{
  "version": "2.0",
  "primary_sources": [
    {
      "id": "gogoanime",
      "name": "GogoAnime",
      "base_url": "https://gogoanime.by",
      "search_url": "https://gogoanime.by/search.html?keyword={query}",
      "embed_domains": ["gogocdn.net", "gogoanime.by"],
      "priority": 1,
      "active": true
    },
    {
      "id": "aniwaves",
      "name": "AniWaves",
      "base_url": "https://aniwaves.ru",
      "search_url": "https://aniwaves.ru/search?q={query}",
      "embed_domains": ["aniwaves.ru"],
      "priority": 2,
      "active": true
    },
    {
      "id": "yomi",
      "name": "Yomi",
      "base_url": "https://yomi.to",
      "search_url": "https://yomi.to/search?q={query}",
      "embed_domains": ["yomi.to"],
      "priority": 3,
      "active": true
    },
    {
      "id": "kickassanime",
      "name": "KickAssAnime",
      "base_url": "https://kickassanime.com.es",
      "search_url": "https://kickassanime.com.es/search?q={query}",
      "embed_domains": ["kickassanime.com.es"],
      "priority": 4,
      "active": true
    }
  ],
  "torrent_sources": [
    {
      "id": "nyaa",
      "name": "Nyaa",
      "base_url": "https://nyaa.si",
      "api_url": "https://nyaa.si/?page=rss&q={query}&c=1_0&f=0",
      "type": "rss",
      "priority": 5,
      "active": true
    }
  ],
  "embed_resolvers": {
    "gogoanime": {
      "pattern": "/watch/{slug}-episode-{ep}",
      "iframe_selector": "iframe#playerframe",
      "backup_api": "https://api.consumet.org/anime/gogoanime/watch/{id}"
    },
    "aniwaves": {
      "pattern": "/watch/{mal_id}/ep-{ep}",
      "direct": true
    },
    "yomi": {
      "pattern": "/watch/{mal_id}/{ep}",
      "direct": true
    },
    "kickassanime": {
      "pattern": "/{slug}-episode-{ep}-english-subbed/",
      "direct": true
    }
  },
  "consumet_api": "https://api.consumet.org",
  "jikan_api": "https://api.jikan.moe/v4",
  "settings": {
    "timeout_ms": 5000,
    "race_timeout_ms": 8000,
    "max_retries": 2,
    "cache_ttl_seconds": 300
  }
}
