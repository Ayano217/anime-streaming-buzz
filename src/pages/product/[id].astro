---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { id } = Astro.params;
---

<BaseLayout
  title="Product Details"
  description="Premium anime merchandise, figures, manga, and more."
>
  <Header slot="header" />
  
  <div class="pd-wrap">
    
    <!-- Loader -->
    <div id="pdLoader" class="pd-loader">
      <div class="pd-lo-spinner"></div>
      <p>Loading product details...</p>
    </div>
    
    <!-- Not Found -->
    <div id="pdNotFound" class="pd-nf" style="display:none;">
      <div class="nf-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
      </div>
      <h1>Product Not Found</h1>
      <p>This product doesn't exist or has been removed.</p>
      <div class="nf-btns">
        <a href="/" class="nf-btn nf-btn-primary">← Back to Homepage</a>
      </div>
    </div>
    
    <!-- Main Content -->
    <div id="pdContent" style="display:none;">
      
      <!-- Breadcrumb -->
      <div class="pd-breadcrumb container">
        <a href="/">Home</a>
        <span class="bc-sep">›</span>
        <a href="#" id="pdCategoryLink">Products</a>
        <span class="bc-sep">›</span>
        <span id="pdBreadcrumbTitle">Product</span>
      </div>
      
      <!-- Product Main Section -->
      <section class="pd-main-section">
        <div class="container">
          <div class="pd-grid">
            
            <!-- LEFT: Image Gallery -->
            <div class="pd-gallery">
              <div class="pd-main-image">
                <img id="pdMainImage" src="" alt="" />
                <div class="pd-image-overlay">
                  <button id="pdSaveBtn" class="pd-save-btn" aria-label="Save product">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                    </svg>
                  </button>
                </div>
                <div id="pdBadge" class="pd-image-badge"></div>
              </div>
              <div id="pdThumbnails" class="pd-thumbnails" style="display:none;"></div>
              
              <!-- Video (if exists) -->
              <div id="pdVideo" class="pd-video" style="display:none;">
                <div class="pd-video-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  Product Video
                </div>
                <div id="pdVideoFrame" class="pd-video-frame"></div>
              </div>
            </div>
            
            <!-- RIGHT: Product Info -->
            <div class="pd-info">
              
              <div class="pd-brand" id="pdBrand">Brand</div>
              <h1 class="pd-title" id="pdTitle">Loading...</h1>
              <p class="pd-subtitle" id="pdSubtitle"></p>
              
              <!-- Rating -->
              <div class="pd-rating-row">
                <div class="pd-rating" id="pdRating">
                  <div class="pd-stars">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <span id="pdRatingNum">0</span>
                  </div>
                  <span class="pd-reviews" id="pdReviews">0 reviews</span>
                </div>
                <div class="pd-stock in-stock" id="pdStock">
                  <span class="stock-dot"></span>
                  <span id="pdStockText">In Stock</span>
                </div>
              </div>
              
              <!-- Price -->
              <div class="pd-price-block">
                <div class="pd-price-row">
                  <span class="pd-price" id="pdPrice">$0.00</span>
                  <span class="pd-original-price" id="pdOriginalPrice" style="display:none;"></span>
                  <span class="pd-discount" id="pdDiscount" style="display:none;"></span>
                </div>
                <div class="pd-shipping" id="pdShipping">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  <span>Free shipping with Prime</span>
                </div>
              </div>
              
              <!-- Description -->
              <div class="pd-description" id="pdDescription"></div>
              
              <!-- Features -->
              <div class="pd-features" id="pdFeatures" style="display:none;">
                <div class="pd-features-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Key Features</span>
                </div>
                <ul class="pd-features-list" id="pdFeaturesList"></ul>
              </div>
              
              <!-- Purchase Actions -->
              <div class="pd-actions">
                <a href="#" id="pdBuyBtn" class="pd-buy-btn" target="_blank" rel="noopener nofollow sponsored">
                  <div class="pd-buy-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                  </div>
                  <div class="pd-buy-text">
                    <div class="pd-buy-main">Buy on <span id="pdStoreName">Amazon</span></div>
                    <div class="pd-buy-sub">Best price · Fast delivery</div>
                  </div>
                  <div class="pd-buy-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </div>
                </a>
                
                <button id="pdShareBtn" class="pd-share-btn" aria-label="Share">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                </button>
              </div>
              
              <!-- Trust Badges -->
              <div class="pd-trust">
                <div class="trust-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span>Verified Seller</span>
                </div>
                <div class="trust-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/></svg>
                  <span>Fast Delivery</span>
                </div>
                <div class="trust-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span>24/7 Support</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Related Products -->
      <section class="pd-related-section" id="pdRelatedSection" style="display:none;">
        <div class="container">
          <div class="pd-section-head">
            <h2 class="pd-section-title">
              <span class="grad-text">You May Also Like</span>
            </h2>
            <p class="pd-section-sub">Handpicked for you based on this product</p>
          </div>
          <div id="pdRelatedGrid" class="pd-related-grid"></div>
        </div>
      </section>
      
      <!-- Related Anime -->
      <section class="pd-anime-section" id="pdAnimeSection" style="display:none;">
        <div class="container">
          <div class="pd-section-head">
            <h2 class="pd-section-title">
              <span class="grad-text">Watch the Anime</span>
            </h2>
            <p class="pd-section-sub">Discover the shows this product is from</p>
          </div>
          <div id="pdAnimeGrid" class="pd-anime-grid"></div>
        </div>
      </section>
      
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ id }}>
(function() {
  var els = {
    loader: document.getElementById('pdLoader'),
    notFound: document.getElementById('pdNotFound'),
    content: document.getElementById('pdContent'),
    mainImage: document.getElementById('pdMainImage'),
    thumbnails: document.getElementById('pdThumbnails'),
    badge: document.getElementById('pdBadge'),
    brand: document.getElementById('pdBrand'),
    title: document.getElementById('pdTitle'),
    subtitle: document.getElementById('pdSubtitle'),
    ratingNum: document.getElementById('pdRatingNum'),
    reviews: document.getElementById('pdReviews'),
    stock: document.getElementById('pdStock'),
    stockText: document.getElementById('pdStockText'),
    price: document.getElementById('pdPrice'),
    originalPrice: document.getElementById('pdOriginalPrice'),
    discount: document.getElementById('pdDiscount'),
    shipping: document.getElementById('pdShipping'),
    description: document.getElementById('pdDescription'),
    features: document.getElementById('pdFeatures'),
    featuresList: document.getElementById('pdFeaturesList'),
    buyBtn: document.getElementById('pdBuyBtn'),
    storeName: document.getElementById('pdStoreName'),
    shareBtn: document.getElementById('pdShareBtn'),
    saveBtn: document.getElementById('pdSaveBtn'),
    breadcrumbTitle: document.getElementById('pdBreadcrumbTitle'),
    categoryLink: document.getElementById('pdCategoryLink'),
    relatedSection: document.getElementById('pdRelatedSection'),
    relatedGrid: document.getElementById('pdRelatedGrid'),
    animeSection: document.getElementById('pdAnimeSection'),
    animeGrid: document.getElementById('pdAnimeGrid'),
    video: document.getElementById('pdVideo'),
    videoFrame: document.getElementById('pdVideoFrame'),
  };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
    });
  }

  function trunc(s, n) {
    s = String(s || '');
    return s.length > n ? s.slice(0, n).trim() + '…' : s;
  }

  var STORE_NAMES = {
    amazon: 'Amazon',
    playasia: 'Play-Asia',
    cdjapan: 'CDJapan',
  };

  async function fetchJSON(url) {
    try {
      var res = await fetch(url);
      if (!res.ok) return null;
      return await res.json();
    } catch (e) {
      return null;
    }
  }

  async function loadProduct() {
    var data = await fetchJSON('/api/products?id=' + encodeURIComponent(id) + '&related=true');
    
    if (!data || !data.success || !data.product) {
      els.loader.style.display = 'none';
      els.notFound.style.display = 'flex';
      return;
    }
    
    var p = data.product;
    var related = data.related || [];
    
    // Set page title
    document.title = p.title + ' — AniTube Buzz';
    
    // Render main info
    renderProduct(p);
    
    // Render related products
    if (related.length > 0) {
      renderRelated(related);
    }
    
    // Load related anime
    if (p.animeTag && p.animeTag.length > 0) {
      loadRelatedAnime(p.animeTag);
    }
    
    // Hide loader, show content
    els.loader.style.display = 'none';
    els.content.style.display = 'block';
  }

  function renderProduct(p) {
    // Main image
    if (p.image) {
      els.mainImage.src = p.image;
      els.mainImage.alt = p.title;
    }
    
    // Thumbnails (if multiple images)
    if (p.images && p.images.length > 1) {
      els.thumbnails.style.display = 'flex';
      els.thumbnails.innerHTML = p.images.map(function(img, i) {
        return '<button class="pd-thumb ' + (i === 0 ? 'active' : '') + '" data-src="' + esc(img) + '">' +
          '<img src="' + esc(img) + '" alt="Image ' + (i+1) + '" loading="lazy" />' +
        '</button>';
      }).join('');
      
      els.thumbnails.querySelectorAll('.pd-thumb').forEach(function(btn) {
        btn.addEventListener('click', function() {
          els.thumbnails.querySelectorAll('.pd-thumb').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          els.mainImage.src = btn.dataset.src;
        });
      });
    }
    
    // Badge
    if (p.badge) {
      els.badge.textContent = p.badge;
      els.badge.style.display = 'inline-flex';
    }
    
    // Brand
    els.brand.textContent = p.brand || 'Premium Brand';
    
    // Title & subtitle
    els.title.textContent = p.title;
    els.subtitle.textContent = p.subtitle || '';
    els.breadcrumbTitle.textContent = trunc(p.title, 40);
    els.categoryLink.textContent = p.category ? p.category.charAt(0).toUpperCase() + p.category.slice(1) : 'Products';
    
    // Rating
    els.ratingNum.textContent = p.rating ? p.rating.toFixed(1) : '5.0';
    els.reviews.textContent = (p.reviews ? p.reviews.toLocaleString() : '0') + ' reviews';
    
    // Stock
    if (p.inStock === false) {
      els.stock.classList.remove('in-stock');
      els.stock.classList.add('out-stock');
      els.stockText.textContent = 'Out of Stock';
    }
    
    // Price
    els.price.textContent = p.price || '$0.00';
    if (p.originalPrice) {
      els.originalPrice.textContent = p.originalPrice;
      els.originalPrice.style.display = 'inline';
    }
    if (p.discount) {
      els.discount.textContent = '-' + p.discount + '% OFF';
      els.discount.style.display = 'inline-flex';
    }
    
    // Shipping
    if (p.shipping) {
      els.shipping.querySelector('span').textContent = p.shipping;
    }
    
    // Description
    els.description.innerHTML = '<p>' + esc(p.longDescription || p.description || '') + '</p>';
    
    // Features
    if (p.features && p.features.length > 0) {
      els.features.style.display = 'block';
      els.featuresList.innerHTML = p.features.map(function(f) {
        return '<li>' +
          '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>' +
          '<span>' + esc(f) + '</span>' +
        '</li>';
      }).join('');
    }
    
    // Buy button
    els.buyBtn.href = p.affiliateUrl || p.rawUrl || '#';
    els.storeName.textContent = STORE_NAMES[p.store] || 'Store';
    
    // Video
    if (p.video) {
      els.video.style.display = 'block';
      els.videoFrame.innerHTML = '<iframe src="' + esc(p.video) + '" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    }
    
    // Save button
    setupSaveButton(p);
    
    // Share button
    setupShareButton(p);
    
    // Track product view (analytics)
    trackView(p);
  }

  function renderRelated(products) {
    els.relatedSection.style.display = 'block';
    els.relatedGrid.innerHTML = products.map(function(p) {
      return '<a href="/product/' + esc(p.id) + '" class="pd-rel-card">' +
        '<div class="pd-rel-img">' +
          (p.image ? '<img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" loading="lazy" />' : '<div class="pd-rel-no-img">🛍️</div>') +
          (p.badge ? '<div class="pd-rel-badge">' + esc(p.badge) + '</div>' : '') +
        '</div>' +
        '<div class="pd-rel-info">' +
          '<div class="pd-rel-title">' + esc(trunc(p.title, 55)) + '</div>' +
          '<div class="pd-rel-price">' + esc(p.price) + '</div>' +
          (p.rating ? '<div class="pd-rel-rating">' +
            '<svg width="10" height="10" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' +
            '<span>' + p.rating + '</span>' +
          '</div>' : '') +
        '</div>' +
      '</a>';
    }).join('');
  }

  async function loadRelatedAnime(animeTags) {
    var animeToShow = [];
    var maxToLoad = Math.min(6, animeTags.length);
    
    for (var i = 0; i < maxToLoad; i++) {
      var tag = animeTags[i];
      try {
        var res = await fetch('/api/anime?action=detail&slug=' + encodeURIComponent(tag));
        var data = await res.json();
        if (data && data.success && data.anime) {
          animeToShow.push(data.anime);
        }
      } catch (e) {}
    }
    
    if (animeToShow.length > 0) {
      els.animeSection.style.display = 'block';
      els.animeGrid.innerHTML = animeToShow.map(function(a) {
        return '<a href="/anime/' + esc(a.slug) + '" class="pd-anime-card">' +
          '<div class="pd-anime-poster">' +
            (a.image ? '<img src="' + esc(a.image) + '" alt="' + esc(a.title) + '" loading="lazy" />' : '<div class="pd-anime-no-img">🎬</div>') +
            '<div class="pd-anime-play">' +
              '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
            '</div>' +
          '</div>' +
          '<div class="pd-anime-title">' + esc(trunc(a.title, 40)) + '</div>' +
          (a.score ? '<div class="pd-anime-score"><svg width="10" height="10" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span>' + a.score + '</span></div>' : '') +
        '</a>';
      }).join('');
    }
  }

  function setupSaveButton(p) {
    var saved = JSON.parse(localStorage.getItem('savedProducts') || '[]');
    var isSaved = saved.some(function(x) { return x.id === p.id; });
    
    if (isSaved) els.saveBtn.classList.add('saved');
    
    els.saveBtn.addEventListener('click', function() {
      var current = JSON.parse(localStorage.getItem('savedProducts') || '[]');
      var idx = current.findIndex(function(x) { return x.id === p.id; });
      
      if (idx >= 0) {
        current.splice(idx, 1);
        els.saveBtn.classList.remove('saved');
      } else {
        current.push({
          id: p.id,
          title: p.title,
          image: p.image,
          price: p.price,
          savedAt: Date.now(),
        });
        els.saveBtn.classList.add('saved');
      }
      
      localStorage.setItem('savedProducts', JSON.stringify(current));
    });
  }

  function setupShareButton(p) {
    els.shareBtn.addEventListener('click', function() {
      var url = window.location.href;
      var title = p.title + ' — AniTube Buzz';
      
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function() {});
      } else {
        navigator.clipboard.writeText(url).then(function() {
          els.shareBtn.classList.add('copied');
          setTimeout(function() { els.shareBtn.classList.remove('copied'); }, 1500);
        });
      }
    });
  }

  function trackView(p) {
    // Save to user's view history (for Safiya AI personalization later)
    try {
      var viewed = JSON.parse(localStorage.getItem('viewedProducts') || '[]');
      viewed.unshift({
        id: p.id,
        title: p.title,
        category: p.category,
        animeTag: p.animeTag,
        viewedAt: Date.now(),
      });
      // Keep last 50
      viewed = viewed.slice(0, 50);
      localStorage.setItem('viewedProducts', JSON.stringify(viewed));
    } catch (e) {}
  }

  loadProduct();
})();
</script>

<style>
  .pd-wrap {
    min-height: 100vh;
    color: var(--text-primary);
  }
  
  /* Loader */
  .pd-loader, .pd-nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 1rem;
    text-align: center;
    min-height: 60vh;
  }
  
  .pd-lo-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: pdSpin 0.8s linear infinite;
    margin-bottom: 1rem;
  }
  
  @keyframes pdSpin {
    to { transform: rotate(360deg); }
  }
  
  .pd-loader p {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }
  
  .nf-icon {
    color: #c084fc;
    margin-bottom: 1rem;
  }
  
  .pd-nf h1 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 2rem;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }
  
  .pd-nf p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  
  .nf-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  
  .nf-btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 8px 24px rgba(192, 132, 252, 0.4);
  }
  
  .nf-btn:hover {
    transform: translateY(-2px);
  }
  
  /* Breadcrumb */
  .pd-breadcrumb {
    padding: 1.5rem 0 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  
  .pd-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .pd-breadcrumb a:hover {
    color: var(--purple);
  }
  
  .bc-sep {
    color: var(--text-faint);
    padding: 0 4px;
  }
  
  /* Main Section */
  .pd-main-section {
    padding: 1.5rem 0 3rem;
  }
  
  .pd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  
  /* Gallery */
  .pd-gallery {
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }
  
  .pd-main-image {
    position: relative;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(28, 15, 61, 0.4);
    border: 1px solid var(--border-color);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    margin-bottom: 12px;
  }
  
  [data-theme="light"] .pd-main-image {
    background: #fff;
