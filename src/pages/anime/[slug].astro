---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
---

<BaseLayout 
  title="Anime Details"
  description="Watch anime episodes online in premium HD quality on AniTube Buzz."
>
  <Header slot="header" />
  
  <div class="ap-wrap">
    <div id="apLoader" class="ap-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p id="apLoaderText">Loading anime details...</p>
    </div>
    
    <div id="apNotFound" class="ap-nf" style="display:none;">
      <div class="nf-ic"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></div>
      <h1>Anime Not Found</h1>
      <p id="apNfMsg">This anime doesn't exist or couldn't be loaded.</p>
      <div class="nf-btns">
        <a href="/" class="nf-bk">← Back to Homepage</a>
        <button onclick="location.reload()" class="nf-rt">🔄 Try Again</button>
      </div>
    </div>
    
    <div id="apContent" style="display:none;">
      <div class="ap-hero">
        <div class="ap-bg" id="apBg"></div>
        <div class="ap-fade"></div>
        <div class="container">
          <div class="ap-hero-in">
            <div class="ap-poster"><img id="apPosterImg" alt="" /></div>
            <div class="ap-info">
              <div class="ap-badges" id="apBadges"></div>
              <h1 class="ap-title" id="apTitle">Loading...</h1>
              <div class="ap-meta" id="apMeta"></div>
              <div class="ap-genres" id="apGenres"></div>
              <p class="ap-syno" id="apSyno"></p>
              <div class="ap-actions">
                <button class="ap-btn ap-btn-p" id="apWatchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="ap-btn ap-btn-s" id="apInfoBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                  <span>More Info</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <section class="section-block ap-player" id="apPlayerBlock" style="display:none;">
        <div class="container">
          <div class="pl-head">
            <h2 class="section-title" id="apPlayerTitle"><span class="grad-text">Now Playing</span></h2>
            <button class="pl-close" id="apClosePlayer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          
          <div class="pl-wrap-full">
            <div id="apPlayerFrame" class="pl-frame-full">
              <div class="pl-load-msg">Loading player...</div>
            </div>
          </div>
          
          <div id="apVideoPicker" class="pl-picker" style="display:none;">
            <div class="pl-picker-head">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
              <span>Choose your source (multi-platform):</span>
            </div>
            <div class="pl-picker-list" id="apPickerList"></div>
          </div>
          
          <div class="pl-affiliate">
            <div class="af-title">🎬 Watch full episodes officially:</div>
            <div class="af-btns">
              <a href="#" class="af-btn af-cr" id="afCrunchyroll" target="_blank" rel="noopener">
                <div class="af-btn-lg cr">CR</div>
                <div class="af-btn-txt">
                  <div class="af-btn-t">Crunchyroll</div>
                  <div class="af-btn-s">1000+ anime series</div>
                </div>
              </a>
              <a href="#" class="af-btn af-nf" id="afNetflix" target="_blank" rel="noopener">
                <div class="af-btn-lg nf">N</div>
                <div class="af-btn-txt">
                  <div class="af-btn-t">Netflix</div>
                  <div class="af-btn-s">Popular anime originals</div>
                </div>
              </a>
              <a href="#" class="af-btn af-am" id="afAmazon" target="_blank" rel="noopener">
                <div class="af-btn-lg am">A</div>
                <div class="af-btn-txt">
                  <div class="af-btn-t">Buy Merch</div>
                  <div class="af-btn-s">Figures, manga, more</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-details" id="apDetailsBlock">
        <div class="container">
          <div class="ap-grid">
            <div class="ap-main">
              <div class="ap-sec">
                <h2 class="ap-sh">Synopsis</h2>
                <p class="ap-desc" id="apFullSyno">Loading...</p>
              </div>
              
              <div class="ap-sec">
                <div class="ap-eps-head">
                  <h2 class="ap-sh">Episodes</h2>
                  <div class="ap-eps-sort" id="apSortInfo"></div>
                </div>
                <div class="ap-seasons" id="apSeasonsTabs"></div>
                <div id="apEpisodesList" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
                  <div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:.85rem;">Loading episodes...</div>
                </div>
              </div>
            </div>
            
            <aside class="ap-side">
              <div class="ap-card">
                <h3 class="ac-t">Information</h3>
                <div class="ac-list" id="apInfoList"></div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Where to Watch</h3>
                <div class="ac-list">
                  <a href="#" class="ap-stream" data-platform="crunchyroll"><div class="st-lg cr">CR</div><span>Crunchyroll</span></a>
                  <a href="#" class="ap-stream" data-platform="netflix"><div class="st-lg nf">N</div><span>Netflix</span></a>
                  <a href="#" class="ap-stream" data-platform="hulu"><div class="st-lg hu">Hulu</div><span>Hulu</span></a>
                </div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Share</h3>
                <div class="ap-share">
                  <button class="sh-btn" data-share="twitter"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></button>
                  <button class="sh-btn" data-share="facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></button>
                  <button class="sh-btn" data-share="copy"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-related">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">You Might Also Like</span></h2>
          <div id="apRelatedGrid" class="rel-grid">
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @keyframes atPlayRing { 0%{transform:scale(1);opacity:.9} 100%{transform:scale(1.7);opacity:0} }
  @keyframes atCardIn { from{opacity:0;transform:translateY(15px)} to{opacity:1;transform:translateY(0)} }
  
  .at-ep-card { transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1) !important; }
  .at-ep-card:hover { transform: translateY(-6px) !important; }
  .at-ep-card:hover .at-thumb-wrap { 
    border-color: rgba(232, 121, 249, 0.9) !important;
    box-shadow: 0 15px 40px rgba(0,0,0,0.5), 0 0 25px rgba(192, 132, 252, 0.5), 0 0 0 1px rgba(232, 121, 249, 0.7) !important;
  }
  .at-ep-card:hover .at-play-wrap { opacity: 1 !important; transform: translate(-50%,-50%) scale(1) !important; }
  .at-ep-card:hover .at-thumb-img { transform: scale(1.08) !important; filter: brightness(0.65) !important; }
  .at-ep-card:hover .at-thumb-img-fb { filter: blur(6px) brightness(0.3) saturate(1.5) !important; transform: scale(1.55) !important; }
  .at-ep-card:hover .at-shine { left: 120% !important; }
  .at-ep-card:hover .at-overlay { opacity: 1 !important; }
  .at-ep-card:hover .at-title { 
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc) !important; 
    -webkit-background-clip: text !important; 
    -webkit-text-fill-color: transparent !important; 
    background-clip: text !important; 
  }
  
  @media (max-width: 768px) {
    .at-play-wrap { opacity: 1 !important; transform: translate(-50%,-50%) scale(0.85) !important; }
    #apEpisodesList { grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; }
  }
  @media (max-width: 1024px) and (min-width: 769px) {
    #apEpisodesList { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>

<script is:inline define:vars={{ slug }}>
(async function(){
  function esc(s){try{return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}catch(e){return'';}}
  function fmt(d){try{if(!d)return'N/A';var x=new Date(d);if(isNaN(x.getTime()))return'N/A';return x.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}catch(e){return'N/A';}}
  function cap(s){try{if(!s)return'';var str=String(s).replace(/_/g,' ');return str.charAt(0).toUpperCase()+str.slice(1);}catch(e){return String(s||'');}}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  async function fetchJSON(url,timeoutMs){
    timeoutMs=timeoutMs||10000;
    try{
      var c=new AbortController();var t=setTimeout(function(){c.abort();},timeoutMs);
      var r=await fetch(url,{signal:c.signal});clearTimeout(t);
      if(!r.ok)return null;return await r.json();
    }catch(e){return null;}
  }

  async function loadAnimeData(loaderText){
    if(loaderText)loaderText.textContent='Loading anime details...';
    var j=await fetchJSON('/api/anime?action=detail&slug='+encodeURIComponent(slug),10000);
    if(j&&j.success&&j.anime)return j.anime;
    if(loaderText)loaderText.textContent='Searching for anime...';
    var searchTerm=slug.replace(/-/g,' ');
    var s=await fetchJSON('/api/anime?action=search&q='+encodeURIComponent(searchTerm),10000);
    if(s&&s.success&&s.anime&&s.anime.length>0){
      var exact=s.anime.find(function(a){return a.slug===slug;});
      var pick=exact||s.anime[0];
      var full=await fetchJSON('/api/anime?action=detail&id='+pick.id,8000);
      if(full&&full.success&&full.anime)return full.anime;
      return pick;
    }
    return null;
  }

  // ═══ MULTI-SOURCE VIDEO EMBED ═══
  function embedMultiSource(video, els) {
    var brand = '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · ' + esc(video.sourceLabel) + '</span></div>';
    els.playerFrame.innerHTML = brand;
    var iframe = document.createElement('iframe');
    iframe.src = video.embedUrl;
    iframe.setAttribute('width', '100%');
    iframe.setAttribute('height', '100%');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute !important;top:0 !important;left:0 !important;width:100% !important;height:100% !important;border:0 !important;display:block !important;';
    els.playerFrame.appendChild(iframe);
  }

  function embedFallback(query, els) {
    var brand = '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · YouTube Search</span></div>';
    els.playerFrame.innerHTML = brand;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed?listType=search&list=' + encodeURIComponent(query);
    iframe.setAttribute('width', '100%');
    iframe.setAttribute('height', '100%');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute !important;top:0 !important;left:0 !important;width:100% !important;height:100% !important;border:0 !important;display:block !important;';
    els.playerFrame.appendChild(iframe);
  }

  function renderMultiSourcePicker(videos, els) {
    if (!videos || videos.length <= 1) {
      if (els.videoPicker) els.videoPicker.style.display = 'none';
      return;
    }
    if (!els.videoPicker) return;
    
    els.videoPicker.style.display = 'block';
    
    var sourceColors = {
      youtube: { bg: '#ff0000', label: 'YT' },
      dailymotion: { bg: '#0066dc', label: 'DM' },
      odysee: { bg: '#ee44aa', label: 'OD' },
      rumble: { bg: '#85c742', label: 'RB' },
      vimeo: { bg: '#1ab7ea', label: 'VM' }
    };
    
    els.pickerList.innerHTML = videos.map(function(v, idx) {
      var sc = sourceColors[v.source] || { bg: '#c084fc', label: (v.source || '?').substring(0, 2).toUpperCase() };
      var officialBadge = v.isOfficial ? '<div class="pl-pick-official">✓ OFFICIAL</div>' : '';
      var sourceBadge = '<div class="pl-pick-source" style="background:' + sc.bg + ';">' + sc.label + '</div>';
      var title = v.title || '';
      var channel = v.channel || v.sourceLabel || 'Unknown';
      
      return '<div class="pl-pick-item' + (idx === 0 ? ' active' : '') + '" data-video-idx="' + idx + '">' +
        '<div class="pl-pick-thumb">' +
          (v.thumbnail ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' : '<div class="sd-no"></div>') +
          sourceBadge +
          officialBadge +
        '</div>' +
        '<div class="pl-pick-info">' +
          '<div class="pl-pick-title">' + esc(trunc(title, 65)) + '</div>' +
          '<div class="pl-pick-channel">' + esc(channel) + '</div>' +
        '</div>' +
      '</div>';
    }).join('');
    
    els.pickerList.querySelectorAll('.pl-pick-item').forEach(function(el) {
      el.addEventListener('click', function() {
        var idx = parseInt(el.dataset.videoIdx);
        var video = videos[idx];
        if (!video) return;
        els.pickerList.querySelectorAll('.pl-pick-item').forEach(function(x) { x.classList.remove('active'); });
        el.classList.add('active');
        embedMultiSource(video, els);
      });
    });
  }

  async function playVideo(query, title, els, epNumber) {
    try {
      if (!els.playerBlock || !els.playerFrame) return;
      els.playerBlock.style.display = 'block';
      if (els.playerTitle) els.playerTitle.innerHTML = '<span class="grad-text">' + esc(title || 'Now Playing') + '</span>';
      els.playerFrame.innerHTML = '<div class="pl-load-msg"><div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div><span style="margin-left:12px;">Searching multiple sources...</span></div>';
      if (els.videoPicker) els.videoPicker.style.display = 'none';
      setTimeout(function() { els.playerBlock.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
      
      var searchUrl = '/api/video-search?q=' + encodeURIComponent(query);
      if (epNumber) searchUrl += '&ep=' + epNumber;
      
      var j = await fetchJSON(searchUrl, 15000);
      
      if (j && j.success && j.videos && j.videos.length > 0) {
        embedMultiSource(j.videos[0], els);
        renderMultiSourcePicker(j.videos, els);
        console.log('[AniTube] Sources found:', j.sources || {});
      } else {
        embedFallback(query, els);
      }
    } catch(e) {
      console.error('playVideo error:', e);
      embedFallback(query, els);
    }
  }

  function safeRender(a,els){
    try{document.title=(a.title||'Anime')+' - AniTube Buzz';}catch(e){}
    try{if(a.image){if(els.bg)els.bg.style.backgroundImage='url('+a.image+')';if(els.poster){els.poster.src=a.image;els.poster.alt=a.title||'';}}}catch(e){}
    try{if(els.title)els.title.textContent=a.title||'Untitled';}catch(e){}
    try{
      var b=[];
      if(a.status==='current')b.push('<span class="ap-b ap-b-new"><span class="ap-dot"></span>AIRING NOW</span>');
      if(a.score!=null)b.push('<span class="ap-b ap-b-sc"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'+Number(a.score).toFixed(1)+'</span>');
      b.push('<span class="ap-b ap-b-hd">HD</span>');
      if(a.ageRating)b.push('<span class="ap-b ap-b-age">'+esc(a.ageRating)+'</span>');
      if(els.badges)els.badges.innerHTML=b.join('');
    }catch(e){}
    try{
      var m=[];
      if(a.year)m.push(String(a.year));
      if(a.episodes&&a.episodes>0)m.push(a.episodes+' Episodes');
      if(a.subtype)m.push(String(a.subtype));
      if(a.status)m.push(cap(a.status));
      if(els.meta)els.meta.innerHTML=m.map(function(x){return '<span>'+esc(x)+'</span>';}).join('<span class="mp-sep">·</span>');
    }catch(e){}
    try{if(a.genres&&Array.isArray(a.genres)&&a.genres.length>0&&els.genres){els.genres.innerHTML=a.genres.slice(0,6).map(function(g){return '<span class="ap-gp">'+esc(g)+'</span>';}).join('');}}catch(e){}
    try{
      var syn=a.description||a.synopsis||'No synopsis available.';
      if(els.syno)els.syno.textContent=syn.length>250?syn.slice(0,250)+'...':syn;
      if(els.fullSyno)els.fullSyno.textContent=syn;
    }catch(e){}
    try{
      var rows=[
        ['Type',a.subtype||'TV'],
        ['Episodes',(a.episodes&&a.episodes>0)?a.episodes:'Unknown'],
        ['Status',a.status?cap(a.status):'Unknown'],
        ['Aired',a.startDate?(fmt(a.startDate)+(a.endDate?' to '+fmt(a.endDate):' to ?')):'Unknown'],
        ['Score',a.score!=null?('⭐ '+Number(a.score).toFixed(1)+' / 10'):'N/A'],
        ['Rating',a.ageRating||'Not Rated'],
        ['Genres',(a.genres&&a.genres.length)?a.genres.join(', '):'N/A']
      ];
      if(els.infoList)els.infoList.innerHTML=rows.map(function(r){return '<div class="ir"><span class="ir-l">'+esc(r[0])+'</span><span class="ir-v">'+esc(String(r[1]))+'</span></div>';}).join('');
    }catch(e){}
    try{
      var qEnc=encodeURIComponent(a.title||'');
      document.querySelectorAll('.ap-stream').forEach(function(el){
        var p=el.dataset.platform,u='#';
        if(p==='crunchyroll')u='https://www.crunchyroll.com/search?q='+qEnc;
        else if(p==='netflix')u='https://www.netflix.com/search?q='+qEnc;
        else if(p==='hulu')u='https://www.hulu.com/search?q='+qEnc;
        el.href=u;el.target='_blank';el.rel='noopener';
      });
      var afCr=document.getElementById('afCrunchyroll');
      var afNf=document.getElementById('afNetflix');
      var afAm=document.getElementById('afAmazon');
      if(afCr)afCr.href='https://www.crunchyroll.com/search?q='+qEnc;
      if(afNf)afNf.href='https://www.netflix.com/search?q='+qEnc;
      if(afAm)afAm.href='https://www.amazon.com/s?k='+encodeURIComponent(a.title+' anime')+'&tag=anitubebuzz-20';
    }catch(e){}
  }

  function buildEpisodeCard(e, idx, title, posterFallback) {
    var hasRealThumb = !!e.thumbnail;
    var thumb = e.thumbnail || posterFallback || '';
    var animDelay = ((idx % 12) * 40) + 'ms';
    var imgStyle = hasRealThumb
      ? 'position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.6s ease, filter 0.35s ease;'
      : 'position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:all 0.35s ease;filter:blur(8px) brightness(0.45) saturate(1.3);transform:scale(1.45);';
    var imgClass = hasRealThumb ? 'at-thumb-img' : 'at-thumb-img at-thumb-img-fb';
    var imgHtml = thumb
      ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" class="' + imgClass + '" style="' + imgStyle + '" />'
      : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.25),rgba(232,121,249,0.15),rgba(125,211,252,0.2));"></div>';
    
    return '<div class="at-ep-card" data-n="' + e.number + '" data-t="' + esc(e.title) + '" ' +
      'style="position:relative;cursor:pointer;background:transparent;animation:atCardIn 0.5s ease backwards;animation-delay:' + animDelay + ';">' +
      '<div class="at-thumb-wrap" style="position:relative;width:100%;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#0a0517;border:1px solid rgba(192,132,252,0.35);box-shadow:0 8px 20px rgba(0,0,0,0.4);transition:all 0.35s ease;">' +
        imgHtml +
        '<div class="at-shine" style="position:absolute;top:0;left:-80%;width:60%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,0.2),transparent);z-index:3;transition:left 0.8s ease;pointer-events:none;"></div>' +
        '<div class="at-overlay" style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(10,5,23,0.85) 100%);opacity:0;transition:opacity 0.3s ease;pointer-events:none;z-index:3;"></div>' +
        '<div class="at-play-wrap" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.4);width:52px;height:52px;z-index:5;opacity:0;transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none;">' +
          '<div style="position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,0.8);animation:atPlayRing 2s ease-out infinite;"></div>' +
          '<div style="position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,0.8);animation:atPlayRing 2s ease-out infinite;animation-delay:1s;"></div>' +
          '<div style="position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:3px;box-shadow:0 10px 30px rgba(192,132,252,0.7),0 0 40px rgba(232,121,249,0.5),inset 0 0 15px rgba(255,255,255,0.15);z-index:2;">' +
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
          '</div>' +
        '</div>' +
        '<div style="position:absolute;top:8px;left:8px;padding:4px 9px;background:linear-gradient(135deg,#c084fc,#e879f9);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.62rem;font-weight:800;letter-spacing:0.08em;border-radius:6px;z-index:6;box-shadow:0 3px 10px rgba(192,132,252,0.5);">EP ' + e.number + '</div>' +
        (e.length ? '<div style="position:absolute;bottom:8px;right:8px;padding:3px 8px;background:rgba(10,5,23,0.9);border:1px solid rgba(192,132,252,0.3);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;font-weight:700;border-radius:5px;z-index:6;">' + e.length + 'm</div>' : '') +
      '</div>' +
      '<div style="padding:10px 4px 4px;position:relative;z-index:1;">' +
        '<h4 class="at-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.85rem;font-weight:700;color:var(--text-primary);margin:0 0 4px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;">' + esc(e.title) + '</h4>' +
        (e.airdate ? '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.66rem;color:var(--text-muted);opacity:0.75;">' + fmt(e.airdate) + '</div>' : '') +
      '</div>' +
    '</div>';
  }

  function renderEpisodes(eps,title,posterFallback,els){
    try{
      if(!els.episodesList)return;
      if(!eps||!eps.length){
        els.episodesList.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);background:rgba(192,132,252,0.05);border:1px dashed rgba(192,132,252,0.2);border-radius:12px;">Episodes not available yet. Click Watch Now for the trailer!</div>';
        if(els.seasonsTabs)els.seasonsTabs.style.display='none';
        return;
      }
      var sortInfo=document.getElementById('apSortInfo');
      if(sortInfo)sortInfo.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 6h18M6 12h12M10 18h4"/></svg> Latest first';
      var seasons={};
      eps.forEach(function(e){var s=e.seasonNumber||1;if(!seasons[s])seasons[s]=[];seasons[s].push(e);});
      var nums=Object.keys(seasons).map(Number).sort(function(a,b){return a-b;});
      nums.forEach(function(s){seasons[s].sort(function(a,b){return (b.number||0)-(a.number||0);});});
      if(els.seasonsTabs){
        els.seasonsTabs.innerHTML=nums.map(function(s,i){
          return '<button class="ap-st'+(i===0?' active':'')+'" data-s="'+s+'">Season '+s+' <span class="st-c">'+seasons[s].length+' EP</span></button>';
        }).join('');
      }
      function show(s){
        var list=seasons[s];
        els.episodesList.innerHTML=list.map(function(e,idx){return buildEpisodeCard(e,idx,title,posterFallback);}).join('');
        els.episodesList.querySelectorAll('.at-ep-card').forEach(function(el){
          el.addEventListener('click',function(){
            var epNum = el.dataset.n;
            var epTitle = el.dataset.t;
            // Multi-source search with episode number for strict matching
            playVideo(title, 'Episode ' + epNum + ': ' + epTitle, els, epNum);
          });
        });
      }
      if(els.seasonsTabs){
        els.seasonsTabs.querySelectorAll('.ap-st').forEach(function(t){
          t.addEventListener('click',function(){
            els.seasonsTabs.querySelectorAll('.ap-st').forEach(function(x){x.classList.remove('active');});
            t.classList.add('active');
            show(Number(t.dataset.s));
          });
        });
      }
      show(nums[0]);
    }catch(e){console.error('renderEpisodes:',e);}
  }

  function renderRelated(list,els){
    try{
      if(!els.relatedGrid)return;
      if(!list||!list.length){els.relatedGrid.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:2rem;grid-column:1/-1;">No related anime found.</p>';return;}
      els.relatedGrid.innerHTML=list.map(function(a){
        var img=a.image?'<img src="'+esc(a.image)+'" alt="" loading="lazy" />':'<div class="rc-no"></div>';
        return '<a href="/anime/'+esc(a.slug)+'" class="rel-c">'+
          '<div class="rc-p">'+img+'<div class="rc-pl"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div></div>'+
          '<div class="rc-t">'+esc(a.title)+'</div></a>';
      }).join('');
    }catch(e){}
  }

  function domReady(cb){if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',cb);else cb();}

  domReady(async function(){
    var els={
      loader:document.getElementById('apLoader'),
      loaderText:document.getElementById('apLoaderText'),
      notFound:document.getElementById('apNotFound'),
      nfMsg:document.getElementById('apNfMsg'),
      content:document.getElementById('apContent'),
      bg:document.getElementById('apBg'),
      poster:document.getElementById('apPosterImg'),
      title:document.getElementById('apTitle'),
      meta:document.getElementById('apMeta'),
      genres:document.getElementById('apGenres'),
      syno:document.getElementById('apSyno'),
      badges:document.getElementById('apBadges'),
      fullSyno:document.getElementById('apFullSyno'),
      infoList:document.getElementById('apInfoList'),
      seasonsTabs:document.getElementById('apSeasonsTabs'),
      episodesList:document.getElementById('apEpisodesList'),
      relatedGrid:document.getElementById('apRelatedGrid'),
      playerBlock:document.getElementById('apPlayerBlock'),
      playerFrame:document.getElementById('apPlayerFrame'),
      playerTitle:document.getElementById('apPlayerTitle'),
      closePlayer:document.getElementById('apClosePlayer'),
      watchBtn:document.getElementById('apWatchBtn'),
      infoBtn:document.getElementById('apInfoBtn'),
      detailsBlock:document.getElementById('apDetailsBlock'),
      videoPicker:document.getElementById('apVideoPicker'),
      pickerList:document.getElementById('apPickerList')
    };
    
    if(!els.loader||!els.content)return;
    
    var hardTimeout=setTimeout(function(){
      if(els.loader.style.display!=='none'){
        els.loader.style.display='none';
        if(els.nfMsg)els.nfMsg.textContent='Loading timeout. Please try again.';
        if(els.notFound)els.notFound.style.display='flex';
      }
    },25000);

    try{
      var anime=await loadAnimeData(els.loaderText);
      if(!anime){
        clearTimeout(hardTimeout);
        els.loader.style.display='none';
        if(els.nfMsg)els.nfMsg.textContent='This anime could not be found in our database.';
        if(els.notFound)els.notFound.style.display='flex';
        return;
      }
      safeRender(anime,els);
      clearTimeout(hardTimeout);
      els.loader.style.display='none';
      els.loader.style.visibility='hidden';
      els.content.style.display='block';
      
      if(anime.id){
        var epsUrl='/api/anime?action=episodes&id='+anime.id+'&page=1&title='+encodeURIComponent(anime.title||'');
        fetchJSON(epsUrl,15000).then(function(epsData){
          if(epsData&&epsData.success)renderEpisodes(epsData.episodes||[],anime.title||'',anime.image||'',els);
          else renderEpisodes([],anime.title||'',anime.image||'',els);
        }).catch(function(){renderEpisodes([],anime.title||'',anime.image||'',els);});
        
        fetchJSON('/api/anime?action=list&category=popular&page=1',10000).then(function(relData){
          if(relData&&relData.success){
            var rel=(relData.anime||[]).filter(function(x){return x.slug!==slug;}).slice(0,12);
            renderRelated(rel,els);
          }else renderRelated([],els);
        }).catch(function(){renderRelated([],els);});
      }
      
      if(els.watchBtn)els.watchBtn.addEventListener('click',function(){
        // Trailer search - no episode number
        playVideo((anime.title || 'anime') + ' anime trailer', (anime.title || 'Anime') + ' - Trailer', els, null);
      });
      if(els.infoBtn&&els.detailsBlock)els.infoBtn.addEventListener('click',function(){
        els.detailsBlock.scrollIntoView({behavior:'smooth',block:'start'});
      });
      if(els.closePlayer)els.closePlayer.addEventListener('click',function(){
        if(els.playerBlock)els.playerBlock.style.display='none';
        if(els.playerFrame)els.playerFrame.innerHTML='';
      });
      
      document.querySelectorAll('.sh-btn').forEach(function(b){
        b.addEventListener('click',function(){
          var t=b.dataset.share,u=window.location.href,x=(anime.title||'Anime')+' on AniTube Buzz';
          if(t==='twitter')window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(x)+'&url='+encodeURIComponent(u),'_blank');
          else if(t==='facebook')window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(u),'_blank');
          else if(t==='copy'){navigator.clipboard.writeText(u);b.classList.add('cp');setTimeout(function(){b.classList.remove('cp');},1500);}
        });
      });
    }catch(e){
      clearTimeout(hardTimeout);
      els.loader.style.display='none';
      if(els.nfMsg)els.nfMsg.textContent='Error: '+(e.message||'Unknown');
      if(els.notFound)els.notFound.style.display='flex';
    }
  });
})();
</script>

