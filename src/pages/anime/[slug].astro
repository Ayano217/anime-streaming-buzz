---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { id } = Astro.params;
---

<BaseLayout title="Watch" description="Premium video experience on AniTube Buzz.">

  <!-- Header/Footer render inside slot; JS will hide them for portrait mode -->
  <Header slot="header" />

  <div class="rl-wrap" id="rlWrap">

    <!-- ═══ LOADER ═══ -->
    <div id="rlLoader" class="rl-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p>Loading premium experience...</p>
    </div>

    <!-- ═══ NOT FOUND ═══ -->
    <div id="rlNotFound" class="rl-nf" style="display:none;">
      <div class="nf-ic">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </div>
      <h1>Video Not Found</h1>
      <p>This video doesn't exist or couldn't be loaded.</p>
      <div class="nf-btns">
        <a href="/" class="nf-bk">← Back to Homepage</a>
        <button onclick="location.reload()" class="nf-rt">🔄 Try Again</button>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         🎬 LANDSCAPE MODE (Anime-Style Page)
    ═══════════════════════════════════════════════ -->
    <div id="rlLandscape" class="rl-landscape" style="display:none;">

      <!-- Hero Section -->
      <div class="rl-hero">
        <div class="rl-bg" id="rlBg"></div>
        <div class="rl-fade"></div>
        <div class="container">
          <div class="rl-hero-in">
            <div class="rl-poster">
              <img id="rlPosterImg" alt="" />
              <div class="rl-poster-play" id="rlPosterPlay">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
            <div class="rl-info">
              <div class="rl-badges" id="rlBadges"></div>
              <h1 class="rl-title" id="rlTitle">Loading...</h1>
              <div class="rl-meta" id="rlMeta"></div>
              <p class="rl-syno" id="rlSyno"></p>
              <div class="rl-actions">
                <button class="rl-btn rl-btn-p" id="rlWatchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="rl-btn rl-btn-s" id="rlSaveBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                  <span id="rlSaveLabel">Save</span>
                </button>
                <button class="rl-btn rl-btn-s" id="rlCopyBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span>Copy Link</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Player Section (hidden until Watch clicked) -->
      <section class="section-block rl-player" id="rlPlayerBlock" style="display:none;">
        <div class="container">
          <div class="pl-head">
            <h2 class="section-title"><span class="grad-text">Now Playing</span></h2>
            <button class="pl-close" id="rlClosePlayer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="pl-wrap-full">
            <div id="rlPlayerFrame" class="pl-frame-full">
              <div class="pl-load-msg">Loading player...</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Details Section -->
      <section class="section-block rl-details">
        <div class="container">
          <div class="rl-grid">
            <div class="rl-main">
              <div class="rl-sec">
                <h2 class="rl-sh">About this video</h2>
                <p class="rl-desc" id="rlFullDesc">Loading...</p>
              </div>

              <div class="rl-sec">
                <div class="rl-eps-head">
                  <h2 class="rl-sh">More Videos</h2>
                  <div class="rl-eps-sort" id="rlSortInfo">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
                    Recommended
                  </div>
                </div>
                <div class="rl-cats" id="rlCatsTabs"></div>
                <div id="rlRelatedList" class="rl-related-grid">
                  <div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:.85rem;">Loading videos...</div>
                </div>
              </div>
            </div>

            <aside class="rl-side">
              <div class="rl-card">
                <h3 class="rc-t">Information</h3>
                <div class="rc-list" id="rlInfoList"></div>
              </div>

              <div class="rl-card">
                <h3 class="rc-t">Share</h3>
                <div class="rl-share">
                  <button class="sh-btn" data-share="twitter"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></button>
                  <button class="sh-btn" data-share="facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></button>
                  <button class="sh-btn" data-share="copy"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </div>

    <!-- ═══════════════════════════════════════════════
         📱 PORTRAIT MODE (TikTok Cinema)
    ═══════════════════════════════════════════════ -->
    <div id="rlPortrait" class="rl-portrait" style="display:none;">

      <!-- Portrait Top Bar -->
      <div class="rp-top">
        <button class="rp-icon-btn" id="rpBack" aria-label="Back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <div class="rp-brand">
          <span class="rp-brand-grad">Ani</span><span class="rp-brand-w">Tube</span><span class="rp-brand-grad">Buzz</span>
        </div>
        <div class="rp-menu-wrap">
          <button class="rp-icon-btn" id="rpMenuBtn" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
          </button>
          <div class="rp-menu" id="rpMenu">
            <button class="rp-menu-item" data-action="save">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              <span>Save</span>
            </button>
            <button class="rp-menu-item" data-action="copy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Link</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Portrait Scroller -->
      <div id="rpScroller" class="rp-scroller"></div>

      <!-- Portrait progress -->
      <div id="rpProgress" class="rp-progress">
        <div class="rp-progress-track"><div class="rp-progress-fill" id="rpProgressFill"></div></div>
        <div class="rp-progress-count" id="rpProgressCount">1 / 1</div>
      </div>

    </div>

    <!-- ═══ TOAST ═══ -->
    <div id="rlToast" class="rl-toast"></div>

  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  // ═══════════════════════════════════════════════
  // ELEMENTS
  // ═══════════════════════════════════════════════
  var $ = function(id) { return document.getElementById(id); };
  var loader = $('rlLoader'), notFound = $('rlNotFound');
  var landscape = $('rlLandscape'), portrait = $('rlPortrait');
  var toast = $('rlToast');

  // Landscape els
  var lBg = $('rlBg'), lPoster = $('rlPosterImg'), lPosterPlay = $('rlPosterPlay');
  var lTitle = $('rlTitle'), lBadges = $('rlBadges'), lMeta = $('rlMeta'), lSyno = $('rlSyno');
  var lWatchBtn = $('rlWatchBtn'), lSaveBtn = $('rlSaveBtn'), lSaveLabel = $('rlSaveLabel'), lCopyBtn = $('rlCopyBtn');
  var lPlayerBlock = $('rlPlayerBlock'), lPlayerFrame = $('rlPlayerFrame'), lClosePlayer = $('rlClosePlayer');
  var lFullDesc = $('rlFullDesc'), lInfoList = $('rlInfoList');
  var lRelatedList = $('rlRelatedList'), lCatsTabs = $('rlCatsTabs');

  // Portrait els
  var pScroller = $('rpScroller'), pProgress = $('rpProgress');
  var pProgressFill = $('rpProgressFill'), pProgressCount = $('rpProgressCount');
  var pBack = $('rpBack'), pMenuBtn = $('rpMenuBtn'), pMenu = $('rpMenu');

  // State
  var currentVideo = null;
  var allVideos = [];
  var relatedByType = {};
  var portraitCurrentIdx = 0;

  // ═══════════════════════════════════════════════
  // HELPERS
  // ═══════════════════════════════════════════════
  function esc(s) { return String(s || '').replace(/[&<>"']/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function trunc(s, n) { s = String(s || ''); return s.length > n ? s.slice(0, n).trim() + '…' : s; }
  function fmt(d) { try { if (!d) return 'N/A'; var x = new Date(d); if (isNaN(x.getTime())) return 'N/A'; return x.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }); } catch(e) { return 'N/A'; } }
  function cap(s) { try { if (!s) return ''; var str = String(s).replace(/_/g, ' '); return str.charAt(0).toUpperCase() + str.slice(1); } catch(e) { return String(s || ''); } }

  // ═══════════════════════════════════════════════
  // 🎯 ASPECT DETECTION
  // ═══════════════════════════════════════════════
  function isPortrait(video) {
    if (!video) return false;
    var source = (video.source || '').toLowerCase();
    var type = (video.type || '').toLowerCase();
    var title = (video.title || '').toLowerCase();
    var url = (video.embedUrl || '').toLowerCase();
    var duration = video.duration || 0;

    // Explicit portrait sources
    if (source === 'tiktok' || source === 'instagram' || source === 'reels') return true;

    // Type-based
    if (type === 'shorts' || type === 'reels' || type === 'short') return true;

    // Title / URL hints
    if (/#shorts?\b|\bshorts?\b|\breels?\b|vertical\s*video/i.test(title)) return true;
    if (/\/shorts\//.test(url)) return true;

    // Duration hint (very short = likely portrait)
    if (duration && duration > 0 && duration < 90) return true;

    // Default: landscape
    return false;
  }

  // ═══════════════════════════════════════════════
  // 💾 SAVE / COPY / SHARE
  // ═══════════════════════════════════════════════
  function isVideoSaved(vid) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      return saved.some(function(x) { return x.id === vid; });
    } catch(e) { return false; }
  }

  function toggleSave(video) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      var idx = saved.findIndex(function(x) { return x.id === video.id; });
      if (idx >= 0) {
        saved.splice(idx, 1);
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        showToast('Removed from saved', '✕');
        return false;
      } else {
        saved.push({
          id: video.id, title: video.title, thumbnail: video.thumbnail,
          channel: video.channel, type: video.type, savedAt: Date.now()
        });
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        showToast('Saved to library', '✓');
        notifySafiya('save', video);
        return true;
      }
    } catch(e) { return false; }
  }

  function copyCurrentLink() {
    try {
      navigator.clipboard.writeText(window.location.href);
      showToast('Link copied', '✓');
    } catch(e) {
      showToast('Copy failed', '✕');
    }
  }

  function showToast(msg, icon) {
    toast.innerHTML = '<span class="rl-toast-ic">' + (icon || '✓') + '</span><span>' + esc(msg) + '</span>';
    toast.classList.add('rl-toast-show');
    setTimeout(function() { toast.classList.remove('rl-toast-show'); }, 2200);
  }

  // ═══════════════════════════════════════════════
  // 💜 SAFIYA INTEGRATION
  // ═══════════════════════════════════════════════
  function notifySafiya(type, video) {
    try {
      var deviceId = '';
      try { deviceId = localStorage.getItem('safiya_v13:device_id') || ''; } catch(e) {}
      var memoryKey = deviceId ? 'safiya_v13:memory:' + deviceId : null;
      var memRaw = null;
      if (memoryKey) memRaw = localStorage.getItem(memoryKey);
      if (!memRaw) memRaw = localStorage.getItem('safiya_memory');
      var memory = memRaw ? JSON.parse(memRaw) : {};

      if (!memory.behavior) memory.behavior = {};
      if (!memory.behavior.watchHistory) memory.behavior.watchHistory = [];
      if (!memory.behavior.savedVideos) memory.behavior.savedVideos = [];

      var record = {
        id: video.id, title: video.title, type: video.type || 'video',
        channel: video.channel || '', source: video.source || '',
        time: Date.now(), action: type
      };

      if (type === 'save') {
        memory.behavior.savedVideos.unshift(record);
        memory.behavior.savedVideos = memory.behavior.savedVideos.slice(0, 40);
      } else {
        memory.behavior.watchHistory.unshift(record);
        memory.behavior.watchHistory = memory.behavior.watchHistory.slice(0, 40);
      }
      memory.behavior.currentlyWatching = record;

      if (memoryKey) localStorage.setItem(memoryKey, JSON.stringify(memory));
      localStorage.setItem('safiya_memory', JSON.stringify(memory));

      window.dispatchEvent(new CustomEvent('safiya:video-event', {
        detail: { action: type, video: video, title: video.title, type: video.type }
      }));

      if (window.Safiya && typeof window.Safiya.say === 'function') {
        var lines = {
          save: ['saved that? nice pick', 'good taste ✨', 'adding to your library 💜'],
          watch: {
            movies: ['movie mode activated 🍿', 'peak cinema', 'good taste bestie'],
            kdrama: ['k-drama? im so here 💕', 'plot better be crazy', 'chemistry incoming'],
            donghua: ['ooh donghua? underrated fr', 'animation slaps', 'cultivation arcs hit'],
            anime: ['elite taste 👀', 'im invested bestie', 'the vibes ✨']
          }
        };
        var msgList = type === 'save' ? lines.save : (lines.watch[video.type] || lines.watch.anime);
        var msg = msgList[Math.floor(Math.random() * msgList.length)];
        setTimeout(function() { window.Safiya.say(msg, 4200); }, 400);
      }
    } catch(err) { console.warn('Safiya notify failed:', err); }
  }

  // ═══════════════════════════════════════════════
  // 🚀 SMART BACK NAVIGATION
  // ═══════════════════════════════════════════════
  function smartGoBack() {
    var ref = document.referrer;
    var thisOrigin = window.location.origin;
    if (ref && ref.indexOf(thisOrigin) === 0 && ref !== window.location.href) {
      window.history.back();
    } else if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '/';
    }
  }

  // ═══════════════════════════════════════════════
  // 🎬 LANDSCAPE MODE RENDERING
  // ═══════════════════════════════════════════════
  function renderLandscape(video) {
    try { document.title = (video.title || 'Watch') + ' - AniTube Buzz'; } catch(e) {}

    // Background & poster
    if (video.thumbnail) {
      if (lBg) lBg.style.backgroundImage = 'url(' + video.thumbnail + ')';
      if (lPoster) { lPoster.src = video.thumbnail; lPoster.alt = video.title || ''; }
    }

    // Title
    if (lTitle) lTitle.textContent = video.title || 'Untitled';

    // Badges
    var badges = [];
    if (video.isNew) badges.push('<span class="rl-b rl-b-new"><span class="rl-dot"></span>NEW</span>');
    if (video.isOfficial) badges.push('<span class="rl-b rl-b-off">✓ OFFICIAL</span>');
    badges.push('<span class="rl-b rl-b-hd">HD</span>');
    if (video.type) badges.push('<span class="rl-b rl-b-type">' + esc((video.type || '').toUpperCase()) + '</span>');
    if (lBadges) lBadges.innerHTML = badges.join('');

    // Meta
    var meta = [];
    if (video.channel) meta.push(esc(video.channel));
    if (video.publishedAt) meta.push(fmt(video.publishedAt));
    if (video.episodeNumber) meta.push('Episode ' + video.episodeNumber);
    if (lMeta) lMeta.innerHTML = meta.map(function(x) { return '<span>' + x + '</span>'; }).join('<span class="mp-sep">·</span>');

    // Synopsis
    var syn = video.description || 'Enjoy this ' + (video.type || 'video') + ' on AniTubeBuzz.';
    if (lSyno) lSyno.textContent = trunc(syn, 250);
    if (lFullDesc) lFullDesc.textContent = syn;

    // Info list
    var info = [
      ['Type', video.type ? cap(video.type) : 'Video'],
      ['Channel', video.channel || 'Unknown'],
      ['Published', video.publishedAt ? fmt(video.publishedAt) : 'N/A'],
      ['Episode', video.episodeNumber || 'N/A'],
      ['Quality', 'HD']
    ];
    if (lInfoList) lInfoList.innerHTML = info.map(function(r) {
      return '<div class="ir"><span class="ir-l">' + esc(r[0]) + '</span><span class="ir-v">' + esc(String(r[1])) + '</span></div>';
    }).join('');

    // Save button state
    updateSaveButton(video);
  }

  function updateSaveButton(video) {
    if (!lSaveLabel) return;
    lSaveLabel.textContent = isVideoSaved(video.id) ? 'Saved' : 'Save';
  }

  function playLandscapeVideo(video) {
    if (!lPlayerBlock || !lPlayerFrame) return;
    lPlayerBlock.style.display = 'block';
    lPlayerFrame.innerHTML = '<div class="pl-load-msg"><div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div><span style="margin-left:12px;color:#fff;">Loading video...</span></div>';

    setTimeout(function() { lPlayerBlock.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 60);

    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=0&ui-logo=0&ui-start-screen-info=0&sharing-enable=0&queue-enable=0';
    } else if (video.source === 'youtube') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&modestbranding=1&rel=0&showinfo=0&playsinline=1';
    }

    var brand = '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player</span></div>';
    lPlayerFrame.innerHTML = brand;

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');
    lPlayerFrame.appendChild(iframe);

    // Notify Safiya after 3s of watching
    setTimeout(function() { notifySafiya('watch', video); }, 3000);
  }

  // ═══════════════════════════════════════════════
  // 🎨 RELATED VIDEO CARD (like episode card)
  // ═══════════════════════════════════════════════
  function buildRelatedCard(v, idx) {
    var animDelay = ((idx % 12) * 40) + 'ms';
    var thumb = v.thumbnail || '';
    var imgHtml = thumb
      ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" class="at-thumb-img" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.6s ease, filter 0.35s ease;" />'
      : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.25),rgba(232,121,249,0.15),rgba(125,211,252,0.2));"></div>';

    var typeBadge = v.type ? '<div style="position:absolute;top:8px;left:8px;padding:4px 9px;background:linear-gradient(135deg,#c084fc,#e879f9);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:800;letter-spacing:0.08em;border-radius:6px;z-index:6;box-shadow:0 3px 10px rgba(192,132,252,0.5);">' + esc((v.type || '').toUpperCase()) + '</div>' : '';
    var newBadge = v.isNew ? '<div style="position:absolute;top:8px;right:8px;padding:3px 8px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.55rem;font-weight:800;border-radius:5px;z-index:6;">NEW</div>' : '';

    return '<a href="/reels/' + esc(v.id) + '" class="at-ep-card rl-related-card" ' +
      'style="text-decoration:none;color:inherit;position:relative;cursor:pointer;background:transparent;animation:atCardIn 0.5s ease backwards;animation-delay:' + animDelay + ';">' +
      '<div class="at-thumb-wrap" style="position:relative;width:100%;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#0a0517;border:1px solid rgba(192,132,252,0.35);box-shadow:0 8px 20px rgba(0,0,0,0.4);transition:all 0.35s ease;">' +
        imgHtml +
        '<div class="at-shine" style="position:absolute;top:0;left:-80%;width:60%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,0.2),transparent);z-index:3;transition:left 0.8s ease;pointer-events:none;"></div>' +
        '<div class="at-overlay" style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(10,5,23,0.85) 100%);opacity:0;transition:opacity 0.3s ease;pointer-events:none;z-index:3;"></div>' +
        '<div class="at-play-wrap" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.4);width:52px;height:52px;z-index:5;opacity:0;transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none;">' +
          '<div style="position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,0.8);animation:atPlayRing 2s ease-out infinite;"></div>' +
          '<div style="position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:3px;box-shadow:0 10px 30px rgba(192,132,252,0.7),0 0 40px rgba(232,121,249,0.5);z-index:2;">' +
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
          '</div>' +
        '</div>' +
        typeBadge +
        newBadge +
      '</div>' +
      '<div style="padding:10px 4px 4px;position:relative;z-index:1;">' +
        '<h4 class="at-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.85rem;font-weight:700;color:var(--text-primary);margin:0 0 4px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;">' + esc(v.title || 'Video') + '</h4>' +
        '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.66rem;color:var(--text-muted);opacity:0.75;">' + esc(v.channel || 'Channel') + '</div>' +
      '</div>' +
    '</a>';
  }

  function renderRelated(videos, currentType) {
    if (!lRelatedList) return;
    // Group by type
    relatedByType = {};
    videos.forEach(function(v) {
      var t = v.type || 'other';
      if (!relatedByType[t]) relatedByType[t] = [];
      relatedByType[t].push(v);
    });

    var types = Object.keys(relatedByType);
    if (!types.length) {
      lRelatedList.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);">No related videos.</div>';
      return;
    }

    // Move current type first
    if (currentType && relatedByType[currentType]) {
      types = types.filter(function(t) { return t !== currentType; });
      types.unshift(currentType);
    }

    // Category tabs
    if (lCatsTabs) {
      lCatsTabs.innerHTML = types.map(function(t, i) {
        return '<button class="rl-ct' + (i === 0 ? ' active' : '') + '" data-cat="' + esc(t) + '">' + esc(cap(t)) + ' <span class="ct-c">' + relatedByType[t].length + '</span></button>';
      }).join('');

      lCatsTabs.querySelectorAll('.rl-ct').forEach(function(btn) {
        btn.addEventListener('click', function() {
          lCatsTabs.querySelectorAll('.rl-ct').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          showCategory(btn.dataset.cat);
        });
      });
    }

    showCategory(types[0]);
  }

  function showCategory(cat) {
    var list = (relatedByType[cat] || []).filter(function(v) { return v.id !== id; });
    if (!list.length) {
      lRelatedList.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);">No videos in this category.</div>';
      return;
    }
    lRelatedList.innerHTML = list.slice(0, 12).map(function(v, i) { return buildRelatedCard(v, i); }).join('');
  }

  // ═══════════════════════════════════════════════
  // 📱 PORTRAIT MODE RENDERING (TikTok)
  // ═══════════════════════════════════════════════
  function buildPortraitSlot(video, idx) {
    var slot = document.createElement('div');
    slot.className = 'rp-slot';
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;

    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="rp-slot-bg" loading="lazy" />' : '';

    slot.innerHTML =
      thumb +
      '<div class="rp-slot-tint"></div>' +
      '<div class="rp-slot-frame">' +
        '<div class="rp-slot-video" data-loaded="0"></div>' +
        '<div class="rp-slot-loading"><div class="rp-slot-spinner"></div></div>' +
      '</div>' +
      '<div class="rp-slot-gradient"></div>' +
      '<div class="rp-slot-info">' +
        '<div class="rp-slot-user">' +
          '<div class="rp-slot-avatar"><div class="rp-slot-avatar-inner">▶</div></div>' +
          '<div class="rp-slot-user-text">' +
            '<div class="rp-slot-username">' + esc(video.channel || 'AniTube') + '</div>' +
            '<div class="rp-slot-type">' + esc((video.type || 'video').toUpperCase()) + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="rp-slot-caption">' + esc(video.title || 'Video') + '</div>' +
      '</div>';

    return slot;
  }

  function loadPortraitVideo(idx) {
    var slot = pScroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded === '1') return;
    videoDiv.dataset.loaded = '1';

    var video = allVideos[idx];
    if (!video || !video.embedUrl) return;

    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1';
    } else if (video.source === 'youtube') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0&playsinline=1';
    }

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');
    iframe.onload = function() {
      if (loading) loading.style.opacity = '0';
      setTimeout(function() { if (loading) loading.style.display = 'none'; }, 400);
    };
    videoDiv.appendChild(iframe);
  }

  function unloadPortraitVideo(idx) {
    var slot = pScroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded !== '1') return;
    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    if (loading) { loading.style.display = 'flex'; loading.style.opacity = '1'; }
  }

  var portraitNotifyTimeout = null;
  function setPortraitCurrent(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length || newIdx === portraitCurrentIdx) return;
    portraitCurrentIdx = newIdx;

    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' · AniTubeBuzz';
        currentVideo = v;
      }
    } catch(e) {}

    for (var i = 0; i < allVideos.length; i++) {
      if (Math.abs(i - newIdx) <= 1) loadPortraitVideo(i);
      else if (Math.abs(i - newIdx) > 2) unloadPortraitVideo(i);
    }

    clearTimeout(portraitNotifyTimeout);
    portraitNotifyTimeout = setTimeout(function() {
      if (allVideos[newIdx]) notifySafiya('watch', allVideos[newIdx]);
    }, 2000);

    updatePortraitProgress();
  }

  function updatePortraitProgress() {
    if (!pProgress || !allVideos.length) return;
    var pct = ((portraitCurrentIdx + 1) / allVideos.length) * 100;
    if (pProgressFill) pProgressFill.style.height = pct + '%';
    if (pProgressCount) pProgressCount.textContent = (portraitCurrentIdx + 1) + ' / ' + allVideos.length;
  }

  var portraitObserver = null;
  function setupPortraitObserver() {
    if (portraitObserver) portraitObserver.disconnect();
    portraitObserver = new IntersectionObserver(function(entries) {
      var mostVisible = null, maxRatio = 0;
      entries.forEach(function(entry) {
        if (entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          mostVisible = entry.target;
        }
      });
      if (mostVisible && maxRatio > 0.6) {
        var idx = parseInt(mostVisible.dataset.idx);
        if (!isNaN(idx) && idx !== portraitCurrentIdx) setPortraitCurrent(idx);
      }
    }, { root: pScroller, threshold: [0.3, 0.6, 0.9] });

    pScroller.querySelectorAll('.rp-slot').forEach(function(s) { portraitObserver.observe(s); });
  }

  // ═══════════════════════════════════════════════
  // 🎯 INITIALIZE MODE
  // ═══════════════════════════════════════════════
  function initPortraitMode() {
    document.body.classList.add('rl-portrait-mode');
    portrait.style.display = 'block';

    // Only keep portrait-oriented videos for scroll
    var portraitVideos = allVideos.filter(isPortrait);
    // If found video isn't in list, add first
    if (!portraitVideos.find(function(v) { return v.id === currentVideo.id; })) {
      portraitVideos.unshift(currentVideo);
    }
    // Move current to top
    var idx = portraitVideos.findIndex(function(v) { return v.id === currentVideo.id; });
    if (idx > 0) {
      var arr = portraitVideos.splice(idx, 1);
      portraitVideos.unshift(arr[0]);
    }
    allVideos = portraitVideos;

    pScroller.innerHTML = '';
    allVideos.forEach(function(v, i) { pScroller.appendChild(buildPortraitSlot(v, i)); });

    portraitCurrentIdx = -1;
    setPortraitCurrent(0);
    setupPortraitObserver();

    // Menu handlers
    pMenuBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      pMenu.classList.toggle('rp-menu-open');
    });
    document.addEventListener('click', function(e) {
      if (!pMenuBtn.contains(e.target) && !pMenu.contains(e.target)) {
        pMenu.classList.remove('rp-menu-open');
      }
    });
    pMenu.addEventListener('click', function(e) {
      var btn = e.target.closest('.rp-menu-item');
      if (!btn) return;
      var action = btn.dataset.action;
      if (action === 'save') toggleSave(currentVideo);
      else if (action === 'copy') copyCurrentLink();
      pMenu.classList.remove('rp-menu-open');
    });

    pBack.addEventListener('click', smartGoBack);

    // Keyboard
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowDown' || e.key === 'j') {
        e.preventDefault();
        var next = pScroller.querySelector('[data-idx="' + (portraitCurrentIdx + 1) + '"]');
        if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (e.key === 'ArrowUp' || e.key === 'k') {
        e.preventDefault();
        var prev = pScroller.querySelector('[data-idx="' + (portraitCurrentIdx - 1) + '"]');
        if (prev) prev.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (e.key === 'Escape') {
        smartGoBack();
      }
    });
  }

  function initLandscapeMode() {
    document.body.classList.add('rl-landscape-mode');
    landscape.style.display = 'block';
    renderLandscape(currentVideo);

    // Button handlers
    if (lWatchBtn) lWatchBtn.addEventListener('click', function() { playLandscapeVideo(currentVideo); });
    if (lPosterPlay) lPosterPlay.addEventListener('click', function() { playLandscapeVideo(currentVideo); });
    if (lSaveBtn) lSaveBtn.addEventListener('click', function() {
      toggleSave(currentVideo);
      updateSaveButton(currentVideo);
    });
    if (lCopyBtn) lCopyBtn.addEventListener('click', copyCurrentLink);
    if (lClosePlayer) lClosePlayer.addEventListener('click', function() {
      if (lPlayerBlock) lPlayerBlock.style.display = 'none';
      if (lPlayerFrame) lPlayerFrame.innerHTML = '';
    });

    // Share buttons
    document.querySelectorAll('.sh-btn').forEach(function(b) {
      b.addEventListener('click', function() {
        var t = b.dataset.share, u = window.location.href, x = (currentVideo.title || 'Video') + ' on AniTube Buzz';
        if (t === 'twitter') window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(x) + '&url=' + encodeURIComponent(u), '_blank');
        else if (t === 'facebook') window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u), '_blank');
        else if (t === 'copy') { copyCurrentLink(); }
      });
    });

    // Render related videos
    renderRelated(allVideos, currentVideo.type);
  }

  // ═══════════════════════════════════════════════
  // 🚀 INIT
  // ═══════════════════════════════════════════════
  async function init() {
    try {
      var fetched = [];
      var found = null;

      for (var i = 1; i <= 3; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          if (!res.ok) continue;
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) found = data.videos.find(function(v) { return v.id === id; });
          }
        } catch(e) {}
      }

      if (!found && fetched.length > 0) found = fetched[0];

      if (!found) {
        loader.style.display = 'none';
        notFound.style.display = 'flex';
        return;
      }

      // Dedupe
      var seen = {};
      allVideos = fetched.filter(function(v) {
        if (!v || !v.id || seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });

      // Add current to list if missing
      if (!allVideos.find(function(v) { return v.id === found.id; })) {
        allVideos.unshift(found);
      }

      currentVideo = found;

      loader.style.display = 'none';

      // ═══ DECIDE MODE ═══
      if (isPortrait(currentVideo)) {
        initPortraitMode();
      } else {
        initLandscapeMode();
      }

    } catch(err) {
      console.error('[Reels]', err);
      loader.style.display = 'none';
      notFound.style.display = 'flex';
    }
  }

  init();
})();
</script>

