---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
const animeSlug = slug || '';

// Fetch anime info from Kitsu (parallel with external search)
let anime = null;
let externalMatch = null;

try {
  const url = new URL('/api/anime', Astro.url.origin);
  url.searchParams.set('action', 'detail');
  url.searchParams.set('slug', animeSlug);
  const res = await fetch(url);
  if (res.ok) {
    const data = await res.json();
    if (data.success && data.anime) anime = data.anime;
  }
} catch (e) {}

// Try to find on AnimoTVSlash SERVER-SIDE for instant redirect
if (anime) {
  try {
    const cleanTitle = (anime.title || '').split(':')[0].split('|')[0].trim();
    const extUrl = new URL('/api/anime-external', Astro.url.origin);
    extUrl.searchParams.set('action', 'find');
    extUrl.searchParams.set('q', cleanTitle);
    const extRes = await fetch(extUrl);
    if (extRes.ok) {
      const extData = await extRes.json();
      if (extData.success && extData.found && extData.firstEpisodeId) {
        externalMatch = extData;
      }
    }
  } catch (e) {}
}

// If found on external — INSTANT REDIRECT via meta refresh + JS
if (externalMatch && externalMatch.firstEpisodeId) {
  return Astro.redirect(`/reels/${externalMatch.firstEpisodeId}`);
}

const animeTitle = anime?.title || animeSlug.replace(/-/g, ' ');
const animeImage = anime?.image || anime?.coverImage || '';
const animeCover = anime?.coverImage || anime?.image || '';
const animeSynopsis = anime?.synopsis || anime?.description || '';
const animeYear = anime?.year || '';
const animeScore = anime?.score || '';
const animeEpisodes = anime?.episodes || '';
const animeStatus = anime?.status || '';
---

<BaseLayout title={`${animeTitle} | AniTubeBuzz`}>
  <Header slot="header" />

  <section class="ar-section">
    <div class="ar-bg" style={animeCover ? `background-image:url(${animeCover});` : ''}></div>
    <div class="ar-container">
      <div class="ar-card">
        <div class="ar-poster-wrap">
          {animeImage ? (
            <img class="ar-poster" src={animeImage} alt={animeTitle} />
          ) : (
            <div class="ar-poster-placeholder">🎬</div>
          )}
          <div class="ar-poster-glow"></div>
        </div>
        <div class="ar-info">
          <div class="ar-badges">
            <span class="ar-badge ar-badge-anime">🎌 ANIME</span>
            {animeYear && <span class="ar-badge">{animeYear}</span>}
            {animeScore && <span class="ar-badge ar-badge-score">★ {animeScore}</span>}
            {animeStatus && <span class="ar-badge">{animeStatus.toUpperCase()}</span>}
          </div>
          <h1 class="ar-title">{animeTitle}</h1>
          {animeEpisodes && (
            <div class="ar-eps">
              <span class="ar-eps-num">{animeEpisodes}</span>
              <span class="ar-eps-lbl">Episodes</span>
            </div>
          )}
          <div class="ar-status">
            <div class="ar-status-icon">😢</div>
            <div class="ar-status-text">
              <div class="ar-status-title">Not available yet</div>
              <div class="ar-status-sub">This anime might not be added to our library yet</div>
            </div>
          </div>
          <div class="ar-actions">
            <button class="ar-btn ar-btn-primary" id="retryBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
              <span>Retry</span>
            </button>
            <a class="ar-btn ar-btn-secondary" href="/">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Back to Home</span>
            </a>
          </div>
        </div>
      </div>
      {animeSynopsis && (
        <div class="ar-synopsis">
          <div class="ar-synopsis-title">Synopsis</div>
          <p>{animeSynopsis}</p>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />

  <style is:global>
    .ar-section {
      position: relative;
      min-height: calc(100vh - 80px);
      padding: 60px 0 80px;
      overflow: hidden;
    }
    .ar-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: 0.15;
      filter: blur(40px);
      transform: scale(1.2);
      z-index: 0;
    }
    .ar-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10,5,23,0.6) 0%, #0a0517 100%);
    }
    .ar-container {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .ar-card {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 40px;
      align-items: start;
      background: rgba(28, 15, 61, 0.4);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(192, 132, 252, 0.15);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }
    .ar-poster-wrap { position: relative; width: 100%; }
    .ar-poster {
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
      border-radius: 14px;
      display: block;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
      position: relative;
      z-index: 2;
    }
    .ar-poster-placeholder {
      width: 100%;
      aspect-ratio: 3/4;
      background: linear-gradient(135deg, #1a0f3d, #2d1b5e);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
      opacity: 0.4;
    }
    .ar-poster-glow {
      position: absolute;
      inset: -20px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      border-radius: 20px;
      opacity: 0.4;
      filter: blur(30px);
      z-index: 1;
      animation: arGlow 3s ease-in-out infinite;
    }
    @keyframes arGlow {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.6; }
    }
    .ar-info {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .ar-badges { display: flex; flex-wrap: wrap; gap: 8px; }
    .ar-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 11px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.08);
      color: rgba(255, 255, 255, 0.85);
      font-size: 11px;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.5px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .ar-badge-anime {
      background: linear-gradient(135deg, #c084fc, #e879f9);
      color: #fff;
      border: 0;
    }
    .ar-badge-score {
      background: linear-gradient(135deg, #fbbf24, #f97316);
      color: #fff;
      border: 0;
    }
    .ar-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      color: #fff;
      margin: 0;
      line-height: 1.15;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #fff 0%, #c084fc 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .ar-eps {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(192, 132, 252, 0.15);
      border: 1px solid rgba(192, 132, 252, 0.3);
      border-radius: 20px;
      width: fit-content;
    }
    .ar-eps-num {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: #c084fc;
    }
    .ar-eps-lbl {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.7);
      font-family: 'JetBrains Mono', monospace;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .ar-status {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px 18px;
      background: rgba(10, 5, 23, 0.5);
      border: 1px solid rgba(192, 132, 252, 0.2);
      border-radius: 14px;
      margin-top: 8px;
    }
    .ar-status-icon {
      font-size: 32px;
      flex-shrink: 0;
    }
    .ar-status-text { min-width: 0; flex: 1; }
    .ar-status-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 2px;
    }
    .ar-status-sub {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.6);
      font-family: 'JetBrains Mono', monospace;
    }
    .ar-actions {
      display: flex;
      gap: 10px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .ar-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 22px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      border: 0;
      text-decoration: none;
      font-family: inherit;
      transition: all 0.2s;
    }
    .ar-btn-primary {
      background: linear-gradient(135deg, #c084fc, #e879f9);
      color: #fff;
    }
    .ar-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(192, 132, 252, 0.5);
    }
    .ar-btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    .ar-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }
    .ar-synopsis {
      margin-top: 30px;
      background: rgba(28, 15, 61, 0.4);
      border: 1px solid rgba(192, 132, 252, 0.15);
      border-radius: 16px;
      padding: 24px;
    }
    .ar-synopsis-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #c084fc;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .ar-synopsis p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 14px;
      line-height: 1.7;
      margin: 0;
      white-space: pre-wrap;
    }
    @media (max-width: 768px) {
      .ar-card {
        grid-template-columns: 1fr;
        padding: 20px;
        gap: 24px;
      }
      .ar-poster-wrap {
        max-width: 220px;
        margin: 0 auto;
      }
      .ar-container { padding: 0 16px; }
      .ar-section { padding: 30px 0; }
    }
  </style>

  <script is:inline>
    (function() {
      var retryBtn = document.getElementById('retryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() {
          window.location.reload();
        });
      }
    })();
  </script>
</BaseLayout>
