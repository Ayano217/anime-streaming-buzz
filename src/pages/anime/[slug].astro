---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
---

<BaseLayout 
  title="Anime Details"
  description="Watch anime episodes online in premium HD quality on AniTube Buzz."
>
  <Header slot="header" />
  
  <div class="ap-wrap">
    <div id="apLoader" class="ap-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p id="apLoaderText">Loading anime details...</p>
    </div>
    
    <div id="apNotFound" class="ap-nf" style="display:none;">
      <div class="nf-ic"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></div>
      <h1>Anime Not Found</h1>
      <p id="apNfMsg">This anime doesn't exist or couldn't be loaded.</p>
      <div class="nf-btns">
        <a href="/" class="nf-bk">← Back to Homepage</a>
        <button onclick="location.reload()" class="nf-rt">🔄 Try Again</button>
      </div>
    </div>
    
    <div id="apContent" style="display:none;">
      <div class="ap-hero">
        <div class="ap-bg" id="apBg"></div>
        <div class="ap-fade"></div>
        <div class="container">
          <div class="ap-hero-in">
            <div class="ap-poster">
              <img id="apPosterImg" alt="" />
            </div>
            <div class="ap-info">
              <div class="ap-badges" id="apBadges"></div>
              <h1 class="ap-title" id="apTitle">Loading...</h1>
              <div class="ap-meta" id="apMeta"></div>
              <div class="ap-genres" id="apGenres"></div>
              <p class="ap-syno" id="apSyno"></p>
              <div class="ap-actions">
                <button class="ap-btn ap-btn-p" id="apWatchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="ap-btn ap-btn-s" id="apInfoBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                  <span>More Info</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <section class="section-block ap-player" id="apPlayerBlock" style="display:none;">
        <div class="container">
          <div class="pl-head">
            <h2 class="section-title" id="apPlayerTitle"><span class="grad-text">Now Playing</span></h2>
            <button class="pl-close" id="apClosePlayer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="pl-wrap">
            <div id="apPlayerFrame" class="pl-frame">
              <div class="pl-load">Loading player...</div>
            </div>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-details" id="apDetailsBlock">
        <div class="container">
          <div class="ap-grid">
            <div class="ap-main">
              <div class="ap-sec">
                <h2 class="ap-sh">Synopsis</h2>
                <p class="ap-desc" id="apFullSyno">Loading...</p>
              </div>
              
              <div class="ap-sec">
                <div class="ap-eps-head">
                  <h2 class="ap-sh">Episodes</h2>
                  <div class="ap-eps-sort" id="apSortInfo"></div>
                </div>
                <div class="ap-seasons" id="apSeasonsTabs"></div>
                <div class="ap-eps" id="apEpisodesList">
                  <div class="ep-ld">
                    <div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div>
                    <span>Loading episodes...</span>
                  </div>
                </div>
              </div>
            </div>
            
            <aside class="ap-side">
              <div class="ap-card">
                <h3 class="ac-t">Information</h3>
                <div class="ac-list" id="apInfoList"></div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Where to Watch</h3>
                <div class="ac-list">
                  <a href="#" class="ap-stream" data-platform="crunchyroll">
                    <div class="st-lg cr">CR</div><span>Crunchyroll</span>
                  </a>
                  <a href="#" class="ap-stream" data-platform="netflix">
                    <div class="st-lg nf">N</div><span>Netflix</span>
                  </a>
                  <a href="#" class="ap-stream" data-platform="hulu">
                    <div class="st-lg hu">Hulu</div><span>Hulu</span>
                  </a>
                </div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Share</h3>
                <div class="ap-share">
                  <button class="sh-btn" data-share="twitter">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </button>
                  <button class="sh-btn" data-share="facebook">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
                  </button>
                  <button class="sh-btn" data-share="copy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-related">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">You Might Also Like</span></h2>
          <div id="apRelatedGrid" class="rel-grid">
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ slug }}>
(async function(){
  function esc(s){try{return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}catch(e){return'';}}
  function fmt(d){try{if(!d)return'N/A';var x=new Date(d);if(isNaN(x.getTime()))return'N/A';return x.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}catch(e){return'N/A';}}
  function cap(s){try{if(!s)return'';var str=String(s).replace(/_/g,' ');return str.charAt(0).toUpperCase()+str.slice(1);}catch(e){return String(s||'');}}

  async function fetchJSON(url,timeoutMs){
    timeoutMs=timeoutMs||10000;
    try{
      var c=new AbortController();var t=setTimeout(function(){c.abort();},timeoutMs);
      var r=await fetch(url,{signal:c.signal});clearTimeout(t);
      if(!r.ok)return null;return await r.json();
    }catch(e){return null;}
  }

  async function loadAnimeData(loaderText){
    if(loaderText)loaderText.textContent='Loading anime details...';
    var j=await fetchJSON('/api/anime?action=detail&slug='+encodeURIComponent(slug),10000);
    if(j&&j.success&&j.anime)return j.anime;
    if(loaderText)loaderText.textContent='Searching for anime...';
    var searchTerm=slug.replace(/-/g,' ');
    var s=await fetchJSON('/api/anime?action=search&q='+encodeURIComponent(searchTerm),10000);
    if(s&&s.success&&s.anime&&s.anime.length>0){
      var exact=s.anime.find(function(a){return a.slug===slug;});
      var pick=exact||s.anime[0];
      var full=await fetchJSON('/api/anime?action=detail&id='+pick.id,8000);
      if(full&&full.success&&full.anime)return full.anime;
      return pick;
    }
    return null;
  }

  async function playVideo(query,title,els){
    try{
      if(!els.playerBlock||!els.playerFrame)return;
      els.playerBlock.style.display='block';
      if(els.playerTitle)els.playerTitle.innerHTML='<span class="grad-text">'+esc(title||'Now Playing')+'</span>';
      els.playerFrame.innerHTML='<div class="pl-load"><div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div><span style="margin-left:12px;">Finding best video...</span></div>';
      setTimeout(function(){els.playerBlock.scrollIntoView({behavior:'smooth',block:'start'});},50);
      
      var j=await fetchJSON('/api/youtube?q='+encodeURIComponent(query));
      var vid=(j&&j.success&&j.primary&&j.primary.videoId)?j.primary.videoId:null;
      
      if(vid){
        els.playerFrame.innerHTML=
          '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · HD</span></div>'+
          '<iframe src="https://www.youtube.com/embed/'+vid+'?autoplay=1&rel=0&modestbranding=1&iv_load_policy=3" '+
          'frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>';
      }else{
        els.playerFrame.innerHTML=
          '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · HD</span></div>'+
          '<iframe src="https://www.youtube.com/embed?listType=search&list='+encodeURIComponent(query)+'" '+
          'frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>';
      }
    }catch(e){console.error('playVideo error:',e);}
  }

  function safeRender(a,els){
    try{document.title=(a.title||'Anime')+' - AniTube Buzz';}catch(e){}
    try{if(a.image){if(els.bg)els.bg.style.backgroundImage='url('+a.image+')';if(els.poster){els.poster.src=a.image;els.poster.alt=a.title||'';}}}catch(e){}
    try{if(els.title)els.title.textContent=a.title||'Untitled';}catch(e){}
    try{
      var b=[];
      if(a.status==='current')b.push('<span class="ap-b ap-b-new"><span class="ap-dot"></span>AIRING NOW</span>');
      if(a.score!=null)b.push('<span class="ap-b ap-b-sc"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'+Number(a.score).toFixed(1)+'</span>');
      b.push('<span class="ap-b ap-b-hd">HD</span>');
      if(a.ageRating)b.push('<span class="ap-b ap-b-age">'+esc(a.ageRating)+'</span>');
      if(els.badges)els.badges.innerHTML=b.join('');
    }catch(e){}
    try{
      var m=[];
      if(a.year)m.push(String(a.year));
      if(a.episodes&&a.episodes>0)m.push(a.episodes+' Episodes');
      if(a.subtype)m.push(String(a.subtype));
      if(a.status)m.push(cap(a.status));
      if(els.meta)els.meta.innerHTML=m.map(function(x){return '<span>'+esc(x)+'</span>';}).join('<span class="mp-sep">·</span>');
    }catch(e){}
    try{if(a.genres&&Array.isArray(a.genres)&&a.genres.length>0&&els.genres){els.genres.innerHTML=a.genres.slice(0,6).map(function(g){return '<span class="ap-gp">'+esc(g)+'</span>';}).join('');}}catch(e){}
    try{
      var syn=a.description||a.synopsis||'No synopsis available.';
      if(els.syno)els.syno.textContent=syn.length>250?syn.slice(0,250)+'...':syn;
      if(els.fullSyno)els.fullSyno.textContent=syn;
    }catch(e){}
    try{
      var rows=[
        ['Type',a.subtype||'TV'],
        ['Episodes',(a.episodes&&a.episodes>0)?a.episodes:'Unknown'],
        ['Status',a.status?cap(a.status):'Unknown'],
        ['Aired',a.startDate?(fmt(a.startDate)+(a.endDate?' to '+fmt(a.endDate):' to ?')):'Unknown'],
        ['Score',a.score!=null?('⭐ '+Number(a.score).toFixed(1)+' / 10'):'N/A'],
        ['Rating',a.ageRating||'Not Rated'],
        ['Genres',(a.genres&&a.genres.length)?a.genres.join(', '):'N/A']
      ];
      if(els.infoList)els.infoList.innerHTML=rows.map(function(r){return '<div class="ir"><span class="ir-l">'+esc(r[0])+'</span><span class="ir-v">'+esc(String(r[1]))+'</span></div>';}).join('');
    }catch(e){}
    try{
      var qEnc=encodeURIComponent(a.title||'');
      document.querySelectorAll('.ap-stream').forEach(function(el){
        var p=el.dataset.platform,u='#';
        if(p==='crunchyroll')u='https://www.crunchyroll.com/search?q='+qEnc;
        else if(p==='netflix')u='https://www.netflix.com/search?q='+qEnc;
        else if(p==='hulu')u='https://www.hulu.com/search?q='+qEnc;
        el.href=u;el.target='_blank';el.rel='noopener';
      });
    }catch(e){}
  }

  function renderEpisodes(eps,title,posterFallback,els){
    try{
      if(!els.episodesList)return;
      if(!eps||!eps.length){
        els.episodesList.innerHTML='<div class="ep-empty">Episodes not available yet. Click Watch Now for the trailer!</div>';
        if(els.seasonsTabs)els.seasonsTabs.style.display='none';
        return;
      }
      
      // Update sort info
      var sortInfo=document.getElementById('apSortInfo');
      if(sortInfo)sortInfo.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 6h18M6 12h12M10 18h4"/></svg> Latest first';
      
      var seasons={};
      eps.forEach(function(e){var s=e.seasonNumber||1;if(!seasons[s])seasons[s]=[];seasons[s].push(e);});
      var nums=Object.keys(seasons).map(Number).sort(function(a,b){return a-b;});
      
      // Sort each season's episodes in REVERSE (latest first)
      nums.forEach(function(s){
        seasons[s].sort(function(a,b){return (b.number||0)-(a.number||0);});
      });
      
      if(els.seasonsTabs){
        els.seasonsTabs.innerHTML=nums.map(function(s,i){
          return '<button class="ap-st'+(i===0?' active':'')+'" data-s="'+s+'">Season '+s+' <span class="st-c">'+seasons[s].length+' EP</span></button>';
        }).join('');
      }
      
      function show(s){
        var list=seasons[s];
        els.episodesList.innerHTML=list.map(function(e,idx){
          var hasRealThumb=!!e.thumbnail;
          var thumb=e.thumbnail||posterFallback||'';
          var imgHtml=thumb?
            '<img src="'+esc(thumb)+'" alt="" loading="lazy" class="ep-img'+(hasRealThumb?'':' ep-img-fallback')+'" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"/>'+
            '<div class="ep-nt" style="display:none"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" opacity="0.4"><path d="M8 5v14l11-7z"/></svg></div>':
            '<div class="ep-nt"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" opacity="0.4"><path d="M8 5v14l11-7z"/></svg></div>';
          
          // If using poster fallback, add big episode number overlay
          var epNumOverlay=!hasRealThumb?'<div class="ep-num-big">'+e.number+'</div>':'';
          
          return '<div class="ep-i" data-n="'+e.number+'" data-t="'+esc(e.title)+'" style="animation-delay:'+((idx%12)*40)+'ms">'+
            '<div class="ep-border"></div>'+
            '<div class="ep-poster">'+
              imgHtml+
              epNumOverlay+
              '<div class="ep-ov"></div>'+
              '<div class="ep-shine"></div>'+
              '<div class="ep-pl-wrap">'+
                '<div class="ep-pl-ring"></div>'+
                '<div class="ep-pl-ring ep-pl-ring-2"></div>'+
                '<div class="ep-pl"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>'+
              '</div>'+
              '<div class="ep-nm">EP '+e.number+'</div>'+
              (e.length?'<div class="ep-dur">'+e.length+'m</div>':'')+
            '</div>'+
            '<div class="ep-info">'+
              '<h4 class="ep-t">'+esc(e.title)+'</h4>'+
              (e.airdate?'<div class="ep-m">'+fmt(e.airdate)+'</div>':'')+
            '</div>'+
          '</div>';
        }).join('');
        els.episodesList.querySelectorAll('.ep-i').forEach(function(el){
          el.addEventListener('click',function(){
            var epNum=el.dataset.n;
            var epTitle=el.dataset.t;
            playVideo(title+' episode '+epNum+' full english sub','Episode '+epNum+': '+epTitle,els);
          });
        });
      }
      
      if(els.seasonsTabs){
        els.seasonsTabs.querySelectorAll('.ap-st').forEach(function(t){
          t.addEventListener('click',function(){
            els.seasonsTabs.querySelectorAll('.ap-st').forEach(function(x){x.classList.remove('active');});
            t.classList.add('active');
            show(Number(t.dataset.s));
          });
        });
      }
      show(nums[0]);
    }catch(e){console.error('renderEpisodes:',e);}
  }

  function renderRelated(list,els){
    try{
      if(!els.relatedGrid)return;
      if(!list||!list.length){els.relatedGrid.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:2rem;grid-column:1/-1;">No related anime found.</p>';return;}
      els.relatedGrid.innerHTML=list.map(function(a){
        var img=a.image?'<img src="'+esc(a.image)+'" alt="" loading="lazy" />':'<div class="rc-no"></div>';
        return '<a href="/anime/'+esc(a.slug)+'" class="rel-c">'+
          '<div class="rc-p">'+img+'<div class="rc-pl"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div></div>'+
          '<div class="rc-t">'+esc(a.title)+'</div></a>';
      }).join('');
    }catch(e){}
  }

  function domReady(cb){if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',cb);else cb();}

  domReady(async function(){
    var els={
      loader:document.getElementById('apLoader'),
      loaderText:document.getElementById('apLoaderText'),
      notFound:document.getElementById('apNotFound'),
      nfMsg:document.getElementById('apNfMsg'),
      content:document.getElementById('apContent'),
      bg:document.getElementById('apBg'),
      poster:document.getElementById('apPosterImg'),
      title:document.getElementById('apTitle'),
      meta:document.getElementById('apMeta'),
      genres:document.getElementById('apGenres'),
      syno:document.getElementById('apSyno'),
      badges:document.getElementById('apBadges'),
      fullSyno:document.getElementById('apFullSyno'),
      infoList:document.getElementById('apInfoList'),
      seasonsTabs:document.getElementById('apSeasonsTabs'),
      episodesList:document.getElementById('apEpisodesList'),
      relatedGrid:document.getElementById('apRelatedGrid'),
      playerBlock:document.getElementById('apPlayerBlock'),
      playerFrame:document.getElementById('apPlayerFrame'),
      playerTitle:document.getElementById('apPlayerTitle'),
      closePlayer:document.getElementById('apClosePlayer'),
      watchBtn:document.getElementById('apWatchBtn'),
      infoBtn:document.getElementById('apInfoBtn'),
      detailsBlock:document.getElementById('apDetailsBlock')
    };
    
    if(!els.loader||!els.content)return;
    
    var hardTimeout=setTimeout(function(){
      if(els.loader.style.display!=='none'){
        els.loader.style.display='none';
        if(els.nfMsg)els.nfMsg.textContent='Loading timeout. Please try again.';
        if(els.notFound)els.notFound.style.display='flex';
      }
    },25000);

    try{
      var anime=await loadAnimeData(els.loaderText);
      if(!anime){
        clearTimeout(hardTimeout);
        els.loader.style.display='none';
        if(els.nfMsg)els.nfMsg.textContent='This anime could not be found in our database.';
        if(els.notFound)els.notFound.style.display='flex';
        return;
      }
      
      safeRender(anime,els);
      clearTimeout(hardTimeout);
      els.loader.style.display='none';
      els.loader.style.visibility='hidden';
      els.content.style.display='block';
      
      if(anime.id){
        fetchJSON('/api/anime?action=episodes&id='+anime.id+'&page=1',10000).then(function(epsData){
          if(epsData&&epsData.success)renderEpisodes(epsData.episodes||[],anime.title||'',anime.image||'',els);
          else renderEpisodes([],anime.title||'',anime.image||'',els);
        }).catch(function(){renderEpisodes([],anime.title||'',anime.image||'',els);});
        
        fetchJSON('/api/anime?action=list&category=popular&page=1',10000).then(function(relData){
          if(relData&&relData.success){
            var rel=(relData.anime||[]).filter(function(x){return x.slug!==slug;}).slice(0,12);
            renderRelated(rel,els);
          }else renderRelated([],els);
        }).catch(function(){renderRelated([],els);});
      }
      
      if(els.watchBtn)els.watchBtn.addEventListener('click',function(){
        playVideo((anime.title||'anime')+' anime official trailer',(anime.title||'Anime')+' - Trailer',els);
      });
      if(els.infoBtn&&els.detailsBlock)els.infoBtn.addEventListener('click',function(){
        els.detailsBlock.scrollIntoView({behavior:'smooth',block:'start'});
      });
      if(els.closePlayer)els.closePlayer.addEventListener('click',function(){
        if(els.playerBlock)els.playerBlock.style.display='none';
        if(els.playerFrame)els.playerFrame.innerHTML='';
      });
      
      document.querySelectorAll('.sh-btn').forEach(function(b){
        b.addEventListener('click',function(){
          var t=b.dataset.share,u=window.location.href,x=(anime.title||'Anime')+' on AniTube Buzz';
          if(t==='twitter')window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(x)+'&url='+encodeURIComponent(u),'_blank');
          else if(t==='facebook')window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(u),'_blank');
          else if(t==='copy'){navigator.clipboard.writeText(u);b.classList.add('cp');setTimeout(function(){b.classList.remove('cp');},1500);}
        });
      });
      
    }catch(e){
      clearTimeout(hardTimeout);
      els.loader.style.display='none';
      if(els.nfMsg)els.nfMsg.textContent='Error: '+(e.message||'Unknown');
      if(els.notFound)els.notFound.style.display='flex';
    }
  });
})();
</script>

