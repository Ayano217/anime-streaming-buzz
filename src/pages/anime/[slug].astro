  async function playVideo(query, title, els, epNumber) {
    try {
      if (!els.playerBlock || !els.playerFrame) return;
      els.playerBlock.style.display = 'block';
      if (els.playerTitle) els.playerTitle.innerHTML = '<span class="grad-text">' + esc(title || 'Now Playing') + '</span>';
      els.playerFrame.innerHTML = '<div class="pl-load"><div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div><span style="margin-left:12px;">Searching multiple sources...</span></div>';
      if (els.videoPicker) els.videoPicker.style.display = 'none';
      setTimeout(function() { els.playerBlock.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
      
      // NEW: Multi-source search
      var searchUrl = '/api/video-search?q=' + encodeURIComponent(query);
      if (epNumber) searchUrl += '&ep=' + epNumber;
      
      var j = await fetchJSON(searchUrl, 15000);
      
      if (j && j.success && j.videos && j.videos.length > 0) {
        embedMultiSource(j.videos[0], els);
        renderMultiSourcePicker(j.videos, els);
        
        // Show source count
        if (j.sources) {
          var sourcesText = Object.entries(j.sources).map(function(s) {
            return s[1] + ' ' + s[0];
          }).join(', ');
          console.log('Sources found:', sourcesText);
        }
      } else {
        // Fallback: YouTube search embed
        embedFallback(query, els);
      }
    } catch(e) {
      console.error('playVideo error:', e);
      embedFallback(query, els);
    }
  }
  
  function embedMultiSource(video, els) {
    var brand = '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · ' + esc(video.sourceLabel) + '</span></div>';
    
    els.playerFrame.innerHTML = brand;
    
    var iframe = document.createElement('iframe');
    iframe.src = video.embedUrl;
    iframe.setAttribute('width', '100%');
    iframe.setAttribute('height', '100%');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;display:block;';
    els.playerFrame.appendChild(iframe);
  }
  
  function embedFallback(query, els) {
    var brand = '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player</span></div>';
    els.playerFrame.innerHTML = brand;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed?listType=search&list=' + encodeURIComponent(query);
    iframe.setAttribute('width', '100%');
    iframe.setAttribute('height', '100%');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;display:block;';
    els.playerFrame.appendChild(iframe);
  }
  
  function renderMultiSourcePicker(videos, els) {
    if (!videos || videos.length <= 1) {
      if (els.videoPicker) els.videoPicker.style.display = 'none';
      return;
    }
    if (!els.videoPicker) return;
    
    els.videoPicker.style.display = 'block';
    
    var sourceColors = {
      youtube: { bg: '#ff0000', label: 'YT' },
      dailymotion: { bg: '#0066dc', label: 'DM' },
      odysee: { bg: '#ee44aa', label: 'OD' },
      rumble: { bg: '#85c742', label: 'RB' }
    };
    
    els.pickerList.innerHTML = videos.map(function(v, idx) {
      var sc = sourceColors[v.source] || { bg: '#c084fc', label: v.source.substring(0, 2).toUpperCase() };
      var officialBadge = v.isOfficial ? '<div class="pl-pick-official">✓ OFFICIAL</div>' : '';
      var sourceBadge = '<div class="pl-pick-source" style="background:' + sc.bg + ';">' + sc.label + '</div>';
      
      return '<div class="pl-pick-item' + (idx === 0 ? ' active' : '') + '" data-video-idx="' + idx + '">' +
        '<div class="pl-pick-thumb">' +
          '<img src="' + esc(v.thumbnail || '') + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' +
          sourceBadge +
          officialBadge +
        '</div>' +
        '<div class="pl-pick-info">' +
          '<div class="pl-pick-title">' + esc(v.title.substring(0, 70)) + (v.title.length > 70 ? '...' : '') + '</div>' +
          '<div class="pl-pick-channel">' + esc(v.channel || v.sourceLabel) + '</div>' +
        '</div>' +
      '</div>';
    }).join('');
    
    els.pickerList.querySelectorAll('.pl-pick-item').forEach(function(el) {
      el.addEventListener('click', function() {
        var idx = parseInt(el.dataset.videoIdx);
        var video = videos[idx];
        if (!video) return;
        els.pickerList.querySelectorAll('.pl-pick-item').forEach(function(x) { x.classList.remove('active'); });
        el.classList.add('active');
        embedMultiSource(video, els);
      });
    });
  }
