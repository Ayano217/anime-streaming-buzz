---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';

export const prerender = false;

const { slug } = Astro.params;

// ── Enhanced rate limiter with exponential backoff ──
let lastCall = 0;
const MIN_DELAY = 500;

async function jikanFetch(url, retries = 2) {
  for (let attempt = 0; attempt <= retries; attempt++) {
    const now = Date.now();
    const elapsed = now - lastCall;
    if (elapsed < MIN_DELAY) {
      await new Promise(r => setTimeout(r, MIN_DELAY - elapsed));
    }
    lastCall = Date.now();
    
    try {
      const res = await fetch(url, {
        headers: { 'User-Agent': 'AniTubeBuzz/1.0' },
      });
      
      if (res.status === 429) {
        // Rate limited — exponential backoff
        const waitTime = 2000 * Math.pow(2, attempt);
        console.warn(`[Jikan] Rate limited, waiting ${waitTime}ms (attempt ${attempt + 1})`);
        await new Promise(r => setTimeout(r, waitTime));
        continue;
      }
      
      if (res.status === 404) {
        return { data: null, notFound: true };
      }
      
      if (!res.ok) {
        console.warn(`[Jikan] HTTP ${res.status} for ${url}`);
        if (attempt === retries) return { data: null, error: true };
        continue;
      }
      
      const json = await res.json();
      return { data: json, notFound: false };
    } catch (e) {
      console.warn('[Jikan] Fetch error:', e.message);
      if (attempt === retries) return { data: null, error: true };
      await new Promise(r => setTimeout(r, 1000));
    }
  }
  return { data: null, error: true };
}

// ── Better slug matching ──
async function findAnime(slug) {
  const variations = [
    slug.replace(/-/g, ' '),
    slug.replace(/-/g, ' ').replace(/\s+the\s+/gi, ' '),
    slug.split('-').slice(0, 4).join(' '),
    slug.split('-').slice(0, 3).join(' '),
    slug.split('-').slice(0, 2).join(' '),
  ];
  
  const tried = new Set();
  
  for (const query of variations) {
    const trimmed = query.trim();
    if (!trimmed || trimmed.length < 2 || tried.has(trimmed)) continue;
    tried.add(trimmed);
    
    const result = await jikanFetch(
      `https://api.jikan.moe/v4/anime?q=${encodeURIComponent(trimmed)}&limit=5&order_by=popularity`
    );
    
    if (result.data && result.data.data && result.data.data.length > 0) {
      // Prefer exact slug match
      const exact = result.data.data.find(a => {
        const t1 = (a.title_english || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        const t2 = (a.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        return t1 === slug || t2 === slug;
      });
      
      // Fallback to partial match
      const partial = result.data.data.find(a => {
        const t1 = (a.title_english || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        const t2 = (a.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        return t1.startsWith(slug) || t2.startsWith(slug) || slug.startsWith(t1) || slug.startsWith(t2);
      });
      
      return exact || partial || result.data.data[0];
    }
  }
  return null;
}

async function fetchFullAnime(malId) {
  const result = await jikanFetch(`https://api.jikan.moe/v4/anime/${malId}/full`);
  return result.data?.data || null;
}

async function fetchEpisodes(malId) {
  const result = await jikanFetch(`https://api.jikan.moe/v4/anime/${malId}/episodes`);
  return result.data?.data || [];
}

async function fetchRelated() {
  const result = await jikanFetch('https://api.jikan.moe/v4/top/anime?filter=airing&limit=12');
  return result.data?.data || [];
}

// ── Load data ──
let anime = null;
let notFound = false;
let episodes = [];
let related = [];

try {
  anime = await findAnime(slug);
  
  if (anime && anime.mal_id) {
    const full = await fetchFullAnime(anime.mal_id);
    if (full) anime = full;
    episodes = await fetchEpisodes(anime.mal_id);
  } else {
    notFound = true;
  }
  
  related = await fetchRelated();
} catch (e) {
  console.error('[Anime page] Error:', e);
  notFound = true;
}

// ── Set 404 status if not found ──
if (notFound) {
  Astro.response.status = 404;
}

// ── Prepare display data ──
const title    = anime?.title_english || anime?.title || '';
const titleJp  = anime?.title_japanese || '';
const synopsis = (anime?.synopsis || '').replace(/\[Written by MAL Rewrite\]/g, '').trim();
const image    = anime?.images?.jpg?.large_image_url || '';
const trailer  = anime?.trailer?.youtube_id || '';
const score    = anime?.score;
const rank     = anime?.rank;
const popularity = anime?.popularity;
const members  = anime?.members;
const status   = anime?.status || '';
const episodesCount = anime?.episodes || '?';
const duration = anime?.duration || '';
const rating   = anime?.rating || '';
const year     = anime?.year || '';
const season   = anime?.season || '';
const genres   = (anime?.genres || []).map(g => g.name);
const studios  = (anime?.studios || []).map(s => s.name);
const producers = (anime?.producers || []).slice(0, 3).map(p => p.name);
const streaming = anime?.streaming || [];

function makeSlug(str) {
  return (str || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
}

const displaySlug = slug.replace(/-/g, ' ');
const pageTitle = notFound 
  ? `"${displaySlug}" Not Found | AniTube Buzz` 
  : `${title} - Watch Online | AniTube Buzz`;
const pageDesc = notFound 
  ? `The anime "${displaySlug}" could not be found. Browse trending anime instead.` 
  : synopsis.substring(0, 160);
---

<BaseLayout title={pageTitle} description={pageDesc} image={image}>
  <Header slot="header" />

  {notFound ? (
    <!-- ═══ NOT FOUND STATE (Real 404) ═══ -->
    <div class="nf-page container">
      
      <!-- Big 404 visual -->
      <div class="nf-hero">
        <div class="nf-code grad-text">404</div>
        <div class="nf-decoration">
          <div class="nf-dec nf-dec-1"></div>
          <div class="nf-dec nf-dec-2"></div>
          <div class="nf-dec nf-dec-3"></div>
        </div>
      </div>
      
      <h1 class="nf-title">
        Anime <span class="grad-text">Not Found</span>
      </h1>
      
      <p class="nf-searched">
        We searched for: <strong>"{displaySlug}"</strong>
      </p>
      
      <p class="nf-desc">
        This anime doesn't exist in our database, or the search API is temporarily rate-limited.
        <br/>Try again in a moment or explore trending anime below.
      </p>
      
      <div class="nf-actions">
        <a href="/" class="nf-btn nf-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Homepage</span>
        </a>
        
        <a href={`/search?q=${encodeURIComponent(displaySlug)}`} class="nf-btn nf-btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
          <span>Search Instead</span>
        </a>
        
        <button onclick="location.reload()" class="nf-btn nf-btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M23 4v6h-6M1 20v-6h6"/>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
          </svg>
          <span>Try Again</span>
        </button>
      </div>
      
      {related.length > 0 && (
        <div class="nf-suggestions">
          <div class="nf-sug-header">
            <div class="nf-sug-bar"></div>
            <div>
              <div class="nf-sug-tag">TRENDING NOW</div>
              <h2 class="nf-sug-title">
                Try these <span class="grad-text">Hot Anime</span>
              </h2>
            </div>
          </div>
          
          <div class="nf-sug-grid">
            {related.slice(0, 12).map(a => {
              const rTitle = a.title_english || a.title;
              const rImage = a.images?.jpg?.large_image_url || a.images?.jpg?.image_url;
              const rSlug = makeSlug(rTitle) || `anime-${a.mal_id}`;
              const rScore = a.score;
              const rIsNew = a.status === 'Currently Airing';
              return (
                <a href={`/anime/${rSlug}`} class="nf-sug-card">
                  <div class="nf-sug-thumb">
                    {rImage && <img src={rImage} alt={rTitle} loading="lazy" />}
                    <div class="nf-sug-overlay"></div>
                    <div class="nf-sug-play">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                    {rIsNew && <div class="nf-sug-new">NEW</div>}
                    {rScore && (
                      <div class="nf-sug-score">
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {rScore}
                      </div>
                    )}
                    <div class="nf-sug-name">{rTitle}</div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  ) : (
    <!-- ═══ FOUND — Show anime ═══ -->
    <div>
      <div class="anime-page-backdrop" style={image ? `background-image: url(${image})` : ''}></div>
      <div class="anime-page-backdrop-tint"></div>

      <div class="anime-page container">
        <div class="anime-hero-section">
          {trailer ? (
            <YouTubePlayer 
              videoId={trailer}
              title={`${title} - Official Trailer`}
              autoplay={true}
              poster={image}
            />
          ) : (
            <div class="anime-no-video">
              {image && <img src={image} alt={title} class="anime-no-video-img" />}
              <div class="anime-no-video-overlay">
                <div class="anime-no-video-icon">
                  <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="M2.5 17H21.5"/>
                    <path d="M2.5 7H21.5"/>
                  </svg>
                </div>
                <div class="anime-no-video-msg">Trailer Coming Soon</div>
                <div class="anime-no-video-sub">Preview not available yet</div>
              </div>
            </div>
          )}
        </div>

        <div class="anime-info-section">
          <div class="anime-info-main">
            <div class="anime-badges-row">
              {studios[0] && (
                <div class="anime-badge-studio">
                  <div class="badge-mini-icon">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/></svg>
                  </div>
                  <span>{studios[0]}</span>
                  <span class="studio-original">Original</span>
                </div>
              )}
              <div class="anime-badge-hd">HD 4K</div>
              {status === 'Currently Airing' && (
                <div class="anime-badge-airing">
                  <span class="airing-dot"></span>
                  NOW AIRING
                </div>
              )}
            </div>
            
            <h1 class="anime-page-title">{title}</h1>
            {titleJp && <p class="anime-page-title-jp">{titleJp}</p>}
            
            <div class="anime-page-meta">
              {year && <div class="meta-pill"><strong>{year}</strong></div>}
              {season && <div class="meta-pill">{season.charAt(0).toUpperCase() + season.slice(1)}</div>}
              <div class="meta-pill">{anime.type || 'TV'}</div>
              <div class="meta-pill">{episodesCount} EP</div>
              {duration && <div class="meta-pill">{duration}</div>}
              {rating && <div class="meta-pill meta-rating-pill">{rating}</div>}
            </div>
            
            {genres.length > 0 && (
              <div class="anime-genres">
                {genres.slice(0, 6).map(g => (
                  <span class="genre-chip">{g}</span>
                ))}
              </div>
            )}
            
            {synopsis && (
              <div class="anime-synopsis">
                <p>{synopsis}</p>
              </div>
            )}
          </div>
          
          <div class="anime-info-side">
            {score && (
              <div class="stat-card stat-score">
                <div class="stat-label">Score</div>
                <div class="stat-value stat-value-large">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <span>{score}</span>
                  <span class="stat-value-max">/10</span>
                </div>
              </div>
            )}
            {rank && (
              <div class="stat-card">
                <div class="stat-label">Rank</div>
                <div class="stat-value"><span class="stat-hash">#</span>{rank.toLocaleString()}</div>
              </div>
            )}
            {popularity && (
              <div class="stat-card">
                <div class="stat-label">Popularity</div>
                <div class="stat-value"><span class="stat-hash">#</span>{popularity.toLocaleString()}</div>
              </div>
            )}
            {members && (
              <div class="stat-card">
                <div class="stat-label">Members</div>
                <div class="stat-value">{(members / 1000).toFixed(0)}K</div>
              </div>
            )}
            {studios.length > 0 && (
              <div class="stat-card">
                <div class="stat-label">Studio</div>
                <div class="stat-value stat-value-text">{studios.join(', ')}</div>
              </div>
            )}
            {producers.length > 0 && (
              <div class="stat-card">
                <div class="stat-label">Producers</div>
                <div class="stat-value stat-value-text">{producers.join(', ')}</div>
              </div>
            )}
            {status && (
              <div class="stat-card">
                <div class="stat-label">Status</div>
                <div class="stat-value stat-value-text">{status}</div>
              </div>
            )}
          </div>
        </div>

        {episodes.length > 0 && (
          <div class="anime-episodes-section">
            <div class="episodes-header">
              <div class="episodes-title-wrap">
                <div class="episodes-bar"></div>
                <div>
                  <div class="episodes-tag">EPISODE LIST</div>
                  <h2 class="episodes-title">All <span class="grad-text">Episodes</span></h2>
                </div>
              </div>
              <div class="episodes-count">
                <span class="grad-text">{episodes.length}</span>
                <span>episodes</span>
              </div>
            </div>
            
            <div class="episodes-grid">
              {episodes.slice(0, 30).map((ep, idx) => (
                <a href={`/anime/${slug}/${ep.mal_id || (idx + 1)}`} class="episode-item">
                  <div class="ep-num-wrap">
                    <span class="ep-num">{String(ep.mal_id || (idx + 1)).padStart(2, '0')}</span>
                  </div>
                  <div class="ep-details">
                    <div class="ep-title">{ep.title || `Episode ${idx + 1}`}</div>
                    {ep.aired && (
                      <div class="ep-aired">{new Date(ep.aired).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                    )}
                  </div>
                  <div class="ep-play">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </a>
              ))}
            </div>
            
            {episodes.length > 30 && (
              <div class="episodes-more-note">
                Showing 30 of {episodes.length} episodes
              </div>
            )}
          </div>
        )}

        {streaming.length > 0 && (
          <div class="anime-streaming-section">
            <h2 class="section-title">
              Also Watch On <span class="grad-text">Official Platforms</span>
            </h2>
            <div class="streaming-grid">
              {streaming.slice(0, 6).map(s => (
                <a href={s.url} target="_blank" rel="noopener" class="streaming-link">
                  <span>{s.name}</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}

        {related.length > 0 && (
          <div class="anime-related-section">
            <div class="related-header">
              <div class="related-bar"></div>
              <div>
                <div class="related-tag">YOU MIGHT ALSO LIKE</div>
                <h2 class="related-title">More <span class="grad-text">Trending Anime</span></h2>
              </div>
            </div>
            
            <div class="related-grid">
              {related.filter(a => a.mal_id !== anime?.mal_id).slice(0, 12).map(a => {
                const rTitle = a.title_english || a.title || 'Unknown';
                const rImage = a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '';
                const rSlug = makeSlug(rTitle) || `anime-${a.mal_id}`;
                const rIsNew = a.status === 'Currently Airing';
                return (
                  <a href={`/anime/${rSlug}`} class="related-card">
                    <div class="related-thumb">
                      {rImage ? (
                        <img src={rImage} alt={rTitle} loading="lazy" />
                      ) : (
                        <div class="related-fallback"></div>
                      )}
                      <div class="related-overlay"></div>
                      <div class="related-play">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </div>
                      {rIsNew && <div class="related-new">NEW</div>}
                      {a.score && (
                        <div class="related-score">
                          <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                          {a.score}
                        </div>
                      )}
                      <div class="related-info">
                        <div class="related-title-text">{rTitle}</div>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ═══ NOT FOUND STATE ═══ */
  .nf-page {
    padding: 4rem 1.5rem 5rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  
  .nf-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    height: 200px;
  }
  
  .nf-code {
    font-family: var(--font-heading);
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    position: relative;
    z-index: 2;
    text-shadow: 0 8px 30px rgba(192, 132, 252, 0.4);
  }
  
  .nf-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  .nf-dec {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }
  
  .nf-dec-1 {
    width: 200px; height: 200px;
    background: rgba(192, 132, 252, 0.4);
    top: 0; left: 20%;
    animation: nf-float-1 8s ease infinite;
  }
  
  .nf-dec-2 {
    width: 160px; height: 160px;
    background: rgba(232, 121, 249, 0.35);
    bottom: 0; right: 20%;
    animation: nf-float-2 10s ease infinite;
  }
  
  .nf-dec-3 {
    width: 140px; height: 140px;
    background: rgba(125, 211, 252, 0.3);
    top: 30%; right: 30%;
    animation: nf-float-3 12s ease infinite;
  }
  
  @keyframes nf-float-1 {
    0%, 100% { transform: translate(0, 0); }
    50%       { transform: translate(30px, -20px); }
  }
  @keyframes nf-float-2 {
    0%, 100% { transform: translate(0, 0); }
    50%       { transform: translate(-25px, 20px); }
  }
  @keyframes nf-float-3 {
    0%, 100% { transform: translate(0, 0); }
    50%       { transform: translate(20px, 30px); }
  }
  
  .nf-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }
  
  .nf-searched {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  
  .nf-searched strong {
    color: var(--purple);
    font-weight: 700;
    font-family: var(--font-mono);
  }
  
  .nf-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 2rem;
  }
  
  .nf-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  
  .nf-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }
  
  .nf-btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 4px 15px rgba(192, 132, 252, 0.4);
  }
  
  .nf-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(192, 132, 252, 0.55);
  }
  
  .nf-btn-secondary {
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan);
  }
  
  .nf-btn-secondary:hover {
    background: rgba(125, 211, 252, 0.25);
