---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
---

<BaseLayout title="Anime Details" description="Watch anime episodes online in HD quality">
  <Header slot="header" />
  
  <div class="ap-wrap">
    <div id="apLoader" class="ap-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p id="apLoaderText">Loading...</p>
    </div>
    
    <div id="apNotFound" class="ap-nf" style="display:none;">
      <h1>Anime Not Found</h1>
      <p id="apNfMsg">This anime couldn't be loaded.</p>
      <div class="nf-btns">
        <a href="/" class="nf-bk">← Back to Homepage</a>
      </div>
    </div>
    
    <div id="apContent" style="display:none;">
      <!-- HERO -->
      <div class="ap-hero">
        <div class="ap-bg" id="apBg"></div>
        <div class="ap-fade"></div>
        <div class="container">
          <div class="ap-hero-in">
            <div class="ap-poster"><img id="apPosterImg" alt="" /></div>
            <div class="ap-info">
              <div class="ap-badges" id="apBadges"></div>
              <h1 class="ap-title" id="apTitle">Loading...</h1>
              <div class="ap-meta" id="apMeta"></div>
              <div class="ap-genres" id="apGenres"></div>
              <p class="ap-syno" id="apSyno"></p>
              <div class="ap-actions">
                <button class="ap-btn ap-btn-p" id="apWatchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="ap-btn ap-btn-s" id="apInfoBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                  <span>More Info</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- DETAILS -->
      <section class="section-block ap-details" id="apDetailsBlock">
        <div class="container">
          <div class="ap-grid">
            <div class="ap-main">
              <div class="ap-sec">
                <h2 class="ap-sh">Synopsis</h2>
                <p class="ap-desc" id="apFullSyno">Loading...</p>
              </div>
              
              <div class="ap-sec">
                <div class="ap-eps-head">
                  <h2 class="ap-sh">Related Videos</h2>
                </div>
                <div id="apRelatedVideos" class="rel-vids-grid">
                  <div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);">Loading videos...</div>
                </div>
              </div>
            </div>
            
            <aside class="ap-side">
              <div class="ap-card">
                <h3 class="ac-t">Information</h3>
                <div class="ac-list" id="apInfoList"></div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Recommended Products</h3>
                <div id="apRelatedProducts" class="side-products"></div>
              </div>
            </aside>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-related">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">You Might Also Like</span></h2>
          <div id="apRelatedGrid" class="rel-grid"></div>
        </div>
      </section>
    </div>
  </div>

  <!-- ═══ INSTAGRAM-STYLE VIDEO PLAYER ═══ -->
  <div id="reelsPlayer" class="reels-player" style="display:none;">
    <div class="reels-backdrop" id="reelsBackdrop"></div>
    <div class="reels-container">
      <button class="reels-close" id="reelsClose">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <div class="reels-video-wrap">
        <div id="reelsVideoFrame" class="reels-video-frame">
          <div class="reels-video-loading">
            <div class="reels-spinner"></div>
            <span>Loading video...</span>
          </div>
        </div>
      </div>
      <div class="reels-info">
        <div class="reels-avatar"><div class="reels-avatar-icon">▶</div></div>
        <div class="reels-info-text">
          <div id="reelsTitle" class="reels-title">Loading...</div>
          <div id="reelsChannel" class="reels-channel">Video</div>
        </div>
        <button class="reels-like" id="reelsLike">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      </div>
      <!-- Related videos scroll (Instagram-style) -->
      <div class="reels-more" id="reelsMore">
        <div class="reels-more-label">🎬 Watch More</div>
        <div class="reels-more-scroll" id="reelsMoreScroll"></div>
      </div>
      <!-- Products below -->
      <div class="reels-ads" id="reelsAds"></div>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @keyframes atCardIn { from{opacity:0;transform:translateY(15px)} to{opacity:1;transform:translateY(0)} }
</style>

<script is:inline define:vars={{ slug }}>
(async function(){
  function esc(s){try{return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}catch(e){return'';}}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}
  function fmt(d){try{if(!d)return'N/A';var x=new Date(d);if(isNaN(x.getTime()))return'N/A';return x.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}catch(e){return'N/A';}}
  function cap(s){try{if(!s)return'';var str=String(s).replace(/_/g,' ');return str.charAt(0).toUpperCase()+str.slice(1);}catch(e){return String(s||'');}}
  
  async function fetchJSON(url){
    try{
      var r=await fetch(url);
      if(!r.ok)return null;
      return await r.json();
    }catch(e){return null;}
  }

  // Load anime data
  async function loadAnimeData(){
    var j=await fetchJSON('/api/anime?action=detail&slug='+encodeURIComponent(slug));
    if(j&&j.success&&j.anime)return j.anime;
    var searchTerm=slug.replace(/-/g,' ');
    var s=await fetchJSON('/api/anime?action=search&q='+encodeURIComponent(searchTerm));
    if(s&&s.success&&s.anime&&s.anime.length>0){
      var pick=s.anime.find(function(a){return a.slug===slug;})||s.anime[0];
      return pick;
    }
    return null;
  }

  var els={
    loader:document.getElementById('apLoader'),
    notFound:document.getElementById('apNotFound'),
    content:document.getElementById('apContent'),
    bg:document.getElementById('apBg'),
    poster:document.getElementById('apPosterImg'),
    title:document.getElementById('apTitle'),
    meta:document.getElementById('apMeta'),
    genres:document.getElementById('apGenres'),
    syno:document.getElementById('apSyno'),
    badges:document.getElementById('apBadges'),
    fullSyno:document.getElementById('apFullSyno'),
    infoList:document.getElementById('apInfoList'),
    relatedVideos:document.getElementById('apRelatedVideos'),
    relatedProducts:document.getElementById('apRelatedProducts'),
    relatedGrid:document.getElementById('apRelatedGrid'),
    watchBtn:document.getElementById('apWatchBtn'),
    infoBtn:document.getElementById('apInfoBtn'),
    detailsBlock:document.getElementById('apDetailsBlock'),
    // Reels player
    reelsPlayer:document.getElementById('reelsPlayer'),
    reelsFrame:document.getElementById('reelsVideoFrame'),
    reelsTitle:document.getElementById('reelsTitle'),
    reelsChannel:document.getElementById('reelsChannel'),
    reelsClose:document.getElementById('reelsClose'),
    reelsBackdrop:document.getElementById('reelsBackdrop'),
    reelsLike:document.getElementById('reelsLike'),
    reelsMoreScroll:document.getElementById('reelsMoreScroll'),
    reelsAds:document.getElementById('reelsAds')
  };
  
  var animeData = null;
  var currentVideos = []; // Videos for related scroll
  var productPool = [];

  // ═══ REELS PLAYER — Instagram Style ═══
  function openReels(video, allVideos) {
    els.reelsTitle.textContent = video.title || 'Video';
    els.reelsChannel.textContent = video.channel || 'Channel';
    els.reelsFrame.innerHTML = '<div class="reels-video-loading"><div class="reels-spinner"></div><span>Loading...</span></div>';
    
    // Add params to hide platform branding
    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'ui-logo=0&ui-start-screen-info=0&sharing-enable=0&mute=0';
    }
    if (video.source === 'youtube' && !embedUrl.includes('modestbranding')) {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'modestbranding=1&showinfo=0&rel=0';
    }
    
    setTimeout(function() {
      var iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
      iframe.setAttribute('allowfullscreen', '');
      iframe.style.cssText = 'width:100%;height:100%;border:0;position:absolute;top:0;left:0;';
      els.reelsFrame.innerHTML = '';
      els.reelsFrame.appendChild(iframe);
    }, 100);
    
    // Related videos scroll
    if (allVideos && allVideos.length > 1) {
      var others = allVideos.filter(function(v) { return v.id !== video.id; }).slice(0, 8);
      var scrollHtml = others.map(function(v) {
        var img = v.thumbnail ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' : '';
        return '<div class="reels-more-item" data-vid=\'' + esc(JSON.stringify(v).replace(/'/g, "&#39;")) + '\'>' +
          '<div class="reels-more-thumb">' + img +
            '<div class="reels-more-play">▶</div>' +
          '</div>' +
          '<div class="reels-more-title">' + esc(trunc(v.title, 40)) + '</div>' +
        '</div>';
      }).join('');
      els.reelsMoreScroll.innerHTML = scrollHtml;
      
      // Click handler for related items
      els.reelsMoreScroll.querySelectorAll('.reels-more-item').forEach(function(item) {
        item.addEventListener('click', function() {
          try {
            var vidData = JSON.parse(item.dataset.vid.replace(/&#39;/g, "'"));
            openReels(vidData, allVideos);
          } catch(e) {}
        });
      });
    }
    
    // Related product ads
    if (productPool.length > 0) {
      var picks = shuffle(productPool).slice(0, 3);
      var adsHtml = '<div class="reels-ads-label">✨ Recommended For You</div>' +
        '<div class="reels-ads-list">' +
        picks.map(function(p) {
          var img = p.image ? '<img src="' + esc(p.image) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;">🛍️</div>';
          return '<a href="/product/' + esc(p.id) + '" class="reels-ad-item" target="_blank">' +
            '<div class="reels-ad-thumb">' + img +
              '<div class="reels-ad-price">' + esc(p.price) + '</div>' +
            '</div>' +
            '<div class="reels-ad-title">' + esc(trunc(p.title, 35)) + '</div>' +
          '</a>';
        }).join('') + '</div>';
      els.reelsAds.innerHTML = adsHtml;
    }
    
    els.reelsPlayer.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  
  function closeReels() {
    els.reelsPlayer.style.display = 'none';
    els.reelsFrame.innerHTML = '';
    document.body.style.overflow = '';
    if (els.reelsLike) els.reelsLike.classList.remove('liked');
  }
  
  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }
  
  if (els.reelsClose) els.reelsClose.addEventListener('click', closeReels);
  if (els.reelsBackdrop) els.reelsBackdrop.addEventListener('click', closeReels);
  if (els.reelsLike) els.reelsLike.addEventListener('click', function() { els.reelsLike.classList.toggle('liked'); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && els.reelsPlayer && els.reelsPlayer.style.display !== 'none') closeReels();
  });

  // Load related videos from social feed
  async function loadRelatedVideos(animeTitle) {
    // Search for videos related to this anime
    var searchQuery = animeTitle.split(':')[0].trim(); // Use first part of title
    var types = ['anime', 'movies', 'kdrama'];
    var allVids = [];
    
    for (var i = 0; i < types.length; i++) {
      try {
        var res = await fetch('/api/social-feed?type=' + types[i] + '&page=1&limit=6');
        var data = await res.json();
        if (data.success && data.videos) {
          allVids = allVids.concat(data.videos);
        }
      } catch(e) {}
    }
    
    currentVideos = allVids;
    renderRelatedVideos(allVids);
  }
  
  function renderRelatedVideos(videos) {
    if (!videos || videos.length === 0) {
      els.relatedVideos.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);">No related videos available.</div>';
      return;
    }
    
    els.relatedVideos.innerHTML = videos.slice(0, 12).map(function(v, i) {
      var typeLabel = { movies: '🎬 MOVIE', kdrama: '🇰🇷 K-DRAMA', donghua: '🐼 DONGHUA', anime: '🎌 ANIME' }[v.type] || '📺';
      var img = v.thumbnail ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.style.background=\'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))\'" />' : '';
      var delay = ((i % 6) * 40) + 'ms';
      return '<div class="rel-vid-card" data-idx="' + i + '" style="animation-delay:' + delay + '">' +
        '<div class="rel-vid-thumb">' + img +
          '<div class="rel-vid-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>' +
          (v.isNew ? '<div class="rel-vid-new">NEW</div>' : '') +
          '<div class="rel-vid-type">' + typeLabel + '</div>' +
        '</div>' +
        '<div class="rel-vid-title">' + esc(trunc(v.title, 55)) + '</div>' +
        '<div class="rel-vid-channel">' + esc(v.channel || 'Channel') + '</div>' +
      '</div>';
    }).join('');
    
    els.relatedVideos.querySelectorAll('.rel-vid-card').forEach(function(card) {
      card.addEventListener('click', function() {
        var idx = parseInt(card.dataset.idx);
        var video = videos[idx];
        if (video) openReels(video, videos);
      });
    });
  }
  
  async function loadRelatedProducts() {
    try {
      var res = await fetch('/api/products?limit=20');
      var j = await res.json();
      if (j.success && j.products) {
        productPool = j.products;
        // Show 4 in sidebar
        var picks = shuffle(productPool).slice(0, 4);
        els.relatedProducts.innerHTML = picks.map(function(p) {
          var img = p.image ? '<img src="' + esc(p.image) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🛍️</div>';
          return '<a href="/product/' + esc(p.id) + '" class="side-product-item" target="_blank">' +
            '<div class="side-product-thumb">' + img + '</div>' +
            '<div class="side-product-info">' +
              '<div class="side-product-title">' + esc(trunc(p.title, 40)) + '</div>' +
              '<div class="side-product-price">' + esc(p.price) + '</div>' +
            '</div>' +
          '</a>';
        }).join('');
      }
    } catch(e) {}
  }

  function safeRender(a){
    try{document.title=(a.title||'Anime')+' - AniTube Buzz';}catch(e){}
    try{if(a.image){if(els.bg)els.bg.style.backgroundImage='url('+a.image+')';if(els.poster){els.poster.src=a.image;els.poster.alt=a.title||'';}}}catch(e){}
    try{if(els.title)els.title.textContent=a.title||'Untitled';}catch(e){}
    try{
      var b=[];
      if(a.status==='current')b.push('<span class="ap-b ap-b-new"><span class="ap-dot"></span>AIRING NOW</span>');
      if(a.score!=null)b.push('<span class="ap-b ap-b-sc">⭐ '+Number(a.score).toFixed(1)+'</span>');
      b.push('<span class="ap-b ap-b-hd">HD</span>');
      if(a.ageRating)b.push('<span class="ap-b ap-b-age">'+esc(a.ageRating)+'</span>');
      if(els.badges)els.badges.innerHTML=b.join('');
    }catch(e){}
    try{
      var m=[];
      if(a.year)m.push(String(a.year));
      if(a.episodes&&a.episodes>0)m.push(a.episodes+' Episodes');
      if(a.subtype)m.push(String(a.subtype));
      if(a.status)m.push(cap(a.status));
      if(els.meta)els.meta.innerHTML=m.map(function(x){return '<span>'+esc(x)+'</span>';}).join('<span class="mp-sep">·</span>');
    }catch(e){}
    try{if(a.genres&&a.genres.length>0&&els.genres){els.genres.innerHTML=a.genres.slice(0,6).map(function(g){return '<span class="ap-gp">'+esc(g)+'</span>';}).join('');}}catch(e){}
    try{
      var syn=a.description||a.synopsis||'No synopsis available.';
      if(els.syno)els.syno.textContent=syn.length>250?syn.slice(0,250)+'...':syn;
      if(els.fullSyno)els.fullSyno.textContent=syn;
    }catch(e){}
    try{
      var rows=[
        ['Type',a.subtype||'TV'],
        ['Episodes',(a.episodes&&a.episodes>0)?a.episodes:'Unknown'],
        ['Status',a.status?cap(a.status):'Unknown'],
        ['Aired',a.startDate?fmt(a.startDate):'Unknown'],
        ['Score',a.score!=null?('⭐ '+Number(a.score).toFixed(1)):'N/A'],
        ['Rating',a.ageRating||'Not Rated'],
        ['Genres',(a.genres&&a.genres.length)?a.genres.join(', '):'N/A']
      ];
      if(els.infoList)els.infoList.innerHTML=rows.map(function(r){return '<div class="ir"><span class="ir-l">'+esc(r[0])+'</span><span class="ir-v">'+esc(String(r[1]))+'</span></div>';}).join('');
    }catch(e){}
  }
  
  function renderRelated(list){
    if(!list||!list.length){els.relatedGrid.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:2rem;grid-column:1/-1;">No related anime found.</p>';return;}
    els.relatedGrid.innerHTML=list.map(function(a){
      var img=a.image?'<img src="'+esc(a.image)+'" alt="" loading="lazy" />':'<div class="rc-no"></div>';
      return '<a href="/anime/'+esc(a.slug)+'" class="rel-c">'+
        '<div class="rc-p">'+img+'<div class="rc-pl">▶</div></div>'+
        '<div class="rc-t">'+esc(a.title)+'</div></a>';
    }).join('');
  }

  // MAIN INIT
  var timeout = setTimeout(function(){
    els.loader.style.display='none';
    els.notFound.style.display='flex';
  }, 25000);

  try {
    animeData = await loadAnimeData();
    if (!animeData) {
      clearTimeout(timeout);
      els.loader.style.display='none';
      els.notFound.style.display='flex';
      return;
    }
    
    safeRender(animeData);
    clearTimeout(timeout);
    els.loader.style.display='none';
    els.content.style.display='block';
    
    // Load related videos + products in parallel
    Promise.all([
      loadRelatedVideos(animeData.title || slug),
      loadRelatedProducts()
    ]);
    
    // Related anime
    fetchJSON('/api/anime?action=list&category=popular&page=1').then(function(relData){
      if(relData&&relData.success){
        var rel=(relData.anime||[]).filter(function(x){return x.slug!==slug;}).slice(0,12);
        renderRelated(rel);
      }
    });
    
    // ═══ WATCH NOW → OPENS INSTAGRAM STYLE MODAL WITH FIRST VIDEO ═══
    if(els.watchBtn) els.watchBtn.addEventListener('click', async function(){
      // Show loading in modal immediately
      els.reelsTitle.textContent = animeData.title || 'Loading...';
      els.reelsChannel.textContent = 'Fetching video...';
      els.reelsFrame.innerHTML = '<div class="reels-video-loading"><div class="reels-spinner"></div><span>Finding best video...</span></div>';
      els.reelsPlayer.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      
      // Search for videos of this anime
      try {
        var searchQuery = animeData.title.split(':')[0].trim();
        var res = await fetch('/api/social-feed?type=anime&page=1&limit=10');
        var data = await res.json();
        
        if (data.success && data.videos && data.videos.length > 0) {
          // Find best match (contains anime name in title)
          var titleLower = searchQuery.toLowerCase();
          var bestMatch = data.videos.find(function(v) {
            return v.title.toLowerCase().includes(titleLower);
          }) || data.videos[0];
          
          openReels(bestMatch, data.videos);
        } else {
          // No videos found — show error in modal
          els.reelsFrame.innerHTML = '<div class="reels-video-loading" style="color:#f87171;"><span>No video available yet. Try a related video below!</span></div>';
          // Still show related content
          if (currentVideos.length > 0) {
            openReels(currentVideos[0], currentVideos);
          }
        }
      } catch(e) {
        console.warn('Watch error:', e);
        if (currentVideos.length > 0) {
          openReels(currentVideos[0], currentVideos);
        }
      }
    });
    
    if(els.infoBtn&&els.detailsBlock) els.infoBtn.addEventListener('click', function(){
      els.detailsBlock.scrollIntoView({behavior:'smooth',block:'start'});
    });
    
  }catch(e){
    clearTimeout(timeout);
    els.loader.style.display='none';
    els.notFound.style.display='flex';
  }
})();
</script>

<style>
  .ap-wrap{min-height:100vh;color:var(--text-primary)}
  .ap-loader,.ap-nf{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6rem 1rem;text-align:center;min-height:60vh}
  .lo-orb{position:relative;width:50px;height:50px;margin-bottom:1rem}
  .lo-core{position:absolute;inset:15%;border-radius:50%;background:linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);box-shadow:0 0 20px rgba(192,132,252,.6);animation:loPu 1s ease infinite}
  .lo-ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,.6);animation:loEx 1.2s ease-out infinite}
