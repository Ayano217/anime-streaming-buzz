---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
---

<BaseLayout 
  title="Anime Details"
  description="Watch anime episodes online in premium HD quality on AniTube Buzz."
>
  <Header slot="header" />
  
  <div class="ap-wrap">
    <div id="loader" class="ap-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p>Loading anime details...</p>
    </div>
    
    <div id="notFound" class="ap-nf" style="display:none;">
      <div class="nf-ic"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></div>
      <h1>Anime Not Found</h1>
      <p>This anime doesn't exist or was removed.</p>
      <a href="/" class="nf-bk">← Back to Homepage</a>
    </div>
    
    <div id="content" style="display:none;">
      <div class="ap-hero">
        <div class="ap-bg" id="apBg"></div>
        <div class="ap-fade"></div>
        <div class="container">
          <div class="ap-hero-in">
            <div class="ap-poster">
              <img id="posterImg" alt="" />
            </div>
            <div class="ap-info">
              <div class="ap-badges" id="apBadges"></div>
              <h1 class="ap-title" id="apTitle">Loading...</h1>
              <div class="ap-meta" id="apMeta"></div>
              <div class="ap-genres" id="apGenres"></div>
              <p class="ap-syno" id="apSyno"></p>
              <div class="ap-actions">
                <button class="ap-btn ap-btn-p" id="watchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="ap-btn ap-btn-s" id="infoBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                  <span>More Info</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <section class="section-block ap-player" id="playerBlock" style="display:none;">
        <div class="container">
          <div class="pl-head">
            <h2 class="section-title" id="playerTitle"><span class="grad-text">Now Playing</span></h2>
            <button class="pl-close" id="closePlayer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="pl-wrap">
            <div id="playerFrame" class="pl-frame">
              <div class="pl-load">Loading player...</div>
            </div>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-details" id="detailsBlock">
        <div class="container">
          <div class="ap-grid">
            <div class="ap-main">
              <div class="ap-sec">
                <h2 class="ap-sh">Synopsis</h2>
                <p class="ap-desc" id="fullSyno">Loading...</p>
              </div>
              
              <div class="ap-sec">
                <h2 class="ap-sh">Episodes</h2>
                <div class="ap-seasons" id="seasonsTabs"></div>
                <div class="ap-eps" id="episodesList">
                  <div class="ep-ld">
                    <div class="lo-orb sm"><div class="lo-ring"></div><div class="lo-core"></div></div>
                    <span>Loading episodes...</span>
                  </div>
                </div>
              </div>
            </div>
            
            <aside class="ap-side">
              <div class="ap-card">
                <h3 class="ac-t">Information</h3>
                <div class="ac-list" id="infoList"></div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Where to Watch</h3>
                <div class="ac-list">
                  <a href="#" class="ap-stream" data-platform="crunchyroll">
                    <div class="st-lg cr">CR</div><span>Crunchyroll</span>
                  </a>
                  <a href="#" class="ap-stream" data-platform="netflix">
                    <div class="st-lg nf">N</div><span>Netflix</span>
                  </a>
                  <a href="#" class="ap-stream" data-platform="hulu">
                    <div class="st-lg hu">Hulu</div><span>Hulu</span>
                  </a>
                </div>
              </div>
              
              <div class="ap-card">
                <h3 class="ac-t">Share</h3>
                <div class="ap-share">
                  <button class="sh-btn" data-share="twitter">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </button>
                  <button class="sh-btn" data-share="facebook">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
                  </button>
                  <button class="sh-btn" data-share="copy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>
      
      <section class="section-block ap-related">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">You Might Also Like</span></h2>
          <div id="relatedGrid" class="rel-grid">
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
            <div class="rel-sk"></div><div class="rel-sk"></div><div class="rel-sk"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ slug }}>
(async function(){
  var loader=document.getElementById('loader'),
      notFound=document.getElementById('notFound'),
      content=document.getElementById('content'),
      apBg=document.getElementById('apBg'),
      posterImg=document.getElementById('posterImg'),
      apTitle=document.getElementById('apTitle'),
      apMeta=document.getElementById('apMeta'),
      apGenres=document.getElementById('apGenres'),
      apSyno=document.getElementById('apSyno'),
      apBadges=document.getElementById('apBadges'),
      fullSyno=document.getElementById('fullSyno'),
      infoList=document.getElementById('infoList'),
      seasonsTabs=document.getElementById('seasonsTabs'),
      episodesList=document.getElementById('episodesList'),
      relatedGrid=document.getElementById('relatedGrid'),
      playerBlock=document.getElementById('playerBlock'),
      playerFrame=document.getElementById('playerFrame'),
      playerTitle=document.getElementById('playerTitle'),
      closePlayer=document.getElementById('closePlayer'),
      watchBtn=document.getElementById('watchBtn'),
      infoBtn=document.getElementById('infoBtn'),
      detailsBlock=document.getElementById('detailsBlock');

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function fmt(d){if(!d)return'N/A';var x=new Date(d);return x.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}

  async function fetchJSON(url){
    try{var r=await fetch(url);if(!r.ok)return null;return await r.json();}catch(e){return null;}
  }

  async function playVideo(query,title){
    playerBlock.style.display='block';
    playerTitle.innerHTML='<span class="grad-text">'+esc(title||'Now Playing')+'</span>';
    playerFrame.innerHTML='<div class="pl-load">Loading video...</div>';
    setTimeout(function(){playerBlock.scrollIntoView({behavior:'smooth',block:'start'});},50);
    
    var j=await fetchJSON('/api/youtube?q='+encodeURIComponent(query));
    var vid=(j&&j.success&&j.primary&&j.primary.videoId)?j.primary.videoId:null;
    
    if(vid){
      playerFrame.innerHTML=
        '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · HD</span></div>'+
        '<iframe src="https://www.youtube.com/embed/'+vid+'?autoplay=1&rel=0&modestbranding=1&iv_load_policy=3" '+
        'frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>';
    } else {
      playerFrame.innerHTML=
        '<div class="pl-brand"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg><span>AniTube Player · HD</span></div>'+
        '<iframe src="https://www.youtube.com/embed?listType=search&list='+encodeURIComponent(query)+'" '+
        'frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>';
    }
  }

  function renderInfo(a){
    document.title=a.title+' - AniTube Buzz';
    if(a.image){apBg.style.backgroundImage='url('+a.image+')';posterImg.src=a.image;posterImg.alt=a.title;}
    apTitle.textContent=a.title;
    
    var b=[];
    if(a.status==='current')b.push('<span class="ap-b ap-b-new"><span class="ap-dot"></span>AIRING NOW</span>');
    if(a.score)b.push('<span class="ap-b ap-b-sc"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'+Number(a.score).toFixed(1)+'</span>');
    b.push('<span class="ap-b ap-b-hd">HD</span>');
    if(a.ageRating)b.push('<span class="ap-b ap-b-age">'+esc(a.ageRating)+'</span>');
    apBadges.innerHTML=b.join('');
    
    var m=[];
    if(a.year)m.push(a.year);
    if(a.episodes>0)m.push(a.episodes+' Episodes');
    if(a.subtype)m.push(a.subtype);
    if(a.status){var s=String(a.status).replace(/_/g,' ');m.push(s.charAt(0).toUpperCase()+s.slice(1));}
    apMeta.innerHTML=m.map(function(x){return '<span>'+esc(x)+'</span>';}).join('<span class="mp-sep">·</span>');
    
    if(a.genres&&a.genres.length){
      apGenres.innerHTML=a.genres.slice(0,6).map(function(g){return '<span class="ap-gp">'+esc(g)+'</span>';}).join('');
    }
    
    var s=a.description||a.synopsis||'No synopsis available.';
    apSyno.textContent=s.length>250?s.slice(0,250)+'...':s;
    fullSyno.textContent=s;
    
    var rows=[
      ['Type',a.subtype||'TV'],
      ['Episodes',a.episodes>0?a.episodes:'Unknown'],
      ['Status',a.status?String(a.status).replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}):'Unknown'],
      ['Aired',a.startDate?fmt(a.startDate)+(a.endDate?' to '+fmt(a.endDate):' to ?'):'Unknown'],
      ['Score',a.score?'⭐ '+Number(a.score).toFixed(1)+' / 10':'N/A'],
      ['Rating',a.ageRating||'Not Rated'],
      ['Genres',(a.genres&&a.genres.length)?a.genres.join(', '):'N/A']
    ];
    infoList.innerHTML=rows.map(function(r){
      return '<div class="ir"><span class="ir-l">'+esc(r[0])+'</span><span class="ir-v">'+esc(String(r[1]))+'</span></div>';
    }).join('');
    
    var qEnc=encodeURIComponent(a.title);
    document.querySelectorAll('.ap-stream').forEach(function(el){
      var p=el.dataset.platform,u='#';
      if(p==='crunchyroll')u='https://www.crunchyroll.com/search?q='+qEnc;
      else if(p==='netflix')u='https://www.netflix.com/search?q='+qEnc;
      else if(p==='hulu')u='https://www.hulu.com/search?q='+qEnc;
      el.href=u;el.target='_blank';el.rel='noopener';
    });
  }

  function renderEpisodes(eps,title){
    if(!eps||!eps.length){
      episodesList.innerHTML='<div class="ep-empty">Episodes not available yet. Click Watch Now for the trailer!</div>';
      seasonsTabs.style.display='none';
      return;
    }
    var seasons={};
    eps.forEach(function(e){var s=e.seasonNumber||1;if(!seasons[s])seasons[s]=[];seasons[s].push(e);});
    var nums=Object.keys(seasons).map(Number).sort(function(a,b){return a-b;});
    
    seasonsTabs.innerHTML=nums.map(function(s,i){
      return '<button class="ap-st'+(i===0?' active':'')+'" data-s="'+s+'">Season '+s+' <span class="st-c">'+seasons[s].length+' EP</span></button>';
    }).join('');
    
    function show(s){
      var list=seasons[s];
      episodesList.innerHTML=list.map(function(e){
        var t=e.thumbnail?'<img src="'+esc(e.thumbnail)+'" alt="" loading="lazy" />':'<div class="ep-nt"></div>';
        return '<div class="ep-i" data-n="'+e.number+'" data-t="'+esc(e.title)+'">'+
          '<div class="ep-th">'+t+'<div class="ep-pl"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div><div class="ep-nm">EP '+e.number+'</div></div>'+
          '<div class="ep-in"><h4 class="ep-t">'+esc(e.title)+'</h4>'+
          (e.synopsis?'<p class="ep-d">'+esc(e.synopsis.slice(0,120))+(e.synopsis.length>120?'...':'')+'</p>':'')+
          (e.airdate?'<div class="ep-m">Aired: '+fmt(e.airdate)+(e.length?' · '+e.length+' min':'')+'</div>':'')+
          '</div></div>';
      }).join('');
      episodesList.querySelectorAll('.ep-i').forEach(function(el){
        el.addEventListener('click',function(){
          playVideo(title+' episode '+el.dataset.n,'Episode '+el.dataset.n+': '+el.dataset.t);
        });
      });
    }
    
    seasonsTabs.querySelectorAll('.ap-st').forEach(function(t){
      t.addEventListener('click',function(){
        seasonsTabs.querySelectorAll('.ap-st').forEach(function(x){x.classList.remove('active');});
        t.classList.add('active');
        show(Number(t.dataset.s));
      });
    });
    show(nums[0]);
  }

  function renderRelated(list){
    if(!list||!list.length){relatedGrid.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:2rem;grid-column:1/-1;">No related anime found.</p>';return;}
    relatedGrid.innerHTML=list.map(function(a){
      var img=a.image?'<img src="'+esc(a.image)+'" alt="" loading="lazy" />':'<div class="rc-no"></div>';
      return '<a href="/anime/'+esc(a.slug)+'" class="rel-c">'+
        '<div class="rc-p">'+img+'<div class="rc-pl"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div></div>'+
        '<div class="rc-t">'+esc(a.title)+'</div></a>';
    }).join('');
  }

  try{
    // Fetch main data
    var detailRes=await fetchJSON('/api/anime?action=detail&slug='+encodeURIComponent(slug));
    if(!detailRes||!detailRes.success||!detailRes.anime){
      loader.style.display='none';
      notFound.style.display='flex';
      return;
    }
    
    var anime=detailRes.anime;
    renderInfo(anime);
    loader.style.display='none';
    content.style.display='block';
    
    // Fetch episodes + related in parallel (faster)
    Promise.all([
      fetchJSON('/api/anime?action=episodes&id='+anime.id+'&page=1'),
      fetchJSON('/api/anime?action=list&category=popular&page=1')
    ]).then(function(res){
      var epsData=res[0];
      var relData=res[1];
      if(epsData&&epsData.success)renderEpisodes(epsData.episodes||[],anime.title);
      else renderEpisodes([],anime.title);
      if(relData&&relData.success){
        var rel=(relData.anime||[]).filter(function(x){return x.slug!==slug;}).slice(0,12);
        renderRelated(rel);
      } else renderRelated([]);
    });
    
    watchBtn.addEventListener('click',function(){
      playVideo(anime.title+' anime official trailer',anime.title+' - Trailer');
    });
    infoBtn.addEventListener('click',function(){
      detailsBlock.scrollIntoView({behavior:'smooth',block:'start'});
    });
    if(closePlayer)closePlayer.addEventListener('click',function(){
      playerBlock.style.display='none';playerFrame.innerHTML='';
    });
    
    document.querySelectorAll('.sh-btn').forEach(function(b){
      b.addEventListener('click',function(){
        var t=b.dataset.share,u=window.location.href,x=anime.title+' on AniTube Buzz';
        if(t==='twitter')window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(x)+'&url='+encodeURIComponent(u),'_blank');
        else if(t==='facebook')window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(u),'_blank');
        else if(t==='copy'){navigator.clipboard.writeText(u);b.classList.add('cp');setTimeout(function(){b.classList.remove('cp');},1500);}
      });
    });
    
  }catch(e){
    console.error('Load error:',e);
    loader.style.display='none';
    notFound.style.display='flex';
  }
})();
</script>

<style>
  .ap-wrap { min-height: 100vh; color: var(--text-primary); }
  
  .ap-loader, .ap-nf {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 6rem 1rem; text-align: center; min-height: 60vh;
  }
  .lo-orb { position: relative; width: 50px; height: 50px; margin-bottom: 1rem; }
  .lo-orb.sm { width: 32px; height: 32px; margin-bottom: 0.6rem; }
  .lo-core {
    position: absolute; inset: 15%; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    box-shadow: 0 0 20px rgba(192, 132, 252, 0.6);
    animation: lo-pulse 1s ease infinite;
  }
  .lo-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgba(192, 132, 252, 0.6);
    animation: lo-exp 1.2s ease-out infinite;
  }
  @keyframes lo-exp { 0% { transform: scale(0.5); opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } }
  @keyframes lo-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
  .ap-loader p, .ep-ld span { color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; }
  
  .nf-ic { color: #c084fc; margin-bottom: 1rem; }
  .ap-nf h1 {
    font-family: var(--font-heading); font-size: 2rem;
    background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 0.5rem;
  }
  .ap-nf p { color: var(--text-secondary); margin-bottom: 1.5rem; }
  .nf-bk {
    display: inline-block; padding: 12px 28px;
    background: var(--grad); color: #fff; text-decoration: none;
    border-radius: 999px; font-weight: 700;
    box-shadow: 0 8px 24px rgba(192, 132, 252, 0.4);
    transition: transform 0.2s ease;
  }
  .nf-bk:hover { transform: translateY(-2px); }
  
  /* HERO */
  .ap-hero { position: relative; padding: 3rem 0; overflow: hidden; min-height: 480px; }
  .ap-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: blur(35px) brightness(0.3) saturate(1.3);
    transform: scale(1.15); opacity: 0.7; z-index: 0;
  }
  .ap-fade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10, 5, 23, 0.55) 0%, rgba(10, 5, 23, 0.7) 60%, var(--bg-base, #0a0517) 100%);
    z-index: 1;
  }
  .ap-hero-in {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 280px 1fr;
    gap: 3rem; align-items: center;
  }
  .ap-poster {
    aspect-ratio: 3/4.4; border-radius: 18px; overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(192, 132, 252, 0.3);
  }
  .ap-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  
  .ap-info { min-width: 0; color: #fff; }
  .ap-badges { display: flex; gap: 8px; margin-bottom: 1rem; flex-wrap: wrap; }
  .ap-b {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 11px; border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em;
  }
  .ap-b-new { background: linear-gradient(135deg, #ef4444, #f97316); color: #fff; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4); }
  .ap-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 6px #fff;
    animation: apd 1.5s ease infinite;
  }
  @keyframes apd { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .ap-b-sc { background: rgba(10, 5, 23, 0.75); border: 1px solid rgba(251, 191, 36, 0.5); color: #fbbf24; backdrop-filter: blur(10px); }
  .ap-b-hd { background: rgba(125, 211, 252, 0.9); color: #0a0517; }
  .ap-b-age { background: rgba(192, 132, 252, 0.9); color: #0a0517; }
  
  .ap-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem; color: #fff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  }
  .ap-meta {
    display: flex; align-items: center; gap: 12px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem; font-family: 'JetBrains Mono', monospace;
    margin-bottom: 1rem; flex-wrap: wrap;
  }
  .mp-sep { color: rgba(192, 132, 252, 0.5); }
  .ap-genres { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 1.25rem; }
