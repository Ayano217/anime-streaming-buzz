---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';

export const prerender = false;

const { slug } = Astro.params;

// Fetch anime data from Jikan API by title search
async function fetchAnimeBySlug(slug) {
  const searchQuery = slug.replace(/-/g, ' ');
  try {
    const res = await fetch(`https://api.jikan.moe/v4/anime?q=${encodeURIComponent(searchQuery)}&limit=1`);
    if (!res.ok) return null;
    const data = await res.json();
    return data?.data?.[0] || null;
  } catch (e) {
    return null;
  }
}

async function fetchFullAnime(malId) {
  try {
    const res = await fetch(`https://api.jikan.moe/v4/anime/${malId}/full`);
    if (!res.ok) return null;
    const data = await res.json();
    return data?.data || null;
  } catch (e) {
    return null;
  }
}

async function fetchEpisodes(malId) {
  try {
    const res = await fetch(`https://api.jikan.moe/v4/anime/${malId}/episodes`);
    if (!res.ok) return [];
    const data = await res.json();
    return data?.data || [];
  } catch (e) {
    return [];
  }
}

async function fetchRelated() {
  try {
    const res = await fetch('https://api.jikan.moe/v4/top/anime?filter=airing&limit=12');
    if (!res.ok) return [];
    const data = await res.json();
    return data?.data || [];
  } catch (e) {
    return [];
  }
}

let anime = await fetchAnimeBySlug(slug);
if (anime && anime.mal_id) {
  const full = await fetchFullAnime(anime.mal_id);
  if (full) anime = full;
}

// Fallback if not found
if (!anime) {
  return Astro.redirect('/');
}

const episodes = await fetchEpisodes(anime.mal_id);
const related = await fetchRelated();

const title    = anime.title_english || anime.title || 'Unknown';
const titleJp  = anime.title_japanese || '';
const synopsis = (anime.synopsis || '').replace(/\[Written by MAL Rewrite\]/g, '').trim();
const image    = anime.images?.jpg?.large_image_url || '';
const banner   = anime.trailer?.images?.maximum_image_url || image;
const trailer  = anime.trailer?.youtube_id || '';
const score    = anime.score;
const rank     = anime.rank;
const popularity = anime.popularity;
const members  = anime.members;
const status   = anime.status || '';
const episodesCount = anime.episodes || '?';
const duration = anime.duration || '';
const rating   = anime.rating || '';
const year     = anime.year || '';
const season   = anime.season || '';
const genres   = (anime.genres || []).map(g => g.name);
const studios  = (anime.studios || []).map(s => s.name);
const producers = (anime.producers || []).slice(0, 3).map(p => p.name);
const streaming = anime.streaming || [];

function makeSlug(str) {
  return (str || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
}

const pageTitle = `${title} - Watch Online | AniTube Buzz`;
const pageDesc = synopsis.substring(0, 160);
---

<BaseLayout title={pageTitle} description={pageDesc} image={image}>
  <Header slot="header" />

  <!-- Cinematic banner backdrop -->
  <div class="anime-page-backdrop" style={banner ? `background-image: url(${banner})` : ''}></div>
  <div class="anime-page-backdrop-tint"></div>

  <div class="anime-page container">

    <!-- HERO: Video Player -->
    <div class="anime-hero-section">
      
      {trailer ? (
        <YouTubePlayer 
          videoId={trailer}
          title={`${title} - Official Trailer`}
          autoplay={true}
          poster={image}
        />
      ) : (
        <div class="anime-no-video">
          <img src={image} alt={title} class="anime-no-video-img" />
          <div class="anime-no-video-overlay">
            <div class="anime-no-video-msg">Preview video not available</div>
          </div>
        </div>
      )}
      
    </div>

    <!-- Anime Info Section -->
    <div class="anime-info-section">
      
      <div class="anime-info-main">
        
        <!-- Studio + badges -->
        <div class="anime-badges-row">
          {studios[0] && (
            <div class="anime-badge-studio">
              <div class="badge-mini-icon">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/></svg>
              </div>
              <span>{studios[0]}</span>
              <span class="studio-original">Original</span>
            </div>
          )}
          <div class="anime-badge-hd">HD 4K</div>
          {status === 'Currently Airing' && (
            <div class="anime-badge-airing">
              <span class="airing-dot"></span>
              NOW AIRING
            </div>
          )}
        </div>
        
        <!-- Title -->
        <h1 class="anime-page-title">{title}</h1>
        {titleJp && <p class="anime-page-title-jp">{titleJp}</p>}
        
        <!-- Meta info -->
        <div class="anime-page-meta">
          {year && <div class="meta-pill"><strong>{year}</strong></div>}
          {season && <div class="meta-pill">{season.charAt(0).toUpperCase() + season.slice(1)}</div>}
          <div class="meta-pill">{anime.type || 'TV'}</div>
          <div class="meta-pill">{episodesCount} EP</div>
          {duration && <div class="meta-pill">{duration}</div>}
          {rating && <div class="meta-pill meta-rating-pill">{rating}</div>}
        </div>
        
        <!-- Genres -->
        {genres.length > 0 && (
          <div class="anime-genres">
            {genres.slice(0, 6).map(g => (
              <span class="genre-chip">{g}</span>
            ))}
          </div>
        )}
        
        <!-- Synopsis -->
        {synopsis && (
          <div class="anime-synopsis">
            <p>{synopsis}</p>
          </div>
        )}
        
      </div>
      
      <!-- Sidebar Stats -->
      <div class="anime-info-side">
        
        {score && (
          <div class="stat-card stat-score">
            <div class="stat-label">Score</div>
            <div class="stat-value stat-value-large">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>{score}</span>
              <span class="stat-value-max">/10</span>
            </div>
          </div>
        )}
        
        {rank && (
          <div class="stat-card">
            <div class="stat-label">Rank</div>
            <div class="stat-value">
              <span class="stat-hash">#</span>{rank.toLocaleString()}
            </div>
          </div>
        )}
        
        {popularity && (
          <div class="stat-card">
            <div class="stat-label">Popularity</div>
            <div class="stat-value">
              <span class="stat-hash">#</span>{popularity.toLocaleString()}
            </div>
          </div>
        )}
        
        {members && (
          <div class="stat-card">
            <div class="stat-label">Members</div>
            <div class="stat-value">{(members / 1000).toFixed(0)}K</div>
          </div>
        )}
        
        {studios.length > 0 && (
          <div class="stat-card">
            <div class="stat-label">Studio</div>
            <div class="stat-value stat-value-text">{studios.join(', ')}</div>
          </div>
        )}
        
        {producers.length > 0 && (
          <div class="stat-card">
            <div class="stat-label">Producers</div>
            <div class="stat-value stat-value-text">{producers.join(', ')}</div>
          </div>
        )}
        
        {status && (
          <div class="stat-card">
            <div class="stat-label">Status</div>
            <div class="stat-value stat-value-text">{status}</div>
          </div>
        )}
        
      </div>
      
    </div>

    <!-- Episodes Section -->
    {episodes.length > 0 && (
      <div class="anime-episodes-section">
        
        <div class="episodes-header">
          <div class="episodes-title-wrap">
            <div class="episodes-bar"></div>
            <div>
              <div class="episodes-tag">EPISODE LIST</div>
              <h2 class="episodes-title">All <span class="grad-text">Episodes</span></h2>
            </div>
          </div>
          <div class="episodes-count">
            <span class="grad-text">{episodes.length}</span>
            <span>episodes</span>
          </div>
        </div>
        
        <div class="episodes-grid">
          {episodes.slice(0, 30).map((ep, idx) => (
            <a href={`/anime/${slug}/${ep.mal_id || (idx + 1)}`} class="episode-item">
              <div class="ep-num-wrap">
                <span class="ep-num">{String(ep.mal_id || (idx + 1)).padStart(2, '0')}</span>
              </div>
              <div class="ep-details">
                <div class="ep-title">{ep.title || `Episode ${idx + 1}`}</div>
                {ep.aired && (
                  <div class="ep-aired">{new Date(ep.aired).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                )}
              </div>
              <div class="ep-play">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
        
        {episodes.length > 30 && (
          <div class="episodes-more-note">
            Showing 30 of {episodes.length} episodes
          </div>
        )}
        
      </div>
    )}

    <!-- Streaming Platforms -->
    {streaming.length > 0 && (
      <div class="anime-streaming-section">
        <h2 class="section-title">
          Also Watch On <span class="grad-text">Official Platforms</span>
        </h2>
        <div class="streaming-grid">
          {streaming.slice(0, 6).map(s => (
            <a href={s.url} target="_blank" rel="noopener" class="streaming-link">
              <span>{s.name}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Related / Suggestions Section -->
    {related.length > 0 && (
      <div class="anime-related-section">
        
        <div class="related-header">
          <div class="related-bar"></div>
          <div>
            <div class="related-tag">YOU MIGHT ALSO LIKE</div>
            <h2 class="related-title">More <span class="grad-text">Trending Anime</span></h2>
          </div>
        </div>
        
        <div class="related-grid">
          {related.filter(a => a.mal_id !== anime.mal_id).slice(0, 12).map(a => {
            const rTitle = a.title_english || a.title || 'Unknown';
            const rImage = a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '';
            const rSlug = makeSlug(rTitle) || `anime-${a.mal_id}`;
            const rIsNew = a.status === 'Currently Airing';
            return (
              <a href={`/anime/${rSlug}`} class="related-card">
                <div class="related-thumb">
                  {rImage ? (
                    <img src={rImage} alt={rTitle} loading="lazy" />
                  ) : (
                    <div class="related-fallback"></div>
                  )}
                  <div class="related-overlay"></div>
                  <div class="related-play">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                  {rIsNew && <div class="related-new">NEW</div>}
                  {a.score && (
                    <div class="related-score">
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {a.score}
                    </div>
                  )}
                  <div class="related-info">
                    <div class="related-title-text">{rTitle}</div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Backdrop */
  .anime-page-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 500px;
    background-size: cover;
    background-position: center top;
    filter: blur(30px) brightness(0.35);
    z-index: 0;
    opacity: 0.6;
  }

  .anime-page-backdrop-tint {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 500px;
    background: linear-gradient(180deg, transparent 0%, var(--bg-base) 100%);
    z-index: 0;
  }

  .anime-page {
    position: relative;
    z-index: 1;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  /* Hero video section */
  .anime-hero-section {
    margin-bottom: 3rem;
    animation: fade-slide-up 0.7s ease;
  }

  @keyframes fade-slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .anime-no-video {
    position: relative;
    aspect-ratio: 16/9;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
  }

  .anime-no-video-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(4px) brightness(0.4);
  }

  .anime-no-video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .anime-no-video-msg {
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  /* Info section */
  .anime-info-section {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .anime-info-main {
    min-width: 0;
  }

  .anime-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .anime-badge-studio {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.8rem 0.32rem 0.35rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
    backdrop-filter: blur(10px);
  }

  .badge-mini-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .studio-original {
    color: var(--text-muted);
    font-size: 0.68rem;
    margin-left: 3px;
  }

  .anime-badge-hd {
    padding: 0.32rem 0.8rem;
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .anime-badge-airing {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.8rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .airing-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: airing-blink 1.5s ease infinite;
  }

  @keyframes airing-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .anime-page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.05;
    margin: 0 0 0.4rem;
    letter-spacing: -0.03em;
  }

  .anime-page-title-jp {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--cyan);
    margin-bottom: 1.25rem;
  }

  .anime-page-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .meta-pill {
    padding: 0.28rem 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .meta-pill strong {
    color: var(--text-primary);
  }

  .meta-rating-pill {
    background: rgba(192, 132, 252, 0.12);
    color: var(--purple);
    border-color: rgba(192, 132, 252, 0.3);
    font-weight: 700;
  }

  .anime-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .genre-chip {
    padding: 0.32rem 0.8rem;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    color: var(--purple);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .genre-chip:hover {
    background: rgba(192, 132, 252, 0.2);
    transform: translateY(-1px);
  }

  .anime-synopsis {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.95rem;
    padding: 1.25rem 1.5rem;
    background: rgba(28, 15, 61, 0.4);
    border-left: 3px solid var(--purple);
    border-radius: 0 12px 12px 0;
    backdrop-filter: blur(10px);
  }

  /* Sidebar stats */
  .anime-info-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .stat-card {
    padding: 14px 18px;
    background: rgba(28, 15, 61, 0.5);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    backdrop-filter: blur(10px);
    transition: border-color 0.3s ease;
  }

  .stat-card:hover {
    border-color: rgba(192, 132, 252, 0.4);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .stat-value-large {
    font-size: 1.5rem;
  }

  .stat-value-max {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .stat-value-text {
    font-size: 0.85rem;
    font-family: var(--font-body);
    font-weight: 600;
    display: block;
  }

  .stat-hash {
    color: var(--purple);
    font-weight: 800;
  }

  .stat-score .stat-value {
    color: #fbbf24;
  }

  /* Episodes */
  .anime-episodes-section {
    margin-bottom: 3rem;
    padding: 2rem;
    background: rgba(15, 6, 32, 0.5);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    backdrop-filter: blur(15px);
  }

  .episodes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .episodes-title-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .episodes-bar {
    width: 4px;
    height: 42px;
    background: var(--grad);
    border-radius: 3px;
    box-shadow: 0 0 12px rgba(192, 132, 252, 0.5);
  }

  .episodes-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--purple);
    margin-bottom: 4px;
  }

  .episodes-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .episodes-count {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .episodes-count > span:last-child {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 10px;
  }

  .episode-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    background: rgba(28, 15, 61, 0.5);
    border: 1px solid rgba(192, 132, 252, 0.1);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s ease;
  }

  .episode-item:hover {
    background: rgba(28, 15, 61, 0.8);
    border-color: rgba(192, 132, 252, 0.5);
    transform: translateX(4px);
  }

  .ep-num-wrap {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.2), rgba(232, 121, 249, 0.15));
    border: 1px solid rgba(192, 132, 252, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ep-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ep-details {
    flex: 1;
