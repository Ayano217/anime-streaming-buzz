---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
---

<BaseLayout 
  title={`Loading anime...`}
  description="Watch anime episodes online in premium HD quality on AniTube Buzz."
>
  <Header slot="header" />
  
  <div class="anime-page">
    <div id="animeLoader" class="anime-loader">
      <div class="loader-spinner"></div>
      <p>Loading anime details...</p>
    </div>
    
    <div id="animeNotFound" class="not-found" style="display:none;">
      <div class="nf-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </div>
      <h1>Anime Not Found</h1>
      <p>The anime you're looking for doesn't exist or has been removed.</p>
      <a href="/" class="nf-back">← Back to Homepage</a>
    </div>
    
    <div id="animeContent" style="display:none;">
      <!-- Hero backdrop -->
      <div class="anime-hero">
        <div class="hero-bg" id="heroBg"></div>
        <div class="hero-fade"></div>
        <div class="hero-fade-side"></div>
        
        <div class="container">
          <div class="hero-inner">
            <div class="hero-poster">
              <div class="poster-glow"></div>
              <img id="posterImg" alt="" />
              <div class="poster-play">
                <div class="pp-ring"></div>
                <div class="pp-ring pp-ring-2"></div>
                <button class="pp-btn" id="watchNowBtn">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </button>
              </div>
            </div>
            
            <div class="hero-info">
              <div class="hero-badges" id="heroBadges"></div>
              <h1 class="hero-title" id="heroTitle">Loading...</h1>
              <div class="hero-meta" id="heroMeta"></div>
              <div class="hero-genres" id="heroGenres"></div>
              <p class="hero-synopsis" id="heroSynopsis"></p>
              
              <div class="hero-actions">
                <button class="btn-primary" id="watchBtn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Now</span>
                </button>
                <button class="btn-secondary">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                  <span>More Info</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Video player placeholder -->
      <section class="section-block player-block" id="playerBlock" style="display:none;">
        <div class="container">
          <div class="player-header">
            <h2 class="section-title"><span class="grad-text">Watch Episode</span></h2>
          </div>
          <div class="player-wrap">
            <div id="videoPlayer" class="video-player-frame">
              <div class="player-loading">
                <div class="loader-spinner"></div>
                <p>Loading player...</p>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Related section (placeholder for now) -->
      <section class="section-block related-block">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">You Might Also Like</span></h2>
          <div id="relatedGrid" class="related-grid">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ slug }}>
(async function() {
  var loader     = document.getElementById('animeLoader');
  var notFound   = document.getElementById('animeNotFound');
  var content    = document.getElementById('animeContent');
  var heroBg     = document.getElementById('heroBg');
  var posterImg  = document.getElementById('posterImg');
  var heroTitle  = document.getElementById('heroTitle');
  var heroMeta   = document.getElementById('heroMeta');
  var heroGenres = document.getElementById('heroGenres');
  var heroSyno   = document.getElementById('heroSynopsis');
  var heroBadges = document.getElementById('heroBadges');
  var relatedGrid = document.getElementById('relatedGrid');
  var playerBlock = document.getElementById('playerBlock');
  var videoPlayer = document.getElementById('videoPlayer');
  var watchBtn    = document.getElementById('watchBtn');
  var watchNowBtn = document.getElementById('watchNowBtn');
  
  function esc(str) {
    return String(str || '').replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  
  async function fetchCategory(cat) {
    try {
      var res = await fetch('/api/anime?category=' + cat);
      var json = await res.json();
      return json.success ? (json.anime || []) : [];
    } catch { return []; }
  }
  
  async function findAnime() {
    var cats = ['airing', 'top', 'popular', 'upcoming', 'movies'];
    var allAnime = [];
    for (var i = 0; i < cats.length; i++) {
      var list = await fetchCategory(cats[i]);
      allAnime = allAnime.concat(list);
      var found = list.find(function(a) { return a.slug === slug; });
      if (found) return { found: found, all: allAnime };
    }
    return { found: null, all: allAnime };
  }
  
  function render(anime, allAnime) {
    document.title = anime.title + ' - AniTube Buzz';
    
    if (anime.image) {
      heroBg.style.backgroundImage = 'url(' + anime.image + ')';
      posterImg.src = anime.image;
      posterImg.alt = anime.title;
    }
    
    heroTitle.textContent = anime.title;
    
    var badges = [];
    if (anime.status === 'current' || anime.status === 'Currently Airing') {
      badges.push('<span class="hb hb-new"><span class="hb-dot"></span>AIRING NOW</span>');
    }
    if (anime.score) {
      badges.push('<span class="hb hb-score"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' + Number(anime.score).toFixed(1) + '</span>');
    }
    badges.push('<span class="hb hb-hd">HD</span>');
    heroBadges.innerHTML = badges.join('');
    
    var meta = [];
    if (anime.year) meta.push(anime.year);
    if (anime.episodes && anime.episodes > 0) meta.push(anime.episodes + ' Episodes');
    if (anime.status) {
      var s = String(anime.status).replace(/_/g, ' ');
      s = s.charAt(0).toUpperCase() + s.slice(1);
      meta.push(s);
    }
    heroMeta.innerHTML = meta.map(function(m) { return '<span>' + esc(m) + '</span>'; }).join('<span class="meta-sep">·</span>');
    
    if (anime.genres && anime.genres.length) {
      heroGenres.innerHTML = anime.genres.slice(0, 5).map(function(g) {
        return '<span class="genre-pill">' + esc(g) + '</span>';
      }).join('');
    }
    
    heroSyno.textContent = anime.synopsis || 'No synopsis available for this anime.';
    
    // Related
    var related = allAnime.filter(function(a) { return a.slug !== anime.slug; }).slice(0, 12);
    if (related.length > 0) {
      relatedGrid.innerHTML = related.map(function(a) {
        var img = a.image 
          ? '<img src="' + esc(a.image) + '" alt="" loading="lazy" />'
          : '<div class="rg-nomg"></div>';
        return '<a href="/anime/' + esc(a.slug) + '" class="related-card">' +
          '<div class="rc-poster">' + img +
            '<div class="rc-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>' +
          '</div>' +
          '<div class="rc-title">' + esc(a.title) + '</div>' +
        '</a>';
      }).join('');
    }
    
    // Watch button opens YouTube search embed
    function openPlayer() {
      playerBlock.style.display = 'block';
      var query = encodeURIComponent(anime.title + ' anime trailer official');
      videoPlayer.innerHTML = 
        '<div class="atb-player-wrap">' +
          '<div class="atb-brand">' +
            '<div class="atb-logo-mini">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7l-2 7 9-11h-7l2-7z"/></svg>' +
            '</div>' +
            '<span>AniTube Player</span>' +
          '</div>' +
          '<iframe ' +
            'src="https://www.youtube.com/embed?listType=search&list=' + query + '&autoplay=0&rel=0&modestbranding=1" ' +
            'frameborder="0" ' +
            'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" ' +
            'allowfullscreen>' +
          '</iframe>' +
        '</div>';
      setTimeout(function() {
        playerBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
    
    if (watchBtn) watchBtn.addEventListener('click', openPlayer);
    if (watchNowBtn) watchNowBtn.addEventListener('click', openPlayer);
    
    loader.style.display = 'none';
    content.style.display = 'block';
  }
  
  try {
    var result = await findAnime();
    if (result.found) {
      render(result.found, result.all);
    } else {
      loader.style.display = 'none';
      notFound.style.display = 'flex';
    }
  } catch (err) {
    console.error('Anime load error:', err);
    loader.style.display = 'none';
    notFound.style.display = 'flex';
  }
})();
</script>

<style>
  .anime-page { min-height: 100vh; }
  
  .anime-loader, .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 1rem;
    color: var(--text-muted);
    text-align: center;
  }
  
  .loader-spinner {
    width: 40px; height: 40px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 1rem;
  }
  
  @keyframes spin { to { transform: rotate(360deg); } }
  
  .nf-icon { color: #c084fc; margin-bottom: 1rem; }
  .not-found h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }
  .not-found p { margin-bottom: 1.5rem; }
  .nf-back {
    display: inline-block;
    padding: 12px 28px;
    background: var(--grad);
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(192, 132, 252, 0.4);
    transition: transform 0.2s ease;
  }
  .nf-back:hover { transform: translateY(-2px); }
  
  /* ═══ HERO ═══ */
  .anime-hero {
    position: relative;
    padding: 4rem 0 3rem;
    overflow: hidden;
    min-height: 500px;
  }
  
  .hero-bg {
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(30px) brightness(0.35) saturate(1.2);
    transform: scale(1.15);
    opacity: 0.8;
    z-index: 0;
  }
  
  .hero-fade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(10, 5, 23, 0.5) 60%, #0a0517 100%);
    z-index: 1;
  }
  
  .hero-fade-side {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(10, 5, 23, 0.6) 0%, transparent 50%, rgba(10, 5, 23, 0.4) 100%);
    z-index: 1;
  }
  
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: center;
  }
  
  .hero-poster {
    position: relative;
    aspect-ratio: 3/4.4;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 
      0 25px 60px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(192, 132, 252, 0.3);
  }
  
  .poster-glow {
    position: absolute;
    inset: -3px;
    border-radius: 20px;
    background: conic-gradient(from 0deg, #c084fc, #e879f9, #7dd3fc, #c084fc);
    animation: glow-spin 5s linear infinite;
    filter: blur(10px);
    opacity: 0.6;
    z-index: -1;
  }
  
  @keyframes glow-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  
  .hero-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  
  .poster-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 78px; height: 78px;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .hero-poster:hover .poster-play { opacity: 1; }
  
  .pp-btn {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    border: none;
    color: #fff;
    padding-left: 5px;
    cursor: pointer;
    box-shadow: 
      0 12px 30px rgba(192, 132, 252, 0.65),
      0 0 40px rgba(232, 121, 249, 0.4);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.2s ease;
    z-index: 2;
  }
  
  .pp-btn:hover { transform: scale(1.08); }
  
  .pp-ring {
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(192, 132, 252, 0.7);
    animation: ring-pulse 2s ease-out infinite;
  }
  
  .pp-ring-2 { animation-delay: 1s; }
  
  @keyframes ring-pulse {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  
  .hero-info { min-width: 0; }
  
  .hero-badges {
    display: flex; gap: 8px;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  
  .hb {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  
  .hb-new {
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
  }
  
  .hb-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 6px #fff;
    animation: live-blink 1.5s ease infinite;
  }
  
  @keyframes live-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  
  .hb-score {
    background: rgba(10, 5, 23, 0.75);
    border: 1px solid rgba(251, 191, 36, 0.5);
    color: #fbbf24;
    backdrop-filter: blur(10px);
  }
  
  .hb-hd {
    background: rgba(125, 211, 252, 0.9);
    color: #0a0517;
  }
  
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }
  
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  
  .meta-sep { color: rgba(192, 132, 252, 0.5); }
  
  .hero-genres {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  
  .genre-pill {
    display: inline-block;
    padding: 5px 12px;
    background: rgba(192, 132, 252, 0.12);
    border: 1px solid rgba(192, 132, 252, 0.3);
    color: #c084fc;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    backdrop-filter: blur(10px);
  }
  
  .hero-synopsis {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 1.75rem;
    max-width: 700px;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    border: none;
    text-decoration: none;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #c084fc 0%, #e879f9 50%, #7dd3fc 100%);
    color: #fff;
    box-shadow: 0 10px 30px rgba(192, 132, 252, 0.5);
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(192, 132, 252, 0.65);
  }
  
  .btn-secondary {
    background: rgba(28, 15, 61, 0.6);
    color: var(--text-primary);
    border: 1px solid rgba(192, 132, 252, 0.3);
    backdrop-filter: blur(10px);
  }
  
  .btn-secondary:hover {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.5);
    transform: translateY(-3px);
  }
  
  /* Player */
  .player-header { margin-bottom: 1.5rem; }
  
  .player-wrap {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    background: #000;
  }
  
  .video-player-frame {
    position: relative;
    aspect-ratio: 16/9;
    background: #000;
  }
  
  .atb-player-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .atb-player-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  
  .atb-brand {
    position: absolute;
    top: 12px; left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    background: rgba(10, 5, 23, 0.8);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 999px;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    z-index: 10;
    pointer-events: none;
    opacity: 0.85;
  }
  
  .atb-logo-mini {
    color: #e879f9;
    display: flex;
  }
  
  .player-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }
  
  /* Related */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }
  
  .related-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }
  
  .related-card:hover { transform: translateY(-6px); }
  
  .rc-poster {
    position: relative;
    aspect-ratio: 3/4.4;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(28, 15, 61, 0.5);
    margin-bottom: 8px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(192, 132, 252, 0.1);
    transition: box-shadow 0.3s ease;
  }
  
  .related-card:hover .rc-poster {
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5), 0 0 0 1.5px rgba(232, 121, 249, 0.6);
  }
  
  .rc-poster img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .related-card:hover .rc-poster img { transform: scale(1.08); }
  
  .rc-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    display: flex;
    align-items: center; justify-content: center;
    color: #fff;
    padding-left: 3px;
    box-shadow: 0 6px 20px rgba(192, 132, 252, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .related-card:hover .rc-play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  
  .rc-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 0 2px;
  }
  
  .rg-nomg {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(125, 211, 252, 0.1));
  }
  
  .skeleton-card {
    aspect-ratio: 3/4.4;
    border-radius: 12px;
    background: linear-gradient(90deg,
      rgba(192, 132, 252, 0.05) 25%,
      rgba(192, 132, 252, 0.12) 50%,
      rgba(192, 132, 252, 0.05) 75%
    );
    background-size: 200% 100%;
    animation: skel-shine 1.5s infinite;
  }
  
  @keyframes skel-shine {
    from { background-position: -200% 0; }
    to   { background-position:  200% 0; }
  }
  
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 220px 1fr;
      gap: 2rem;
