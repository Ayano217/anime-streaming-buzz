---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const novelty = sortedPosts.slice(0, 4);
const news    = sortedPosts.slice(4, 8);
const latest  = sortedPosts.slice(8, 16);
---

<BaseLayout>
  <Header slot="header" />

  <HeroSection />

  <section class="section-block arrivals-block">
    <div class="container">
      
      <div class="arrivals-header">
        <div class="arrivals-title-wrap">
          <div class="arrivals-bar"></div>
          <div>
            <div class="arrivals-tag">
              <span class="arrivals-dot"></span>
              <span>FRESH · UPDATED DAILY</span>
            </div>
            <h2 class="arrivals-title">
              <span class="grad-text">New Arrivals</span>
            </h2>
          </div>
        </div>
        
        <div class="arrivals-actions">
          <div class="search-inline">
            <svg class="search-inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input 
              type="text" 
              id="quickSearch" 
              placeholder="Search anime..." 
              class="search-inline-input"
              autocomplete="off"
            />
            <div id="searchDropdown" class="search-dropdown"></div>
          </div>
          
          <div class="arrivals-count">
            <span class="arrivals-count-num" id="arrivalsCount">0</span>
            <span class="arrivals-count-lbl">titles</span>
          </div>
        </div>
      </div>
      
      <div class="cat-tabs" id="catTabs">
        <button class="cat-tab active" data-source="airing">
          <span class="cat-tab-dot"></span>
          <span>Now Airing</span>
        </button>
        <button class="cat-tab" data-source="top">Top Rated</button>
        <button class="cat-tab" data-source="upcoming">Upcoming</button>
        <button class="cat-tab" data-source="popular">Popular</button>
        <button class="cat-tab" data-source="movies">Movies</button>
      </div>
      
      <div class="arrivals-grid" id="arrivalsGrid">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
      </div>
      
      <div class="load-more-wrap" id="loadMoreWrap" style="display:none;">
        <button class="load-more-btn" id="loadMoreBtn">
          <span class="load-more-inner">
            <span>Load More Anime</span>
            <div class="load-more-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </div>
          </span>
        </button>
      </div>
      
      <div class="loading-more" id="loadingMore" style="display:none;">
        <div class="loading-spinner"></div>
        <span>Loading more anime...</span>
      </div>
      
      <div class="end-message" id="endMessage" style="display:none;">
        <div class="end-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <span>You've explored everything. Check back tomorrow for more!</span>
      </div>
      
      <div class="error-message" id="errorMessage" style="display:none;">
        <div class="error-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4M12 16h.01"/>
          </svg>
        </div>
        <h3>Loading anime feed...</h3>
        <p id="errorSubtext">Trying multiple sources. This may take a moment.</p>
        <button onclick="location.reload()" class="error-retry">Refresh Page</button>
      </div>
      
    </div>
  </section>

  {novelty.length > 0 && (
    <section class="section-block novelty-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Novelty</span></h2>
        <div class="novelty-grid">
          {novelty.map((post) => (
            <a href={`/posts/${post.slug}`} class="novelty-card">
              <div class="nc-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="nc-overlay"></div>
              </div>
              <div class="nc-content">
                <h3 class="nc-title">{post.data.title}</h3>
                <p class="nc-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section-block news-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">News</span></h2>
        <div class="news-grid">
          {news.map((post) => (
            <a href={`/posts/${post.slug}`} class="news-card">
              <div class="nw-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
              </div>
              <div class="nw-content">
                <div class="nw-category">{post.data.category}</div>
                <h3 class="nw-title">{post.data.title}</h3>
                <p class="nw-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="section-block latest-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Latest Season</span></h2>
        <div class="latest-grid">
          {latest.map((post) => (
            <a href={`/posts/${post.slug}`} class="latest-card">
              <div class="lt-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="lt-overlay">
                  <div class="lt-play-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="lt-content">
                <h3 class="lt-title">{post.data.title}</h3>
                <div class="lt-meta">
                  <span>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
(function() {
  var currentSource = 'airing';
  var loading = false;
  var totalLoaded = 0;
  var allIds = {};
  var allLoadedAnime = [];
  var currentPage = 1;
  var PAGE_SIZE = 12;
  var fullDataset = [];
  
  var grid       = document.getElementById('arrivalsGrid');
  var loadBtn    = document.getElementById('loadMoreBtn');
  var loadWrap   = document.getElementById('loadMoreWrap');
  var loadingEl  = document.getElementById('loadingMore');
  var endMsg     = document.getElementById('endMessage');
  var errorMsg   = document.getElementById('errorMessage');
  var errorSub   = document.getElementById('errorSubtext');
  var countEl    = document.getElementById('arrivalsCount');
  var catTabs    = document.querySelectorAll('.cat-tab');
  var searchIn   = document.getElementById('quickSearch');
  var searchDD   = document.getElementById('searchDropdown');
  
  function esc(str) {
    return String(str || '').replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  
  function truncate(str, n) {
    str = String(str || '');
    return str.length > n ? str.slice(0, n).trim() + '…' : str;
  }
  
  function createCard(anime, index) {
    var title    = anime.title || 'Unknown';
    var image    = anime.image || '';
    var slug     = anime.slug || ('anime-' + anime.id);
    var score    = anime.score ? Number(anime.score).toFixed(1) : '';
    var year     = anime.year || '';
    var episodes = anime.episodes && anime.episodes > 0 ? anime.episodes : '';
    var genre    = (anime.genres && anime.genres.length) ? anime.genres[0] : '';
    var isNew    = anime.status === 'current' || anime.status === 'Currently Airing';
    
    var card = document.createElement('a');
    card.href = '/anime/' + slug;
    card.className = 'a-card';
    card.style.animationDelay = ((index % 12) * 60) + 'ms';
    
    var imgHtml = image 
      ? '<img src="' + esc(image) + '" alt="' + esc(title) + '" loading="lazy" class="a-img" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'" />' +
        '<div class="a-fallback" style="display:none"><svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>'
      : '<div class="a-fallback"><svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>';
    
    var scoreBadge = score 
      ? '<div class="a-score"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span>' + score + '</span></div>'
      : '';
    
    var newBadge = isNew ? '<div class="a-new">NEW</div>' : '';
    
    var metaParts = [];
    if (year) metaParts.push(esc(year));
    if (episodes) metaParts.push(esc(episodes) + ' EP');
    var metaHtml = metaParts.join(' <span class="a-dot">·</span> ');
    
    card.innerHTML = 
      '<div class="a-poster">' +
        '<div class="a-glow"></div>' +
        imgHtml +
        '<div class="a-shade"></div>' +
        '<div class="a-shine"></div>' +
        newBadge +
        scoreBadge +
        '<div class="a-play">' +
          '<div class="a-ring"></div>' +
          '<div class="a-ring a-ring-2"></div>' +
          '<div class="a-playbtn">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<div class="a-info">' +
        '<h3 class="a-title">' + esc(truncate(title, 45)) + '</h3>' +
        (metaHtml ? '<div class="a-meta">' + metaHtml + '</div>' : '') +
        (genre ? '<div class="a-genre">' + esc(genre) + '</div>' : '') +
      '</div>';
    
    return card;
  }
  
  function updateCount() {
    if (!countEl) return;
    var current = parseInt(countEl.textContent) || 0;
    var target = totalLoaded;
    if (current === target) return;
    var step = Math.max(1, Math.ceil((target - current) / 10));
    var counter = function() {
      current = Math.min(current + step, target);
      countEl.textContent = current;
      if (current < target) requestAnimationFrame(counter);
    };
    requestAnimationFrame(counter);
  }
  
  function renderPage() {
    var start = (currentPage - 1) * PAGE_SIZE;
    var end = currentPage * PAGE_SIZE;
    var slice = fullDataset.slice(start, end);
    
    if (currentPage === 1) grid.innerHTML = '';
    
    slice.forEach(function(anime, idx) {
      if (allIds[anime.id]) return;
      allIds[anime.id] = true;
      var card = createCard(anime, idx);
      grid.appendChild(card);
      totalLoaded++;
    });
    
    updateCount();
    
    if (end >= fullDataset.length) {
      if (loadWrap) loadWrap.style.display = 'none';
      if (endMsg && totalLoaded >= 12) endMsg.style.display = 'flex';
    } else {
      if (loadWrap) loadWrap.style.display = 'flex';
      if (endMsg) endMsg.style.display = 'none';
    }
  }
  
  async function loadAnime(source) {
    if (loading) return;
    loading = true;
    
    if (errorMsg) errorMsg.style.display = 'none';
    if (endMsg) endMsg.style.display = 'none';
    
    try {
      var res = await fetch('/api/anime?category=' + source);
      if (!res.ok) throw new Error('API returned ' + res.status);
      var json = await res.json();
      if (!json.success) throw new Error(json.error || 'API returned failure');
      
      fullDataset = (json.anime || []).filter(function(a) { return a && a.id; });
      
      if (fullDataset.length === 0) throw new Error('No anime data returned');
      
      currentPage = 1;
      totalLoaded = 0;
      allIds = {};
      if (countEl) countEl.textContent = '0';
      
      renderPage();
      
      if (loadingEl) loadingEl.style.display = 'none';
      loading = false;
      
    } catch (err) {
      console.warn('Load failed:', err.message);
      loading = false;
      if (loadingEl) loadingEl.style.display = 'none';
      
      if (totalLoaded === 0) {
        grid.innerHTML = '';
        if (errorMsg) {
          errorMsg.style.display = 'block';
          if (errorSub) {
            errorSub.textContent = 'Anime database is temporarily unavailable. Please try again in a moment.';
          }
        }
      }
    }
  }
  
  // Category tabs
  catTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var source = tab.dataset.source;
      if (source === currentSource) return;
      
      catTabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      
      currentSource = source;
      totalLoaded = 0;
      allIds = {};
      currentPage = 1;
      if (countEl) countEl.textContent = '0';
      if (endMsg) endMsg.style.display = 'none';
      if (errorMsg) errorMsg.style.display = 'none';
      if (loadWrap) loadWrap.style.display = 'none';
      
      grid.innerHTML = 
        '<div class="skeleton-card"></div>'.repeat(6);
      
      loadAnime(source);
    });
  });
  
  // Load more
  if (loadBtn) {
    loadBtn.addEventListener('click', function() {
      currentPage++;
      renderPage();
    });
  }
  
  // Live inline search
  var searchTimeout;
  if (searchIn) {
    searchIn.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      var q = searchIn.value.trim().toLowerCase();
      if (!q) {
        if (searchDD) { searchDD.innerHTML = ''; searchDD.classList.remove('open'); }
        return;
      }
      searchTimeout = setTimeout(function() {
        var matches = fullDataset.filter(function(a) {
          return (a.title || '').toLowerCase().indexOf(q) !== -1;
        }).slice(0, 6);
        
        if (searchDD) {
          if (matches.length === 0) {
            searchDD.innerHTML = 
              '<a href="/search?q=' + encodeURIComponent(q) + '" class="sd-item sd-more">' +
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' +
                '<span>Search all anime for "' + esc(q) + '"</span>' +
              '</a>';
          } else {
            var html = matches.map(function(a) {
              var img = a.image ? '<img src="' + esc(a.image) + '" alt="" />' : '<div class="sd-nomg"></div>';
              return '<a href="/anime/' + esc(a.slug) + '" class="sd-item">' +
                '<div class="sd-thumb">' + img + '</div>' +
                '<div class="sd-info">' +
                  '<div class="sd-title">' + esc(a.title) + '</div>' +
                  '<div class="sd-meta">' + esc(a.year || '') + (a.score ? ' · ⭐ ' + a.score : '') + '</div>' +
                '</div>' +
              '</a>';
            }).join('');
            html += '<a href="/search?q=' + encodeURIComponent(q) + '" class="sd-item sd-more">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' +
              '<span>See all results for "' + esc(q) + '"</span>' +
            '</a>';
            searchDD.innerHTML = html;
          }
          searchDD.classList.add('open');
        }
      }, 180);
    });
    
    searchIn.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        var q = searchIn.value.trim();
        if (q) window.location.href = '/search?q=' + encodeURIComponent(q);
      } else if (e.key === 'Escape') {
        if (searchDD) { searchDD.classList.remove('open'); }
        searchIn.blur();
      }
    });
    
    document.addEventListener('click', function(e) {
      if (searchDD && !e.target.closest('.search-inline')) {
        searchDD.classList.remove('open');
      }
    });
  }
  
  loadAnime(currentSource);
})();
</script>

<style>
  .arrivals-block { position: relative; }
  
  .arrivals-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  
  .arrivals-title-wrap { display: flex; align-items: center; gap: 1rem; }
  
  .arrivals-bar {
    width: 4px; height: 48px;
    background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
    border-radius: 3px;
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.6);
    animation: bar-glow 3s ease infinite;
  }
  
  @keyframes bar-glow {
    0%, 100% { box-shadow: 0 0 15px rgba(192, 132, 252, 0.6); }
    50%       { box-shadow: 0 0 25px rgba(232, 121, 249, 0.8); }
  }
  
  .arrivals-tag {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.15em; color: #c084fc;
    margin-bottom: 4px;
  }
  
  .arrivals-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #ef4444; box-shadow: 0 0 8px #ef4444;
    animation: live-blink 1.5s ease infinite;
  }
  
  @keyframes live-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  
  .arrivals-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800; margin: 0;
    letter-spacing: -0.03em; line-height: 1;
  }
  
  .arrivals-actions {
    display: flex; align-items: center; gap: 12px;
  }
  
  /* Inline search */
  .search-inline {
    position: relative;
    display: flex; align-items: center;
    background: rgba(28, 15, 61, 0.6);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 999px;
    padding: 0 16px 0 14px;
    transition: all 0.25s ease;
    backdrop-filter: blur(10px);
    min-width: 260px;
  }
  
  .search-inline:focus-within {
    border-color: rgba(232, 121, 249, 0.6);
    box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
    background: rgba(28, 15, 61, 0.85);
  }
  
  .search-inline-icon {
    color: #c084fc;
    flex-shrink: 0;
    margin-right: 8px;
  }
  
  .search-inline-input {
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
    padding: 10px 0;
    width: 100%;
  }
  
  .search-inline-input::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }
  
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0; right: 0;
    background: rgba(15, 8, 35, 0.98);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 16px;
    padding: 6px;
    max-height: 400px;
    overflow-y: auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(192, 132, 252, 0.1);
    backdrop-filter: blur(20px);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 0.2s ease;
  }
  
  .search-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .sd-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text-primary);
    transition: background 0.15s ease;
  }
  
  .sd-item:hover {
    background: rgba(192, 132, 252, 0.12);
  }
  
  .sd-thumb {
    width: 44px; height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(192, 132, 252, 0.1);
    flex-shrink: 0;
  }
  
  .sd-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .sd-nomg { width: 100%; height: 100%; }
  
  .sd-info { flex: 1; min-width: 0; }
  
  .sd-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  
  .sd-meta {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }
  
  .sd-more {
    border-top: 1px solid rgba(192, 132, 252, 0.15);
    margin-top: 4px;
    padding-top: 12px;
    color: #c084fc;
    font-size: 0.82rem;
    font-weight: 600;
    justify-content: center;
    gap: 8px;
  }
  
  .sd-more:hover { color: #e879f9; background: rgba(232, 121, 249, 0.08); }
  
  .arrivals-count {
    display: flex; align-items: baseline; gap: 6px;
    padding: 8px 16px;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  
  .arrivals-count-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem; font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    min-width: 24px; display: inline-block; text-align: center;
  }
  
  .arrivals-count-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 700;
