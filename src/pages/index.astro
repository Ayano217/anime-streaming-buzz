---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const novelty = sortedPosts.slice(0, 4);
const news    = sortedPosts.slice(4, 8);
---

<BaseLayout>
  <Header slot="header" />
  <HeroSection />

  <!-- ═══ NEW ARRIVALS — anime + inline products ═══ -->
  <section class="section-block arrivals-block">
    <div class="container">
      <div class="arrivals-header">
        <div class="arrivals-title-wrap">
          <div class="arrivals-bar"></div>
          <div>
            <div class="arrivals-tag">
              <span class="arrivals-dot"></span>
              <span>FRESH · UPDATED DAILY</span>
            </div>
            <h2 class="arrivals-title"><span class="grad-text">New Arrivals</span></h2>
          </div>
        </div>
        <div class="arrivals-actions">
         <div class="arrivals-count">
            <span class="arrivals-count-num" id="arrivalsCount">0</span>
            <span class="arrivals-count-lbl">titles</span>
          </div>
        </div>
      </div>

      <div class="cat-tabs" id="catTabs">
        <button class="cat-tab active" data-cat="airing"><span class="cat-tab-dot"></span><span>Now Airing</span></button>
        <button class="cat-tab" data-cat="top">Top Rated</button>
        <button class="cat-tab" data-cat="upcoming">Upcoming</button>
        <button class="cat-tab" data-cat="popular">Popular</button>
        <button class="cat-tab" data-cat="movies">Movies</button>
      </div>

      <div id="arrivalsGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;"></div>

      <div class="loading-more" id="loadingMore" style="display:none;">
        <div class="ld-spinner"></div><span>Loading more...</span>
      </div>

      <div class="end-message" id="endMessage" style="display:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>You've explored everything!</span>
      </div>

      <div class="error-msg" id="errorMsg" style="display:none;">
        <div class="err-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg></div>
        <h3>Loading anime feed...</h3>
        <p id="errorSub">Trying multiple sources.</p>
        <button onclick="location.reload()" class="err-retry">Refresh Page</button>
      </div>
    </div>
  </section>

  {novelty.length > 0 && (
    <section class="section-block novelty-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Latest Articles</span></h2>
        <div class="novelty-grid">
          {novelty.map((post) => (
            <a href={`/posts/${post.slug}`} class="novelty-card">
              <div class="nc-img">{post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}<div class="nc-ov"></div></div>
              <div class="nc-ct"><h3 class="nc-t">{post.data.title}</h3><p class="nc-e">{post.data.excerpt}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section-block news-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">News</span></h2>
        <div class="news-grid">
          {news.map((post) => (
            <a href={`/posts/${post.slug}`} class="news-card">
              <div class="nw-img">{post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}</div>
              <div class="nw-ct"><div class="nw-cat">{post.data.category}</div><h3 class="nw-t">{post.data.title}</h3><p class="nw-e">{post.data.excerpt}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @keyframes atNaCardIn { from{opacity:0;transform:translateY(15px)} to{opacity:1;transform:translateY(0)} }
  @keyframes atNaPlayRing { 0%{transform:scale(1);opacity:.9} 100%{transform:scale(1.7);opacity:0} }
  
  .at-na-card { transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1) !important; cursor: pointer; }
  .at-na-card:hover { transform: translateY(-8px) !important; }
  .at-na-card:hover .at-na-thumb {
    border-color: rgba(232,121,249,0.9) !important;
    box-shadow: 0 20px 45px rgba(0,0,0,0.6), 0 0 30px rgba(192,132,252,0.6), 0 0 0 1px rgba(232,121,249,0.8) !important;
  }
  .at-na-card:hover .at-na-play { opacity: 1 !important; transform: translate(-50%,-50%) scale(1) !important; }
  .at-na-card:hover .at-na-img { transform: scale(1.1) !important; filter: brightness(0.65) !important; }
  .at-na-card:hover .at-na-shine { left: 120% !important; }
  .at-na-card:hover .at-na-overlay { opacity: 1 !important; }
  .at-na-card:hover .at-na-title {
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
  }

  /* ═══ INLINE PRODUCT CARD (matches anime card size exactly) ═══ */
  .at-inline-product {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    animation: atNaCardIn 0.5s ease backwards;
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .at-inline-product:hover { transform: translateY(-8px); }
  .at-inline-product:hover .at-ip-thumb {
    border-color: rgba(232,121,249,0.9) !important;
    box-shadow: 0 20px 45px rgba(0,0,0,0.6), 0 0 30px rgba(192,132,252,0.6), 0 0 0 1px rgba(232,121,249,0.8);
  }
  .at-inline-product:hover .at-ip-img {
    transform: scale(1.08);
    filter: brightness(0.65);
  }
  .at-inline-product:hover .at-ip-shine { left: 120%; }
  .at-inline-product:hover .at-ip-overlay { opacity: 1; }
  .at-inline-product:hover .at-ip-cta {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .at-inline-product:hover .at-ip-title {
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  @media (max-width: 1024px) {
    #arrivalsGrid { grid-template-columns: repeat(3, 1fr) !important; gap: 12px !important; }
  }
  @media (max-width: 768px) {
    .at-na-play { opacity: 1 !important; transform: translate(-50%,-50%) scale(0.85) !important; }
    #arrivalsGrid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; }
    .at-ip-cta { opacity: 1 !important; transform: translate(-50%,-50%) scale(0.9) !important; }
  }
  @media (max-width: 480px) {
    #arrivalsGrid { grid-template-columns: repeat(1, 1fr) !important; gap: 12px !important; }
  }
</style>

<script is:inline>
(function(){
  var cat='airing', pg=1, loading=false, hasMore=true, total=0, ids={};
  var animeCount = 0; // track anime added to grid (for product injection)
  var productPool = []; // cached products
  var productIdx = 0;
  var allAnime = [];
  
  var grid=document.getElementById('arrivalsGrid'),
      loadingEl=document.getElementById('loadingMore'),
      endMsg=document.getElementById('endMessage'),
      errMsg=document.getElementById('errorMsg'),
      errSub=document.getElementById('errorSub'),
      countEl=document.getElementById('arrivalsCount'),
      tabs=document.querySelectorAll('.cat-tab'),
      searchIn=document.getElementById('quickSearch'),
      sdd=document.getElementById('searchDD'),
      siClear=document.getElementById('siClear');

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  function levenshtein(a, b) {
    a = a.toLowerCase(); b = b.toLowerCase();
    if (a.length === 0) return b.length;
    if (b.length === 0) return a.length;
    var matrix = [];
    for (var i = 0; i <= b.length; i++) matrix[i] = [i];
    for (var j = 0; j <= a.length; j++) matrix[0][j] = j;
    for (var i = 1; i <= b.length; i++) {
      for (var j = 1; j <= a.length; j++) {
        if (b.charAt(i-1) === a.charAt(j-1)) matrix[i][j] = matrix[i-1][j-1];
        else matrix[i][j] = Math.min(matrix[i-1][j-1]+1, matrix[i][j-1]+1, matrix[i-1][j]+1);
      }
    }
    return matrix[b.length][a.length];
  }

  function fuzzyScore(query, title) {
    query = query.toLowerCase().trim();
    title = title.toLowerCase();
    if (!query) return 0;
    if (title === query) return 1000;
    if (title.startsWith(query)) return 500;
    if (title.includes(query)) return 300;
    var words = title.split(/\s+/);
    for (var i = 0; i < words.length; i++) {
      if (words[i].startsWith(query)) return 200;
    }
    var dist = levenshtein(query, title.substring(0, Math.min(title.length, query.length + 3)));
    if (dist <= 2) return 100 - dist * 10;
    var matches = 0;
    for (var i = 0; i < query.length; i++) {
      if (title.indexOf(query[i]) !== -1) matches++;
    }
    return matches >= query.length * 0.7 ? 50 : 0;
  }

  // ─── Anime card (unchanged design) ───
  function animeCard(a, i) {
    var t = a.title || 'Unknown', img = a.image || '', sl = a.slug || 'anime-' + a.id,
        sc = a.score ? Number(a.score).toFixed(1) : '',
        yr = a.year || '',
        ep = a.episodes && a.episodes > 0 ? a.episodes : '',
        g = (a.genres && a.genres.length) ? a.genres[0] : '',
        nw = a.status === 'current';
    var animDelay = ((i % 12) * 30) + 'ms';
    
    var imgStyle = 'position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.6s ease, filter 0.35s ease;';
    var imgHtml = img
      ? '<img src="' + esc(img) + '" alt="' + esc(t) + '" loading="lazy" class="at-na-img" style="' + imgStyle + '" />'
      : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.25),rgba(232,121,249,0.15),rgba(125,211,252,0.2));display:flex;align-items:center;justify-content:center;"><svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>';
    
    var el = document.createElement('a');
    el.href = '/anime/' + sl;
    el.className = 'at-na-card';
    el.style.cssText = 'position:relative;text-decoration:none;color:inherit;background:transparent;cursor:pointer;animation:atNaCardIn 0.5s ease backwards;animation-delay:' + animDelay + ';display:block;';
    
    el.innerHTML =
      '<div class="at-na-thumb" style="position:relative;width:100%;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#0a0517;border:1px solid rgba(192,132,252,0.35);box-shadow:0 8px 20px rgba(0,0,0,0.4);transition:all 0.35s ease;">' +
        imgHtml +
        '<div class="at-na-shine" style="position:absolute;top:0;left:-80%;width:60%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,0.2),transparent);z-index:3;transition:left 0.8s ease;pointer-events:none;"></div>' +
        '<div class="at-na-overlay" style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(10,5,23,0.85) 100%);opacity:0;transition:opacity 0.3s ease;pointer-events:none;z-index:3;"></div>' +
        '<div class="at-na-play" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.4);width:52px;height:52px;z-index:5;opacity:0;transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none;">' +
          '<div style="position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,0.8);animation:atNaPlayRing 2s ease-out infinite;"></div>' +
          '<div style="position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,0.8);animation:atNaPlayRing 2s ease-out infinite;animation-delay:1s;"></div>' +
          '<div style="position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:3px;box-shadow:0 10px 30px rgba(192,132,252,0.7),0 0 40px rgba(232,121,249,0.5),inset 0 0 15px rgba(255,255,255,0.15);z-index:2;">' +
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
          '</div>' +
        '</div>' +
        (nw ? '<div style="position:absolute;top:8px;left:8px;padding:4px 9px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;font-weight:800;letter-spacing:0.1em;border-radius:6px;z-index:6;box-shadow:0 3px 12px rgba(239,68,68,0.5);">NEW</div>' : '') +
        (sc ? '<div style="position:absolute;top:8px;right:8px;display:inline-flex;align-items:center;gap:4px;padding:4px 8px;background:rgba(10,5,23,0.85);border:1px solid rgba(251,191,36,0.4);color:#fbbf24;font-family:\'JetBrains Mono\',monospace;font-size:0.65rem;font-weight:800;border-radius:5px;z-index:6;backdrop-filter:blur(10px);"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' + sc + '</div>' : '') +
        '<div style="position:absolute;bottom:8px;left:8px;padding:3px 8px;background:rgba(125,211,252,0.9);color:#0a0517;font-family:\'JetBrains Mono\',monospace;font-size:0.55rem;font-weight:800;letter-spacing:0.1em;border-radius:5px;z-index:6;">HD</div>' +
      '</div>' +
      '<div style="padding:10px 4px 4px;position:relative;z-index:1;">' +
        '<h3 class="at-na-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.9rem;font-weight:700;color:var(--text-primary);margin:0 0 4px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;">' + esc(trunc(t, 55)) + '</h3>' +
        '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.66rem;color:var(--text-muted);opacity:0.75;">' + 
          (yr ? esc(yr) : '') +
          (yr && ep ? ' · ' : '') +
          (ep ? esc(ep) + ' EP' : '') +
        '</div>' +
        (g ? '<div style="display:inline-block;margin-top:5px;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:700;color:#c084fc;letter-spacing:0.05em;text-transform:uppercase;">' + esc(g) + '</div>' : '') +
      '</div>';
    
    return el;
  }

  // ─── Inline product card (same 16:9 size as anime card) ───
  function productCard(p, i) {
    var animDelay = ((i % 12) * 30) + 'ms';
    var badge = p.badge || 'SPONSORED';
    
    var el = document.createElement('a');
    // Route to internal product page (built in STEP 2)
    el.href = '/product/' + encodeURIComponent(p.id);
    el.className = 'at-inline-product';
    el.style.cssText = 'display:block;text-decoration:none;color:inherit;animation-delay:' + animDelay + ';';
    
    var imgHtml = p.image
      ? '<img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" loading="lazy" class="at-ip-img" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.6s ease, filter 0.35s ease;" onerror="this.style.opacity=\'0.3\';" />'
      : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.25),rgba(232,121,249,0.15));display:flex;align-items:center;justify-content:center;font-size:3rem;">🛍️</div>';
    
    el.innerHTML =
      '<div class="at-ip-thumb" style="position:relative;width:100%;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#0a0517;border:1px solid rgba(232,121,249,0.4);box-shadow:0 8px 20px rgba(0,0,0,0.4);transition:all 0.35s ease;">' +
        imgHtml +
        '<div class="at-ip-shine" style="position:absolute;top:0;left:-80%;width:60%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,0.2),transparent);z-index:3;transition:left 0.8s ease;pointer-events:none;"></div>' +
        '<div class="at-ip-overlay" style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(10,5,23,0.9) 100%);opacity:0;transition:opacity 0.3s ease;pointer-events:none;z-index:3;"></div>' +
        // "Shop" tag top-left (subtle, native-looking)
        '<div style="position:absolute;top:8px;left:8px;padding:4px 9px;background:linear-gradient(135deg,#c084fc,#e879f9);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;font-weight:800;letter-spacing:0.1em;border-radius:6px;z-index:6;box-shadow:0 3px 12px rgba(192,132,252,0.5);">' + esc(badge) + '</div>' +
        // Price top-right (like anime rating)
        '<div style="position:absolute;top:8px;right:8px;padding:4px 9px;background:rgba(10,5,23,0.85);border:1px solid rgba(125,211,252,0.4);color:#7dd3fc;font-family:\'JetBrains Mono\',monospace;font-size:0.68rem;font-weight:800;border-radius:5px;z-index:6;backdrop-filter:blur(10px);">' + esc(p.price) + '</div>' +
        // "View" CTA in center (shows on hover)
        '<div class="at-ip-cta" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.6);z-index:5;opacity:0;transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none;">' +
          '<div style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);color:#fff;font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.78rem;font-weight:800;border-radius:999px;box-shadow:0 10px 30px rgba(192,132,252,0.6),0 0 40px rgba(232,121,249,0.4);white-space:nowrap;">' +
            '<span>View Details</span>' +
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
          '</div>' +
        '</div>' +
        // Rating bottom-left
        (p.rating ? '<div style="position:absolute;bottom:8px;left:8px;display:inline-flex;align-items:center;gap:3px;padding:3px 8px;background:rgba(10,5,23,0.85);color:#fbbf24;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:800;border-radius:5px;z-index:6;backdrop-filter:blur(10px);"><svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' + p.rating + '</div>' : '') +
      '</div>' +
      '<div style="padding:10px 4px 4px;position:relative;z-index:1;">' +
        '<h3 class="at-ip-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.9rem;font-weight:700;color:var(--text-primary);margin:0 0 4px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;">' + esc(trunc(p.title, 55)) + '</h3>' +
        '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.66rem;color:var(--text-muted);opacity:0.75;">' + esc(trunc(p.subtitle || '', 45)) + '</div>' +
        '<div style="display:inline-block;margin-top:5px;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:700;color:#e879f9;letter-spacing:0.05em;text-transform:uppercase;">FROM OUR STORE</div>' +
      '</div>';
    
    return el;
  }

  // ─── Fetch products in background, cache them ───
  async function loadProducts() {
    try {
      var res = await fetch('/api/products?limit=50');
      var j = await res.json();
      if (j.success && j.products) {
        productPool = j.products;
      }
    } catch(e) {
      console.warn('Product pool load failed:', e.message);
    }
  }
  
  function getNextProduct() {
    if (!productPool.length) return null;
    var p = productPool[productIdx % productPool.length];
    productIdx++;
    return p;
  }

  function updateCount(){
    if(!countEl)return;
    var c=parseInt(countEl.textContent)||0,t=total;
    if(c===t)return;
    var step=Math.max(1,Math.ceil((t-c)/12));
    (function f(){c=Math.min(c+step,t);countEl.textContent=c;if(c<t)requestAnimationFrame(f);})();
  }

  async function load(){
    if(loading||!hasMore)return;
    loading=true;
    if(pg===1){grid.innerHTML='<div style="grid-column:1/-1;display:flex;justify-content:center;padding:2rem;"><div class="ld-spinner"></div></div>';if(errMsg)errMsg.style.display='none';if(endMsg)endMsg.style.display='none';}
    else{if(loadingEl)loadingEl.style.display='flex';}

    try{
      var res=await fetch('/api/anime?action=list&category='+cat+'&page='+pg);
      if(!res.ok)throw new Error('API '+res.status);
      var j=await res.json();
      if(!j.success)throw new Error(j.error||'fail');
      var items=(j.anime||[]).filter(function(a){if(!a.id||ids[a.id])return false;ids[a.id]=true;return true;});
      if(pg===1)grid.innerHTML='';
      
      items.forEach(function(a,i){
        total++;
        allAnime.push(a);
        grid.appendChild(animeCard(a, total-1));
        animeCount++;
        
        // ═══ INJECT PRODUCT every 6 anime cards ═══
        // This gives Facebook-ads-style feel — natural, not disruptive
        if (animeCount % 6 === 0 && productPool.length > 0) {
          var prod = getNextProduct();
          if (prod) {
            grid.appendChild(productCard(prod, total));
          }
        }
      });
      
      updateCount();
      hasMore=j.hasNext!==false&&items.length>0;
      if(loadingEl)loadingEl.style.display='none';
      if(!hasMore && total > 20){if(endMsg)endMsg.style.display='flex';}
    }catch(e){
      console.warn('Load fail:',e.message);
      if(loadingEl)loadingEl.style.display='none';
      if(total===0){grid.innerHTML='';if(errMsg){errMsg.style.display='block';if(errSub)errSub.textContent='Anime database temporarily unavailable.';}}
    }
    loading=false;
  }

  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      var c2=tab.dataset.cat;if(c2===cat)return;
      tabs.forEach(function(t){t.classList.remove('active');});tab.classList.add('active');
      cat=c2;pg=1;hasMore=true;total=0;ids={};allAnime=[];animeCount=0;productIdx=0;
      if(countEl)countEl.textContent='0';
      if(errMsg)errMsg.style.display='none';
      if(endMsg)endMsg.style.display='none';
      load();
    });
  });

  var scrollT;
  window.addEventListener('scroll',function(){
    if(loading||!hasMore)return;
    clearTimeout(scrollT);
    scrollT=setTimeout(function(){
      var scrollPos = window.scrollY + window.innerHeight;
      var pageHeight = document.body.offsetHeight;
      if(scrollPos > pageHeight - 1500){
        pg++;
        load();
      }
    },100);
  },{passive:true});

  // ─── Smart search (unchanged) ───
  var sT;
  function showClear() { if (siClear) siClear.style.display = 'flex'; }
  function hideClear() { if (siClear) siClear.style.display = 'none'; }
  
  if (siClear) {
    siClear.addEventListener('click', function() {
      searchIn.value = '';
      hideClear();
      if (sdd) { sdd.innerHTML = ''; sdd.classList.remove('open'); }
      searchIn.focus();
    });
  }
  
  async function performSearch(q) {
    if (!q || q.length < 1) {
      if (sdd) { sdd.innerHTML = ''; sdd.classList.remove('open'); }
      return;
    }
    if (sdd) {
      sdd.innerHTML = '<div class="sdd-loading"><div class="ld-spinner"></div><span>Searching...</span></div>';
      sdd.classList.add('open');
    }
    var localMatches = allAnime.map(function(a) {
      return { anime: a, score: fuzzyScore(q, a.title) };
    }).filter(function(x) { return x.score > 0; })
      .sort(function(a, b) { return b.score - a.score; })
      .slice(0, 5);
    var apiResults = [];
    try {
      var r = await fetch('/api/anime?action=search&q=' + encodeURIComponent(q));
      var j = await r.json();
      if (j.success && j.anime) apiResults = j.anime;
    } catch(e) {}
    var seen = {};
    var combined = [];
    localMatches.forEach(function(m) {
      if (!seen[m.anime.id]) { seen[m.anime.id] = true; combined.push(m.anime); }
    });
    apiResults.forEach(function(a) {
      if (!seen[a.id]) { seen[a.id] = true; combined.push(a); }
    });
    var scored = combined.map(function(a) {
      return { anime: a, score: fuzzyScore(q, a.title) };
    }).sort(function(a, b) { return b.score - a.score; });
    var top = scored.slice(0, 8);
    if (sdd) {
      if (top.length === 0) {
        sdd.innerHTML = '<div class="sdd-empty"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg><div><div class="sdd-empty-t">No anime found for "' + esc(q) + '"</div><div class="sdd-empty-s">Try a different spelling</div></div></div>';
      } else {
        var isTypo = top[0].score < 200 && top[0].score > 0;
        var html = '';
        if (isTypo) {
          html += '<div class="sdd-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>Did you mean...</div>';
        }
        html += top.map(function(m) {
          var a = m.anime;
          var im = a.image ? '<img src="' + esc(a.image) + '" alt="" loading="lazy" />' : '<div class="sd-no"></div>';
          var badge = a.status === 'current' ? '<span class="sd-badge">AIRING</span>' : '';
          return '<a href="/anime/' + esc(a.slug) + '" class="sd-i"><div class="sd-th">' + im + '</div><div class="sd-inf"><div class="sd-t">' + esc(a.title) + '</div><div class="sd-m">' + esc(a.year || 'Unknown') + (a.score ? ' · ⭐ ' + a.score : '') + (a.episodes ? ' · ' + a.episodes + ' EP' : '') + '</div>' + (a.genres && a.genres.length ? '<div class="sd-g">' + a.genres.slice(0,2).map(esc).join(' · ') + '</div>' : '') + '</div>' + badge + '</a>';
        }).join('');
        html += '<a href="/search?q=' + encodeURIComponent(q) + '" class="sd-i sd-more"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><span>See all results for "' + esc(q) + '"</span></a>';
        sdd.innerHTML = html;
      }
      sdd.classList.add('open');
    }
  }
  
  if (searchIn) {
    searchIn.addEventListener('input', function() {
      clearTimeout(sT);
      var q = searchIn.value.trim();
      if (q) showClear(); else hideClear();
      if (!q) {
        if (sdd) { sdd.innerHTML = ''; sdd.classList.remove('open'); }
        return;
      }
      sT = setTimeout(function() { performSearch(q); }, 200);
    });
    searchIn.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        var q = searchIn.value.trim();
        if (q) {
          var firstResult = sdd && sdd.querySelector('.sd-i:not(.sd-more):not(.sdd-empty):not(.sdd-loading)');
          if (firstResult) window.location.href = firstResult.href;
          else window.location.href = '/search?q=' + encodeURIComponent(q);
        }
      }
      if (e.key === 'Escape' && sdd) { sdd.classList.remove('open'); searchIn.blur(); }
    });
    document.addEventListener('click', function(e) {
      if (sdd && !e.target.closest('.search-inline')) sdd.classList.remove('open');
    });
    searchIn.addEventListener('focus', function() {
      if (searchIn.value.trim() && sdd && sdd.innerHTML) sdd.classList.add('open');
    });
  }

  // ─── Init: load products first (fast), then start anime feed ───
  loadProducts().then(load);
})();
</script>

<style>
  .arrivals-block{position:relative}
  .arrivals-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;gap:1.25rem;flex-wrap:wrap}
  .arrivals-title-wrap{display:flex;align-items:center;gap:1rem}
  .arrivals-bar{width:4px;height:48px;background:linear-gradient(180deg,#c084fc,#e879f9,#7dd3fc);border-radius:3px;box-shadow:0 0 15px rgba(192,132,252,.6);animation:bg 3s ease infinite}
  @keyframes bg{0%,100%{box-shadow:0 0 15px rgba(192,132,252,.6)}50%{box-shadow:0 0 25px rgba(232,121,249,.8)}}
  .arrivals-tag{display:inline-flex;align-items:center;gap:.4rem;font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:700;letter-spacing:.15em;color:#c084fc;margin-bottom:4px}
  .arrivals-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 8px #ef4444;animation:lb 1.5s ease infinite}
  @keyframes lb{0%,100%{opacity:1}50%{opacity:.4}}
  .arrivals-title{font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;margin:0;letter-spacing:-.03em;line-height:1}
  .arrivals-actions{display:flex;align-items:center;gap:12px}
  
  .sdd{position:absolute;top:calc(100% + 10px);left:0;right:0;background:rgba(15,8,35,.98);border:1px solid rgba(192,132,252,.3);border-radius:16px;padding:8px;max-height:500px;overflow-y:auto;box-shadow:0 25px 60px rgba(0,0,0,.6),0 0 30px rgba(192,132,252,.15);backdrop-filter:blur(20px);z-index:100;opacity:0;visibility:hidden;transform:translateY(-8px);transition:all .25s ease}
  .sdd.open{opacity:1;visibility:visible;transform:translateY(0)}
  .sdd-loading{display:flex;align-items:center;justify-content:center;gap:10px;padding:2rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:.75rem}
  .sdd-empty{display:flex;align-items:center;gap:12px;padding:20px;color:var(--text-muted)}
  .sdd-empty svg{color:#c084fc;flex-shrink:0}
  .sdd-empty-t{font-family:'Bricolage Grotesque',sans-serif;font-size:.9rem;font-weight:700;color:var(--text-primary);margin-bottom:2px}
  .sdd-empty-s{font-family:'JetBrains Mono',monospace;font-size:.7rem;opacity:.7}
  .sdd-hint{display:flex;align-items:center;gap:6px;padding:6px 12px;color:#e879f9;font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:700;letter-spacing:.05em;margin-bottom:4px}
  
  .arrivals-count{display:flex;align-items:baseline;gap:6px;padding:8px 16px;background:rgba(192,132,252,.1);border:1px solid rgba(192,132,252,.25);border-radius:999px;backdrop-filter:blur(10px)}
  .arrivals-count-num{font-family:'JetBrains Mono',monospace;font-size:1.2rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;min-width:24px;display:inline-block;text-align:center}
  .arrivals-count-lbl{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted)}
  
  .cat-tabs{display:flex;gap:8px;margin-bottom:1.75rem;overflow-x:auto;scrollbar-width:none}
  .cat-tabs::-webkit-scrollbar{display:none}
  .cat-tab{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;background:rgba(28,15,61,.5);border:1px solid var(--border-color);border-radius:999px;color:var(--text-secondary);font-family:'Bricolage Grotesque',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .25s ease;white-space:nowrap;backdrop-filter:blur(10px)}
  .cat-tab:hover{background:rgba(192,132,252,.15);border-color:rgba(192,132,252,.4);color:var(--text-primary);transform:translateY(-1px)}
  .cat-tab.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 6px 20px rgba(192,132,252,.4)}
  .cat-tab-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 6px #ef4444;animation:lb 1.5s ease infinite}
  .cat-tab.active .cat-tab-dot{background:#fff;box-shadow:0 0 6px #fff}
  
  .loading-more{display:flex;align-items:center;justify-content:center;gap:12px;padding:2rem 0;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:.85rem}
  .ld-spinner{width:22px;height:22px;border:2px solid rgba(192,132,252,.2);border-top-color:#c084fc;border-radius:50%;animation:sp .8s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  
  .end-message{display:none;align-items:center;justify-content:center;gap:10px;padding:2rem;margin-top:2rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:.82rem;background:rgba(192,132,252,.04);border:1px dashed rgba(192,132,252,.2);border-radius:14px}
  .end-message svg{color:#10b981}
  
  .error-msg{text-align:center;padding:3rem 1rem;color:var(--text-secondary);background:rgba(239,68,68,.06);border:1px dashed rgba(239,68,68,.3);border-radius:16px;margin-top:2rem}
  .err-icon{color:#ef4444;margin-bottom:1rem;display:flex;justify-content:center}
  .error-msg h3{font-size:1.2rem;margin:0 0 .5rem;color:var(--text-primary);font-family:'Bricolage Grotesque',sans-serif}
  .error-msg p{font-size:.88rem;margin:0 0 1.5rem}
  .err-retry{padding:10px 24px;background:var(--grad);color:#fff;border:none;border-radius:999px;font-family:inherit;font-size:.85rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(192,132,252,.4)}
  
  .novelty-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
  .novelty-card{display:block;background:var(--bg-card);border-radius:20px;overflow:hidden;transition:transform .4s ease,box-shadow .4s ease;text-decoration:none;color:inherit}
  .novelty-card:hover{transform:translateY(-8px);box-shadow:0 20px 40px rgba(192,132,252,.15)}
  .nc-img{position:relative;aspect-ratio:3/4;overflow:hidden}
  .nc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
  .novelty-card:hover .nc-img img{transform:scale(1.08)}
  .nc-ov{position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(0,0,0,.5) 70%,rgba(0,0,0,.85) 100%)}
  .nc-ct{padding:1rem 1.1rem 1.2rem}
  .nc-t{font-family:'Bricolage Grotesque',sans-serif;font-size:1rem;font-weight:700;color:var(--text-primary);margin:0 0 .4rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .nc-e{font-size:.78rem;color:var(--text-muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  
  .news-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
  .news-card{display:flex;gap:1rem;background:var(--bg-card);border-radius:16px;overflow:hidden;padding:1rem;transition:transform .3s ease;text-decoration:none;color:inherit}
  .news-card:hover{transform:translateY(-3px);background:var(--bg-card-hover)}
  .nw-img{width:120px;min-width:120px;aspect-ratio:1;border-radius:12px;overflow:hidden}
  .nw-img img{width:100%;height:100%;object-fit:cover}
  .nw-ct{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}
  .nw-cat{font-family:'Bricolage Grotesque',sans-serif;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.4rem}
  .nw-t{font-family:'Bricolage Grotesque',sans-serif;font-size:.95rem;font-weight:700;color:var(--text-primary);margin:0 0 .4rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .nw-e{font-size:.78rem;color:var(--text-muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  
  @media(max-width:1024px){.novelty-grid{grid-template-columns:repeat(2,1fr)}.news-grid{grid-template-columns:1fr}}
  @media(max-width:640px){.arrivals-header{flex-direction:column;align-items:flex-start}.arrivals-actions{width:100%}.novelty-grid{grid-template-columns:repeat(2,1fr);gap:.75rem}.news-card{padding:.75rem}.nw-img{width:90px;min-width:90px}}
</style>
