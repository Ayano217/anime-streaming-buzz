---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const novelty = sortedPosts.slice(0, 4);
const news    = sortedPosts.slice(4, 8);
const latest  = sortedPosts.slice(8, 16);
---

<BaseLayout>
  <Header slot="header" />

  <HeroSection />

  <section class="section-block arrivals-block">
    <div class="container">
      
      <div class="arrivals-header">
        <div class="arrivals-title-wrap">
          <div class="arrivals-bar"></div>
          <div>
            <div class="arrivals-tag">
              <span class="arrivals-dot"></span>
              <span>FRESH · UPDATED DAILY</span>
            </div>
            <h2 class="arrivals-title">
              <span class="grad-text">New Arrivals</span>
            </h2>
          </div>
        </div>
        
        <div class="arrivals-count">
          <span class="arrivals-count-num" id="arrivalsCount">0</span>
          <span class="arrivals-count-lbl">titles</span>
        </div>
      </div>
      
      <div class="cat-tabs" id="catTabs">
        <button class="cat-tab active" data-source="airing">
          <span class="cat-tab-dot"></span>
          <span>Now Airing</span>
        </button>
        <button class="cat-tab" data-source="top">Top Rated</button>
        <button class="cat-tab" data-source="upcoming">Upcoming</button>
        <button class="cat-tab" data-source="popular">Popular</button>
        <button class="cat-tab" data-source="movie">Movies</button>
      </div>
      
      <div class="arrivals-grid" id="arrivalsGrid">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
      </div>
      
      <div class="load-more-wrap" id="loadMoreWrap" style="display:none;">
        <button class="load-more-btn" id="loadMoreBtn">
          <span>Load More Anime</span>
          <div class="load-more-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </div>
        </button>
      </div>
      
      <div class="loading-more" id="loadingMore" style="display:none;">
        <div class="loading-spinner"></div>
        <span>Loading more anime...</span>
      </div>
      
      <div class="end-message" id="endMessage" style="display:none;">
        <span>You've explored everything. Check back tomorrow!</span>
      </div>
      
      <div class="error-message" id="errorMessage" style="display:none;">
        <div class="error-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4M12 16h.01"/>
          </svg>
        </div>
        <h3>Loading anime feed...</h3>
        <p id="errorSubtext">Trying multiple sources. This may take a moment.</p>
        <button onclick="location.reload()" class="error-retry">Refresh Page</button>
      </div>
      
    </div>
  </section>

  {novelty.length > 0 && (
    <section class="section-block novelty-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Novelty</span></h2>
        <div class="novelty-grid">
          {novelty.map((post) => (
            <a href={`/posts/${post.slug}`} class="novelty-card">
              <div class="nc-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="nc-overlay"></div>
              </div>
              <div class="nc-content">
                <h3 class="nc-title">{post.data.title}</h3>
                <p class="nc-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section-block news-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">News</span></h2>
        <div class="news-grid">
          {news.map((post) => (
            <a href={`/posts/${post.slug}`} class="news-card">
              <div class="nw-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
              </div>
              <div class="nw-content">
                <div class="nw-category">{post.data.category}</div>
                <h3 class="nw-title">{post.data.title}</h3>
                <p class="nw-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="section-block latest-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Latest Season</span></h2>
        <div class="latest-grid">
          {latest.map((post) => (
            <a href={`/posts/${post.slug}`} class="latest-card">
              <div class="lt-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="lt-overlay">
                  <div class="lt-play-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="lt-content">
                <h3 class="lt-title">{post.data.title}</h3>
                <div class="lt-meta">
                  <span>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>
<script is:inline>
(function() {
  var currentSource = 'airing';
  var page = 1;
  var loading = false;
  var hasMore = true;
  var totalLoaded = 0;
  var allIds = {};
  
  var grid       = document.getElementById('arrivalsGrid');
  var loadBtn    = document.getElementById('loadMoreBtn');
  var loadWrap   = document.getElementById('loadMoreWrap');
  var loadingEl  = document.getElementById('loadingMore');
  var endMsg     = document.getElementById('endMessage');
  var errorMsg   = document.getElementById('errorMessage');
  var errorSub   = document.getElementById('errorSubtext');
  var countEl    = document.getElementById('arrivalsCount');
  var catTabs    = document.querySelectorAll('.cat-tab');
  
  function makeSlug(str) {
    return (str || '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 80);
  }
  
  function esc(str) {
    return String(str || '').replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  
  function createCard(anime, index) {
    var title    = anime.title || 'Unknown';
    var image    = anime.image || '';
    var slug     = makeSlug(title) || ('anime-' + anime.id);
    var score    = anime.score;
    var year     = anime.year || '';
    var episodes = anime.episodes || '?';
    var genre    = anime.genre || '';
    var isNew    = anime.status === 'Currently Airing';
    
    var card = document.createElement('a');
    card.href = '/anime/' + slug;
    card.className = 'arrivals-card-item';
    card.style.animationDelay = (index % 12 * 50) + 'ms';
    
    var imgHtml = image 
      ? '<img src="' + esc(image) + '" alt="' + esc(title) + '" loading="lazy" class="anime-img" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'" />' +
        '<div class="anime-img-fallback" style="display:none"><svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>'
      : '<div class="anime-img-fallback"><svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>';
    
    var newBadge = isNew 
      ? '<div class="anime-badge anime-badge-new"><span class="anime-new-dot"></span>NEW</div>'
      : '';
    
    var scoreBadge = score 
      ? '<div class="anime-badge anime-badge-score"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' + score + '</div>'
      : '';
    
    var metaHtml = '';
    if (year)     metaHtml += '<span>' + esc(year) + '</span>';
    if (episodes) metaHtml += '<span>' + esc(episodes) + ' EP</span>';
    if (genre)    metaHtml += '<span class="anime-genre">' + esc(genre) + '</span>';
    
    card.innerHTML = 
      '<div class="anime-thumb">' +
        '<div class="thumb-border-glow"></div>' +
        imgHtml +
        '<div class="anime-overlay"></div>' +
        '<div class="anime-shine"></div>' +
        '<div class="anime-corner anime-corner-tl"></div>' +
        '<div class="anime-corner anime-corner-tr"></div>' +
        '<div class="anime-corner anime-corner-bl"></div>' +
        '<div class="anime-corner anime-corner-br"></div>' +
        '<div class="anime-play">' +
          '<div class="anime-play-ring anime-play-ring-1"></div>' +
          '<div class="anime-play-ring anime-play-ring-2"></div>' +
          '<div class="anime-play-btn">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
          '</div>' +
        '</div>' +
        '<div class="anime-badges-top">' + newBadge + scoreBadge + '</div>' +
        '<div class="anime-hd">HD</div>' +
        '<div class="anime-info">' +
          '<h3 class="anime-title">' + esc(title) + '</h3>' +
          '<div class="anime-meta">' + metaHtml + '</div>' +
        '</div>' +
      '</div>';
    
    return card;
  }
  
  function updateCount() {
    if (!countEl) return;
    var current = parseInt(countEl.textContent) || 0;
    var target = totalLoaded;
    var step = Math.max(1, Math.floor((target - current) / 8));
    var counter = function() {
      current = Math.min(current + step, target);
      countEl.textContent = current;
      if (current < target) requestAnimationFrame(counter);
    };
    requestAnimationFrame(counter);
  }
  
  async function loadAnime(pageNum, source) {
    if (loading) return;
    loading = true;
    
    if (errorMsg) errorMsg.style.display = 'none';
    
    if (pageNum > 1) {
      if (loadingEl) loadingEl.style.display = 'flex';
      if (loadWrap) loadWrap.style.display = 'none';
    }
    
    try {
      // Use own API endpoint (works because hybrid mode is set up)
      var res = await fetch('/api/anime?source=' + source + '&page=' + pageNum);
      
      if (!res.ok) throw new Error('API returned ' + res.status);
      
      var json = await res.json();
      
      if (!json.success) throw new Error(json.error || 'API returned failure');
      
      var items = json.data || [];
      
      var newItems = items.filter(function(a) {
        if (!a.id || allIds[a.id]) return false;
        allIds[a.id] = true;
        return true;
      });
      
      if (pageNum === 1) {
        grid.innerHTML = '';
      }
      
      if (newItems.length === 0 && pageNum === 1) {
        throw new Error('No anime data');
      }
      
      newItems.forEach(function(anime, idx) {
        var card = createCard(anime, totalLoaded + idx);
        grid.appendChild(card);
        totalLoaded++;
      });
      
      updateCount();
      
      var pag = json.pagination || {};
      if (pag.has_next_page === false) {
        hasMore = false;
      }
      
      if (loadingEl) loadingEl.style.display = 'none';
      
      if (hasMore) {
        if (loadWrap) loadWrap.style.display = 'flex';
      } else {
        if (loadWrap) loadWrap.style.display = 'none';
        if (endMsg) endMsg.style.display = 'block';
      }
      
      loading = false;
      
    } catch (err) {
      console.warn('Load failed:', err.message);
      loading = false;
      if (loadingEl) loadingEl.style.display = 'none';
      
      if (pageNum === 1 && totalLoaded === 0) {
        grid.innerHTML = '';
        if (errorMsg) {
          errorMsg.style.display = 'block';
          if (errorSub) {
            errorSub.textContent = 'Anime database is temporarily unavailable. Please try again in a moment.';
          }
        }
      } else {
        if (loadWrap) loadWrap.style.display = 'flex';
      }
    }
  }
  
  catTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var source = tab.dataset.source;
      if (source === currentSource) return;
      
      catTabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      
      currentSource = source;
      page = 1;
      hasMore = true;
      totalLoaded = 0;
      allIds = {};
      if (countEl) countEl.textContent = '0';
      if (endMsg) endMsg.style.display = 'none';
      if (errorMsg) errorMsg.style.display = 'none';
      
      grid.innerHTML = 
        '<div class="skeleton-card"></div>' +
        '<div class="skeleton-card"></div>' +
        '<div class="skeleton-card"></div>' +
        '<div class="skeleton-card"></div>' +
        '<div class="skeleton-card"></div>' +
        '<div class="skeleton-card"></div>';
      
      loadAnime(1, source);
    });
  });
  
  if (loadBtn) {
    loadBtn.addEventListener('click', function() {
      page++;
      loadAnime(page, currentSource);
    });
  }
  
  var scrollTimeout;
  window.addEventListener('scroll', function() {
    if (loading || !hasMore) return;
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(function() {
      var scrollPos = window.scrollY + window.innerHeight;
      var pageHeight = document.body.offsetHeight;
      if (scrollPos > pageHeight - 800) {
        page++;
        loadAnime(page, currentSource);
      }
    }, 200);
  }, { passive: true });
  
  loadAnime(1, currentSource);
})();
</script>

<style>
  /* All previous styles preserved - keeping same as before */
  .arrivals-block { position: relative; }
  
  .arrivals-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .arrivals-title-wrap { display: flex; align-items: center; gap: 1rem; }
  
  .arrivals-bar {
    width: 4px; height: 46px;
    background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
    border-radius: 3px;
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.6);
    animation: bar-glow 3s ease infinite;
  }
  
  @keyframes bar-glow {
    0%, 100% { box-shadow: 0 0 15px rgba(192, 132, 252, 0.6); }
    50%       { box-shadow: 0 0 25px rgba(232, 121, 249, 0.8); }
  }
  
  .arrivals-tag {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.15em; color: var(--purple);
    margin-bottom: 4px;
  }
  
  .arrivals-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #ef4444; box-shadow: 0 0 8px #ef4444;
    animation: arrivals-live 1.5s ease infinite;
  }
  
  @keyframes arrivals-live {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  
  .arrivals-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800; margin: 0;
    letter-spacing: -0.03em; line-height: 1;
  }
  
  .arrivals-count {
    display: flex; align-items: baseline; gap: 6px;
    padding: 8px 16px;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  
  .arrivals-count-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem; font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    min-width: 24px; display: inline-block; text-align: center;
  }
  
  .arrivals-count-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted);
  }
  
  .cat-tabs {
    display: flex; gap: 8px;
    margin-bottom: 1.5rem; padding-bottom: 4px;
    overflow-x: auto; scrollbar-width: none;
  }
  
  .cat-tabs::-webkit-scrollbar { display: none; }
  
  .cat-tab {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 18px;
    background: rgba(28, 15, 61, 0.5);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: inherit; font-size: 0.82rem;
    font-weight: 600; cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    backdrop-filter: blur(10px);
  }
  
  .cat-tab:hover {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.4);
    color: var(--text-primary);
    transform: translateY(-1px);
  }
  
  .cat-tab.active {
    background: var(--grad);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 6px 20px rgba(192, 132, 252, 0.4);
  }
  
  .cat-tab-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #ef4444; box-shadow: 0 0 6px #ef4444;
    animation: arrivals-live 1.5s ease infinite;
  }
  
  .cat-tab.active .cat-tab-dot {
    background: #fff; box-shadow: 0 0 6px #fff;
  }
  
  .arrivals-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }
  
  .arrivals-card-item {
    display: block;
    text-decoration: none; color: inherit;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: card-slide-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }
  
  @keyframes card-slide-in {
    from { opacity: 0; transform: translateY(30px) scale(0.9); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .arrivals-card-item:hover { transform: translateY(-8px) scale(1.02); }
  
  .arrivals-card-item .anime-thumb {
    position: relative; aspect-ratio: 3/4;
    border-radius: 16px; overflow: hidden;
    background: rgba(28, 15, 61, 0.5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(192, 132, 252, 0.15);
    transition: box-shadow 0.4s ease;
  }
  
  .arrivals-card-item:hover .anime-thumb {
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 0 2px rgba(192, 132, 252, 0.8), 0 0 40px rgba(192, 132, 252, 0.35);
  }
  
  .thumb-border-glow {
    position: absolute; inset: -2px;
    border-radius: 18px;
    background: conic-gradient(from 0deg, #c084fc, #e879f9, #7dd3fc, #c084fc);
    opacity: 0; z-index: -1;
    animation: thumb-spin 4s linear infinite;
    filter: blur(4px);
    transition: opacity 0.3s ease;
  }
  
  .arrivals-card-item:hover .thumb-border-glow { opacity: 0.8; }
  
  @keyframes thumb-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  
  .anime-shine {
    position: absolute; top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
    z-index: 3;
    transition: left 0.8s ease;
    pointer-events: none;
  }
  
  .arrivals-card-item:hover .anime-shine { left: 120%; }
  
  .arrivals-card-item .anime-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s ease, filter 0.4s ease;
    display: block;
  }
  
  .arrivals-card-item:hover .anime-img {
    transform: scale(1.1);
    filter: brightness(0.7) saturate(1.2);
  }
  
  .arrivals-card-item .anime-img-fallback {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(125, 211, 252, 0.1));
    color: rgba(192, 132, 252, 0.5);
  }
  
  .arrivals-card-item .anime-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(10, 5, 23, 0.5) 75%, rgba(10, 5, 23, 0.95) 100%);
    z-index: 1;
  }
  
  .arrivals-card-item .anime-corner {
    position: absolute;
    width: 16px; height: 16px;
    border: 2px solid #7dd3fc;
    z-index: 3; pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    filter: drop-shadow(0 0 6px #7dd3fc);
  }
  
  .arrivals-card-item:hover .anime-corner { opacity: 0.9; }
  
  .arrivals-card-item .anime-corner-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; transform: translate(-4px, -4px); }
  .arrivals-card-item .anime-corner-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; transform: translate(4px, -4px); }
  .arrivals-card-item .anime-corner-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; transform: translate(-4px, 4px); }
  .arrivals-card-item .anime-corner-br { bottom: 10px; right: 10px; border-left: none; border-top: none; transform: translate(4px, 4px); }
  
  .arrivals-card-item:hover .anime-corner-tl,
  .arrivals-card-item:hover .anime-corner-tr,
  .arrivals-card-item:hover .anime-corner-bl,
  .arrivals-card-item:hover .anime-corner-br { transform: translate(0, 0); }
  
  .arrivals-card-item .anime-play {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.5);
