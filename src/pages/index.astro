<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f0820">
<title>AniTubeBuzz — Anime, Drama, Movies & More</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:#0a0515;
  color:#fff;
  overflow-x:hidden;
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:'';
  position:fixed;inset:0;
  background:
    radial-gradient(ellipse at top,rgba(139,92,246,.18),transparent 60%),
    radial-gradient(ellipse at bottom right,rgba(236,72,153,.1),transparent 60%),
    #0a0515;
  z-index:-1;pointer-events:none;
}
img{max-width:100%;display:block;user-select:none;-webkit-user-drag:none}

/* ========== NAVBAR ========== */
.navbar{
  position:sticky;top:0;z-index:100;
  background:rgba(15,8,32,.75);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(255,255,255,.05);
  padding:16px 5%;
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;
}
.logo{
  font-size:24px;font-weight:800;
  background:linear-gradient(135deg,#c084fc,#ec4899);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  letter-spacing:-.5px;cursor:pointer;flex-shrink:0;
}
.nav-links{
  display:flex;gap:8px;
  background:rgba(255,255,255,.04);
  padding:6px;border-radius:14px;
}
.nav-links a{
  color:#a1a1b3;text-decoration:none;
  padding:8px 20px;border-radius:10px;
  font-size:14px;font-weight:500;
  transition:all .2s;white-space:nowrap;
}
.nav-links a:hover{color:#fff}
.nav-links a.active{
  color:#fff;
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
}
.search-box{
  flex:1;max-width:420px;position:relative;
}
.search-box input{
  width:100%;padding:11px 16px 11px 42px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
  border-radius:12px;
  color:#fff;font-size:13px;outline:none;
  transition:all .2s;
}
.search-box input:focus{
  border-color:rgba(139,92,246,.5);
  background:rgba(255,255,255,.08);
}
.search-box i{
  position:absolute;left:16px;top:50%;transform:translateY(-50%);
  color:#a78bfa;font-size:13px;
}
.nav-actions{display:flex;gap:8px}
.icon-btn{
  width:40px;height:40px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
  border-radius:10px;color:#fff;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;font-size:14px;
}
.icon-btn:hover{background:rgba(139,92,246,.15);border-color:rgba(139,92,246,.3)}
.menu-toggle{display:none}

/* ========== SECTION ========== */
.section{padding:30px 5% 20px}
.section-head{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:20px;gap:16px;
}
.section-title-wrap{display:flex;align-items:center;gap:12px}
.live-dot{
  width:8px;height:8px;border-radius:50%;
  background:#10b981;
  box-shadow:0 0 12px #10b981;
  animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.section-title{
  font-size:14px;color:#a78bfa;font-weight:600;
  text-transform:uppercase;letter-spacing:1.5px;
}
.section-heading{
  font-size:36px;font-weight:800;
  background:linear-gradient(135deg,#c084fc,#ec4899);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  margin-top:4px;
}
.item-count{
  padding:8px 18px;
  background:rgba(139,92,246,.15);
  border:1px solid rgba(139,92,246,.3);
  border-radius:30px;
  font-size:13px;font-weight:600;
  color:#c084fc;
}

/* ========== TABS ========== */
.tabs{
  display:flex;gap:10px;overflow-x:auto;
  padding-bottom:8px;margin-bottom:28px;
  scrollbar-width:none;-webkit-overflow-scrolling:touch;
}
.tabs::-webkit-scrollbar{display:none}
.tab{
  padding:10px 22px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.06);
  border-radius:30px;
  color:#a1a1b3;font-size:14px;font-weight:600;
  cursor:pointer;white-space:nowrap;
  transition:all .2s;flex-shrink:0;
  display:flex;align-items:center;gap:8px;
}
.tab:hover{color:#fff;border-color:rgba(139,92,246,.3)}
.tab.active{
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
  color:#fff;border-color:transparent;
  box-shadow:0 4px 20px rgba(139,92,246,.4);
}
.tab .dot{
  width:6px;height:6px;border-radius:50%;
  background:#10b981;box-shadow:0 0 8px #10b981;
}

/* ========== GRID ========== */
.grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:20px;
}
.card{
  background:transparent;
  border-radius:14px;
  overflow:hidden;
  cursor:pointer;
  transition:transform .25s;
  contain:layout style;
}
.card:hover{transform:translateY(-6px)}
.card-img{
  position:relative;
  aspect-ratio:2/3;
  overflow:hidden;
  border-radius:14px;
  background:#1a1030;
  box-shadow:0 4px 20px rgba(0,0,0,.4);
}
.card-img img{
  width:100%;height:100%;
  object-fit:cover;
  transition:transform .4s;
}
.card:hover .card-img img{transform:scale(1.08)}

/* Badges */
.badge-new{
  position:absolute;top:10px;left:10px;
  background:linear-gradient(135deg,#f97316,#ef4444);
  padding:4px 10px;border-radius:6px;
  font-size:10px;font-weight:800;
  letter-spacing:.5px;
  box-shadow:0 2px 10px rgba(239,68,68,.4);
  z-index:2;
}
.badge-rating{
  position:absolute;top:10px;right:10px;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(10px);
  padding:4px 8px;border-radius:6px;
  font-size:11px;font-weight:700;
  display:flex;align-items:center;gap:4px;
  z-index:2;
}
.badge-rating i{color:#fbbf24;font-size:10px}
.badge-hd{
  position:absolute;bottom:10px;left:10px;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(10px);
  padding:3px 8px;border-radius:5px;
  font-size:10px;font-weight:800;
  letter-spacing:.5px;color:#fff;
  z-index:2;
}
.play-overlay{
  position:absolute;inset:0;
  background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.7));
  display:flex;align-items:flex-end;justify-content:flex-start;
  padding:14px;
  opacity:0;transition:opacity .3s;
}
.card:hover .play-overlay{opacity:1}
.play-btn{
  width:36px;height:36px;
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:12px;
  box-shadow:0 4px 15px rgba(139,92,246,.5);
}

/* Card info below thumbnail */
.card-info{padding:12px 4px 0}
.card-title{
  font-size:15px;font-weight:700;
  color:#fff;
  margin-bottom:6px;
  overflow:hidden;text-overflow:ellipsis;
  display:-webkit-box;-webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  line-height:1.35;min-height:40px;
}
.card-meta{
  font-size:12px;color:#8b8b9e;
  margin-bottom:4px;
}
.card-cat{
  font-size:11px;
  color:#a78bfa;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.5px;
}

/* ========== FOOTER ========== */
.footer{
  margin-top:60px;padding:30px 5%;
  border-top:1px solid rgba(255,255,255,.05);
  text-align:center;color:#5c5c6e;font-size:12px;
}

/* ========== MOBILE ========== */
@media(max-width:1200px){
  .grid{grid-template-columns:repeat(4,1fr);gap:18px}
}
@media(max-width:900px){
  .grid{grid-template-columns:repeat(3,1fr);gap:16px}
  .nav-links{display:none}
  .search-box{max-width:none}
  .section-heading{font-size:30px}
}
@media(max-width:640px){
  .navbar{padding:14px 4%;gap:12px}
  .search-box{display:none}
  .menu-toggle{display:flex}
  .logo{font-size:20px}
  .section{padding:24px 4% 16px}
  .grid{grid-template-columns:repeat(2,1fr);gap:14px}
  .section-heading{font-size:24px}
  .section-title{font-size:12px}
  .item-count{font-size:12px;padding:6px 14px}
  .card-title{font-size:13px;min-height:35px}
  .badge-new{font-size:9px;padding:3px 8px}
  .badge-rating{font-size:10px}
  .tab{padding:8px 16px;font-size:13px}
}
@media(max-width:400px){
  .grid{gap:12px}
  .card-title{font-size:12px;min-height:32px}
}

/* Mobile menu */
.mobile-menu{
  position:fixed;top:0;right:-100%;
  width:280px;height:100vh;
  background:rgba(15,8,32,.98);
  backdrop-filter:blur(20px);
  padding:80px 24px 24px;
  transition:right .3s;
  z-index:99;
  border-left:1px solid rgba(255,255,255,.06);
  overflow-y:auto;
}
.mobile-menu.open{right:0}
.mobile-menu a{
  display:flex;align-items:center;gap:12px;
  color:#fff;text-decoration:none;
  padding:14px 16px;border-radius:10px;
  margin-bottom:6px;font-weight:500;font-size:14px;
  transition:background .2s;
}
.mobile-menu a:hover,.mobile-menu a.active{
  background:rgba(139,92,246,.15);color:#a78bfa;
}
.mobile-search{margin-bottom:20px;position:relative}
.mobile-search input{
  width:100%;padding:12px 14px 12px 40px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
  border-radius:10px;color:#fff;outline:none;font-size:14px;
}
.mobile-search i{
  position:absolute;left:14px;top:50%;transform:translateY(-50%);
  color:#a78bfa;
}
.overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,.6);
  opacity:0;pointer-events:none;
  transition:opacity .3s;z-index:98;
}
.overlay.show{opacity:1;pointer-events:auto}

/* Skeleton loader */
.skeleton-card .card-img{
  background:linear-gradient(90deg,#1a1030 25%,#2a1145 50%,#1a1030 75%);
  background-size:200% 100%;
  animation:shimmer 1.5s infinite;
}
@keyframes shimmer{
  0%{background-position:200% 0}
  100%{background-position:-200% 0}
}
</style>
</head>
