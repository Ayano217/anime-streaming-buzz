---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const novelty = sortedPosts.slice(0, 4);
const news    = sortedPosts.slice(4, 8);
---

<BaseLayout>
  <Header slot="header" />
  <HeroSection />

  <section class="section-block arrivals-block">
    <div class="container">
      <div class="arrivals-header">
        <div class="arrivals-title-wrap">
          <div class="arrivals-bar"></div>
          <div>
            <div class="arrivals-tag">
              <span class="arrivals-dot"></span>
              <span>FRESH · UPDATED DAILY</span>
            </div>
            <h2 class="arrivals-title"><span class="grad-text">New Arrivals</span></h2>
          </div>
        </div>
        <div class="arrivals-actions">
          <div class="search-inline">
            <svg class="si-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" id="quickSearch" placeholder="Search anime..." class="si-input" autocomplete="off" />
            <div id="searchDD" class="sdd"></div>
          </div>
          <div class="arrivals-count">
            <span class="arrivals-count-num" id="arrivalsCount">0</span>
            <span class="arrivals-count-lbl">titles</span>
          </div>
        </div>
      </div>

      <div class="cat-tabs" id="catTabs">
        <button class="cat-tab active" data-cat="airing"><span class="cat-tab-dot"></span><span>Now Airing</span></button>
        <button class="cat-tab" data-cat="top">Top Rated</button>
        <button class="cat-tab" data-cat="upcoming">Upcoming</button>
        <button class="cat-tab" data-cat="popular">Popular</button>
        <button class="cat-tab" data-cat="movies">Movies</button>
      </div>

      <div class="arrivals-grid" id="grid"></div>

      <div class="load-more-wrap" id="loadWrap" style="display:none;">
        <button class="load-more-btn" id="loadBtn">
          <span class="lm-inner"><span>Load More Anime</span>
            <div class="lm-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg></div>
          </span>
        </button>
      </div>

      <div class="loading-more" id="loadingMore" style="display:none;">
        <div class="ld-spinner"></div><span>Loading more anime...</span>
      </div>

      <div class="error-msg" id="errorMsg" style="display:none;">
        <div class="err-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg></div>
        <h3>Loading anime feed...</h3>
        <p id="errorSub">Trying multiple sources.</p>
        <button onclick="location.reload()" class="err-retry">Refresh Page</button>
      </div>
    </div>
  </section>

  {novelty.length > 0 && (
    <section class="section-block novelty-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">Latest Articles</span></h2>
        <div class="novelty-grid">
          {novelty.map((post) => (
            <a href={`/posts/${post.slug}`} class="novelty-card">
              <div class="nc-img">{post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}<div class="nc-ov"></div></div>
              <div class="nc-ct"><h3 class="nc-t">{post.data.title}</h3><p class="nc-e">{post.data.excerpt}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section-block news-block">
      <div class="container">
        <h2 class="section-title"><span class="grad-text">News</span></h2>
        <div class="news-grid">
          {news.map((post) => (
            <a href={`/posts/${post.slug}`} class="news-card">
              <div class="nw-img">{post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}</div>
              <div class="nw-ct"><div class="nw-cat">{post.data.category}</div><h3 class="nw-t">{post.data.title}</h3><p class="nw-e">{post.data.excerpt}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
(function(){
  var cat='airing', pg=1, loading=false, hasMore=true, total=0, ids={};
  var grid=document.getElementById('grid'),
      loadW=document.getElementById('loadWrap'),
      loadBtn=document.getElementById('loadBtn'),
      loadingEl=document.getElementById('loadingMore'),
      errMsg=document.getElementById('errorMsg'),
      errSub=document.getElementById('errorSub'),
      countEl=document.getElementById('arrivalsCount'),
      tabs=document.querySelectorAll('.cat-tab'),
      searchIn=document.getElementById('quickSearch'),
      sdd=document.getElementById('searchDD');

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  function card(a,i){
    var t=a.title||'Unknown',img=a.image||'',sl=a.slug||'anime-'+a.id,
        sc=a.score?Number(a.score).toFixed(1):'',yr=a.year||'',
        ep=a.episodes&&a.episodes>0?a.episodes:'',
        g=(a.genres&&a.genres.length)?a.genres[0]:'',
        nw=a.status==='current';
    var el=document.createElement('a');
    el.href='/anime/'+sl;el.className='a-card';
    el.style.animationDelay=((i%20)*40)+'ms';
    var imgH=img?'<img src="'+esc(img)+'" alt="'+esc(t)+'" loading="lazy" class="a-img" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"/>'+
      '<div class="a-fb" style="display:none"><svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>':
      '<div class="a-fb"><svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg></div>';
    var meta=[];if(yr)meta.push(esc(yr));if(ep)meta.push(esc(ep)+' EP');
    el.innerHTML='<div class="a-poster"><div class="a-glow"></div>'+imgH+
      '<div class="a-shade"></div><div class="a-shine"></div>'+
      (nw?'<div class="a-new">NEW</div>':'')+
      (sc?'<div class="a-score"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span>'+sc+'</span></div>':'')+
      '<div class="a-play"><div class="a-ring"></div><div class="a-ring a-ring-2"></div><div class="a-playbtn"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div></div>'+
      '</div><div class="a-info"><h3 class="a-title">'+esc(trunc(t,45))+'</h3>'+
      (meta.length?'<div class="a-meta">'+meta.join(' <span class="a-dot">·</span> ')+'</div>':'')+
      (g?'<div class="a-genre">'+esc(g)+'</div>':'')+'</div>';
    return el;
  }

  function updateCount(){
    if(!countEl)return;
    var c=parseInt(countEl.textContent)||0,t=total;
    if(c===t)return;
    var step=Math.max(1,Math.ceil((t-c)/12));
    (function f(){c=Math.min(c+step,t);countEl.textContent=c;if(c<t)requestAnimationFrame(f);})();
  }

  async function load(){
    if(loading||!hasMore)return;
    loading=true;
    if(pg===1){grid.innerHTML='<div class="sk"></div>'.repeat(6);if(errMsg)errMsg.style.display='none';}
    else{if(loadingEl)loadingEl.style.display='flex';if(loadW)loadW.style.display='none';}

    try{
      var res=await fetch('/api/anime?action=list&category='+cat+'&page='+pg);
      if(!res.ok)throw new Error('API '+res.status);
      var j=await res.json();
      if(!j.success)throw new Error(j.error||'fail');
      var items=(j.anime||[]).filter(function(a){if(!a.id||ids[a.id])return false;ids[a.id]=true;return true;});
      if(pg===1)grid.innerHTML='';
      items.forEach(function(a,i){total++;grid.appendChild(card(a,total-1));});
      updateCount();
      hasMore=j.hasNext!==false&&items.length>0;
      if(loadingEl)loadingEl.style.display='none';
      if(hasMore){if(loadW)loadW.style.display='flex';}
      else{if(loadW)loadW.style.display='none';}
    }catch(e){
      console.warn('Load fail:',e.message);
      if(loadingEl)loadingEl.style.display='none';
      if(total===0){grid.innerHTML='';if(errMsg){errMsg.style.display='block';if(errSub)errSub.textContent='Anime database temporarily unavailable.';}}
      else{if(loadW)loadW.style.display='flex';}
    }
    loading=false;
  }

  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      var c2=tab.dataset.cat;if(c2===cat)return;
      tabs.forEach(function(t){t.classList.remove('active');});tab.classList.add('active');
      cat=c2;pg=1;hasMore=true;total=0;ids={};
      if(countEl)countEl.textContent='0';
      if(errMsg)errMsg.style.display='none';
      if(loadW)loadW.style.display='none';
      load();
    });
  });

  if(loadBtn)loadBtn.addEventListener('click',function(){pg++;load();});

  var scrollT;
  window.addEventListener('scroll',function(){
    if(loading||!hasMore)return;
    clearTimeout(scrollT);
    scrollT=setTimeout(function(){
      if(window.scrollY+window.innerHeight>document.body.offsetHeight-1000){pg++;load();}
    },150);
  },{passive:true});

  // Search
  var sT;
  if(searchIn){
    searchIn.addEventListener('input',function(){
      clearTimeout(sT);var q=searchIn.value.trim();
      if(!q){if(sdd){sdd.innerHTML='';sdd.classList.remove('open');}return;}
      sT=setTimeout(async function(){
        try{
          var r=await fetch('/api/anime?action=search&q='+encodeURIComponent(q));
          var j=await r.json();
          if(!j.success||!j.anime)return;
          var m=j.anime.slice(0,6);
          if(sdd){
            var h=m.map(function(a){
              var im=a.image?'<img src="'+esc(a.image)+'" alt="" />':'<div class="sd-no"></div>';
              return '<a href="/anime/'+esc(a.slug)+'" class="sd-i"><div class="sd-th">'+im+'</div><div class="sd-inf"><div class="sd-t">'+esc(a.title)+'</div><div class="sd-m">'+esc(a.year||'')+(a.score?' · ⭐ '+a.score:'')+'</div></div></a>';
            }).join('');
            h+='<a href="/search?q='+encodeURIComponent(q)+'" class="sd-i sd-more"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><span>See all for "'+esc(q)+'"</span></a>';
            sdd.innerHTML=h;sdd.classList.add('open');
          }
        }catch(e){}
      },250);
    });
    searchIn.addEventListener('keydown',function(e){
      if(e.key==='Enter'){var q=searchIn.value.trim();if(q)window.location.href='/search?q='+encodeURIComponent(q);}
      if(e.key==='Escape'&&sdd){sdd.classList.remove('open');searchIn.blur();}
    });
    document.addEventListener('click',function(e){if(sdd&&!e.target.closest('.search-inline'))sdd.classList.remove('open');});
  }

  load();
})();
</script>

<style>
  .arrivals-block{position:relative}
  .arrivals-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;gap:1.25rem;flex-wrap:wrap}
  .arrivals-title-wrap{display:flex;align-items:center;gap:1rem}
  .arrivals-bar{width:4px;height:48px;background:linear-gradient(180deg,#c084fc,#e879f9,#7dd3fc);border-radius:3px;box-shadow:0 0 15px rgba(192,132,252,.6);animation:bg 3s ease infinite}
  @keyframes bg{0%,100%{box-shadow:0 0 15px rgba(192,132,252,.6)}50%{box-shadow:0 0 25px rgba(232,121,249,.8)}}
  .arrivals-tag{display:inline-flex;align-items:center;gap:.4rem;font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:700;letter-spacing:.15em;color:#c084fc;margin-bottom:4px}
  .arrivals-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 8px #ef4444;animation:lb 1.5s ease infinite}
  @keyframes lb{0%,100%{opacity:1}50%{opacity:.4}}
  .arrivals-title{font-family:var(--font-heading);font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;margin:0;letter-spacing:-.03em;line-height:1}
  .arrivals-actions{display:flex;align-items:center;gap:12px}
  .search-inline{position:relative;display:flex;align-items:center;background:rgba(28,15,61,.6);border:1px solid rgba(192,132,252,.25);border-radius:999px;padding:0 16px 0 14px;transition:all .25s ease;backdrop-filter:blur(10px);min-width:260px}
  .search-inline:focus-within{border-color:rgba(232,121,249,.6);box-shadow:0 0 0 3px rgba(192,132,252,.15);background:rgba(28,15,61,.85)}
  .si-icon{color:#c084fc;flex-shrink:0;margin-right:8px}
  .si-input{background:none;border:none;outline:none;color:var(--text-primary);font-family:inherit;font-size:.85rem;padding:10px 0;width:100%}
  .si-input::placeholder{color:var(--text-muted);opacity:.7}
  .sdd{position:absolute;top:calc(100% + 8px);left:0;right:0;background:rgba(15,8,35,.98);border:1px solid rgba(192,132,252,.25);border-radius:16px;padding:6px;max-height:400px;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.5);backdrop-filter:blur(20px);z-index:100;opacity:0;visibility:hidden;transform:translateY(-6px);transition:all .2s ease}
  .sdd.open{opacity:1;visibility:visible;transform:translateY(0)}
  .sd-i{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;text-decoration:none;color:var(--text-primary);transition:background .15s ease}
  .sd-i:hover{background:rgba(192,132,252,.12)}
  .sd-th{width:44px;height:56px;border-radius:6px;overflow:hidden;background:rgba(192,132,252,.1);flex-shrink:0}
  .sd-th img{width:100%;height:100%;object-fit:cover}
  .sd-no{width:100%;height:100%}
  .sd-inf{flex:1;min-width:0}
  .sd-t{font-size:.85rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
  .sd-m{font-size:.72rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace}
  .sd-more{border-top:1px solid rgba(192,132,252,.15);margin-top:4px;padding-top:12px;color:#c084fc;font-size:.82rem;font-weight:600;justify-content:center;gap:8px}
  .sd-more:hover{color:#e879f9}
  .arrivals-count{display:flex;align-items:baseline;gap:6px;padding:8px 16px;background:rgba(192,132,252,.1);border:1px solid rgba(192,132,252,.25);border-radius:999px;backdrop-filter:blur(10px)}
  .arrivals-count-num{font-family:'JetBrains Mono',monospace;font-size:1.2rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;min-width:24px;display:inline-block;text-align:center}
  .arrivals-count-lbl{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted)}
  .cat-tabs{display:flex;gap:8px;margin-bottom:1.75rem;overflow-x:auto;scrollbar-width:none}
  .cat-tabs::-webkit-scrollbar{display:none}
  .cat-tab{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;background:rgba(28,15,61,.5);border:1px solid var(--border-color);border-radius:999px;color:var(--text-secondary);font-family:inherit;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .25s ease;white-space:nowrap;backdrop-filter:blur(10px)}
  .cat-tab:hover{background:rgba(192,132,252,.15);border-color:rgba(192,132,252,.4);color:var(--text-primary);transform:translateY(-1px)}
  .cat-tab.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 6px 20px rgba(192,132,252,.4)}
  .cat-tab-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 6px #ef4444;animation:lb 1.5s ease infinite}
  .cat-tab.active .cat-tab-dot{background:#fff;box-shadow:0 0 6px #fff}
  .arrivals-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1.1rem}
  .a-card{display:block;text-decoration:none;color:inherit;position:relative;animation:ci .5s cubic-bezier(.34,1.56,.64,1) backwards;transition:transform .35s cubic-bezier(.34,1.56,.64,1)}
  @keyframes ci{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
  .a-card:hover{transform:translateY(-6px)}
  .a-poster{position:relative;aspect-ratio:3/4.4;border-radius:14px;overflow:hidden;background:rgba(28,15,61,.6);box-shadow:0 8px 24px rgba(0,0,0,.4),0 0 0 1px rgba(192,132,252,.12);transition:box-shadow .35s ease}
  .a-card:hover .a-poster{box-shadow:0 20px 45px rgba(0,0,0,.55),0 0 0 1.5px rgba(232,121,249,.7),0 0 30px rgba(192,132,252,.3)}
  .a-glow{position:absolute;inset:-2px;border-radius:16px;background:conic-gradient(from 0deg,#c084fc,#e879f9,#7dd3fc,#c084fc);opacity:0;z-index:-1;animation:gs 4s linear infinite;filter:blur(6px);transition:opacity .35s ease}
  .a-card:hover .a-glow{opacity:.6}
  @keyframes gs{from{transform:rotate(0)}to{transform:rotate(360deg)}}
  .a-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease,filter .35s ease}
  .a-card:hover .a-img{transform:scale(1.08);filter:brightness(.75)}
  .a-fb{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(192,132,252,.18),rgba(125,211,252,.1))}
  .a-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,5,23,.15) 0%,transparent 30%,transparent 55%,rgba(10,5,23,.6) 100%);z-index:1;pointer-events:none}
  .a-shine{position:absolute;top:0;left:-80%;width:55%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.14),transparent);z-index:3;transition:left .75s ease;pointer-events:none}
  .a-card:hover .a-shine{left:120%}
  .a-new{position:absolute;top:10px;left:10px;padding:4px 9px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;font-family:'JetBrains Mono',monospace;font-size:.58rem;font-weight:800;letter-spacing:.1em;border-radius:5px;z-index:4;box-shadow:0 3px 12px rgba(239,68,68,.5);animation:np 2.5s ease infinite}
  @keyframes np{0%,100%{box-shadow:0 3px 12px rgba(239,68,68,.5)}50%{box-shadow:0 3px 18px rgba(249,115,22,.7)}}
  .a-score{position:absolute;top:10px;right:10px;display:inline-flex;align-items:center;gap:4px;padding:4px 9px;background:rgba(10,5,23,.85);border:1px solid rgba(251,191,36,.4);color:#fbbf24;font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:800;border-radius:5px;z-index:4;backdrop-filter:blur(10px)}
  .a-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.6);width:62px;height:62px;z-index:5;opacity:0;transition:opacity .3s ease,transform .4s cubic-bezier(.34,1.56,.64,1);pointer-events:none}
  .a-card:hover .a-play{opacity:1;transform:translate(-50%,-50%) scale(1)}
  .a-playbtn{position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:4px;box-shadow:0 10px 30px rgba(192,132,252,.6),0 0 40px rgba(232,121,249,.35),inset 0 0 20px rgba(255,255,255,.15);z-index:2}
  .a-ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(192,132,252,.7);pointer-events:none;animation:rp 2s ease-out infinite}
  .a-ring-2{animation-delay:1s}
  @keyframes rp{0%{transform:scale(1);opacity:.9}100%{transform:scale(1.7);opacity:0}}
  .a-info{padding:12px 4px 4px}
  .a-title{font-family:'Bricolage Grotesque',sans-serif;font-size:.92rem;font-weight:700;color:var(--text-primary);margin:0 0 6px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:color .25s ease}
  .a-card:hover .a-title{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .a-meta{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--text-muted);font-weight:500;margin-bottom:4px}
  .a-dot{color:rgba(192,132,252,.5);margin:0 2px}
  .a-genre{display:inline-block;font-size:.66rem;font-weight:700;color:#c084fc;letter-spacing:.03em;text-transform:uppercase;font-family:'JetBrains Mono',monospace}
  .load-more-wrap{display:flex;justify-content:center;margin-top:2.5rem}
  .load-more-btn{position:relative;padding:2px;background:linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);border:none;border-radius:999px;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;box-shadow:0 8px 25px rgba(192,132,252,.35)}
  .load-more-btn:hover{transform:translateY(-3px);box-shadow:0 14px 35px rgba(192,132,252,.55)}
