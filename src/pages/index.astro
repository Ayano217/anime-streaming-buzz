---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import AnimeCard from '../components/AnimeCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const novelty = sortedPosts.slice(0, 4);
const news    = sortedPosts.slice(4, 8);
const latest  = sortedPosts.slice(8, 16);

// Fetch new arrivals from Jikan (currently airing anime)
let newArrivals = [];
try {
  const res = await fetch('https://api.jikan.moe/v4/seasons/now?filter=tv&limit=12');
  if (res.ok) {
    const data = await res.json();
    newArrivals = (data.data || []).slice(0, 12).map(a => ({
      title:    a.title_english || a.title,
      image:    a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '',
      slug:     (a.title_english || a.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80),
      score:    a.score,
      year:     a.year,
      episodes: a.episodes,
      genre:    a.genres?.[0]?.name || '',
      status:   a.status || '',
      malId:    a.mal_id,
    }));
  }
} catch (e) {
  console.warn('New arrivals fetch failed:', e);
}
---

<BaseLayout>
  <Header slot="header" />

  <!-- Hero -->
  <HeroSection />

  <!-- NEW ARRIVALS SECTION -->
  {newArrivals.length > 0 && (
    <section class="section-block arrivals-block">
      <div class="container">
        
        <div class="arrivals-header">
          <div class="arrivals-title-wrap">
            <div class="arrivals-bar"></div>
            <div>
              <div class="arrivals-tag">
                <span class="arrivals-dot"></span>
                <span>FRESH · UPDATED DAILY</span>
              </div>
              <h2 class="arrivals-title">
                <span class="grad-text">New Arrivals</span>
              </h2>
            </div>
          </div>
          
          <div class="arrivals-count">
            <span class="arrivals-count-num">{newArrivals.length}</span>
            <span class="arrivals-count-lbl">titles</span>
          </div>
        </div>
        
        <div class="arrivals-grid">
          {newArrivals.map((anime) => (
            <AnimeCard
              title={anime.title}
              image={anime.image}
              slug={anime.slug}
              score={anime.score}
              year={anime.year}
              episodes={anime.episodes}
              genre={anime.genre}
              status={anime.status}
              size="medium"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Novelty Section -->
  {novelty.length > 0 && (
    <section class="section-block novelty-block">
      <div class="container">
        <h2 class="section-title">
          <span class="grad-text">Novelty</span>
        </h2>

        <div class="novelty-grid">
          {novelty.map((post) => (
            <a href={`/posts/${post.slug}`} class="novelty-card">
              <div class="nc-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="nc-overlay"></div>
              </div>
              <div class="nc-content">
                <h3 class="nc-title">{post.data.title}</h3>
                <p class="nc-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- News Section -->
  {news.length > 0 && (
    <section class="section-block news-block">
      <div class="container">
        <h2 class="section-title">
          <span class="grad-text">News</span>
        </h2>

        <div class="news-grid">
          {news.map((post) => (
            <a href={`/posts/${post.slug}`} class="news-card">
              <div class="nw-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
              </div>
              <div class="nw-content">
                <div class="nw-category">{post.data.category}</div>
                <h3 class="nw-title">{post.data.title}</h3>
                <p class="nw-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest Season Section -->
  {latest.length > 0 && (
    <section class="section-block latest-block">
      <div class="container">
        <h2 class="section-title">
          <span class="grad-text">Latest Season</span>
        </h2>

        <div class="latest-grid">
          {latest.map((post) => (
            <a href={`/posts/${post.slug}`} class="latest-card">
              <div class="lt-image">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                )}
                <div class="lt-overlay">
                  <div class="lt-play-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="lt-content">
                <h3 class="lt-title">{post.data.title}</h3>
                <div class="lt-meta">
                  <span>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* NEW ARRIVALS SECTION */
  .arrivals-block {
    position: relative;
  }
  
  .arrivals-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    gap: 1rem;
  }
  
  .arrivals-title-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .arrivals-bar {
    width: 4px;
    height: 46px;
    background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
    border-radius: 3px;
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.6);
  }
  
  .arrivals-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--purple);
    margin-bottom: 4px;
  }
  
  .arrivals-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: arrivals-live 1.5s ease infinite;
  }
  
  @keyframes arrivals-live {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  
  .arrivals-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  
  .arrivals-count {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  
  .arrivals-count-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .arrivals-count-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  
  .arrivals-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }
  
  /* Novelty */
  .novelty-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .novelty-card {
    display: block;
    background: var(--bg-card);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    text-decoration: none;
    color: inherit;
  }

  .novelty-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(192, 132, 252, 0.15);
  }

  .nc-image {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .nc-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .novelty-card:hover .nc-image img {
    transform: scale(1.08);
  }

  .nc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      transparent 30%,
      rgba(0, 0, 0, 0.5) 70%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .nc-content { padding: 1rem 1.1rem 1.2rem; }

  .nc-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nc-excerpt {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* News */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .news-card {
    display: flex;
    gap: 1rem;
    background: var(--bg-card);
    border-radius: 16px;
    overflow: hidden;
    padding: 1rem;
    transition: transform 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .news-card:hover {
    transform: translateY(-3px);
    background: var(--bg-card-hover);
  }

  .nw-image {
    width: 120px;
    min-width: 120px;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
  }

  .nw-image img { width: 100%; height: 100%; object-fit: cover; }

  .nw-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .nw-category {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.4rem;
  }

  .nw-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nw-excerpt {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Latest */
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .latest-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .latest-card:hover { transform: translateY(-5px); }

  .lt-image {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 0.6rem;
  }

  .lt-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .latest-card:hover .lt-image img { transform: scale(1.08); }

  .lt-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(0, 0, 0, 0.5) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .latest-card:hover .lt-overlay { opacity: 1; }

  .lt-play-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding-left: 3px;
    box-shadow: 0 0 20px rgba(192, 132, 252, 0.5);
    transform: scale(0.7);
    transition: transform 0.3s ease;
  }

  .latest-card:hover .lt-play-icon { transform: scale(1); }

  .lt-content { padding: 0 0.2rem; }

  .lt-title {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lt-meta {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .arrivals-grid { grid-template-columns: repeat(4, 1fr); }
  }
  
  @media (max-width: 1024px) {
    .arrivals-grid { grid-template-columns: repeat(4, 1fr); gap: 0.85rem; }
    .novelty-grid { grid-template-columns: repeat(2, 1fr); }
    .latest-grid  { grid-template-columns: repeat(3, 1fr); }
    .news-grid    { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .arrivals-grid { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
    .arrivals-count-num { font-size: 0.95rem; }
    .arrivals-count-lbl { font-size: 0.62rem; }
    .arrivals-bar { height: 40px; }
  }
  
  @media (max-width: 640px) {
    .arrivals-grid { grid-template-columns: repeat(2, 1fr); gap: 0.65rem; }
    .arrivals-header { flex-direction: column; align-items: flex-start; }
    .novelty-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .latest-grid  { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .news-card    { padding: 0.75rem; }
    .nw-image     { width: 90px; min-width: 90px; }
    .nw-title     { font-size: 0.85rem; }
  }
</style>
