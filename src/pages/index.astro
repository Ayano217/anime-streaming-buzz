/* ========== HELPERS ========== */
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function getContent(cat='all'){
  if(cat==='all'){
    // Trending: mix by ratio
    const anime=shuffle(contentPool.filter(x=>x.c==='anime')).slice(0,15);
    const drama=shuffle(contentPool.filter(x=>x.c==='drama')).slice(0,3);
    const movie=shuffle(contentPool.filter(x=>x.c==='movie')).slice(0,3);
    const donghua=shuffle(contentPool.filter(x=>x.c==='donghua')).slice(0,3);
    const serial=shuffle(contentPool.filter(x=>x.c==='serial')).slice(0,3);
    return shuffle([...anime,...drama,...movie,...donghua,...serial]);
  }
  return shuffle(contentPool.filter(x=>x.c===cat));
}

function createCard(item){
  const div=document.createElement('div');
  div.className='card';
  const epText=item.ep?` · ${item.ep}`:'';
  div.innerHTML=`
    <div class="card-img">
      <span class="badge-new">NEW</span>
      <span class="badge-rating"><i class="fas fa-star"></i>${item.r}</span>
      <img loading="lazy" src="${item.img}" alt="${item.t}"
        onerror="this.src='https://via.placeholder.com/300x450/1a1030/8b5cf6?text=${encodeURIComponent(item.t.slice(0,15))}'">
      <span class="badge-hd">HD</span>
      <div class="play-overlay">
        <div class="play-btn"><i class="fas fa-play"></i></div>
      </div>
    </div>
    <div class="card-info">
      <div class="card-title">${item.t}</div>
      <div class="card-meta">${item.y}${epText}</div>
      <div class="card-cat">${item.g}</div>
    </div>
  `;
  return div;
}

function renderGrid(cat='all'){
  const grid=document.getElementById('mainGrid');
  const items=getContent(cat);
  
  grid.innerHTML='';
  const frag=document.createDocumentFragment();
  items.forEach(item=>frag.appendChild(createCard(item)));
  grid.appendChild(frag);
  
  document.getElementById('itemCount').textContent=`${items.length} items`;
}

/* ========== INIT ========== */
document.addEventListener('DOMContentLoaded',()=>{
  renderGrid('all');
  
  // Tabs
  document.querySelectorAll('#tabs .tab').forEach(tab=>{
    tab.addEventListener('click',()=>{
      document.querySelectorAll('#tabs .tab').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      renderGrid(tab.dataset.cat);
    });
  });
  
  // Mobile menu
  const menuBtn=document.getElementById('menuBtn');
  const mobileMenu=document.getElementById('mobileMenu');
  const overlay=document.getElementById('overlay');
  menuBtn?.addEventListener('click',()=>{
    mobileMenu.classList.toggle('open');
    overlay.classList.toggle('show');
  });
  overlay?.addEventListener('click',()=>{
    mobileMenu.classList.remove('open');
    overlay.classList.remove('show');
  });
  
  // Search
  document.getElementById('searchInput')?.addEventListener('input',e=>{
    const q=e.target.value.toLowerCase().trim();
    const grid=document.getElementById('mainGrid');
    if(!q){renderGrid('all');return}
    const results=contentPool.filter(x=>x.t.toLowerCase().includes(q));
    grid.innerHTML='';
    const frag=document.createDocumentFragment();
    results.forEach(item=>frag.appendChild(createCard(item)));
    grid.appendChild(frag);
    document.getElementById('itemCount').textContent=`${results.length} items`;
  });
  
  // Auto-refresh content every 60 seconds (fresh feel)
  setInterval(()=>{
    const activeTab=document.querySelector('#tabs .tab.active');
    if(activeTab)renderGrid(activeTab.dataset.cat);
  },60000);
});
</script>
</body>
</html>
