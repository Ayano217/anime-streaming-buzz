---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search — AniTube Buzz"
  description="Search anime, movies, K-Drama, videos, or paste any Facebook/YouTube/Dailymotion link to watch instantly."
>
  <div class="search-page">

    <!-- Search Hero -->
    <section class="search-hero">
      <div class="search-hero-inner">
        <h1 class="search-title">
          <span class="search-icon-big">🔍</span>
          <span class="glow-text">Search AniTube Buzz</span>
        </h1>
        <p class="search-subtitle">Search anime, movies, K-Drama — or paste any video link (Facebook, YouTube, Dailymotion, Bilibili)</p>

        <!-- Search Input -->
        <div class="search-input-wrapper">
          <input
            type="text"
            id="search-input"
            class="search-input"
            placeholder="Search anime, or paste video link..."
            autocomplete="off"
            autofocus
            aria-label="Search all content"
          />
          <button class="search-btn" id="search-btn" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </div>

        <!-- Link paste hint -->
        <div class="link-hint" id="linkHint" style="display:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span id="linkHintText">Video link detected — press Enter to open</span>
        </div>

        <!-- Category filter pills -->
        <div class="search-filters">
          <button class="filter-pill active" data-filter="all">All</button>
          <button class="filter-pill" data-filter="anime">Anime</button>
          <button class="filter-pill" data-filter="movies">Movies</button>
          <button class="filter-pill" data-filter="kdrama">K-Drama</button>
          <button class="filter-pill" data-filter="donghua">Donghua</button>
          <button class="filter-pill" data-filter="news">News</button>
        </div>
      </div>
    </section>

    <!-- Results Area -->
    <div class="search-content">

      <!-- Status bar -->
      <div class="search-status" id="search-status" aria-live="polite">
        <span id="status-text">Enter a keyword above to search — or paste a video link</span>
      </div>

      <!-- Link resolving state -->
      <div class="link-resolving" id="linkResolving" style="display:none;">
        <div class="link-orbit">
          <div class="link-dot"></div>
          <div class="link-dot"></div>
          <div class="link-dot"></div>
        </div>
        <p>Detecting your video...</p>
      </div>

      <!-- Video results section (from social-feed API) -->
      <div class="video-results-section" id="videoResultsSection" style="display:none;">
        <h2 class="results-heading">
          <span class="results-heading-icon">🎬</span>
          Videos
          <span class="results-count" id="videoResultsCount">0</span>
        </h2>
        <div class="video-results-grid" id="videoResults"></div>
      </div>

      <!-- Article results section (existing search-index) -->
      <div class="article-results-section" id="articleResultsSection" style="display:none;">
        <h2 class="results-heading">
          <span class="results-heading-icon">📰</span>
          Articles
          <span class="results-count" id="articleResultsCount">0</span>
        </h2>
        <div class="search-results" id="search-results" role="list"></div>
      </div>

      <!-- Empty / No results state -->
      <div class="no-results" id="no-results" style="display:none;">
        <div class="no-results-icon">😢</div>
        <h2 id="no-results-title">No results found</h2>
        <p id="no-results-msg">We couldn't find anything matching your search.</p>
        <div class="no-results-actions">
          <a
            href="https://omg10.com/4/11594510"
            target="_blank"
            rel="noopener sponsored"
            class="btn-premium-search"
          >
            ⚡ Premium Search Results
          </a>
          <a
            id="google-fallback-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-google"
          >
            🌐 Search on Google
          </a>
          <a href="/" class="btn-home">← Back to Homepage</a>
        </div>
      </div>

      <!-- Initial / Welcome state -->
      <div class="search-welcome" id="search-welcome">
        <h3 class="welcome-heading">Browse Categories</h3>
        <div class="welcome-grid">
          <a href="/category/anime" class="welcome-card">
            <span class="welcome-emoji">🎌</span>
            <span class="welcome-label">Anime</span>
          </a>
          <a href="/category/movies" class="welcome-card">
            <span class="welcome-emoji">🎬</span>
            <span class="welcome-label">Movies</span>
          </a>
          <a href="/category/kdrama" class="welcome-card">
            <span class="welcome-emoji">🎭</span>
            <span class="welcome-label">K-Drama</span>
          </a>
          <a href="/category/donghua" class="welcome-card">
            <span class="welcome-emoji">🐉</span>
            <span class="welcome-label">Donghua</span>
          </a>
          <a href="/category/news" class="welcome-card">
            <span class="welcome-emoji">📰</span>
            <span class="welcome-label">News</span>
          </a>
        </div>

        <div class="paste-tip">
          <div class="paste-tip-icon">💡</div>
          <div class="paste-tip-content">
            <strong>Pro Tip:</strong> Paste any Facebook, YouTube, Dailymotion, or Bilibili video link — we'll open it instantly!
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline>
(function () {
  'use strict';

  // ── State ──────────────────────────────────────────────
  let searchIndex = [];
  let allVideos = [];
  let currentFilter = 'all';
  let searchTimeout = null;
  let indexLoaded = false;
  let videosLoaded = false;

  // ── DOM refs ───────────────────────────────────────────
  const input       = document.getElementById('search-input');
  const statusText  = document.getElementById('status-text');
  const resultsEl   = document.getElementById('search-results');
  const videoResults = document.getElementById('videoResults');
  const videoResultsSection = document.getElementById('videoResultsSection');
  const videoResultsCount = document.getElementById('videoResultsCount');
  const articleResultsSection = document.getElementById('articleResultsSection');
  const articleResultsCount = document.getElementById('articleResultsCount');
  const noResults   = document.getElementById('no-results');
  const welcome     = document.getElementById('search-welcome');
  const googleLink  = document.getElementById('google-fallback-link');
  const filterPills = document.querySelectorAll('.filter-pill');
  const linkHint    = document.getElementById('linkHint');
  const linkHintText = document.getElementById('linkHintText');
  const linkResolving = document.getElementById('linkResolving');

  // ── Detect if input is a URL ───────────────────────────
  function detectUrlType(text) {
    const t = text.trim();
    if (/facebook\.com|fb\.watch/i.test(t)) return 'facebook';
    if (/youtube\.com|youtu\.be/i.test(t)) return 'youtube';
    if (/dailymotion\.com|dai\.ly/i.test(t)) return 'dailymotion';
    if (/bilibili\.com/i.test(t)) return 'bilibili';
    return null;
  }

  // ── Load search index ──────────────────────────────────
  async function loadIndex() {
    if (indexLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error('Index fetch failed');
      searchIndex = await res.json();
    } catch (err) {
      console.warn('Search index could not be loaded:', err);
      searchIndex = [];
    }
    indexLoaded = true;
  }

  // ── Load videos from social-feed API ───────────────────
  async function loadVideos() {
    if (videosLoaded) return;
    try {
      const res = await fetch('/api/social-feed?limit=200&format=all');
      if (!res.ok) throw new Error('Feed failed');
      const data = await res.json();
      if (data && data.success && Array.isArray(data.videos)) {
        allVideos = data.videos;
      }
    } catch (err) {
      console.warn('Videos could not be loaded:', err);
      allVideos = [];
    }
    videosLoaded = true;
  }

  // ── Resolve video link ─────────────────────────────────
  async function resolveVideoLink(url) {
    hideAll();
    linkResolving.style.display = 'flex';
    statusText.textContent = 'Detecting video from link...';
    try {
      const res = await fetch('/api/link-resolver?url=' + encodeURIComponent(url));
      const data = await res.json();
      if (data && data.success && data.redirectUrl) {
        statusText.textContent = 'Found! Opening video...';
        setTimeout(function() {
          window.location.href = data.redirectUrl;
        }, 500);
        return;
      }
      // Not detected
      linkResolving.style.display = 'none';
      noResults.style.display = 'flex';
      document.getElementById('no-results-title').textContent = "Couldn't detect this video";
      document.getElementById('no-results-msg').textContent = 'The video link was received but we could not identify it. Try searching by name.';
      statusText.textContent = 'Link not detected — try searching by name';
    } catch (err) {
      linkResolving.style.display = 'none';
      noResults.style.display = 'flex';
      document.getElementById('no-results-title').textContent = 'Link error';
      document.getElementById('no-results-msg').textContent = 'Could not resolve the video link. Please try again.';
      statusText.textContent = 'Link resolve failed';
    }
  }

  // ── Highlight matching text ────────────────────────────
  function highlight(text, query) {
    if (!query || !text) return text || '';
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp('(' + escaped + ')', 'gi');
    return text.replace(regex, '<mark class="hl">$1</mark>');
  }

  // ── Format date ────────────────────────────────────────
  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      return new Date(dateStr).toLocaleDateString('en-US', {
        year: 'numeric', month: 'short', day: 'numeric'
      });
    } catch { return dateStr; }
  }

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // ── Hide all result sections ───────────────────────────
  function hideAll() {
    welcome.style.display = 'none';
    videoResultsSection.style.display = 'none';
    articleResultsSection.style.display = 'none';
    noResults.style.display = 'none';
    linkResolving.style.display = 'none';
  }

  // ── Search videos ──────────────────────────────────────
  function searchVideos(query) {
    if (!query || !allVideos.length) return [];
    const q = query.toLowerCase();
    const words = q.split(/\s+/).filter(w => w.length > 1);
    
    return allVideos
      .map(v => {
        let score = 0;
        const title = (v.title || '').toLowerCase();
        const channel = (v.channel || '').toLowerCase();
        const desc = (v.description || '').toLowerCase();
        const type = (v.type || '').toLowerCase();
        
        // Type filter
        if (currentFilter !== 'all') {
          if (currentFilter === 'anime' && type !== 'anime') return { video: v, score: 0 };
          if (currentFilter === 'movies' && type !== 'movies') return { video: v, score: 0 };
          if (currentFilter === 'kdrama' && type !== 'kdrama') return { video: v, score: 0 };
          if (currentFilter === 'donghua' && type !== 'donghua') return { video: v, score: 0 };
          if (currentFilter === 'news') return { video: v, score: 0 };
        }
        
        if (title.includes(q)) score += 15;
        if (title.startsWith(q)) score += 8;
        if (channel.includes(q)) score += 6;
        if (desc.includes(q)) score += 3;
        
        for (const word of words) {
          if (title.includes(word)) score += 3;
          if (channel.includes(word)) score += 2;
          if (desc.includes(word)) score += 1;
        }
        
        return { video: v, score: score };
      })
      .filter(x => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 24);
  }

  // ── Search articles ────────────────────────────────────
  function searchArticles(query) {
    if (!query || !searchIndex.length) return [];
    const q = query.toLowerCase();
    const words = q.split(/\s+/).filter(w => w.length > 2);
    
    let pool = searchIndex;
    if (currentFilter === 'news') {
      pool = searchIndex.filter(p => {
        const cat = (p.category || '').toLowerCase().replace(/\s+/g, '-');
        return cat === 'news';
      });
    } else if (currentFilter !== 'all') {
      // For anime/movies/kdrama filters, skip articles unless they match category
      pool = searchIndex.filter(p => {
        const cat = (p.category || '').toLowerCase();
        return cat.includes(currentFilter);
      });
    }
    
    return pool
      .map(post => {
        let score = 0;
        const title = (post.title || '').toLowerCase();
        const excerpt = (post.excerpt || '').toLowerCase();
        const cat = (post.category || '').toLowerCase();
        const tags = (post.tags || []).join(' ').toLowerCase();
        
        if (title.includes(q)) score += 10;
        if (title.startsWith(q)) score += 5;
        if (excerpt.includes(q)) score += 4;
        if (cat.includes(q)) score += 3;
        if (tags.includes(q)) score += 2;
        
        for (const word of words) {
          if (title.includes(word)) score += 2;
          if (excerpt.includes(word)) score += 1;
        }
        
        return { post: post, score: score };
      })
      .filter(x => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 20);
  }

  // ── Render video card ──────────────────────────────────
  function typeLabel(t) {
    return ({ anime: '🎌 ANIME', kdrama: '🎭 K-DRAMA', donghua: '🐉 DONGHUA', movies: '🎬 MOVIE' })[t] || '📺 VIDEO';
  }
  
  function renderVideoCard(v) {
    const t = v.title || 'Video';
    const img = v.thumbnail || '';
    const channel = v.channel || 'AniTube';
    
    const imgHtml = img
      ? '<img src="' + escapeHtml(img) + '" alt="" loading="lazy" class="vr-thumb-img" onerror="this.style.opacity=0.3" />'
      : '<div class="vr-thumb-fallback">📺</div>';
    
    return '<a href="/reels/' + encodeURIComponent(v.id) + '" class="vr-card">' +
      '<div class="vr-thumb">' +
        imgHtml +
        '<div class="vr-overlay"></div>' +
        '<div class="vr-play">' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
        '</div>' +
        '<div class="vr-type">' + typeLabel(v.type) + '</div>' +
        (v.isNew ? '<div class="vr-new">NEW</div>' : '') +
      '</div>' +
      '<div class="vr-info">' +
        '<h3 class="vr-title">' + escapeHtml(t) + '</h3>' +
        '<p class="vr-channel">' + escapeHtml(channel) + '</p>' +
      '</div>' +
    '</a>';
  }

  // ── Run search ─────────────────────────────────────────
  async function runSearch() {
    const rawQuery = input.value.trim();
    
    if (!rawQuery) {
      hideAll();
      welcome.style.display = 'block';
      statusText.textContent = 'Enter a keyword above to search — or paste a video link';
      return;
    }
    
    // Check if it's a URL
    const urlType = detectUrlType(rawQuery);
    if (urlType) {
      linkHint.style.display = 'none';
      await resolveVideoLink(rawQuery);
      return;
    }
    
    // Load both data sources
    await Promise.all([loadIndex(), loadVideos()]);
    
    hideAll();
    
    const videoMatches = searchVideos(rawQuery);
    const articleMatches = searchArticles(rawQuery);
    const totalCount = videoMatches.length + articleMatches.length;
    
    // Update Google fallback
    const encodedQ = encodeURIComponent(rawQuery + ' anime');
    googleLink.href = 'https://www.google.com/search?q=' + encodedQ;
    
    if (totalCount === 0) {
      noResults.style.display = 'flex';
      document.getElementById('no-results-title').textContent = 'No results for "' + rawQuery + '"';
      document.getElementById('no-results-msg').textContent = 'Try different keywords, or paste a Facebook/YouTube/Dailymotion video link.';
      statusText.textContent = '0 results for "' + rawQuery + '"';
      return;
    }
    
    statusText.textContent = totalCount + ' result' + (totalCount !== 1 ? 's' : '') + ' for "' + rawQuery + '"';
    
    // Show video results
    if (videoMatches.length > 0) {
      videoResultsSection.style.display = 'block';
      videoResultsCount.textContent = videoMatches.length;
      videoResults.innerHTML = videoMatches.map(x => renderVideoCard(x.video)).join('');
    }
    
    // Show article results
    if (articleMatches.length > 0) {
      articleResultsSection.style.display = 'block';
      articleResultsCount.textContent = articleMatches.length;
      resultsEl.innerHTML = articleMatches.map(x => {
        const post = x.post;
        const safeTitle = highlight(post.title || 'Untitled', rawQuery);
        const safeExcerpt = highlight(
          (post.excerpt || '').substring(0, 180) + ((post.excerpt || '').length > 180 ? '...' : ''),
          rawQuery
        );
        const catDisplay = post.category || 'General';
        const imgSrc = post.image || '/placeholder.jpg';
        const dateStr = formatDate(post.date);
        
        return '<article class="result-card" role="listitem">' +
          '<a href="/posts/' + post.slug + '" class="result-link">' +
            '<div class="result-image-wrap">' +
              '<img src="' + escapeHtml(imgSrc) + '" alt="" class="result-image" loading="lazy" onerror="this.src=\'/placeholder.jpg\'" />' +
              '<span class="result-category-badge">' + escapeHtml(catDisplay) + '</span>' +
            '</div>' +
            '<div class="result-body">' +
              '<h3 class="result-title">' + safeTitle + '</h3>' +
              '<p class="result-excerpt">' + safeExcerpt + '</p>' +
              '<div class="result-meta">' +
                '<span class="result-date">' + dateStr + '</span>' +
                '<span class="result-read">Read →</span>' +
              '</div>' +
            '</div>' +
          '</a>' +
        '</article>';
      }).join('');
    }
  }

  // ── Input event (with URL detection) ───────────────────
  input.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const val = input.value.trim();
    const urlType = detectUrlType(val);
    
    if (urlType) {
      linkHint.style.display = 'flex';
      linkHintText.textContent = urlType.charAt(0).toUpperCase() + urlType.slice(1) + ' link detected — press Enter to open';
    } else {
      linkHint.style.display = 'none';
    }
    
    searchTimeout = setTimeout(runSearch, 300);
  });

  // ── Enter key ──────────────────────────────────────────
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      clearTimeout(searchTimeout);
      runSearch();
    }
  });

  // ── Search button ──────────────────────────────────────
  document.getElementById('search-btn').addEventListener('click', function() {
    clearTimeout(searchTimeout);
    runSearch();
  });

  // ── Filter pills ───────────────────────────────────────
  filterPills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      currentFilter = pill.dataset.filter;
      if (input.value.trim()) runSearch();
    });
  });

  // ── Check ?q= in URL ───────────────────────────────────
  const urlParams = new URLSearchParams(window.location.search);
  const preQuery = urlParams.get('q');
  if (preQuery) {
    input.value = preQuery;
    runSearch();
  }

  // ── Pre-load ───────────────────────────────────────────
  loadIndex();
  loadVideos();

})();
</script>

<style>
  .search-page { min-height: 100vh; }

  .search-hero {
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(139, 0, 255, 0.12) 50%, rgba(255, 0, 128, 0.06) 100%);
    border-bottom: 1px solid rgba(139, 0, 255, 0.2);
    padding: 3rem 1.5rem 2.5rem;
    text-align: center;
  }
  .search-hero-inner { max-width: 720px; margin: 0 auto; }
  .search-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .btn-premium-search {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.3rem;
    background: linear-gradient(135deg, #f59e0b, #ea580c);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    transition: all 0.2s;
    border: 1px solid rgba(245, 158, 11, 0.5);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
  }
  .btn-premium-search:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
  }
  .search-icon-big { font-size: 0.8em; }
  .glow-text {
    background: linear-gradient(135deg, #fff 0%, #c084fc 50%, #00d4ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 15px rgba(139, 0, 255, 0.4));
  }
  .search-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-input-wrapper {
    display: flex;
    gap: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1.5px solid rgba(139, 0, 255, 0.5);
    background: rgba(10, 10, 20, 0.8);
    box-shadow: 0 0 20px rgba(139, 0, 255, 0.15);
    margin-bottom: 0.75rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-input-wrapper:focus-within {
    border-color: rgba(139, 0, 255, 0.9);
    box-shadow: 0 0 30px rgba(139, 0, 255, 0.3);
  }
  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 1rem;
    padding: 0.9rem 1.2rem;
    font-family: inherit;
  }
  .search-input::placeholder { color: rgba(255, 255, 255, 0.3); }
  .search-btn {
    background: linear-gradient(135deg, #8b00ff, #5500cc);
    border: none;
    color: #fff;
    padding: 0 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    min-width: 52px;
  }
  .search-btn:hover { background: linear-gradient(135deg, #9f1fff, #6600ff); }

  /* Link hint */
  .link-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 1rem;
    padding: 6px 14px;
    background: rgba(0, 200, 100, 0.12);
    border: 1px solid rgba(0, 200, 100, 0.35);
    border-radius: 999px;
    color: #4ade80;
    font-size: 0.75rem;
    font-weight: 600;
    animation: linkHintFade 0.3s ease;
  }
  @keyframes linkHintFade { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }
