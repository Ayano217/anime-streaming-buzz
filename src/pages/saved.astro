---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Saved Videos | AniTubeBuzz">
  <Header slot="header" />
  
  <div class="atb-saved-page">
    <div class="container">
      
      <div class="atb-hero-box">
        <div class="atb-hero-icon-wrap">
          <div class="atb-hero-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
        </div>
        <div class="atb-hero-text">
          <div class="atb-hero-eyebrow">MY LIBRARY</div>
          <h1 class="atb-hero-title">Saved Videos</h1>
          <p class="atb-hero-sub" id="atbSubtitle">Loading...</p>
        </div>
        <button class="atb-hero-clear" id="atbClearBtn" style="display:none">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
          </svg>
          <span>Clear All</span>
        </button>
      </div>
      
      <div id="atbGrid" class="atb-grid"></div>
      
      <div id="atbEmpty" class="atb-empty" style="display:none">
        <div class="atb-empty-icon">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h2 class="atb-empty-title">No Saved Videos Yet</h2>
        <p class="atb-empty-desc">Watch anime and tap <strong>Save</strong> to bookmark videos here</p>
        <a href="/" class="atb-empty-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Start Watching
        </a>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  var grid = document.getElementById('atbGrid');
  var empty = document.getElementById('atbEmpty');
  var subtitle = document.getElementById('atbSubtitle');
  var clearBtn = document.getElementById('atbClearBtn');
  
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  
  function fmtTime(ts) {
    if (!ts) return 'recently';
    var diff = Date.now() - ts;
    var mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    var days = Math.floor(hrs / 24);
    if (days < 30) return days + 'd ago';
    return Math.floor(days / 30) + 'mo ago';
  }
  
  function typeLabel(t) {
    var map = { anime: 'ANIME', kdrama: 'K-DRAMA', donghua: 'DONGHUA', movies: 'MOVIE' };
    return map[t] || 'ANIME';
  }
  
  function render() {
    var items = [];
    try { items = JSON.parse(localStorage.getItem('anitube_saved') || '[]'); } catch(e) {}
    
    if (!items.length) {
      grid.style.display = 'none';
      empty.style.display = 'flex';
      subtitle.textContent = 'Nothing here yet';
      clearBtn.style.display = 'none';
      return;
    }
    
    empty.style.display = 'none';
    grid.style.display = 'grid';
    subtitle.textContent = items.length + ' ' + (items.length === 1 ? 'video' : 'videos');
    clearBtn.style.display = 'inline-flex';
    
    // Build cards using INLINE STYLES to bypass any CSS conflicts
    var html = '';
    items.forEach(function(v, i) {
      var title = esc(v.title || 'Untitled');
      var channel = esc(v.channel || 'AniTube');
      var thumb = v.thumbnail || '';
      var initial = channel.charAt(0).toUpperCase();
      var time = fmtTime(v.savedAt);
      var type = typeLabel(v.type);
      var delay = Math.min(i * 30, 400);
      
      // INLINE STYLES on every element - unbreakable
      html += 
      '<a href="/reels/' + encodeURIComponent(v.id) + '" class="atb-card" style="' +
        'animation-delay:' + delay + 'ms;' +
        'display:block !important;' +
        'position:relative !important;' +
        'width:100% !important;' +
        'padding:0 !important;' +
        'margin:0 !important;' +
        'background:rgba(28,15,61,0.55) !important;' +
        'border:1px solid rgba(192,132,252,0.15) !important;' +
        'border-radius:12px !important;' +
        'overflow:hidden !important;' +
        'text-decoration:none !important;' +
        'color:inherit !important;' +
        'box-sizing:border-box !important;' +
        'transition:transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.25s, box-shadow 0.35s, background 0.25s !important;' +
      '">' +
        // Thumbnail wrapper - fixed 16:9
        '<div style="' +
          'position:relative !important;' +
          'width:100% !important;' +
          'padding-bottom:56.25% !important;' + // 16:9 aspect fallback
          'overflow:hidden !important;' +
          'background:linear-gradient(135deg,#1c0f3d,#241548) !important;' +
          'display:block !important;' +
          'margin:0 !important;' +
        '">' +
          // Image or gradient placeholder
          (thumb 
            ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" style="' +
                'position:absolute !important;' +
                'top:0 !important;' +
                'left:0 !important;' +
                'width:100% !important;' +
                'height:100% !important;' +
                'object-fit:cover !important;' +
                'display:block !important;' +
                'max-width:none !important;' +
                'max-height:none !important;' +
                'aspect-ratio:auto !important;' +
                'transition:transform 0.5s ease, filter 0.3s ease !important;' +
              '" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';"/>' +
              '<div style="' +
                'position:absolute !important;' +
                'inset:0 !important;' +
                'display:none !important;' +
                'align-items:center !important;' +
                'justify-content:center !important;' +
                'background:radial-gradient(circle at 30% 30%,rgba(232,121,249,0.5) 0%,transparent 55%),radial-gradient(circle at 70% 70%,rgba(125,211,252,0.4) 0%,transparent 55%),linear-gradient(135deg,#a855f7,#e879f9,#7dd3fc) !important;' +
                'font-family:\'Bricolage Grotesque\',sans-serif !important;' +
                'font-size:2.2rem !important;' +
                'font-weight:800 !important;' +
                'color:white !important;' +
                'text-shadow:0 4px 20px rgba(0,0,0,0.5) !important;' +
              '">' + initial + '</div>'
            : '<div style="' +
                'position:absolute !important;' +
                'inset:0 !important;' +
                'display:flex !important;' +
                'align-items:center !important;' +
                'justify-content:center !important;' +
                'background:radial-gradient(circle at 30% 30%,rgba(232,121,249,0.5) 0%,transparent 55%),radial-gradient(circle at 70% 70%,rgba(125,211,252,0.4) 0%,transparent 55%),linear-gradient(135deg,#a855f7,#e879f9,#7dd3fc) !important;' +
                'font-family:\'Bricolage Grotesque\',sans-serif !important;' +
                'font-size:2.2rem !important;' +
                'font-weight:800 !important;' +
                'color:white !important;' +
                'text-shadow:0 4px 20px rgba(0,0,0,0.5) !important;' +
              '">' + initial + '</div>'
          ) +
          
          // Type badge (top-left) - CONTAINED size
          '<div style="' +
            'position:absolute !important;' +
            'top:7px !important;' +
            'left:7px !important;' +
            'padding:3px 7px !important;' +
            'background:linear-gradient(135deg,#c084fc,#e879f9) !important;' +
            'color:white !important;' +
            'font-family:\'JetBrains Mono\',monospace !important;' +
            'font-size:0.55rem !important;' +
            'font-weight:800 !important;' +
            'letter-spacing:0.06em !important;' +
            'border-radius:4px !important;' +
            'text-transform:uppercase !important;' +
            'box-shadow:0 3px 10px rgba(192,132,252,0.5) !important;' +
            'z-index:4 !important;' +
            'width:auto !important;' +
            'max-width:max-content !important;' +
            'height:auto !important;' +
            'line-height:1 !important;' +
          '">' + type + '</div>' +
          
          // Remove button (top-right)
          '<button data-remove-id="' + esc(v.id) + '" aria-label="Remove" style="' +
            'position:absolute !important;' +
            'top:7px !important;' +
            'right:7px !important;' +
            'width:24px !important;' +
            'height:24px !important;' +
            'border-radius:50% !important;' +
            'background:rgba(0,0,0,0.75) !important;' +
            'backdrop-filter:blur(10px) !important;' +
            '-webkit-backdrop-filter:blur(10px) !important;' +
            'border:1px solid rgba(239,68,68,0.5) !important;' +
            'color:#ef4444 !important;' +
            'cursor:pointer !important;' +
            'display:flex !important;' +
            'align-items:center !important;' +
            'justify-content:center !important;' +
            'opacity:0 !important;' +
            'transition:all 0.25s !important;' +
            'padding:0 !important;' +
            'z-index:5 !important;' +
          '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:11px !important;height:11px !important;"><path d="M18 6L6 18M6 6l12 12"/></svg></button>' +
          
          // Play button (center) - contained
          '<div class="atb-play-btn" style="' +
            'position:absolute !important;' +
            'top:50% !important;' +
            'left:50% !important;' +
            'transform:translate(-50%,-50%) scale(0.5) !important;' +
            'width:42px !important;' +
            'height:42px !important;' +
            'min-width:42px !important;' +
            'min-height:42px !important;' +
            'max-width:42px !important;' +
            'max-height:42px !important;' +
            'border-radius:50% !important;' +
            'background:linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc) !important;' +
            'display:flex !important;' +
            'align-items:center !important;' +
            'justify-content:center !important;' +
            'color:white !important;' +
            'opacity:0 !important;' +
            'transition:all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;' +
            'box-shadow:0 8px 25px rgba(192,132,252,0.65), inset 0 1px 0 rgba(255,255,255,0.3) !important;' +
            'pointer-events:none !important;' +
            'z-index:4 !important;' +
            'padding:0 !important;' +
            'margin:0 !important;' +
          '"><svg viewBox="0 0 24 24" fill="currentColor" style="width:17px !important;height:17px !important;margin-left:2px !important;max-width:17px !important;max-height:17px !important;"><path d="M8 5v14l11-7z"/></svg></div>' +
        '</div>' +
        
        // Info section
        '<div style="' +
          'padding:10px 11px 12px !important;' +
          'display:block !important;' +
          'width:100% !important;' +
          'box-sizing:border-box !important;' +
        '">' +
          '<div style="' +
            'font-family:\'DM Sans\',sans-serif !important;' +
            'font-size:0.82rem !important;' +
            'font-weight:700 !important;' +
            'color:var(--text-primary) !important;' +
            'line-height:1.35 !important;' +
            'margin:0 0 5px 0 !important;' +
            'display:-webkit-box !important;' +
            '-webkit-line-clamp:2 !important;' +
            '-webkit-box-orient:vertical !important;' +
            'overflow:hidden !important;' +
            'letter-spacing:-0.005em !important;' +
            'min-height:2.3em !important;' +
          '">' + title + '</div>' +
          '<div style="' +
            'display:flex !important;' +
            'align-items:center !important;' +
            'gap:5px !important;' +
            'font-family:\'JetBrains Mono\',monospace !important;' +
            'font-size:0.62rem !important;' +
            'color:var(--text-muted) !important;' +
            'line-height:1.2 !important;' +
          '">' +
            '<span style="' +
              'color:#c084fc !important;' +
              'font-weight:600 !important;' +
              'max-width:90px !important;' +
              'white-space:nowrap !important;' +
              'overflow:hidden !important;' +
              'text-overflow:ellipsis !important;' +
            '">@' + channel.replace(/\s+/g,'').toLowerCase().slice(0,15) + '</span>' +
            '<span style="opacity:0.4 !important;">·</span>' +
            '<span>' + time + '</span>' +
          '</div>' +
        '</div>' +
      '</a>';
    });
    grid.innerHTML = html;
    
    // Handle remove buttons
    grid.querySelectorAll('[data-remove-id]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('data-remove-id');
        var arr = [];
        try { arr = JSON.parse(localStorage.getItem('anitube_saved') || '[]'); } catch(e) {}
        arr = arr.filter(function(x) { return x.id !== id; });
        localStorage.setItem('anitube_saved', JSON.stringify(arr));
        render();
      });
    });
    
    // Handle hover states via JS (bypass any CSS conflicts)
    grid.querySelectorAll('.atb-card').forEach(function(card) {
      card.addEventListener('mouseenter', function() {
        card.style.transform = 'translateY(-6px)';
        card.style.background = 'rgba(36, 21, 72, 0.75)';
        card.style.borderColor = 'rgba(192, 132, 252, 0.45)';
        card.style.boxShadow = '0 20px 40px rgba(0, 0, 0, 0.35), 0 0 25px rgba(192, 132, 252, 0.2)';
        var img = card.querySelector('img');
        if (img) {
          img.style.transform = 'scale(1.08)';
          img.style.filter = 'brightness(0.85)';
        }
        var play = card.querySelector('.atb-play-btn');
        if (play) {
          play.style.opacity = '1';
          play.style.transform = 'translate(-50%,-50%) scale(1)';
        }
        var removeBtn = card.querySelector('[data-remove-id]');
        if (removeBtn) removeBtn.style.opacity = '1';
      });
      card.addEventListener('mouseleave', function() {
        card.style.transform = '';
        card.style.background = 'rgba(28,15,61,0.55)';
        card.style.borderColor = 'rgba(192,132,252,0.15)';
        card.style.boxShadow = '';
        var img = card.querySelector('img');
        if (img) {
          img.style.transform = '';
          img.style.filter = '';
        }
        var play = card.querySelector('.atb-play-btn');
        if (play) {
          play.style.opacity = '0';
          play.style.transform = 'translate(-50%,-50%) scale(0.5)';
        }
        var removeBtn = card.querySelector('[data-remove-id]');
        if (removeBtn) removeBtn.style.opacity = '0';
      });
    });
  }
  
  clearBtn.addEventListener('click', function() {
    if (confirm('Remove all saved videos?')) {
      localStorage.removeItem('anitube_saved');
      render();
    }
  });
  
  render();
})();
</script>

<style>
  /* Only hero + grid + empty state styles here (cards use inline styles) */
  .atb-saved-page {
    min-height: calc(100vh - var(--header-h) - 100px);
    padding: 2rem 0 5rem;
  }
  
  .atb-hero-box {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 26px;
    background: 
      linear-gradient(135deg, rgba(168, 85, 247, 0.08), rgba(232, 121, 249, 0.05)),
      linear-gradient(180deg, rgba(28, 15, 61, 0.7), rgba(20, 10, 40, 0.8));
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 22px;
    margin-bottom: 2rem;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
  }
  .atb-hero-box::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  [data-theme="light"] .atb-hero-box {
    background: 
      linear-gradient(135deg, rgba(168, 85, 247, 0.05), rgba(232, 121, 249, 0.03)),
      linear-gradient(180deg, #ffffff, #faf5ff);
    border-color: rgba(168, 85, 247, 0.25);
  }
  
  .atb-hero-icon-wrap { position: relative; flex-shrink: 0; }
  .atb-hero-icon-wrap::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: linear-gradient(135deg, #a855f7, #e879f9);
    border-radius: 20px;
    opacity: 0.4;
    filter: blur(12px);
  }
  .atb-hero-icon {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: linear-gradient(135deg, #a855f7, #c084fc, #e879f9);
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.5);
  }
  
  .atb-hero-text { flex: 1; min-width: 0; position: relative; z-index: 1; }
  .atb-hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: #e879f9;
    letter-spacing: 0.15em;
    margin-bottom: 4px;
  }
  .atb-hero-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 4px;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  .atb-hero-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    font-weight: 500;
  }
  .atb-hero-clear {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 100px;
    color: #ef4444;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  .atb-hero-clear:hover {
    background: rgba(239, 68, 68, 0.2);
    transform: translateY(-2px);
  }
  
  /* GRID - unique, isolated */
  .atb-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.1rem;
    width: 100%;
    box-sizing: border-box;
  }
  
  @media (max-width: 1200px) { .atb-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } }
  @media (max-width: 900px) { .atb-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; } }
  @media (max-width: 640px) { .atb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; } }
  
  /* Card entry animation */
  @keyframes atbFadeIn {
    from { opacity: 0; transform: translateY(15px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .atb-card {
    animation: atbFadeIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }
  
  /* EMPTY STATE */
  .atb-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    min-height: 480px;
  }
  .atb-empty-icon {
    width: 96px;
    height: 96px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.12), rgba(232, 121, 249, 0.08));
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(192, 132, 252, 0.55);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(192, 132, 252, 0.25);
  }
  .atb-empty-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  .atb-empty-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    max-width: 360px;
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }
  .atb-empty-desc strong { color: #c084fc; font-weight: 700; }
  .atb-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    color: white;
    border-radius: 100px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.86rem;
    box-shadow: 0 10px 30px rgba(192, 132, 252, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .atb-empty-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(192, 132, 252, 0.65);
  }
  
  @media (max-width: 640px) {
    .atb-hero-box { padding: 15px 16px; gap: 12px; border-radius: 18px; }
    .atb-hero-icon { width: 44px; height: 44px; border-radius: 12px; }
    .atb-hero-icon svg { width: 22px; height: 22px; }
    .atb-hero-clear { padding: 6px 10px; font-size: 0.68rem; }
  }
</style>
