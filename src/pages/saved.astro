---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Saved Videos | AniTubeBuzz" description="Your bookmarked anime videos">
  <Header slot="header" />
  
  <div class="lib-page">
    <div class="container">
      
      <div class="lib-hero">
        <div class="lib-hero-icon-wrap">
          <div class="lib-hero-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
        </div>
        <div class="lib-hero-content">
          <div class="lib-hero-eyebrow">MY LIBRARY</div>
          <h1 class="lib-title">Saved Videos</h1>
          <p class="lib-subtitle" id="libSubtitle">Loading...</p>
        </div>
        <button class="lib-clear-btn" id="libClearBtn" style="display:none">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
          </svg>
          <span>Clear All</span>
        </button>
      </div>
      
      <div id="libGrid" class="lib-grid"></div>
      
      <div id="libEmpty" class="lib-empty" style="display:none">
        <div class="lib-empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h2 class="lib-empty-title">No Saved Videos Yet</h2>
        <p class="lib-empty-desc">Watch anime and tap <strong>Save</strong> to bookmark videos here</p>
        <a href="/" class="lib-empty-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Start Watching
        </a>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  var grid = document.getElementById('libGrid');
  var empty = document.getElementById('libEmpty');
  var subtitle = document.getElementById('libSubtitle');
  var clearBtn = document.getElementById('libClearBtn');
  
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  
  function fmtTime(ts) {
    if (!ts) return 'recently';
    var diff = Date.now() - ts;
    var mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    var days = Math.floor(hrs / 24);
    if (days < 30) return days + 'd ago';
    return Math.floor(days / 30) + 'mo ago';
  }
  
  function typeLabel(t) {
    var map = { anime: 'ANIME', kdrama: 'K-DRAMA', donghua: 'DONGHUA', movies: 'MOVIE' };
    return map[t] || 'ANIME';
  }
  
  function typeColor(t) {
    var map = { anime: '#c084fc', kdrama: '#ec4899', donghua: '#f97316', movies: '#7dd3fc' };
    return map[t] || '#c084fc';
  }
  
  function render() {
    var items = [];
    try { items = JSON.parse(localStorage.getItem('anitube_saved') || '[]'); } catch(e) {}
    
    if (!items.length) {
      grid.style.display = 'none';
      empty.style.display = 'flex';
      subtitle.textContent = 'Nothing here yet';
      clearBtn.style.display = 'none';
      return;
    }
    
    empty.style.display = 'none';
    grid.style.display = 'grid';
    subtitle.textContent = items.length + ' ' + (items.length === 1 ? 'video' : 'videos');
    clearBtn.style.display = 'inline-flex';
    
    var html = '';
    items.forEach(function(v, i) {
      var title = esc(v.title || 'Untitled');
      var channel = esc(v.channel || 'AniTube');
      var thumb = v.thumbnail || '';
      var initial = channel.charAt(0).toUpperCase();
      var time = fmtTime(v.savedAt);
      var type = typeLabel(v.type);
      var tColor = typeColor(v.type);
      var delay = Math.min(i * 25, 400);
      
      html += '<a href="/reels/' + encodeURIComponent(v.id) + '" class="lib-card" style="animation-delay:' + delay + 'ms">' +
        '<div class="lib-card-thumb">' +
          (thumb 
            ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';"/><div class="lib-card-noimg" style="display:none">' + initial + '</div>'
            : '<div class="lib-card-noimg">' + initial + '</div>'
          ) +
          '<div class="lib-card-shine"></div>' +
          '<div class="lib-card-badge" style="background:linear-gradient(135deg,' + tColor + ',#e879f9)">' + type + '</div>' +
          '<button class="lib-card-remove" data-id="' + esc(v.id) + '" aria-label="Remove">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>' +
          '</button>' +
          '<div class="lib-card-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>' +
        '</div>' +
        '<div class="lib-card-info">' +
          '<div class="lib-card-title">' + title + '</div>' +
          '<div class="lib-card-meta"><span class="lib-card-channel">@' + channel.replace(/\s+/g,'').toLowerCase().slice(0,15) + '</span><span class="lib-card-dot">·</span><span>' + time + '</span></div>' +
        '</div>' +
      '</a>';
    });
    grid.innerHTML = html;
    
    grid.querySelectorAll('.lib-card-remove').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('data-id');
        var arr = [];
        try { arr = JSON.parse(localStorage.getItem('anitube_saved') || '[]'); } catch(e) {}
        arr = arr.filter(function(x) { return x.id !== id; });
        localStorage.setItem('anitube_saved', JSON.stringify(arr));
        render();
      });
    });
  }
  
  clearBtn.addEventListener('click', function() {
    if (confirm('Remove all saved videos?')) {
      localStorage.removeItem('anitube_saved');
      render();
    }
  });
  
  render();
})();
</script>

<style>
  .lib-page {
    min-height: calc(100vh - var(--header-h) - 100px);
    padding: 2rem 0 5rem;
  }
  
  /* HERO */
  .lib-hero {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 24px 28px;
    background: 
      linear-gradient(135deg, rgba(168, 85, 247, 0.08), rgba(232, 121, 249, 0.05)),
      linear-gradient(180deg, rgba(28, 15, 61, 0.7), rgba(20, 10, 40, 0.8));
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 24px;
    margin-bottom: 2rem;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }
  .lib-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  [data-theme="light"] .lib-hero {
    background: 
      linear-gradient(135deg, rgba(168, 85, 247, 0.05), rgba(232, 121, 249, 0.03)),
      linear-gradient(180deg, #ffffff, #faf5ff);
    border-color: rgba(168, 85, 247, 0.25);
  }
  .lib-hero-icon-wrap { position: relative; flex-shrink: 0; }
  .lib-hero-icon-wrap::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: linear-gradient(135deg, #a855f7, #e879f9);
    border-radius: 20px;
    opacity: 0.4;
    filter: blur(12px);
  }
  .lib-hero-icon {
    position: relative;
    width: 56px; height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #a855f7, #c084fc, #e879f9);
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .lib-hero-content { flex: 1; min-width: 0; position: relative; z-index: 1; }
  .lib-hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem; font-weight: 700;
    color: #e879f9;
    letter-spacing: 0.15em;
    margin-bottom: 4px;
  }
  .lib-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 4px;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  .lib-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0;
    font-weight: 500;
  }
  .lib-clear-btn {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 100px;
    color: #ef4444;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  .lib-clear-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
  }
  
  /* ═══════════════════════════════════════════════════
     🎨 GRID — Home page 5-column style
     ═══════════════════════════════════════════════════ */
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
  }
  
  @media (max-width: 1200px) { .lib-grid { grid-template-columns: repeat(4, 1fr); gap: 1rem; } }
  @media (max-width: 900px) { .lib-grid { grid-template-columns: repeat(3, 1fr); gap: 0.9rem; } }
  @media (max-width: 640px) { .lib-grid { grid-template-columns: repeat(2, 1fr); gap: 0.7rem; } }
  
  /* ═══════════════════════════════════════════════════
     🃏 CARD — Match home page premium style
     ═══════════════════════════════════════════════════ */
  .lib-card {
    display: block;
    background: rgba(28, 15, 61, 0.5);
    border: 1px solid rgba(192, 132, 252, 0.15);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                border-color 0.25s ease,
                box-shadow 0.35s ease,
                background 0.25s ease;
    animation: lib-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    position: relative;
    will-change: transform;
  }
  
  [data-theme="light"] .lib-card {
    background: #ffffff;
    border-color: rgba(168, 85, 247, 0.15);
  }
  
  @keyframes lib-in {
    from { opacity: 0; transform: translateY(15px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .lib-card:hover {
    transform: translateY(-6px);
    background: rgba(36, 21, 72, 0.75);
    border-color: rgba(192, 132, 252, 0.45);
    box-shadow: 
      0 22px 45px rgba(0, 0, 0, 0.35),
      0 0 30px rgba(192, 132, 252, 0.2);
  }
  
  [data-theme="light"] .lib-card:hover {
    background: #faf5ff;
    box-shadow: 0 22px 45px rgba(168, 85, 247, 0.2);
  }
  
  /* THUMBNAIL — Fixed size, home-style */
  .lib-card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, #1c0f3d, #241548);
  }
  
  .lib-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), filter 0.3s ease;
  }
  
  .lib-card:hover .lib-card-thumb img {
    transform: scale(1.08);
    filter: brightness(0.85);
  }
  
  /* Beautiful gradient placeholder (when no thumbnail) */
  .lib-card-noimg {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: 
      radial-gradient(circle at 30% 30%, rgba(232, 121, 249, 0.4) 0%, transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(125, 211, 252, 0.35) 0%, transparent 55%),
      linear-gradient(135deg, #a855f7, #e879f9, #7dd3fc);
    color: white;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }
  
  .lib-card-noimg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.15) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: shimmer-slow 3s ease-in-out infinite;
  }
  
  @keyframes shimmer-slow {
    0% { transform: translateX(-100%); }
    50%, 100% { transform: translateX(100%); }
  }
  
  /* Shine sweep on hover */
  .lib-card-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      110deg,
      transparent 25%,
      rgba(255, 255, 255, 0.15) 50%,
      transparent 75%
    );
    transition: left 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 2;
  }
  
  .lib-card:hover .lib-card-shine { left: 100%; }
  
  /* Badge (top-left) - matches home NEW/HD */
  .lib-card-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 8px;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    border-radius: 5px;
    text-transform: uppercase;
    box-shadow: 0 3px 10px rgba(192, 132, 252, 0.4);
    z-index: 3;
  }
  
  /* Remove button (top-right) */
  .lib-card-remove {
    position: absolute;
    top: 8px; right: 8px;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(239, 68, 68, 0.5);
    color: #ef4444;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.25s;
    padding: 0;
    z-index: 4;
  }
  .lib-card-remove svg { width: 12px; height: 12px; }
  .lib-card:hover .lib-card-remove { opacity: 1; }
  .lib-card-remove:hover {
    background: rgba(239, 68, 68, 0.95);
    color: white;
    transform: scale(1.15);
  }
  
  /* Play button (center) - premium home style */
  .lib-card-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.5);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 
      0 8px 25px rgba(192, 132, 252, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    pointer-events: none;
    z-index: 3;
  }
  .lib-card-play svg { width: 18px; height: 18px; margin-left: 2px; }
  
  .lib-card:hover .lib-card-play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  
  /* INFO */
  .lib-card-info { 
    padding: 10px 12px 12px;
  }
  
  .lib-card-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0 0 5px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.25s ease;
    letter-spacing: -0.005em;
    min-height: 2.3em;
  }
  
  .lib-card:hover .lib-card-title {
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .lib-card-meta {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.63rem;
    color: var(--text-muted);
    line-height: 1.2;
  }
  
  .lib-card-channel {
    color: var(--purple);
    font-weight: 600;
    max-width: 90px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .lib-card-dot { opacity: 0.4; }
  
  /* EMPTY STATE */
  .lib-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    min-height: 500px;
  }
  
  .lib-empty-icon {
    width: 100px;
    height: 100px;
    border-radius: 30px;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.12), rgba(232, 121, 249, 0.08));
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(192, 132, 252, 0.55);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(192, 132, 252, 0.25);
  }
  
  .lib-empty-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  
  .lib-empty-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    max-width: 380px;
    margin: 0 0 1.6rem;
    line-height: 1.6;
  }
  
  .lib-empty-desc strong {
    color: var(--purple);
    font-weight: 700;
  }
  
  .lib-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    color: white;
    border-radius: 100px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.88rem;
    box-shadow: 0 10px 30px rgba(192, 132, 252, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .lib-empty-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(192, 132, 252, 0.65);
  }
  
  @media (max-width: 640px) {
    .lib-hero {
      padding: 16px 18px;
      gap: 14px;
      border-radius: 20px;
    }
    .lib-hero-icon { width: 46px; height: 46px; border-radius: 13px; }
    .lib-hero-icon svg { width: 24px; height: 24px; }
    .lib-clear-btn { padding: 7px 11px; font-size: 0.7rem; }
    .lib-card-info { padding: 9px 10px 11px; }
    .lib-card-title { font-size: 0.78rem; min-height: 2.1em; }
    .lib-card-meta { font-size: 0.58rem; }
    .lib-card-badge { font-size: 0.52rem; padding: 2px 6px; top: 6px; left: 6px; }
    .lib-card-remove { width: 22px; height: 22px; top: 6px; right: 6px; }
    .lib-card-remove svg { width: 10px; height: 10px; }
    .lib-card-play { width: 38px; height: 38px; }
    .lib-card-play svg { width: 16px; height: 16px; }
    .lib-card-noimg { font-size: 2rem; }
  }
</style>
