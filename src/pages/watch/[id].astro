---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { id } = Astro.params;
---

<BaseLayout title="Watch Video">
  <Header slot="header" />
  
  <div class="watch-wrap">
    <div id="watchLoader" class="watch-loader">
      <div class="wl-spinner"></div>
      <p>Loading video...</p>
    </div>
    
    <div id="watchContent" style="display:none;">
      <div class="container">
        <div class="watch-player-wrap">
          <div id="watchPlayer" class="watch-player"></div>
        </div>
        
        <div class="watch-info">
          <div class="watch-badges" id="watchBadges"></div>
          <h1 class="watch-title" id="watchTitle">Loading...</h1>
          <div class="watch-meta" id="watchMeta"></div>
        </div>
      </div>
      
      <section class="section-block">
        <div class="container">
          <h2 class="section-title"><span class="grad-text">More Videos</span></h2>
          <div id="watchRelated" class="watch-related-grid"></div>
        </div>
      </section>
    </div>
    
    <div id="watchNotFound" style="display:none;padding:6rem 1rem;text-align:center;">
      <h1 style="font-size:2rem;color:var(--text-primary);">Video Not Found</h1>
      <p style="color:var(--text-muted);margin:1rem 0;">This video is no longer available.</p>
      <a href="/" class="btn btn-grad">← Back to Homepage</a>
    </div>
  </div>
  
  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('watchLoader');
  var content = document.getElementById('watchContent');
  var notFound = document.getElementById('watchNotFound');
  var player = document.getElementById('watchPlayer');
  var titleEl = document.getElementById('watchTitle');
  var metaEl = document.getElementById('watchMeta');
  var badgesEl = document.getElementById('watchBadges');
  var relatedEl = document.getElementById('watchRelated');
  
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  
  function trunc(s, n) {
    s = String(s || '');
    return s.length > n ? s.slice(0, n).trim() + '…' : s;
  }
  
  // Try to find video from social feed
  try {
    // Fetch all types and search for this video
    var types = ['all'];
    var found = null;
    var allVideos = [];
    
    for (var i = 0; i < 3; i++) {
      var res = await fetch('/api/social-feed?type=all&page=' + (i + 1) + '&limit=30');
      var data = await res.json();
      if (data.success && data.videos) {
        allVideos = allVideos.concat(data.videos);
        found = data.videos.find(function(v) { return v.id === id; });
        if (found) break;
      }
    }
    
    if (!found) {
      loader.style.display = 'none';
      notFound.style.display = 'block';
      return;
    }
    
    // Render video
    document.title = found.title + ' — AniTube Buzz';
    
    var iframe = document.createElement('iframe');
    iframe.src = found.embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
    player.appendChild(iframe);
    
    titleEl.textContent = found.title;
    
    var typeLabel = { movies: '🎬 MOVIE', kdrama: '🇰🇷 K-DRAMA', donghua: '🐼 DONGHUA', anime: '🎌 ANIME' }[found.type] || '📺';
    var sourceLabel = { youtube: 'YouTube', dailymotion: 'Dailymotion', bilibili: 'Bilibili', odysee: 'Odysee' }[found.source] || 'Video';
    
    badgesEl.innerHTML = 
      '<span class="wb wb-type">' + typeLabel + '</span>' +
      '<span class="wb wb-source">' + esc(sourceLabel) + '</span>' +
      (found.isNew ? '<span class="wb wb-new">NEW</span>' : '');
    
    metaEl.innerHTML = 
      '<span>👤 ' + esc(found.channel || 'Unknown') + '</span>' +
      (found.publishedAt ? '<span>📅 ' + new Date(found.publishedAt).toLocaleDateString() : '');
    
    // Related videos (other videos except this one)
    var related = allVideos.filter(function(v) { return v.id !== found.id; }).slice(0, 12);
    relatedEl.innerHTML = related.map(function(v) {
      var img = v.thumbnail 
        ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />'
        : '<div style="width:100%;height:100%;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:2rem;">📺</div>';
      var srcColor = { youtube: '#ff0000', dailymotion: '#0066dc', bilibili: '#00a1d6' }[v.source] || '#c084fc';
      var srcLabel = { youtube: 'YT', dailymotion: 'DM', bilibili: 'BILI' }[v.source] || 'V';
      return '<a href="/watch/' + encodeURIComponent(v.id) + '" class="wr-card">' +
        '<div class="wr-thumb">' + img + '<div class="wr-src" style="background:' + srcColor + '">' + srcLabel + '</div></div>' +
        '<div class="wr-title">' + esc(trunc(v.title, 60)) + '</div>' +
        '<div class="wr-channel">' + esc(v.channel || '') + '</div>' +
      '</a>';
    }).join('');
    
    loader.style.display = 'none';
    content.style.display = 'block';
  } catch(e) {
    console.error('watch error:', e);
    loader.style.display = 'none';
    notFound.style.display = 'block';
  }
})();
</script>

<style>
  .watch-wrap { min-height: 100vh; }
  .watch-loader { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 6rem 1rem; }
  .wl-spinner { width: 40px; height: 40px; border: 3px solid rgba(192,132,252,0.2); border-top-color: #c084fc; border-radius: 50%; animation: wlSpin 0.8s linear infinite; margin-bottom: 1rem; }
  @keyframes wlSpin { to { transform: rotate(360deg); } }
  .watch-loader p { color: var(--text-muted); }
  
  .watch-player-wrap { padding: 2rem 0 1rem; }
  .watch-player { position: relative; width: 100%; padding-top: 56.25%; background: #000; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  
  .watch-info { padding: 1.5rem 0; }
  .watch-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1rem; }
  .wb { padding: 4px 10px; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.05em; }
  .wb-type { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .wb-source { background: rgba(192,132,252,0.15); color: #c084fc; border: 1px solid rgba(192,132,252,0.3); }
  .wb-new { background: linear-gradient(135deg,#ef4444,#f97316); color: #fff; }
  
  .watch-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: clamp(1.3rem, 2.5vw, 1.8rem); font-weight: 800; color: var(--text-primary); margin: 0 0 0.75rem; letter-spacing: -0.02em; line-height: 1.2; }
  .watch-meta { display: flex; gap: 1rem; flex-wrap: wrap; color: var(--text-muted); font-size: 0.85rem; font-family: 'JetBrains Mono', monospace; }
  
  .watch-related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  @media (max-width: 1024px) { .watch-related-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) { .watch-related-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  
  .wr-card { text-decoration: none; color: inherit; display: block; transition: transform 0.3s ease; }
  .wr-card:hover { transform: translateY(-5px); }
  .wr-thumb { position: relative; width: 100%; padding-top: 56.25%; background: #000; border-radius: 12px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(192,132,252,0.2); }
  .wr-thumb > img { position: absolute; top: 0; left: 0; }
  .wr-src { position: absolute; top: 6px; right: 6px; padding: 3px 7px; color: #fff; font-family: 'JetBrains Mono', monospace; font-size: 0.55rem; font-weight: 800; border-radius: 4px; }
  .wr-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 4px; }
  .wr-channel { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; color: var(--text-muted); }
</style>
