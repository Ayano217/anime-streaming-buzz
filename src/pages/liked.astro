---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Liked Videos | AniTubeBuzz" description="Videos you have liked">
  <Header slot="header" />
  
  <div class="lib-page">
    <div class="container">
      
      <div class="lib-hero">
        <div class="lib-hero-icon-wrap">
          <div class="lib-hero-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
        </div>
        <div class="lib-hero-content">
          <div class="lib-hero-eyebrow">MY LIBRARY</div>
          <h1 class="lib-title">Liked Videos</h1>
          <p class="lib-subtitle" id="libSubtitle">Loading...</p>
        </div>
        <button class="lib-clear-btn" id="libClearBtn" style="display:none">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
          </svg>
          <span>Clear All</span>
        </button>
      </div>
      
      <div id="libGrid" class="lib-grid"></div>
      
      <div id="libEmpty" class="lib-empty" style="display:none">
        <div class="lib-empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h2 class="lib-empty-title">No Liked Videos Yet</h2>
        <p class="lib-empty-desc">Double-tap videos to show some love ❤️</p>
        <a href="/" class="lib-empty-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          Discover Videos
        </a>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  var grid = document.getElementById('libGrid');
  var empty = document.getElementById('libEmpty');
  var subtitle = document.getElementById('libSubtitle');
  var clearBtn = document.getElementById('libClearBtn');
  
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  
  function typeLabel(t) {
    var map = { anime: 'Anime', kdrama: 'K-Drama', donghua: 'Donghua', movies: 'Movie' };
    return map[t] || 'Anime';
  }
  
  function render() {
    var likedIds = [];
    try { likedIds = JSON.parse(localStorage.getItem('anitube_liked') || '[]'); } catch(e) {}
    
    // Merge metadata from history/saved
    var history = [], saved = [];
    try { history = JSON.parse(localStorage.getItem('anitube_history') || '[]'); } catch(e) {}
    try { saved = JSON.parse(localStorage.getItem('anitube_saved') || '[]'); } catch(e) {}
    
    var lookup = {};
    history.forEach(function(v) { lookup[v.id] = v; });
    saved.forEach(function(v) { if (!lookup[v.id]) lookup[v.id] = v; });
    
    if (!likedIds.length) {
      grid.style.display = 'none';
      empty.style.display = 'flex';
      subtitle.textContent = 'Nothing here yet';
      clearBtn.style.display = 'none';
      return;
    }
    
    empty.style.display = 'none';
    grid.style.display = 'grid';
    subtitle.textContent = likedIds.length + ' ' + (likedIds.length === 1 ? 'video' : 'videos');
    clearBtn.style.display = 'inline-flex';
    
    var html = '';
    likedIds.forEach(function(id, i) {
      var v = lookup[id] || { id: id, title: 'Video', channel: 'AniTube', thumbnail: '', type: 'anime' };
      var title = esc(v.title || 'Untitled');
      var channel = esc(v.channel || 'AniTube');
      var thumb = v.thumbnail || '';
      var initial = channel.charAt(0).toUpperCase();
      var type = typeLabel(v.type);
      var delay = Math.min(i * 20, 400);
      
      html += '<a href="/reels/' + encodeURIComponent(id) + '" class="lib-card" style="animation-delay:' + delay + 'ms">' +
        '<div class="lib-card-thumb">' +
          (thumb ? '<img src="' + esc(thumb) + '" alt="" loading="lazy"/>' : '<div class="lib-card-noimg">' + initial + '</div>') +
          '<div class="lib-card-overlay"></div>' +
          '<div class="lib-card-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>' +
          '<div class="lib-card-type">' + type + '</div>' +
          '<div class="lib-card-heart"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>' +
          '<button class="lib-card-remove" data-id="' + esc(id) + '" aria-label="Unlike">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>' +
          '</button>' +
        '</div>' +
        '<div class="lib-card-info">' +
          '<div class="lib-card-title">' + title + '</div>' +
          '<div class="lib-card-meta">@' + channel.replace(/\s+/g,'').toLowerCase() + '</div>' +
        '</div>' +
      '</a>';
    });
    grid.innerHTML = html;
    
    grid.querySelectorAll('.lib-card-remove').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('data-id');
        var arr = [];
        try { arr = JSON.parse(localStorage.getItem('anitube_liked') || '[]'); } catch(e) {}
        arr = arr.filter(function(x) { return x !== id; });
        localStorage.setItem('anitube_liked', JSON.stringify(arr));
        render();
      });
    });
  }
  
  clearBtn.addEventListener('click', function() {
    if (confirm('Remove all likes?')) {
      localStorage.removeItem('anitube_liked');
      render();
    }
  });
  
  render();
})();
</script>

<style>
  .lib-page { min-height: calc(100vh - var(--header-h) - 100px); padding: 2rem 0 5rem; }
  
  .lib-hero {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 26px 30px;
    background: 
      linear-gradient(135deg, rgba(236, 72, 153, 0.08), rgba(232, 121, 249, 0.05)),
      linear-gradient(180deg, rgba(28, 15, 61, 0.7), rgba(20, 10, 40, 0.8));
    border: 1px solid rgba(236, 72, 153, 0.35);
    border-radius: 28px;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }
  
  .lib-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(236, 72, 153, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  
  [data-theme="light"] .lib-hero {
    background: 
      linear-gradient(135deg, rgba(236, 72, 153, 0.05), rgba(232, 121, 249, 0.03)),
      linear-gradient(180deg, #ffffff, #fdf2f8);
    border-color: rgba(236, 72, 153, 0.2);
  }
  
  .lib-hero-icon-wrap { position: relative; flex-shrink: 0; }
  
  .lib-hero-icon-wrap::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: linear-gradient(135deg, #ec4899, #e879f9);
    border-radius: 20px;
    opacity: 0.4;
    filter: blur(12px);
  }
  
  .lib-hero-icon {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: linear-gradient(135deg, #ec4899, #f472b6, #e879f9);
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 8px 24px rgba(236, 72, 153, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  
  .lib-hero-content { flex: 1; min-width: 0; position: relative; z-index: 1; }
  
  .lib-hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #f472b6;
    letter-spacing: 0.15em;
    margin-bottom: 4px;
  }
  
  .lib-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 6px;
    background: linear-gradient(135deg, #ec4899, #e879f9, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  
  .lib-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    font-weight: 500;
  }
  
  .lib-clear-btn {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 100px;
    color: #ef4444;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  
  .lib-clear-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
  }
  
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.4rem;
  }
  
  @media (max-width: 1200px) { .lib-grid { grid-template-columns: repeat(4, 1fr); gap: 1.2rem; } }
  @media (max-width: 900px) { .lib-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }
  @media (max-width: 640px) { .lib-grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; } }
  
  .lib-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.25s ease, box-shadow 0.35s ease;
    animation: lib-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    display: block;
    position: relative;
    will-change: transform;
  }
  
  @keyframes lib-in {
    from { opacity: 0; transform: translateY(15px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .lib-card:hover {
    transform: translateY(-8px);
    border-color: rgba(236, 72, 153, 0.55);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.35), 0 0 30px rgba(236, 72, 153, 0.25);
  }
  
  .lib-card-thumb {
    position: relative;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(232, 121, 249, 0.1));
    overflow: hidden;
  }
  
  .lib-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
  .lib-card:hover .lib-card-thumb img { transform: scale(1.1); }
  
  .lib-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lib-card:hover .lib-card-overlay { opacity: 1; }
  
  .lib-card-noimg {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 3.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ec4899, #f472b6, #e879f9);
    color: white;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
  
  .lib-card-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    width: 56px; height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ec4899, #f472b6, #e879f9);
    display: flex; align-items: center; justify-content: center;
    color: white;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 10px 35px rgba(236, 72, 153, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    pointer-events: none;
  }
  .lib-card-play svg { width: 24px; height: 24px; margin-left: 3px; }
  
  .lib-card:hover .lib-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  
  .lib-card-type {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border-radius: 6px;
    border: 1px solid rgba(236, 72, 153, 0.5);
    text-transform: uppercase;
  }
  
  .lib-card-heart {
    position: absolute;
    bottom: 10px;
    left: 10px;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: linear-gradient(135deg, #ec4899, #f472b6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 14px rgba(236, 72, 153, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    z-index: 2;
  }
  .lib-card-heart svg { width: 16px; height: 16px; }
  
  .lib-card-remove {
    position: absolute;
    top: 10px; right: 10px;
    width: 30px; height: 30px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(239, 68, 68, 0.5);
    color: #ef4444;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: all 0.25s;
    padding: 0;
    z-index: 5;
  }
  .lib-card-remove svg { width: 13px; height: 13px; }
  .lib-card:hover .lib-card-remove { opacity: 1; }
  .lib-card-remove:hover {
    background: rgba(239, 68, 68, 0.95);
    color: white;
    transform: scale(1.12);
  }
  
  .lib-card-info { padding: 13px 15px 15px; }
  
  .lib-card-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.25s ease;
    letter-spacing: -0.005em;
  }
  
  .lib-card:hover .lib-card-title {
    background: linear-gradient(135deg, #ec4899, #e879f9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .lib-card-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .lib-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    min-height: 500px;
  }
  
  .lib-empty-icon {
    width: 110px; height: 110px;
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.12), rgba(232, 121, 249, 0.08));
    display: flex; align-items: center; justify-content: center;
    color: rgba(236, 72, 153, 0.6);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(236, 72, 153, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  
  .lib-empty-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  
  .lib-empty-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 380px;
    margin: 0 0 1.8rem;
    line-height: 1.6;
  }
  
  .lib-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: linear-gradient(135deg, #ec4899, #f472b6, #e879f9);
    color: white;
    border-radius: 100px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 10px 30px rgba(236, 72, 153, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .lib-empty-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(236, 72, 153, 0.65);
  }
  
  @media (max-width: 640px) {
    .lib-hero { padding: 18px 20px; gap: 14px; border-radius: 22px; flex-wrap: wrap; }
    .lib-hero-icon { width: 48px; height: 48px; border-radius: 14px; }
    .lib-hero-icon svg { width: 24px; height: 24px; }
    .lib-clear-btn { padding: 7px 12px; font-size: 0.72rem; }
    .lib-card-info { padding: 11px 12px 13px; }
    .lib-card-title { font-size: 0.85rem; }
    .lib-card-meta { font-size: 0.62rem; }
    .lib-card-type { font-size: 0.55rem; padding: 3px 8px; }
    .lib-card-heart { width: 28px; height: 28px; border-radius: 8px; }
    .lib-card-heart svg { width: 14px; height: 14px; }
  }
</style>
