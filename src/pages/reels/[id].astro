---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Reels" description="Instagram-style shorts on AniTube Buzz.">

  <div class="rp-app">

    <!-- LOADER -->
    <div id="rpLoader" class="rp-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p>Loading reels...</p>
    </div>

    <!-- NOT FOUND -->
    <div id="rpNotFound" class="rp-nf" style="display:none;">
      <div class="nf-ic">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </div>
      <h1>No Reels Available</h1>
      <p>No portrait shorts found.</p>
      <a href="/" class="nf-bk">← Back to Homepage</a>
    </div>

    <!-- MAIN LAYOUT -->
    <div id="rpMain" class="rp-main" style="display:none;">

      <!-- TOP BAR -->
      <div class="rp-top">
        <button class="rp-icon-btn" id="rpBack" aria-label="Back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <div class="rp-brand">
          <span class="rp-brand-grad">Ani</span><span class="rp-brand-w">Tube</span><span class="rp-brand-grad">Buzz</span>
        </div>
        <div class="rp-menu-wrap">
          <button class="rp-icon-btn" id="rpMenuBtn" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
          </button>
          <div class="rp-menu" id="rpMenu">
            <button class="rp-menu-item" data-action="copy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Link</span>
            </button>
            <button class="rp-menu-item" data-action="report">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              <span>Not Interested</span>
            </button>
          </div>
        </div>
      </div>

      <!-- LEFT: UP/DOWN NAV ARROWS -->
      <div class="rp-nav-arrows">
        <button class="rp-nav-btn" id="rpNavUp" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 15l-6-6-6 6"/></svg>
        </button>
        <button class="rp-nav-btn" id="rpNavDown" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>

      <!-- CENTER: VERTICAL VIDEO SCROLLER -->
      <div id="rpScroller" class="rp-scroller"></div>

      <!-- RIGHT: SIDE DETAILS PANEL (desktop only) -->
      <aside id="rpSidebar" class="rp-sidebar">
        <div class="rp-side-inner">
          <div class="rp-side-head">
            <div class="rp-side-avatar" id="rpSideAvatar">▶</div>
            <div class="rp-side-user">
              <div class="rp-side-username" id="rpSideChannel">Loading...</div>
              <div class="rp-side-type" id="rpSideType">VIDEO</div>
            </div>
          </div>
          <h2 class="rp-side-title" id="rpSideTitle">Loading...</h2>
          <div class="rp-side-meta" id="rpSideMeta"></div>
          <p class="rp-side-desc" id="rpSideDesc"></p>

          <div class="rp-side-actions">
            <button class="rp-side-btn rp-side-btn-p" id="rpSideSave">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              <span id="rpSideSaveLabel">Save</span>
            </button>
            <button class="rp-side-btn rp-side-btn-s" id="rpSideShare">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
              <span>Share</span>
            </button>
          </div>

          <div class="rp-side-related">
            <div class="rp-side-related-head">
              <span>UP NEXT</span>
            </div>
            <div class="rp-side-related-list" id="rpSideRelated"></div>
          </div>
        </div>
      </aside>

      <!-- BOTTOM: SIDE PROGRESS -->
      <div id="rpProgress" class="rp-progress">
        <div class="rp-progress-count" id="rpProgressCount">1 / 1</div>
      </div>

      <!-- HINT -->
      <div id="rpHint" class="rp-hint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        <span>Swipe up for next</span>
      </div>

    </div>

    <!-- TOAST -->
    <div id="rpToast" class="rp-toast"></div>

  </div>

</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('rpLoader');
  var notFound = document.getElementById('rpNotFound');
  var main = document.getElementById('rpMain');
  var scroller = document.getElementById('rpScroller');
  var progress = document.getElementById('rpProgress');
  var progressCount = document.getElementById('rpProgressCount');
  var hint = document.getElementById('rpHint');
  var back = document.getElementById('rpBack');
  var menuBtn = document.getElementById('rpMenuBtn');
  var menu = document.getElementById('rpMenu');
  var toast = document.getElementById('rpToast');
  var navUp = document.getElementById('rpNavUp');
  var navDown = document.getElementById('rpNavDown');

  // Sidebar els
  var sideChannel = document.getElementById('rpSideChannel');
  var sideType = document.getElementById('rpSideType');
  var sideTitle = document.getElementById('rpSideTitle');
  var sideMeta = document.getElementById('rpSideMeta');
  var sideDesc = document.getElementById('rpSideDesc');
  var sideSave = document.getElementById('rpSideSave');
  var sideSaveLabel = document.getElementById('rpSideSaveLabel');
  var sideShare = document.getElementById('rpSideShare');
  var sideRelated = document.getElementById('rpSideRelated');

  var allVideos = [];
  var currentIdx = 0;
  var hintTimeout = null;
  var likedSet = new Set();

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}
  function fmt(d){try{if(!d)return'';var x=new Date(d);if(isNaN(x.getTime()))return'';return x.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}catch(e){return'';}}
  function cap(s){try{if(!s)return'';var str=String(s).replace(/_/g,' ');return str.charAt(0).toUpperCase()+str.slice(1);}catch(e){return String(s||'');}}

  // ═══ TOAST ═══
  function showToast(msg, icon) {
    toast.innerHTML = '<span class="rp-toast-ic">' + (icon || '✓') + '</span><span>' + esc(msg) + '</span>';
    toast.classList.add('rp-toast-show');
    setTimeout(function() { toast.classList.remove('rp-toast-show'); }, 2200);
  }

  // ═══ BACK ═══
  function smartGoBack() {
    var ref = document.referrer;
    var thisOrigin = window.location.origin;
    if (ref && ref.indexOf(thisOrigin) === 0 && ref !== window.location.href) {
      window.history.back();
    } else if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '/';
    }
  }
  back.addEventListener('click', smartGoBack);

  // ═══ MENU ═══
  menuBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    menu.classList.toggle('rp-menu-open');
  });
  document.addEventListener('click', function(e) {
    if (!menuBtn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.remove('rp-menu-open');
    }
  });
  menu.addEventListener('click', function(e) {
    var btn = e.target.closest('.rp-menu-item');
    if (!btn) return;
    var action = btn.dataset.action;
    if (action === 'copy') {
      try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
    } else if (action === 'report') {
      showToast('We\'ll show less of this', '🔕');
    }
    menu.classList.remove('rp-menu-open');
  });

  // ═══ NAV ARROWS ═══
  function scrollToSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (slot) slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  navUp.addEventListener('click', function() { scrollToSlot(currentIdx - 1); });
  navDown.addEventListener('click', function() { scrollToSlot(currentIdx + 1); });

  // ═══ KEYBOARD ═══
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      scrollToSlot(currentIdx + 1);
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      scrollToSlot(currentIdx - 1);
    } else if (e.key === 'Escape') {
      smartGoBack();
    } else if (e.key === 'm' || e.key === 'M') {
      toggleMuteCurrent();
    }
  });

  // ═══ SAVE / LIKE ═══
  function isVideoSaved(vid) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      return saved.some(function(x) { return x.id === vid; });
    } catch(e) { return false; }
  }
  function toggleSave(video, actionBtn) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      var idx = saved.findIndex(function(x) { return x.id === video.id; });
      if (idx >= 0) {
        saved.splice(idx, 1);
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (actionBtn) actionBtn.classList.remove('rp-saved');
        updateSideActions(video);
        showToast('Removed', '✕');
      } else {
        saved.push({
          id: video.id, title: video.title, thumbnail: video.thumbnail,
          channel: video.channel, type: video.type, savedAt: Date.now()
        });
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (actionBtn) actionBtn.classList.add('rp-saved');
        updateSideActions(video);
        showToast('Saved to library', '✓');
        notifySafiya('save', video);
      }
    } catch(e) {}
  }
  function toggleLike(video, btn) {
    if (likedSet.has(video.id)) {
      likedSet.delete(video.id);
      if (btn) btn.classList.remove('rp-liked');
    } else {
      likedSet.add(video.id);
      if (btn) btn.classList.add('rp-liked');
      showToast('Loved it 💜', '💜');
    }
  }
  function updateSideActions(video) {
    if (!sideSaveLabel) return;
    sideSaveLabel.textContent = isVideoSaved(video.id) ? 'Saved' : 'Save';
  }

  // ═══ SAFIYA ═══
  function notifySafiya(type, video) {
    try {
      var deviceId = '';
      try { deviceId = localStorage.getItem('safiya_v13:device_id') || ''; } catch(e) {}
      var memoryKey = deviceId ? 'safiya_v13:memory:' + deviceId : null;
      var memRaw = null;
      if (memoryKey) memRaw = localStorage.getItem(memoryKey);
      if (!memRaw) memRaw = localStorage.getItem('safiya_memory');
      var memory = memRaw ? JSON.parse(memRaw) : {};
      if (!memory.behavior) memory.behavior = {};
      if (!memory.behavior.watchHistory) memory.behavior.watchHistory = [];
      if (!memory.behavior.savedVideos) memory.behavior.savedVideos = [];

      var record = {
        id: video.id, title: video.title, type: video.type || 'video',
        channel: video.channel || '', source: video.source || '',
        time: Date.now(), action: type
      };
      if (type === 'save') {
        memory.behavior.savedVideos.unshift(record);
        memory.behavior.savedVideos = memory.behavior.savedVideos.slice(0, 40);
      } else {
        memory.behavior.watchHistory.unshift(record);
        memory.behavior.watchHistory = memory.behavior.watchHistory.slice(0, 40);
      }
      memory.behavior.currentlyWatching = record;
      if (memoryKey) localStorage.setItem(memoryKey, JSON.stringify(memory));
      localStorage.setItem('safiya_memory', JSON.stringify(memory));

      window.dispatchEvent(new CustomEvent('safiya:video-event', {
        detail: { action: type, video: video, title: video.title, type: video.type }
      }));

      if (window.Safiya && typeof window.Safiya.say === 'function') {
        var lines = {
          save: ['saved that? nice pick', 'good taste bestie', 'adding to your library 💜'],
          watch: ['ooh nice reel', 'the vibes ✨', 'obsessed with this one', 'this one hits different']
        };
        var msgList = type === 'save' ? lines.save : lines.watch;
        setTimeout(function() {
          window.Safiya.say(msgList[Math.floor(Math.random() * msgList.length)], 3800);
        }, 500);
      }
    } catch(err) {}
  }

  // ═══ BUILD SLOT (Instagram-exact center layout) ═══
  function buildSlot(video, idx) {
    var slot = document.createElement('div');
    slot.className = 'rp-slot';
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;

    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="rp-slot-bg" loading="lazy" />' : '';

    slot.innerHTML =
      thumb +
      '<div class="rp-slot-tint"></div>' +
      // Video wrapper (center)
      '<div class="rp-slot-wrap">' +
        '<div class="rp-slot-frame">' +
          '<div class="rp-slot-video" data-loaded="0"></div>' +
          '<div class="rp-slot-loading"><div class="rp-slot-spinner"></div></div>' +
          // Bottom gradient inside frame
          '<div class="rp-slot-gradient"></div>' +
          // Bottom info OVERLAY (Instagram style, inside frame bottom)
          '<div class="rp-slot-info">' +
            '<div class="rp-slot-user">' +
              '<div class="rp-slot-avatar"><div class="rp-slot-avatar-inner">▶</div></div>' +
              '<div class="rp-slot-username">' + esc(video.channel || 'AniTube') + '</div>' +
              '<button class="rp-follow">Follow</button>' +
            '</div>' +
            '<div class="rp-slot-caption">' + esc(trunc(video.title || 'Video', 100)) + '</div>' +
          '</div>' +
        '</div>' +
        // RIGHT ACTION BAR (attached to video frame)
        '<div class="rp-actions" data-idx="' + idx + '">' +
          '<button class="rp-action" data-act="like" aria-label="Like">' +
            '<div class="rp-action-ic">' +
              '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
            '</div>' +
            '<span class="rp-action-lbl">Like</span>' +
          '</button>' +
          '<button class="rp-action" data-act="comment" aria-label="Comment">' +
            '<div class="rp-action-ic">' +
              '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
            '</div>' +
            '<span class="rp-action-lbl">Comment</span>' +
          '</button>' +
          '<button class="rp-action" data-act="share" aria-label="Share">' +
            '<div class="rp-action-ic">' +
              '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>' +
            '</div>' +
            '<span class="rp-action-lbl">Share</span>' +
          '</button>' +
          '<button class="rp-action rp-action-save' + (isVideoSaved(video.id) ? ' rp-saved' : '') + '" data-act="save" aria-label="Save">' +
            '<div class="rp-action-ic">' +
              '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
            '</div>' +
            '<span class="rp-action-lbl">Save</span>' +
          '</button>' +
          '<button class="rp-action rp-action-mute" data-act="mute" aria-label="Toggle sound">' +
            '<div class="rp-action-ic">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>' +
            '</div>' +
            '<span class="rp-action-lbl">Sound</span>' +
          '</button>' +
        '</div>' +
      '</div>';

    // Bind actions
    var actions = slot.querySelectorAll('.rp-action');
    actions.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var act = btn.dataset.act;
        if (act === 'like') toggleLike(video, btn);
        else if (act === 'save') toggleSave(video, btn);
        else if (act === 'comment') showToast('Comments coming soon', '💬');
        else if (act === 'share') {
          try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
        } else if (act === 'mute') {
          toggleMuteCurrent();
        }
      });
    });

    return slot;
  }

  // ═══ LOAD IFRAME ═══
  function loadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded === '1') return;
    videoDiv.dataset.loaded = '1';

    var video = allVideos[idx];
    if (!video || !video.embedUrl) return;

    var embedUrl = video.embedUrl;
    if (video.source === 'youtube' || video.source === 'youtube_shorts') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0&playsinline=1&loop=1&playlist=' + (video.videoId || '');
    } else if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&ui-logo=0';
    }

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');
    iframe.onload = function() {
      if (loading) loading.style.opacity = '0';
      setTimeout(function() { if (loading) loading.style.display = 'none'; }, 400);
    };
    videoDiv.appendChild(iframe);
  }

  function unloadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded !== '1') return;
    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    if (loading) { loading.style.display = 'flex'; loading.style.opacity = '1'; }
  }

  function toggleMuteCurrent() {
    var slot = scroller.querySelector('[data-idx="' + currentIdx + '"]');
    if (!slot) return;
    var iframe = slot.querySelector('.rp-slot-video iframe');
    if (!iframe) return;
    var currentSrc = iframe.src;
    var isMuted = /[?&]mute=1/.test(currentSrc);
    var newSrc = isMuted
      ? currentSrc.replace(/([?&])mute=1/g, '$1mute=0')
      : currentSrc.replace(/([?&])mute=0/g, '$1mute=1');
    iframe.src = newSrc;
    showToast(isMuted ? 'Sound on' : 'Muted', isMuted ? '🔊' : '🔇');
  }

  // ═══ UPDATE SIDEBAR ═══
  function updateSidebar(video) {
    if (!video) return;
    if (sideChannel) sideChannel.textContent = video.channel || 'AniTube';
    if (sideType) sideType.textContent = (video.type || 'video').toUpperCase();
    if (sideTitle) sideTitle.textContent = video.title || 'Untitled';

    var meta = [];
    if (video.publishedAt) { var d = fmt(video.publishedAt); if (d) meta.push(d); }
    if (video.isNew) meta.push('NEW');
    if (video.isOfficial) meta.push('OFFICIAL');
    if (sideMeta) sideMeta.innerHTML = meta.map(function(m) { return '<span class="rp-meta-pill">' + esc(m) + '</span>'; }).join('');

    if (sideDesc) sideDesc.textContent = video.description || 'Enjoy this ' + (video.type || 'video') + ' on AniTubeBuzz.';

    updateSideActions(video);

    // Related list (next 5 videos)
    if (sideRelated) {
      var next = [];
      for (var i = 1; i <= 6; i++) {
        var idx = (currentIdx + i) % allVideos.length;
        if (idx !== currentIdx && allVideos[idx]) next.push({ video: allVideos[idx], idx: idx });
      }
      sideRelated.innerHTML = next.slice(0, 5).map(function(item) {
        var v = item.video;
        var thumb = v.thumbnail ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" />' : '<div style="width:100%;height:100%;background:linear-gradient(135deg,#c084fc,#e879f9);"></div>';
        return '<div class="rp-side-rel-item" data-idx="' + item.idx + '">' +
          '<div class="rp-side-rel-thumb">' + thumb + '</div>' +
          '<div class="rp-side-rel-info">' +
            '<div class="rp-side-rel-title">' + esc(trunc(v.title || 'Video', 60)) + '</div>' +
            '<div class="rp-side-rel-ch">' + esc(v.channel || 'Channel') + '</div>' +
          '</div>' +
        '</div>';
      }).join('');

      sideRelated.querySelectorAll('.rp-side-rel-item').forEach(function(el) {
        el.addEventListener('click', function() {
          var idx = parseInt(el.dataset.idx);
          if (!isNaN(idx)) scrollToSlot(idx);
        });
      });
    }
  }

  // Sidebar button handlers
  if (sideSave) sideSave.addEventListener('click', function() {
    var v = allVideos[currentIdx];
    if (v) toggleSave(v);
  });
  if (sideShare) sideShare.addEventListener('click', function() {
    try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
  });

  // ═══ SET CURRENT ═══
  var currentNotifyTimeout = null;
  function setCurrentIdx(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length || newIdx === currentIdx) return;
    currentIdx = newIdx;

    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' · AniTubeBuzz';
      }
    } catch(e) {}

    for (var i = 0; i < allVideos.length; i++) {
      if (Math.abs(i - newIdx) <= 1) loadVideoInSlot(i);
      else if (Math.abs(i - newIdx) > 2) unloadVideoInSlot(i);
    }

    updateSidebar(allVideos[newIdx]);
    updateProgress();

    clearTimeout(currentNotifyTimeout);
    currentNotifyTimeout = setTimeout(function() {
      if (allVideos[newIdx]) notifySafiya('watch', allVideos[newIdx]);
    }, 2000);
  }

  function updateProgress() {
    if (!progress || !allVideos.length) return;
    if (progressCount) progressCount.textContent = (currentIdx + 1) + ' / ' + allVideos.length;
  }

  // ═══ OBSERVER ═══
  var slotObserver = null;
  function setupObserver() {
    if (slotObserver) slotObserver.disconnect();
    slotObserver = new IntersectionObserver(function(entries) {
      var mostVisible = null, maxRatio = 0;
      entries.forEach(function(entry) {
        if (entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          mostVisible = entry.target;
        }
      });
      if (mostVisible && maxRatio > 0.6) {
        var idx = parseInt(mostVisible.dataset.idx);
        if (!isNaN(idx) && idx !== currentIdx) setCurrentIdx(idx);
      }
    }, { root: scroller, threshold: [0.3, 0.6, 0.9] });

    scroller.querySelectorAll('.rp-slot').forEach(function(s) { slotObserver.observe(s); });
  }

  // ═══ HINT ═══
  function scheduleHintHide() {
    hintTimeout = setTimeout(function() {
      if (hint) hint.classList.add('rp-hint-hide');
    }, 4000);
  }
  scroller.addEventListener('scroll', function() {
    if (hint && !hint.classList.contains('rp-hint-hide')) {
      hint.classList.add('rp-hint-hide');
      clearTimeout(hintTimeout);
    }
  }, { passive: true });

  // ═══ PORTRAIT DETECT ═══
  function isPortrait(video) {
    if (!video) return false;
    if (video.aspect === 'portrait') return true;
    if (video.source === 'youtube_shorts' || video.source === 'tiktok' || video.source === 'instagram') return true;
    if (video.isShort === true) return true;
    var title = (video.title || '').toLowerCase();
    if (/#shorts?\b|\bshorts?\b|\breels?\b/i.test(title)) return true;
    if (video.duration && video.duration > 0 && video.duration < 90) return true;
    return false;
  }

  // ═══ INIT ═══
  async function init() {
    try {
      var fetched = [];
      var found = null;

      try {
        var res1 = await fetch('/api/social-feed?format=portrait&page=1&limit=30');
        if (res1.ok) {
          var data1 = await res1.json();
          if (data1.success && data1.videos) fetched = fetched.concat(data1.videos);
        }
      } catch(e) {}

      for (var i = 1; i <= 2; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          if (!res.ok) continue;
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) found = data.videos.find(function(v) { return v.id === id; });
          }
        } catch(e) {}
      }

      if (!found) found = fetched.find(function(v) { return v.id === id; });

      var seen = {};
      var uniqueAll = fetched.filter(function(v) {
        if (!v || !v.id || seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });

      var portraitVideos = uniqueAll.filter(isPortrait);

      if (found && !portraitVideos.find(function(v) { return v.id === found.id; })) {
        portraitVideos.unshift(found);
      }

      if (portraitVideos.length === 0) {
        loader.style.display = 'none';
        notFound.style.display = 'flex';
        return;
      }

      if (found) {
        var idx = portraitVideos.findIndex(function(v) { return v.id === found.id; });
        if (idx > 0) {
          var arr = portraitVideos.splice(idx, 1);
          portraitVideos.unshift(arr[0]);
        }
      }

      allVideos = portraitVideos;

      scroller.innerHTML = '';
      allVideos.forEach(function(v, i) { scroller.appendChild(buildSlot(v, i)); });

      loader.style.display = 'none';
      main.style.display = 'block';
      if (hint) hint.classList.add('rp-hint-show');
      scheduleHintHide();

      currentIdx = -1;
      setCurrentIdx(0);
      setupObserver();

    } catch(err) {
      console.error('[Reels]', err);
      loader.style.display = 'none';
      notFound.style.display = 'flex';
    }
  }

  init();
})();
</script>

