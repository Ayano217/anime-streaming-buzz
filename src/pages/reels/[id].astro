---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Reels" description="Instagram-style shorts on AniTube Buzz.">

  <div id="rp-root" class="rp-root">

    <!-- LOADER -->
    <div id="rpLoader" class="rp-loader">
      <div class="rp-lo-orb">
        <div class="rp-lo-ring"></div>
        <div class="rp-lo-core"></div>
      </div>
      <p>Loading reels...</p>
    </div>

    <!-- NOT FOUND -->
    <div id="rpNotFound" class="rp-nf" style="display:none;">
      <div class="rp-nf-ic">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </div>
      <h1>No Reels Available</h1>
      <p>No portrait shorts found.</p>
      <a href="/" class="rp-nf-bk">← Back to Homepage</a>
    </div>

    <!-- TOP BAR -->
    <div id="rpTop" class="rp-top" style="display:none;">
      <button class="rp-top-btn" id="rpBack" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>
      <div class="rp-top-brand">
        <span class="rp-brand-grad">Ani</span><span class="rp-brand-w">Tube</span><span class="rp-brand-grad">Buzz</span>
      </div>
      <button class="rp-top-btn" id="rpMenu" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
        </svg>
      </button>
    </div>

    <!-- VERTICAL SCROLLER -->
    <div id="rpScroller" class="rp-scroller" style="display:none;"></div>

    <!-- COUNTER -->
    <div id="rpCounter" class="rp-counter" style="display:none;">1 / 1</div>

    <!-- TOAST -->
    <div id="rpToast" class="rp-toast"></div>

  </div>

</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('rpLoader');
  var notFound = document.getElementById('rpNotFound');
  var top = document.getElementById('rpTop');
  var scroller = document.getElementById('rpScroller');
  var counter = document.getElementById('rpCounter');
  var toast = document.getElementById('rpToast');
  var back = document.getElementById('rpBack');
  var menuBtn = document.getElementById('rpMenu');

  var allVideos = [];
  var currentIdx = 0;
  var likedSet = new Set();

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  // ═══ TOAST ═══
  function showToast(msg, icon) {
    if (!toast) return;
    toast.innerHTML = '<span class="rp-toast-ic">' + (icon || '✓') + '</span><span>' + esc(msg) + '</span>';
    toast.classList.add('rp-toast-show');
    setTimeout(function() { toast.classList.remove('rp-toast-show'); }, 2200);
  }

  // ═══ BACK ═══
  function smartGoBack() {
    var ref = document.referrer;
    var thisOrigin = window.location.origin;
    if (ref && ref.indexOf(thisOrigin) === 0 && ref !== window.location.href) {
      window.history.back();
    } else if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '/';
    }
  }
  if (back) back.addEventListener('click', smartGoBack);
  if (menuBtn) menuBtn.addEventListener('click', function() {
    try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
  });

  // ═══ KEYBOARD ═══
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      scrollToSlot(currentIdx + 1);
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      scrollToSlot(currentIdx - 1);
    } else if (e.key === 'Escape') {
      smartGoBack();
    }
  });

  function scrollToSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (slot) slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ═══ SAVE / LIKE ═══
  function isVideoSaved(vid) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      return saved.some(function(x) { return x.id === vid; });
    } catch(e) { return false; }
  }
  function toggleSave(video, btn) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      var idx = saved.findIndex(function(x) { return x.id === video.id; });
      if (idx >= 0) {
        saved.splice(idx, 1);
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (btn) btn.classList.remove('rp-active');
        showToast('Removed', '✕');
      } else {
        saved.push({
          id: video.id, title: video.title, thumbnail: video.thumbnail,
          channel: video.channel, type: video.type, savedAt: Date.now()
        });
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (btn) btn.classList.add('rp-active');
        showToast('Saved', '💜');
        notifySafiya('save', video);
      }
    } catch(e) {}
  }
  function toggleLike(video, btn) {
    if (likedSet.has(video.id)) {
      likedSet.delete(video.id);
      if (btn) btn.classList.remove('rp-liked');
    } else {
      likedSet.add(video.id);
      if (btn) btn.classList.add('rp-liked');
      showToast('Loved it 💜', '❤️');
    }
  }

  // ═══ SAFIYA ═══
  function notifySafiya(type, video) {
    try {
      var deviceId = '';
      try { deviceId = localStorage.getItem('safiya_v13:device_id') || ''; } catch(e) {}
      var memoryKey = deviceId ? 'safiya_v13:memory:' + deviceId : null;
      var memRaw = null;
      if (memoryKey) memRaw = localStorage.getItem(memoryKey);
      if (!memRaw) memRaw = localStorage.getItem('safiya_memory');
      var memory = memRaw ? JSON.parse(memRaw) : {};
      if (!memory.behavior) memory.behavior = {};
      if (!memory.behavior.watchHistory) memory.behavior.watchHistory = [];
      if (!memory.behavior.savedVideos) memory.behavior.savedVideos = [];

      var record = {
        id: video.id, title: video.title, type: video.type || 'video',
        channel: video.channel || '', source: video.source || '',
        time: Date.now(), action: type
      };
      if (type === 'save') {
        memory.behavior.savedVideos.unshift(record);
        memory.behavior.savedVideos = memory.behavior.savedVideos.slice(0, 40);
      } else {
        memory.behavior.watchHistory.unshift(record);
        memory.behavior.watchHistory = memory.behavior.watchHistory.slice(0, 40);
      }
      memory.behavior.currentlyWatching = record;
      if (memoryKey) localStorage.setItem(memoryKey, JSON.stringify(memory));
      localStorage.setItem('safiya_memory', JSON.stringify(memory));

      window.dispatchEvent(new CustomEvent('safiya:video-event', {
        detail: { action: type, video: video, title: video.title, type: video.type }
      }));

      if (window.Safiya && typeof window.Safiya.say === 'function') {
        var lines = {
          save: ['saved that? nice pick', 'good taste bestie', 'adding to your library 💜'],
          watch: ['ooh nice reel', 'the vibes ✨', 'obsessed with this one', 'this one hits different']
        };
        var msgList = type === 'save' ? lines.save : lines.watch;
        setTimeout(function() {
          window.Safiya.say(msgList[Math.floor(Math.random() * msgList.length)], 3800);
        }, 500);
      }
    } catch(err) {}
  }

  // ═══ BUILD SLOT ═══
  function buildSlot(video, idx) {
    var slot = document.createElement('div');
    slot.className = 'rp-slot';
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;

    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="rp-bg-img" loading="lazy" />' : '';

    slot.innerHTML =
      thumb +
      '<div class="rp-bg-tint"></div>' +
      '<div class="rp-stage">' +
        '<div class="rp-video-wrap">' +
          '<div class="rp-video" data-loaded="0"></div>' +
          '<div class="rp-spinner"><div class="rp-spinner-ring"></div></div>' +
          '<div class="rp-info-gradient"></div>' +
          '<div class="rp-info">' +
            '<div class="rp-user">' +
              '<div class="rp-avatar"><div class="rp-avatar-in">▶</div></div>' +
              '<div class="rp-username">' + esc(video.channel || 'AniTube') + '</div>' +
              '<button class="rp-follow">Follow</button>' +
            '</div>' +
            '<div class="rp-caption">' + esc(trunc(video.title || 'Video', 100)) + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="rp-actions">' +
          '<button class="rp-act" data-act="like" aria-label="Like">' +
            '<div class="rp-act-ic">' +
              '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
            '</div>' +
            '<span class="rp-act-lbl">Like</span>' +
          '</button>' +
          '<button class="rp-act" data-act="comment" aria-label="Comment">' +
            '<div class="rp-act-ic">' +
              '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
            '</div>' +
            '<span class="rp-act-lbl">Comment</span>' +
          '</button>' +
          '<button class="rp-act" data-act="share" aria-label="Share">' +
            '<div class="rp-act-ic">' +
              '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>' +
            '</div>' +
            '<span class="rp-act-lbl">Share</span>' +
          '</button>' +
          '<button class="rp-act' + (isVideoSaved(video.id) ? ' rp-active' : '') + '" data-act="save" aria-label="Save">' +
            '<div class="rp-act-ic">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
            '</div>' +
            '<span class="rp-act-lbl">Save</span>' +
          '</button>' +
        '</div>' +
      '</div>';

    slot.querySelectorAll('.rp-act').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var act = btn.dataset.act;
        if (act === 'like') toggleLike(video, btn);
        else if (act === 'save') toggleSave(video, btn);
        else if (act === 'comment') showToast('Comments coming soon', '💬');
        else if (act === 'share') {
          try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
        }
      });
    });

    return slot;
  }

  // ═══ LOAD IFRAME ═══
  function loadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-video');
    var spinner = slot.querySelector('.rp-spinner');
    if (!videoDiv || videoDiv.dataset.loaded === '1') return;
    videoDiv.dataset.loaded = '1';

    var video = allVideos[idx];
    if (!video || !video.embedUrl) return;

    var embedUrl = video.embedUrl;
    if (video.source === 'youtube' || video.source === 'youtube_shorts') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0&playsinline=1&loop=1&playlist=' + (video.videoId || '');
    } else if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&ui-logo=0&sharing-enable=0';
    }

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');
    iframe.onload = function() {
      if (spinner) spinner.style.opacity = '0';
      setTimeout(function() { if (spinner) spinner.style.display = 'none'; }, 400);
    };
    videoDiv.appendChild(iframe);
  }

  function unloadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-video');
    var spinner = slot.querySelector('.rp-spinner');
    if (!videoDiv || videoDiv.dataset.loaded !== '1') return;
    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    if (spinner) { spinner.style.display = 'flex'; spinner.style.opacity = '1'; }
  }

  // ═══ CURRENT ═══
  var notifyTimeout = null;
  function setCurrentIdx(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length || newIdx === currentIdx) return;
    currentIdx = newIdx;

    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' · AniTubeBuzz';
      }
    } catch(e) {}

    for (var i = 0; i < allVideos.length; i++) {
      if (Math.abs(i - newIdx) <= 1) loadVideoInSlot(i);
      else if (Math.abs(i - newIdx) > 2) unloadVideoInSlot(i);
    }

    if (counter) counter.textContent = (currentIdx + 1) + ' / ' + allVideos.length;

    clearTimeout(notifyTimeout);
    notifyTimeout = setTimeout(function() {
      if (allVideos[newIdx]) notifySafiya('watch', allVideos[newIdx]);
    }, 2000);
  }

  // ═══ OBSERVER ═══
  var slotObserver = null;
  function setupObserver() {
    if (slotObserver) slotObserver.disconnect();
    slotObserver = new IntersectionObserver(function(entries) {
      var mostVisible = null, maxRatio = 0;
      entries.forEach(function(entry) {
        if (entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          mostVisible = entry.target;
        }
      });
      if (mostVisible && maxRatio > 0.6) {
        var idx = parseInt(mostVisible.dataset.idx);
        if (!isNaN(idx) && idx !== currentIdx) setCurrentIdx(idx);
      }
    }, { root: scroller, threshold: [0.3, 0.6, 0.9] });

    scroller.querySelectorAll('.rp-slot').forEach(function(s) { slotObserver.observe(s); });
  }

  // ═══ DETECT ═══
  function isPortrait(video) {
    if (!video) return false;
    if (video.aspect === 'portrait') return true;
    if (video.source === 'youtube_shorts' || video.source === 'tiktok' || video.source === 'instagram') return true;
    if (video.isShort === true) return true;
    var title = (video.title || '').toLowerCase();
    if (/#shorts?\b|\bshorts?\b|\breels?\b/i.test(title)) return true;
    if (video.duration && video.duration > 0 && video.duration < 90) return true;
    return false;
  }

  // ═══ INIT ═══
  async function init() {
    try {
      var fetched = [];
      var found = null;

      try {
        var res1 = await fetch('/api/social-feed?format=portrait&page=1&limit=30');
        if (res1.ok) {
          var data1 = await res1.json();
          if (data1.success && data1.videos) fetched = fetched.concat(data1.videos);
        }
      } catch(e) {}

      for (var i = 1; i <= 2; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          if (!res.ok) continue;
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) found = data.videos.find(function(v) { return v.id === id; });
          }
        } catch(e) {}
      }

      if (!found) found = fetched.find(function(v) { return v.id === id; });

      var seen = {};
      var uniqueAll = fetched.filter(function(v) {
        if (!v || !v.id || seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });

      var portraitVideos = uniqueAll.filter(isPortrait);

      if (found && !portraitVideos.find(function(v) { return v.id === found.id; })) {
        portraitVideos.unshift(found);
      }

      if (portraitVideos.length === 0) {
        loader.style.display = 'none';
        notFound.style.display = 'flex';
        return;
      }

      if (found) {
        var idx = portraitVideos.findIndex(function(v) { return v.id === found.id; });
        if (idx > 0) {
          var arr = portraitVideos.splice(idx, 1);
          portraitVideos.unshift(arr[0]);
        }
      }

      allVideos = portraitVideos;

      scroller.innerHTML = '';
      allVideos.forEach(function(v, i) { scroller.appendChild(buildSlot(v, i)); });

      loader.style.display = 'none';
      top.style.display = 'flex';
      scroller.style.display = 'block';
      counter.style.display = 'block';

      currentIdx = -1;
      setCurrentIdx(0);
      setupObserver();

    } catch(err) {
      console.error('[Reels]', err);
      loader.style.display = 'none';
      notFound.style.display = 'flex';
    }
  }

  init();
})();
</script>

<style is:global>
  body:has(.rp-root) {
    background: #000 !important;
    overflow: hidden !important;
  }
  body:has(.rp-root) .site-header,
  body:has(.rp-root) header,
  body:has(.rp-root) footer,
  body:has(.rp-root) #btt,
  body:has(.rp-root) .back-to-top,
  body:has(.rp-root) .ambient-bg {
    display: none !important;
  }
  body:has(.rp-root) main {
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
  }
  body:has(.rp-root) #app {
    background: #000 !important;
    min-height: 100vh !important;
  }
</style>

<style>
  /* ═══ ROOT ═══ */
  .rp-root {
    position: fixed;
    inset: 0;
    background: #000;
    color: #fff;
    z-index: 500;
    font-family: 'Inter', 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    overflow: hidden;
  }

  /* ═══ LOADER / NOT FOUND ═══ */
  .rp-loader, .rp-nf {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: #000;
    z-index: 400;
    padding: 2rem;
    text-align: center;
  }
  .rp-lo-orb { position: relative; width: 50px; height: 50px; }
  .rp-lo-core {
    position: absolute; inset: 15%; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    box-shadow: 0 0 20px rgba(192,132,252,.6);
    animation: rpLoPu 1s ease infinite;
  }
  .rp-lo-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgba(192,132,252,.6);
    animation: rpLoEx 1.2s ease-out infinite;
  }
  @keyframes rpLoEx { 0%{transform:scale(.5);opacity:1} 100%{transform:scale(1.5);opacity:0} }
  @keyframes rpLoPu { 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
  .rp-loader p {
    color: rgba(255,255,255,.55);
    font-family: 'JetBrains Mono', monospace;
    font-size: .8rem; margin: 0;
  }
  .rp-nf-ic { color: #c084fc; }
  .rp-nf h1 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.8rem; margin: 0;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .rp-nf p { color: rgba(255,255,255,.6); max-width: 400px; margin: 0; }
  .rp-nf-bk {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 12px 24px; text-decoration: none;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    color: #fff; border-radius: 999px; font-weight: 700;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: .9rem;
    box-shadow: 0 8px 24px rgba(192,132,252,.4);
    transition: transform .2s ease;
  }
  .rp-nf-bk:hover { transform: translateY(-2px); }

  /* ═══ TOP BAR ═══ */
  .rp-top {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(0,0,0,.75) 0%, rgba(0,0,0,.35) 70%, transparent);
    pointer-events: none;
  }
  .rp-top-btn {
    pointer-events: auto;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.1);
    color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all .2s ease;
    padding: 0;
    font-family: inherit;
    flex-shrink: 0;
  }
  .rp-top-btn:hover { background: rgba(255,255,255,.18); transform: scale(1.06); }
  .rp-top-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem; font-weight: 800;
    letter-spacing: -.02em;
    text-shadow: 0 2px 12px rgba(0,0,0,.9);
    white-space: nowrap;
    pointer-events: none;
  }
  .rp-brand-grad {
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .rp-brand-w { color: #fff; }

  /* ═══ SCROLLER ═══ */
  .rp-scroller {
    position: fixed;
    inset: 0;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
