---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Reels" description="Watch amazing videos">
  <div class="reels-page" id="reelsPage">
    
    <!-- Header (minimal) -->
    <div class="reels-header">
      <a href="/" class="reels-back" aria-label="Back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div class="reels-header-title">Reels</div>
      <div style="width:22px"></div>
    </div>
    
    <!-- Main Reels Container -->
    <div class="reels-main" id="reelsMain">
      
      <!-- Loading state -->
      <div id="reelsLoader" class="reels-loader">
        <div class="reels-spinner"></div>
        <p>Loading reel...</p>
      </div>
      
      <!-- Reels container (holds current video + next/prev) -->
      <div id="reelsStack" class="reels-stack" style="display:none;">
        <!-- Video slot -->
        <div class="reel-slot" id="reelSlot">
          <!-- Video iframe container -->
          <div class="reel-video-container" id="reelVideoContainer">
            <div class="reel-video-loading">
              <div class="reels-spinner"></div>
            </div>
          </div>
          
          <!-- Gradient overlay for text readability -->
          <div class="reel-gradient-top"></div>
          <div class="reel-gradient-bottom"></div>
          
          <!-- Right side action buttons (like Instagram) -->
          <div class="reel-actions">
            <button class="reel-action-btn" id="reelLikeBtn">
              <div class="reel-action-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </div>
              <div class="reel-action-count" id="reelLikeCount">0</div>
            </button>
            
            <button class="reel-action-btn">
              <div class="reel-action-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="reel-action-count">💬</div>
            </button>
            
            <button class="reel-action-btn" id="reelShareBtn">
              <div class="reel-action-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              </div>
              <div class="reel-action-count">Share</div>
            </button>
            
            <button class="reel-action-btn" id="reelSaveBtn">
              <div class="reel-action-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="reel-action-count">Save</div>
            </button>
            
            <button class="reel-action-btn reel-more-btn">
              <div class="reel-action-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
              </div>
            </button>
          </div>
          
          <!-- Bottom info bar -->
          <div class="reel-info-bar">
            <div class="reel-user">
              <div class="reel-user-avatar">
                <div class="reel-user-avatar-inner">▶</div>
              </div>
              <div class="reel-user-info">
                <div class="reel-user-name" id="reelChannel">Loading...</div>
                <button class="reel-follow-btn">Follow</button>
              </div>
            </div>
            <div class="reel-caption" id="reelTitle">Loading...</div>
            <div class="reel-audio">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              <span id="reelAudio">Original Audio</span>
            </div>
          </div>
          
          <!-- Navigation arrows (for PC users) -->
          <button class="reel-nav-btn reel-nav-up" id="reelPrevBtn" aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
          <button class="reel-nav-btn reel-nav-down" id="reelNextBtn" aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Related Products (below Reels on scroll) -->
      <div class="reel-products-section" id="reelProductsSection" style="display:none;">
        <div class="reel-products-header">
          <div class="reel-products-title">
            <span class="reel-products-icon">✨</span>
            Recommended For You
          </div>
        </div>
        <div class="reel-products-grid" id="reelProductsGrid"></div>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('reelsLoader');
  var stack = document.getElementById('reelsStack');
  var videoContainer = document.getElementById('reelVideoContainer');
  var titleEl = document.getElementById('reelTitle');
  var channelEl = document.getElementById('reelChannel');
  var audioEl = document.getElementById('reelAudio');
  var likeBtn = document.getElementById('reelLikeBtn');
  var likeCount = document.getElementById('reelLikeCount');
  var shareBtn = document.getElementById('reelShareBtn');
  var saveBtn = document.getElementById('reelSaveBtn');
  var prevBtn = document.getElementById('reelPrevBtn');
  var nextBtn = document.getElementById('reelNextBtn');
  var productsSection = document.getElementById('reelProductsSection');
  var productsGrid = document.getElementById('reelProductsGrid');
  
  var allVideos = [];
  var currentIdx = 0;
  var productPool = [];
  
  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}
  function shuffle(arr){var a=arr.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
  
  function formatCount(n) {
    if (n < 1000) return n;
    if (n < 1000000) return (n / 1000).toFixed(1) + 'K';
    return (n / 1000000).toFixed(1) + 'M';
  }
  
  // Load a video by index
  function loadVideoAt(idx) {
    if (!allVideos[idx]) return;
    currentIdx = idx;
    var video = allVideos[idx];
    
    // Update URL without reload
    try {
      window.history.replaceState({}, '', '/reels/' + encodeURIComponent(video.id));
    } catch(e) {}
    
    document.title = (video.title || 'Reel') + ' - AniTube Buzz';
    
    // Show loading
    videoContainer.innerHTML = '<div class="reel-video-loading"><div class="reels-spinner"></div></div>';
    
    // Info
    titleEl.textContent = video.title || 'Video';
    channelEl.textContent = video.channel || 'Channel';
    audioEl.textContent = video.channel ? '♫ ' + video.channel : 'Original Audio';
    
    // Random like count (feels real)
    var seed = video.id.split('').reduce(function(a, c) { return a + c.charCodeAt(0); }, 0);
    var likes = 1000 + (seed % 100000);
    likeCount.textContent = formatCount(likes);
    
    // Load iframe
    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'ui-logo=0&ui-start-screen-info=0&sharing-enable=0&autoplay=1&mute=1';
    }
    if (video.source === 'youtube') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'modestbranding=1&showinfo=0&rel=0&autoplay=1&mute=1';
    }
    
    setTimeout(function() {
      videoContainer.innerHTML = '';
      var iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
      iframe.setAttribute('allowfullscreen', '');
      iframe.style.cssText = 'width:100%;height:100%;border:0;position:absolute;top:0;left:0;';
      videoContainer.appendChild(iframe);
    }, 200);
    
    // Update nav button states
    prevBtn.style.opacity = currentIdx > 0 ? '1' : '0.3';
    nextBtn.style.opacity = currentIdx < allVideos.length - 1 ? '1' : '0.3';
    
    // Reset like state
    likeBtn.classList.remove('liked');
    saveBtn.classList.remove('saved');
    
    // Load related products
    loadRelatedProducts();
  }
  
  function nextVideo() {
    if (currentIdx < allVideos.length - 1) {
      loadVideoAt(currentIdx + 1);
    }
  }
  
  function prevVideo() {
    if (currentIdx > 0) {
      loadVideoAt(currentIdx - 1);
    }
  }
  
  function loadRelatedProducts() {
    if (!productPool.length) return;
    var picks = shuffle(productPool).slice(0, 6);
    var html = picks.map(function(p) {
      var img = p.image ? '<img src="' + esc(p.image) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🛍️</div>';
      return '<a href="/product/' + esc(p.id) + '" class="reel-product-card" target="_blank">' +
        '<div class="reel-product-thumb">' + img +
          '<div class="reel-product-price">' + esc(p.price) + '</div>' +
        '</div>' +
        '<div class="reel-product-title">' + esc(trunc(p.title, 40)) + '</div>' +
      '</a>';
    }).join('');
    productsGrid.innerHTML = html;
    productsSection.style.display = 'block';
  }
  
  // Like button
  likeBtn.addEventListener('click', function() {
    likeBtn.classList.toggle('liked');
    var current = parseInt(likeCount.textContent.replace(/[^\d]/g, '')) || 0;
    likeCount.textContent = formatCount(likeBtn.classList.contains('liked') ? current + 1 : Math.max(0, current - 1));
  });
  
  // Save button
  saveBtn.addEventListener('click', function() {
    saveBtn.classList.toggle('saved');
  });
  
  // Share button
  shareBtn.addEventListener('click', function() {
    if (navigator.share && allVideos[currentIdx]) {
      navigator.share({
        title: allVideos[currentIdx].title,
        url: window.location.href
      }).catch(function() {});
    } else {
      navigator.clipboard.writeText(window.location.href);
      shareBtn.classList.add('shared');
      setTimeout(function() { shareBtn.classList.remove('shared'); }, 1500);
    }
  });
  
  // Nav buttons
  prevBtn.addEventListener('click', prevVideo);
  nextBtn.addEventListener('click', nextVideo);
  
  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowUp' || e.key === 'k') { e.preventDefault(); prevVideo(); }
    else if (e.key === 'ArrowDown' || e.key === 'j') { e.preventDefault(); nextVideo(); }
    else if (e.key === ' ') { e.preventDefault(); }
    else if (e.key === 'l') { likeBtn.click(); }
    else if (e.key === 'Escape') { window.history.back(); }
  });
  
  // Touch swipe for mobile
  var touchStartY = 0;
  var touchEndY = 0;
  document.addEventListener('touchstart', function(e) {
    touchStartY = e.changedTouches[0].screenY;
  }, { passive: true });
  document.addEventListener('touchend', function(e) {
    touchEndY = e.changedTouches[0].screenY;
    var diff = touchStartY - touchEndY;
    if (Math.abs(diff) > 50) {
      if (diff > 0) nextVideo(); // Swipe up = next
      else prevVideo(); // Swipe down = prev
    }
  }, { passive: true });
  
  // Mouse wheel navigation
  var wheelTimeout;
  document.addEventListener('wheel', function(e) {
    if (wheelTimeout) return;
    if (Math.abs(e.deltaY) < 30) return;
    
    wheelTimeout = setTimeout(function() {
      wheelTimeout = null;
    }, 600);
    
    if (e.deltaY > 0) nextVideo();
    else prevVideo();
  }, { passive: true });
  
  // MAIN INIT
  async function init() {
    try {
      // Load products in background
      fetch('/api/products?limit=30').then(function(r) { return r.json(); }).then(function(d) {
        if (d.success && d.products) productPool = d.products;
      }).catch(function(){});
      
      // Fetch videos to find this one
      var types = ['all'];
      var found = null;
      var allFetched = [];
      
      for (var i = 1; i <= 3; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=30');
          var data = await res.json();
          if (data.success && data.videos) {
            allFetched = allFetched.concat(data.videos);
            if (!found) {
              found = data.videos.find(function(v) { return v.id === id; });
            }
          }
        } catch(e) {}
      }
      
      if (!found && allFetched.length > 0) {
        found = allFetched[0]; // Fallback to first video
      }
      
      if (!found) {
        loader.innerHTML = '<h1 style="color:#fff;margin-bottom:1rem;">Video Not Found</h1><a href="/" style="color:#c084fc;">← Back to Home</a>';
        return;
      }
      
      // Deduplicate
      var seen = {};
      allVideos = allFetched.filter(function(v) {
        if (seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });
      
      // Find index of found video
      var foundIdx = allVideos.findIndex(function(v) { return v.id === found.id; });
      if (foundIdx < 0) {
        allVideos.unshift(found);
        foundIdx = 0;
      }
      
      loader.style.display = 'none';
      stack.style.display = 'block';
      
      loadVideoAt(foundIdx);
    } catch(e) {
      console.error(e);
      loader.innerHTML = '<h1 style="color:#fff;">Error loading reel</h1>';
    }
  }
  
  init();
})();
</script>

<style>
  /* Full page dark background */
  html, body { background: #000 !important; }
  #app { background: #000 !important; }
  main { background: #000 !important; padding: 0 !important; }
  
  .reels-page {
    min-height: 100vh;
    background: #000;
    color: #fff;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  
  /* Header */
  .reels-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  .reels-back {
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    transition: all 0.2s ease;
  }
  
  .reels-back:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  
  .reels-header-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .reels-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0 0;
  }
  
  /* Loader */
  .reels-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 6rem 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    min-height: 60vh;
  }
  
  .reels-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: reelsSpin 0.8s linear infinite;
  }
  
  @keyframes reelsSpin { to { transform: rotate(360deg); } }
  
  /* Reels Stack */
  .reels-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    padding: 0 16px;
  }
  
  /* Individual Reel Slot */
  .reel-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 9/16;
    max-height: calc(100vh - 100px);
    background: #000;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  }
  
  /* Video container fills the slot */
  .reel-video-container {
    position: absolute;
    inset: 0;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .reel-video-container iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
    /* Center the 16:9 video in 9:16 container */
    object-fit: contain;
  }
  
  .reel-video-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }
  
  /* Gradient overlays */
  .reel-gradient-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(180deg, rgba(0,0,0,0.6), transparent);
    pointer-events: none;
    z-index: 5;
  }
  
  .reel-gradient-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 200px;
    background: linear-gradient(0deg, rgba(0,0,0,0.85), transparent);
    pointer-events: none;
    z-index: 5;
  }
  
  /* RIGHT SIDE ACTIONS (Instagram style) */
  .reel-actions {
    position: absolute;
    right: 10px;
    bottom: 100px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    z-index: 10;
  }
  
  .reel-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }
  
  .reel-action-btn:hover {
    transform: scale(1.1);
  }
  
  .reel-action-btn:active {
    transform: scale(0.9);
  }
  
  .reel-action-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
  }
  
  .reel-action-count {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
  
  .reel-action-btn.liked .reel-action-icon svg {
    fill: #ff3040;
    stroke: #ff3040;
    animation: likeBoom 0.4s ease;
  }
  
  @keyframes likeBoom {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
  
  .reel-action-btn.saved .reel-action-icon svg {
    fill: #ffd60a;
    stroke: #ffd60a;
  }
  
  .reel-action-btn.shared .reel-action-icon svg {
    stroke: #10b981;
  }
  
  /* Bottom info bar */
  .reel-info-bar {
    position: absolute;
    left: 12px;
    right: 80px;
    bottom: 16px;
    z-index: 10;
    color: #fff;
  }
  
  .reel-user {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  
  .reel-user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    padding: 2px;
    flex-shrink: 0;
  }
  
  .reel-user-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e879f9;
    font-size: 0.9rem;
    padding-left: 2px;
  }
  
  .reel-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  
  .reel-user-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
  
  .reel-follow-btn {
    padding: 4px 12px;
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .reel-follow-btn:hover {
    background: #fff;
    color: #000;
  }
  
  .reel-caption {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: #fff;
    line-height: 1.4;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
  
  .reel-audio {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
  }
  
  .reel-audio svg {
    color: #fff;
  }
  
  /* Navigation buttons */
  .reel-nav-btn {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }
  
