---
export const prerender = false;

import ImmersiveLayout from '../../layouts/ImmersiveLayout.astro';

const { id } = Astro.params;
const videoId = id || '';

function getPlatformData(vid: string) {
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return { source: 'youtube_shorts', embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1&autoplay=1`, aspect: 'portrait', isShort: true };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return { source: 'youtube', embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1&autoplay=1`, aspect: 'landscape', isShort: false };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return { source: 'dailymotion', embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0`, aspect: 'mixed', isShort: false };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return { source: 'bilibili', embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1&high_quality=1`, aspect: 'landscape', isShort: false };
  }
  if (vid.startsWith('ody_')) {
    const rawId = vid.replace('ody_', '');
    return { source: 'odysee', embedUrl: `https://odysee.com/$/embed/${rawId}?autoplay=1`, aspect: 'landscape', isShort: false };
  }
  if (vid.startsWith('rmb_')) {
    const rawId = vid.replace('rmb_', '');
    return { source: 'rumble', embedUrl: `https://rumble.com/embed/${rawId}/?autoplay=2`, aspect: 'landscape', isShort: false };
  }
  return null;
}

let video: any = null;
let allVideos: any[] = [];

try {
  const apiUrl = new URL('/api/social-feed', Astro.url.origin);
  apiUrl.searchParams.set('limit', '100');
  apiUrl.searchParams.set('format', 'all');
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    allVideos = data.videos || [];
    video = allVideos.find((v: any) => v.id === videoId);
  }
} catch (e) {
  console.error('API fetch failed:', e);
}

if (!video) {
  const platformData = getPlatformData(videoId);
  if (platformData) {
    video = {
      id: videoId, title: 'Anime Content', channel: 'AniTube', thumbnail: '',
      embedUrl: platformData.embedUrl, source: platformData.source,
      aspect: platformData.aspect, isShort: platformData.isShort, type: 'anime'
    };
  } else {
    video = {
      id: videoId, title: 'Anime Video', channel: 'AniTubeBuzz', thumbnail: '',
      embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0&autoplay=1`,
      source: 'youtube', aspect: 'landscape', isShort: false, type: 'anime'
    };
  }
}

function buildRelatedFeed(current: any, all: any[]): any[] {
  if (!all || all.length === 0) return [current];
  const pool = all.filter(v => v.id !== current.id);
  const scored = pool.map(v => {
    let score = 0;
    if (v.channel === current.channel) score += 100;
    if (v.type === current.type) score += 50;
    if (v.source === current.source) score += 20;
    if (v.aspect === current.aspect) score += 30;
    if (v.isNew) score += 15;
    if (v.isOfficial) score += 10;
    score += Math.random() * 5;
    return { video: v, score };
  });
  scored.sort((a, b) => b.score - a.score);
  return [current, ...scored.map(s => s.video)];
}

const feedQueue = buildRelatedFeed(video, allVideos);
const nextVideo = feedQueue[1] || null;

const displayChannel = (video.channel || 'AniTube').trim();
const channelHandle = displayChannel.replace(/\s+/g, '').toLowerCase().slice(0, 25);

const typeInfo: any = {
  anime: { label: 'Anime', emoji: '🎌' },
  kdrama: { label: 'K-Drama', emoji: '🎭' },
  donghua: { label: 'Donghua', emoji: '🐉' },
  movies: { label: 'Movie', emoji: '🎬' }
};
const currentType = typeInfo[video.type] || typeInfo.anime;
---

<ImmersiveLayout title={`${video.title} | AniTubeBuzz`}>
  <div 
    id="reels-root" 
    class="rp-root" 
    data-videoid={videoId}
    data-next={nextVideo?.id || ''}
  >
    
    <header class="rp-topbar">
      <button class="rp-back" id="backBtn" aria-label="Back to home">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <div class="rp-brand">
        <span class="rp-brand-text">AniTubeBuzz</span>
        <div class="rp-brand-dot"></div>
      </div>
      
      <div class="rp-type-badge">
        <span class="rp-type-emoji">{currentType.emoji}</span>
        <span class="rp-type-label">{currentType.label}</span>
      </div>
    </header>

    <main class="rp-stage">
      
      <div class="rp-card" id="videoCard">
        <div class="rp-card-glow"></div>
        <div class="rp-card-frame">
          <iframe 
            id="videoFrame"
            src={video.embedUrl}
            title={video.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="eager"
          ></iframe>
          
          <div class="rp-loader" id="loader">
            <div class="rp-loader-orbit">
              <div class="rp-loader-dot rp-dot-1"></div>
              <div class="rp-loader-dot rp-dot-2"></div>
              <div class="rp-loader-dot rp-dot-3"></div>
            </div>
            <div class="rp-loader-text">AniTubeBuzz</div>
          </div>
          
          <div class="rp-doubletap-heart" id="doubleTapHeart">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="rp-info">
        <div class="rp-channel-row">
          <div class="rp-avatar">
            {displayChannel.charAt(0).toUpperCase()}
            <div class="rp-avatar-ring"></div>
          </div>
          <div class="rp-channel-info">
            <span class="rp-channel-name">@{channelHandle}</span>
            <span class="rp-channel-meta">
              <span class="rp-hd-dot"></span>
              HD Quality
            </span>
          </div>
        </div>
        <h1 class="rp-title">{video.title}</h1>
      </div>

      <div class="rp-actions">
        <button class="rp-pill rp-save" id="saveBtn" aria-label="Save">
          <div class="rp-pill-icon">
            <svg class="rp-icon rp-bookmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <span class="rp-pill-label">Save</span>
        </button>
        
        <button class="rp-pill rp-send" id="sendBtn" aria-label="Share">
          <div class="rp-pill-icon">
            <svg class="rp-icon rp-plane" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </div>
          <span class="rp-pill-label">Send</span>
        </button>
      </div>

      <div class="rp-nav">
        <button class="rp-arrow" id="prevBtn" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6"/>
          </svg>
        </button>
        <button class="rp-arrow" id="nextBtn" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>

    </main>

    <script is:inline set:html={`window.__REELS_VIDEO__ = ${JSON.stringify(video)}; window.__REELS_QUEUE__ = ${JSON.stringify(feedQueue.slice(0, 30))}; window.__CURRENT_VIDEO_ID__ = ${JSON.stringify(videoId)};`}></script>

    <!-- 🔥 CRITICAL INLINE SCRIPT: Save resume to localStorage IMMEDIATELY on page load + back button handler -->
    <script is:inline>
      (function(){
        var vid = window.__CURRENT_VIDEO_ID__ || '';
        
        // Save to localStorage IMMEDIATELY when reels page loads (so even browser back works)
        try {
          if (vid) {
            localStorage.setItem('anitube_resume_video', vid);
            localStorage.setItem('anitube_resume_time', String(Date.now()));
          }
        } catch(e) {}
        
        // Back button handler
        function goHome(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          // Refresh timestamp for freshness
          try {
            if (vid) {
              localStorage.setItem('anitube_resume_video', vid);
              localStorage.setItem('anitube_resume_time', String(Date.now()));
            }
          } catch(err) {}
          
          // Try history.back if same origin, else go home
          try {
            if (document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
              window.history.back();
            } else {
              window.location.href = '/';
            }
          } catch(err) {
            window.location.href = '/';
          }
          return false;
        }
        
        function attachBackHandler() {
          var btn = document.getElementById('backBtn');
          if (btn) {
            btn.onclick = goHome;
            btn.addEventListener('click', goHome, false);
          } else {
            setTimeout(attachBackHandler, 50);
          }
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', attachBackHandler);
        } else {
          attachBackHandler();
        }
      })();
    </script>

  </div>

  <style>
    .rp-root {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: 
        radial-gradient(ellipse at 20% 20%, rgba(192, 132, 252, 0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 85% 75%, rgba(125, 211, 252, 0.12) 0%, transparent 55%),
        linear-gradient(180deg, #0a0517 0%, #150a29 50%, #0a0517 100%);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      user-select: none;
      -webkit-user-select: none;
      z-index: 1;
      animation: rp-fade-in 0.5s ease-out;
    }

    @keyframes rp-fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .rp-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(10, 5, 23, 0.9) 0%, transparent 100%);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .rp-back {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f5ecff;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(10px);
    }

    .rp-back:hover {
      background: rgba(192, 132, 252, 0.15);
      border-color: rgba(192, 132, 252, 0.4);
      transform: scale(1.05);
    }

    .rp-back:active { transform: scale(0.94); }

    .rp-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .rp-brand-text {
      font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 17px;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .rp-brand-dot {
      width: 6px;
      height: 6px;
      background: #7dd3fc;
      border-radius: 50%;
      box-shadow: 0 0 10px #7dd3fc;
      animation: rp-pulse 2s infinite;
    }

    @keyframes rp-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .rp-type-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(192, 132, 252, 0.25);
      border-radius: 20px;
      backdrop-filter: blur(10px);
    }

    .rp-type-emoji { font-size: 14px; }
    .rp-type-label {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: #f5ecff;
      letter-spacing: 0.02em;
    }

    .rp-stage {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 80px 20px 40px;
      z-index: 1;
    }

    .rp-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      aspect-ratio: 9 / 16;
      max-height: calc(100vh - 130px);
      max-height: calc(100dvh - 130px);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
      animation: rp-card-enter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes rp-card-enter {
      from { opacity: 0; transform: translateY(30px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .rp-card-glow {
      position: absolute;
      inset: -3px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      border-radius: 24px;
      opacity: 0.65;
      filter: blur(14px);
      z-index: -1;
      animation: rp-glow 4s ease-in-out infinite;
    }

    @keyframes rp-glow {
      0%, 100% { opacity: 0.5; filter: blur(14px); }
      50% { opacity: 0.8; filter: blur(20px); }
    }

    .rp-card-frame {
      position: absolute;
      inset: 0;
      background: #000;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(192, 132, 252, 0.35);
    }

    .rp-card-frame iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .rp-doubletap-heart {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      width: 100px;
      height: 100px;
      color: #ff2d55;
      pointer-events: none;
      z-index: 20;
      filter: drop-shadow(0 0 30px rgba(255, 45, 85, 0.9));
    }

    .rp-doubletap-heart svg { width: 100%; height: 100%; }
    .rp-doubletap-heart.pop {
      animation: rp-heart-explode 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes rp-heart-explode {
      0% { transform: translate(-50%, -50%) scale(0) rotate(-15deg); opacity: 0; }
      30% { transform: translate(-50%, -50%) scale(1.3) rotate(0deg); opacity: 1; }
      60% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
      100% { transform: translate(-50%, -50%) scale(1.5) rotate(0deg); opacity: 0; }
    }

    .rp-loader {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      background: radial-gradient(circle at center, #1a0f2e 0%, #000 100%);
      z-index: 5;
      transition: opacity 0.5s;
    }

    .rp-loader.hidden { opacity: 0; pointer-events: none; }

    .rp-loader-orbit {
      position: relative;
      width: 60px;
      height: 60px;
    }

    .rp-loader-dot {
      position: absolute;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .rp-dot-1 { background: #c084fc; box-shadow: 0 0 15px #c084fc; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    .rp-dot-2 { background: #e879f9; box-shadow: 0 0 15px #e879f9; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite -0.47s; }
    .rp-dot-3 { background: #7dd3fc; box-shadow: 0 0 15px #7dd3fc; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite -0.93s; }

    @keyframes rp-orbit {
      0% { transform: translate(-50%, -50%) rotate(0deg) translateX(22px) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg) translateX(22px) rotate(-360deg); }
    }

    .rp-loader-text {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0.9;
    }

    .rp-info {
      position: absolute;
      bottom: 40px;
      left: 32px;
      z-index: 50;
      max-width: 340px;
      pointer-events: none;
    }

    .rp-channel-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .rp-avatar {
      position: relative;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700;
      font-size: 17px;
      color: white;
      border: 2px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 4px 16px rgba(192, 132, 252, 0.55);
    }

    .rp-avatar-ring {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid transparent;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc) border-box;
      -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0.4;
      animation: rp-ring-rotate 4s linear infinite;
    }

    @keyframes rp-ring-rotate {
      to { transform: rotate(360deg); }
    }

    .rp-channel-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .rp-channel-name {
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 15px;
      color: white;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    }

    .rp-channel-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.7);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
      font-weight: 500;
    }

    .rp-hd-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #7dd3fc;
      box-shadow: 0 0 8px #7dd3fc;
      animation: rp-pulse 2s infinite;
    }

    .rp-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: white;
      line-height: 1.35;
      margin: 0;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .rp-actions {
      position: absolute;
      right: 20px;
      bottom: 260px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 60;
    }

    .rp-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 14px 6px 6px;
      height: 44px;
      background: linear-gradient(135deg, rgba(28, 15, 61, 0.85), rgba(20, 10, 40, 0.9));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(192, 132, 252, 0.35);
      border-radius: 24px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 
        0 6px 20px rgba(0, 0, 0, 0.4),
        0 0 0 1px rgba(192, 132, 252, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      position: relative;
      overflow: hidden;
    }

    .rp-pill-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(192, 132, 252, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      transition: all 0.3s;
    }

    .rp-icon {
      width: 16px;
      height: 16px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .rp-pill-label {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #f5ecff;
      letter-spacing: 0.01em;
      padding-right: 4px;
    }

    .rp-pill::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent 0%, rgba(192, 132, 252, 0.2) 50%, transparent 100%);
      transition: left 0.7s;
      pointer-events: none;
    }

    .rp-pill:hover {
      transform: translateX(-3px);
      background: linear-gradient(135deg, rgba(48, 25, 90, 0.9), rgba(35, 18, 65, 0.95));
      border-color: rgba(232, 121, 249, 0.6);
    }

    .rp-pill:hover::before { left: 100%; }
    .rp-pill:hover .rp-pill-icon { transform: scale(1.08); }
    .rp-pill:hover .rp-icon { transform: scale(1.1); }
    .rp-pill:active { transform: translateX(-2px) scale(0.97); }

    .rp-save.saved {
      border-color: rgba(255, 200, 100, 0.55);
      background: linear-gradient(135deg, rgba(75, 55, 20, 0.85), rgba(50, 35, 10, 0.9));
    }

    .rp-save.saved .rp-pill-icon {
      background: linear-gradient(135deg, #fbbf24, #f59e0b, #d97706);
    }

    .rp-save.saved .rp-bookmark {
      fill: currentColor;
      animation: rp-save-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .rp-save.saved .rp-pill-label { color: #fde68a; }

    @keyframes rp-save-pop {
      0% { transform: scale(1); }
      40% { transform: scale(1.35) rotate(-8deg); }
      70% { transform: scale(0.92) rotate(4deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    .rp-send.sent .rp-plane {
      animation: rp-plane-fly 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes rp-plane-fly {
      0% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
      50% { transform: translate(20px, -20px) rotate(30deg); opacity: 0; }
      51% { transform: translate(-20px, 20px) rotate(-30deg); opacity: 0; }
      100% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    }

    .rp-nav {
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      display: none;
      flex-direction: column;
      gap: 14px;
      z-index: 50;
    }

    .rp-arrow {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(192, 132, 252, 0.25);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .rp-arrow:hover {
      background: linear-gradient(135deg, rgba(192, 132, 252, 0.3), rgba(232, 121, 249, 0.15));
      border-color: rgba(232, 121, 249, 0.6);
      transform: scale(1.1);
    }

    .rp-arrow:active { transform: scale(0.95); }
    .rp-arrow svg { width: 20px; height: 20px; }

    @media (min-width: 1024px) {
      .rp-nav { display: flex; right: 40px; }
      .rp-actions { right: 40px; bottom: 200px; }
      .rp-info { left: 40px; bottom: 60px; }
    }

    @media (max-width: 640px) {
      .rp-stage { padding: 0; }
      .rp-card {
        max-width: 100%; max-height: 100%; width: 100%; height: 100%; aspect-ratio: auto;
      }
      .rp-card-glow { display: none; }
      .rp-card-frame { border-radius: 0; box-shadow: none; }
      .rp-topbar { background: linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 0%, transparent 100%); }
      .rp-info { left: 16px; bottom: 95px; max-width: calc(100% - 130px); }
      .rp-actions { right: 12px; bottom: 240px; gap: 8px; }
      .rp-pill { height: 40px; padding: 5px 12px 5px 5px; gap: 8px; }
      .rp-pill-icon { width: 30px; height: 30px; }
      .rp-icon { width: 15px; height: 15px; }
      .rp-pill-label { font-size: 12px; }
      .rp-title { font-size: 16px; }
      .rp-type-badge { padding: 5px 10px; }
      .rp-type-label { font-size: 11px; }
    }

    @media (min-width: 641px) and (max-width: 1023px) {
      .rp-info { left: 24px; bottom: 50px; }
      .rp-actions { right: 24px; bottom: 220px; }
    }
  </style>

  <script>
    (function() {
      const root = document.getElementById('reels-root') as HTMLElement;
      if (!root) return;
      
      const videoId = root.dataset.videoid || '';
      const currentVideo: any = (window as any).__REELS_VIDEO__ || null;
      const queue: any[] = (window as any).__REELS_QUEUE__ || [];
      
      // WATCH HISTORY
      try {
        if (currentVideo && videoId) {
          const history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          const filtered = history.filter((h: any) => h.id !== videoId);
          filtered.unshift({
            id: videoId,
            title: currentVideo.title,
            channel: currentVideo.channel,
            thumbnail: currentVideo.thumbnail || '',
            type: currentVideo.type || 'anime',
            source: currentVideo.source || 'youtube',
            watchedAt: Date.now()
          });
          localStorage.setItem('anitube_history', JSON.stringify(filtered.slice(0, 100)));
        }
      } catch (e) { console.warn('History save failed', e); }
      
      // SAVE
      const saveBtn = document.getElementById('saveBtn');
      const savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      const isSaved = () => savedVideos.some((s: any) => s.id === videoId);
      
      function updateSaveUI() {
        if (!saveBtn) return;
        const label = saveBtn.querySelector('.rp-pill-label');
        if (isSaved()) {
          saveBtn.classList.add('saved');
          if (label) label.textContent = 'Saved';
        } else {
          saveBtn.classList.remove('saved');
          if (label) label.textContent = 'Save';
        }
      }
      
      function toggleSave() {
        const idx = savedVideos.findIndex((s: any) => s.id === videoId);
        if (idx > -1) {
          savedVideos.splice(idx, 1);
        } else {
          savedVideos.unshift({
            id: videoId,
            title: currentVideo?.title || 'Video',
            channel: currentVideo?.channel || 'AniTube',
            thumbnail: currentVideo?.thumbnail || '',
            type: currentVideo?.type || 'anime',
            source: currentVideo?.source || 'youtube',
            savedAt: Date.now()
          });
        }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      
      updateSaveUI();
      saveBtn?.addEventListener('click', toggleSave);
      
      // DOUBLE-TAP
      const card = document.getElementById('videoCard');
      const doubleTapHeart = document.getElementById('doubleTapHeart');
      let lastTap = 0;
      
      card?.addEventListener('click', (e) => {
        const now = Date.now();
        if (now - lastTap < 350) {
          if (!isSaved()) toggleSave();
          if (doubleTapHeart) {
            doubleTapHeart.classList.remove('pop');
            void (doubleTapHeart as HTMLElement).offsetWidth;
            doubleTapHeart.classList.add('pop');
          }
          lastTap = 0;
        } else {
          lastTap = now;
        }
      });
      
      // SEND
      const sendBtn = document.getElementById('sendBtn');
      sendBtn?.addEventListener('click', async () => {
        const shareData = {
          title: document.querySelector('.rp-title')?.textContent || 'AniTube Video',
          text: 'Check out this on AniTubeBuzz!',
          url: window.location.href
        };
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        sendBtn.classList.add('sent');
        setTimeout(() => sendBtn.classList.remove('sent'), 600);
        if (isMobile && (navigator as any).share) {
          try { await (navigator as any).share(shareData); } catch { }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const label = sendBtn.querySelector('.rp-pill-label');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => { label.textContent = orig; }, 1800);
            }
          } catch {
            prompt('Copy this link:', window.location.href);
          }
        }
      });
      
      // NAVIGATION
      function navigate(direction: 'next' | 'prev') {
        let targetId = '';
        if (direction === 'next') {
          if (queue.length > 1) targetId = queue[1].id;
        } else {
          if (window.history.length > 1) { window.history.back(); return; }
        }
        if (targetId) {
          const c = document.getElementById('videoCard');
          if (c) {
            c.style.opacity = '0';
            c.style.transform = `translateY(${direction === 'next' ? '-30px' : '30px'}) scale(0.95)`;
          }
          setTimeout(() => { window.location.href = `/reels/${targetId}`; }, 220);
        }
      }
      
      document.getElementById('nextBtn')?.addEventListener('click', () => navigate('next'));
      document.getElementById('prevBtn')?.addEventListener('click', () => navigate('prev'));
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'j' || e.key === 'J') { e.preventDefault(); navigate('next'); }
        else if (e.key === 'ArrowUp' || e.key === 'k' || e.key === 'K') { e.preventDefault(); navigate('prev'); }
      });
      
      let wheelLocked = false;
      document.addEventListener('wheel', (e) => {
        if (wheelLocked) return;
        if (Math.abs(e.deltaY) < 30) return;
        wheelLocked = true;
        if (e.deltaY > 0) navigate('next');
        else navigate('prev');
        setTimeout(() => { wheelLocked = false; }, 800);
      }, { passive: true });
      
      let touchStartY = 0;
      let touchStartTime = 0;
      document.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      }, { passive: true });
      document.addEventListener('touchend', (e) => {
        const touchEndY = e.changedTouches[0].clientY;
        const diff = touchStartY - touchEndY;
        const timeDiff = Date.now() - touchStartTime;
        if (Math.abs(diff) > 80 && timeDiff < 600) {
          if (diff > 0) navigate('next');
          else navigate('prev');
        }
      }, { passive: true });
      
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const loader = document.getElementById('loader');
      iframe?.addEventListener('load', () => {
        setTimeout(() => loader?.classList.add('hidden'), 400);
      });
      setTimeout(() => loader?.classList.add('hidden'), 3500);
      
      setTimeout(() => {
        if (currentVideo) {
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: currentVideo }
          }));
        }
      }, 500);
      
    })();
  </script>
</ImmersiveLayout>
