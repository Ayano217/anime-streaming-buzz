---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const videoId = id || '';
---

<BaseLayout>
  <div class="rp-root" data-video-id={videoId}>
    <div class="rp-bg" id="rpBg"></div>
    <div class="rp-bg-overlay"></div>

    <div class="rp-topbar">
      <button class="rp-btn-icon" id="rpBack" aria-label="Back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="rp-brand">AniTube<span>Buzz</span></div>
      <button class="rp-btn-icon" id="rpMenu" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
      </button>
    </div>

    <div class="rp-nav-arrows">
      <button class="rp-arrow" id="rpArrowUp" aria-label="Previous">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
      <button class="rp-arrow" id="rpArrowDown" aria-label="Next">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>

    <div class="rp-feed" id="rpFeed">
      <div class="rp-loading" id="rpLoading">
        <div class="rp-spinner"></div>
      </div>
    </div>

    <div class="rp-toast" id="rpToast"></div>
  </div>
</BaseLayout>

<style is:global>
  html, body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #000 !important;
    height: 100% !important;
  }
  body .ambient-bg,
  body .site-header,
  body header.site-header,
  body > header,
  body footer,
  body .site-footer,
  body #btt,
  body .back-to-top {
    display: none !important;
  }
  body #app {
    background: #000 !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    min-height: 100vh !important;
    display: block !important;
  }
  #app > * {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .rp-root {
    position: fixed !important;
    inset: 0 !important;
    background: #000 !important;
    color: #fff !important;
    z-index: 9999 !important;
    font-family: 'Inter', 'DM Sans', sans-serif !important;
    overflow: hidden !important;
    width: 100vw !important;
    height: 100vh !important;
  }

  .rp-bg {
    position: absolute;
    inset: -30px;
    background-size: cover;
    background-position: center;
    filter: blur(45px) brightness(0.35);
    transform: scale(1.15);
    transition: background-image 0.5s ease;
    z-index: 1;
  }
  .rp-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 2;
  }

  .rp-topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    z-index: 100;
    background: linear-gradient(180deg, rgba(0,0,0,0.7), transparent);
    height: 60px;
    box-sizing: border-box;
  }
  .rp-btn-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0;
  }
  .rp-btn-icon:hover {
    background: rgba(192,132,252,0.3);
    border-color: rgba(192,132,252,0.6);
    transform: scale(1.05);
  }
  .rp-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }
  .rp-brand span { color: #fff; -webkit-text-fill-color: #fff; }

  .rp-nav-arrows {
    position: absolute;
    right: 30px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 90;
  }
  .rp-arrow {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(30,30,30,0.9);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    padding: 0;
  }
  .rp-arrow:hover {
    background: rgba(192,132,252,0.4);
    transform: scale(1.1);
  }

  .rp-feed {
    position: absolute;
    inset: 0;
    z-index: 10;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .rp-feed::-webkit-scrollbar { display: none; width: 0; }

  .rp-item {
    height: 100vh;
    width: 100vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }

  .rp-card {
    position: relative;
    height: min(90vh, calc(100vh - 40px));
    aspect-ratio: 9 / 16;
    max-width: min(92vw, 500px);
    background: #0d0520;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,0.8), 0 0 40px rgba(192,132,252,0.2);
  }

  .rp-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
    z-index: 1;
  }
  .rp-video iframe {
    width: 100% !important;
    height: 100% !important;
    border: 0 !important;
    display: block !important;
    position: absolute;
    inset: 0;
  }

  .rp-info {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 24px 18px 20px;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.9) 60%);
    z-index: 5;
    pointer-events: none;
  }
  .rp-info-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    pointer-events: auto;
    flex-wrap: wrap;
  }
  .rp-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    padding: 2px;
    flex-shrink: 0;
    box-sizing: border-box;
  }
  .rp-avatar-inner {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: #0d0520;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  .rp-channel {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
  }
  .rp-follow {
    margin-left: 4px;
    padding: 5px 14px;
    background: transparent;
    border: 1.5px solid rgba(255,255,255,0.9);
    color: #fff;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }
  .rp-follow:hover {
    background: rgba(255,255,255,0.15);
  }
  .rp-follow.followed {
    background: linear-gradient(135deg,#c084fc,#e879f9);
    border-color: transparent;
  }
  .rp-caption {
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(255,255,255,0.95);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    pointer-events: auto;
    padding-right: 70px;
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
  }

  .rp-actions {
    position: absolute;
    right: 8px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 10;
    align-items: center;
  }
  .rp-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .rp-action-btn {
    width: 46px; height: 46px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    padding: 0;
  }
  .rp-action-btn:hover {
    background: rgba(255,255,255,0.22);
    transform: scale(1.1);
  }
  .rp-action-btn.liked {
    background: rgba(239,68,68,0.3);
    color: #ef4444;
  }
  .rp-action-btn.liked svg { fill: #ef4444; }
  .rp-action-btn.saved {
    background: linear-gradient(135deg,rgba(192,132,252,0.5),rgba(232,121,249,0.5));
    color: #e879f9;
  }
  .rp-action-btn.saved svg { fill: #e879f9; }
  .rp-action-lbl {
    font-size: 0.62rem;
    font-weight: 700;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    text-shadow: 0 1px 3px rgba(0,0,0,0.9);
    letter-spacing: 0.02em;
  }

  .rp-loading {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    z-index: 200;
  }
  .rp-spinner {
    width: 44px; height: 44px;
    border: 3px solid rgba(192,132,252,0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: rpSpin 0.8s linear infinite;
  }
  @keyframes rpSpin { to { transform: rotate(360deg); } }

  .rp-toast {
    position: fixed;
    bottom: 40px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    padding: 12px 24px;
    background: rgba(20,10,45,0.95);
    border: 1px solid rgba(192,132,252,0.4);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 500;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    pointer-events: none;
    white-space: nowrap;
  }
  .rp-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 768px) {
    .rp-card {
      height: 100vh;
      max-width: 100vw;
      width: 100vw;
      aspect-ratio: unset;
      border-radius: 0;
      box-shadow: none;
    }
    .rp-nav-arrows { display: none; }
    .rp-actions {
      right: 10px;
      bottom: 110px;
    }
    .rp-info {
      right: 0;
      padding: 24px 14px 24px;
    }
    .rp-caption {
      padding-right: 70px;
    }
    .rp-topbar { padding: 10px 14px; }
  }
  @media (max-width: 480px) {
    .rp-brand { font-size: 0.95rem; }
    .rp-btn-icon { width: 36px; height: 36px; }
  }
</style>

<script is:inline define:vars={{ videoId }}>
(function(){
  var CURRENT_ID = videoId;
  var feedEl = document.getElementById('rpFeed');
  var loadingEl = document.getElementById('rpLoading');
  var bgEl = document.getElementById('rpBg');
  var toastEl = document.getElementById('rpToast');
  var backBtn = document.getElementById('rpBack');
  var arrowUp = document.getElementById('rpArrowUp');
  var arrowDown = document.getElementById('rpArrowDown');

  var videos = [];
  var currentIdx = 0;
  var seenIds = {};

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  function showToast(msg){
    if(!toastEl)return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastEl._t);
    toastEl._t = setTimeout(function(){ toastEl.classList.remove('show'); }, 2000);
  }

  // Detect source from ID prefix
  function detectSource(id){
    if(!id) return 'youtube';
    if(id.indexOf('dm_') === 0) return 'dailymotion';
    if(id.indexOf('bili_') === 0) return 'bilibili';
    if(id.indexOf('od_') === 0) return 'odysee';
    if(id.indexOf('rum_') === 0) return 'rumble';
    if(id.indexOf('ytshort_') === 0) return 'youtube_shorts';
    if(id.indexOf('yt_') === 0) return 'youtube';
    return 'youtube';
  }

  // Extract raw ID (strip prefix)
  function stripPrefix(id, source){
    if(source === 'dailymotion') return id.replace(/^dm_/, '');
    if(source === 'bilibili') return id.replace(/^bili_/, '');
    if(source === 'odysee') return id.replace(/^od_/, '');
    if(source === 'rumble') return id.replace(/^rum_/, '');
    if(source === 'youtube_shorts') return id.replace(/^ytshort_/, '');
    if(source === 'youtube') return id.replace(/^yt_/, '');
    return id;
  }

  function buildFallbackVideo(id){
    var source = detectSource(id);
    var rawId = stripPrefix(id, source);
    var embedUrl = '';
    var thumbnail = '';

    if(source === 'dailymotion'){
      embedUrl = 'https://www.dailymotion.com/embed/video/' + rawId + '?autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0';
      thumbnail = 'https://www.dailymotion.com/thumbnail/video/' + rawId;
    } else if(source === 'bilibili'){
      embedUrl = 'https://player.bilibili.com/player.html?bvid=' + rawId + '&autoplay=1&muted=1';
      thumbnail = '';
    } else if(source === 'odysee'){
      embedUrl = 'https://odysee.com/$/embed/' + rawId + '?autoplay=1&muted=1';
      thumbnail = '';
    } else if(source === 'rumble'){
      embedUrl = 'https://rumble.com/embed/' + rawId + '/?autoplay=2';
      thumbnail = '';
    } else if(source === 'youtube' || source === 'youtube_shorts'){
      embedUrl = 'https://www.youtube.com/embed/' + rawId + '?autoplay=1&mute=1&modestbranding=1&rel=0&playsinline=1';
      thumbnail = 'https://i.ytimg.com/vi/' + rawId + '/hqdefault.jpg';
    }

    return {
      id: id,
      title: 'Video',
      channel: 'Channel',
      thumbnail: thumbnail,
      embedUrl: embedUrl,
      source: source,
      type: 'anime',
      aspect: 'portrait'
    };
  }

  function addToHistory(v){
    try{
      var hist = JSON.parse(localStorage.getItem('atb_watch_history')||'[]');
      hist = hist.filter(function(h){ return h.id !== v.id; });
      hist.unshift({
        id: v.id,
        title: v.title,
        thumbnail: v.thumbnail,
        channel: v.channel,
        type: v.type,
        watchedAt: Date.now()
      });
      hist = hist.slice(0, 50);
      localStorage.setItem('atb_watch_history', JSON.stringify(hist));
    }catch(e){}
  }

  function isSaved(id){
    try{ var s = JSON.parse(localStorage.getItem('atb_saved_reels')||'[]'); return s.indexOf(id) !== -1; }catch(e){return false;}
  }
  function toggleSaved(id){
    try{
      var s = JSON.parse(localStorage.getItem('atb_saved_reels')||'[]');
      var i = s.indexOf(id);
      if(i === -1){ s.push(id); localStorage.setItem('atb_saved_reels', JSON.stringify(s)); return true; }
      s.splice(i,1); localStorage.setItem('atb_saved_reels', JSON.stringify(s)); return false;
    }catch(e){return false;}
  }
  function isLiked(id){
    try{ var l = JSON.parse(localStorage.getItem('atb_liked_reels')||'[]'); return l.indexOf(id) !== -1; }catch(e){return false;}
  }
  function toggleLiked(id){
    try{
      var l = JSON.parse(localStorage.getItem('atb_liked_reels')||'[]');
      var i = l.indexOf(id);
      if(i === -1){ l.push(id); localStorage.setItem('atb_liked_reels', JSON.stringify(l)); return true; }
      l.splice(i,1); localStorage.setItem('atb_liked_reels', JSON.stringify(l)); return false;
    }catch(e){return false;}
  }
  function isFollowed(ch){
    try{ var f = JSON.parse(localStorage.getItem('atb_followed')||'[]'); return f.indexOf(ch) !== -1; }catch(e){return false;}
  }
  function toggleFollowed(ch){
    try{
      var f = JSON.parse(localStorage.getItem('atb_followed')||'[]');
      var i = f.indexOf(ch);
      if(i === -1){ f.push(ch); localStorage.setItem('atb_followed', JSON.stringify(f)); return true; }
      f.splice(i,1); localStorage.setItem('atb_followed', JSON.stringify(f)); return false;
    }catch(e){return false;}
  }

  function buildEmbedUrl(v){
    var url = v.embedUrl || '';
    if(!url) return '';
    var sep = url.indexOf('?') === -1 ? '?' : '&';
    if(v.source === 'youtube' || v.source === 'youtube_shorts'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&modestbranding=1&rel=0&playsinline=1';
    } else if(v.source === 'dailymotion'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0';
    } else if(v.source === 'bilibili'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&muted=1';
    } else {
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1';
    }
    return url;
  }

  function renderItem(v, idx){
    var el = document.createElement('div');
    el.className = 'rp-item';
    el.dataset.videoId = v.id;
    el.dataset.idx = idx;

    var liked = isLiked(v.id);
    var saved = isSaved(v.id);
    var followed = isFollowed(v.channel || '');
    var initials = (v.channel||'AT').charAt(0).toUpperCase();

    el.innerHTML =
      '<div class="rp-card">' +
        '<div class="rp-video" data-video-container></div>' +
        '<div class="rp-info">' +
          '<div class="rp-info-row">' +
            '<div class="rp-avatar"><div class="rp-avatar-inner">' + esc(initials) + '</div></div>' +
            '<div class="rp-channel">' + esc(v.channel || 'Channel') + '</div>' +
            '<button class="rp-follow ' + (followed?'followed':'') + '" data-follow>' + (followed?'Following':'Follow') + '</button>' +
          '</div>' +
          '<div class="rp-caption">' + esc(trunc(v.title||'', 120)) + '</div>' +
        '</div>' +
        '<div class="rp-actions">' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn ' + (liked?'liked':'') + '" data-like aria-label="Like">' +
              '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">' + (liked?'Liked':'Like') + '</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn" data-comment aria-label="Comment">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">Chat</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn" data-share aria-label="Share">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">Share</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn ' + (saved?'saved':'') + '" data-save aria-label="Save">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">' + (saved?'Saved':'Save') + '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    el.querySelector('[data-like]').addEventListener('click', function(e){
      e.stopPropagation();
      var nowLiked = toggleLiked(v.id);
      this.classList.toggle('liked', nowLiked);
      var lbl = this.parentElement.querySelector('.rp-action-lbl');
      if(lbl) lbl.textContent = nowLiked ? 'Liked' : 'Like';
      showToast(nowLiked ? '❤️ Liked' : 'Removed');
    });
    el.querySelector('[data-save]').addEventListener('click', function(e){
      e.stopPropagation();
      var nowSaved = toggleSaved(v.id);
      this.classList.toggle('saved', nowSaved);
      var lbl = this.parentElement.querySelector('.rp-action-lbl');
      if(lbl) lbl.textContent = nowSaved ? 'Saved' : 'Save';
      showToast(nowSaved ? '🔖 Saved' : 'Removed');
    });
    el.querySelector('[data-share]').addEventListener('click', function(e){
      e.stopPropagation();
      var url = window.location.origin + '/reels/' + encodeURIComponent(v.id);
      if(navigator.share){
        navigator.share({title: v.title, url: url}).catch(function(){});
      } else {
        try{ navigator.clipboard.writeText(url); showToast('🔗 Link copied'); }catch(_){}
      }
    });
    el.querySelector('[data-comment]').addEventListener('click', function(e){
      e.stopPropagation();
      showToast('💬 Comments coming soon');
    });
    el.querySelector('[data-follow]').addEventListener('click', function(e){
      e.stopPropagation();
      var ch = v.channel || '';
      var nowFollow = toggleFollowed(ch);
      this.classList.toggle('followed', nowFollow);
      this.textContent = nowFollow ? 'Following' : 'Follow';
      showToast(nowFollow ? '✅ Following ' + ch : 'Unfollowed');
    });

    return el;
  }

  function activateItem(idx){
    var items = feedEl.querySelectorAll('.rp-item');
    items.forEach(function(item, i){
      var container = item.querySelector('[data-video-container]');
      if(!container) return;
      if(i === idx){
        if(!container.querySelector('iframe')){
          var v = videos[i];
          if(v){
            var url = buildEmbedUrl(v);
            if(url){
              var iframe = document.createElement('iframe');
              iframe.src = url;
              iframe.setAttribute('frameborder','0');
              iframe.setAttribute('allow','accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen; web-share');
              iframe.setAttribute('allowfullscreen','');
              iframe.setAttribute('allowtransparency','true');
              container.appendChild(iframe);
            }
          }
        }
        currentIdx = idx;
        var vv = videos[idx];
        if(vv && vv.thumbnail && bgEl){
          bgEl.style.backgroundImage = 'url(' + vv.thumbnail + ')';
        }
        if(vv) addToHistory(vv);
        try{
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: vv }
          }));
        }catch(_){}
      } else {
        if(Math.abs(i - idx) > 1){
          container.innerHTML = '';
        }
      }
    });
  }

  async function loadFeed(){
    try {
      // 1) Find clicked video across ALL types
      var clickedVideo = null;
      var types = ['anime','donghua','kdrama','movies'];
      for(var t = 0; t < types.length; t++){
        if(clickedVideo) break;
        try {
          var r = await fetch('/api/social-feed?type=' + types[t] + '&limit=50');
          var d = await r.json();
          if(d.success && d.videos){
            clickedVideo = d.videos.find(function(v){ return v.id === CURRENT_ID; });
          }
        }catch(_){}
      }

      // Fallback: build from ID prefix (proper source detect)
      if(!clickedVideo){
        clickedVideo = buildFallbackVideo(CURRENT_ID);
      }

      videos = [clickedVideo];
      seenIds[clickedVideo.id] = true;

      // 2) Load related portrait shorts
      var relatedTypes = ['anime','donghua'];
      for(var rt = 0; rt < relatedTypes.length; rt++){
        try {
          var rr = await fetch('/api/social-feed?type=' + relatedTypes[rt] + '&format=portrait&limit=25');
          var dd = await rr.json();
          if(dd.success && dd.videos){
            dd.videos.forEach(function(v){
              if(!seenIds[v.id] && (v.aspect === 'portrait' || v.source === 'youtube_shorts' || v.isShort)){
                videos.push(v);
                seenIds[v.id] = true;
              }
            });
          }
        }catch(_){}
      }

      // Render
      feedEl.innerHTML = '';
      videos.forEach(function(v, i){
        feedEl.appendChild(renderItem(v, i));
      });

      if(loadingEl) loadingEl.style.display = 'none';
      setTimeout(function(){ activateItem(0); }, 100);

    } catch(err){
      console.error('[reels]', err);
      if(loadingEl){
        loadingEl.innerHTML = '<div style="text-align:center;color:#fff;padding:20px;"><div style="font-size:2rem;margin-bottom:10px;">😔</div><div>Failed to load video</div><button onclick="history.back()" style="margin-top:20px;padding:10px 20px;background:rgba(192,132,252,0.3);border:1px solid rgba(192,132,252,0.6);color:#fff;border-radius:8px;cursor:pointer;">Go Back</button></div>';
      }
    }
  }

  var scrollTimer;
  feedEl.addEventListener('scroll', function(){
    if(scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function(){
      var idx = Math.round(feedEl.scrollTop / window.innerHeight);
      if(idx !== currentIdx){ activateItem(idx); }
    }, 100);
  }, { passive: true });

  function scrollToIdx(idx){
    if(idx < 0 || idx >= videos.length) return;
    feedEl.scrollTo({ top: idx * window.innerHeight, behavior: 'smooth' });
  }
  if(arrowUp) arrowUp.addEventListener('click', function(){ scrollToIdx(currentIdx - 1); });
  if(arrowDown) arrowDown.addEventListener('click', function(){ scrollToIdx(currentIdx + 1); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowDown' || e.key === 'j'){ e.preventDefault(); scrollToIdx(currentIdx + 1); }
    else if(e.key === 'ArrowUp' || e.key === 'k'){ e.preventDefault(); scrollToIdx(currentIdx - 1); }
    else if(e.key === 'Escape'){ goBack(); }
  });

  function goBack(){
    if(document.referrer && document.referrer.indexOf(window.location.origin) === 0){
      history.back();
    } else {
      window.location.href = '/';
    }
  }
  if(backBtn) backBtn.addEventListener('click', goBack);

  loadFeed();
})();
</script>
