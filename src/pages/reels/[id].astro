---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Watch" description="Premium video experience">
  <div class="reels-page">

    <!-- ═══ TOP BAR ═══ -->
    <div class="reels-top">
      <button class="reels-icon-btn" id="reelsBack" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>

      <div class="reels-brand">
        <span class="reels-brand-grad">Ani</span><span class="reels-brand-white">Tube</span><span class="reels-brand-grad">Buzz</span>
      </div>

      <div class="reels-menu-wrap">
        <button class="reels-icon-btn" id="reelsMenuBtn" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
          </svg>
        </button>
        <div class="reels-menu" id="reelsMenu">
          <button class="reels-menu-item" data-action="save">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Save</span>
          </button>
          <button class="reels-menu-item" data-action="copy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <span>Copy Link</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ═══ LOADER ═══ -->
    <div id="reelsLoader" class="reels-loader">
      <div class="reels-loader-orb">
        <div class="reels-loader-ring"></div>
        <div class="reels-loader-ring reels-loader-ring-2"></div>
        <div class="reels-loader-core"></div>
      </div>
      <p class="reels-loader-text">Loading premium experience</p>
    </div>

    <!-- ═══ SCROLL CONTAINER ═══ -->
    <div id="reelsScroller" class="reels-scroller" style="display:none;"></div>

    <!-- ═══ SIDE PROGRESS ═══ -->
    <div id="reelsProgress" class="reels-progress" style="display:none;">
      <div class="reels-progress-track">
        <div class="reels-progress-fill" id="reelsProgressFill"></div>
      </div>
      <div class="reels-progress-count" id="reelsProgressCount">1 / 1</div>
    </div>

    <!-- ═══ SCROLL HINT ═══ -->
    <div id="reelsHint" class="reels-hint">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
      <span>Scroll for next</span>
    </div>

    <!-- ═══ TOAST ═══ -->
    <div id="reelsToast" class="reels-toast"></div>

  </div>
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('reelsLoader');
  var scroller = document.getElementById('reelsScroller');
  var progress = document.getElementById('reelsProgress');
  var progressFill = document.getElementById('reelsProgressFill');
  var progressCount = document.getElementById('reelsProgressCount');
  var hint = document.getElementById('reelsHint');
  var back = document.getElementById('reelsBack');
  var menuBtn = document.getElementById('reelsMenuBtn');
  var menu = document.getElementById('reelsMenu');
  var toast = document.getElementById('reelsToast');

  var allVideos = [];
  var currentIdx = 0;
  var hintTimeout = null;
  var STATE_KEY = 'reels_state_v1';

  function esc(s) { return String(s || '').replace(/[&<>"']/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  // ═══════════════════════════════════════════════
  // 🎯 SMART ASPECT RATIO DETECTION
  // ═══════════════════════════════════════════════
  function detectAspect(video) {
    // Content type-based hints (most reliable)
    var type = (video.type || '').toLowerCase();
    var source = (video.source || '').toLowerCase();
    var title = (video.title || '').toLowerCase();

    // TikTok, Instagram Reels, YouTube Shorts = portrait
    if (source === 'tiktok' || source === 'reels' || source === 'shorts') return 'portrait';
    if (/#shorts?\b|\bshorts?\b|vertical|reel/i.test(title)) return 'portrait';

    // Movies, k-drama, donghua, anime = landscape (widescreen cinematic)
    if (type === 'movies' || type === 'movie' || type === 'kdrama' || type === 'k-drama' ||
        type === 'donghua' || type === 'anime' || type === 'series' || type === 'episode') {
      return 'landscape';
    }

    // Check embed URL hints
    var url = (video.embedUrl || '').toLowerCase();
    if (/shorts/.test(url)) return 'portrait';

    // Default: landscape (most content is 16:9)
    return 'landscape';
  }

  // ═══════════════════════════════════════════════
  // 🔙 SMART BACK NAVIGATION
  // ═══════════════════════════════════════════════
  function saveNavState() {
    try {
      sessionStorage.setItem(STATE_KEY, JSON.stringify({
        fromReelId: id,
        currentReelId: allVideos[currentIdx] ? allVideos[currentIdx].id : id,
        currentIdx: currentIdx,
        timestamp: Date.now()
      }));
    } catch(e) {}
  }

  function smartGoBack() {
    saveNavState();
    // Priority 1: Real history back if we came from within site
    var ref = document.referrer;
    var thisOrigin = window.location.origin;

    if (ref && ref.indexOf(thisOrigin) === 0 && ref !== window.location.href) {
      // Came from same site → history.back preserves position
      window.history.back();
    } else if (window.history.length > 1) {
      window.history.back();
    } else {
      // Direct visit → go home
      window.location.href = '/';
    }
  }

  back.addEventListener('click', smartGoBack);

  // Also handle keyboard Esc as back
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'Escape') {
      e.preventDefault();
      smartGoBack();
    } else if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      scrollToSlot(currentIdx + 1);
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      scrollToSlot(currentIdx - 1);
    }
  });

  // ═══════════════════════════════════════════════
  // 📱 MENU
  // ═══════════════════════════════════════════════
  menuBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    menu.classList.toggle('reels-menu-open');
  });
  document.addEventListener('click', function(e) {
    if (!menuBtn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.remove('reels-menu-open');
    }
  });

  menu.addEventListener('click', function(e) {
    var btn = e.target.closest('.reels-menu-item');
    if (!btn) return;
    var action = btn.dataset.action;
    var v = allVideos[currentIdx];
    if (!v) return;

    if (action === 'save') {
      try {
        var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
        var idx = saved.findIndex(function(x) { return x.id === v.id; });
        if (idx >= 0) {
          saved.splice(idx, 1);
          showToast('Removed from saved', '✕');
        } else {
          saved.push({
            id: v.id, title: v.title, thumbnail: v.thumbnail,
            channel: v.channel, type: v.type, savedAt: Date.now()
          });
          showToast('Saved to library', '✓');
          notifySafiya('save', v);
        }
        localStorage.setItem('savedVideos', JSON.stringify(saved));
      } catch(err) { console.warn(err); }
    } else if (action === 'copy') {
      try {
        navigator.clipboard.writeText(window.location.href);
        showToast('Link copied', '✓');
      } catch(err) {
        showToast('Copy failed', '✕');
      }
    }
    menu.classList.remove('reels-menu-open');
  });

  function showToast(msg, icon) {
    toast.innerHTML = '<span class="reels-toast-icon">' + (icon || '✓') + '</span><span>' + esc(msg) + '</span>';
    toast.classList.add('reels-toast-show');
    setTimeout(function() { toast.classList.remove('reels-toast-show'); }, 2200);
  }

  // ═══════════════════════════════════════════════
  // 💜 SAFIYA INTEGRATION
  // ═══════════════════════════════════════════════
  function notifySafiya(type, video) {
    try {
      var deviceId = '';
      try { deviceId = localStorage.getItem('safiya_v13:device_id') || ''; } catch(e) {}
      var memoryKey = deviceId ? 'safiya_v13:memory:' + deviceId : null;

      var memRaw = null;
      if (memoryKey) memRaw = localStorage.getItem(memoryKey);
      if (!memRaw) memRaw = localStorage.getItem('safiya_memory');
      var memory = memRaw ? JSON.parse(memRaw) : {};

      if (!memory.behavior) memory.behavior = {};
      if (!memory.behavior.watchHistory) memory.behavior.watchHistory = [];
      if (!memory.behavior.savedVideos) memory.behavior.savedVideos = [];

      var record = {
        id: video.id, title: video.title, type: video.type || 'video',
        channel: video.channel || '', source: video.source || '',
        time: Date.now(), action: type
      };

      if (type === 'save') {
        memory.behavior.savedVideos.unshift(record);
        memory.behavior.savedVideos = memory.behavior.savedVideos.slice(0, 40);
      } else {
        memory.behavior.watchHistory.unshift(record);
        memory.behavior.watchHistory = memory.behavior.watchHistory.slice(0, 40);
      }
      memory.behavior.currentlyWatching = record;

      if (memoryKey) localStorage.setItem(memoryKey, JSON.stringify(memory));
      localStorage.setItem('safiya_memory', JSON.stringify(memory));

      window.dispatchEvent(new CustomEvent('safiya:video-event', {
        detail: { action: type, video: video, title: video.title, type: video.type }
      }));
      window.dispatchEvent(new CustomEvent('reels:' + type, {
        detail: { id: video.id, title: video.title, type: video.type }
      }));

      if (window.Safiya && typeof window.Safiya.say === 'function') {
        var lines = {
          save: ['saved that? nice pick', 'good taste ✨', 'adding to your library 💜'],
          watch: {
            movies: ['movie mode activated 🍿', 'peak cinema right here', 'good taste bestie'],
            kdrama: ['k-drama? im so here 💕', 'plot better be crazy', 'leads better have chemistry'],
            donghua: ['ooh donghua? underrated fr', 'animation slaps', 'cultivation arcs hit'],
            anime: ['elite taste 👀', 'im invested bestie', 'the vibes ✨']
          }
        };
        var msgList = type === 'save' ? lines.save : (lines.watch[video.type] || lines.watch.anime);
        var msg = msgList[Math.floor(Math.random() * msgList.length)];
        setTimeout(function() { window.Safiya.say(msg, 4200); }, 400);
      }
    } catch(err) { console.warn('Safiya notify failed:', err); }
  }

  // ═══════════════════════════════════════════════
  // 🎬 BUILD SLOT (aspect-aware)
  // ═══════════════════════════════════════════════
  function buildSlot(video, idx) {
    var aspect = detectAspect(video);
    var slot = document.createElement('div');
    slot.className = 'reels-slot reels-slot-' + aspect;
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;
    slot.dataset.aspect = aspect;

    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="reels-slot-bg" loading="lazy" />' : '';

    slot.innerHTML =
      thumb +
      '<div class="reels-slot-tint"></div>' +
      '<div class="reels-slot-frame">' +
        '<div class="reels-slot-video" data-video-slot="' + idx + '"></div>' +
        '<div class="reels-slot-loading" data-loading="' + idx + '">' +
          '<div class="reels-slot-spinner"></div>' +
        '</div>' +
      '</div>' +
      '<div class="reels-slot-gradient"></div>' +
      '<div class="reels-slot-info">' +
        '<div class="reels-slot-user">' +
          '<div class="reels-slot-avatar">' +
            '<div class="reels-slot-avatar-inner">▶</div>' +
          '</div>' +
          '<div class="reels-slot-user-text">' +
            '<div class="reels-slot-username">' + esc(video.channel || 'AniTube') + '</div>' +
            '<div class="reels-slot-type">' + esc((video.type || 'video').toUpperCase()) + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="reels-slot-caption">' + esc(video.title || 'Video') + '</div>' +
      '</div>';

    return slot;
  }

  // ═══════════════════════════════════════════════
  // 🎥 LOAD / UNLOAD IFRAME
  // ═══════════════════════════════════════════════
  function loadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.reels-slot-video');
    var loading = slot.querySelector('.reels-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded === '1') return;

    videoDiv.dataset.loaded = '1';
    var video = allVideos[idx];
    if (!video || !video.embedUrl) return;

    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0&queue-enable=0';
    } else if (video.source === 'youtube') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0&playsinline=1';
    }

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');

    iframe.onload = function() {
      if (loading) loading.style.opacity = '0';
      setTimeout(function() {
        if (loading) loading.style.display = 'none';
      }, 400);
    };

    videoDiv.appendChild(iframe);
  }

  function unloadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.reels-slot-video');
    var loading = slot.querySelector('.reels-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded !== '1') return;

    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    if (loading) {
      loading.style.display = 'flex';
      loading.style.opacity = '1';
    }
  }

  // ═══════════════════════════════════════════════
  // 📍 SET CURRENT
  // ═══════════════════════════════════════════════
  var currentSetTimeout = null;
  function setCurrentIdx(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length) return;
    if (newIdx === currentIdx) return;

    currentIdx = newIdx;

    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' · AniTubeBuzz';
      }
    } catch(e) {}

    for (var i = 0; i < allVideos.length; i++) {
      if (Math.abs(i - newIdx) <= 1) loadVideoInSlot(i);
      else if (Math.abs(i - newIdx) > 2) unloadVideoInSlot(i);
    }

    clearTimeout(currentSetTimeout);
    currentSetTimeout = setTimeout(function() {
      var video = allVideos[newIdx];
      if (video) notifySafiya('watch', video);
    }, 2000);

    updateProgress();
    saveNavState();
  }

  function updateProgress() {
    if (!progress || !allVideos.length) return;
    var pct = ((currentIdx + 1) / allVideos.length) * 100;
    if (progressFill) progressFill.style.height = pct + '%';
    if (progressCount) progressCount.textContent = (currentIdx + 1) + ' / ' + allVideos.length;
  }

  // ═══════════════════════════════════════════════
  // 👁️ INTERSECTION OBSERVER
  // ═══════════════════════════════════════════════
  var slotObserver = null;
  function setupObserver() {
    if (slotObserver) slotObserver.disconnect();
    slotObserver = new IntersectionObserver(function(entries) {
      var mostVisible = null, maxRatio = 0;
      entries.forEach(function(entry) {
        if (entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          mostVisible = entry.target;
        }
      });
      if (mostVisible && maxRatio > 0.6) {
        var idx = parseInt(mostVisible.dataset.idx);
        if (!isNaN(idx) && idx !== currentIdx) setCurrentIdx(idx);
      }
    }, { root: scroller, threshold: [0.3, 0.6, 0.9] });

    scroller.querySelectorAll('.reels-slot').forEach(function(slot) {
      slotObserver.observe(slot);
    });
  }

  function scrollToSlot(idx) {
    if (idx < 0 || idx >= allVideos.length) return;
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function scheduleHintHide() {
    hintTimeout = setTimeout(function() {
      if (hint) hint.classList.add('reels-hint-hide');
    }, 4000);
  }

  scroller.addEventListener('scroll', function() {
    if (hint && !hint.classList.contains('reels-hint-hide')) {
      hint.classList.add('reels-hint-hide');
      clearTimeout(hintTimeout);
    }
  }, { passive: true });

  // Handle browser back button (popstate)
  window.addEventListener('popstate', function() {
    saveNavState();
  });

  // Save state on page unload
  window.addEventListener('beforeunload', saveNavState);
  window.addEventListener('pagehide', saveNavState);

  // ═══════════════════════════════════════════════
  // 🚀 INIT
  // ═══════════════════════════════════════════════
  async function init() {
    try {
      var fetched = [];
      var found = null;

      for (var i = 1; i <= 3; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          if (!res.ok) continue;
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) found = data.videos.find(function(v) { return v.id === id; });
          }
        } catch(e) {}
      }

      if (!found && fetched.length > 0) found = fetched[0];

      if (!found || !fetched.length) {
        loader.innerHTML =
          '<div style="text-align:center;color:#fff;">' +
          '<h1 style="font-family:\'Bricolage Grotesque\',sans-serif;margin-bottom:1rem;font-size:1.6rem;">Video Not Available</h1>' +
          '<a href="/" style="color:#c084fc;font-weight:700;text-decoration:none;padding:12px 28px;border:1.5px solid #c084fc;border-radius:999px;display:inline-block;">← Back to Home</a>' +
          '</div>';
        return;
      }

      var seen = {};
      allVideos = fetched.filter(function(v) {
        if (!v || !v.id || seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });

      var foundIdx = allVideos.findIndex(function(v) { return v.id === found.id; });
      if (foundIdx > 0) {
        var arr = allVideos.splice(foundIdx, 1);
        allVideos.unshift(arr[0]);
      } else if (foundIdx < 0) {
        allVideos.unshift(found);
      }

      scroller.innerHTML = '';
      allVideos.forEach(function(v, i) {
        scroller.appendChild(buildSlot(v, i));
      });

      loader.style.opacity = '0';
      setTimeout(function() { loader.style.display = 'none'; }, 400);
      scroller.style.display = 'block';
      progress.style.display = 'flex';
      if (hint) hint.classList.add('reels-hint-show');
      scheduleHintHide();

      currentIdx = -1;
      setCurrentIdx(0);
      setupObserver();

    } catch(err) {
      console.error('[Reels]', err);
      loader.innerHTML = '<div style="color:#fff;text-align:center;"><h1>Error loading videos</h1><a href="/" style="color:#c084fc;">← Home</a></div>';
    }
  }

  init();
})();
</script>

<style is:global>
  html, body {
    background: #000 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 100vh !important;
    height: 100dvh !important;
  }
  #app, main {
    background: #000 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  body:has(.reels-page) .site-header,
  body:has(.reels-page) header:not(.reels-page header),
  body:has(.reels-page) footer,
  body:has(.reels-page) #btt,
  body:has(.reels-page) #back-to-top,
  body:has(.reels-page) .back-to-top,
  body:has(.reels-page) .btt {
    display: none !important;
    visibility: hidden !important;
  }
</style>

<style>
  /* ═══════════════════════════════════════════════
     🎬 REELS PAGE
  ═══════════════════════════════════════════════ */
  .reels-page {
    position: fixed;
    inset: 0;
    background: #000;
    color: #fff;
    display: flex;
    flex-direction: column;
    z-index: 500;
    font-family: 'Inter', 'DM Sans', -apple-system, sans-serif;
    overflow: hidden;
  }

  /* ═══ TOP BAR ═══ */
  .reels-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 70%, transparent);
    pointer-events: none;
  }

  .reels-icon-btn {
    pointer-events: auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 0;
  }
  .reels-icon-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.06);
  }
  .reels-icon-btn:active { transform: scale(0.94); }

  .reels-brand {
    text-align: center;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    pointer-events: none;
    white-space: nowrap;
    line-height: 1;
  }
  .reels-brand-grad {
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
