---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { id } = Astro.params;
const videoId = id || '';

// ═══ Detect if this is AnimoTVSlash anime iframe (anime_slug_ep{n}) ═══
const animeMatch = videoId.match(/^anime_(.+)_ep(\d+)$/);
const isAnimeExternal = !!animeMatch;
const animeSlug = animeMatch ? animeMatch[1] : '';
const animeEpNum = animeMatch ? parseInt(animeMatch[2]) : 0;

// ═══ Server-side: Fetch anime data if external ═══
let externalAnime = null;
if (isAnimeExternal) {
  try {
    const url = new URL('/api/anime-external', Astro.url.origin);
    url.searchParams.set('action', 'detail');
    url.searchParams.set('slug', animeSlug);
    const res = await fetch(url);
    if (res.ok) {
      const data = await res.json();
      if (data.success) externalAnime = data;
    }
  } catch (e) {}
}

function getPlatformData(vid) {
  // AnimoTVSlash anime
  if (vid.startsWith('anime_')) {
    const m = vid.match(/^anime_(.+)_ep(\d+)$/);
    if (m) {
      return {
        source: 'animotv',
        embedUrl: `https://animotvslash.org/${m[1]}-episode-${m[2]}/`,
        aspect: 'landscape',
        isShort: false
      };
    }
  }
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return {
      source: 'youtube_shorts',
      embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1&autoplay=1`,
      aspect: 'portrait',
      isShort: true
    };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return {
      source: 'youtube',
      embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1&autoplay=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return {
      source: 'dailymotion',
      embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0&ui-logo=0&sharing-enable=0`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return {
      source: 'bilibili',
      embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1&high_quality=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  return null;
}

function generateThumbnail(vid, apiThumbnail = '') {
  if (apiThumbnail && apiThumbnail.trim()) return apiThumbnail;
  if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
    return `https://i.ytimg.com/vi/${vid.replace(/^(yts_|yt_)/, '')}/hqdefault.jpg`;
  }
  if (vid.startsWith('dm_')) {
    return `https://www.dailymotion.com/thumbnail/video/${vid.replace('dm_', '')}`;
  }
  return '';
}

function extractSeriesFromTitle(title) {
  let t = (title || '').toLowerCase();
  t = t.replace(/\bep(?:isode)?\s*\d+.*/i, '');
  t = t.replace(/\bseason\s\d+.*/i, '');
  t = t.replace(/\bs\d+e\d+.*/i, '');
  t = t.replace(/\b\d+\s*(?:sub|dub|eng|hd|full).*/i, '');
  t = t.replace(/\[[^\]]*\]/g, '');
  t = t.replace(/\([^)]*\)/g, '');
  t = t.replace(/[^\w\s]/g, ' ');
  t = t.replace(/\s+/g, ' ').trim();
  return t.slice(0, 50);
}

let video = null;
let allVideos = [];

// ═══ Build video object ═══
if (isAnimeExternal && externalAnime) {
  const platformData = getPlatformData(videoId);
  video = {
    id: videoId,
    title: `${externalAnime.title} - Episode ${animeEpNum}`,
    channel: 'AniTubeBuzz',
    thumbnail: externalAnime.poster || '',
    embedUrl: platformData.embedUrl,
    source: 'animotv',
    aspect: 'landscape',
    isShort: false,
    type: 'anime',
    description: externalAnime.description || '',
    isAnimeExternal: true,
    animeSlug: animeSlug,
    episodeNumber: animeEpNum,
    totalEpisodes: externalAnime.episodes ? externalAnime.episodes.length : 26,
  };
} else {
  // Existing logic for normal videos
  try {
    const apiUrl = new URL('/api/social-feed', Astro.url.origin);
    apiUrl.searchParams.set('limit', '100');
    apiUrl.searchParams.set('format', 'all');
    const response = await fetch(apiUrl);
    if (response.ok) {
      const data = await response.json();
      allVideos = data.videos || [];
      video = allVideos.find(v => v.id === videoId);
    }
  } catch (e) {}

  if (!video) {
    const platformData = getPlatformData(videoId);
    if (platformData) {
      video = {
        id: videoId,
        title: 'Video',
        channel: 'AniTube',
        thumbnail: generateThumbnail(videoId, ''),
        embedUrl: platformData.embedUrl,
        source: platformData.source,
        aspect: platformData.aspect,
        isShort: platformData.isShort,
        type: 'anime',
        description: ''
      };
    } else {
      video = {
        id: videoId,
        title: 'Video',
        channel: 'AniTubeBuzz',
        thumbnail: '',
        embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0&autoplay=1`,
        source: 'youtube',
        aspect: 'landscape',
        isShort: false,
        type: 'anime',
        description: ''
      };
    }
  } else {
    if (!video.thumbnail || !video.thumbnail.trim()) video.thumbnail = generateThumbnail(videoId, '');
    if (!video.description) video.description = '';
  }
}

const seriesName = extractSeriesFromTitle(video.title);
const displayChannel = (video.channel || 'AniTube').trim();
const videoAspect = video.aspect || (video.isShort ? 'portrait' : 'landscape');
const typeLabels = { anime: 'Anime', kdrama: 'K-Drama', donghua: 'Donghua', movies: 'Movie' };
const typeLabel = typeLabels[video.type] || 'Video';

let publishText = '';
if (video.publishedAt) {
  try {
    const d = new Date(video.publishedAt);
    const diff = Math.floor((Date.now() - d.getTime()) / (1000 * 60 * 60 * 24));
    if (diff < 1) publishText = 'Today';
    else if (diff < 7) publishText = diff + ' days ago';
    else if (diff < 30) publishText = Math.floor(diff / 7) + ' weeks ago';
    else if (diff < 365) publishText = Math.floor(diff / 30) + ' months ago';
    else publishText = Math.floor(diff / 365) + ' years ago';
  } catch (e) {}
}

const description = (video.description || '').trim();
const hasDescription = description.length > 0;
const metaParts = ['HD', typeLabel];
if (publishText) metaParts.push(publishText);
const metaText = metaParts.join(' • ');

// External anime episodes data for sidebar
const externalEpisodes = (isAnimeExternal && externalAnime) ? externalAnime.episodes : [];
---

<BaseLayout title={`${video.title} | AniTubeBuzz`}>
  <Header slot="header" />

  <section class="rp-section">
    <div class="rp-container">
      <div id="reels-root" 
           data-videoid={videoId} 
           data-aspect={videoAspect} 
           data-channel={displayChannel} 
           data-series={seriesName} 
           data-type={video.type}
           data-is-external={isAnimeExternal ? 'true' : 'false'}
           data-anime-slug={animeSlug}
           data-ep-num={animeEpNum}>
        <div class="rp-grid">

          <!-- MAIN COLUMN (LEFT) -->
          <div class="rp-main">

            <div class={`rp-player ${isAnimeExternal ? 'rp-player-external' : ''}`} id="videoCard" data-aspect={videoAspect}>
              <div class="rp-player-frame">
                {isAnimeExternal ? (
                  <div class="rp-external-wrap" id="externalWrap">
                       <iframe
                      id="videoFrame"
                      src={video.embedUrl}
                      title={video.title}
                      frameborder="0"
                      scrolling="no"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                      loading="eager"
                      sandbox="allow-scripts allow-same-origin allow-forms"
                      class="rp-ext-iframe"
                    ></iframe>
                    <div class="rp-ext-mask-top"></div>
                    <div class="rp-ext-mask-bottom"></div>
                    <div class="rp-ext-mask-left"></div>
                    <div class="rp-ext-mask-right"></div>
                    <div class="rp-ext-click-blocker rp-ext-blocker-bottom"></div>
                    <div class="rp-ext-click-blocker rp-ext-blocker-top"></div>
                    <div class="rp-ext-brand">
                      <span class="rp-ext-logo">AniTubeBuzz</span>
                      <span class="rp-ext-live">HD</span>
                    </div>
                   undefined
                  </div>
                ) : (
                  <iframe
                    id="videoFrame"
                    src={video.embedUrl}
                    title={video.title}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    loading="eager"
                  ></iframe>
                )}
                <div class="rp-vloader" id="videoLoader">
                  <div class="rp-orbit">
                    <div class="rp-dot rp-d1"></div>
                    <div class="rp-dot rp-d2"></div>
                    <div class="rp-dot rp-d3"></div>
                  </div>
                  <div class="rp-brand">AniTubeBuzz</div>
                </div>
                {!isAnimeExternal && (
                  <div class="rp-heart" id="doubleTapHeart">
                    <svg viewBox="0 0 24 24" fill="currentColor" style="width:100%;height:100%;">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </div>
                )}
              </div>
            </div>

            <h1 class="rp-title">{video.title}</h1>

            <div class="rp-meta-bar">
              <div class="rp-channel">
                <div class="rp-avatar"><span>{displayChannel.charAt(0).toUpperCase()}</span></div>
                <div class="rp-channel-info">
                  <div class="rp-channel-name">{displayChannel}</div>
                  <div class="rp-channel-meta">
                    <span class="rp-live"></span>
                    <span>{metaText}</span>
                  </div>
                </div>
              </div>
              <div class="rp-actions">
                <button class="rp-btn" id="likeBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Like</span>
                </button>
                <button class="rp-btn" id="saveBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Save</span>
                </button>
                <button class="rp-btn" id="sendBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Share</span>
                </button>
                <button class="rp-btn rp-btn-next" id="nextBtn">
                  <span class="rp-btn-lbl">Next</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            {hasDescription && (
              <div class="rp-desc">
                <div class="rp-desc-head">
                  <div class="rp-desc-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    <span>Description</span>
                  </div>
                  <button class="rp-desc-tgl" id="descToggle">Show more</button>
                </div>
                <div class="rp-desc-body" id="descContent">
                  <p>{description}</p>
                </div>
              </div>
            )}

            <!-- COMMENTS -->
            <section class="rp-comments">
              <div class="rp-comments-head">
                <h3 class="rp-comments-title"><span id="commentCount">0</span> Comments</h3>
                <button class="rp-sort-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="15" y2="12"></line>
                    <line x1="3" y1="18" x2="9" y2="18"></line>
                  </svg>
                  <span>Sort by</span>
                </button>
              </div>
              <div class="rp-comment-input-row">
                <div class="rp-my-av" id="userInitial">Y</div>
                <div class="rp-comment-input-wrap">
                  <input type="text" id="commentInput" class="rp-comment-input" placeholder="Add a comment..." maxlength="500" />
                  <div class="rp-comment-actions" id="commentActions" style="display:none;">
                    <button class="rp-cancel-btn" id="cancelComment">Cancel</button>
                    <button class="rp-submit-btn" id="submitComment">Comment</button>
                  </div>
                </div>
              </div>
              <div id="commentsList" class="rp-comments-list">
                <div class="rp-comments-empty"><p>No comments yet. Be the first! 💬</p></div>
              </div>
            </section>

            <!-- MORE LIKE THIS -->
            <section class="rp-more-section" id="moreSection">
              <div class="rp-section-head">
                <div class="rp-section-title">
                  <span class="rp-section-bar"></span>
                  <span>More Like This</span>
                </div>
                <div class="rp-section-tag">FOR YOU</div>
              </div>
              <div id="moreFeed" class="rp-feed-grid"></div>
              <div id="moreLoading" class="rp-more-loading">
                <div class="rp-spinner"></div>
                <span>Loading more...</span>
              </div>
            </section>

          </div>

          <!-- SIDEBAR (RIGHT) -->
          <aside class="rp-sidebar">
            <div class="rp-sidebar-head">
              <div class="rp-sidebar-title">
                <span class="rp-section-bar"></span>
                <span>{isAnimeExternal ? '📺 Episodes' : 'Up Next'}</span>
              </div>
              <label class="rp-autoplay-label">
                <span>Autoplay</span>
                <input type="checkbox" id="autoplayToggle" checked />
                <span class="rp-switch"></span>
              </label>
            </div>

            {isAnimeExternal && externalEpisodes.length > 0 && (
              <div id="externalEpisodes" class="rp-ext-episodes">
                {externalEpisodes.map(ep => (
                  <a class={`rp-ext-ep-card ${ep.number === animeEpNum ? 'active' : ''}`} 
                     href={`/reels/${ep.embedId}`}
                     data-ep-num={ep.number}>
                    <div class="rp-ext-ep-thumb">
                      {ep.thumbnail ? (
                        <img src={ep.thumbnail} alt={`Episode ${ep.number}`} loading="lazy" onerror="this.style.opacity=0.3" />
                      ) : (
                        <div class="rp-ext-ep-num-fallback">{ep.number}</div>
                      )}
                      <div class="rp-ext-ep-num-badge">{ep.number}</div>
                      {ep.number === animeEpNum && <div class="rp-ext-ep-active-overlay"></div>}
                    </div>
                    <div class="rp-ext-ep-info">
                      <div class="rp-ext-ep-title">Episode {ep.number}</div>
                      <div class="rp-ext-ep-meta">{ep.number === animeEpNum ? '▶ Playing now' : 'Click to watch'}</div>
                    </div>
                    {ep.number === animeEpNum && <div class="rp-ext-ep-playing"><span></span><span></span><span></span></div>}
                  </a>
                ))}
              </div>
            )}

            {!isAnimeExternal && (
              <div id="relatedFeed" class="rp-side-list"></div>
            )}
          </aside>

        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <style is:global>
    /* ============ RESET & BASE ============ */
    .rp-section {
      background: #0a0517;
      min-height: 100vh;
      padding: 20px 0 60px;
    }
    .rp-container {
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .rp-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: 24px;
      align-items: start;
    }
    .rp-main { min-width: 0; }
    .rp-sidebar {
      position: sticky;
      top: 80px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      overflow-x: hidden;
      padding-right: 4px;
    }
    .rp-sidebar::-webkit-scrollbar { width: 6px; }
    .rp-sidebar::-webkit-scrollbar-track { background: transparent; }
    .rp-sidebar::-webkit-scrollbar-thumb {
      background: rgba(192, 132, 252, 0.3);
      border-radius: 3px;
    }

    /* ============ PLAYER ============ */
      .rp-player {
      width: 100%;
      background: #000;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(192, 132, 252, 0.2);
      isolation: isolate;
    }
    .rp-player-frame {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000;
      overflow: hidden;
    }
    .rp-player-external {
      overflow: hidden !important;
    }
    .rp-player-external .rp-external-wrap * {
      -webkit-tap-highlight-color: transparent;
    }
    .rp-player[data-aspect="portrait"] .rp-player-frame {
      padding-top: min(85vh, 900px);
      max-width: 500px;
      margin: 0 auto;
    }
    .rp-player-frame > iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

        /* ============ EXTERNAL ANIME IFRAME (STEALTH VIDEO ONLY) ============ */
    .rp-player-external .rp-player-frame {
      padding-top: 56.25%;
      background: #000;
      overflow: hidden;
    }
    .rp-external-wrap {
      position: absolute;
      inset: 0;
      overflow: hidden !important;
      background: #000;
    }
    /* IFRAME: Large size, positioned so ONLY video player rectangle visible */
    /* AnimoTV video player location: ~340px from top, ~600px tall on 1280 width */
       .rp-ext-iframe {
      position: absolute;
      top: -420px;
      left: -20px;
      width: calc(100% + 40px);
      height: calc(100% + 720px);
      border: 0;
      overflow: hidden !important;
    }
    /* FULLSCREEN */
    .rp-external-wrap:fullscreen {
      background: #000;
      width: 100vw;
      height: 100vh;
    }
    .rp-external-wrap:fullscreen .rp-ext-iframe,
    .rp-external-wrap:-webkit-full-screen .rp-ext-iframe {
      top: -520px;
      height: calc(100% + 1100px);
    }
    /* MASKS — hide everything except video area */
    .rp-ext-mask-top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 0;
      background: #000;
      z-index: 12;
      pointer-events: auto;
    }
        .rp-ext-mask-bottom {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 0;
      background: #000;
      z-index: 12;
      pointer-events: none;
    }
    .rp-ext-mask-left {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 0;
      background: #000;
      z-index: 12;
      pointer-events: auto;
    }
    .rp-ext-mask-right {
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 0;
      background: #000;
      z-index: 12;
      pointer-events: auto;
    }
    /* CLICK BLOCKERS — user cannot click auto-play/download/etc */
    .rp-ext-click-blocker {
      position: absolute;
      left: 0;
      right: 0;
      background: transparent;
      z-index: 13;
      cursor: default;
    }
    .rp-ext-blocker-bottom {
      bottom: 0;
      height: 100px;
    }
    .rp-ext-blocker-top {
      top: 0;
      height: 0;
    }
    /* BRAND WATERMARK */
    .rp-ext-brand {
      position: absolute;
      top: 14px;
      right: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(12px);
      border-radius: 22px;
      z-index: 15;
      pointer-events: none;
      opacity: 0;
      animation: rpBrandFade 5s ease-out 1.5s forwards;
      border: 1px solid rgba(192, 132, 252, 0.3);
    }
    @keyframes rpBrandFade {
      0% { opacity: 0; transform: translateY(-8px); }
      12% { opacity: 1; transform: translateY(0); }
      88% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-4px); }
    }
    .rp-ext-logo {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      font-size: 12px;
      background: linear-gradient(135deg, #c084fc, #e879f9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.3px;
    }
    .rp-ext-live {
      display: inline-block;
      padding: 2px 7px;
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
      font-size: 9px;
      font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 1px;
      border-radius: 4px;
      box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
    }
    /* CUSTOM CONTROLS BAR — our own fullscreen button */
    .rp-ext-controls {
      position: absolute;
      bottom: 12px;
      right: 14px;
      z-index: 20;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    .rp-external-wrap:hover .rp-ext-controls {
      opacity: 1;
      pointer-events: auto;
    }
    .rp-ext-ctrl-bar {
      display: flex;
      gap: 8px;
      padding: 6px;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(14px);
      border-radius: 24px;
      border: 1px solid rgba(192, 132, 252, 0.25);
    }
    .rp-ext-fs-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(192, 132, 252, 0.2), rgba(232, 121, 249, 0.2));
      border: 1px solid rgba(192, 132, 252, 0.35);
      color: #fff;
      cursor: pointer;
      transition: all 0.2s;
    }
    .rp-ext-fs-btn:hover {
      background: linear-gradient(135deg, #c084fc, #e879f9);
      transform: scale(1.08);
      box-shadow: 0 4px 16px rgba(192, 132, 252, 0.5);
    }
    /* ============ NORMAL PLAYER LOADER ============ */
    .rp-vloader {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #0a0517 0%, #1a0f3d 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      z-index: 5;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .rp-vloader.hidden { opacity: 0; }
    .rp-orbit { position: relative; width: 60px; height: 60px; }
    .rp-dot {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c084fc, #e879f9);
      top: 50%;
      left: 50%;
      transform-origin: 0 0;
      animation: rpOrbit 1.4s linear infinite;
    }
    .rp-d1 { animation-delay: 0s; }
    .rp-d2 { animation-delay: -0.47s; background: linear-gradient(135deg, #e879f9, #7dd3fc); }
    .rp-d3 { animation-delay: -0.94s; background: linear-gradient(135deg, #7dd3fc, #c084fc); }
    @keyframes rpOrbit {
      0% { transform: rotate(0deg) translateX(24px) rotate(0deg); }
      100% { transform: rotate(360deg) translateX(24px) rotate(-360deg); }
    }
    .rp-brand {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-size: 14px;
      letter-spacing: 1px;
    }
    .rp-heart {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100px;
      height: 100px;
      color: #ff3366;
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      pointer-events: none;
      z-index: 10;
      filter: drop-shadow(0 0 20px rgba(255, 51, 102, 0.8));
    }
    .rp-heart.pop { animation: rpHeartPop 0.9s ease-out; }
    @keyframes rpHeartPop {
      0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
      30% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
      60% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
    }

    /* ============ TITLE & META ============ */
    .rp-title {
