      function saveToHistory() {
        try {
          var hist = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          hist = hist.filter(function(h) { return h.id !== currentId; });
          hist.unshift({ id: currentId, title: currentVideo.title, channel: currentVideo.channel, thumbnail: currentVideo.thumbnail, type: currentVideo.type, watchedAt: Date.now() });
          if (hist.length > 100) hist = hist.slice(0, 100);
          localStorage.setItem('anitube_history', JSON.stringify(hist));
        } catch (e) {}
      }
      function isLiked() { try { return JSON.parse(localStorage.getItem('anitube_liked') || '[]').indexOf(currentId) !== -1; } catch (e) { return false; } }
      function isSaved() { try { return JSON.parse(localStorage.getItem('anitube_saved') || '[]').some(function(s) { return s.id === currentId; }); } catch (e) { return false; } }
      function toggleLike() {
        try {
          var liked = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
          var idx = liked.indexOf(currentId);
          if (idx === -1) liked.push(currentId); else liked.splice(idx, 1);
          localStorage.setItem('anitube_liked', JSON.stringify(liked));
          updateLikeBtn();
        } catch (e) {}
      }
      function toggleSave() {
        try {
          var saved = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
          var idx = -1;
          for (var i = 0; i < saved.length; i++) if (saved[i].id === currentId) { idx = i; break; }
          if (idx === -1) {
            saved.unshift({ id: currentId, title: currentVideo.title, channel: currentVideo.channel, thumbnail: currentVideo.thumbnail, type: currentVideo.type, savedAt: Date.now() });
          } else saved.splice(idx, 1);
          localStorage.setItem('anitube_saved', JSON.stringify(saved));
          updateSaveBtn();
        } catch (e) {}
      }
