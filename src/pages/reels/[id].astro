                    <label class="rp-autoplay-mini" title="Autoplay next episode">
                      <input type="checkbox" id="autoplayToggle" checked />
                      <span class="rp-switch-mini"></span>
                    </label>
                  </div>
                </div>

                <div class="rp-ep-body">
                  <div class="rp-ep-scroll" id="externalEpisodes">
                    {externalEpisodes.map((ep: any) => (
                      <a class={`rp-ext-ep-card ${ep.number === animeEpNum ? 'active' : ''}`} 
                         href={`/reels/${ep.embedId}`}
                         data-ep-num={ep.number}>
                        <div class="rp-ext-ep-thumb">
                          <img src={ep.thumbnail} alt={`Episode ${ep.number}`} loading="lazy" referrerpolicy="no-referrer" />
                          <div class="rp-ext-ep-overlay"></div>
                          <div class="rp-ext-ep-num-badge">EP {ep.number}</div>
                          {ep.number !== animeEpNum && (
                            <div class="rp-ext-ep-play-mini">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z"></path>
                              </svg>
