                          )}
                          {ep.number === animeEpNum && (
                            <div class="rp-ext-ep-playing-overlay">
                              <div class="rp-ext-ep-playing-wave">
                                <span></span><span></span><span></span><span></span>
                              </div>
                            </div>
                          )}
                        </div>
                        <div class="rp-ext-ep-info">
                          <div class="rp-ext-ep-title">Episode {ep.number}</div>
                          <div class="rp-ext-ep-meta">
                            {ep.number === animeEpNum ? (
                              <><span class="rp-ep-live-dot"></span> Playing now</>
                            ) : ep.hasRealThumb ? (
                              'Available HD'
                            ) : (
                              'Click to watch'
                            )}
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {!isAnimeExternal && (
              <>
                <div class="rp-sidebar-head">
                  <div class="rp-sidebar-title">
                    <span class="rp-section-bar"></span>
                    <span>Up Next</span>
