---
export const prerender = false;

const { id } = Astro.params;
const videoId = id || '';

// Helper to determine platform from ID prefix
function getPlatformData(vid: string) {
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return {
      source: 'youtube_shorts',
      embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1`,
      aspect: 'portrait',
      isShort: true
    };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return {
      source: 'youtube',
      embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return {
      source: 'dailymotion',
      embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0`,
      aspect: 'mixed', // DM can be both
      isShort: false
    };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return {
      source: 'bilibili',
      embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('ody_')) {
    const rawId = vid.replace('ody_', '');
    // Odysee format: name/claimId
    return {
      source: 'odysee',
      embedUrl: `https://odysee.com/$/embed/${rawId}`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('rmb_')) {
    const rawId = vid.replace('rmb_', '');
    return {
      source: 'rumble',
      embedUrl: `https://rumble.com/embed/${rawId}/`,
      aspect: 'landscape',
      isShort: false
    };
  }
  // Default fallback
  return null;
}

// Try to fetch from API first, fallback to constructed data
let video = null;
let relatedVideos = [];

try {
  const apiUrl = new URL('/api/social-feed', Astro.url.origin);
  apiUrl.searchParams.set('limit', '50');
  apiUrl.searchParams.set('format', 'all');
  
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    relatedVideos = data.videos || [];
    video = relatedVideos.find(v => v.id === videoId);
  }
} catch (e) {
  console.error('API fetch failed:', e);
}

// If not found in API, build fallback from ID
if (!video) {
  const platformData = getPlatformData(videoId);
  if (platformData) {
    video = {
      id: videoId,
      title: 'Video Content',
      channel: 'AniTube Channel',
      thumbnail: '',
      embedUrl: platformData.embedUrl,
      source: platformData.source,
      aspect: platformData.aspect,
      isShort: platformData.isShort,
      index: 0
    };
  } else {
    // Complete fallback
    video = {
      id: videoId,
      title: 'Anime Video',
      channel: 'AniTubeBuzz',
      thumbnail: '',
      embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0`,
      source: 'unknown',
      aspect: 'landscape',
      isShort: false,
      index: 0
    };
  }
}

// Calculate current index in feed for counter
const currentIndex = relatedVideos.findIndex(v => v.id === videoId) + 1 || 1;
const totalCount = relatedVideos.length || 134; // Fallback number

// Prepare next/prev IDs for navigation
const currentPos = relatedVideos.findIndex(v => v.id === videoId);
const nextVideo = relatedVideos[currentPos + 1];
const prevVideo = relatedVideos[currentPos - 1];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{video.title} | AniTubeBuzz Reels</title>
  <meta name="description" content={`Watch ${video.title} on AniTubeBuzz`} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style is:global>
    :root {
      --grad: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      --bg-deep: #0a0517;
      --bg-card: rgba(28,15,61,0.5);
      --border-color: rgba(192,132,252,0.3);
      --text-primary: #f5ecff;
      --text-secondary: rgba(255,255,255,0.75);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg-deep);
      font-family: 'DM Sans', sans-serif;
      color: var(--text-primary);
    }
    
    /* Hide scrollbar but keep functionality */
    body::-webkit-scrollbar {
      display: none;
    }
    body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>

<body>
  <div id="reels-root" class="reels-container" data-videoid={videoId} data-next={nextVideo?.id || ''} data-prev={prevVideo?.id || ''}>
    
    <!-- Top Navigation Bar -->
    <header class="top-bar">
      <a href="/" class="back-btn" aria-label="Go back">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
      
      <div class="brand">
        <span class="brand-text">AniTubeBuzz</span>
        <div class="brand-dot"></div>
      </div>
      
      <div class="counter">
        <span class="current">{currentIndex}</span>
        <span class="separator">/</span>
        <span class="total">{totalCount}</span>
      </div>
    </header>

    <!-- Main Video Area -->
    <main class="video-stage">
      
      <!-- Video Card with Glow -->
      <div class="video-card" id="videoCard">
        <div class="card-glow"></div>
        <div class="card-frame">
          <iframe 
            id="videoFrame"
            src={video.embedUrl}
            title={video.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="eager"
          ></iframe>
          
          <!-- Loading State -->
          <div class="video-loader" id="loader">
            <div class="spinner"></div>
          </div>
        </div>
      </div>

      <!-- Left Side Info (Instagram Style) -->
      <div class="info-panel">
        <div class="channel-row">
          <div class="channel-avatar">
            {video.channel.charAt(0).toUpperCase()}
          </div>
          <span class="channel-name">@{video.channel.replace(/\s+/g, '').toLowerCase()}</span>
        </div>
        <h1 class="video-title">{video.title}</h1>
        <p class="video-meta">AniTube Anime • HD</p>
      </div>

      <!-- Right Side Actions -->
      <div class="action-panel">
        <button class="action-btn like-btn" id="likeBtn" aria-label="Like video">
          <svg class="heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="action-label">Like</span>
        </button>
        
        <button class="action-btn send-btn" id="sendBtn" aria-label="Share video">
          <svg class="send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
          <span class="action-label">Send</span>
        </button>
      </div>

      <!-- Desktop Navigation Arrows -->
      <div class="desktop-nav">
        <button class="nav-arrow up-arrow" id="prevBtn" disabled={!prevVideo}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 15l-6-6-6 6"/>
          </svg>
        </button>
        <button class="nav-arrow down-arrow" id="nextBtn" disabled={!nextVideo}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>

    </main>

    <!-- Hidden data for JS -->
    <script is:inline define:vars={{ videoData: video, relatedData: relatedVideos }}>
      window.__REELS_DATA__ = {
        current: videoData,
        related: relatedData,
        index: {currentIndex}
      };
    </script>

  </div>

  <style>
    /* Container - Full Screen */
    .reels-container {
      width: 100vw;
      height: 100vh;
      height: 100dvh; /* Mobile viewport fix */
      background: linear-gradient(180deg, #0a0517 0%, #1a0f2e 50%, #0a0517 100%);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Ambient Background Blur */
    .reels-container::before {
      content: '';
      position: fixed;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at 50% 50%, rgba(192, 132, 252, 0.15) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    /* Top Bar */
    .top-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(10,5,23,0.9) 0%, transparent 100%);
    }

    .back-btn {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      border-radius: 50%;
      transition: background 0.2s;
      cursor: pointer;
      text-decoration: none;
    }

    .back-btn:hover {
      background: rgba(255,255,255,0.1);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .brand-text {
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 18px;
      background: var(--grad);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .brand-dot {
      width: 6px;
      height: 6px;
      background: #7dd3fc;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .counter {
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      background: rgba(255,255,255,0.1);
      padding: 6px 12px;
      border-radius: 20px;
      backdrop-filter: blur(10px);
    }

    .counter .current {
      color: #e879f9;
    }

    .counter .separator {
      margin: 0 4px;
      opacity: 0.5;
    }

    /* Main Stage - Center Everything */
    .video-stage {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 80px 20px;
      z-index: 1;
    }

    /* Video Card - 9:16 Aspect Ratio */
    .video-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      aspect-ratio: 9/16;
      max-height: 85vh;
      filter: drop-shadow(0 0 30px rgba(192, 132, 252, 0.4));
      transition: transform 0.3s ease;
    }

    .card-glow {
      position: absolute;
      inset: -2px;
      background: var(--grad);
      border-radius: 24px;
      opacity: 0.6;
      filter: blur(8px);
      z-index: -1;
      animation: glow-pulse 3s ease-in-out infinite;
    }

    @keyframes glow-pulse {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.02); }
    }

    .card-frame {
      width: 100%;
      height: 100%;
      background: #000;
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(192, 132, 252, 0.3);
    }

    .card-frame iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Loader */
    .video-loader {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      z-index: 10;
      transition: opacity 0.3s;
    }

    .video-loader.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(192, 132, 252, 0.3);
      border-top-color: #e879f9;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Info Panel - Bottom Left (Instagram Style) */
    .info-panel {
      position: absolute;
      bottom: 100px;
      left: 20px;
      z-index: 50;
      max-width: 300px;
      pointer-events: none; /* Let clicks pass through to video */
    }

    .channel-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .channel-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--grad);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      color: white;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .channel-name {
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 15px;
      color: white;
      text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .video-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: white;
      line-height: 1.3;
      margin-bottom: 6px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.8);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .video-meta {
      font-size: 13px;
      color: rgba(255,255,255,0.7);
      text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }

    /* Action Panel - Right Side Fixed */
    .action-panel {
      position: absolute;
      right: 20px;
      bottom: 100px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      z-index: 50;
    }

    .action-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
    }

    .action-btn:hover {
      transform: scale(1.1);
      background: rgba(255,255,255,0.2);
    }

    .action-btn:active {
      transform: scale(0.95);
    }

    .action-btn svg {
      width: 22px;
      height: 22px;
    }

    .action-btn.liked {
      color: #ff2d55;
      background: rgba(255, 45, 85, 0.2);
      border-color: rgba(255, 45, 85, 0.4);
    }

    .action-btn.liked svg {
      fill: currentColor;
    }

    .action-label {
      font-size: 10px;
      margin-top: 4px;
      font-weight: 600;
      opacity: 0.9;
    }

    /* Desktop Navigation Arrows */
    .desktop-nav {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      display: none;
      flex-direction: column;
      gap: 20px;
      z-index: 50;
    }

    .nav-arrow {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.2);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .nav-arrow:hover:not(:disabled) {
      background: rgba(255,255,255,0.2);
      transform: scale(1.1);
    }

    .nav-arrow:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .nav-arrow svg {
      width: 24px;
      height: 24px;
    }

    /* Show desktop nav on larger screens */
    @media (min-width: 1024px) {
      .desktop-nav {
        display: flex;
      }
      .action-panel {
        bottom: 120px;
        right: 30px;
      }
      .info-panel {
        left: 60px;
        bottom: 120px;
      }
    }

    /* Mobile Optimizations */
    @media (max-width: 640px) {
      .video-card {
        max-width: 100%;
        max-height: 100%;
        border-radius: 0;
        filter: none;
      }
      
      .card-frame {
        border-radius: 0;
        border: none;
      }
      
      .card-glow {
        display: none; /* No glow on mobile full screen */
      }
      
      .video-stage {
        padding: 0;
      }
      
      .top-bar {
        background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
      }
      
      .info-panel {
        left: 16px;
        bottom: 80px;
        max-width: 70%;
      }
      
      .action-panel {
        right: 16px;
        bottom: 80px;
        gap: 16px;
      }
      
      .action-btn {
        width: 44px;
        height: 44px;
      }
    }

    /* Prevent text selection */
    .reels-container {
      user-select: none;
      -webkit-user-select: none;
    }
  </style>

  <script>
    // Client-side functionality
    (function() {
      const root = document.getElementById('reels-root');
      const videoId = root.dataset.videoid;
      const nextId = root.dataset.next;
      const prevId = root.dataset.prev;
      
      // Like functionality
      const likeBtn = document.getElementById('likeBtn');
      const likedVideos = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      
      if (likedVideos.includes(videoId)) {
        likeBtn.classList.add('liked');
      }
      
      likeBtn.addEventListener('click', () => {
        const index = likedVideos.indexOf(videoId);
        if (index > -1) {
          likedVideos.splice(index, 1);
          likeBtn.classList.remove('liked');
        } else {
          likedVideos.push(videoId);
          likeBtn.classList.add('liked');
          
          // Animation
          likeBtn.style.transform = 'scale(1.3)';
          setTimeout(() => likeBtn.style.transform = '', 200);
        }
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
      });
      
      // Share/Send functionality
      const sendBtn = document.getElementById('sendBtn');
      sendBtn.addEventListener('click', async () => {
        const shareData = {
          title: document.querySelector('.video-title')?.textContent || 'AniTube Video',
          text: `Check out this anime on AniTubeBuzz!`,
          url: window.location.href
        };
        
        if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
          try {
            await navigator.share(shareData);
          } catch (err) {
            console.log('Share cancelled');
          }
        } else {
          // Desktop: Copy to clipboard
          try {
            await navigator.clipboard.writeText(window.location.href);
            const originalLabel = sendBtn.querySelector('.action-label').textContent;
            sendBtn.querySelector('.action-label').textContent = 'Copied!';
            setTimeout(() => {
              sendBtn.querySelector('.action-label').textContent = originalLabel;
            }, 2000);
          } catch (err) {
            prompt('Copy this link:', window.location.href);
          }
        }
      });
      
      // Navigation
      const nextBtn = document.getElementById('nextBtn');
      const prevBtn = document.getElementById('prevBtn');
      
      function navigate(direction) {
        const targetId = direction === 'next' ? nextId : prevId;
        if (targetId) {
          // Smooth transition
          document.querySelector('.video-card').style.opacity = '0';
          document.querySelector('.video-card').style.transform = `translateY(${direction === 'next' ? '-20px' : '20px'})`;
          
          setTimeout(() => {
            window.location.href = `/reels/${targetId}`;
          }, 200);
        }
      }
      
      if (nextBtn) nextBtn.addEventListener('click', () => navigate('next'));
      if (prevBtn) prevBtn.addEventListener('click', () => navigate('prev'));
      
      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'j' || e.key === 'J') {
          navigate('next');
        } else if (e.key === 'ArrowUp' || e.key === 'k' || e.key === 'K') {
          navigate('prev');
        } else if (e.key === 'Escape') {
          window.location.href = '/';
        }
      });
      
      // Wheel/Scroll snap
      let wheelTimeout;
      document.addEventListener('wheel', (e) => {
        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => {
          if (e.deltaY > 50) navigate('next');
          else if (e.deltaY < -50) navigate('prev');
        }, 50);
      });
      
      // Touch swipe for mobile
      let touchStartY = 0;
      document.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, {passive: true});
      
      document.addEventListener('touchend', (e) => {
        const touchEndY = e.changedTouches[0].clientY;
        const diff = touchStartY - touchEndY;
        
        if (Math.abs(diff) > 100) {
          if (diff > 0) navigate('next');
          else navigate('prev');
        }
      }, {passive: true});
      
      // Hide loader when iframe loads
      const iframe = document.getElementById('videoFrame');
      const loader = document.getElementById('loader');
      
      iframe.addEventListener('load', () => {
        loader.classList.add('hidden');
      });
      
      // Safiya Integration
      if (window.__REELS_DATA__?.current) {
        window.dispatchEvent(new CustomEvent('safiya:video-event', {
          detail: { 
            action: 'watch', 
            video: window.__REELS_DATA__.current 
          }
        }));
      }
      
      // Visibility API - pause/resume logic if needed
      document.addEventListener('visibilitychange', () => {
        // Could add pause logic here if we had direct video control
      });
    })();
  </script>
</body>
</html>
