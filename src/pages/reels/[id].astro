      function getComments() { try { return JSON.parse(localStorage.getItem('anitube_chat_' + currentId) || '[]'); } catch (e) { return []; } }
      function saveComments(list) { try { localStorage.setItem('anitube_chat_' + currentId, JSON.stringify(list)); } catch (e) {} }
      function renderComments() {
        var list = document.getElementById('commentsList');
