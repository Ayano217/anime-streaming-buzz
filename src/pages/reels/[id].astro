  </style>

  <script>
    (function () {
      var root = document.getElementById('reels-root');
      if (!root) return;

      var videoId = root.dataset.videoid || '';
      var currentVideo = window.__REELS_VIDEO__ || null;
      var feedData = window.__REELS_FEED__ || [];
      var seriesName = window.__SERIES_NAME__ || '';

      try {
        if (videoId) {
          localStorage.setItem('anitube_resume_video', videoId);
          localStorage.setItem('anitube_resume_time', String(Date.now()));
        }
      } catch (e) {}

      function getThumb(vid, existing) {
        if (existing && existing.trim()) return existing;
        if (vid && (vid.indexOf('yts_') === 0 || vid.indexOf('yt_') === 0)) {
          return 'https://i.ytimg.com/vi/' + vid.replace(/^(yts_|yt_)/, '') + '/hqdefault.jpg';
        }
        if (vid && vid.indexOf('dm_') === 0) {
          return 'https://www.dailymotion.com/thumbnail/video/' + vid.replace('dm_', '');
        }
        return '';
      }

      function esc(s) {
        return String(s || '').replace(/[&<>"']/g, function (c) {
          var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
          return map[c] || c;
        });
      }

      function trunc(s, n) {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '\u2026' : s;
      }

      function timeAgo(ts) {
        var diff = Date.now() - ts;
        var s = Math.floor(diff / 1000);
        if (s < 60) return 'just now';
        var m = Math.floor(s / 60);
        if (m < 60) return m + ' minute' + (m !== 1 ? 's' : '') + ' ago';
        var h = Math.floor(m / 60);
        if (h < 24) return h + ' hour' + (h !== 1 ? 's' : '') + ' ago';
        var d = Math.floor(h / 24);
        if (d < 30) return d + ' day' + (d !== 1 ? 's' : '') + ' ago';
        return Math.floor(d / 30) + ' months ago';
      }

      function imgEl(src, cls) {
        var img = document.createElement('img');
        img.src = src || '';
        if (cls) img.className = cls;
        img.loading = 'lazy';
        img.onerror = function () {
          img.style.display = 'none';
          if (img.parentElement) {
            img.parentElement.style.background = 'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))';
          }
        };
        return img;
      }

      function fallbackDiv(emoji, size) {
        var d = document.createElement('div');
        d.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:' + size + ';background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));';
        d.textContent = emoji;
        return d;
      }

      // History
      try {
        if (currentVideo && videoId) {
          var goodThumb = getThumb(videoId, currentVideo.thumbnail || '');
          var history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          history = history.filter(function (h) { return h.id !== videoId; });
          history.unshift({ id: videoId, title: currentVideo.title, channel: currentVideo.channel, thumbnail: goodThumb, type: currentVideo.type || 'anime', source: currentVideo.source || 'youtube', at: Date.now() });
          localStorage.setItem('anitube_history', JSON.stringify(history.slice(0, 100)));
        }
      } catch (e) {}

      // Like
      var likeBtn = document.getElementById('likeBtn');
      var likedVideos = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      function isLiked() { return likedVideos.indexOf(videoId) > -1; }
      function updateLikeUI() {
        if (!likeBtn) return;
        var lbl = likeBtn.querySelector('.rp-btn-lbl');
        if (isLiked()) { likeBtn.classList.add('active'); if (lbl) lbl.textContent = 'Liked'; }
        else { likeBtn.classList.remove('active'); if (lbl) lbl.textContent = 'Like'; }
      }
      function toggleLike() {
        var idx = likedVideos.indexOf(videoId);
        if (idx > -1) likedVideos.splice(idx, 1); else likedVideos.push(videoId);
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
        updateLikeUI();
      }
      updateLikeUI();
      if (likeBtn) likeBtn.addEventListener('click', toggleLike);

      // Save
      var saveBtn = document.getElementById('saveBtn');
      var savedVideos = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      function isSaved() { return savedVideos.some(function (s) { return s.id === videoId; }); }
      function updateSaveUI() {
        if (!saveBtn) return;
        var lbl = saveBtn.querySelector('.rp-btn-lbl');
        if (isSaved()) { saveBtn.classList.add('active'); if (lbl) lbl.textContent = 'Saved'; }
        else { saveBtn.classList.remove('active'); if (lbl) lbl.textContent = 'Save'; }
      }
      function toggleSave() {
        var idx = savedVideos.findIndex(function (s) { return s.id === videoId; });
        if (idx > -1) { savedVideos.splice(idx, 1); }
        else { savedVideos.unshift({ id: videoId, title: currentVideo ? currentVideo.title : 'Video', channel: currentVideo ? currentVideo.channel : 'AniTube', thumbnail: getThumb(videoId, (currentVideo && currentVideo.thumbnail) || '') }); }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      updateSaveUI();
      if (saveBtn) saveBtn.addEventListener('click', toggleSave);

      // Double tap
      var videoCard = document.getElementById('videoCard');
      var heart = document.getElementById('doubleTapHeart');
      var lastTap = 0;
      if (videoCard) {
        videoCard.addEventListener('click', function () {
          var now = Date.now();
          if (now - lastTap < 350) {
            if (!isLiked()) toggleLike();
            if (heart) { heart.classList.remove('pop'); void heart.offsetWidth; heart.classList.add('pop'); }
            lastTap = 0;
          } else { lastTap = now; }
        });
      }

      // Share
      var sendBtn = document.getElementById('sendBtn');
      if (sendBtn) {
        sendBtn.addEventListener('click', async function () {
          var isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
          sendBtn.classList.add('sent');
          setTimeout(function () { sendBtn.classList.remove('sent'); }, 600);
          if (isMobile && navigator.share) {
            try { await navigator.share({ title: currentVideo ? currentVideo.title : 'AniTubeBuzz', url: window.location.href }); } catch (e) {}
          } else {
            try {
              await navigator.clipboard.writeText(window.location.href);
              var lbl = sendBtn.querySelector('.rp-btn-lbl');
              if (lbl) { var orig = lbl.textContent; lbl.textContent = 'Copied!'; setTimeout(function () { lbl.textContent = orig; }, 1800); }
            } catch (e) { prompt('Copy:', window.location.href); }
          }
        });
      }

      // Video loader
      var iframe = document.getElementById('videoFrame');
      var videoLoader = document.getElementById('videoLoader');
      function hideLoader() { if (videoLoader) videoLoader.classList.add('hidden'); }
      if (iframe) iframe.addEventListener('load', function () { setTimeout(hideLoader, 500); });
      setTimeout(hideLoader, 3500);

      // Safiya event
      setTimeout(function () {
        if (currentVideo) {
          try { window.dispatchEvent(new CustomEvent('safiya:video-event', { detail: { action: 'watch', video: currentVideo } })); } catch (e) {}
        }
      }, 800);

      // Description toggle
      var descToggle = document.getElementById('descToggle');
      var descContent = document.getElementById('descContent');
      if (descToggle && descContent) {
        descToggle.addEventListener('click', function () {
          var expanded = descContent.classList.toggle('expanded');
          descToggle.textContent = expanded ? 'Show less' : 'Show more';
        });
      }

      // Hook banner
      var hookBanner = document.getElementById('hookBanner');
      var moreSection = document.getElementById('moreSection');
      if (hookBanner && moreSection) {
        hookBanner.addEventListener('click', function () { moreSection.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      }

      // ═══ COMMENTS ═══
      var commentsList = document.getElementById('commentsList');
      var commentInput = document.getElementById('commentInput');
      var commentActions = document.getElementById('commentActions');
      var submitCommentBtn = document.getElementById('submitComment');
      var cancelCommentBtn = document.getElementById('cancelComment');
      var commentCountEl = document.getElementById('commentCount');
      var userInitialEl = document.getElementById('userInitial');
      var CHAT_KEY = 'anitube_chat_' + videoId;
      var USER_KEY = 'anitube_username';

      var username = localStorage.getItem(USER_KEY);
      if (!username) {
        var names = ['SakuraFan','NarutoKid','OtakuHero','AnimeVibes','MangaLover','WeebLife','AnimeVIP','SenpaiChan','KawaiiUser','DemonSlayer'];
        username = names[Math.floor(Math.random() * names.length)] + Math.floor(Math.random() * 999);
        localStorage.setItem(USER_KEY, username);
      }
      if (userInitialEl) userInitialEl.textContent = username.charAt(0).toUpperCase();

      function userColor(name) {
        var colors = [
          'linear-gradient(135deg,#c084fc,#e879f9)',
          'linear-gradient(135deg,#7dd3fc,#22d3ee)',
          'linear-gradient(135deg,#f472b6,#ec4899)',
          'linear-gradient(135deg,#fbbf24,#f97316)',
          'linear-gradient(135deg,#34d399,#059669)'
        ];
        var hash = 0;
        for (var i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
        return colors[Math.abs(hash) % colors.length];
      }

      function loadComments() {
        try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch (e) { return []; }
      }
      function saveComments(list) {
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(list.slice(-100))); } catch (e) {}
      }
      function totalCount(list) {
        var n = list.length;
        list.forEach(function (c) { if (c.replies) n += c.replies.length; });
        return n;
      }

      if (commentInput) {
        commentInput.addEventListener('focus', function () { if (commentActions) commentActions.style.display = 'flex'; });
        commentInput.addEventListener('input', function () {
          if (commentActions) {
            commentActions.style.display = commentInput.value.trim() ? 'flex' : 'none';
          }
        });
      }
      if (cancelCommentBtn) {
        cancelCommentBtn.addEventListener('click', function () {
          if (commentInput) commentInput.value = '';
          if (commentActions) commentActions.style.display = 'none';
          if (commentInput) commentInput.blur();
        });
      }

      function buildAvatar(name, size) {
        var av = document.createElement('div');
        av.className = 'rp-c-avatar';
        av.textContent = (name && name.charAt(0)) ? name.charAt(0).toUpperCase() : '?';
        av.style.background = userColor(name || 'anon');
        av.style.display = 'flex';
        av.style.alignItems = 'center';
        av.style.justifyContent = 'center';
        av.style.width = size + 'px';
        av.style.height = size + 'px';
        av.style.borderRadius = '50%';
        av.style.flexShrink = '0';
        av.style.fontFamily = "'Bricolage Grotesque', sans-serif";
        av.style.fontWeight = '700';
        av.style.color = '#fff';
        return av;
      }

      function renderComments() {
        if (!commentsList) return;
        var list = loadComments();
        if (commentCountEl) commentCountEl.textContent = String(totalCount(list));
        if (!list || list.length === 0) {
          commentsList.innerHTML = '<div class="rp-comments-empty"><p>No comments yet. Be the first! 💬</p></div>';
          return;
        }
        commentsList.innerHTML = '';
        list.forEach(function (c) {
          var wrap = document.createElement('div');
          wrap.className = 'rp-comment';

          var avatarWrapper = document.createElement('div');
          avatarWrapper.style.minWidth = '40px';
          avatarWrapper.style.display = 'flex';
          avatarWrapper.style.alignItems = 'flex-start';
          var av = buildAvatar(c.name || 'User', 40);
          avatarWrapper.appendChild(av);

          var body = document.createElement('div');
          body.className = 'rp-c-body';

          var head = document.createElement('div');
          head.className = 'rp-c-head';
          var nameEl = document.createElement('div');
          nameEl.className = 'rp-c-name';
          nameEl.textContent = c.name || 'Anonymous';
          var timeEl = document.createElement('div');
          timeEl.className = 'rp-c-time';
          timeEl.textContent = (c.at ? timeAgo(c.at) : 'just now');
          head.appendChild(nameEl);
          head.appendChild(timeEl);

          var text = document.createElement('div');
          text.className = 'rp-c-text';
          text.textContent = c.text || '';

          var actions = document.createElement('div');
          actions.className = 'rp-c-actions';
          // sample action buttons (non-functional placeholders)
          var likeAct = document.createElement('button');
          likeAct.className = 'rp-c-action';
          likeAct.textContent = 'Like';
          actions.appendChild(likeAct);

          body.appendChild(head);
          body.appendChild(text);
          body.appendChild(actions);

          wrap.appendChild(avatarWrapper);
          wrap.appendChild(body);

          commentsList.appendChild(wrap);

          // replies
          if (c.replies && c.replies.length) {
            var repliesContainer = document.createElement('div');
            repliesContainer.className = 'rp-replies show';
            c.replies.forEach(function (r) {
              var rwrap = document.createElement('div');
              rwrap.className = 'rp-reply';
              var rav = buildAvatar(r.name || 'User', 32);
              var rbody = document.createElement('div');
              rbody.className = 'rp-c-body';
              var rhead = document.createElement('div');
              rhead.className = 'rp-c-head';
              var rname = document.createElement('div');
              rname.className = 'rp-c-name';
              rname.textContent = r.name || 'Anonymous';
              var rtime = document.createElement('div');
              rtime.className = 'rp-c-time';
              rtime.textContent = (r.at ? timeAgo(r.at) : 'just now');
              rhead.appendChild(rname);
              rhead.appendChild(rtime);
              var rtext = document.createElement('div');
              rtext.className = 'rp-c-text';
              rtext.textContent = r.text || '';
              rbody.appendChild(rhead);
              rbody.appendChild(rtext);
              rwrap.appendChild(rav);
              rwrap.appendChild(rbody);
              repliesContainer.appendChild(rwrap);
            });
            commentsList.appendChild(repliesContainer);
          }
        });
      }

      // Add comment
      if (submitCommentBtn && commentInput) {
        submitCommentBtn.addEventListener('click', function () {
          var txt = commentInput.value.trim();
          if (!txt) return;
          var list = loadComments();
          var obj = { id: 'c_' + Date.now(), name: username, text: txt, at: Date.now(), replies: [] };
          list.push(obj);
          saveComments(list);
          commentInput.value = '';
          if (commentActions) commentActions.style.display = 'none';
          renderComments();
        });
      }

      renderComments();

      // Simple series/related feed rendering (non-fatal; safe if feedData empty)
      var moreFeed = document.getElementById('moreFeed');
      var sidebarCount = document.getElementById('sidebarCount');
      var seriesSection = document.getElementById('seriesSection');
      var seriesList = document.getElementById('seriesList');
      var seriesCountEl = document.getElementById('seriesCount');
      var relatedFeed = document.getElementById('relatedFeed');

      function populateRelated() {
        try {
          if (!moreFeed || !Array.isArray(feedData) || feedData.length === 0) return;
          moreFeed.innerHTML = '';
          var count = 0;
          feedData.forEach(function (it) {
            if (!it || !it.id || it.id === videoId) return;
            var card = document.createElement('a');
            card.className = 'rp-si';
            card.href = '/reels/' + encodeURIComponent(it.id);
            var thumb = document.createElement('div');
            thumb.className = 'rp-si-thumb';
            var img = document.createElement('img');
            img.src = getThumb(it.id, it.thumbnail || '');
            thumb.appendChild(img);
            var info = document.createElement('div');
            info.className = 'rp-si-info';
            var title = document.createElement('div');
            title.className = 'rp-si-title';
            title.textContent = it.title || 'Video';
            var ch = document.createElement('div');
            ch.className = 'rp-si-channel';
            ch.textContent = it.channel || '';
            info.appendChild(title);
            info.appendChild(ch);
            card.appendChild(thumb);
            card.appendChild(info);
            moreFeed.appendChild(card);
            count++;
          });
          if (sidebarCount) sidebarCount.textContent = String(count);
        } catch (e) {}
      }

      function populateSeries() {
        try {
          if (!seriesList || !Array.isArray(feedData) || !seriesName) return;
          var matches = feedData.filter(function (v) {
            var t = (v.title || '').toLowerCase();
            return seriesName && t.indexOf(seriesName.toLowerCase()) !== -1;
          });
          if (matches.length === 0) {
            if (seriesSection) seriesSection.style.display = 'none';
            return;
          }
          seriesList.innerHTML = '';
          matches.forEach(function (it) {
            var a = document.createElement('a');
            a.className = 'rp-si';
            a.href = '/reels/' + encodeURIComponent(it.id);
            var thumb = document.createElement('div');
            thumb.className = 'rp-si-thumb';
            var im = document.createElement('img');
            im.src = getThumb(it.id, it.thumbnail || '');
            thumb.appendChild(im);
            var info = document.createElement('div');
            info.className = 'rp-si-info';
            var title = document.createElement('div');
            title.className = 'rp-si-title';
            title.textContent = it.title || 'Episode';
            var ch = document.createElement('div');
            ch.className = 'rp-si-channel';
            ch.textContent = it.channel || '';
            info.appendChild(title);
            info.appendChild(ch);
            a.appendChild(thumb);
            a.appendChild(info);
            seriesList.appendChild(a);
          });
          if (seriesSection) seriesSection.style.display = 'block';
          if (seriesCountEl) seriesCountEl.textContent = String(matches.length);
        } catch (e) {}
      }

      populateRelated();
      populateSeries();

    })();
  </script>
</BaseLayout>
