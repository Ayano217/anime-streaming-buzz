      const currentVideo: any = (window as any).__REELS_VIDEO__ || null;
      const feedData: any[] = (window as any).__REELS_FEED__ || [];
      const seriesName: string = (window as any).__SERIES_NAME__ || '';
      const channelName: string = (window as any).__CHANNEL_NAME__ || '';

      try {
        if (videoId) {
          localStorage.setItem('anitube_resume_video', videoId);
          localStorage.setItem('anitube_resume_time', String(Date.now()));
        }
      } catch(e) {}

      function getThumb(vid: string, existing: string = ''): string {
        if (existing && existing.trim()) return existing;
        if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
          return 'https://i.ytimg.com/vi/' + vid.replace(/^(yts_|yt_)/, '') + '/hqdefault.jpg';
        }
        if (vid.startsWith('dm_')) {
          return 'https://www.dailymotion.com/thumbnail/video/' + vid.replace('dm_', '');
        }
        return '';
      }

      function esc(s: string): string {
        return String(s || '').replace(/[&<>"']/g, (c: string) => (
          {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] || c
        ));
      }

      function trunc(s: string, n: number): string {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '…' : s;
      }

      function shuffle<T>(arr: T[]): T[] {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      function timeAgo(ts: number): string {
        const diff = Date.now() - ts;
        const s = Math.floor(diff / 1000);
        if (s < 60) return 'just now';
        const m = Math.floor(s / 60);
        if (m < 60) return m + ' minute' + (m !== 1 ? 's' : '') + ' ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + ' hour' + (h !== 1 ? 's' : '') + ' ago';
        const d = Math.floor(h / 24);
        if (d < 30) return d + ' day' + (d !== 1 ? 's' : '') + ' ago';
        return Math.floor(d / 30) + ' months ago';
      }

      // History
      try {
        if (currentVideo && videoId) {
          const goodThumb = getThumb(videoId, currentVideo.thumbnail);
          const history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          const filtered = history.filter((h: any) => h.id !== videoId);
          filtered.unshift({
            id: videoId, title: currentVideo.title, channel: currentVideo.channel,
            thumbnail: goodThumb, type: currentVideo.type || 'anime',
            source: currentVideo.source || 'youtube', watchedAt: Date.now()
          });
          localStorage.setItem('anitube_history', JSON.stringify(filtered.slice(0, 100)));
        }
      } catch(e) {}

      // Like
      const likeBtn = document.getElementById('likeBtn');
      const likedVideos: string[] = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      const isLiked = () => likedVideos.includes(videoId);
      function updateLikeUI() {
        if (!likeBtn) return;
        if (isLiked()) {
          likeBtn.classList.add('active');
          const lbl = likeBtn.querySelector('.rp-btn-lbl');
          if (lbl) lbl.textContent = 'Liked';
        } else {
          likeBtn.classList.remove('active');
          const lbl = likeBtn.querySelector('.rp-btn-lbl');
          if (lbl) lbl.textContent = 'Like';
        }
      }
      function toggleLike() {
        const idx = likedVideos.indexOf(videoId);
        if (idx > -1) likedVideos.splice(idx, 1);
        else likedVideos.push(videoId);
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
        updateLikeUI();
      }
      updateLikeUI();
      likeBtn?.addEventListener('click', toggleLike);

      // Save
      const saveBtn = document.getElementById('saveBtn');
      const savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      const isSaved = () => savedVideos.some((s: any) => s.id === videoId);
      function updateSaveUI() {
        if (!saveBtn) return;
        if (isSaved()) {
          saveBtn.classList.add('active');
          const lbl = saveBtn.querySelector('.rp-btn-lbl');
          if (lbl) lbl.textContent = 'Saved';
        } else {
          saveBtn.classList.remove('active');
          const lbl = saveBtn.querySelector('.rp-btn-lbl');
          if (lbl) lbl.textContent = 'Save';
        }
      }
      function toggleSave() {
        const idx = savedVideos.findIndex((s: any) => s.id === videoId);
        if (idx > -1) savedVideos.splice(idx, 1);
        else savedVideos.unshift({
          id: videoId, title: currentVideo?.title || 'Video',
          channel: currentVideo?.channel || 'AniTube',
          thumbnail: getThumb(videoId, currentVideo?.thumbnail),
          type: currentVideo?.type || 'anime',
          source: currentVideo?.source || 'youtube',
          savedAt: Date.now()
        });
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      updateSaveUI();
      saveBtn?.addEventListener('click', toggleSave);

      // Double tap
      const videoCard = document.getElementById('videoCard');
      const heart = document.getElementById('doubleTapHeart');
      let lastTap = 0;
      videoCard?.addEventListener('click', () => {
        const now = Date.now();
        if (now - lastTap < 350) {
          if (!isLiked()) toggleLike();
          if (heart) {
            heart.classList.remove('pop');
            void (heart as HTMLElement).offsetWidth;
            heart.classList.add('pop');
          }
          lastTap = 0;
        } else { lastTap = now; }
      });

      // Share
      const sendBtn = document.getElementById('sendBtn');
      async function handleSend() {
        if (!sendBtn) return;
        const shareData = { title: currentVideo?.title || 'AniTubeBuzz', url: window.location.href };
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        sendBtn.classList.add('sent');
        setTimeout(() => sendBtn.classList.remove('sent'), 600);
        if (isMobile && (navigator as any).share) {
          try { await (navigator as any).share(shareData); } catch {}
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const lbl = sendBtn.querySelector('.rp-btn-lbl');
            if (lbl) {
              const orig = lbl.textContent;
              lbl.textContent = 'Copied!';
              setTimeout(() => { lbl.textContent = orig; }, 1800);
            }
          } catch { prompt('Copy:', window.location.href); }
        }
      }
      sendBtn?.addEventListener('click', handleSend);

      // Next
      let navigating = false;
      function goTo(targetId: string) {
        if (navigating || !targetId) return;
        navigating = true;
        const c = document.getElementById('videoCard');
        if (c) { c.style.opacity = '0.4'; c.style.transition = 'opacity 0.2s'; }
        setTimeout(() => { window.location.href = '/reels/' + targetId; }, 180);
      }
      document.getElementById('nextBtn')?.addEventListener('click', () => {
        if (seriesEpisodes.length > 0) {
          const currentIdx = seriesEpisodes.findIndex((v: any) => v.id === videoId);
          const next = seriesEpisodes[currentIdx + 1];
          if (next) { goTo(next.id); return; }
        }
        if (sideItems[0]) goTo(sideItems[0].id);
      });

      // Video loader
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const videoLoader = document.getElementById('videoLoader');
      function hideVideoLoader() { videoLoader?.classList.add('hidden'); }
      iframe?.addEventListener('load', () => setTimeout(hideVideoLoader, 500));
      setTimeout(hideVideoLoader, 3500);

      // Safiya
      setTimeout(() => {
        if (currentVideo) {
          try {
            window.dispatchEvent(new CustomEvent('safiya:video-event', {
              detail: { action: 'watch', video: currentVideo }
            }));
          } catch(e) {}
        }
      }, 800);

      // Description
      const descToggle = document.getElementById('descToggle');
      const descContent = document.getElementById('descContent');
      descToggle?.addEventListener('click', () => {
        if (!descContent) return;
        const expanded = descContent.classList.toggle('expanded');
        descToggle.textContent = expanded ? 'Show less' : 'Show more';
      });

      const moreSection = document.getElementById('moreSection');
      document.getElementById('hookBanner')?.addEventListener('click', () => {
        moreSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // ═══════════════════════════════════════════════
      // COMMENTS
      // ═══════════════════════════════════════════════
      const commentsList = document.getElementById('commentsList');
      const commentInput = document.getElementById('commentInput') as HTMLInputElement;
      const commentActions = document.getElementById('commentActions');
      const submitBtn = document.getElementById('submitComment');
      const cancelBtn = document.getElementById('cancelComment');
      const commentCount = document.getElementById('commentCount');
      const userInitial = document.getElementById('userInitial');
      const CHAT_KEY = 'anitube_chat_' + videoId;
      const USER_KEY = 'anitube_username';

      let username = localStorage.getItem(USER_KEY);
      if (!username) {
        const names = ['SakuraFan','NarutoKid','OtakuHero','AnimeVibes','MangaLover','WeebLife','AnimeVIP','SenpaiChan','KawaiiUser','DemonSlayer'];
        username = names[Math.floor(Math.random() * names.length)] + Math.floor(Math.random() * 999);
        localStorage.setItem(USER_KEY, username);
      }
      if (userInitial) userInitial.textContent = username.charAt(0).toUpperCase();

      function userColor(name: string): string {
        const colors = [
          'linear-gradient(135deg, #c084fc, #e879f9)',
          'linear-gradient(135deg, #7dd3fc, #22d3ee)',
          'linear-gradient(135deg, #f472b6, #ec4899)',
          'linear-gradient(135deg, #fbbf24, #f97316)',
          'linear-gradient(135deg, #34d399, #10b981)',
          'linear-gradient(135deg, #a78bfa, #8b5cf6)',
          'linear-gradient(135deg, #60a5fa, #3b82f6)',
          'linear-gradient(135deg, #f87171, #ef4444)'
        ];
        let hash = 0;
        for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
        return colors[Math.abs(hash) % colors.length];
      }

      function loadComments(): any[] {
        try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch { return []; }
      }
      function saveComments(list: any[]) {
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(list.slice(-100))); } catch {}
      }
      function totalCommentCount(list: any[]): number {
        let n = list.length;
        list.forEach((c: any) => { if (c.replies) n += c.replies.length; });
        return n;
      }

      commentInput?.addEventListener('focus', () => {
        if (commentActions) commentActions.style.display = 'flex';
      });
      cancelBtn?.addEventListener('click', () => {
        if (commentInput) commentInput.value = '';
        if (commentActions) commentActions.style.display = 'none';
        commentInput?.blur();
      });

      function renderComments() {
        if (!commentsList) return;
        const list = loadComments();
        if (commentCount) commentCount.textContent = String(totalCommentCount(list));

        if (list.length === 0) {
          commentsList.innerHTML = '<div class="rp-comments-empty"><p>No comments yet. Be the first! 💬</p></div>';
          return;
        }

        commentsList.innerHTML = list.map((c: any, i: number) => {
          const liked = c.liked ? 'active' : '';
          const disliked = c.disliked ? 'active' : '';
          const likes = c.likes || 0;
          const replies = c.replies || [];
          
          const repliesHtml = replies.length > 0 ? 
            '<button class="rp-replies-toggle" data-idx="' + i + '">' +
              '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>' +
              '<span>' + replies.length + ' ' + (replies.length === 1 ? 'reply' : 'replies') + '</span>' +
            '</button>' +
            '<div class="rp-replies" data-idx="' + i + '">' +
              replies.map((r: any) => 
                '<div class="rp-reply">' +
                  '<div class="rp-c-avatar" style="background:' + userColor(r.name) + '">' + esc(r.name.charAt(0).toUpperCase()) + '</div>' +
                  '<div class="rp-c-body">' +
                    '<div class="rp-c-head">' +
                      '<span class="rp-c-name">@' + esc(r.name) + '</span>' +
                      '<span class="rp-c-time">' + timeAgo(r.time) + '</span>' +
                    '</div>' +
                    '<div class="rp-c-text">' + esc(r.text) + '</div>' +
                  '</div>' +
                '</div>'
              ).join('') +
            '</div>' : '';
          
          return '<div class="rp-comment" data-idx="' + i + '">' +
            '<div class="rp-c-avatar" style="background:' + userColor(c.name) + '">' + esc(c.name.charAt(0).toUpperCase()) + '</div>' +
            '<div class="rp-c-body">' +
              '<div class="rp-c-head">' +
                '<span class="rp-c-name">@' + esc(c.name) + '</span>' +
                '<span class="rp-c-time">' + timeAgo(c.time) + '</span>' +
              '</div>' +
              '<div class="rp-c-text">' + esc(c.text) + '</div>' +
              '<div class="rp-c-actions">' +
                '<button class="rp-c-action ' + liked + '" data-idx="' + i + '" data-action="like">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>' +
                  '<span class="rp-c-count">' + (likes > 0 ? likes : '') + '</span>' +
                '</button>' +
                '<button class="rp-c-action ' + disliked + '" data-idx="' + i + '" data-action="dislike">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zM17 2h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"/></svg>' +
                '</button>' +
                '<button class="rp-c-reply-btn" data-idx="' + i + '">Reply</button>' +
              '</div>' +
              '<div class="rp-reply-container" data-idx="' + i + '"></div>' +
              repliesHtml +
            '</div>' +
          '</div>';
        }).join('');

        commentsList.querySelectorAll('.rp-c-action').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt((btn as HTMLElement).dataset.idx || '0');
            const action = (btn as HTMLElement).dataset.action;
            const list = loadComments();
            if (!list[idx]) return;
            if (action === 'like') {
              if (list[idx].liked) { list[idx].liked = false; list[idx].likes = Math.max(0, (list[idx].likes || 0) - 1); }
              else { list[idx].liked = true; list[idx].likes = (list[idx].likes || 0) + 1; if (list[idx].disliked) list[idx].disliked = false; }
            } else if (action === 'dislike') {
              if (list[idx].disliked) list[idx].disliked = false;
              else { list[idx].disliked = true; if (list[idx].liked) { list[idx].liked = false; list[idx].likes = Math.max(0, (list[idx].likes || 0) - 1); } }
            }
            saveComments(list);
            renderComments();
          });
        });

        commentsList.querySelectorAll('.rp-c-reply-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt((btn as HTMLElement).dataset.idx || '0');
            const container = commentsList.querySelector('.rp-reply-container[data-idx="' + idx + '"]') as HTMLElement;
            if (!container) return;
            if (container.querySelector('input')) { container.innerHTML = ''; return; }
            container.innerHTML = 
              '<div class="rp-reply-input-row">' +
                '<div class="rp-my-av" style="background:' + userColor(username || 'Y') + '">' + (username || 'Y').charAt(0).toUpperCase() + '</div>' +
                '<div>' +
                  '<input type="text" class="rp-reply-input" placeholder="Add a reply..." maxlength="300" />' +
                  '<div class="rp-comment-actions" style="display:flex;">' +
                    '<button class="rp-cancel-btn rp-cancel-reply">Cancel</button>' +
                    '<button class="rp-submit-btn rp-submit-reply">Reply</button>' +
                  '</div>' +
                '</div>' +
              '</div>';
            const input = container.querySelector('input') as HTMLInputElement;
            const cancelReply = container.querySelector('.rp-cancel-reply');
            const submitReply = container.querySelector('.rp-submit-reply');
            input?.focus();
            cancelReply?.addEventListener('click', () => { container.innerHTML = ''; });
            const doSubmit = () => {
              const text = input?.value.trim();
              if (!text) return;
              const list = loadComments();
              if (!list[idx].replies) list[idx].replies = [];
              list[idx].replies.push({ name: username, text, time: Date.now() });
              saveComments(list);
              renderComments();
            };
            submitReply?.addEventListener('click', doSubmit);
            input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doSubmit(); } });
          });
        });

        commentsList.querySelectorAll('.rp-replies-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = (btn as HTMLElement).dataset.idx;
            const repliesDiv = commentsList.querySelector('.rp-replies[data-idx="' + idx + '"]');
            repliesDiv?.classList.toggle('show');
          });
        });
      }

      function submitComment() {
        if (!commentInput) return;
        const text = commentInput.value.trim();
        if (!text) return;
        const list = loadComments();
        list.unshift({ name: username, text, time: Date.now(), likes: 0, replies: [] });
        saveComments(list);
        commentInput.value = '';
        if (commentActions) commentActions.style.display = 'none';
        commentInput.blur();
        renderComments();
      }
      submitBtn?.addEventListener('click', submitComment);
      commentInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); submitComment(); }
      });
      renderComments();

      // ═══════════════════════════════════════════════
      // SERIES EPISODES (from API)
      // ═══════════════════════════════════════════════
      let seriesEpisodes: any[] = [];
      
      async function loadSeriesEpisodes() {
        if (!seriesName || seriesName.length < 3) return;
        try {
          const res = await fetch('/api/social-feed?related=true&series=' + encodeURIComponent(seriesName) + '&limit=20');
          const data = await res.json();
          if (data.success && data.videos && data.videos.length > 0) {
            seriesEpisodes = data.videos.filter((v: any) => v.id !== videoId);
            renderSeriesEpisodes();
          }
        } catch(e) {}
      }

      function renderSeriesEpisodes() {
        const seriesSection = document.getElementById('seriesSection');
        const seriesList = document.getElementById('seriesList');
        const seriesCount = document.getElementById('seriesCount');
        if (!seriesList || !seriesSection || seriesEpisodes.length === 0) return;
        
        seriesSection.style.display = 'block';
        if (seriesCount) seriesCount.textContent = String(seriesEpisodes.length);
        
        seriesList.innerHTML = seriesEpisodes.slice(0, 15).map((v: any, i: number) => {
          const thumb = getThumb(v.id, v.thumbnail || '');
          const imgHtml = thumb
            ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.style.background=\'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))\';" />'
            : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📺</div>';
          const epLabel = v.episodeNumber ? 'EP ' + v.episodeNumber : (i + 1);
          
          return '<a href="/reels/' + esc(v.id) + '" class="rp-si" style="animation-delay:' + (i * 40) + 'ms;">' +
            '<div class="rp-si-thumb">' + imgHtml +
              '<div class="rp-si-ep">' + epLabel + '</div>' +
            '</div>' +
            '<div class="rp-si-info">' +
              '<h3 class="rp-si-title">' + esc(trunc(v.title || 'Episode', 80)) + '</h3>' +
              '<div class="rp-si-channel">' + esc((v.channel || '').slice(0, 25)) + '</div>' +
            '</div>' +
          '</a>';
        }).join('');
      }

      loadSeriesEpisodes();

      // ═══════════════════════════════════════════════
      // SIDEBAR "UP NEXT" — Similar videos + ads
      // ═══════════════════════════════════════════════
      const sidebarFeed = document.getElementById('relatedFeed');
      const sidebarCount = document.getElementById('sidebarCount');
      let sideItems: any[] = feedData.filter((v: any) => v.id !== videoId).slice();
      let sideRendered = 0;
      let productPool: any[] = [];

      function makeSidebarItem(v: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = v.isAnimeDetail ? '/anime/' + v.id : '/reels/' + v.id;
        el.className = 'rp-si';
        el.style.animationDelay = ((i % 10) * 40) + 'ms';

        const thumb = getThumb(v.id, v.thumbnail || '');
        const chan = (v.channel || 'AniTube').slice(0, 30);
        const views = Math.floor(Math.random() * 500 + 50) + 'K views';
        const ago = ['2 hours ago', '5 hours ago', '1 day ago', '3 days ago', '1 week ago'][Math.floor(Math.random() * 5)];
        const dur = Math.floor(Math.random() * 20 + 5) + ':' + String(Math.floor(Math.random() * 60)).padStart(2, '0');

        const imgHtml = thumb
          ? '<img src="' + esc(thumb) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.style.background=\'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))\';" />'
          : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📺</div>';

        el.innerHTML = 
          '<div class="rp-si-thumb">' + imgHtml +
            (v.isNew ? '<div class="rp-si-new">NEW</div>' : '') +
            '<div class="rp-si-duration">' + dur + '</div>' +
          '</div>' +
          '<div class="rp-si-info">' +
            '<h3 class="rp-si-title">' + esc(trunc(v.title || 'Video', 100)) + '</h3>' +
            '<div class="rp-si-channel">' + esc(chan) + '</div>' +
            '<div class="rp-si-meta">' + views + ' • ' + ago + '</div>' +
          '</div>';
        return el;
      }

      function makeSidebarAd(p: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = '/product/' + esc(p.id);
        el.className = 'rp-si rp-si-ad';
        el.style.animationDelay = ((i % 10) * 40) + 'ms';
        
        const imgHtml = p.image 
          ? '<img src="' + esc(p.image) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';" />'
          : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(251,191,36,0.3),rgba(249,115,22,0.2));display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🛍️</div>';

        el.innerHTML = 
          '<div class="rp-si-thumb">' + imgHtml + '</div>' +
          '<div class="rp-si-info">' +
            '<h3 class="rp-si-title">' + esc(trunc(p.title, 80)) + '</h3>' +
            '<div class="rp-si-price">' + esc(p.price) + '</div>' +
          '</div>';
        return el;
      }

      function renderSidebar() {
        if (!sidebarFeed) return;
        const batchSize = 12;
        const end = Math.min(sideRendered + batchSize, sideItems.length);
        let placed = 0;
        for (let i = sideRendered; i < end; i++) {
          sidebarFeed.appendChild(makeSidebarItem(sideItems[i], i));
          placed++;
          if (placed % 5 === 0 && productPool.length > 0) {
            const p = productPool[Math.floor(Math.random() * productPool.length)];
            if (p) sidebarFeed.appendChild(makeSidebarAd(p, i));
          }
        }
        sideRendered = end;
        if (sidebarCount) sidebarCount.textContent = String(sideRendered);
      }

      // ═══════════════════════════════════════════════
      // MORE VIDEOS — home page card style
      // ═══════════════════════════════════════════════
      const moreEl = document.getElementById('moreFeed');
      const moreLoadingEl = document.getElementById('moreLoading');
      let moreItems: any[] = sideItems.slice();
      let moreRendered = 0;
      let loadingMore = false;
      let cardsSinceProduct = 0;

      function makeCard(v: any, i: number): HTMLElement {
        const t = v.title || 'Video';
        const img = getThumb(v.id, v.thumbnail || '');
        const delay = ((i % 8) * 40) + 'ms';
        const typeLabel: any = { 
          movies: '🎬 MOVIE', kdrama: '🇰🇷 K-DRAMA', 
          donghua: '🐼 DONGHUA', anime: '🎌 ANIME' 
        }[v.type] || '';
        
        const imgHtml = img
          ? '<img src="' + esc(img) + '" alt="' + esc(t) + '" loading="lazy" class="at-na-img" onerror="this.style.display=\'none\';this.parentElement.style.background=\'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))\';" />'
          : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:2rem;">📺</div>';
        
        const el = document.createElement('a');
        el.href = v.isAnimeDetail ? '/anime/' + v.id : '/reels/' + v.id;
        el.className = 'at-na-card';
        el.style.animationDelay = delay;
        el.style.textDecoration = 'none';
        
        el.innerHTML =
          '<div class="at-na-thumb">' +
            imgHtml +
            '<div class="at-na-shine"></div>' +
            '<div class="at-na-overlay"></div>' +
            '<div class="at-na-play">' +
              '<div style="position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:2px;box-shadow:0 8px 25px rgba(192,132,252,0.7);z-index:2;">' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
              '</div>' +
            '</div>' +
            (v.isNew ? '<div style="position:absolute;top:6px;left:6px;padding:3px 7px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;letter-spacing:0.08em;border-radius:4px;z-index:6;">NEW</div>' : '') +
            '<div style="position:absolute;bottom:6px;left:6px;padding:2px 7px;background:rgba(10,5,23,0.9);color:#fbbf24;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;border-radius:4px;z-index:6;">' + typeLabel + '</div>' +
          '</div>' +
          '<div style="padding:8px 3px 4px;position:relative;z-index:1;">' +
            '<h3 class="at-na-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.78rem;font-weight:700;color:var(--text-primary);margin:0 0 3px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;min-height:2em;">' + esc(trunc(t, 55)) + '</h3>' +
            '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;color:var(--text-muted);opacity:0.75;">' + esc(v.channel || 'Channel') + '</div>' +
          '</div>';
        
        return el;
      }

      function makeInlineProductCard(p: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = '/product/' + esc(p.id);
        el.className = 'at-na-card';
        el.style.animationDelay = ((i % 8) * 40) + 'ms';
        el.style.textDecoration = 'none';
        
        const imgHtml = p.image
          ? '<img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" loading="lazy" class="at-na-img" onerror="this.style.display=\'none\';" />'
          : '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(251,191,36,0.3),rgba(249,115,22,0.2));display:flex;align-items:center;justify-content:center;font-size:2rem;">🛍️</div>';
        
        el.innerHTML =
          '<div class="at-na-thumb" style="border-color:rgba(251,191,36,0.5);">' +
            imgHtml +
            '<div class="at-na-shine"></div>' +
            '<div class="at-na-overlay"></div>' +
            '<div style="position:absolute;top:6px;left:6px;padding:3px 7px;background:linear-gradient(135deg,#fbbf24,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;letter-spacing:0.08em;border-radius:4px;z-index:6;">💎 AD</div>' +
            '<div style="position:absolute;bottom:6px;left:6px;padding:2px 7px;background:linear-gradient(135deg,#fbbf24,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:800;border-radius:4px;z-index:6;">' + esc(p.price) + '</div>' +
          '</div>' +
          '<div style="padding:8px 3px 4px;position:relative;z-index:1;">' +
            '<h3 class="at-na-title" style="font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.78rem;font-weight:700;color:var(--text-primary);margin:0 0 3px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;min-height:2em;">' + esc(trunc(p.title, 55)) + '</h3>' +
            '<div style="font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;color:#fbbf24;opacity:0.9;">Sponsored</div>' +
          '</div>';
        return el;
      }

      function renderMoreBatch() {
        if (!moreEl) return;
        const batchSize = 8;
        const end = Math.min(moreRendered + batchSize, moreItems.length);
        for (let i = moreRendered; i < end; i++) {
          moreEl.appendChild(makeCard(moreItems[i], i));
          cardsSinceProduct++;
          if (cardsSinceProduct >= 6 && productPool.length > 0) {
            const p = productPool[Math.floor(Math.random() * productPool.length)];
            if (p) moreEl.appendChild(makeInlineProductCard(p, i));
            cardsSinceProduct = 0;
          }
        }
        moreRendered = end;
      }

      async function fetchMore() {
        if (loadingMore) return;
        loadingMore = true;
        if (moreLoadingEl) moreLoadingEl.classList.add('show');
        try {
          const types = ['anime', 'donghua', 'kdrama', 'movies'];
          const type = types[Math.floor(Math.random() * types.length)];
          const page = Math.floor(Math.random() * 5) + 1;
          const res = await fetch('/api/social-feed?type=' + type + '&page=' + page + '&limit=15');
          const data = await res.json();
          if (data.success && data.videos) {
            const existing = new Set(moreItems.map((v: any) => v.id));
            existing.add(videoId);
            const fresh = data.videos.filter((v: any) => !existing.has(v.id));
            moreItems = moreItems.concat(fresh);
            sideItems = sideItems.concat(fresh);
            renderMoreBatch();
            renderSidebar();
          }
        } catch(e) {}
        if (moreLoadingEl) moreLoadingEl.classList.remove('show');
        loadingMore = false;
      }

      async function loadProducts() {
        try {
          const res = await fetch('/api/products?limit=30');
          const data = await res.json();
          if (data.success && data.products) productPool = data.products;
        } catch(e) {}
      }

      loadProducts().then(() => {
        renderSidebar();
        renderMoreBatch();
      });

      let scrollTimer: any = null;
      window.addEventListener('scroll', () => {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          if (loadingMore) return;
          const bottom = window.scrollY + window.innerHeight;
          const height = document.documentElement.scrollHeight;
          if (bottom > height - 800) {
            if (moreRendered < moreItems.length) renderMoreBatch();
            else fetchMore();
          }
        }, 100);
      }, { passive: true });

      const autoplayToggle = document.getElementById('autoplayToggle') as HTMLInputElement;
      if (autoplayToggle) {
        const saved = localStorage.getItem('anitube_autoplay');
        if (saved === 'false') autoplayToggle.checked = false;
        autoplayToggle.addEventListener('change', () => {
          localStorage.setItem('anitube_autoplay', String(autoplayToggle.checked));
        });
      }
    })();
  </script>
</BaseLayout>
