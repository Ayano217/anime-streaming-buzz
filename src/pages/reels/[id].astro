  </style>

  <script>
    (function () {
      var root = document.getElementById('reels-root');
      if (!root) return;

      var videoId = root.dataset.videoid || '';
      var currentVideo = (window as any).__REELS_VIDEO__ || null;
      var feedData = (window as any).__REELS_FEED__ || [];
      var seriesName = (window as any).__SERIES_NAME__ || '';

      try {
        if (videoId) {
          localStorage.setItem('anitube_resume_video', videoId);
          localStorage.setItem('anitube_resume_time', String(Date.now()));
        }
      } catch (e) {}

      function getThumb(vid: string, existing: string): string {
        if (existing && existing.trim()) return existing;
        if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
          return 'https://i.ytimg.com/vi/' + vid.replace(/^(yts_|yt_)/, '') + '/hqdefault.jpg';
        }
        if (vid.startsWith('dm_')) {
          return 'https://www.dailymotion.com/thumbnail/video/' + vid.replace('dm_', '');
        }
        return '';
      }

      function esc(s: string): string {
        return String(s || '').replace(/[&<>"']/g, function (c) {
          var map: any = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
          return map[c] || c;
        });
      }

      function trunc(s: string, n: number): string {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '\u2026' : s;
      }

      function timeAgo(ts: number): string {
        var diff = Date.now() - ts;
        var s = Math.floor(diff / 1000);
        if (s < 60) return 'just now';
        var m = Math.floor(s / 60);
        if (m < 60) return m + ' minute' + (m !== 1 ? 's' : '') + ' ago';
        var h = Math.floor(m / 60);
        if (h < 24) return h + ' hour' + (h !== 1 ? 's' : '') + ' ago';
        var d = Math.floor(h / 24);
        if (d < 30) return d + ' day' + (d !== 1 ? 's' : '') + ' ago';
        return Math.floor(d / 30) + ' months ago';
      }

      function imgEl(src: string, cls: string): HTMLImageElement {
        var img = document.createElement('img');
        img.src = src;
        if (cls) img.className = cls;
        img.loading = 'lazy';
        img.onerror = function () {
          (img as any).style.display = 'none';
          if (img.parentElement) {
            img.parentElement.style.background = 'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))';
          }
        };
        return img;
      }

      function fallbackDiv(emoji: string, size: string): HTMLDivElement {
        var d = document.createElement('div');
        d.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:' + size + ';background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));';
        d.textContent = emoji;
        return d;
      }

      // History
      try {
        if (currentVideo && videoId) {
          var goodThumb = getThumb(videoId, currentVideo.thumbnail || '');
          var history: any[] = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          history = history.filter(function (h: any) { return h.id !== videoId; });
          history.unshift({ id: videoId, title: currentVideo.title, channel: currentVideo.channel, thumbnail: goodThumb, type: currentVideo.type || 'anime', source: currentVideo.source || 'youtube', watchedAt: Date.now() });
          localStorage.setItem('anitube_history', JSON.stringify(history.slice(0, 100)));
        }
      } catch (e) {}

      // Like
      var likeBtn = document.getElementById('likeBtn');
      var likedVideos: string[] = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      function isLiked() { return likedVideos.indexOf(videoId) > -1; }
      function updateLikeUI() {
        if (!likeBtn) return;
        var lbl = likeBtn.querySelector('.rp-btn-lbl');
        if (isLiked()) { likeBtn.classList.add('active'); if (lbl) lbl.textContent = 'Liked'; }
        else { likeBtn.classList.remove('active'); if (lbl) lbl.textContent = 'Like'; }
      }
      function toggleLike() {
        var idx = likedVideos.indexOf(videoId);
        if (idx > -1) likedVideos.splice(idx, 1); else likedVideos.push(videoId);
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
        updateLikeUI();
      }
      updateLikeUI();
      if (likeBtn) likeBtn.addEventListener('click', toggleLike);

      // Save
      var saveBtn = document.getElementById('saveBtn');
      var savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      function isSaved() { return savedVideos.some(function (s: any) { return s.id === videoId; }); }
      function updateSaveUI() {
        if (!saveBtn) return;
        var lbl = saveBtn.querySelector('.rp-btn-lbl');
        if (isSaved()) { saveBtn.classList.add('active'); if (lbl) lbl.textContent = 'Saved'; }
        else { saveBtn.classList.remove('active'); if (lbl) lbl.textContent = 'Save'; }
      }
      function toggleSave() {
        var idx = savedVideos.findIndex(function (s: any) { return s.id === videoId; });
        if (idx > -1) { savedVideos.splice(idx, 1); }
        else { savedVideos.unshift({ id: videoId, title: currentVideo ? currentVideo.title : 'Video', channel: currentVideo ? currentVideo.channel : 'AniTube', thumbnail: getThumb(videoId, currentVideo ? currentVideo.thumbnail : ''), type: currentVideo ? currentVideo.type : 'anime', source: currentVideo ? currentVideo.source : 'youtube', savedAt: Date.now() }); }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      updateSaveUI();
      if (saveBtn) saveBtn.addEventListener('click', toggleSave);

      // Double tap
      var videoCard = document.getElementById('videoCard');
      var heart = document.getElementById('doubleTapHeart');
      var lastTap = 0;
      if (videoCard) {
        videoCard.addEventListener('click', function () {
          var now = Date.now();
          if (now - lastTap < 350) {
            if (!isLiked()) toggleLike();
            if (heart) { heart.classList.remove('pop'); void (heart as HTMLElement).offsetWidth; heart.classList.add('pop'); }
            lastTap = 0;
          } else { lastTap = now; }
        });
      }

      // Share
      var sendBtn = document.getElementById('sendBtn');
      if (sendBtn) {
        sendBtn.addEventListener('click', async function () {
          var isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
          sendBtn!.classList.add('sent');
          setTimeout(function () { sendBtn!.classList.remove('sent'); }, 600);
          if (isMobile && (navigator as any).share) {
            try { await (navigator as any).share({ title: currentVideo ? currentVideo.title : 'AniTubeBuzz', url: window.location.href }); } catch (e) {}
          } else {
            try {
              await navigator.clipboard.writeText(window.location.href);
              var lbl = sendBtn!.querySelector('.rp-btn-lbl');
              if (lbl) { var orig = lbl.textContent; lbl.textContent = 'Copied!'; setTimeout(function () { lbl!.textContent = orig; }, 1800); }
            } catch (e) { prompt('Copy:', window.location.href); }
          }
        });
      }

      // Video loader
      var iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      var videoLoader = document.getElementById('videoLoader');
      function hideLoader() { if (videoLoader) videoLoader.classList.add('hidden'); }
      if (iframe) iframe.addEventListener('load', function () { setTimeout(hideLoader, 500); });
      setTimeout(hideLoader, 3500);

      // Safiya event
      setTimeout(function () {
        if (currentVideo) {
          try { window.dispatchEvent(new CustomEvent('safiya:video-event', { detail: { action: 'watch', video: currentVideo } })); } catch (e) {}
        }
      }, 800);

      // Description toggle
      var descToggle = document.getElementById('descToggle');
      var descContent = document.getElementById('descContent');
      if (descToggle && descContent) {
        descToggle.addEventListener('click', function () {
          var expanded = descContent!.classList.toggle('expanded');
          descToggle!.textContent = expanded ? 'Show less' : 'Show more';
        });
      }

      // Hook banner
      var hookBanner = document.getElementById('hookBanner');
      var moreSection = document.getElementById('moreSection');
      if (hookBanner && moreSection) {
        hookBanner.addEventListener('click', function () { moreSection!.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      }

      // ═══ COMMENTS ═══
      var commentsList = document.getElementById('commentsList');
      var commentInput = document.getElementById('commentInput') as HTMLInputElement;
      var commentActions = document.getElementById('commentActions');
      var submitCommentBtn = document.getElementById('submitComment');
      var cancelCommentBtn = document.getElementById('cancelComment');
      var commentCountEl = document.getElementById('commentCount');
      var userInitialEl = document.getElementById('userInitial');
      var CHAT_KEY = 'anitube_chat_' + videoId;
      var USER_KEY = 'anitube_username';

      var username = localStorage.getItem(USER_KEY);
      if (!username) {
        var names = ['SakuraFan','NarutoKid','OtakuHero','AnimeVibes','MangaLover','WeebLife','AnimeVIP','SenpaiChan','KawaiiUser','DemonSlayer'];
        username = names[Math.floor(Math.random() * names.length)] + Math.floor(Math.random() * 999);
        localStorage.setItem(USER_KEY, username);
      }
      if (userInitialEl) userInitialEl.textContent = username.charAt(0).toUpperCase();

      function userColor(name: string): string {
        var colors = ['linear-gradient(135deg,#c084fc,#e879f9)','linear-gradient(135deg,#7dd3fc,#22d3ee)','linear-gradient(135deg,#f472b6,#ec4899)','linear-gradient(135deg,#fbbf24,#f97316)','linear-gradient(135deg,#34d399,#10b981)','linear-gradient(135deg,#a78bfa,#8b5cf6)','linear-gradient(135deg,#60a5fa,#3b82f6)','linear-gradient(135deg,#f87171,#ef4444)'];
        var hash = 0;
        for (var i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
        return colors[Math.abs(hash) % colors.length];
      }

      function loadComments(): any[] {
        try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch (e) { return []; }
      }
      function saveComments(list: any[]) {
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(list.slice(-100))); } catch (e) {}
      }
      function totalCount(list: any[]): number {
        var n = list.length;
        list.forEach(function (c: any) { if (c.replies) n += c.replies.length; });
        return n;
      }

      if (commentInput) {
        commentInput.addEventListener('focus', function () { if (commentActions) commentActions.style.display = 'flex'; });
      }
      if (cancelCommentBtn) {
        cancelCommentBtn.addEventListener('click', function () {
          if (commentInput) commentInput.value = '';
          if (commentActions) commentActions.style.display = 'none';
          if (commentInput) commentInput.blur();
        });
      }

      function renderComments() {
        if (!commentsList) return;
        var list = loadComments();
        if (commentCountEl) commentCountEl.textContent = String(totalCount(list));
        if (list.length === 0) {
          commentsList.innerHTML = '<div class="rp-comments-empty"><p>No comments yet. Be the first! \uD83D\uDCAC</p></div>';
          return;
        }
        commentsList.innerHTML = list.map(function (c: any, i: number) {
          var liked = c.liked ? 'active' : '';
          var disliked = c.disliked ? 'active' : '';
          var likes = c.likes || 0;
          var replies: any[] = c.replies || [];
          var repliesHtml = '';
          if (replies.length > 0) {
            repliesHtml =
              '<button class="rp-replies-toggle" data-idx="' + i + '">' +
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>' +
                '<span>' + replies.length + ' ' + (replies.length === 1 ? 'reply' : 'replies') + '</span>' +
              '</button>' +
              '<div class="rp-replies" data-idx="' + i + '">' +
                replies.map(function (r: any) {
                  return '<div class="rp-reply">' +
                    '<div class="rp-c-avatar" style="background:' + userColor(r.name) + ';">' + esc(r.name.charAt(0).toUpperCase()) + '</div>' +
                    '<div class="rp-c-body"><div class="rp-c-head"><span class="rp-c-name">@' + esc(r.name) + '</span><span class="rp-c-time">' + timeAgo(r.time) + '</span></div>' +
                    '<div class="rp-c-text">' + esc(r.text) + '</div></div></div>';
                }).join('') +
              '</div>';
          }
          return '<div class="rp-comment" data-idx="' + i + '">' +
            '<div class="rp-c-avatar" style="background:' + userColor(c.name) + ';">' + esc(c.name.charAt(0).toUpperCase()) + '</div>' +
            '<div class="rp-c-body">' +
              '<div class="rp-c-head"><span class="rp-c-name">@' + esc(c.name) + '</span><span class="rp-c-time">' + timeAgo(c.time) + '</span></div>' +
              '<div class="rp-c-text">' + esc(c.text) + '</div>' +
              '<div class="rp-c-actions">' +
                '<button class="rp-c-action ' + liked + '" data-idx="' + i + '" data-action="like"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg><span class="rp-c-count">' + (likes > 0 ? likes : '') + '</span></button>' +
                '<button class="rp-c-action ' + disliked + '" data-idx="' + i + '" data-action="dislike"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zM17 2h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path></svg></button>' +
                '<button class="rp-c-reply-btn" data-idx="' + i + '">Reply</button>' +
              '</div>' +
              '<div class="rp-reply-container" data-idx="' + i + '"></div>' +
              repliesHtml +
            '</div></div>';
        }).join('');

        commentsList.querySelectorAll('.rp-c-action').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var el = btn as HTMLElement;
            var idx = parseInt(el.dataset.idx || '0', 10);
            var action = el.dataset.action;
            var list = loadComments();
            if (!list[idx]) return;
            if (action === 'like') {
              if (list[idx].liked) { list[idx].liked = false; list[idx].likes = Math.max(0, (list[idx].likes || 0) - 1); }
              else { list[idx].liked = true; list[idx].likes = (list[idx].likes || 0) + 1; list[idx].disliked = false; }
            } else if (action === 'dislike') {
              if (list[idx].disliked) { list[idx].disliked = false; }
              else { list[idx].disliked = true; if (list[idx].liked) { list[idx].liked = false; list[idx].likes = Math.max(0, (list[idx].likes || 0) - 1); } }
            }
            saveComments(list);
            renderComments();
          });
        });

        commentsList.querySelectorAll('.rp-c-reply-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var el = btn as HTMLElement;
            var idx = parseInt(el.dataset.idx || '0', 10);
            var container = commentsList!.querySelector('.rp-reply-container[data-idx="' + idx + '"]') as HTMLElement;
            if (!container) return;
            if (container.querySelector('input')) { container.innerHTML = ''; return; }
            var av = document.createElement('div');
            av.className = 'rp-my-av';
            av.style.cssText = 'width:32px;height:32px;min-width:32px;font-size:13px;background:' + userColor(username || 'Y');
            av.textContent = (username || 'Y').charAt(0).toUpperCase();
            var wrap = document.createElement('div');
            var inp = document.createElement('input');
            inp.type = 'text'; inp.className = 'rp-reply-input'; inp.placeholder = 'Add a reply...'; inp.maxLength = 300;
            var acts = document.createElement('div');
            acts.className = 'rp-comment-actions'; acts.style.display = 'flex';
            var cancelR = document.createElement('button'); cancelR.className = 'rp-cancel-btn'; cancelR.textContent = 'Cancel';
            var submitR = document.createElement('button'); submitR.className = 'rp-submit-btn'; submitR.textContent = 'Reply';
            acts.appendChild(cancelR); acts.appendChild(submitR);
            wrap.appendChild(inp); wrap.appendChild(acts);
            var row = document.createElement('div'); row.className = 'rp-reply-input-row';
            row.appendChild(av); row.appendChild(wrap);
            container.innerHTML = ''; container.appendChild(row);
            inp.focus();
            cancelR.addEventListener('click', function () { container.innerHTML = ''; });
            function doReply() {
              var text = inp.value.trim();
              if (!text) return;
              var list = loadComments();
              if (!list[idx].replies) list[idx].replies = [];
              list[idx].replies.push({ name: username, text: text, time: Date.now() });
              saveComments(list); renderComments();
            }
            submitR.addEventListener('click', doReply);
            inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doReply(); } });
          });
        });

        commentsList.querySelectorAll('.rp-replies-toggle').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var idx = (btn as HTMLElement).dataset.idx;
            var rd = commentsList!.querySelector('.rp-replies[data-idx="' + idx + '"]');
            if (rd) rd.classList.toggle('show');
          });
        });
      }

      function submitComment() {
        if (!commentInput) return;
        var text = commentInput.value.trim();
        if (!text) return;
        var list = loadComments();
        list.unshift({ name: username, text: text, time: Date.now(), likes: 0, replies: [] });
        saveComments(list);
        commentInput.value = '';
        if (commentActions) commentActions.style.display = 'none';
        commentInput.blur();
        renderComments();
      }
      if (submitCommentBtn) submitCommentBtn.addEventListener('click', submitComment);
      if (commentInput) {
        commentInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); submitComment(); } });
      }
      renderComments();

      // ═══ SERIES ═══
      var seriesEpisodes: any[] = [];

      async function loadSeriesEpisodes() {
        if (!seriesName || seriesName.length < 5) return;
        try {
          var res = await fetch('/api/social-feed?related=true&series=' + encodeURIComponent(seriesName) + '&limit=25');
          var data = await res.json();
          if (data.success && data.videos && data.videos.length > 0) {
            var words = seriesName.toLowerCase().split(/\s+/).filter(function (w: string) { return w.length > 3; });
            seriesEpisodes = data.videos.filter(function (v: any) {
              if (v.id === videoId) return false;
              var title = (v.title || '').toLowerCase();
              var matches = words.filter(function (w: string) { return title.indexOf(w) > -1; }).length;
              return matches >= Math.max(2, Math.ceil(words.length * 0.5));
            });
            if (seriesEpisodes.length >= 2) renderSeriesEpisodes();
          }
        } catch (e) {}
      }

      function renderSeriesEpisodes() {
        var sec = document.getElementById('seriesSection');
        var list = document.getElementById('seriesList');
        var cnt = document.getElementById('seriesCount');
        if (!sec || !list || seriesEpisodes.length === 0) return;
        sec.style.display = 'block';
        if (cnt) cnt.textContent = String(seriesEpisodes.length);
        list.innerHTML = '';
        seriesEpisodes.slice(0, 15).forEach(function (v: any, i: number) {
          var a = document.createElement('a');
          a.href = '/reels/' + v.id;
          a.className = 'rp-si';
          a.style.animationDelay = (i * 40) + 'ms';
          var thumb = getThumb(v.id, v.thumbnail || '');
          var thumbDiv = document.createElement('div');
          thumbDiv.className = 'rp-si-thumb';
          if (thumb) { thumbDiv.appendChild(imgEl(thumb, '')); }
          else { thumbDiv.appendChild(fallbackDiv('\uD83D\uDCFA', '1.5rem')); }
          var epBadge = document.createElement('div');
          epBadge.className = 'rp-si-ep';
          epBadge.textContent = v.episodeNumber ? 'EP ' + v.episodeNumber : String(i + 1);
          thumbDiv.appendChild(epBadge);
          var info = document.createElement('div'); info.className = 'rp-si-info';
          var titleEl = document.createElement('h3'); titleEl.className = 'rp-si-title'; titleEl.textContent = trunc(v.title || 'Episode', 80);
          var chanEl = document.createElement('div'); chanEl.className = 'rp-si-channel'; chanEl.textContent = (v.channel || '').slice(0, 25);
          info.appendChild(titleEl); info.appendChild(chanEl);
          a.appendChild(thumbDiv); a.appendChild(info);
          list!.appendChild(a);
        });
      }

      loadSeriesEpisodes();

      // ═══ NEXT ═══
      var navigating = false;
      var sideItems: any[] = feedData.filter(function (v: any) { return v.id !== videoId; });

      function goTo(targetId: string) {
        if (navigating || !targetId) return;
        navigating = true;
        var c = document.getElementById('videoCard');
        if (c) { (c as HTMLElement).style.opacity = '0.4'; (c as HTMLElement).style.transition = 'opacity 0.2s'; }
        setTimeout(function () { window.location.href = '/reels/' + targetId; }, 180);
      }

      var nextBtn = document.getElementById('nextBtn');
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          if (seriesEpisodes.length > 0) {
            var ci = seriesEpisodes.findIndex(function (v: any) { return v.id === videoId; });
            var next = seriesEpisodes[ci + 1];
            if (next) { goTo(next.id); return; }
          }
          if (sideItems[0]) goTo(sideItems[0].id);
        });
      }

      // ═══ SIDEBAR ═══
      var sidebarFeed = document.getElementById('relatedFeed');
      var sidebarCountEl = document.getElementById('sidebarCount');
      var sideRendered = 0;
      var productPool: any[] = [];

      function makeSidebarItem(v: any, i: number): HTMLElement {
        var a = document.createElement('a');
        a.href = v.isAnimeDetail ? '/anime/' + v.id : '/reels/' + v.id;
        a.className = 'rp-si';
        a.style.animationDelay = ((i % 10) * 40) + 'ms';
        var thumb = getThumb(v.id, v.thumbnail || '');
        var tDiv = document.createElement('div'); tDiv.className = 'rp-si-thumb';
        if (thumb) { tDiv.appendChild(imgEl(thumb, '')); }
        else { tDiv.appendChild(fallbackDiv('\uD83D\uDCFA', '1.5rem')); }
        if (v.isNew) { var nb = document.createElement('div'); nb.className = 'rp-si-new'; nb.textContent = 'NEW'; tDiv.appendChild(nb); }
        var dur = Math.floor(Math.random() * 20 + 5) + ':' + String(Math.floor(Math.random() * 60)).padStart(2, '0');
        var db = document.createElement('div'); db.className = 'rp-si-duration'; db.textContent = dur; tDiv.appendChild(db);
        var info = document.createElement('div'); info.className = 'rp-si-info';
        var tEl = document.createElement('h3'); tEl.className = 'rp-si-title'; tEl.textContent = trunc(v.title || 'Video', 100);
        var cEl = document.createElement('div'); cEl.className = 'rp-si-channel'; cEl.textContent = (v.channel || 'AniTube').slice(0, 30);
        var views = Math.floor(Math.random() * 500 + 50) + 'K views';
        var ago = ['2 hours ago','5 hours ago','1 day ago','3 days ago','1 week ago'][Math.floor(Math.random() * 5)];
        var mEl = document.createElement('div'); mEl.className = 'rp-si-meta'; mEl.textContent = views + ' \u2022 ' + ago;
        info.appendChild(tEl); info.appendChild(cEl); info.appendChild(mEl);
        a.appendChild(tDiv); a.appendChild(info);
        return a;
      }

      function makeSidebarAd(p: any, i: number): HTMLElement {
        var a = document.createElement('a');
        a.href = '/product/' + p.id;
        a.className = 'rp-si rp-si-ad';
        a.style.animationDelay = ((i % 10) * 40) + 'ms';
        var tDiv = document.createElement('div'); tDiv.className = 'rp-si-thumb';
        if (p.image) { tDiv.appendChild(imgEl(p.image, '')); }
        else { tDiv.appendChild(fallbackDiv('\uD83D\uDED2', '1.5rem')); }
        var info = document.createElement('div'); info.className = 'rp-si-info';
        var tEl = document.createElement('h3'); tEl.className = 'rp-si-title'; tEl.textContent = trunc(p.title, 80);
        var pEl = document.createElement('div'); pEl.className = 'rp-si-price'; pEl.textContent = p.price;
        info.appendChild(tEl); info.appendChild(pEl);
        a.appendChild(tDiv); a.appendChild(info);
        return a;
      }

      function renderSidebar() {
        if (!sidebarFeed) return;
        var batchSize = 12;
        var end = Math.min(sideRendered + batchSize, sideItems.length);
        var placed = 0;
        for (var i = sideRendered; i < end; i++) {
          sidebarFeed.appendChild(makeSidebarItem(sideItems[i], i));
          placed++;
          if (placed % 5 === 0 && productPool.length > 0) {
            var p = productPool[Math.floor(Math.random() * productPool.length)];
            if (p) sidebarFeed.appendChild(makeSidebarAd(p, i));
          }
        }
        sideRendered = end;
        if (sidebarCountEl) sidebarCountEl.textContent = String(sideRendered);
      }

      // ═══ MORE FEED ═══
      var moreEl = document.getElementById('moreFeed');
      var moreLoadingEl = document.getElementById('moreLoading');
      var moreItems: any[] = sideItems.slice();
      var moreRendered = 0;
      var loadingMore = false;
      var cardsSinceProduct = 0;

      function makeCard(v: any, i: number): HTMLElement {
        var t = v.title || 'Video';
        var img = getThumb(v.id, v.thumbnail || '');
        var typeMap: any = { movies: '\uD83C\uDFAC MOVIE', kdrama: '\uD83C\uDDF0\uD83C\uDDF7 K-DRAMA', donghua: '\uD83D\uDC3C DONGHUA', anime: '\uD83C\uDF8C ANIME' };
        var typeLabel = typeMap[v.type] || '';
        var a = document.createElement('a');
        a.href = v.isAnimeDetail ? '/anime/' + v.id : '/reels/' + v.id;
        a.className = 'at-na-card';
        a.style.animationDelay = ((i % 8) * 40) + 'ms';
        a.style.textDecoration = 'none';
        var thumbDiv = document.createElement('div'); thumbDiv.className = 'at-na-thumb';
        if (img) { thumbDiv.appendChild(imgEl(img, 'at-na-img')); }
        else { thumbDiv.appendChild(fallbackDiv('\uD83D\uDCFA', '2rem')); }
        var shine = document.createElement('div'); shine.className = 'at-na-shine'; thumbDiv.appendChild(shine);
        var overlay = document.createElement('div'); overlay.className = 'at-na-overlay'; thumbDiv.appendChild(overlay);
        var play = document.createElement('div'); play.className = 'at-na-play';
        play.innerHTML = '<div style="position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#c084fc 0%,#e879f9 50%,#7dd3fc 100%);display:flex;align-items:center;justify-content:center;color:#fff;padding-left:2px;box-shadow:0 8px 25px rgba(192,132,252,0.7);z-index:2;"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></div>';
        thumbDiv.appendChild(play);
        if (v.isNew) {
          var nb = document.createElement('div');
          nb.style.cssText = 'position:absolute;top:6px;left:6px;padding:3px 7px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;letter-spacing:0.08em;border-radius:4px;z-index:6;';
          nb.textContent = 'NEW'; thumbDiv.appendChild(nb);
        }
        if (typeLabel) {
          var tb = document.createElement('div');
          tb.style.cssText = 'position:absolute;bottom:6px;left:6px;padding:2px 7px;background:rgba(10,5,23,0.9);color:#fbbf24;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;border-radius:4px;z-index:6;';
          tb.textContent = typeLabel; thumbDiv.appendChild(tb);
        }
        var info = document.createElement('div'); info.style.cssText = 'padding:8px 3px 4px;position:relative;z-index:1;';
        var titleEl = document.createElement('h3');
        titleEl.className = 'at-na-title';
        titleEl.style.cssText = 'font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.78rem;font-weight:700;color:var(--text-primary);margin:0 0 3px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;min-height:2em;';
        titleEl.textContent = trunc(t, 55);
        var chanEl = document.createElement('div');
        chanEl.style.cssText = 'font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;color:var(--text-muted);opacity:0.75;';
        chanEl.textContent = v.channel || 'Channel';
        info.appendChild(titleEl); info.appendChild(chanEl);
        a.appendChild(thumbDiv); a.appendChild(info);
        return a;
      }

      function makeProductCard(p: any, i: number): HTMLElement {
        var a = document.createElement('a');
        a.href = '/product/' + p.id;
        a.className = 'at-na-card';
        a.style.cssText = 'animation-delay:' + ((i % 8) * 40) + 'ms;text-decoration:none;';
        var thumbDiv = document.createElement('div'); thumbDiv.className = 'at-na-thumb'; thumbDiv.style.borderColor = 'rgba(251,191,36,0.5)';
        if (p.image) { thumbDiv.appendChild(imgEl(p.image, 'at-na-img')); }
        else { thumbDiv.appendChild(fallbackDiv('\uD83D\uDED2', '2rem')); }
        var shine = document.createElement('div'); shine.className = 'at-na-shine'; thumbDiv.appendChild(shine);
        var overlay = document.createElement('div'); overlay.className = 'at-na-overlay'; thumbDiv.appendChild(overlay);
        var adBadge = document.createElement('div');
        adBadge.style.cssText = 'position:absolute;top:6px;left:6px;padding:3px 7px;background:linear-gradient(135deg,#fbbf24,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.5rem;font-weight:800;border-radius:4px;z-index:6;';
        adBadge.textContent = 'AD'; thumbDiv.appendChild(adBadge);
        var priceBadge = document.createElement('div');
        priceBadge.style.cssText = 'position:absolute;bottom:6px;left:6px;padding:2px 7px;background:linear-gradient(135deg,#fbbf24,#f97316);color:#fff;font-family:\'JetBrains Mono\',monospace;font-size:0.6rem;font-weight:800;border-radius:4px;z-index:6;';
        priceBadge.textContent = p.price; thumbDiv.appendChild(priceBadge);
        var info = document.createElement('div'); info.style.cssText = 'padding:8px 3px 4px;position:relative;z-index:1;';
        var titleEl = document.createElement('h3');
        titleEl.className = 'at-na-title';
        titleEl.style.cssText = 'font-family:\'Bricolage Grotesque\',sans-serif;font-size:0.78rem;font-weight:700;color:var(--text-primary);margin:0 0 3px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:all 0.3s ease;min-height:2em;';
        titleEl.textContent = trunc(p.title, 55);
        var sponsEl = document.createElement('div');
        sponsEl.style.cssText = 'font-family:\'JetBrains Mono\',monospace;font-size:0.58rem;color:#fbbf24;opacity:0.9;';
        sponsEl.textContent = 'Sponsored';
        info.appendChild(titleEl); info.appendChild(sponsEl);
        a.appendChild(thumbDiv); a.appendChild(info);
        return a;
      }

      function renderMoreBatch() {
        if (!moreEl) return;
        var batchSize = 8;
        var end = Math.min(moreRendered + batchSize, moreItems.length);
        for (var i = moreRendered; i < end; i++) {
          moreEl.appendChild(makeCard(moreItems[i], i));
          cardsSinceProduct++;
          if (cardsSinceProduct >= 6 && productPool.length > 0) {
            var p = productPool[Math.floor(Math.random() * productPool.length)];
            if (p) moreEl.appendChild(makeProductCard(p, i));
            cardsSinceProduct = 0;
          }
        }
        moreRendered = end;
      }

      async function fetchMore() {
        if (loadingMore) return;
        loadingMore = true;
        if (moreLoadingEl) moreLoadingEl.classList.add('show');
        try {
          var types = ['anime','donghua','kdrama','movies'];
          var type = types[Math.floor(Math.random() * types.length)];
          var page = Math.floor(Math.random() * 5) + 1;
          var res = await fetch('/api/social-feed?type=' + type + '&page=' + page + '&limit=15');
          var data = await res.json();
          if (data.success && data.videos) {
            var existing = new Set(moreItems.map(function (v: any) { return v.id; }));
            existing.add(videoId);
            var fresh = data.videos.filter(function (v: any) { return !existing.has(v.id); });
            moreItems = moreItems.concat(fresh);
            sideItems = sideItems.concat(fresh);
            renderMoreBatch();
            renderSidebar();
          }
        } catch (e) {}
        if (moreLoadingEl) moreLoadingEl.classList.remove('show');
        loadingMore = false;
      }

      async function loadProducts() {
        try {
          var res = await fetch('/api/products?limit=30');
          var data = await res.json();
          if (data.success && data.products) productPool = data.products;
        } catch (e) {}
      }

      loadProducts().then(function () {
        renderSidebar();
        renderMoreBatch();
      });

      var scrollTimer: any = null;
      window.addEventListener('scroll', function () {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function () {
          if (loadingMore) return;
          var bottom = window.scrollY + window.innerHeight;
          var height = document.documentElement.scrollHeight;
          if (bottom > height - 800) {
            if (moreRendered < moreItems.length) renderMoreBatch();
            else fetchMore();
          }
        }, 100);
      }, { passive: true });

      var autoplayToggle = document.getElementById('autoplayToggle') as HTMLInputElement;
      if (autoplayToggle) {
        if (localStorage.getItem('anitube_autoplay') === 'false') autoplayToggle.checked = false;
        autoplayToggle.addEventListener('change', function () {
          localStorage.setItem('anitube_autoplay', String(autoplayToggle.checked));
        });
      }
    })();
  </script>
</BaseLayout>
