    }
    
    /* ═══ PRODUCT ROW ═══ */
    .atbrp-product-row {
      grid-column: 1 / -1;
      margin: 8px 0;
      padding: 18px;
      background: linear-gradient(135deg, rgba(28,15,61,0.5), rgba(20,10,45,0.3));
      border: 1px solid rgba(192,132,252,0.25);
      border-radius: 18px;
      backdrop-filter: blur(10px);
      animation: atbrpCardIn 0.5s ease backwards;
    }
    
    .atbrp-product-head {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 14px;
    }
    .atbrp-product-title {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.12em;
      color: #e879f9;
      text-transform: uppercase;
    }
    .atbrp-product-title::before {
      content: ''; width: 4px; height: 16px;
      background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
