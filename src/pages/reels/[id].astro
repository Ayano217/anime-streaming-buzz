---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const videoId = id || '';
---

<BaseLayout>
  <div class="reels-page" data-video-id={videoId}>
    <div class="reels-bg" id="reelsBg"></div>

    <header class="reels-header">
      <button class="reels-icon-btn" id="reelsBack" aria-label="Back">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="reels-brand">AniTube<span>Buzz</span></div>
      <div class="reels-counter" id="reelsCounter">1 / 1</div>
    </header>

    <button class="reels-nav reels-nav-up" id="reelsUp" aria-label="Previous">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>
    <button class="reels-nav reels-nav-down" id="reelsDown" aria-label="Next">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="reels-container" id="reelsContainer">
      <div class="reels-loading" id="reelsLoading"><div class="reels-spinner"></div></div>
    </div>

    <div class="reels-toast" id="reelsToast"></div>
  </div>
</BaseLayout>

<style is:global>
  body:has(.reels-page) {
    overflow: hidden !important;
    background: #000 !important;
    margin: 0 !important;
  }
  body:has(.reels-page) > header,
  body:has(.reels-page) > footer,
  body:has(.reels-page) .site-header,
  body:has(.reels-page) .site-footer,
  body:has(.reels-page) header.site-header,
  body:has(.reels-page) footer.site-footer,
  body:has(.reels-page) .ambient-bg,
  body:has(.reels-page) #btt,
  body:has(.reels-page) .back-to-top {
    display: none !important;
  }
  body:has(.reels-page) #app {
    background: #000 !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100vw !important;
    width: 100vw !important;
    height: 100vh !important;
    overflow: hidden !important;
    display: block !important;
    position: relative !important;
  }
  body:has(.reels-page) #app > *:not(:has(.reels-page)):not(.reels-page) {
    display: none !important;
  }
</style>

<style>
  .reels-page {
    position: fixed;
    top: 0; left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    color: #fff;
    z-index: 9000;
    font-family: 'Inter', 'DM Sans', sans-serif;
    overflow: hidden;
  }

  .reels-bg {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(50px) brightness(0.3) saturate(1.3);
    transform: scale(1.2);
    transition: background-image 0.5s ease;
    z-index: 1;
  }

  .reels-header {
    position: absolute;
    top: 0; left: 0; right: 0;
    padding: 16px 22px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 100;
    pointer-events: none;
    box-sizing: border-box;
  }
  .reels-icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.12);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s ease;
    padding: 0;
    pointer-events: auto;
  }
  .reels-icon-btn:hover {
    background: rgba(192,132,252,0.35);
    border-color: rgba(192,132,252,0.6);
    transform: scale(1.06);
  }
  .reels-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }
  .reels-brand span {
    color: #fff;
    -webkit-text-fill-color: #fff;
  }
  .reels-counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255,255,255,0.75);
    letter-spacing: 0.08em;
    padding: 5px 12px;
    background: rgba(0,0,0,0.5);
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.08);
    pointer-events: auto;
  }

  .reels-nav {
    position: absolute;
    right: 30px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(20,20,30,0.8);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s ease;
    padding: 0;
    z-index: 90;
  }
  .reels-nav:hover {
    background: rgba(192,132,252,0.45);
    transform: scale(1.1);
  }
  .reels-nav-up { top: calc(50% - 55px); }
  .reels-nav-down { top: calc(50% + 25px); }

  .reels-container {
    position: absolute;
    inset: 0;
    z-index: 10;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .reels-container::-webkit-scrollbar {
    display: none;
    width: 0;
  }

  .reel {
    height: 100vh;
    width: 100vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .reel-card {
    position: relative;
    height: min(88vh, calc(100vh - 60px));
    aspect-ratio: 9 / 16;
    max-width: min(90vw, 460px);
    background: #0a0517;
    border-radius: 24px;
    overflow: visible;
    box-shadow: 
      0 30px 80px rgba(0,0,0,0.85),
      0 0 0 1px rgba(255,255,255,0.06);
  }

  .reel-card::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 28px;
    background: linear-gradient(135deg,
      rgba(192,132,252,0.8) 0%,
      rgba(232,121,249,0.5) 25%,
      rgba(125,211,252,0.8) 50%,
      rgba(232,121,249,0.5) 75%,
      rgba(192,132,252,0.8) 100%);
    background-size: 300% 300%;
    animation: reelGlow 6s ease infinite;
    z-index: -1;
    opacity: 0.55;
    filter: blur(12px);
  }
  @keyframes reelGlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .reel-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 24px;
    overflow: hidden;
    z-index: 1;
  }
  .reel-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .reel-send {
    position: absolute;
    right: -62px;
    bottom: 28px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(20,10,45,0.9);
    border: 1px solid rgba(192,132,252,0.3);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    padding: 0;
    z-index: 15;
    box-shadow: 0 8px 24px rgba(0,0,0,0.6);
  }
  .reel-send:hover {
    background: linear-gradient(135deg, rgba(192,132,252,0.5), rgba(232,121,249,0.4));
    border-color: rgba(232,121,249,0.8);
    transform: scale(1.12);
  }

  .reels-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    z-index: 200;
  }
  .reels-loading.hidden { display: none; }
  .reels-spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(192,132,252,0.15);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: reelSpin 0.8s linear infinite;
  }
  @keyframes reelSpin { to { transform: rotate(360deg); } }

  .reels-toast {
    position: fixed;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%) translateY(30px);
    padding: 12px 24px;
    background: rgba(20,10,45,0.95);
    border: 1px solid rgba(192,132,252,0.4);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 500;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34,1.56,0.64,1);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
  }
  .reels-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 768px) {
    .reel-card {
      height: 100vh;
      max-width: 100vw;
      width: 100vw;
      aspect-ratio: unset;
      border-radius: 0;
    }
    .reel-card::before { display: none; }
    .reel-video { border-radius: 0; }
    .reels-nav { display: none; }
    .reel-send {
      right: 14px;
      bottom: 110px;
    }
    .reels-header { padding: 12px 14px; height: 56px; }
  }
  @media (max-width: 480px) {
    .reels-icon-btn { width: 38px; height: 38px; }
    .reels-brand { font-size: 0.95rem; }
    .reels-counter { font-size: 0.65rem; padding: 5px 10px; }
  }
</style>

<script is:inline define:vars={{ videoId }}>
(function(){
  var CURRENT_ID = videoId;
  var containerEl = document.getElementById('reelsContainer');
  var loadingEl = document.getElementById('reelsLoading');
  var bgEl = document.getElementById('reelsBg');
  var toastEl = document.getElementById('reelsToast');
  var backBtn = document.getElementById('reelsBack');
  var upBtn = document.getElementById('reelsUp');
  var downBtn = document.getElementById('reelsDown');
  var counterEl = document.getElementById('reelsCounter');

  var videos = [];
  var currentIdx = 0;
  var seenIds = {};

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}

  function toast(msg){
    if(!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastEl._t);
    toastEl._t = setTimeout(function(){ toastEl.classList.remove('show'); }, 1800);
  }

  function updateCounter(){
    if(counterEl) counterEl.textContent = (currentIdx + 1) + ' / ' + videos.length;
  }

  function detectSource(id){
    if(!id) return 'youtube';
    if(id.indexOf('dm_') === 0) return 'dailymotion';
    if(id.indexOf('bili_') === 0) return 'bilibili';
    if(id.indexOf('od_') === 0) return 'odysee';
    if(id.indexOf('rum_') === 0) return 'rumble';
    if(id.indexOf('ytshort_') === 0) return 'youtube_shorts';
    if(id.indexOf('yt_') === 0) return 'youtube';
    return 'youtube';
  }
  function stripPrefix(id, src){
    return id.replace(/^(dm_|bili_|od_|rum_|ytshort_|yt_)/, '');
  }

  function buildFallback(id){
    var src = detectSource(id);
    var raw = stripPrefix(id, src);
    var embed = '', thumb = '';
    if(src === 'dailymotion'){
      embed = 'https://www.dailymotion.com/embed/video/' + raw;
      thumb = 'https://www.dailymotion.com/thumbnail/video/' + raw;
    } else if(src === 'bilibili'){
      embed = 'https://player.bilibili.com/player.html?bvid=' + raw;
    } else if(src === 'odysee'){
      embed = 'https://odysee.com/$/embed/' + raw;
    } else if(src === 'rumble'){
      embed = 'https://rumble.com/embed/' + raw + '/';
    } else {
      embed = 'https://www.youtube.com/embed/' + raw;
      thumb = 'https://i.ytimg.com/vi/' + raw + '/hqdefault.jpg';
    }
    return { id: id, title: 'Video', channel: 'Channel', thumbnail: thumb, embedUrl: embed, source: src, type: 'anime', aspect: 'portrait' };
  }

  function buildEmbedUrl(v){
    var url = v.embedUrl || '';
    if(!url) return '';
    var sep = url.indexOf('?') === -1 ? '?' : '&';
    if(v.source === 'youtube' || v.source === 'youtube_shorts'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&modestbranding=1&rel=0&playsinline=1';
    } else if(v.source === 'dailymotion'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0';
    } else if(v.source === 'bilibili'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&muted=1';
    } else {
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1';
    }
    return url;
  }

  function renderReel(v, idx){
    var el = document.createElement('div');
    el.className = 'reel';
    el.dataset.idx = idx;
    el.innerHTML =
      '<div class="reel-card">' +
        '<div class="reel-video" data-container></div>' +
        '<button class="reel-send" data-send aria-label="Send">' +
          '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>' +
        '</button>' +
      '</div>';
    el.querySelector('[data-send]').addEventListener('click', function(e){
      e.stopPropagation();
      var url = window.location.origin + '/reels/' + encodeURIComponent(v.id);
      if(navigator.share){ navigator.share({title: v.title || 'Video', url: url}).catch(function(){}); }
      else { try{ navigator.clipboard.writeText(url); toast('🔗 Link copied'); }catch(_){ toast('Copy failed'); } }
    });
    return el;
  }

  function activate(idx){
    if(idx < 0 || idx >= videos.length) return;
    var reels = containerEl.querySelectorAll('.reel');
    reels.forEach(function(reel, i){
      var container = reel.querySelector('[data-container]');
      if(!container) return;
      if(i === idx){
        if(!container.querySelector('iframe')){
          var v = videos[i];
          var url = buildEmbedUrl(v);
          if(url){
            var iframe = document.createElement('iframe');
            iframe.src = url;
            iframe.setAttribute('frameborder','0');
            iframe.setAttribute('allow','accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; fullscreen; web-share');
            container.appendChild(iframe);
          }
        }
        currentIdx = idx;
        var vv = videos[idx];
        if(vv && vv.thumbnail && bgEl){
          bgEl.style.backgroundImage = 'url(' + vv.thumbnail + ')';
        }
        try{
          window.dispatchEvent(new CustomEvent('safiya:video-event', { detail: { action: 'watch', video: vv } }));
        }catch(_){}
        updateCounter();
      } else {
        if(Math.abs(i - idx) > 1){ container.innerHTML = ''; }
      }
    });
  }

  async function loadFeed(){
    try {
      var clicked = null;
      var types = ['anime','donghua','kdrama','movies'];
      for(var t = 0; t < types.length; t++){
        if(clicked) break;
        try {
          var r = await fetch('/api/social-feed?type=' + types[t] + '&limit=50');
          var d = await r.json();
          if(d.success && d.videos){ clicked = d.videos.find(function(v){ return v.id === CURRENT_ID; }); }
        }catch(_){}
      }
      if(!clicked) clicked = buildFallback(CURRENT_ID);

      videos = [clicked];
      seenIds[clicked.id] = true;

      var loaders = [
        '/api/social-feed?type=anime&limit=30',
        '/api/social-feed?type=donghua&limit=30',
        '/api/social-feed?type=kdrama&limit=20',
        '/api/social-feed?type=movies&limit=20'
      ];
      for(var i = 0; i < loaders.length; i++){
        try {
          var rr = await fetch(loaders[i]);
          var dd = await rr.json();
          if(dd.success && dd.videos){
            dd.videos.forEach(function(v){
              if(!seenIds[v.id]){ videos.push(v); seenIds[v.id] = true; }
            });
          }
        }catch(_){}
      }

      containerEl.innerHTML = '';
      videos.forEach(function(v, i){ containerEl.appendChild(renderReel(v, i)); });

      if(loadingEl) loadingEl.classList.add('hidden');
      setTimeout(function(){ activate(0); }, 100);

    } catch(err){
      console.error('[reels]', err);
      if(loadingEl){
        loadingEl.innerHTML = '<div style="text-align:center;color:#fff;padding:20px;"><div style="font-size:2rem;margin-bottom:10px;">😔</div><div>Failed to load</div><button id="rBack" style="margin-top:20px;padding:10px 20px;background:rgba(192,132,252,0.3);border:1px solid rgba(192,132,252,0.6);color:#fff;border-radius:8px;cursor:pointer;">Go Back</button></div>';
        var eb = document.getElementById('rBack');
        if(eb) eb.addEventListener('click', goBack);
      }
    }
  }

  var scrollTimer;
  containerEl.addEventListener('scroll', function(){
    if(scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function(){
      var idx = Math.round(containerEl.scrollTop / window.innerHeight);
      if(idx !== currentIdx && idx >= 0 && idx < videos.length){ activate(idx); }
    }, 120);
  }, { passive: true });

  function scrollTo(idx){
    if(idx < 0 || idx >= videos.length) return;
    containerEl.scrollTo({ top: idx * window.innerHeight, behavior: 'smooth' });
  }
  if(upBtn) upBtn.addEventListener('click', function(){ scrollTo(currentIdx - 1); });
  if(downBtn) downBtn.addEventListener('click', function(){ scrollTo(currentIdx + 1); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowDown' || e.key === 'j'){ e.preventDefault(); scrollTo(currentIdx + 1); }
    else if(e.key === 'ArrowUp' || e.key === 'k'){ e.preventDefault(); scrollTo(currentIdx - 1); }
    else if(e.key === 'Escape'){ goBack(); }
  });

  function goBack(){
    if(document.referrer && document.referrer.indexOf(window.location.origin) === 0){ history.back(); }
    else { window.location.href = '/'; }
  }
  if(backBtn) backBtn.addEventListener('click', goBack);

  loadFeed();
})();
</script>rebuild: reels TikTok-style feed, clean minimal, video plays properly
