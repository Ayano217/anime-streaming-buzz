    [data-theme="light"] .atbrp-autoplay { background: rgba(255, 255, 255, 0.7); }
    
    .atbrp-autoplay-label {
      display: flex; align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 12.5px; font-weight: 600;
      color: var(--text-secondary);
    }
    
    .atbrp-autoplay-label input[type="checkbox"] {
      position: absolute; opacity: 0; width: 0; height: 0;
    }
    
    .atbrp-switch {
      position: relative;
      width: 36px; height: 20px;
      background: rgba(192, 132, 252, 0.2);
      border-radius: 100px;
      transition: background 0.25s ease;
    }
    .atbrp-switch::after {
      content: '';
      position: absolute;
      top: 2px; left: 2px;
      width: 16px; height: 16px;
      background: white;
      border-radius: 50%;
      transition: transform 0.25s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }
    .atbrp-autoplay-label input:checked ~ .atbrp-switch {
      background: linear-gradient(135deg, #c084fc, #e879f9);
    }
    .atbrp-autoplay-label input:checked ~ .atbrp-switch::after {
      transform: translateX(16px);
    }
    
    /* Sidebar list — scrollable */
    .atbrp-side-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
      padding-right: 6px;
      flex: 1;
      max-height: calc(100vh - 250px);
      scrollbar-width: thin;
      scrollbar-color: rgba(192, 132, 252, 0.3) transparent;
    }
    .atbrp-side-list::-webkit-scrollbar { width: 5px; }
    .atbrp-side-list::-webkit-scrollbar-thumb { background: rgba(192, 132, 252, 0.35); border-radius: 3px; }
    
    /* Sidebar item — premium mini card */
    .atbrp-si {
      display: flex;
      gap: 12px;
      padding: 8px;
      background: linear-gradient(135deg, rgba(28, 15, 61, 0.5), rgba(20, 10, 40, 0.3));
      border: 1px solid rgba(192, 132, 252, 0.15);
      border-radius: 14px;
      text-decoration: none; color: inherit; cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      animation: atbrpSiIn 0.5s ease backwards;
      position: relative;
      overflow: hidden;
    }
    [data-theme="light"] .atbrp-si { background: rgba(255, 255, 255, 0.8); }
    
    @keyframes atbrpSiIn {
      from { opacity: 0; transform: translateX(20px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    
    .atbrp-si:hover {
      background: linear-gradient(135deg, rgba(36, 21, 72, 0.85), rgba(28, 15, 61, 0.7));
      border-color: rgba(232, 121, 249, 0.6);
      transform: translateX(-4px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3), 0 0 20px rgba(192, 132, 252, 0.2);
    }
    
    .atbrp-si-thumb {
      position: relative;
      flex-shrink: 0;
      width: 130px; height: 74px;
      border-radius: 10px;
      overflow: hidden;
      background: #0d0520;
      border: 1px solid rgba(192, 132, 252, 0.2);
    }
    
    .atbrp-si-thumb img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease, filter 0.3s ease;
    }
    
    .atbrp-si:hover .atbrp-si-thumb img {
      transform: scale(1.12);
      filter: brightness(0.7);
    }
    
    /* Shine effect on sidebar hover */
    .atbrp-si-thumb::after {
      content: '';
      position: absolute;
      top: 0; left: -80%;
      width: 60%; height: 100%;
      background: linear-gradient(105deg, transparent, rgba(255,255,255,0.25), transparent);
      transition: left 0.7s ease;
      pointer-events: none;
      z-index: 2;
    }
    .atbrp-si:hover .atbrp-si-thumb::after { left: 120%; }
    
    /* Play button on sidebar hover */
    .atbrp-si-play {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0.5);
      width: 32px; height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      display: flex; align-items: center; justify-content: center;
      color: white;
      opacity: 0;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
      z-index: 3;
      box-shadow: 0 6px 18px rgba(192, 132, 252, 0.7);
    }
    .atbrp-si:hover .atbrp-si-play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    
    /* Duration badge */
    .atbrp-si-duration {
      position: absolute;
      bottom: 4px; right: 4px;
      padding: 1px 5px;
      background: rgba(0, 0, 0, 0.85);
      color: #fbbf24;
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px; font-weight: 800;
      border-radius: 3px;
      z-index: 3;
      backdrop-filter: blur(4px);
    }
    
    /* NEW badge on sidebar */
    .atbrp-si-new {
      position: absolute;
      top: 4px; left: 4px;
      padding: 1px 5px;
      background: linear-gradient(135deg, #ef4444, #f97316);
      color: white;
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px; font-weight: 800;
      letter-spacing: 0.05em;
      border-radius: 3px;
      z-index: 4;
    }
    
    .atbrp-si-info {
      flex: 1; min-width: 0;
      display: flex; flex-direction: column;
      justify-content: space-between;
      padding: 2px 0;
    }
    
    .atbrp-si-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 700;
      color: var(--text-primary);
      line-height: 1.35;
      margin: 0 0 4px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 0.3s ease;
    }
    .atbrp-si:hover .atbrp-si-title {
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .atbrp-si-channel {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--text-muted);
      letter-spacing: 0.03em;
    }
    
    .atbrp-si-meta {
      display: flex; align-items: center; gap: 6px;
      margin-top: 3px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      color: var(--text-faint);
    }
    
    .atbrp-si-meta-dot {
      width: 3px; height: 3px;
      border-radius: 50%;
