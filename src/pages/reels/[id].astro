    }
    
    /* ═══════════ MOBILE ═══════════ */
    @media (max-width: 960px) {
      .atbrp-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      .atbrp-sidebar {
        position: static;
        max-height: none;
      }
      .atbrp-side-list {
        max-height: none;
        overflow-y: visible;
      }
      .atbrp-title { font-size: 18px; }
      .atbrp-meta-bar {
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
      }
      .atbrp-actions {
        gap: 6px;
      }
      .atbrp-btn {
        padding: 8px 12px;
        font-size: 12px;
        height: 38px;
        flex: 1;
        justify-content: center;
      }
      .atbrp-chat-messages { max-height: 320px; }
      .atbrp-si-thumb { width: 130px; height: 74px; }
      .atbrp-player[data-aspect="portrait"] {
        max-width: 100%;
        max-height: calc(100dvh - 220px);
      }
    }
    
    @media (max-width: 480px) {
      .atbrp-container { padding: 0 14px; }
      .atbrp-btn-label { display: none; }
      .atbrp-btn { padding: 8px 10px; min-width: 40px; }
      .atbrp-btn-next .atbrp-btn-label { display: inline; }
    }
    
    /* Reduce motion accessibility */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <script>
    (function() {
      const root = document.getElementById('reels-root') as HTMLElement;
      if (!root) return;

      const videoId = root.dataset.videoid || '';
      const currentVideo: any = (window as any).__REELS_VIDEO__ || null;
      const feedData: any[] = (window as any).__REELS_FEED__ || [];
      const nextId = (window as any).__NEXT_ID__ || '';
      const prevId = (window as any).__PREV_ID__ || '';

      // ═══ SAVE RESUME ═══
      try {
        if (videoId) {
          localStorage.setItem('anitube_resume_video', videoId);
          localStorage.setItem('anitube_resume_time', String(Date.now()));
        }
      } catch(e) {}

      // ═══ UTILITIES ═══
      function getThumb(vid: string, existing: string = ''): string {
        if (existing && existing.trim()) return existing;
        if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
          return `https://i.ytimg.com/vi/${vid.replace(/^(yts_|yt_)/, '')}/hqdefault.jpg`;
        }
        if (vid.startsWith('dm_')) {
          return `https://www.dailymotion.com/thumbnail/video/${vid.replace('dm_', '')}`;
        }
        return '';
      }

      function esc(s: string): string {
        return String(s || '').replace(/[&<>"']/g, (c: string) => (
          {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] || c
        ));
      }

      function trunc(s: string, n: number): string {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '…' : s;
      }

      function shuffle<T>(arr: T[]): T[] {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      function timeAgo(ts: number): string {
        const diff = Date.now() - ts;
        const s = Math.floor(diff / 1000);
        if (s < 60) return 'now';
        const m = Math.floor(s / 60);
        if (m < 60) return `${m}m`;
        const h = Math.floor(m / 60);
        if (h < 24) return `${h}h`;
        return `${Math.floor(h / 24)}d`;
      }

      // ═══ SAVE TO HISTORY ═══
      try {
        if (currentVideo && videoId) {
          const goodThumb = getThumb(videoId, currentVideo.thumbnail);
          const history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          const filtered = history.filter((h: any) => h.id !== videoId);
          filtered.unshift({
            id: videoId,
            title: currentVideo.title,
            channel: currentVideo.channel,
            thumbnail: goodThumb,
            type: currentVideo.type || 'anime',
            source: currentVideo.source || 'youtube',
            watchedAt: Date.now()
          });
          localStorage.setItem('anitube_history', JSON.stringify(filtered.slice(0, 100)));
        }
      } catch(e) {}

      // ═══ LIKE BUTTON ═══
      const likeBtn = document.getElementById('likeBtn');
      const likedVideos: string[] = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      const isLiked = () => likedVideos.includes(videoId);
      
      function updateLikeUI() {
        if (!likeBtn) return;
        if (isLiked()) {
          likeBtn.classList.add('active');
          const label = likeBtn.querySelector('.atbrp-btn-label');
          if (label) label.textContent = 'Liked';
        } else {
          likeBtn.classList.remove('active');
          const label = likeBtn.querySelector('.atbrp-btn-label');
          if (label) label.textContent = 'Like';
        }
      }
      
      function toggleLike() {
        const idx = likedVideos.indexOf(videoId);
        if (idx > -1) likedVideos.splice(idx, 1);
        else likedVideos.push(videoId);
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
        updateLikeUI();
      }
      
      updateLikeUI();
      likeBtn?.addEventListener('click', toggleLike);

      // ═══ SAVE BUTTON ═══
      const saveBtn = document.getElementById('saveBtn');
      const savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      const isSaved = () => savedVideos.some((s: any) => s.id === videoId);

      function updateSaveUI() {
        if (!saveBtn) return;
        const saved = isSaved();
        if (saved) {
          saveBtn.classList.add('active');
          const label = saveBtn.querySelector('.atbrp-btn-label');
          if (label) label.textContent = 'Saved';
        } else {
          saveBtn.classList.remove('active');
          const label = saveBtn.querySelector('.atbrp-btn-label');
          if (label) label.textContent = 'Save';
        }
      }

      function toggleSave() {
        const idx = savedVideos.findIndex((s: any) => s.id === videoId);
        if (idx > -1) {
          savedVideos.splice(idx, 1);
        } else {
          savedVideos.unshift({
            id: videoId,
            title: currentVideo?.title || 'Video',
            channel: currentVideo?.channel || 'AniTube',
            thumbnail: getThumb(videoId, currentVideo?.thumbnail),
            type: currentVideo?.type || 'anime',
            source: currentVideo?.source || 'youtube',
            savedAt: Date.now()
          });
        }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }

      updateSaveUI();
      saveBtn?.addEventListener('click', toggleSave);

      // ═══ DOUBLE TAP HEART ═══
      const videoCard = document.getElementById('videoCard');
      const heart = document.getElementById('doubleTapHeart');
      let lastTap = 0;
      videoCard?.addEventListener('click', () => {
        const now = Date.now();
        if (now - lastTap < 350) {
          if (!isLiked()) toggleLike();
          if (heart) {
            heart.classList.remove('pop');
            void (heart as HTMLElement).offsetWidth;
            heart.classList.add('pop');
          }
          lastTap = 0;
        } else { lastTap = now; }
      });

      // ═══ SHARE / SEND ═══
      const sendBtn = document.getElementById('sendBtn');
      async function handleSend() {
        if (!sendBtn) return;
        const shareData = { title: currentVideo?.title || 'AniTubeBuzz', url: window.location.href };
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        sendBtn.classList.add('sent');
        setTimeout(() => sendBtn.classList.remove('sent'), 600);
        if (isMobile && (navigator as any).share) {
          try { await (navigator as any).share(shareData); } catch {}
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const label = sendBtn.querySelector('.atbrp-btn-label');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => { label.textContent = orig; }, 1800);
            }
          } catch { prompt('Copy link:', window.location.href); }
        }
      }
      sendBtn?.addEventListener('click', handleSend);

      // ═══ NAVIGATION — smooth transition ═══
      let navigating = false;
      function goTo(targetId: string) {
        if (navigating || !targetId) return;
        navigating = true;
        const c = document.getElementById('videoCard');
        if (c) {
          c.style.opacity = '0.4';
          c.style.transform = 'scale(0.97)';
          c.style.transition = 'all 0.3s ease';
        }
        setTimeout(() => { window.location.href = `/reels/${targetId}`; }, 220);
      }
      document.getElementById('nextBtn')?.addEventListener('click', () => { if (nextId) goTo(nextId); });

      // ═══ VIDEO LOADER HIDE — multiple fallbacks ═══
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const videoLoader = document.getElementById('videoLoader');
      
      function hideVideoLoader() {
        videoLoader?.classList.add('hidden');
      }
      
      iframe?.addEventListener('load', () => { setTimeout(hideVideoLoader, 500); });
      setTimeout(hideVideoLoader, 3500); // Always hide after 3.5s

      // ═══ SAFIYA EVENT ═══
      setTimeout(() => {
        if (currentVideo && (window as any).dispatchEvent) {
          try {
            window.dispatchEvent(new CustomEvent('safiya:video-event', {
              detail: { action: 'watch', video: currentVideo }
            }));
          } catch(e) {}
        }
      }, 800);

      // ═══ DESCRIPTION TOGGLE ═══
      const descToggle = document.getElementById('descToggle');
      const descContent = document.getElementById('descContent');
      descToggle?.addEventListener('click', () => {
        if (!descContent) return;
        const expanded = descContent.classList.toggle('expanded');
        descToggle.textContent = expanded ? 'Show less' : 'Show more';
      });

      // ═══ FAKE ONLINE COUNT ═══
      const chatOnlineEl = document.getElementById('chatOnline');
      if (chatOnlineEl) {
        const base = 90 + Math.floor(Math.random() * 250);
        chatOnlineEl.textContent = String(base);
        setInterval(() => {
          chatOnlineEl.textContent = String(Math.max(60, base + Math.floor(Math.random() * 20) - 10));
        }, 4500);
      }

      // ═══ HOOK BANNER: Scroll to More ═══
      const scrollBtn = document.getElementById('scrollToMore');
      const hookBanner = document.getElementById('hookBanner');
      const moreSection = document.getElementById('moreSection');
      function scrollToMore() {
        moreSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      scrollBtn?.addEventListener('click', scrollToMore);
      hookBanner?.addEventListener('click', scrollToMore);

      // ═══ CHAT SYSTEM ═══
      const chatMessages = document.getElementById('chatMessages');
      const chatInput = document.getElementById('chatInput') as HTMLInputElement;
      const chatSend = document.getElementById('chatSend');
      const chatCount = document.getElementById('chatCount');
      const userInitial = document.getElementById('userInitial');
      const CHAT_KEY = `anitube_chat_${videoId}`;
      const USER_KEY = 'anitube_username';

      let username = localStorage.getItem(USER_KEY);
      if (!username) {
        const names = ['SakuraFan','NarutoKid','OtakuHero','AnimeVibes','MangaLover','WeebLife','AnimeVIP','SenpaiChan','KawaiiUser','DemonSlayer','OnePieceFan','JujutsuKid','TokyoOtaku','GhibliLover','AnimeGod'];
        username = names[Math.floor(Math.random() * names.length)] + '_' + Math.floor(Math.random() * 999);
        localStorage.setItem(USER_KEY, username);
      }
      if (userInitial) userInitial.textContent = username.charAt(0).toUpperCase();

      function userColor(name: string): string {
        const colors = [
          'linear-gradient(135deg, #c084fc, #e879f9)',
          'linear-gradient(135deg, #7dd3fc, #22d3ee)',
          'linear-gradient(135deg, #f472b6, #ec4899)',
          'linear-gradient(135deg, #fbbf24, #f97316)',
          'linear-gradient(135deg, #34d399, #10b981)',
          'linear-gradient(135deg, #a78bfa, #8b5cf6)',
          'linear-gradient(135deg, #60a5fa, #3b82f6)',
          'linear-gradient(135deg, #f87171, #ef4444)'
        ];
        let hash = 0;
        for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
        return colors[Math.abs(hash) % colors.length];
      }

      function loadComments(): any[] {
        try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch { return []; }
      }
      function saveComments(list: any[]) {
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(list.slice(-200))); } catch {}
      }

      function renderMessages() {
        if (!chatMessages) return;
        const list = loadComments();
        if (chatCount) chatCount.textContent = `${list.length} msg${list.length !== 1 ? 's' : ''}`;

        if (list.length === 0) {
          chatMessages.innerHTML = `
            <div class="atbrp-chat-empty">
              <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.25;">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
              <p>Be the first to comment! 💬</p>
            </div>`;
          return;
        }

        chatMessages.innerHTML = list.map((m: any) => `
          <div class="atbrp-msg">
            <div class="atbrp-msg-av" style="background:${userColor(m.name)}">${esc(m.name.charAt(0).toUpperCase())}</div>
            <div class="atbrp-msg-body">
              <div class="atbrp-msg-head">
                <span class="atbrp-msg-name">${esc(m.name)}</span>
                <span class="atbrp-msg-time">${timeAgo(m.time)}</span>
              </div>
              <div class="atbrp-msg-text">${esc(m.text)}</div>
            </div>
          </div>
        `).join('');
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      function postMessage() {
        if (!chatInput) return;
        const text = chatInput.value.trim();
        if (!text) return;
        const list = loadComments();
        list.push({ name: username, text, time: Date.now() });
        saveComments(list);
        chatInput.value = '';
        renderMessages();
      }

      chatSend?.addEventListener('click', postMessage);
      chatInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); postMessage(); }
      });
      renderMessages();

      // ═══════════════════════════════════════════════
      // SIDEBAR — Premium Up Next
      // ═══════════════════════════════════════════════
      const sidebarFeed = document.getElementById('relatedFeed');
      const sidebarCount = document.getElementById('sidebarCount');
      let sideItems: any[] = feedData.slice();
      let sideRendered = 0;

      function makeSidebarItem(v: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = v.isAnimeDetail ? `/anime/${v.id}` : `/reels/${v.id}`;
        el.className = 'atbrp-si';
        el.style.animationDelay = ((i % 10) * 40) + 'ms';

        const thumb = getThumb(v.id, v.thumbnail || '');
        const chan = (v.channel || 'anitube').slice(0, 22);

        const imgHtml = thumb
          ? `<img src="${esc(thumb)}" alt="" loading="lazy" onerror="this.style.display='none';" />`
          : `<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:1.6rem;">📺</div>`;

        el.innerHTML = `
          <div class="atbrp-si-thumb">
            ${imgHtml}
            ${v.isNew ? '<div class="atbrp-si-new">NEW</div>' : ''}
            <div class="atbrp-si-play">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="atbrp-si-info">
            <h3 class="atbrp-si-title">${esc(trunc(v.title || 'Video', 80))}</h3>
            <div class="atbrp-si-channel">${esc(chan)}</div>
            <div class="atbrp-si-meta">
              <span>${v.type ? v.type.toUpperCase() : 'VIDEO'}</span>
              <span class="atbrp-si-meta-dot"></span>
              <span>${Math.floor(Math.random() * 500 + 50)}K views</span>
            </div>
          </div>`;
        return el;
      }

      function renderSidebar() {
        if (!sidebarFeed) return;
        const end = Math.min(sideRendered + 12, sideItems.length);
        for (let i = sideRendered; i < end; i++) {
          sidebarFeed.appendChild(makeSidebarItem(sideItems[i], i));
        }
        sideRendered = end;
        if (sidebarCount) sidebarCount.textContent = String(sideRendered);
      }

      renderSidebar();

      // Auto-load more when scrolling sidebar
      sidebarFeed?.parentElement?.addEventListener('scroll', () => {
        if (!sidebarFeed) return;
        const parent = sidebarFeed.parentElement;
        if (!parent) return;
        if (parent.scrollTop + parent.clientHeight > parent.scrollHeight - 200) {
          if (sideRendered < sideItems.length) renderSidebar();
        }
      });

      // ═══════════════════════════════════════════════
      // MORE VIDEOS — Home page style feed
      // ═══════════════════════════════════════════════
      const moreEl = document.getElementById('moreFeed');
      const moreLoadingEl = document.getElementById('moreLoading');
      let moreItems: any[] = feedData.slice();
      let moreRendered = 0;
      let productPool: any[] = [];
      let loadingMore = false;
      let cardsSinceProduct = 0;

      function makeCard(v: any, i: number): HTMLElement {
        const t = v.title || 'Video';
        const img = getThumb(v.id, v.thumbnail || '');
        const delay = ((i % 8) * 50) + 'ms';
        const typeLabel: any = {
          movies: '🎬 MOVIE', kdrama: '🇰🇷 K-DRAMA',
          donghua: '🐼 DONGHUA', anime: '🎌 ANIME'
        }[v.type] || '📺 VIDEO';

        const imgHtml = img
          ? `<img src="${esc(img)}" alt="${esc(t)}" loading="lazy" class="atbrp-card-img" onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))';" />`
          : `<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:2rem;">📺</div>`;

        const el = document.createElement('a');
        el.href = v.isAnimeDetail ? `/anime/${v.id}` : `/reels/${v.id}`;
        el.className = 'atbrp-card';
        el.style.animationDelay = delay;

        el.innerHTML = `
          <div class="atbrp-card-thumb">
            ${imgHtml}
            <div class="atbrp-card-shine"></div>
            <div class="atbrp-card-overlay"></div>
            <div class="atbrp-card-play">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            ${v.isNew ? '<div class="atbrp-card-badge-new">NEW</div>' : ''}
            <div class="atbrp-card-badge-type">${typeLabel}</div>
          </div>
          <div class="atbrp-card-info">
            <h3 class="atbrp-card-title">${esc(trunc(t, 55))}</h3>
            <div class="atbrp-card-channel">${esc(v.channel || 'Channel')}</div>
          </div>`;

        return el;
      }

      function makeProductRow(products: any[]): HTMLElement | null {
        if (!products || products.length === 0) return null;

        const itemsHtml = products.map(p => {
          const img = p.image
            ? `<img src="${esc(p.image)}" alt="${esc(p.title)}" loading="lazy" class="atbrp-product-img" onerror="this.style.display='none';" />`
            : `<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🛍️</div>`;
          return `<a href="/product/${esc(p.id)}" class="atbrp-product-item">
            <div class="atbrp-product-thumb">${img}</div>
            <div class="atbrp-product-name">${esc(trunc(p.title, 40))}</div>
            <div class="atbrp-product-price">${esc(p.price)}</div>
          </a>`;
        }).join('');

        const row = document.createElement('div');
        row.className = 'atbrp-product-row';
        row.innerHTML = `
          <div class="atbrp-product-head">
            <div class="atbrp-product-title">✨ Recommended</div>
            <div class="atbrp-product-hint">← Swipe →</div>
          </div>
          <div class="atbrp-product-scroll">${itemsHtml}</div>`;

        // Drag scroll
        const scroll = row.querySelector('.atbrp-product-scroll') as HTMLElement;
        if (scroll) {
          let isDown = false, startX = 0, scrollLeft = 0;
          scroll.addEventListener('mousedown', (e) => {
            isDown = true; scroll.style.cursor = 'grabbing';
            startX = e.pageX - scroll.offsetLeft; scrollLeft = scroll.scrollLeft;
          });
          scroll.addEventListener('mouseleave', () => { isDown = false; scroll.style.cursor = 'grab'; });
          scroll.addEventListener('mouseup', () => { isDown = false; scroll.style.cursor = 'grab'; });
          scroll.addEventListener('mousemove', (e) => {
            if (!isDown) return; e.preventDefault();
            scroll.scrollLeft = scrollLeft - (e.pageX - scroll.offsetLeft - startX) * 2;
          });
          scroll.addEventListener('wheel', (e) => {
            if (e.deltaY !== 0) { e.preventDefault(); scroll.scrollLeft += e.deltaY; }
          }, { passive: false });
        }
        return row;
      }

      function renderMoreBatch() {
        if (!moreEl) return;
        const batchSize = 8;
        const end = Math.min(moreRendered + batchSize, moreItems.length);
        const cardsPerRow = window.innerWidth <= 768 ? 2 : (window.innerWidth <= 1100 ? 3 : 4);

        for (let i = moreRendered; i < end; i++) {
          moreEl.appendChild(makeCard(moreItems[i], i));
          cardsSinceProduct++;
          if (cardsSinceProduct >= cardsPerRow * 2 && productPool.length > 0) {
            const products = shuffle(productPool).slice(0, 8);
            const row = makeProductRow(products);
            if (row) moreEl.appendChild(row);
            cardsSinceProduct = 0;
          }
        }
        moreRendered = end;
      }

      async function fetchMore() {
        if (loadingMore) return;
        loadingMore = true;
        if (moreLoadingEl) moreLoadingEl.classList.add('show');

        try {
          const types = ['anime', 'donghua', 'kdrama', 'movies'];
          const type = types[Math.floor(Math.random() * types.length)];
          const page = Math.floor(Math.random() * 5) + 1;
          const res = await fetch(`/api/social-feed?type=${type}&page=${page}&limit=15`);
          const data = await res.json();
          if (data.success && data.videos) {
            const existingIds = new Set(moreItems.map((v: any) => v.id));
            existingIds.add(videoId);
            const fresh = data.videos.filter((v: any) => !existingIds.has(v.id));
            moreItems = moreItems.concat(fresh);
            sideItems = sideItems.concat(fresh);
            renderMoreBatch();
            renderSidebar();
          }
        } catch(e) {}

        if (moreLoadingEl) moreLoadingEl.classList.remove('show');
        loadingMore = false;
      }

      async function loadProducts() {
        try {
          const res = await fetch('/api/products?limit=30');
          const data = await res.json();
          if (data.success && data.products) productPool = data.products;
        } catch(e) {}
      }

      loadProducts().then(() => { renderMoreBatch(); });

      // ═══ INFINITE SCROLL (debounced) ═══
      let scrollTimer: any = null;
      window.addEventListener('scroll', () => {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          if (loadingMore) return;
          const bottom = window.scrollY + window.innerHeight;
          const height = document.documentElement.scrollHeight;
          if (bottom > height - 800) {
            if (moreRendered < moreItems.length) renderMoreBatch();
            else fetchMore();
          }
        }, 150);
      }, { passive: true });

      // ═══ AUTOPLAY NEXT (when video ends) ═══
      // Note: Can't detect iframe video end reliably, so this is future-ready.
      const autoplayToggle = document.getElementById('autoplayToggle') as HTMLInputElement;
      if (autoplayToggle) {
        const savedAuto = localStorage.getItem('anitube_autoplay');
        if (savedAuto === 'false') autoplayToggle.checked = false;
        autoplayToggle.addEventListener('change', () => {
          localStorage.setItem('anitube_autoplay', String(autoplayToggle.checked));
        });
      }

    })();
  </script>
</BaseLayout>
