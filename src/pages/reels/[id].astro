---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const videoId = id || '';
---

<BaseLayout>
  <div class="rp-root" data-video-id={videoId}>
    <!-- Blurred BG (thumbnail) -->
    <div class="rp-bg" id="rpBg"></div>
    <div class="rp-bg-overlay"></div>

    <!-- Top Bar -->
    <div class="rp-topbar">
      <button class="rp-btn-icon" id="rpBack" aria-label="Back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="rp-brand">AniTube<span>Buzz</span></div>
      <button class="rp-btn-icon" id="rpMenu" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
      </button>
    </div>

    <!-- Scroll Nav Arrows (desktop) -->
    <div class="rp-nav-arrows">
      <button class="rp-arrow" id="rpArrowUp" aria-label="Previous">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
      <button class="rp-arrow" id="rpArrowDown" aria-label="Next">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>

    <!-- Reels Feed Container -->
    <div class="rp-feed" id="rpFeed">
      <div class="rp-loading" id="rpLoading">
        <div class="rp-spinner"></div>
      </div>
    </div>

    <!-- Toast -->
    <div class="rp-toast" id="rpToast"></div>
  </div>
</BaseLayout>

<style is:global>
  /* Hide site chrome on reels page */
  body:has(.rp-root) {
    overflow: hidden !important;
    background: #000 !important;
  }
  body:has(.rp-root) .ambient-bg,
  body:has(.rp-root) .site-header,
  body:has(.rp-root) header.site-header,
  body:has(.rp-root) footer,
  body:has(.rp-root) .site-footer,
  body:has(.rp-root) #btt,
  body:has(.rp-root) .back-to-top {
    display: none !important;
  }
  body:has(.rp-root) #app {
    background: #000 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>

<style>
  .rp-root {
    position: fixed;
    inset: 0;
    background: #000;
    color: #fff;
    z-index: 9999;
    font-family: 'Inter', 'DM Sans', sans-serif;
    overflow: hidden;
  }

  .rp-bg {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center;
    filter: blur(40px) brightness(0.4);
    transform: scale(1.1);
    transition: background-image 0.5s ease;
    z-index: 1;
  }
  .rp-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .rp-topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    z-index: 100;
    background: linear-gradient(180deg, rgba(0,0,0,0.6), transparent);
  }
  .rp-btn-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }
  .rp-btn-icon:hover {
    background: rgba(192,132,252,0.3);
    border-color: rgba(192,132,252,0.6);
    transform: scale(1.05);
  }
  .rp-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }
  .rp-brand span { color: #fff; -webkit-text-fill-color: #fff; }

  /* Desktop nav arrows */
  .rp-nav-arrows {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 90;
  }
  .rp-arrow {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(30,30,30,0.85);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }
  .rp-arrow:hover {
    background: rgba(192,132,252,0.4);
    transform: scale(1.1);
  }

  /* Feed */
  .rp-feed {
    position: absolute;
    inset: 0;
    z-index: 10;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .rp-feed::-webkit-scrollbar { display: none; }

  .rp-item {
    height: 100vh;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 60px 20px 20px;
    box-sizing: border-box;
  }

  /* Video card (9:16) - center */
  .rp-card {
    position: relative;
    height: min(88vh, calc((100vh - 100px)));
    aspect-ratio: 9 / 16;
    max-width: 92vw;
    background: #0d0520;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.7), 0 0 40px rgba(192,132,252,0.15);
    display: flex;
    align-items: stretch;
  }

  .rp-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }
  .rp-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Bottom overlay inside video */
  .rp-info {
    position: absolute;
    bottom: 0; left: 0; right: 70px;
    padding: 20px 16px 18px;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.85) 60%);
    z-index: 5;
    pointer-events: none;
  }
  .rp-info-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    pointer-events: auto;
  }
  .rp-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg,#c084fc,#e879f9,#7dd3fc);
    padding: 2px;
    flex-shrink: 0;
  }
  .rp-avatar-inner {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: #0d0520;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  .rp-channel {
    font-size: 0.88rem;
    font-weight: 700;
    color: #fff;
  }
  .rp-follow {
    margin-left: 8px;
    padding: 5px 12px;
    background: transparent;
    border: 1.5px solid rgba(255,255,255,0.85);
    color: #fff;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .rp-follow:hover {
    background: rgba(255,255,255,0.15);
  }
  .rp-follow.followed {
    background: linear-gradient(135deg,#c084fc,#e879f9);
    border-color: transparent;
  }
  .rp-caption {
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgba(255,255,255,0.92);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    pointer-events: auto;
  }

  /* Right action bar - attached to video */
  .rp-actions {
    position: absolute;
    right: -60px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    z-index: 6;
  }
  .rp-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }
  .rp-action-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
  }
  .rp-action-btn:hover {
    background: rgba(255,255,255,0.22);
    transform: scale(1.08);
  }
  .rp-action-btn.liked {
    background: rgba(239,68,68,0.25);
    color: #ef4444;
  }
  .rp-action-btn.liked svg { fill: #ef4444; }
  .rp-action-btn.saved {
    background: linear-gradient(135deg,rgba(192,132,252,0.4),rgba(232,121,249,0.4));
    color: #e879f9;
  }
  .rp-action-btn.saved svg { fill: #e879f9; }
  .rp-action-lbl {
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
  }

  /* Loading */
  .rp-loading {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    z-index: 200;
  }
  .rp-spinner {
    width: 40px; height: 40px;
    border: 3px solid rgba(192,132,252,0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: rpSpin 0.8s linear infinite;
  }
  @keyframes rpSpin { to { transform: rotate(360deg); } }

  /* Toast */
  .rp-toast {
    position: fixed;
    bottom: 40px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    padding: 12px 22px;
    background: rgba(20,10,45,0.95);
    border: 1px solid rgba(192,132,252,0.4);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 500;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    pointer-events: none;
  }
  .rp-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .rp-item { padding: 55px 0 0; }
    .rp-card {
      height: 100vh;
      max-width: 100vw;
      width: 100vw;
      aspect-ratio: unset;
      border-radius: 0;
      box-shadow: none;
    }
    .rp-nav-arrows { display: none; }
    .rp-actions {
      right: 8px;
      bottom: 100px;
    }
    .rp-info {
      right: 68px;
      padding: 20px 14px 20px;
    }
    .rp-topbar { padding: 10px 14px; }
  }
  @media (max-width: 480px) {
    .rp-brand { font-size: 0.95rem; }
    .rp-btn-icon { width: 36px; height: 36px; }
  }
</style>

<script is:inline define:vars={{ videoId }}>
(function(){
  var CURRENT_ID = videoId;
  var feedEl = document.getElementById('rpFeed');
  var loadingEl = document.getElementById('rpLoading');
  var bgEl = document.getElementById('rpBg');
  var toastEl = document.getElementById('rpToast');
  var backBtn = document.getElementById('rpBack');
  var arrowUp = document.getElementById('rpArrowUp');
  var arrowDown = document.getElementById('rpArrowDown');

  var videos = [];   // ordered array
  var currentIdx = 0;
  var seenIds = {};

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}

  function showToast(msg){
    if(!toastEl)return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastEl._t);
    toastEl._t = setTimeout(function(){ toastEl.classList.remove('show'); }, 2000);
  }

  // Watch history (localStorage)
  function addToHistory(v){
    try{
      var hist = JSON.parse(localStorage.getItem('atb_watch_history')||'[]');
      hist = hist.filter(function(h){ return h.id !== v.id; });
      hist.unshift({
        id: v.id,
        title: v.title,
        thumbnail: v.thumbnail,
        channel: v.channel,
        type: v.type,
        watchedAt: Date.now()
      });
      hist = hist.slice(0, 50);
      localStorage.setItem('atb_watch_history', JSON.stringify(hist));
    }catch(e){}
  }

  // Get saved videos
  function isSaved(id){
    try{
      var saved = JSON.parse(localStorage.getItem('atb_saved_reels')||'[]');
      return saved.indexOf(id) !== -1;
    }catch(e){return false;}
  }
  function toggleSaved(id){
    try{
      var saved = JSON.parse(localStorage.getItem('atb_saved_reels')||'[]');
      var i = saved.indexOf(id);
      if(i === -1){ saved.push(id); localStorage.setItem('atb_saved_reels', JSON.stringify(saved)); return true; }
      saved.splice(i,1); localStorage.setItem('atb_saved_reels', JSON.stringify(saved)); return false;
    }catch(e){return false;}
  }

  // Get liked
  function isLiked(id){
    try{
      var l = JSON.parse(localStorage.getItem('atb_liked_reels')||'[]');
      return l.indexOf(id) !== -1;
    }catch(e){return false;}
  }
  function toggleLiked(id){
    try{
      var l = JSON.parse(localStorage.getItem('atb_liked_reels')||'[]');
      var i = l.indexOf(id);
      if(i === -1){ l.push(id); localStorage.setItem('atb_liked_reels', JSON.stringify(l)); return true; }
      l.splice(i,1); localStorage.setItem('atb_liked_reels', JSON.stringify(l)); return false;
    }catch(e){return false;}
  }

  // Get followed
  function isFollowed(ch){
    try{
      var f = JSON.parse(localStorage.getItem('atb_followed')||'[]');
      return f.indexOf(ch) !== -1;
    }catch(e){return false;}
  }
  function toggleFollowed(ch){
    try{
      var f = JSON.parse(localStorage.getItem('atb_followed')||'[]');
      var i = f.indexOf(ch);
      if(i === -1){ f.push(ch); localStorage.setItem('atb_followed', JSON.stringify(f)); return true; }
      f.splice(i,1); localStorage.setItem('atb_followed', JSON.stringify(f)); return false;
    }catch(e){return false;}
  }

  function buildEmbedUrl(v){
    var url = v.embedUrl || '';
    if(!url) return '';
    // Modify to hide platform branding + autoplay muted
    if(v.source === 'youtube' || v.source === 'youtube_shorts'){
      var sep = url.indexOf('?') === -1 ? '?' : '&';
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&modestbranding=1&rel=0&playsinline=1';
    } else if(v.source === 'dailymotion'){
      var sep2 = url.indexOf('?') === -1 ? '?' : '&';
      if(url.indexOf('autoplay') === -1) url += sep2 + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0';
    } else {
      var sep3 = url.indexOf('?') === -1 ? '?' : '&';
      if(url.indexOf('autoplay') === -1) url += sep3 + 'autoplay=1&mute=1';
    }
    return url;
  }

  function renderItem(v, idx){
    var el = document.createElement('div');
    el.className = 'rp-item';
    el.dataset.videoId = v.id;
    el.dataset.idx = idx;

    var liked = isLiked(v.id);
    var saved = isSaved(v.id);
    var followed = isFollowed(v.channel || '');

    var initials = (v.channel||'AT').charAt(0).toUpperCase();

    el.innerHTML =
      '<div class="rp-card">' +
        '<div class="rp-video" data-video-container>' +
          // iframe injected on activation
        '</div>' +
        '<div class="rp-info">' +
          '<div class="rp-info-row">' +
            '<div class="rp-avatar"><div class="rp-avatar-inner">' + esc(initials) + '</div></div>' +
            '<div class="rp-channel">' + esc(v.channel || 'Channel') + '</div>' +
            '<button class="rp-follow ' + (followed?'followed':'') + '" data-follow>' + (followed?'Following':'Follow') + '</button>' +
          '</div>' +
          '<div class="rp-caption">' + esc(trunc(v.title||'', 120)) + '</div>' +
        '</div>' +
        '<div class="rp-actions">' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn ' + (liked?'liked':'') + '" data-like aria-label="Like">' +
              '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">' + (liked?'Liked':'Like') + '</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn" data-comment aria-label="Comment">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">Chat</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn" data-share aria-label="Share">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">Share</div>' +
          '</div>' +
          '<div class="rp-action">' +
            '<button class="rp-action-btn ' + (saved?'saved':'') + '" data-save aria-label="Save">' +
              '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
            '</button>' +
            '<div class="rp-action-lbl">' + (saved?'Saved':'Save') + '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    // Bind actions
    el.querySelector('[data-like]').addEventListener('click', function(e){
      e.stopPropagation();
      var nowLiked = toggleLiked(v.id);
      this.classList.toggle('liked', nowLiked);
      var lbl = this.parentElement.querySelector('.rp-action-lbl');
      if(lbl) lbl.textContent = nowLiked ? 'Liked' : 'Like';
      showToast(nowLiked ? '❤️ Liked' : 'Removed');
    });
    el.querySelector('[data-save]').addEventListener('click', function(e){
      e.stopPropagation();
      var nowSaved = toggleSaved(v.id);
      this.classList.toggle('saved', nowSaved);
      var lbl = this.parentElement.querySelector('.rp-action-lbl');
      if(lbl) lbl.textContent = nowSaved ? 'Saved' : 'Save';
      showToast(nowSaved ? '🔖 Saved' : 'Removed');
    });
    el.querySelector('[data-share]').addEventListener('click', function(e){
      e.stopPropagation();
      var url = window.location.origin + '/reels/' + encodeURIComponent(v.id);
      if(navigator.share){
        navigator.share({title: v.title, url: url}).catch(function(){});
      } else {
        try{ navigator.clipboard.writeText(url); showToast('🔗 Link copied'); }catch(_){}
      }
    });
    el.querySelector('[data-comment]').addEventListener('click', function(e){
      e.stopPropagation();
      showToast('💬 Comments coming soon');
    });
    el.querySelector('[data-follow]').addEventListener('click', function(e){
      e.stopPropagation();
      var ch = v.channel || '';
      var nowFollow = toggleFollowed(ch);
      this.classList.toggle('followed', nowFollow);
      this.textContent = nowFollow ? 'Following' : 'Follow';
      showToast(nowFollow ? '✅ Following ' + ch : 'Unfollowed');
    });

    return el;
  }

  function activateItem(idx){
    var items = feedEl.querySelectorAll('.rp-item');
    items.forEach(function(item, i){
      var container = item.querySelector('[data-video-container]');
      if(!container) return;
      if(i === idx){
        // Load iframe if not loaded
        if(!container.querySelector('iframe')){
          var v = videos[i];
          if(v){
            var url = buildEmbedUrl(v);
            if(url){
              var iframe = document.createElement('iframe');
              iframe.src = url;
              iframe.setAttribute('frameborder','0');
              iframe.setAttribute('allow','accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
              iframe.setAttribute('allowfullscreen','');
              container.appendChild(iframe);
            }
          }
        }
        currentIdx = idx;
        // update BG
        var vv = videos[idx];
        if(vv && vv.thumbnail && bgEl){
          bgEl.style.backgroundImage = 'url(' + vv.thumbnail + ')';
        }
        // add to history
        if(vv) addToHistory(vv);
        // notify Safiya
        try{
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: vv }
          }));
        }catch(_){}
      } else {
        // Unload iframes far from current (keep +1/-1)
        if(Math.abs(i - idx) > 1){
          container.innerHTML = '';
        }
      }
    });
  }

  // Fetch: clicked video FIRST, then related shorts
  async function loadFeed(){
    try {
      // 1) Fetch the CLICKED video specifically
      var clickedVideo = null;
      try {
        var r1 = await fetch('/api/social-feed?type=anime&limit=40');
        var d1 = await r1.json();
        if(d1.success && d1.videos){
          clickedVideo = d1.videos.find(function(v){ return v.id === CURRENT_ID; });
        }
      } catch(_){}

      // Try other types if not found
      if(!clickedVideo){
        var types = ['kdrama','donghua','movies'];
        for(var t = 0; t < types.length; t++){
          try {
            var rr = await fetch('/api/social-feed?type=' + types[t] + '&limit=40');
            var dd = await rr.json();
            if(dd.success && dd.videos){
              clickedVideo = dd.videos.find(function(v){ return v.id === CURRENT_ID; });
              if(clickedVideo) break;
            }
          }catch(_){}
        }
      }

      // Fallback: build minimal video from ID (assume YouTube video ID)
      if(!clickedVideo){
        // Try to infer as YouTube
        clickedVideo = {
          id: CURRENT_ID,
          title: 'Video',
          channel: 'Channel',
          thumbnail: 'https://i.ytimg.com/vi/' + CURRENT_ID + '/hqdefault.jpg',
          embedUrl: 'https://www.youtube.com/embed/' + CURRENT_ID,
          source: 'youtube',
          type: 'anime',
          aspect: 'portrait'
        };
      }

      videos = [clickedVideo];
      seenIds[clickedVideo.id] = true;

      // 2) Load related shorts (portrait only)
      try {
        var r2 = await fetch('/api/social-feed?type=anime&format=portrait&limit=30');
        var d2 = await r2.json();
        if(d2.success && d2.videos){
          d2.videos.forEach(function(v){
            if(!seenIds[v.id] && (v.aspect === 'portrait' || v.source === 'youtube_shorts' || v.isShort)){
              videos.push(v);
              seenIds[v.id] = true;
            }
          });
        }
      }catch(_){}

      // Also grab from other types
      try {
        var r3 = await fetch('/api/social-feed?type=donghua&format=portrait&limit=20');
        var d3 = await r3.json();
        if(d3.success && d3.videos){
          d3.videos.forEach(function(v){
            if(!seenIds[v.id]){
              videos.push(v);
              seenIds[v.id] = true;
            }
          });
        }
      }catch(_){}

      // Render all items
      feedEl.innerHTML = '';
      videos.forEach(function(v, i){
        feedEl.appendChild(renderItem(v, i));
      });

      // Hide loading
      if(loadingEl) loadingEl.style.display = 'none';

      // Activate first item
      setTimeout(function(){ activateItem(0); }, 100);

    } catch(err){
      console.error('[reels]', err);
      if(loadingEl){
        loadingEl.innerHTML = '<div style="text-align:center;color:#fff;padding:20px;"><div style="font-size:2rem;margin-bottom:10px;">😔</div><div>Failed to load video</div><button onclick="history.back()" style="margin-top:20px;padding:10px 20px;background:rgba(192,132,252,0.3);border:1px solid rgba(192,132,252,0.6);color:#fff;border-radius:8px;cursor:pointer;">Go Back</button></div>';
      }
    }
  }

  // Scroll detection - activate visible item
  var scrollTimer;
  feedEl.addEventListener('scroll', function(){
    if(scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function(){
      var scrollTop = feedEl.scrollTop;
      var idx = Math.round(scrollTop / window.innerHeight);
      if(idx !== currentIdx){
        activateItem(idx);
      }
    }, 100);
  }, { passive: true });

  // Nav arrows
  function scrollToIdx(idx){
    if(idx < 0 || idx >= videos.length) return;
    feedEl.scrollTo({ top: idx * window.innerHeight, behavior: 'smooth' });
  }
  if(arrowUp) arrowUp.addEventListener('click', function(){ scrollToIdx(currentIdx - 1); });
  if(arrowDown) arrowDown.addEventListener('click', function(){ scrollToIdx(currentIdx + 1); });

  // Keyboard
  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowDown' || e.key === 'j'){ e.preventDefault(); scrollToIdx(currentIdx + 1); }
    else if(e.key === 'ArrowUp' || e.key === 'k'){ e.preventDefault(); scrollToIdx(currentIdx - 1); }
    else if(e.key === 'Escape'){ goBack(); }
  });

  // Back button - preserves home scroll
  function goBack(){
    // history.back() will return to home at previous scroll position
    if(document.referrer && document.referrer.indexOf(window.location.origin) === 0){
      history.back();
    } else {
      window.location.href = '/';
    }
  }
  if(backBtn) backBtn.addEventListener('click', goBack);

  loadFeed();
})();
</script>
