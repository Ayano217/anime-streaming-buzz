---
export const prerender = false;

import ImmersiveLayout from '../../layouts/ImmersiveLayout.astro';

const { id } = Astro.params;
const videoId = id || '';

// Platform detection from ID prefix
function getPlatformData(vid: string) {
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return {
      source: 'youtube_shorts',
      embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1&autoplay=1`,
      aspect: 'portrait',
      isShort: true
    };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return {
      source: 'youtube',
      embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1&autoplay=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return {
      source: 'dailymotion',
      embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0`,
      aspect: 'mixed',
      isShort: false
    };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return {
      source: 'bilibili',
      embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1&high_quality=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('ody_')) {
    const rawId = vid.replace('ody_', '');
    return {
      source: 'odysee',
      embedUrl: `https://odysee.com/$/embed/${rawId}?autoplay=1`,
      aspect: 'landscape',
      isShort: false
    };
  }
  if (vid.startsWith('rmb_')) {
    const rawId = vid.replace('rmb_', '');
    return {
      source: 'rumble',
      embedUrl: `https://rumble.com/embed/${rawId}/?autoplay=2`,
      aspect: 'landscape',
      isShort: false
    };
  }
  return null;
}

// Fetch all videos from API
let video: any = null;
let allVideos: any[] = [];
let relatedVideos: any[] = [];

try {
  const apiUrl = new URL('/api/social-feed', Astro.url.origin);
  apiUrl.searchParams.set('limit', '100');
  apiUrl.searchParams.set('format', 'all');
  
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    allVideos = data.videos || [];
    video = allVideos.find((v: any) => v.id === videoId);
  }
} catch (e) {
  console.error('API fetch failed:', e);
}

// Fallback: build video from ID if not found in API
if (!video) {
  const platformData = getPlatformData(videoId);
  if (platformData) {
    video = {
      id: videoId,
      title: 'Anime Content',
      channel: 'AniTube Channel',
      thumbnail: '',
      embedUrl: platformData.embedUrl,
      source: platformData.source,
      aspect: platformData.aspect,
      isShort: platformData.isShort,
      type: 'anime'
    };
  } else {
    video = {
      id: videoId,
      title: 'Anime Video',
      channel: 'AniTubeBuzz',
      thumbnail: '',
      embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0&autoplay=1`,
      source: 'youtube',
      aspect: 'landscape',
      isShort: false,
      type: 'anime'
    };
  }
}

// 🧠 INSTAGRAM-STYLE ALGORITHM: Smart Related Videos
// Priority: 1) Same channel, 2) Same type, 3) Recent trending
function buildRelatedFeed(current: any, all: any[]): any[] {
  if (!all || all.length === 0) return [];
  
  // Remove current video from pool
  const pool = all.filter(v => v.id !== current.id);
  
  // Score each video by similarity
  const scored = pool.map(v => {
    let score = 0;
    
    // Same channel = huge boost
    if (v.channel === current.channel) score += 100;
    
    // Same content type (anime/kdrama/donghua/movies)
    if (v.type === current.type) score += 50;
    
    // Same platform source
    if (v.source === current.source) score += 20;
    
    // Same aspect ratio (portrait/landscape) = better UX
    if (v.aspect === current.aspect) score += 30;
    
    // Recent = fresh
    if (v.isNew) score += 15;
    
    // Official content boost
    if (v.isOfficial) score += 10;
    
    // Randomness to avoid same order always
    score += Math.random() * 5;
    
    return { video: v, score };
  });
  
  // Sort by score descending
  scored.sort((a, b) => b.score - a.score);
  
  // Return video array with current at position 0
  return [current, ...scored.map(s => s.video)];
}

const feedQueue = buildRelatedFeed(video, allVideos);
const currentIndex = 1;
const totalCount = feedQueue.length;

// Next/Prev from smart-sorted queue
const nextVideo = feedQueue[1] || null;
const prevVideo = null; // First position, no prev in queue

// Clean channel name for @handle
const channelHandle = (video.channel || 'anitube').replace(/\s+/g, '').toLowerCase().slice(0, 20);
---

<ImmersiveLayout title={`${video.title} | AniTubeBuzz`}>
  <div 
    id="reels-root" 
    class="rp-root" 
    data-videoid={videoId}
    data-next={nextVideo?.id || ''}
  >
    
    <!-- Top Navigation Bar -->
    <header class="rp-topbar">
      <button class="rp-back" id="backBtn" aria-label="Go back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <div class="rp-brand">
        <span class="rp-brand-text">AniTubeBuzz</span>
        <div class="rp-brand-dot"></div>
      </div>
      
      <div class="rp-counter">
        <span class="rp-counter-current">{currentIndex}</span>
        <span class="rp-counter-sep">/</span>
        <span class="rp-counter-total">{totalCount}</span>
      </div>
    </header>

    <!-- Main Video Stage -->
    <main class="rp-stage">
      
      <!-- Video Card -->
      <div class="rp-card" id="videoCard">
        <div class="rp-card-glow"></div>
        <div class="rp-card-glow-2"></div>
        <div class="rp-card-frame">
          <iframe 
            id="videoFrame"
            src={video.embedUrl}
            title={video.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="eager"
          ></iframe>
          
          <div class="rp-loader" id="loader">
            <div class="rp-spinner"></div>
          </div>
        </div>
      </div>

      <!-- Info Panel (Bottom Left - Instagram Style) -->
      <div class="rp-info">
        <div class="rp-channel-row">
          <div class="rp-avatar">
            {(video.channel || 'A').charAt(0).toUpperCase()}
          </div>
          <span class="rp-channel-name">@{channelHandle}</span>
        </div>
        <h1 class="rp-title">{video.title}</h1>
        <p class="rp-meta">
          <span class="rp-badge">HD</span>
          <span class="rp-dot">•</span>
          <span>{video.type === 'kdrama' ? 'K-Drama' : video.type === 'donghua' ? 'Donghua' : video.type === 'movies' ? 'Movie' : 'Anime'}</span>
        </p>
      </div>

      <!-- Action Panel (Right Side - Premium) -->
      <div class="rp-actions">
        <button class="rp-action rp-like" id="likeBtn" aria-label="Like">
          <div class="rp-action-btn">
            <svg class="rp-icon rp-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <span class="rp-action-label">Like</span>
        </button>
        
        <button class="rp-action rp-send" id="sendBtn" aria-label="Share">
          <div class="rp-action-btn">
            <svg class="rp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </div>
          <span class="rp-action-label">Send</span>
        </button>
      </div>

      <!-- Desktop Nav Arrows -->
      <div class="rp-nav">
        <button class="rp-arrow" id="prevBtn" aria-label="Previous video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6"/>
          </svg>
        </button>
        <button class="rp-arrow" id="nextBtn" aria-label="Next video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>

    </main>

    <!-- Hidden data for JS -->
    <script is:inline set:html={`window.__REELS_QUEUE__ = ${JSON.stringify(feedQueue.slice(0, 30))};`}></script>

  </div>

  <style>
    /* ===== ROOT CONTAINER ===== */
    .rp-root {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: 
        radial-gradient(circle at 20% 30%, rgba(192, 132, 252, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(125, 211, 252, 0.1) 0%, transparent 50%),
        linear-gradient(180deg, #0a0517 0%, #1a0f2e 50%, #0a0517 100%);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      user-select: none;
      -webkit-user-select: none;
      z-index: 1;
    }

    /* ===== TOP BAR ===== */
    .rp-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(10, 5, 23, 0.95) 0%, rgba(10, 5, 23, 0.5) 60%, transparent 100%);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .rp-back {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f5ecff;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(10px);
    }

    .rp-back:hover {
      background: rgba(192, 132, 252, 0.15);
      border-color: rgba(192, 132, 252, 0.4);
      transform: scale(1.05);
    }

    .rp-back:active {
      transform: scale(0.95);
    }

    .rp-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .rp-brand-text {
      font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 17px;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .rp-brand-dot {
      width: 6px;
      height: 6px;
      background: #7dd3fc;
      border-radius: 50%;
      box-shadow: 0 0 8px #7dd3fc;
      animation: rp-pulse 2s infinite;
    }

    @keyframes rp-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .rp-counter {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 7px 14px;
      border-radius: 20px;
      backdrop-filter: blur(10px);
      letter-spacing: 0.05em;
    }

    .rp-counter-current {
      background: linear-gradient(135deg, #e879f9, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-weight: 700;
    }

    .rp-counter-sep {
      margin: 0 6px;
      opacity: 0.4;
    }

    /* ===== VIDEO STAGE ===== */
    .rp-stage {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 80px 20px;
      z-index: 1;
    }

    /* ===== VIDEO CARD (9:16 Premium) ===== */
    .rp-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      aspect-ratio: 9 / 16;
      max-height: calc(100vh - 140px);
      max-height: calc(100dvh - 140px);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
    }

    /* Outer glow layer */
    .rp-card-glow {
      position: absolute;
      inset: -4px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      border-radius: 26px;
      opacity: 0.7;
      filter: blur(12px);
      z-index: -2;
      animation: rp-glow 4s ease-in-out infinite;
    }

    /* Inner sharper glow */
    .rp-card-glow-2 {
      position: absolute;
      inset: -1px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      border-radius: 22px;
      opacity: 0.9;
      z-index: -1;
    }

    @keyframes rp-glow {
      0%, 100% { opacity: 0.5; filter: blur(12px); }
      50% { opacity: 0.85; filter: blur(18px); }
    }

    .rp-card-frame {
      position: absolute;
      inset: 0;
      background: #000;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .rp-card-frame iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    /* Loader */
    .rp-loader {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      z-index: 5;
      transition: opacity 0.4s;
    }

    .rp-loader.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .rp-spinner {
      width: 44px;
      height: 44px;
      border: 3px solid rgba(192, 132, 252, 0.2);
      border-top-color: #e879f9;
      border-right-color: #c084fc;
      border-radius: 50%;
      animation: rp-spin 0.9s linear infinite;
    }

    @keyframes rp-spin {
      to { transform: rotate(360deg); }
    }

    /* ===== INFO PANEL (Bottom Left) ===== */
    .rp-info {
      position: absolute;
      bottom: 32px;
      left: 32px;
      z-index: 50;
      max-width: 320px;
      pointer-events: none;
    }

    .rp-channel-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .rp-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: white;
      border: 2px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 4px 12px rgba(192, 132, 252, 0.4);
    }

    .rp-channel-name {
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 15px;
      color: white;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
      letter-spacing: -0.01em;
    }

    .rp-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 17px;
      font-weight: 700;
      color: white;
      line-height: 1.35;
      margin: 0 0 8px 0;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.95);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      letter-spacing: -0.01em;
    }

    .rp-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.85);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
      margin: 0;
    }

    .rp-badge {
      background: linear-gradient(135deg, #c084fc, #e879f9);
      color: white;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 0.05em;
      text-shadow: none;
    }

    .rp-dot {
      opacity: 0.4;
    }

    /* ===== ACTION PANEL (Right - PREMIUM) ===== */
    .rp-actions {
      position: absolute;
      right: 32px;
      bottom: 40px;
      display: flex;
      flex-direction: column;
      gap: 22px;
      z-index: 50;
    }

    .rp-action {
      background: transparent;
      border: none;
      padding: 0;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      transition: transform 0.2s;
    }

    .rp-action-btn {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: 
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 
        0 8px 24px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
      position: relative;
      overflow: hidden;
    }

    /* Shine overlay */
    .rp-action-btn::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        45deg,
        transparent 40%,
        rgba(255, 255, 255, 0.15) 50%,
        transparent 60%
      );
      transform: rotate(-45deg) translateY(100%);
      transition: transform 0.6s;
    }

    .rp-action:hover .rp-action-btn {
      background: 
        linear-gradient(135deg, rgba(192, 132, 252, 0.25), rgba(232, 121, 249, 0.1));
      border-color: rgba(192, 132, 252, 0.5);
      transform: scale(1.08) translateY(-2px);
      box-shadow: 
        0 12px 30px rgba(192, 132, 252, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

    .rp-action:hover .rp-action-btn::before {
      transform: rotate(-45deg) translateY(-100%);
    }

    .rp-action:active .rp-action-btn {
      transform: scale(0.92);
    }

    .rp-icon {
      width: 24px;
      height: 24px;
      transition: all 0.3s;
    }

    /* Liked state - gorgeous red gradient */
    .rp-like.liked .rp-action-btn {
      background: linear-gradient(135deg, #ff2d55, #ff375f);
      border-color: rgba(255, 45, 85, 0.6);
      box-shadow: 
        0 8px 24px rgba(255, 45, 85, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }

    .rp-like.liked .rp-heart {
      fill: currentColor;
      animation: rp-heart-pop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes rp-heart-pop {
      0% { transform: scale(1); }
      50% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }

    .rp-action-label {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 600;
      color: white;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
      letter-spacing: 0.02em;
    }

    /* ===== DESKTOP NAV ARROWS ===== */
    .rp-nav {
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      display: none;
      flex-direction: column;
      gap: 14px;
      z-index: 50;
    }

    .rp-arrow {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    .rp-arrow:hover {
      background: linear-gradient(135deg, rgba(192, 132, 252, 0.3), rgba(232, 121, 249, 0.1));
      border-color: rgba(192, 132, 252, 0.5);
      transform: scale(1.1);
      box-shadow: 0 10px 24px rgba(192, 132, 252, 0.3);
    }

    .rp-arrow:active {
      transform: scale(0.95);
    }

    .rp-arrow svg {
      width: 22px;
      height: 22px;
    }

    /* ===== DESKTOP (≥1024px) ===== */
    @media (min-width: 1024px) {
      .rp-nav {
        display: flex;
        right: 40px;
      }
      .rp-actions {
        right: 120px;
        bottom: 50px;
      }
      .rp-info {
        left: 40px;
        bottom: 50px;
      }
    }

    /* ===== MOBILE (≤640px) ===== */
    @media (max-width: 640px) {
      .rp-stage {
        padding: 0;
      }
      
      .rp-card {
        max-width: 100%;
        max-height: 100%;
        width: 100%;
        height: 100%;
        aspect-ratio: auto;
      }
      
      .rp-card-glow,
      .rp-card-glow-2 {
        display: none;
      }
      
      .rp-card-frame {
        border-radius: 0;
      }
      
      .rp-topbar {
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.85) 0%, transparent 100%);
      }
      
      .rp-info {
        left: 16px;
        bottom: 90px;
        max-width: calc(100% - 100px);
      }
      
      .rp-actions {
        right: 12px;
        bottom: 90px;
        gap: 18px;
      }
      
      .rp-action-btn {
        width: 48px;
        height: 48px;
      }
      
      .rp-icon {
        width: 22px;
        height: 22px;
      }
      
      .rp-title {
        font-size: 15px;
      }
    }

    /* ===== TABLET ===== */
    @media (min-width: 641px) and (max-width: 1023px) {
      .rp-info {
        left: 24px;
        bottom: 40px;
      }
      .rp-actions {
        right: 24px;
        bottom: 40px;
      }
    }
  </style>

  <script>
    (function() {
      const root = document.getElementById('reels-root') as HTMLElement;
      if (!root) return;
      
      const videoId = root.dataset.videoid || '';
      const nextId = root.dataset.next || '';
      
      // ===== LIKE FUNCTIONALITY =====
      const likeBtn = document.getElementById('likeBtn');
      const likedVideos: string[] = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      
      if (likedVideos.includes(videoId) && likeBtn) {
        likeBtn.classList.add('liked');
      }
      
      likeBtn?.addEventListener('click', () => {
        const idx = likedVideos.indexOf(videoId);
        if (idx > -1) {
          likedVideos.splice(idx, 1);
          likeBtn.classList.remove('liked');
        } else {
          likedVideos.push(videoId);
          likeBtn.classList.add('liked');
        }
        localStorage.setItem('anitube_liked', JSON.stringify(likedVideos));
      });
      
      // ===== SEND / SHARE =====
      const sendBtn = document.getElementById('sendBtn');
      sendBtn?.addEventListener('click', async () => {
        const shareData = {
          title: document.querySelector('.rp-title')?.textContent || 'AniTube Video',
          text: 'Check out this on AniTubeBuzz!',
          url: window.location.href
        };
        
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        
        if (isMobile && (navigator as any).share) {
          try {
            await (navigator as any).share(shareData);
          } catch (err) {
            /* user cancelled */
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const label = sendBtn.querySelector('.rp-action-label');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => { label.textContent = orig; }, 1800);
            }
          } catch {
            prompt('Copy this link:', window.location.href);
          }
        }
      });
      
      // ===== SMART BACK BUTTON (history-aware) =====
      const backBtn = document.getElementById('backBtn');
      backBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        // Track how we got here
        const referrer = document.referrer;
        const sameOrigin = referrer && referrer.startsWith(window.location.origin);
        
        if (window.history.length > 1 && sameOrigin) {
          window.history.back();
        } else {
          window.location.href = '/';
        }
      });
      
      // ===== NAVIGATION (Instagram-style smart algorithm) =====
      const queue: any[] = (window as any).__REELS_QUEUE__ || [];
      let currentQueuePos = 0;
      
      function navigate(direction: 'next' | 'prev') {
        let targetId = '';
        
        if (direction === 'next') {
          // Use smart queue if available
          if (queue.length > 1) {
            const nextPos = currentQueuePos + 1;
            if (nextPos < queue.length) {
              targetId = queue[nextPos].id;
            }
          } else if (nextId) {
            targetId = nextId;
          }
        } else {
          // Back button uses history
          if (window.history.length > 1) {
            window.history.back();
            return;
          }
        }
        
        if (targetId) {
          const card = document.getElementById('videoCard');
          if (card) {
            card.style.opacity = '0';
            card.style.transform = `translateY(${direction === 'next' ? '-30px' : '30px'}) scale(0.95)`;
          }
          setTimeout(() => {
            window.location.href = `/reels/${targetId}`;
          }, 220);
        }
      }
      
      document.getElementById('nextBtn')?.addEventListener('click', () => navigate('next'));
      document.getElementById('prevBtn')?.addEventListener('click', () => navigate('prev'));
      
      // ===== KEYBOARD =====
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'j' || e.key === 'J') {
          e.preventDefault();
          navigate('next');
        } else if (e.key === 'ArrowUp' || e.key === 'k' || e.key === 'K') {
          e.preventDefault();
          navigate('prev');
        } else if (e.key === 'Escape') {
          window.history.length > 1 ? window.history.back() : window.location.href = '/';
        }
      });
      
      // ===== WHEEL SCROLL (debounced) =====
      let wheelLocked = false;
      document.addEventListener('wheel', (e) => {
        if (wheelLocked) return;
        if (Math.abs(e.deltaY) < 30) return;
        
        wheelLocked = true;
        if (e.deltaY > 0) navigate('next');
        else navigate('prev');
        
        setTimeout(() => { wheelLocked = false; }, 800);
      }, { passive: true });
      
      // ===== TOUCH SWIPE =====
      let touchStartY = 0;
      let touchStartTime = 0;
      
      document.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      }, { passive: true });
      
      document.addEventListener('touchend', (e) => {
        const touchEndY = e.changedTouches[0].clientY;
        const diff = touchStartY - touchEndY;
        const timeDiff = Date.now() - touchStartTime;
        
        // Fast swipe or long swipe
        if (Math.abs(diff) > 80 && timeDiff < 600) {
          if (diff > 0) navigate('next');
          else navigate('prev');
        }
      }, { passive: true });
      
      // ===== HIDE LOADER =====
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const loader = document.getElementById('loader');
      
      iframe?.addEventListener('load', () => {
        setTimeout(() => loader?.classList.add('hidden'), 300);
      });
      
      // Fallback: hide loader after 3s no matter what
      setTimeout(() => loader?.classList.add('hidden'), 3000);
      
      // ===== SAFIYA INTEGRATION =====
      setTimeout(() => {
        const currentVideo = queue[0];
        if (currentVideo) {
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: currentVideo }
          }));
        }
      }, 500);
      
    })();
  </script>
</ImmersiveLayout>
