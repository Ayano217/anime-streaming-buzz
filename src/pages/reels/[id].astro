---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Watch" description="Premium video experience">
  <div class="reels-page">
    
    <!-- Minimal top bar -->
    <div class="reels-top">
      <button class="reels-back" id="reelsBack" aria-label="Back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="reels-brand">
        <span class="grad-text">Ani</span><span style="color:#fff">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <button class="reels-menu" id="reelsMenu" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
        <div class="reels-menu-drop" id="reelsMenuDrop">
          <button class="reels-menu-item" data-action="save">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            <span>Save</span>
          </button>
          <button class="reels-menu-item" data-action="copy">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>Copy Link</span>
          </button>
        </div>
      </button>
    </div>
    
    <!-- Loading -->
    <div id="reelsLoader" class="reels-loader">
      <div class="reels-spinner"></div>
      <p>Loading premium experience...</p>
    </div>
    
    <!-- ═══ VERTICAL SCROLL CONTAINER (TikTok exact) ═══ -->
    <div id="reelsScroller" class="reels-scroller" style="display:none;">
      <!-- Slots get injected dynamically -->
    </div>
    
    <!-- Progress indicator -->
    <div class="reels-progress" id="reelsProgress" style="display:none;">
      <div class="reels-progress-dot"></div>
      <div class="reels-progress-dot"></div>
      <div class="reels-progress-dot"></div>
    </div>
    
    <!-- Toast for save/copy actions -->
    <div id="reelsToast" class="reels-toast"></div>
    
  </div>
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('reelsLoader');
  var scroller = document.getElementById('reelsScroller');
  var progress = document.getElementById('reelsProgress');
  var back = document.getElementById('reelsBack');
  var menu = document.getElementById('reelsMenu');
  var menuDrop = document.getElementById('reelsMenuDrop');
  var toast = document.getElementById('reelsToast');
  
  var allVideos = [];
  var currentIdx = 0;
  var isTransitioning = false;
  
  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}
  
  // Back
  back.addEventListener('click', function() {
    if (window.history.length > 1) window.history.back();
    else window.location.href = '/';
  });
  
  // Menu toggle
  menu.addEventListener('click', function(e) {
    e.stopPropagation();
    menuDrop.classList.toggle('open');
  });
  document.addEventListener('click', function(e) {
    if (!menu.contains(e.target)) menuDrop.classList.remove('open');
  });
  
  // Menu actions
  menuDrop.addEventListener('click', function(e) {
    var btn = e.target.closest('.reels-menu-item');
    if (!btn) return;
    var action = btn.dataset.action;
    var v = allVideos[currentIdx];
    if (!v) return;
    
    if (action === 'save') {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      var exists = saved.findIndex(function(x) { return x.id === v.id; });
      if (exists >= 0) {
        saved.splice(exists, 1);
        showToast('❌ Removed from saved');
      } else {
        saved.push({ id: v.id, title: v.title, thumbnail: v.thumbnail, savedAt: Date.now() });
        showToast('✓ Saved to your library');
        notifySafiya('save', v);
      }
      localStorage.setItem('savedVideos', JSON.stringify(saved));
    } else if (action === 'copy') {
      navigator.clipboard.writeText(window.location.href);
      showToast('✓ Link copied');
    }
    menuDrop.classList.remove('open');
  });
  
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(function() { toast.classList.remove('show'); }, 2500);
  }
  
  // ═══ SAFIYA INTEGRATION ═══
  // Trigger main Safiya (right-side) to comment on video
  function notifySafiya(type, video) {
    try {
      // Track in Safiya's memory
      var memory = JSON.parse(localStorage.getItem('safiya_memory') || '{}');
      if (!memory.watchHistory) memory.watchHistory = [];
      memory.watchHistory.unshift({
        title: video.title,
        type: video.type,
        source: video.source,
        watchedAt: Date.now(),
        action: type,
      });
      memory.watchHistory = memory.watchHistory.slice(0, 50);
      memory.lastVideo = { title: video.title, type: video.type, timestamp: Date.now() };
      memory.currentlyWatching = video.title;
      localStorage.setItem('safiya_memory', JSON.stringify(memory));
      
      // Dispatch custom event that SafiyaCore listens to
      var event = new CustomEvent('safiya:video-event', {
        detail: {
          action: type,
          video: video,
          currentTitle: video.title,
          currentType: video.type,
        }
      });
      window.dispatchEvent(event);
      
      // Also try calling Safiya's public API if available
      if (window.Safiya && typeof window.Safiya.reactToVideo === 'function') {
        window.Safiya.reactToVideo(video, type);
      } else if (window.Safiya && typeof window.Safiya.say === 'function') {
        var reactions = {
          watch: {
            movies: ["Movie night with you? Say less 🍿", "Bestie you have good taste", "The vibes are immaculate"],
            kdrama: ["K-drama time??? I'm SO here for this 💖", "The chemistry better be crazy", "Second lead syndrome incoming"],
            donghua: ["Ohh donghua? These slap different fr", "The art style is unreal", "Cultivation anime hits"],
            anime: ["Not you having elite taste 👀", "Bestie I'm invested", "The animation tho"],
          },
          save: ["Saving for later? Smart move 💜", "Adding to your collection 📚", "Nice pick bestie"],
        };
        var msgList = type === 'save' ? reactions.save : (reactions.watch[video.type] || reactions.watch.anime);
        var msg = msgList[Math.floor(Math.random() * msgList.length)];
        setTimeout(function() { window.Safiya.say(msg); }, 500);
      }
    } catch(e) {
      console.warn('Safiya notify failed:', e);
    }
  }
  
  // ═══ BUILD REEL SLOT ═══
  function buildSlot(video, idx) {
    var slot = document.createElement('div');
    slot.className = 'reels-slot';
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;
    
    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="reels-slot-poster" loading="lazy" />' : '';
    
    slot.innerHTML = 
      // Poster (shown before video loads)
      thumb +
      // Video container (populated when active)
      '<div class="reels-slot-video" data-idx="' + idx + '"></div>' +
      // Gradient overlay
      '<div class="reels-slot-gradient"></div>' +
      // Bottom info
      '<div class="reels-slot-info">' +
        '<div class="reels-slot-user">' +
          '<div class="reels-slot-avatar"><div class="reels-slot-avatar-inner">▶</div></div>' +
          '<div class="reels-slot-user-name">' + esc(video.channel || 'Channel') + '</div>' +
          '<button class="reels-slot-follow">Follow</button>' +
        '</div>' +
        '<div class="reels-slot-caption">' + esc(video.title || 'Video') + '</div>' +
      '</div>';
    
    return slot;
  }
  
  // ═══ LOAD VIDEO INTO SLOT ═══
  function loadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.reels-slot-video');
    if (videoDiv.dataset.loaded === '1') return;
    videoDiv.dataset.loaded = '1';
    
    var video = allVideos[idx];
    if (!video) return;
    
    var embedUrl = video.embedUrl;
    if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0&queue-enable=0';
    }
    if (video.source === 'youtube') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0';
    }
    
    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    videoDiv.appendChild(iframe);
    
    // Hide poster after brief delay
    setTimeout(function() {
      var poster = slot.querySelector('.reels-slot-poster');
      if (poster) poster.style.opacity = '0';
    }, 800);
  }
  
  // ═══ UNLOAD VIDEO (save memory) ═══
  function unloadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.reels-slot-video');
    if (videoDiv.dataset.loaded !== '1') return;
    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    var poster = slot.querySelector('.reels-slot-poster');
    if (poster) poster.style.opacity = '1';
  }
  
  // ═══ UPDATE CURRENT VIDEO ═══
  function setCurrentIdx(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length) return;
    if (newIdx === currentIdx) return;
    
    var oldIdx = currentIdx;
    currentIdx = newIdx;
    
    // Update URL
    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' - AniTube Buzz';
      }
    } catch(e) {}
    
    // Unload far videos, load nearby (window of 3: prev, current, next)
    allVideos.forEach(function(_, i) {
      if (Math.abs(i - newIdx) <= 1) {
        loadVideoInSlot(i);
      } else if (Math.abs(i - oldIdx) <= 1 && Math.abs(i - newIdx) > 1) {
        unloadVideoInSlot(i);
      }
    });
    
    // Notify Safiya
    var video = allVideos[newIdx];
    if (video) {
      setTimeout(function() { notifySafiya('watch', video); }, 2500);
    }
    
    // Update progress
    updateProgress();
  }
  
  function updateProgress() {
    if (!progress) return;
    var dots = progress.querySelectorAll('.reels-progress-dot');
    dots.forEach(function(d, i) {
      d.classList.remove('active');
      if (i === 1) d.classList.add('active'); // Middle dot always active (current)
    });
  }
  
  // ═══ SCROLL DETECTION (Intersection Observer for smooth) ═══
  var slotObserver = null;
  function setupObserver() {
    if (slotObserver) slotObserver.disconnect();
    
    slotObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.intersectionRatio >= 0.7) {
          var idx = parseInt(entry.target.dataset.idx);
          if (!isNaN(idx) && idx !== currentIdx) {
            setCurrentIdx(idx);
          }
        }
      });
    }, { 
      root: scroller,
      threshold: [0.5, 0.7, 0.9]
    });
    
    scroller.querySelectorAll('.reels-slot').forEach(function(slot) {
      slotObserver.observe(slot);
    });
  }
  
  // ═══ KEYBOARD NAV ═══
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      scrollToSlot(currentIdx + 1);
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      scrollToSlot(currentIdx - 1);
    } else if (e.key === 'Escape') {
      window.history.back();
    }
  });
  
  function scrollToSlot(idx) {
    if (idx < 0 || idx >= allVideos.length || isTransitioning) return;
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    isTransitioning = true;
    slot.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(function() { isTransitioning = false; }, 600);
  }
  
  // ═══ INIT ═══
  async function init() {
    try {
      var fetched = [];
      var found = null;
      
      for (var i = 1; i <= 3; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) {
              found = data.videos.find(function(v) { return v.id === id; });
            }
          }
        } catch(e) {}
      }
      
      if (!found && fetched.length > 0) found = fetched[0];
      
      if (!found) {
        loader.innerHTML = '<h1 style="color:#fff;margin-bottom:1rem;font-family:\'Bricolage Grotesque\',sans-serif;">Video Not Available</h1><a href="/" style="color:#c084fc;font-weight:700;text-decoration:none;padding:12px 24px;border:1px solid #c084fc;border-radius:999px;">← Back to Home</a>';
        return;
      }
      
      // Dedupe
      var seen = {};
      allVideos = fetched.filter(function(v) {
        if (seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });
      
      // Move found video to first
      var foundIdx = allVideos.findIndex(function(v) { return v.id === found.id; });
      if (foundIdx > 0) {
        var [first] = allVideos.splice(foundIdx, 1);
        allVideos.unshift(first);
      } else if (foundIdx < 0) {
        allVideos.unshift(found);
      }
      
      // Build all slots
      scroller.innerHTML = '';
      allVideos.forEach(function(v, i) {
        scroller.appendChild(buildSlot(v, i));
      });
      
      loader.style.display = 'none';
      scroller.style.display = 'block';
      progress.style.display = 'flex';
      
      // Setup observer & load first video
      setupObserver();
      currentIdx = -1; // Force update
      setCurrentIdx(0);
      updateProgress();
      
    } catch(e) {
      console.error(e);
      loader.innerHTML = '<h1 style="color:#fff;">Error loading</h1>';
    }
  }
  
  init();
})();
</script>

<style>
  /* ═══ FULL BLACK BACKGROUND ═══ */
  html, body { background: #000 !important; overflow: hidden; }
  #app { background: #000 !important; }
  main { background: #000 !important; padding: 0 !important; }
  
  .reels-page {
    height: 100vh;
    background: #000;
    color: #fff;
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    z-index: 500;
  }
  
  /* Top bar */
  .reels-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent);
    z-index: 100;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }
  
  .reels-back, .reels-menu {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    position: relative;
  }
  
  .reels-back:hover, .reels-menu:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: scale(1.05);
  }
  
  .reels-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }
  
  /* Menu dropdown */
  .reels-menu-drop {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: rgba(20, 10, 30, 0.98);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 14px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(192, 132, 252, 0.2);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 200;
  }
  
  .reels-menu-drop.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .reels-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    background: transparent;
    border: none;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;
    text-align: left;
  }
  
  .reels-menu-item:hover {
    background: rgba(192, 132, 252, 0.15);
    color: #e879f9;
  }
  
  .reels-menu-item svg {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  
  .reels-menu-item:hover svg {
    color: #e879f9;
  }
  
  /* Loading */
  .reels-loader {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    background: #000;
    z-index: 50;
  }
  
  .reels-spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: reelsSpin 0.8s linear infinite;
  }
  
  @keyframes reelsSpin { to { transform: rotate(360deg); } }
  
  /* ═══ SCROLLER (TikTok's magic) ═══ */
  .reels-scroller {
    flex: 1;
    height: 100vh;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-stop: always;
  }
  
  .reels-scroller::-webkit-scrollbar { display: none; }
  
  /* Each video slot = 1 full screen */
  .reels-slot {
    position: relative;
    height: 100vh;
    width: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  /* Poster (background before video loads) */
  .reels-slot-poster {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    z-index: 1;
    transition: opacity 0.5s ease;
    filter: blur(20px) brightness(0.5);
    width: 100%;
    height: 100%;
    object-position: center;
  }
  
  /* Video container */
  .reels-slot-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: min(500px, calc(100vh * 9 / 16));
    aspect-ratio: 9/16;
    max-height: calc(100vh - 40px);
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9);
    z-index: 5;
  }
  
  .reels-slot-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  
  /* Gradient overlays for text readability */
  .reels-slot-gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 200px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.7), transparent);
    pointer-events: none;
    z-index: 8;
  }
  
  /* Bottom info bar */
  .reels-slot-info {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 40px;
    z-index: 10;
    color: #fff;
    max-width: 500px;
    margin: 0 auto;
    pointer-events: none;
  }
  
  .reels-slot-user {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    pointer-events: auto;
  }
  
  .reels-slot-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    padding: 2px;
    flex-shrink: 0;
  }
  
  .reels-slot-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e879f9;
    font-size: 0.9rem;
    padding-left: 2px;
  }
  
  .reels-slot-user-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .reels-slot-follow {
    padding: 5px 14px;
    background: transparent;
    border: 1.5px solid #fff;
    color: #fff;
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  
  .reels-slot-follow:hover {
    background: #fff;
    color: #000;
  }
  
  .reels-slot-caption {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    pointer-events: auto;
  }
  
  /* Progress indicator (right side) */
  .reels-progress {
    position: fixed;
