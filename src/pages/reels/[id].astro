  </style>

  <!-- ═══ MAIN INTERACTION SCRIPT ═══ -->
  <script>
    (function() {
      const root = document.getElementById('reels-root') as HTMLElement;
      if (!root) return;
      
      const videoId = root.dataset.videoid || '';
      const currentVideo: any = (window as any).__REELS_VIDEO__ || null;
      const feedData: any[] = (window as any).__REELS_FEED__ || [];
      const nextId = (window as any).__NEXT_ID__ || '';
      const prevId = (window as any).__PREV_ID__ || '';
      
      // ═══ THUMBNAIL HELPER ═══
      function getThumbnailUrl(vid: string, existing: string = ''): string {
        if (existing && existing.trim()) return existing;
        if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
          const rawId = vid.replace(/^(yts_|yt_)/, '');
          return `https://i.ytimg.com/vi/${rawId}/hqdefault.jpg`;
        }
        if (vid.startsWith('dm_')) {
          const rawId = vid.replace('dm_', '');
          return `https://www.dailymotion.com/thumbnail/video/${rawId}`;
        }
        return '';
      }
      
      function esc(s: string): string {
        return String(s || '').replace(/[&<>"']/g, (c: string) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c] || c));
      }
      
      function trunc(s: string, n: number): string {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '…' : s;
      }
      
      function shuffle<T>(arr: T[]): T[] {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }
      
      // ═══ WATCH HISTORY ═══
      try {
        if (currentVideo && videoId) {
          const goodThumb = getThumbnailUrl(videoId, currentVideo.thumbnail);
          const history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          const filtered = history.filter((h: any) => h.id !== videoId);
          filtered.unshift({
            id: videoId,
            title: currentVideo.title,
            channel: currentVideo.channel,
            thumbnail: goodThumb,
            type: currentVideo.type || 'anime',
            source: currentVideo.source || 'youtube',
            watchedAt: Date.now()
          });
          localStorage.setItem('anitube_history', JSON.stringify(filtered.slice(0, 100)));
        }
      } catch (e) { console.warn('History save failed', e); }
      
      // ═══ SAVE FUNCTIONALITY ═══
      const saveBtn = document.getElementById('saveBtn');
      const savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      const isSaved = () => savedVideos.some((s: any) => s.id === videoId);
      
      function updateSaveUI() {
        const saved = isSaved();
        if (!saveBtn) return;
        if (saved) {
          saveBtn.classList.add('saved');
          const label = saveBtn.querySelector('.rp-action-label');
          if (label) label.textContent = 'Saved';
        } else {
          saveBtn.classList.remove('saved');
          const label = saveBtn.querySelector('.rp-action-label');
          if (label) label.textContent = 'Save';
        }
      }
      
      function toggleSave() {
        const idx = savedVideos.findIndex((s: any) => s.id === videoId);
        if (idx > -1) {
          savedVideos.splice(idx, 1);
        } else {
          const goodThumb = getThumbnailUrl(videoId, currentVideo?.thumbnail);
          savedVideos.unshift({
            id: videoId,
            title: currentVideo?.title || 'Video',
            channel: currentVideo?.channel || 'AniTube',
            thumbnail: goodThumb,
            type: currentVideo?.type || 'anime',
            source: currentVideo?.source || 'youtube',
            savedAt: Date.now()
          });
        }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      
      updateSaveUI();
      saveBtn?.addEventListener('click', toggleSave);
      
      // ═══ DOUBLE-TAP TO SAVE ═══
      const card = document.getElementById('videoCard');
      const doubleTapHeart = document.getElementById('doubleTapHeart');
      let lastTap = 0;
      
      card?.addEventListener('click', (e) => {
        const now = Date.now();
        if (now - lastTap < 350) {
          if (!isSaved()) toggleSave();
          if (doubleTapHeart) {
            doubleTapHeart.classList.remove('pop');
            void (doubleTapHeart as HTMLElement).offsetWidth;
            doubleTapHeart.classList.add('pop');
          }
          lastTap = 0;
        } else {
          lastTap = now;
        }
      });
      
      // ═══ SEND / SHARE ═══
      const sendBtn = document.getElementById('sendBtn');
      
      async function handleSend() {
        if (!sendBtn) return;
        const shareData = {
          title: (currentVideo?.title || 'AniTube Video'),
          text: 'Check out this on AniTubeBuzz!',
          url: window.location.href
        };
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        sendBtn.classList.add('sent');
        setTimeout(() => sendBtn.classList.remove('sent'), 600);
        if (isMobile && (navigator as any).share) {
          try { await (navigator as any).share(shareData); } catch { }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const label = sendBtn.querySelector('.rp-action-label');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => { label.textContent = orig; }, 1800);
            }
          } catch {
            prompt('Copy this link:', window.location.href);
          }
        }
      }
      
      sendBtn?.addEventListener('click', handleSend);
      
      // ═══ NAVIGATION ═══
      let navigating = false;
      
      function navigateToVideo(targetId: string) {
        if (navigating || !targetId) return;
        navigating = true;
        const c = document.getElementById('videoCard');
        if (c) {
          c.style.opacity = '0';
          c.style.transform = 'scale(0.96)';
          c.style.transition = 'all 0.25s ease';
        }
        setTimeout(() => { window.location.href = `/reels/${targetId}`; }, 220);
      }
      
      const nextBtn = document.getElementById('nextBtn');
      const prevBtn = document.getElementById('prevBtn');
      
      nextBtn?.addEventListener('click', () => {
        if (nextId) navigateToVideo(nextId);
      });
      
      prevBtn?.addEventListener('click', () => {
        if (prevId) navigateToVideo(prevId);
        else if (window.history.length > 1) window.history.back();
      });
      
      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'j' || e.key === 'J') {
          if (nextId) { e.preventDefault(); navigateToVideo(nextId); }
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'k' || e.key === 'K') {
          if (prevId) { e.preventDefault(); navigateToVideo(prevId); }
        }
      });
      
      // ═══ LOADER HIDE ═══
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const loader = document.getElementById('loader');
      iframe?.addEventListener('load', () => {
        setTimeout(() => loader?.classList.add('hidden'), 400);
      });
      setTimeout(() => loader?.classList.add('hidden'), 3500);
      
      // ═══ SAFIYA EVENT ═══
      setTimeout(() => {
        if (currentVideo) {
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: currentVideo }
          }));
        }
      }, 500);
      
      // ═══ CHAT BUTTON (placeholder for now) ═══
      const chatBtn = document.getElementById('chatBtn');
      chatBtn?.addEventListener('click', () => {
        alert('💬 Global Chat coming soon! Stay tuned bro 🔥');
      });
      
      // Fake live chat counter (random 20-80)
      const chatCountEl = document.getElementById('chatCount');
      if (chatCountEl) {
        const baseCount = 20 + Math.floor(Math.random() * 60);
        chatCountEl.textContent = String(baseCount);
        setInterval(() => {
          const variation = Math.floor(Math.random() * 7) - 3;
          const newCount = Math.max(15, baseCount + variation);
          chatCountEl.textContent = String(newCount);
        }, 4000);
      }
      
      // ═══════════════════════════════════════════
      // 🔥 RELATED FEED — Infinite scroll + products
      // ═══════════════════════════════════════════
      const feedEl = document.getElementById('relatedFeed');
      const feedLoadingEl = document.getElementById('feedLoading');
      const feedCountEl = document.getElementById('feedCount');
      
      let feedItems: any[] = feedData.slice();
      let feedRendered = 0;
      let productPool: any[] = [];
      let loadingMore = false;
      let feedTotal = 0;
      let cardsSinceProduct = 0;
      
      function makeFeedItem(v: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = `/reels/${v.id}`;
        el.className = 'rp-feed-item';
        el.style.animationDelay = `${(i % 6) * 50}ms`;
        
        const thumb = getThumbnailUrl(v.id, v.thumbnail || '');
        const typeLabels: any = {
          anime: '🎌 ANIME',
          kdrama: '🇰🇷 K-DRAMA',
          donghua: '🐼 DONGHUA',
          movies: '🎬 MOVIE'
        };
        const typeLabel = typeLabels[v.type] || '🎬 VIDEO';
        
        const imgHtml = thumb
          ? `<img src="${esc(thumb)}" alt="${esc(v.title || '')}" loading="lazy" onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))';" />`
          : `<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:1.4rem;">📺</div>`;
        
        el.innerHTML = `
          <div class="rp-feed-thumb">
            ${imgHtml}
            ${v.isNew ? '<div class="rp-feed-new-badge">NEW</div>' : ''}
            <div class="rp-feed-type-badge">${typeLabel}</div>
            <div class="rp-feed-thumb-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="rp-feed-info">
            <h3 class="rp-feed-title-text">${esc(trunc(v.title || 'Video', 90))}</h3>
            <div class="rp-feed-channel">@${esc((v.channel || 'anitube').replace(/\s+/g, '').toLowerCase().slice(0, 20))}</div>
          </div>
        `;
        
        return el;
      }
      
      function makeProductRow(products: any[]): HTMLElement {
        const row = document.createElement('div');
        row.className = 'rp-feed-product-row';
        
        const items = products.slice(0, 6).map(p => {
          const img = p.image
            ? `<img src="${esc(p.image)}" alt="${esc(p.title || '')}" loading="lazy" onerror="this.style.display='none'" />`
            : '';
          return `
            <a href="/product/${esc(p.id)}" class="rp-feed-product-item">
              <div class="rp-feed-product-thumb">${img}</div>
              <div class="rp-feed-product-title">${esc(trunc(p.title || '', 30))}</div>
              <div class="rp-feed-product-price">${esc(p.price || '')}</div>
            </a>
          `;
        }).join('');
        
        row.innerHTML = `
          <div class="rp-feed-product-header">✨ Recommended</div>
          <div class="rp-feed-product-scroll">${items}</div>
        `;
        
        return row;
      }
      
      function renderBatch() {
        if (!feedEl) return;
        const batchSize = 6;
        const end = Math.min(feedRendered + batchSize, feedItems.length);
        
        for (let i = feedRendered; i < end; i++) {
          feedEl.appendChild(makeFeedItem(feedItems[i], i));
          feedTotal++;
          cardsSinceProduct++;
          
          // Insert product row every 4 videos
          if (cardsSinceProduct >= 4 && productPool.length > 0) {
            const products = shuffle(productPool).slice(0, 6);
            feedEl.appendChild(makeProductRow(products));
            cardsSinceProduct = 0;
          }
        }
        
        feedRendered = end;
        if (feedCountEl) feedCountEl.textContent = String(feedTotal);
      }
      
      async function fetchMoreVideos() {
        if (loadingMore) return;
        loadingMore = true;
        if (feedLoadingEl) feedLoadingEl.style.display = 'flex';
        
        try {
          const types = ['anime', 'donghua', 'kdrama', 'movies'];
          const type = types[Math.floor(Math.random() * types.length)];
          const page = Math.floor(Math.random() * 5) + 1;
          const res = await fetch(`/api/social-feed?type=${type}&page=${page}&limit=10`);
          const data = await res.json();
          
          if (data.success && data.videos) {
            const existingIds = new Set(feedItems.map(v => v.id));
            existingIds.add(videoId);
            const fresh = data.videos.filter((v: any) => !existingIds.has(v.id));
            feedItems = feedItems.concat(fresh);
            renderBatch();
          }
        } catch (e) {
          console.warn('Feed load failed', e);
        }
        
        if (feedLoadingEl) feedLoadingEl.style.display = 'none';
        loadingMore = false;
      }
      
      async function loadProducts() {
        try {
          const res = await fetch('/api/products?limit=30');
          const data = await res.json();
          if (data.success && data.products) {
            productPool = data.products;
          }
        } catch (e) { console.warn('Products fail', e); }
      }
      
      // Initial render
      loadProducts().then(() => {
        renderBatch();
      });
      
      // Infinite scroll — trigger when near bottom
      let scrollTimer: any = null;
      window.addEventListener('scroll', () => {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          if (loadingMore) return;
          const scrollBottom = window.scrollY + window.innerHeight;
          const pageHeight = document.documentElement.scrollHeight;
          
          if (scrollBottom > pageHeight - 800) {
            // If we have more pre-loaded items, render them first
            if (feedRendered < feedItems.length) {
              renderBatch();
            } else {
              fetchMoreVideos();
            }
          }
        }, 150);
      }, { passive: true });
      
    })();
  </script>
</ImmersiveLayout>
