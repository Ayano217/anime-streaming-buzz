---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { id } = Astro.params;
const videoId = id || '';

const animeMatch = videoId.match(/^anime_(.+)_ep(\d+)$/);
const isAnimeExternal = !!animeMatch;
const animeSlug = animeMatch ? animeMatch[1] : '';
const animeEpNum = animeMatch ? parseInt(animeMatch[2]) : 0;

if (videoId.startsWith('anime_') && !isAnimeExternal) {
  const cleanSlug = videoId.replace(/^anime_/, '').replace(/_ep\d*$/, '');
  return Astro.redirect(`/reels/anime_${cleanSlug}_ep1`, 302);
}

let externalAnime: any = null;
let kvAnimeInfo: any = null;

if (isAnimeExternal) {
  try {
    const env = (Astro.locals as any)?.runtime?.env || {};
    const kv = env.ANIME_DB;

    if (kv) {
      const seasonsToTry = [1, 2, 3, 4, 5];
      for (const s of seasonsToTry) {
        const recordId = `${animeSlug}_s${s}_ep${animeEpNum}`;
        const raw = await kv.get(`video:${recordId}`);
        if (raw) {
          try {
            kvAnimeInfo = JSON.parse(raw);
            break;
          } catch {}
        }
      }

      if (!kvAnimeInfo) {
        const indexRaw = await kv.get('index:all');
        if (indexRaw) {
          let index: string[] = [];
          try { index = JSON.parse(indexRaw); } catch {}

          for (const idKey of index.slice(0, 100)) {
            if (idKey.startsWith(animeSlug + '_s') && idKey.endsWith('_ep' + animeEpNum)) {
              const raw = await kv.get(`video:${idKey}`);
              if (raw) {
                try {
                  kvAnimeInfo = JSON.parse(raw);
                  break;
                } catch {}
              }
            }
          }
        }
      }
    }
  } catch (e) {}

  try {
    const url = new URL('/api/anime-external', Astro.url.origin);
    url.searchParams.set('action', 'detail');
    url.searchParams.set('slug', animeSlug);
    const res = await fetch(url);
    if (res.ok) {
      const data = await res.json();
      if (data.success) externalAnime = data;
    }
  } catch (e) {}
}

const tmdbId: number | null = externalAnime?.tmdb_id ?? null;
const seasonNum: number = externalAnime?.season_number ?? 1;

function getPlatformData(vid: string, tmdbIdParam: number | null = null, seasonParam: number = 1): any {
  if (vid.startsWith('anime_')) {
    const m = vid.match(/^anime_(.+)_ep(\d+)$/);
    if (m) {
      const slugPart = m[1];
      const epNum = m[2];

      if (tmdbIdParam) {
        return {
          source: 'multi',
          embedUrl: `https://vidsrc.to/embed/tv/${tmdbIdParam}/${seasonParam}/${epNum}`,
          aspect: 'landscape',
          isShort: false,
          tmdbId: tmdbIdParam,
          season: seasonParam,
          episode: parseInt(epNum, 10),
          hasMultiSource: true,
        };
      }

      return {
        source: 'animotv',
        embedUrl: `https://animotvslash.org/${slugPart}-episode-${epNum}/`,
        aspect: 'landscape',
        isShort: false,
        hasMultiSource: false,
      };
    }
  }
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return { source: 'youtube_shorts', embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1&autoplay=1`, aspect: 'portrait', isShort: true };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return { source: 'youtube', embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1&autoplay=1`, aspect: 'landscape', isShort: false };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return { source: 'dailymotion', embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0&ui-logo=0&sharing-enable=0`, aspect: 'landscape', isShort: false };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return { source: 'bilibili', embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1&high_quality=1`, aspect: 'landscape', isShort: false };
  }
  return null;
}

function generateThumbnail(vid: string, apiThumbnail = '') {
  if (apiThumbnail && apiThumbnail.trim()) return apiThumbnail;
  if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
    return `https://i.ytimg.com/vi/${vid.replace(/^(yts_|yt_)/, '')}/hqdefault.jpg`;
  }
  if (vid.startsWith('dm_')) {
    return `https://www.dailymotion.com/thumbnail/video/${vid.replace('dm_', '')}`;
  }
  return '';
}

function extractSeriesFromTitle(title: string) {
  let t = (title || '').toLowerCase();
  t = t.replace(/\bep(?:isode)?\s*\d+.*/i, '');
  t = t.replace(/\bseason\s\d+.*/i, '');
  t = t.replace(/\bs\d+e\d+.*/i, '');
  t = t.replace(/\b\d+\s*(?:sub|dub|eng|hd|full).*/i, '');
  t = t.replace(/\[[^\]]*\]/g, '');
  t = t.replace(/\([^)]*\)/g, '');
  t = t.replace(/[^\w\s]/g, ' ');
  t = t.replace(/\s+/g, ' ').trim();
  return t.slice(0, 50);
}

function slugToTitle(slug: string) {
  return String(slug || '')
    .replace(/-/g, ' ')
    .replace(/\b\w/g, l => l.toUpperCase())
    .trim();
}

let video: any = null;
let allVideos: any[] = [];

if (isAnimeExternal) {
  const platformData = getPlatformData(videoId, tmdbId, seasonNum);

  if (kvAnimeInfo) {
    const currentEp = (externalAnime && externalAnime.episodes)
      ? externalAnime.episodes.find((e: any) => e.number === animeEpNum)
      : null;
    const heroImage = kvAnimeInfo.thumbnail
      || (currentEp && currentEp.thumbnail)
      || (externalAnime && externalAnime.poster)
      || '';

    video = {
      id: videoId,
      title: `${kvAnimeInfo.animeTitle} - Episode ${animeEpNum}${kvAnimeInfo.season > 1 ? ` (Season ${kvAnimeInfo.season})` : ''}`,
      channel: 'AniTubeBuzz',
      thumbnail: heroImage,
      poster: heroImage,
      embedUrl: platformData.embedUrl,
      source: platformData.source,
      aspect: 'landscape',
      isShort: false,
      type: 'anime',
      description: kvAnimeInfo.caption || (externalAnime && externalAnime.description) || '',
      isAnimeExternal: true,
      animeSlug: animeSlug,
      episodeNumber: animeEpNum,
      totalEpisodes: (externalAnime && externalAnime.episodes) ? externalAnime.episodes.length : 26,
      seasonNumber: kvAnimeInfo.season || seasonNum,
      fromDatabase: true,
      hasMultiSource: platformData.hasMultiSource || false,
    };
  }
  else if (externalAnime) {
    const currentEp = (externalAnime.episodes || []).find((e: any) => e.number === animeEpNum);
    const heroImage = (currentEp && currentEp.thumbnail) ? currentEp.thumbnail : (externalAnime.poster || '');
    video = {
      id: videoId,
      title: `${externalAnime.title} - Episode ${animeEpNum}`,
      channel: 'AniTubeBuzz',
      thumbnail: heroImage,
      poster: externalAnime.poster || '',
      embedUrl: platformData.embedUrl,
      source: platformData.source,
      aspect: 'landscape',
      isShort: false,
      type: 'anime',
      description: externalAnime.description || '',
      isAnimeExternal: true,
      animeSlug: animeSlug,
      episodeNumber: animeEpNum,
      totalEpisodes: externalAnime.episodes ? externalAnime.episodes.length : 26,
      seasonNumber: seasonNum,
      fromDatabase: false,
      hasMultiSource: platformData.hasMultiSource || false,
    };
  }
  else {
    const readableTitle = slugToTitle(animeSlug);
    video = {
      id: videoId,
      title: `${readableTitle} - Episode ${animeEpNum}`,
      channel: 'AniTubeBuzz',
      thumbnail: '',
      poster: '',
      embedUrl: platformData.embedUrl,
      source: platformData.source,
      aspect: 'landscape',
      isShort: false,
      type: 'anime',
      description: '',
      isAnimeExternal: true,
      animeSlug: animeSlug,
      episodeNumber: animeEpNum,
      totalEpisodes: 26,
      seasonNumber: 1,
      fromDatabase: false,
      hasMultiSource: false,
    };
  }
} else {
  try {
    const apiUrl = new URL('/api/social-feed', Astro.url.origin);
    apiUrl.searchParams.set('limit', '100');
    apiUrl.searchParams.set('format', 'all');
    const response = await fetch(apiUrl);
    if (response.ok) {
      const data = await response.json();
      allVideos = data.videos || [];
      video = allVideos.find((v: any) => v.id === videoId);
    }
  } catch (e) {}

  if (!video) {
    const platformData = getPlatformData(videoId);
    if (platformData) {
      video = { id: videoId, title: 'Video', channel: 'AniTube', thumbnail: generateThumbnail(videoId, ''), embedUrl: platformData.embedUrl, source: platformData.source, aspect: platformData.aspect, isShort: platformData.isShort, type: 'anime', description: '' };
    } else {
      video = { id: videoId, title: 'Video', channel: 'AniTubeBuzz', thumbnail: '', embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0&autoplay=1`, source: 'youtube', aspect: 'landscape', isShort: false, type: 'anime', description: '' };
    }
  } else {
    if (!video.thumbnail || !video.thumbnail.trim()) video.thumbnail = generateThumbnail(videoId, '');
    if (!video.description) video.description = '';
  }
}

const seriesName = extractSeriesFromTitle(video.title);
const displayChannel = (video.channel || 'AniTube').trim();
const videoAspect = video.aspect || (video.isShort ? 'portrait' : 'landscape');
const typeLabels: Record<string, string> = { anime: 'Anime', kdrama: 'K-Drama', donghua: 'Donghua', movies: 'Movie' };
const typeLabel = typeLabels[video.type] || 'Video';

let publishText = '';
if (video.publishedAt) {
  try {
    const d = new Date(video.publishedAt);
    const diff = Math.floor((Date.now() - d.getTime()) / (1000 * 60 * 60 * 24));
    if (diff < 1) publishText = 'Today';
    else if (diff < 7) publishText = diff + ' days ago';
    else if (diff < 30) publishText = Math.floor(diff / 7) + ' weeks ago';
    else if (diff < 365) publishText = Math.floor(diff / 30) + ' months ago';
    else publishText = Math.floor(diff / 365) + ' years ago';
  } catch (e) {}
}

const description = (video.description || '').trim();
const hasDescription = description.length > 0;
const metaParts = ['HD', typeLabel];
if (video.episodeNumber) metaParts.push(`Episode ${video.episodeNumber}`);
if (video.seasonNumber && video.seasonNumber > 1) metaParts.push(`Season ${video.seasonNumber}`);
if (publishText) metaParts.push(publishText);
const metaText = metaParts.join(' • ');

const externalEpisodes = (isAnimeExternal && externalAnime) ? externalAnime.episodes : [];
const totalRealThumbs = externalEpisodes.filter((e: any) => e.hasRealThumb).length;
<BaseLayout title={`${video.title} | AniTubeBuzz`}>
  <Header slot="header" />

  <section class="rp-section">
    <div class="rp-container">
      <div id="reels-root" 
           data-videoid={videoId} 
           data-aspect={videoAspect} 
           data-channel={displayChannel} 
           data-series={seriesName} 
           data-type={video.type}
           data-is-external={isAnimeExternal ? 'true' : 'false'}
           data-anime-slug={animeSlug}
           data-ep-num={animeEpNum}
           data-embed-url={video.embedUrl}
           data-poster={video.thumbnail}
           data-tmdb-id={tmdbId || ''}
           data-season={seasonNum}
           data-has-multi={video.hasMultiSource ? 'true' : 'false'}>
        <div class="rp-grid">

          <div class="rp-main">

            {isAnimeExternal ? (
              <div class="rp-player rp-player-external" id="videoCard">
                <div class="rp-player-frame">
                  <div class="rp-external-wrap" id="externalWrap">
                    <div class="rp-ext-placeholder" id="extPlaceholder">
                      {video.thumbnail && (
                        <img 
                          src={String(video.thumbnail)} 
                          alt={String(video.title || 'Video')} 
                          class="rp-ext-placeholder-img" 
                          loading="eager" 
                          referrerpolicy="no-referrer"
                        />
                      )}
                      <div class="rp-ext-placeholder-overlay"></div>
                      <div class="rp-ext-placeholder-content">
                        <div class="rp-orbit">
                          <div class="rp-dot rp-d1"></div>
                          <div class="rp-dot rp-d2"></div>
                          <div class="rp-dot rp-d3"></div>
                        </div>
                        <div class="rp-brand">AniTubeBuzz</div>
                        <div class="rp-ext-placeholder-text" id="extPlaceholderText">Loading player...</div>
                      </div>
                    </div>
                    <div class="rp-ext-brand">
                      <span class="rp-ext-logo">AniTubeBuzz</span>
                      <span class="rp-ext-live">HD</span>
                    </div>
                  </div>
                </div>

                <div class="rp-server-switcher" id="serverSwitcher" style="display:none;">
                  <div class="rp-server-label">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    <span>Server:</span>
                  </div>
                  <div class="rp-server-btns" id="serverBtns"></div>
                </div>
              </div>
            ) : (
              <div class="rp-player" id="videoCard" data-aspect={videoAspect}>
                <div class="rp-player-frame">
                  <iframe
                    id="videoFrame"
                    src={video.embedUrl}
                    title={String(video.title || 'Video')}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    loading="eager"
                  ></iframe>
                  <div class="rp-vloader" id="videoLoader">
                    <div class="rp-orbit">
                      <div class="rp-dot rp-d1"></div>
                      <div class="rp-dot rp-d2"></div>
                      <div class="rp-dot rp-d3"></div>
                    </div>
                    <div class="rp-brand">AniTubeBuzz</div>
                  </div>
                  <div class="rp-heart" id="doubleTapHeart">
                    <svg viewBox="0 0 24 24" fill="currentColor" style="width:100%;height:100%;">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </div>
                </div>
              </div>
            )}

            <h1 class="rp-title">{video.title}</h1>

            <div class="rp-meta-bar">
              <div class="rp-channel">
                <div class="rp-avatar"><span>{displayChannel.charAt(0).toUpperCase()}</span></div>
                <div class="rp-channel-info">
                  <div class="rp-channel-name">{displayChannel}</div>
                  <div class="rp-channel-meta">
                    <span class="rp-live"></span>
                    <span>{metaText}</span>
                  </div>
                </div>
              </div>
              <div class="rp-actions">
                <button class="rp-btn" id="likeBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Like</span>
                </button>
                <button class="rp-btn" id="saveBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Save</span>
                </button>
                <button class="rp-btn" id="sendBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path>
                  </svg>
                  <span class="rp-btn-lbl">Share</span>
                </button>
                <button class="rp-btn rp-btn-next" id="nextBtn">
                  <span class="rp-btn-lbl">Next</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            {isAnimeExternal && externalEpisodes.length > 0 && (
              <div class="rp-ep-box rp-ep-mobile collapsed" id="epBoxMobile">
                <button class="rp-ep-header" id="epHeaderMobile" aria-expanded="false" type="button">
                  <div class="rp-ep-head-left">
                    <div class="rp-ep-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="15" rx="2"></rect>
                        <polyline points="17 2 12 7 7 2"></polyline>
                      </svg>
                    </div>
                    <div class="rp-ep-head-text">
                      <div class="rp-ep-head-title">Episodes</div>
                      <div class="rp-ep-head-sub">
                        <span class="rp-ep-count">{externalEpisodes.length}</span>
                        <span class="rp-ep-dot">•</span>
                        <span class="rp-ep-current">EP {animeEpNum}</span>
                        {totalRealThumbs > 0 && (
                          <>
                            <span class="rp-ep-dot">•</span>
                            <span class="rp-ep-hd">HD</span>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                  <div class="rp-ep-head-right">
                    <div class="rp-ep-chevron">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </div>
                  </div>
                </button>

                <div class="rp-ep-body">
                  <div class="rp-ep-scroll">
                    {externalEpisodes.map((ep: any) => (
                      <a class={`rp-ext-ep-card ${ep.number === animeEpNum ? 'active' : ''}`} 
                         href={`/reels/${ep.embedId}`}
                         data-ep-num={ep.number}>
                        <div class="rp-ext-ep-thumb">
                          <img src={ep.thumbnail} alt={`Episode ${ep.number}`} loading="lazy" referrerpolicy="no-referrer" />
                          <div class="rp-ext-ep-overlay"></div>
                          <div class="rp-ext-ep-num-badge">EP {ep.number}</div>
                          {ep.number !== animeEpNum && (
                            <div class="rp-ext-ep-play-mini">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z"></path>
                              </svg>
                            </div>
                          )}
                          {ep.number === animeEpNum && (
                            <div class="rp-ext-ep-playing-overlay">
                              <div class="rp-ext-ep-playing-wave">
                                <span></span><span></span><span></span><span></span>
                              </div>
                            </div>
                          )}
                        </div>
                        <div class="rp-ext-ep-info">
                          <div class="rp-ext-ep-title">Episode {ep.number}</div>
                          <div class="rp-ext-ep-meta">
                            {ep.number === animeEpNum ? (
                              <><span class="rp-ep-live-dot"></span> Playing now</>
                            ) : ep.hasRealThumb ? (
                              'Available HD'
                            ) : (
                              'Click to watch'
                            )}
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {hasDescription && (
              <div class="rp-desc">
                <div class="rp-desc-head">
                  <div class="rp-desc-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    <span>Description</span>
                  </div>
                  <button class="rp-desc-tgl" id="descToggle">Show more</button>
                </div>
                <div class="rp-desc-body" id="descContent">
                  <p>{description}</p>
                </div>
              </div>
            )}

            <section class="rp-comments">
              <div class="rp-comments-head">
                <h3 class="rp-comments-title"><span id="commentCount">0</span> Comments</h3>
                <button class="rp-sort-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="15" y2="12"></line>
                    <line x1="3" y1="18" x2="9" y2="18"></line>
                  </svg>
                  <span>Sort by</span>
                </button>
              </div>
              <div class="rp-comment-input-row">
                <div class="rp-my-av" id="userInitial">Y</div>
                <div class="rp-comment-input-wrap">
                  <input type="text" id="commentInput" class="rp-comment-input" placeholder="Add a comment..." maxlength="500" />
                  <div class="rp-comment-actions" id="commentActions" style="display:none;">
                    <button class="rp-cancel-btn" id="cancelComment">Cancel</button>
                    <button class="rp-submit-btn" id="submitComment">Comment</button>
                  </div>
                </div>
              </div>
              <div id="commentsList" class="rp-comments-list">
                <div class="rp-comments-empty"><p>No comments yet. Be the first! 💬</p></div>
              </div>
            </section>

            <section class="rp-more-section" id="moreSection">
              <div class="rp-section-head">
                <div class="rp-section-title">
                  <span class="rp-section-bar"></span>
                  <span>More Like This</span>
                </div>
                <div class="rp-section-tag">FOR YOU</div>
              </div>
              <div id="moreFeed" class="rp-feed-grid"></div>
              <div id="moreLoading" class="rp-more-loading">
                <div class="rp-spinner"></div>
                <span>Loading more...</span>
              </div>
            </section>

          </div>

          <aside class="rp-sidebar">
            {isAnimeExternal && externalEpisodes.length > 0 && (
              <div class="rp-ep-box rp-ep-desktop" id="epBoxDesktop">
                <div class="rp-ep-header rp-ep-header-static">
                  <div class="rp-ep-head-left">
                    <div class="rp-ep-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="15" rx="2"></rect>
                        <polyline points="17 2 12 7 7 2"></polyline>
                      </svg>
                    </div>
                    <div class="rp-ep-head-text">
                      <div class="rp-ep-head-title">Episodes</div>
