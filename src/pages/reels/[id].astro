---
export const prerender = false;

import ImmersiveLayout from '../../layouts/ImmersiveLayout.astro';

const { id } = Astro.params;
const videoId = id || '';

function getPlatformData(vid: string) {
  if (vid.startsWith('yts_')) {
    const rawId = vid.replace('yts_', '');
    return { source: 'youtube_shorts', embedUrl: `https://www.youtube.com/embed/${rawId}?loop=1&playlist=${rawId}&rel=0&modestbranding=1&autoplay=1`, aspect: 'portrait', isShort: true, rawId };
  }
  if (vid.startsWith('yt_')) {
    const rawId = vid.replace('yt_', '');
    return { source: 'youtube', embedUrl: `https://www.youtube.com/embed/${rawId}?rel=0&modestbranding=1&autoplay=1`, aspect: 'landscape', isShort: false, rawId };
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return { source: 'dailymotion', embedUrl: `https://www.dailymotion.com/embed/video/${rawId}?autoplay=1&mute=0`, aspect: 'landscape', isShort: false, rawId };
  }
  if (vid.startsWith('bili_')) {
    const rawId = vid.replace('bili_', '');
    return { source: 'bilibili', embedUrl: `https://player.bilibili.com/player.html?bvid=${rawId}&autoplay=1&high_quality=1`, aspect: 'landscape', isShort: false, rawId };
  }
  if (vid.startsWith('ody_')) {
    const rawId = vid.replace('ody_', '');
    return { source: 'odysee', embedUrl: `https://odysee.com/$/embed/${rawId}?autoplay=1`, aspect: 'landscape', isShort: false, rawId };
  }
  if (vid.startsWith('rmb_')) {
    const rawId = vid.replace('rmb_', '');
    return { source: 'rumble', embedUrl: `https://rumble.com/embed/${rawId}/?autoplay=2`, aspect: 'landscape', isShort: false, rawId };
  }
  return null;
}

function generateThumbnail(vid: string, apiThumbnail: string = ''): string {
  if (apiThumbnail && apiThumbnail.trim()) return apiThumbnail;
  if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
    const rawId = vid.replace(/^(yts_|yt_)/, '');
    return `https://i.ytimg.com/vi/${rawId}/hqdefault.jpg`;
  }
  if (vid.startsWith('dm_')) {
    const rawId = vid.replace('dm_', '');
    return `https://www.dailymotion.com/thumbnail/video/${rawId}`;
  }
  return '';
}

let video: any = null;
let allVideos: any[] = [];

try {
  const apiUrl = new URL('/api/social-feed', Astro.url.origin);
  apiUrl.searchParams.set('limit', '100');
  apiUrl.searchParams.set('format', 'all');
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    allVideos = data.videos || [];
    video = allVideos.find((v: any) => v.id === videoId);
  }
} catch (e) {
  console.error('API fetch failed:', e);
}

if (!video) {
  const platformData = getPlatformData(videoId);
  if (platformData) {
    video = {
      id: videoId, title: 'Anime Content', channel: 'AniTube',
      thumbnail: generateThumbnail(videoId, ''),
      embedUrl: platformData.embedUrl, source: platformData.source,
      aspect: platformData.aspect, isShort: platformData.isShort, type: 'anime'
    };
  } else {
    video = {
      id: videoId, title: 'Anime Video', channel: 'AniTubeBuzz',
      thumbnail: '',
      embedUrl: `https://www.youtube.com/embed/${videoId.replace(/^(yt_|yts_|dm_|bili_|ody_|rmb_)/, '')}?rel=0&autoplay=1`,
      source: 'youtube', aspect: 'landscape', isShort: false, type: 'anime'
    };
  }
} else {
  if (!video.thumbnail || !video.thumbnail.trim()) {
    video.thumbnail = generateThumbnail(videoId, '');
  }
}

function buildRelatedFeed(current: any, all: any[]): any[] {
  if (!all || all.length === 0) return [];
  const pool = all.filter(v => v.id !== current.id);
  const scored = pool.map(v => {
    let score = 0;
    if (v.channel === current.channel) score += 100;
    if (v.type === current.type) score += 50;
    if (v.source === current.source) score += 20;
    if (v.aspect === current.aspect) score += 30;
    if (v.isNew) score += 15;
    if (v.isOfficial) score += 10;
    score += Math.random() * 5;
    return { video: v, score };
  });
  scored.sort((a, b) => b.score - a.score);
  return scored.map(s => s.video);
}

const relatedFeed = buildRelatedFeed(video, allVideos);
const nextVideo = relatedFeed[0] || null;
const prevVideo = relatedFeed[1] || null;

const displayChannel = (video.channel || 'AniTube').trim();
const channelHandle = displayChannel.replace(/\s+/g, '').toLowerCase().slice(0, 25);

const videoAspect = video.aspect || (video.isShort ? 'portrait' : 'landscape');
---

<ImmersiveLayout title={`${video.title} | AniTubeBuzz`}>
  <div 
    id="reels-root" 
    class="rp-root" 
    data-videoid={videoId}
    data-next={nextVideo?.id || ''}
    data-prev={prevVideo?.id || ''}
    data-aspect={videoAspect}
  >
    
    <!-- ═══ TOP BAR ═══ -->
    <header class="rp-topbar">
      <button class="rp-home-btn" id="homeBtn" aria-label="Back to Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span class="rp-home-label">Home</span>
      </button>
      
      <div class="rp-brand">
        <span class="rp-brand-text">AniTubeBuzz</span>
        <div class="rp-brand-dot"></div>
      </div>
      
      <!-- 💬 CHAT BUTTON (neon glow, premium) -->
      <button class="rp-chat-btn" id="chatBtn" aria-label="Global Chat">
        <div class="rp-chat-glow"></div>
        <svg class="rp-chat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span class="rp-chat-label">Chat</span>
        <span class="rp-chat-count" id="chatCount">47</span>
        <span class="rp-chat-live"></span>
      </button>
    </header>

    <!-- ═══ MAIN CONTENT — Desktop: 2 columns | Mobile: stacked ═══ -->
    <div class="rp-main">
      
      <!-- LEFT: Video + Info + Actions -->
      <div class="rp-left">
        
        <div class="rp-card" id="videoCard">
          <div class="rp-card-glow"></div>
          <div class="rp-card-frame">
            <iframe 
              id="videoFrame"
              src={video.embedUrl}
              title={video.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="eager"
            ></iframe>
            
            <div class="rp-loader" id="loader">
              <div class="rp-loader-orbit">
                <div class="rp-loader-dot rp-dot-1"></div>
                <div class="rp-loader-dot rp-dot-2"></div>
                <div class="rp-loader-dot rp-dot-3"></div>
              </div>
              <div class="rp-loader-text">AniTubeBuzz</div>
            </div>
            
            <div class="rp-doubletap-heart" id="doubleTapHeart">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Action buttons row (both desktop + mobile) -->
        <div class="rp-actions-row">
          <button class="rp-action-btn rp-btn-save" id="saveBtn" aria-label="Save">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rp-action-icon rp-icon-bookmark">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
            <span class="rp-action-label">Save</span>
          </button>
          
          <button class="rp-action-btn rp-btn-send" id="sendBtn" aria-label="Share">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rp-action-icon rp-icon-plane">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
            <span class="rp-action-label">Send</span>
          </button>
          
          <button class="rp-action-btn rp-btn-prev" id="prevBtn" aria-label="Previous video">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rp-action-icon">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            <span class="rp-action-label">Prev</span>
          </button>
          
          <button class="rp-action-btn rp-btn-next" id="nextBtn" aria-label="Next video">
            <span class="rp-action-label">Next</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rp-action-icon">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
        
        <!-- Info card -->
        <div class="rp-info-card">
          <div class="rp-channel-row">
            <div class="rp-avatar">
              {displayChannel.charAt(0).toUpperCase()}
            </div>
            <div class="rp-channel-info">
              <div class="rp-channel-name">@{channelHandle}</div>
              <div class="rp-channel-sub">
                <span class="rp-hd-dot"></span>
                HD Quality
              </div>
            </div>
          </div>
          <h1 class="rp-video-title">{video.title}</h1>
        </div>
        
      </div>

      <!-- RIGHT: Related videos feed (vertical, YouTube-style) -->
      <aside class="rp-right">
        <div class="rp-feed-header">
          <div class="rp-feed-title">
            <span class="rp-feed-bar"></span>
            <span>Up Next</span>
          </div>
          <div class="rp-feed-count" id="feedCount">0</div>
        </div>
        
        <div class="rp-feed" id="relatedFeed"></div>
        
        <div class="rp-feed-loading" id="feedLoading" style="display:none;">
          <div class="rp-feed-spinner"></div>
          <span>Loading more...</span>
        </div>
      </aside>
      
    </div>

    <!-- ═══ DATA INJECTION ═══ -->
    <script is:inline set:html={`
      window.__REELS_VIDEO__ = ${JSON.stringify(video)};
      window.__REELS_FEED__ = ${JSON.stringify(relatedFeed.slice(0, 20))};
      window.__CURRENT_VIDEO_ID__ = ${JSON.stringify(videoId)};
      window.__NEXT_ID__ = ${JSON.stringify(nextVideo?.id || '')};
      window.__PREV_ID__ = ${JSON.stringify(prevVideo?.id || '')};
    `}></script>

    <!-- ═══ HOME BUTTON HANDLER (saves resume) ═══ -->
    <script is:inline>
      (function(){
        var vid = window.__CURRENT_VIDEO_ID__ || '';
        try {
          if (vid) {
            localStorage.setItem('anitube_resume_video', vid);
            localStorage.setItem('anitube_resume_time', String(Date.now()));
          }
        } catch(e) {}
        
        function goHome(e) {
          if (e) { e.preventDefault(); e.stopPropagation(); }
          try {
            if (vid) {
              localStorage.setItem('anitube_resume_video', vid);
              localStorage.setItem('anitube_resume_time', String(Date.now()));
            }
          } catch(err) {}
          window.location.href = '/';
          return false;
        }
        
        function attachHomeHandler() {
          var btn = document.getElementById('homeBtn');
          if (btn) {
            btn.onclick = goHome;
            btn.addEventListener('click', goHome, false);
          } else {
            setTimeout(attachHomeHandler, 50);
          }
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', attachHomeHandler);
        } else {
          attachHomeHandler();
        }
      })();
    </script>

  </div>

  <!-- ═══════════════════════════════════════════════════════════
       🎨 CSS — Complete rebuild
       ═══════════════════════════════════════════════════════════ -->
  <style>
    /* ═══ ROOT ═══ */
    .rp-root {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      background: 
        radial-gradient(ellipse at 20% 20%, rgba(192, 132, 252, 0.15) 0%, transparent 55%),
        radial-gradient(ellipse at 85% 75%, rgba(125, 211, 252, 0.1) 0%, transparent 55%),
        linear-gradient(180deg, #0a0517 0%, #150a29 50%, #0a0517 100%);
      user-select: none;
      -webkit-user-select: none;
    }

    /* ═══ TOP BAR ═══ */
    .rp-topbar {
      position: sticky;
      top: 0;
      left: 0; right: 0;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      z-index: 100;
      background: rgba(10, 5, 23, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(192, 132, 252, 0.12);
    }
    
    .rp-home-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px 8px 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(192, 132, 252, 0.25);
      border-radius: 100px;
      color: #f5ecff;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
    }
    .rp-home-btn:hover {
      background: rgba(192, 132, 252, 0.15);
      border-color: rgba(192, 132, 252, 0.5);
      transform: translateX(-2px);
    }
    .rp-home-btn:active { transform: translateX(-1px) scale(0.97); }
    .rp-home-label { line-height: 1; }
    
    .rp-brand {
      display: flex; align-items: center; gap: 7px;
      position: absolute; left: 50%; transform: translateX(-50%);
    }
    .rp-brand-text {
      font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;
      font-weight: 700; font-size: 16px;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .rp-brand-dot {
      width: 6px; height: 6px;
      background: #7dd3fc;
      border-radius: 50%;
      box-shadow: 0 0 10px #7dd3fc;
      animation: rp-pulse 2s infinite;
    }
    @keyframes rp-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }
    
    /* ═══ 💬 CHAT BUTTON — Premium neon glow ═══ */
    .rp-chat-btn {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px 8px 12px;
      background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(232, 121, 249, 0.1), rgba(125, 211, 252, 0.15));
      border: 1px solid rgba(232, 121, 249, 0.5);
      border-radius: 100px;
      color: #ffffff;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 
        0 0 20px rgba(232, 121, 249, 0.35),
        0 0 40px rgba(192, 132, 252, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      overflow: visible;
      animation: rp-chat-glow-pulse 3s ease-in-out infinite;
    }
    
    @keyframes rp-chat-glow-pulse {
      0%, 100% {
        box-shadow: 
          0 0 20px rgba(232, 121, 249, 0.35),
          0 0 40px rgba(192, 132, 252, 0.2),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }
      50% {
        box-shadow: 
          0 0 30px rgba(232, 121, 249, 0.6),
          0 0 60px rgba(192, 132, 252, 0.4),
          0 0 80px rgba(125, 211, 252, 0.25),
          inset 0 1px 0 rgba(255, 255, 255, 0.15);
      }
    }
    
    .rp-chat-glow {
      position: absolute;
      inset: -6px;
      border-radius: 100px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc, #e879f9, #c084fc);
      background-size: 300% 300%;
      opacity: 0.4;
      filter: blur(14px);
      z-index: -1;
      animation: rp-chat-glow-move 5s linear infinite;
      pointer-events: none;
    }
    
    @keyframes rp-chat-glow-move {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }
    
    .rp-chat-btn:hover {
      transform: translateY(-1px) scale(1.03);
      border-color: rgba(232, 121, 249, 0.8);
    }
    .rp-chat-btn:hover .rp-chat-glow { opacity: 0.7; }
    .rp-chat-btn:active { transform: translateY(0) scale(0.97); }
    
    .rp-chat-icon {
      width: 16px; height: 16px;
      color: #ffffff;
      filter: drop-shadow(0 0 6px rgba(232, 121, 249, 0.8));
    }
    
    .rp-chat-label {
      line-height: 1;
      color: #ffffff;
      text-shadow: 0 0 8px rgba(232, 121, 249, 0.5);
    }
    
    .rp-chat-count {
      padding: 2px 8px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      color: #7dd3fc;
      line-height: 1;
      text-shadow: 0 0 6px rgba(125, 211, 252, 0.8);
    }
    
    .rp-chat-live {
      position: absolute;
      top: -2px; right: -2px;
      width: 8px; height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981, 0 0 20px rgba(16, 185, 129, 0.5);
      animation: rp-chat-live-pulse 1.5s ease-in-out infinite;
    }
    
    @keyframes rp-chat-live-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.3); opacity: 0.6; }
    }

    /* ═══ MAIN LAYOUT ═══ */
    .rp-main {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 24px;
      max-width: 1600px;
      margin: 0 auto;
      padding: 20px 20px 60px;
    }

    .rp-left {
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-width: 0;
    }
    
    .rp-right {
      min-width: 0;
    }

    /* ═══ VIDEO CARD ═══ */
    .rp-card {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      animation: rp-card-enter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    /* Portrait (9:16 shorts) — smaller centered */
    .rp-root[data-aspect="portrait"] .rp-card {
      aspect-ratio: 9 / 16;
      max-width: 420px;
      margin: 0 auto;
    }
    
    @keyframes rp-card-enter {
      from { opacity: 0; transform: translateY(20px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    
    .rp-card-glow {
      position: absolute; inset: -3px;
      background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
      border-radius: 20px;
      opacity: 0.5;
      filter: blur(12px);
      z-index: -1;
      animation: rp-glow 4s ease-in-out infinite;
    }
    @keyframes rp-glow {
      0%, 100% { opacity: 0.4; filter: blur(12px); }
      50% { opacity: 0.7; filter: blur(18px); }
    }
    
    .rp-card-frame {
      position: absolute; inset: 0;
      background: #000;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(192, 132, 252, 0.3);
    }
    .rp-card-frame iframe {
      width: 100%; height: 100%;
      border: 0; display: block;
    }

    /* ═══ DOUBLE TAP HEART ═══ */
    .rp-doubletap-heart {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0);
      width: 100px; height: 100px;
      color: #ff2d55;
      pointer-events: none;
      z-index: 20;
      filter: drop-shadow(0 0 30px rgba(255, 45, 85, 0.9));
    }
    .rp-doubletap-heart svg { width: 100%; height: 100%; }
    .rp-doubletap-heart.pop { animation: rp-heart-explode 0.9s cubic-bezier(0.34, 1.56, 0.64, 1); }
    @keyframes rp-heart-explode {
      0% { transform: translate(-50%, -50%) scale(0) rotate(-15deg); opacity: 0; }
      30% { transform: translate(-50%, -50%) scale(1.3) rotate(0deg); opacity: 1; }
      60% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
      100% { transform: translate(-50%, -50%) scale(1.5) rotate(0deg); opacity: 0; }
    }

    /* ═══ LOADER ═══ */
    .rp-loader {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 20px;
      background: radial-gradient(circle at center, #1a0f2e 0%, #000 100%);
      z-index: 5;
      transition: opacity 0.5s;
    }
    .rp-loader.hidden { opacity: 0; pointer-events: none; }
    .rp-loader-orbit { position: relative; width: 60px; height: 60px; }
    .rp-loader-dot { position: absolute; width: 14px; height: 14px; border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%); }
    .rp-dot-1 { background: #c084fc; box-shadow: 0 0 15px #c084fc; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    .rp-dot-2 { background: #e879f9; box-shadow: 0 0 15px #e879f9; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite -0.47s; }
    .rp-dot-3 { background: #7dd3fc; box-shadow: 0 0 15px #7dd3fc; animation: rp-orbit 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite -0.93s; }
    @keyframes rp-orbit {
      0% { transform: translate(-50%, -50%) rotate(0deg) translateX(22px) rotate(0deg); }
