  </style>

  <script>
    (function() {
      const root = document.getElementById('reels-root') as HTMLElement;
      if (!root) return;
      
      const videoId = root.dataset.videoid || '';
      const currentVideo: any = (window as any).__REELS_VIDEO__ || null;
      const feedData: any[] = (window as any).__REELS_FEED__ || [];
      const nextId = (window as any).__NEXT_ID__ || '';
      const prevId = (window as any).__PREV_ID__ || '';
      
      // Helpers
      function getThumb(vid: string, existing: string = ''): string {
        if (existing && existing.trim()) return existing;
        if (vid.startsWith('yts_') || vid.startsWith('yt_')) {
          const rawId = vid.replace(/^(yts_|yt_)/, '');
          return `https://i.ytimg.com/vi/${rawId}/hqdefault.jpg`;
        }
        if (vid.startsWith('dm_')) {
          const rawId = vid.replace('dm_', '');
          return `https://www.dailymotion.com/thumbnail/video/${rawId}`;
        }
        return '';
      }
      
      function esc(s: string): string {
        return String(s || '').replace(/[&<>"']/g, (c: string) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c] || c));
      }
      
      function trunc(s: string, n: number): string {
        s = String(s || '');
        return s.length > n ? s.slice(0, n).trim() + '…' : s;
      }
      
      function shuffle<T>(arr: T[]): T[] {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }
      
      function timeAgo(ts: number): string {
        const diff = Date.now() - ts;
        const s = Math.floor(diff / 1000);
        if (s < 60) return 'just now';
        const m = Math.floor(s / 60);
        if (m < 60) return `${m}m ago`;
        const h = Math.floor(m / 60);
        if (h < 24) return `${h}h ago`;
        const d = Math.floor(h / 24);
        return `${d}d ago`;
      }
      
      // WATCH HISTORY
      try {
        if (currentVideo && videoId) {
          const goodThumb = getThumb(videoId, currentVideo.thumbnail);
          const history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
          const filtered = history.filter((h: any) => h.id !== videoId);
          filtered.unshift({
            id: videoId,
            title: currentVideo.title,
            channel: currentVideo.channel,
            thumbnail: goodThumb,
            type: currentVideo.type || 'anime',
            source: currentVideo.source || 'youtube',
            watchedAt: Date.now()
          });
          localStorage.setItem('anitube_history', JSON.stringify(filtered.slice(0, 100)));
        }
      } catch (e) {}
      
      // SAVE
      const saveBtn = document.getElementById('saveBtn');
      const savedVideos: any[] = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      const isSaved = () => savedVideos.some((s: any) => s.id === videoId);
      
      function updateSaveUI() {
        const saved = isSaved();
        if (!saveBtn) return;
        if (saved) {
          saveBtn.classList.add('saved');
          const label = saveBtn.querySelector('.rp-action-label');
          if (label) label.textContent = 'Saved';
        } else {
          saveBtn.classList.remove('saved');
          const label = saveBtn.querySelector('.rp-action-label');
          if (label) label.textContent = 'Save';
        }
      }
      
      function toggleSave() {
        const idx = savedVideos.findIndex((s: any) => s.id === videoId);
        if (idx > -1) {
          savedVideos.splice(idx, 1);
        } else {
          const goodThumb = getThumb(videoId, currentVideo?.thumbnail);
          savedVideos.unshift({
            id: videoId,
            title: currentVideo?.title || 'Video',
            channel: currentVideo?.channel || 'AniTube',
            thumbnail: goodThumb,
            type: currentVideo?.type || 'anime',
            source: currentVideo?.source || 'youtube',
            savedAt: Date.now()
          });
        }
        localStorage.setItem('anitube_saved', JSON.stringify(savedVideos));
        updateSaveUI();
      }
      
      updateSaveUI();
      saveBtn?.addEventListener('click', toggleSave);
      
      // DOUBLE TAP
      const card = document.getElementById('videoCard');
      const doubleTapHeart = document.getElementById('doubleTapHeart');
      let lastTap = 0;
      card?.addEventListener('click', () => {
        const now = Date.now();
        if (now - lastTap < 350) {
          if (!isSaved()) toggleSave();
          if (doubleTapHeart) {
            doubleTapHeart.classList.remove('pop');
            void (doubleTapHeart as HTMLElement).offsetWidth;
            doubleTapHeart.classList.add('pop');
          }
          lastTap = 0;
        } else { lastTap = now; }
      });
      
      // SEND
      const sendBtn = document.getElementById('sendBtn');
      async function handleSend() {
        if (!sendBtn) return;
        const shareData = { title: (currentVideo?.title || 'AniTube Video'), url: window.location.href };
        const isMobile = /mobile|android|iphone|ipad/i.test(navigator.userAgent);
        sendBtn.classList.add('sent');
        setTimeout(() => sendBtn.classList.remove('sent'), 600);
        if (isMobile && (navigator as any).share) {
          try { await (navigator as any).share(shareData); } catch { }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const label = sendBtn.querySelector('.rp-action-label');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => { label.textContent = orig; }, 1800);
            }
          } catch { prompt('Copy this link:', window.location.href); }
        }
      }
      sendBtn?.addEventListener('click', handleSend);
      
      // NAVIGATION
      let navigating = false;
      function navigateTo(targetId: string) {
        if (navigating || !targetId) return;
        navigating = true;
        const c = document.getElementById('videoCard');
        if (c) {
          c.style.opacity = '0';
          c.style.transform = 'scale(0.96)';
          c.style.transition = 'all 0.25s ease';
        }
        setTimeout(() => { window.location.href = `/reels/${targetId}`; }, 220);
      }
      
      document.getElementById('nextBtn')?.addEventListener('click', () => { if (nextId) navigateTo(nextId); });
      document.getElementById('prevBtn')?.addEventListener('click', () => {
        if (prevId) navigateTo(prevId);
        else if (window.history.length > 1) window.history.back();
      });
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'j') { if (nextId) { e.preventDefault(); navigateTo(nextId); } }
        else if (e.key === 'ArrowLeft' || e.key === 'k') { if (prevId) { e.preventDefault(); navigateTo(prevId); } }
      });
      
      // LOADER
      const iframe = document.getElementById('videoFrame') as HTMLIFrameElement;
      const loader = document.getElementById('loader');
      iframe?.addEventListener('load', () => { setTimeout(() => loader?.classList.add('hidden'), 400); });
      setTimeout(() => loader?.classList.add('hidden'), 3500);
      
      // SAFIYA
      setTimeout(() => {
        if (currentVideo) {
          window.dispatchEvent(new CustomEvent('safiya:video-event', {
            detail: { action: 'watch', video: currentVideo }
          }));
        }
      }, 500);
      
      // DESCRIPTION TOGGLE
      const descToggle = document.getElementById('descToggle');
      const descContent = document.getElementById('descContent');
      descToggle?.addEventListener('click', () => {
        if (!descContent) return;
        const expanded = descContent.classList.toggle('expanded');
        descToggle.textContent = expanded ? 'Show less' : 'Show more';
      });
      
      // CHAT BUTTON — scroll to chat section
      const chatBtn = document.getElementById('chatBtn');
      const chatSection = document.getElementById('chatSection');
      chatBtn?.addEventListener('click', () => {
        chatSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      
      // Fake online count
      const chatCountEl = document.getElementById('chatCount');
      const chatOnlineEl = document.getElementById('chatOnlineCount');
      if (chatCountEl) {
        const base = 20 + Math.floor(Math.random() * 60);
        chatCountEl.textContent = String(base);
        setInterval(() => {
          const v = Math.floor(Math.random() * 7) - 3;
          chatCountEl.textContent = String(Math.max(15, base + v));
        }, 4000);
      }
      if (chatOnlineEl) {
        const base = 80 + Math.floor(Math.random() * 200);
        chatOnlineEl.textContent = String(base);
        setInterval(() => {
          const v = Math.floor(Math.random() * 15) - 7;
          chatOnlineEl.textContent = String(Math.max(50, base + v));
        }, 5000);
      }
      
      // ═══════════════════════════════════════
      // 💬 CHAT (localStorage based, per video)
      // ═══════════════════════════════════════
      const chatMessages = document.getElementById('chatMessages');
      const chatInput = document.getElementById('chatInput') as HTMLInputElement;
      const chatSend = document.getElementById('chatSend');
      const commentCount = document.getElementById('commentCount');
      const userInitial = document.getElementById('userInitial');
      const CHAT_KEY = `anitube_chat_${videoId}`;
      const USER_KEY = 'anitube_username';
      
      // Get/generate username
      let username = localStorage.getItem(USER_KEY);
      if (!username) {
        const animeNames = ['SakuraFan', 'NarutoKid', 'OtakuHero', 'AnimeVibes', 'MangaLover', 'WeebLife', 'AnimeVIP', 'SenpaiChan', 'KawaiiUser', 'DemonSlayer'];
        const num = Math.floor(Math.random() * 999);
        username = animeNames[Math.floor(Math.random() * animeNames.length)] + '_' + num;
        localStorage.setItem(USER_KEY, username);
      }
      if (userInitial) userInitial.textContent = username.charAt(0).toUpperCase();
      
      // User color (consistent per username)
      function userColor(name: string): string {
        const colors = [
          'linear-gradient(135deg, #c084fc, #e879f9)',
          'linear-gradient(135deg, #7dd3fc, #22d3ee)',
          'linear-gradient(135deg, #f472b6, #ec4899)',
          'linear-gradient(135deg, #fbbf24, #f97316)',
          'linear-gradient(135deg, #34d399, #10b981)',
          'linear-gradient(135deg, #a78bfa, #8b5cf6)',
        ];
        let hash = 0;
        for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
        return colors[Math.abs(hash) % colors.length];
      }
      
      function loadComments(): any[] {
        try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch { return []; }
      }
      
      function saveComments(list: any[]) {
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(list.slice(-200))); } catch {}
      }
      
      function renderMessages() {
        if (!chatMessages) return;
        const list = loadComments();
        if (commentCount) commentCount.textContent = `${list.length} message${list.length !== 1 ? 's' : ''}`;
        
        if (list.length === 0) {
          chatMessages.innerHTML = `
            <div class="rp-chat-empty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.3;">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
              <p>Be the first to comment on this video!</p>
            </div>
          `;
          return;
        }
        
        chatMessages.innerHTML = list.map((m: any) => `
          <div class="rp-chat-msg">
            <div class="rp-chat-msg-avatar" style="background:${userColor(m.name)}">${esc(m.name.charAt(0).toUpperCase())}</div>
            <div class="rp-chat-msg-body">
              <div class="rp-chat-msg-header">
                <span class="rp-chat-msg-name">${esc(m.name)}</span>
                <span class="rp-chat-msg-time">${timeAgo(m.time)}</span>
              </div>
              <div class="rp-chat-msg-text">${esc(m.text)}</div>
            </div>
          </div>
        `).join('');
        
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
      
      function postMessage() {
        if (!chatInput) return;
        const text = chatInput.value.trim();
        if (!text) return;
        const list = loadComments();
        list.push({ name: username, text, time: Date.now() });
        saveComments(list);
        chatInput.value = '';
        renderMessages();
      }
      
      chatSend?.addEventListener('click', postMessage);
      chatInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); postMessage(); }
      });
      
      renderMessages();
      
      // ═══════════════════════════════════════
      // 🎬 SIDEBAR FEED (Up Next)
      // ═══════════════════════════════════════
      const sidebarFeed = document.getElementById('relatedFeed');
      const feedCountEl = document.getElementById('feedCount');
      const feedLoadingEl = document.getElementById('feedLoading');
      
      let sideItems: any[] = feedData.slice();
      let sideRendered = 0;
      let sideTotal = 0;
      
      function makeSidebarItem(v: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = `/reels/${v.id}`;
        el.className = 'rp-si';
        el.style.animationDelay = `${(i % 6) * 40}ms`;
        
        const thumb = getThumb(v.id, v.thumbnail || '');
        const typeLabels: any = { anime: '🎌 ANIME', kdrama: '🇰🇷 KDRAMA', donghua: '🐼 DONGHUA', movies: '🎬 MOVIE' };
        const typeLabel = typeLabels[v.type] || '🎬 VIDEO';
        
        const imgHtml = thumb
          ? `<img src="${esc(thumb)}" alt="${esc(v.title || '')}" loading="lazy" onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))';" />`
          : `<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2));display:flex;align-items:center;justify-content:center;font-size:1.4rem;">📺</div>`;
        
        const chan = (v.channel || 'anitube').replace(/\s+/g, '').toLowerCase().slice(0, 20);
        
        el.innerHTML = `
          <div class="rp-si-thumb">
            ${imgHtml}
            ${v.isNew ? '<div class="rp-si-new">NEW</div>' : ''}
            <div class="rp-si-type">${typeLabel}</div>
          </div>
          <div class="rp-si-info">
            <h3 class="rp-si-title">${esc(trunc(v.title || 'Video', 80))}</h3>
            <div class="rp-si-channel">@${esc(chan)}</div>
          </div>
        `;
        
        return el;
      }
      
      function renderSidebar() {
        if (!sidebarFeed) return;
        const batchSize = 8;
        const end = Math.min(sideRendered + batchSize, sideItems.length);
        for (let i = sideRendered; i < end; i++) {
          sidebarFeed.appendChild(makeSidebarItem(sideItems[i], i));
          sideTotal++;
        }
        sideRendered = end;
        if (feedCountEl) feedCountEl.textContent = String(sideTotal);
      }
      
      renderSidebar();
      
      // ═══════════════════════════════════════
      // 🎨 MORE VIDEOS (home style grid)
      // ═══════════════════════════════════════
      const moreEl = document.getElementById('moreFeed');
      const moreLoadingEl = document.getElementById('moreLoading');
      
      let moreItems: any[] = feedData.slice();
      let moreRendered = 0;
      let productPool: any[] = [];
      let loadingMore = false;
      let cardsSinceProduct = 0;
      
      function makeNaCard(v: any, i: number): HTMLElement {
        const el = document.createElement('a');
        el.href = `/reels/${v.id}`;
        el.className = 'rp-na-card';
        el.style.animationDelay = `${(i % 6) * 40}ms`;
        
        const thumb = getThumb(v.id, v.thumbnail || '');
        const typeLabels: any = { anime: '🎌 ANIME', kdrama: '🇰🇷 KDRAMA', donghua: '🐼 DONGHUA', movies: '🎬 MOVIE' };
        const typeLabel = typeLabels[v.type] || '🎬 VIDEO';
        
        const imgHtml = thumb
          ? `<img src="${esc(thumb)}" alt="${esc(v.title || '')}" loading="lazy" class="rp-na-img" onerror="this.style.display='none';this.parentElement.querySelector('.rp-na-fallback').style.display='flex';" />`
          : '';
        
        const chan = (v.channel || 'anitube').replace(/\s+/g, '').toLowerCase().slice(0, 20);
        
        el.innerHTML = `
          <div class="rp-na-thumb">
            ${imgHtml}
            <div class="rp-na-fallback" style="display:${thumb ? 'none' : 'flex'}">📺</div>
            <div class="rp-na-shine"></div>
            <div class="rp-na-overlay"></div>
            <div class="rp-na-play">
              <div class="rp-na-play-inner">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
            ${v.isNew ? '<div class="rp-na-badge-new">NEW</div>' : ''}
            <div class="rp-na-badge-hd">HD</div>
            <div class="rp-na-badge-type">${typeLabel}</div>
          </div>
          <div class="rp-na-meta">
            <h3 class="rp-na-title">${esc(trunc(v.title || 'Video', 70))}</h3>
            <div class="rp-na-channel">@${esc(chan)}</div>
          </div>
        `;
        
        return el;
      }
      
      function makeProductRow(products: any[]): HTMLElement {
        const row = document.createElement('div');
        row.className = 'rp-fp-row';
        row.style.gridColumn = '1 / -1';
        
        const items = products.slice(0, 8).map(p => {
          const img = p.image
            ? `<img src="${esc(p.image)}" alt="${esc(p.title || '')}" loading="lazy" onerror="this.style.display='none'" />`
            : '';
          return `
            <a href="/product/${esc(p.id)}" class="rp-fp-item">
              <div class="rp-fp-thumb">${img}</div>
              <div class="rp-fp-title">${esc(trunc(p.title || '', 30))}</div>
              <div class="rp-fp-price">${esc(p.price || '')}</div>
            </a>
          `;
        }).join('');
        
        row.innerHTML = `
          <div class="rp-fp-header">✨ Recommended For You</div>
          <div class="rp-fp-scroll">${items}</div>
        `;
        
        return row;
      }
      
      function renderMoreBatch() {
        if (!moreEl) return;
        const batchSize = 6;
        const end = Math.min(moreRendered + batchSize, moreItems.length);
        
        for (let i = moreRendered; i < end; i++) {
          moreEl.appendChild(makeNaCard(moreItems[i], i));
          cardsSinceProduct++;
          
          if (cardsSinceProduct >= 6 && productPool.length > 0) {
            const products = shuffle(productPool).slice(0, 8);
            moreEl.appendChild(makeProductRow(products));
            cardsSinceProduct = 0;
          }
        }
        
        moreRendered = end;
      }
      
      async function fetchMore() {
        if (loadingMore) return;
        loadingMore = true;
        if (moreLoadingEl) moreLoadingEl.style.display = 'flex';
        
        try {
          const types = ['anime', 'donghua', 'kdrama', 'movies'];
          const type = types[Math.floor(Math.random() * types.length)];
          const page = Math.floor(Math.random() * 5) + 1;
          const res = await fetch(`/api/social-feed?type=${type}&page=${page}&limit=12`);
          const data = await res.json();
          if (data.success && data.videos) {
            const existingIds = new Set(moreItems.map(v => v.id));
            existingIds.add(videoId);
            const fresh = data.videos.filter((v: any) => !existingIds.has(v.id));
            moreItems = moreItems.concat(fresh);
            sideItems = sideItems.concat(fresh);
            renderMoreBatch();
            renderSidebar();
          }
        } catch (e) {}
        
        if (moreLoadingEl) moreLoadingEl.style.display = 'none';
        loadingMore = false;
      }
      
      async function loadProducts() {
        try {
          const res = await fetch('/api/products?limit=30');
          const data = await res.json();
          if (data.success && data.products) productPool = data.products;
        } catch (e) {}
      }
      
      loadProducts().then(() => { renderMoreBatch(); });
      
      // INFINITE SCROLL
      let scrollTimer: any = null;
      window.addEventListener('scroll', () => {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          if (loadingMore) return;
          const bottom = window.scrollY + window.innerHeight;
          const height = document.documentElement.scrollHeight;
          if (bottom > height - 800) {
            if (moreRendered < moreItems.length) renderMoreBatch();
            else fetchMore();
          }
        }, 150);
      }, { passive: true });
      
    })();
  </script>
</ImmersiveLayout>
