---
export const prerender = false;

import ImmersiveLayout from '../../layouts/ImmersiveLayout.astro';

const { id } = Astro.params;
const videoId = id || '';
---

<ImmersiveLayout title="Reels · AniTubeBuzz">
  <div class="rp-root" data-video-id={videoId}>
    <div class="rp-bg" id="rpBg"></div>
    <div class="rp-bg-overlay"></div>

    <header class="rp-header">
      <button class="rp-icon-btn" id="rpBack" aria-label="Back">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="rp-brand">AniTube<span>Buzz</span></div>
      <div class="rp-counter" id="rpCounter">1 / 1</div>
    </header>

    <button class="rp-nav rp-nav-up" id="rpUp" aria-label="Previous">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>
    <button class="rp-nav rp-nav-down" id="rpDown" aria-label="Next">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="rp-feed" id="rpFeed">
      <div class="rp-loading" id="rpLoading"><div class="rp-spinner"></div></div>
    </div>

    <div class="rp-toast" id="rpToast"></div>
  </div>
</ImmersiveLayout>

<style>
  .rp-root {
    position: fixed;
    inset: 0;
    background: #000;
    color: #fff;
    z-index: 100;
    font-family: 'Inter', 'DM Sans', sans-serif;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
  }

  .rp-bg {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(50px) brightness(0.35) saturate(1.3);
    transform: scale(1.2);
    transition: background-image 0.6s ease;
    z-index: 1;
    will-change: background-image;
  }
  .rp-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.85) 100%);
    z-index: 2;
    pointer-events: none;
  }

  .rp-header {
    position: absolute;
    top: 0; left: 0; right: 0;
    padding: 16px 22px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 200;
    pointer-events: none;
    box-sizing: border-box;
  }
  .rp-icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.12);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s ease;
    padding: 0;
    pointer-events: auto;
  }
  .rp-icon-btn:hover {
    background: rgba(192,132,252,0.35);
    border-color: rgba(192,132,252,0.6);
    transform: scale(1.06);
  }
  .rp-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
    pointer-events: auto;
  }
  .rp-brand span {
    color: #fff;
    -webkit-text-fill-color: #fff;
  }
  .rp-counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.08em;
    padding: 6px 12px;
    background: rgba(0,0,0,0.55);
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    pointer-events: auto;
  }

  .rp-nav {
    position: absolute;
    right: 30px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(20,20,30,0.75);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s ease;
    padding: 0;
    z-index: 150;
  }
  .rp-nav:hover {
    background: rgba(192,132,252,0.45);
    transform: scale(1.1);
  }
  .rp-nav-up { top: calc(50% - 55px); }
  .rp-nav-down { top: calc(50% + 25px); }

  .rp-feed {
    position: absolute;
    inset: 0;
    z-index: 10;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .rp-feed::-webkit-scrollbar { display: none; width: 0; }

  .rp-item {
    height: 100vh;
    height: 100dvh;
    width: 100vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  /* ═══ INSTAGRAM-STYLE CARD ═══ */
  .rp-card {
    position: relative;
    height: min(88vh, calc(100vh - 80px));
    aspect-ratio: 9 / 16;
    max-width: min(90vw, 460px);
    background: #0a0517;
    border-radius: 20px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.85);
  }

  /* Gradient glow border */
  .rp-card::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 23px;
    background: linear-gradient(135deg,
      rgba(192,132,252,0.9) 0%,
      rgba(232,121,249,0.6) 25%,
      rgba(125,211,252,0.9) 50%,
      rgba(232,121,249,0.6) 75%,
      rgba(192,132,252,0.9) 100%);
    background-size: 300% 300%;
    animation: rpGlow 6s ease infinite;
    z-index: -1;
    opacity: 0.65;
    filter: blur(12px);
    pointer-events: none;
  }
  @keyframes rpGlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .rp-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 20px;
    overflow: hidden;
    z-index: 1;
  }
  .rp-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .rp-video-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a0517;
    z-index: 2;
    pointer-events: none;
  }
  .rp-video-loader.hidden { display: none; }

  /* ═══ INSTAGRAM-STYLE INFO OVERLAY (bottom-left) ═══ */
  .rp-info {
    position: absolute;
    left: 14px;
    right: 70px;
    bottom: 14px;
    z-index: 5;
    color: #fff;
    pointer-events: none;
    text-shadow: 0 2px 8px rgba(0,0,0,0.9);
  }
  .rp-info-channel {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rp-info-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255,255,255,0.6);
  }
  .rp-info-title {
    font-size: 0.78rem;
    font-weight: 400;
    color: rgba(255,255,255,0.9);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ═══ INSTAGRAM-STYLE ACTION BUTTONS (right side of card) ═══ */
  .rp-actions {
    position: absolute;
    right: -58px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 15;
  }
  .rp-action {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(20,10,45,0.85);
    border: 1px solid rgba(192,132,252,0.25);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    padding: 0;
    box-shadow: 0 6px 20px rgba(0,0,0,0.5);
  }
  .rp-action:hover {
    background: linear-gradient(135deg, rgba(192,132,252,0.5), rgba(232,121,249,0.4));
    border-color: rgba(232,121,249,0.7);
    transform: scale(1.1);
  }
  .rp-action.liked {
    background: linear-gradient(135deg, #ff3366, #ff0055);
    border-color: #ff3366;
  }
  .rp-action.liked svg { fill: #fff; }

  .rp-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    z-index: 300;
  }
  .rp-loading.hidden { display: none; }
  .rp-spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(192,132,252,0.15);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: rpSpin 0.8s linear infinite;
  }
  @keyframes rpSpin { to { transform: rotate(360deg); } }

  .rp-toast {
    position: fixed;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%) translateY(30px);
    padding: 12px 24px;
    background: rgba(20,10,45,0.95);
    border: 1px solid rgba(192,132,252,0.4);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 500;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34,1.56,0.64,1);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
  }
  .rp-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ═══ MOBILE ═══ */
  @media (max-width: 768px) {
    .rp-card {
      height: 100vh;
      height: 100dvh;
      max-width: 100vw;
      width: 100vw;
      aspect-ratio: unset;
      border-radius: 0;
    }
    .rp-card::before { display: none; }
    .rp-video { border-radius: 0; }
    .rp-nav { display: none; }
    .rp-actions {
      right: 8px;
      bottom: 110px;
    }
    .rp-info {
      left: 14px;
      right: 68px;
      bottom: 90px;
    }
    .rp-header { 
      padding: 12px 14px; 
      height: 56px;
      background: linear-gradient(to bottom, rgba(0,0,0,0.55), transparent);
    }
  }
  @media (max-width: 480px) {
    .rp-icon-btn { width: 38px; height: 38px; }
    .rp-brand { font-size: 0.95rem; }
    .rp-counter { font-size: 0.65rem; padding: 5px 10px; }
    .rp-action { width: 42px; height: 42px; }
  }
</style>

<script is:inline define:vars={{ videoId }}>
(function(){
  var CURRENT_ID = videoId;
  var feedEl = document.getElementById('rpFeed');
  var loadingEl = document.getElementById('rpLoading');
  var bgEl = document.getElementById('rpBg');
  var toastEl = document.getElementById('rpToast');
  var backBtn = document.getElementById('rpBack');
  var upBtn = document.getElementById('rpUp');
  var downBtn = document.getElementById('rpDown');
  var counterEl = document.getElementById('rpCounter');

  if(!feedEl) return;

  var videos = [];
  var currentIdx = 0;
  var seenIds = {};
  var likedIds = {};

  // Load liked from localStorage
  try {
    var saved = localStorage.getItem('reels_liked_v1');
    if(saved) likedIds = JSON.parse(saved) || {};
  } catch(_){}

  function saveLiked(){
    try { localStorage.setItem('reels_liked_v1', JSON.stringify(likedIds)); } catch(_){}
  }

  function toast(msg){
    if(!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastEl._t);
    toastEl._t = setTimeout(function(){ toastEl.classList.remove('show'); }, 1800);
  }

  function updateCounter(){
    if(counterEl) counterEl.textContent = (currentIdx + 1) + ' / ' + videos.length;
  }

  // ═══ SOURCE DETECTION (matches API prefixes) ═══
  function detectSource(id){
    if(!id) return 'youtube';
    if(id.indexOf('dm_') === 0) return 'dailymotion';
    if(id.indexOf('bili_') === 0) return 'bilibili';
    if(id.indexOf('ody_') === 0) return 'odysee';
    if(id.indexOf('rmb_') === 0) return 'rumble';
    if(id.indexOf('yts_') === 0) return 'youtube_shorts';
    if(id.indexOf('yt_') === 0) return 'youtube';
    return 'youtube';
  }
  function stripPrefix(id){
    return id.replace(/^(dm_|bili_|ody_|rmb_|yts_|yt_|anime_)/, '');
  }

  // ═══ PORTRAIT DETECTION ═══
  function isPortrait(v){
    if(!v) return false;
    if(v.aspect === 'portrait') return true;
    if(v.aspect === 'landscape') return false;
    if(v.isShort === true) return true;
    if(v.source === 'youtube_shorts') return true;
    if(v.id && v.id.indexOf('yts_') === 0) return true;
    return false;
  }

  function buildEmbedUrl(v){
    var url = v.embedUrl || '';
    if(!url) return '';
    var sep = url.indexOf('?') === -1 ? '?' : '&';
    if(v.source === 'youtube' || v.source === 'youtube_shorts'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&modestbranding=1&rel=0&playsinline=1';
    } else if(v.source === 'dailymotion'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1&ui-logo=0&ui-start-screen-info=0&sharing-enable=0';
    } else if(v.source === 'bilibili'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&muted=1';
    } else if(v.source === 'odysee'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&muted=1';
    } else if(v.source === 'rumble'){
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1';
    } else {
      if(url.indexOf('autoplay') === -1) url += sep + 'autoplay=1&mute=1';
    }
    return url;
  }

  function esc(s){
    return String(s||'').replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  // ═══ RENDER ITEM (Instagram-style) ═══
  function renderItem(v, idx){
    var el = document.createElement('div');
    el.className = 'rp-item';
    el.dataset.idx = idx;

    var card = document.createElement('div');
    card.className = 'rp-card';

    // Video container
    var videoWrap = document.createElement('div');
    videoWrap.className = 'rp-video';
    videoWrap.setAttribute('data-container', '');

    var loader = document.createElement('div');
    loader.className = 'rp-video-loader';
    loader.innerHTML = '<div class="rp-spinner"></div>';
    videoWrap.appendChild(loader);

    // Info overlay (bottom-left)
    var info = document.createElement('div');
    info.className = 'rp-info';
    var channelName = v.channel || 'AniTube';
    var titleText = v.title || '';
    info.innerHTML =
      '<div class="rp-info-channel">' +
        '<span>@' + esc(channelName.toLowerCase().replace(/\s+/g,'')) + '</span>' +
        (v.isNew ? '<span class="rp-info-dot"></span><span style="color:#c084fc;font-size:0.7rem;">NEW</span>' : '') +
      '</div>' +
      '<div class="rp-info-title">' + esc(titleText) + '</div>';

    // Action buttons (right side)
    var actions = document.createElement('div');
    actions.className = 'rp-actions';

    // Like button
    var isLiked = !!likedIds[v.id];
    var likeBtn = document.createElement('button');
    likeBtn.className = 'rp-action' + (isLiked ? ' liked' : '');
    likeBtn.setAttribute('aria-label', 'Like');
    likeBtn.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="' + (isLiked ? '#fff' : 'none') + '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
    likeBtn.addEventListener('click', function(e){
      e.stopPropagation();
      if(likedIds[v.id]){
        delete likedIds[v.id];
        likeBtn.classList.remove('liked');
        likeBtn.querySelector('svg').setAttribute('fill', 'none');
      } else {
        likedIds[v.id] = true;
        likeBtn.classList.add('liked');
        likeBtn.querySelector('svg').setAttribute('fill', '#fff');
        toast('❤️ Liked');
      }
      saveLiked();
    });

    // Send button
    var sendBtn = document.createElement('button');
    sendBtn.className = 'rp-action';
    sendBtn.setAttribute('aria-label', 'Send');
    sendBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
    sendBtn.addEventListener('click', function(e){
      e.stopPropagation();
      var url = window.location.origin + '/reels/' + encodeURIComponent(v.id);
      if(navigator.share){ 
        navigator.share({title: v.title || 'Video', url: url}).catch(function(){}); 
      } else { 
        try{ 
          navigator.clipboard.writeText(url); 
          toast('🔗 Link copied'); 
        }catch(_){ 
          toast('Copy failed'); 
        } 
      }
    });

    actions.appendChild(likeBtn);
    actions.appendChild(sendBtn);

    card.appendChild(videoWrap);
    card.appendChild(info);
    card.appendChild(actions);
    el.appendChild(card);
    return el;
  }

  function activate(idx){
    if(idx < 0 || idx >= videos.length) return;
    var items = feedEl.querySelectorAll('.rp-item');
    items.forEach(function(item, i){
      var container = item.querySelector('[data-container]');
      if(!container) return;
      if(i === idx){
        if(!container.querySelector('iframe')){
          var v = videos[i];
          var url = buildEmbedUrl(v);
          if(url){
            var iframe = document.createElement('iframe');
            iframe.src = url;
            iframe.setAttribute('frameborder','0');
            iframe.setAttribute('allow','accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; fullscreen; web-share; picture-in-picture');
            iframe.setAttribute('allowfullscreen', 'true');
            iframe.addEventListener('load', function(){
              var l = container.querySelector('.rp-video-loader');
              if(l) l.classList.add('hidden');
            });
            container.appendChild(iframe);
          }
        } else {
          var l = container.querySelector('.rp-video-loader');
          if(l) l.classList.add('hidden');
        }
        currentIdx = idx;
        var vv = videos[idx];
        if(vv && vv.thumbnail && bgEl){
          bgEl.style.backgroundImage = 'url(' + vv.thumbnail + ')';
        }
        try{
          window.dispatchEvent(new CustomEvent('safiya:video-event', { detail: { action: 'watch', video: vv } }));
        }catch(_){}
        updateCounter();
      } else {
        // Free memory for far items
        if(Math.abs(i - idx) > 1){ 
          var ifr = container.querySelector('iframe');
          if(ifr) ifr.remove();
          var ldr = container.querySelector('.rp-video-loader');
          if(ldr) ldr.classList.remove('hidden');
        }
      }
    });
  }

  function showRedirectScreen(){
    if(loadingEl){
      loadingEl.innerHTML = 
        '<div style="text-align:center;color:#fff;padding:20px;max-width:340px;">' +
          '<div style="font-size:2.5rem;margin-bottom:14px;">🎬</div>' +
          '<div style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Opening Theater Mode</div>' +
          '<div style="font-size:0.85rem;color:rgba(255,255,255,0.6);margin-bottom:20px;">This video is landscape — better watched full-width</div>' +
          '<div class="rp-spinner" style="margin:0 auto;"></div>' +
        '</div>';
    }
    setTimeout(function(){
      window.location.replace('/watch/' + encodeURIComponent(CURRENT_ID));
    }, 900);
  }

  async function loadFeed(){
    try {
      // ═══ Step 1: Find clicked video metadata ═══
      var clicked = null;
      var types = ['anime','donghua','kdrama','movies'];
      
      // First try WITHOUT format filter (to get any type)
      for(var t = 0; t < types.length && !clicked; t++){
        try {
          var r = await fetch('/api/social-feed?type=' + types[t] + '&limit=50');
          var d = await r.json();
          if(d.success && d.videos){ 
            clicked = d.videos.find(function(v){ return v.id === CURRENT_ID; }); 
          }
        }catch(_){}
      }

      // ═══ Step 2: If landscape → redirect ═══
      if(clicked && !isPortrait(clicked)){
        showRedirectScreen();
        return;
      }

      // ═══ Step 3: No metadata? Check by ID prefix ═══
      if(!clicked){
        var src = detectSource(CURRENT_ID);
        // Only yts_ (YouTube Shorts) is guaranteed portrait from ID alone
        // For dm_, bili_, ody_, rmb_, yt_ — we don't know without metadata
        if(src !== 'youtube_shorts'){
          // Safer to send to /watch/ page
          showRedirectScreen();
          return;
        }
        // Build minimal fallback for YT Shorts
        var raw = stripPrefix(CURRENT_ID);
        clicked = {
          id: CURRENT_ID,
          title: 'Video',
          channel: 'Shorts',
          thumbnail: 'https://i.ytimg.com/vi/' + raw + '/hqdefault.jpg',
          embedUrl: 'https://www.youtube.com/embed/' + raw + '?rel=0&modestbranding=1&playsinline=1&loop=1&playlist=' + raw,
          source: 'youtube_shorts',
          aspect: 'portrait',
          isShort: true
        };
      }

      // ═══ Step 4: Build feed — only portrait ═══
      videos = [clicked];
      seenIds[clicked.id] = true;

      // Fetch ONLY portrait format from all types
      var loaders = [
        '/api/social-feed?type=anime&limit=50&format=portrait',
        '/api/social-feed?type=donghua&limit=50&format=portrait',
        '/api/social-feed?type=kdrama&limit=30&format=portrait',
        '/api/social-feed?type=movies&limit=30&format=portrait'
      ];
      for(var i = 0; i < loaders.length; i++){
        try {
          var rr = await fetch(loaders[i]);
          var dd = await rr.json();
          if(dd.success && dd.videos){
            dd.videos.forEach(function(v){
              if(!seenIds[v.id] && isPortrait(v)){ 
                videos.push(v); 
                seenIds[v.id] = true; 
              }
            });
          }
        }catch(_){}
      }

      // Shuffle related videos (keep clicked as first)
      var first = videos.shift();
      for(var s = videos.length - 1; s > 0; s--){
        var j = Math.floor(Math.random() * (s + 1));
        var tmp = videos[s]; videos[s] = videos[j]; videos[j] = tmp;
      }
      videos.unshift(first);

      // Render
      feedEl.innerHTML = '';
      videos.forEach(function(v, i){ feedEl.appendChild(renderItem(v, i)); });

      if(loadingEl) loadingEl.classList.add('hidden');
      
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){
          activate(0);
          feedEl.scrollTop = 0;
        });
      });

    } catch(err){
      console.error('[reels]', err);
      if(loadingEl){
        loadingEl.innerHTML = '<div style="text-align:center;color:#fff;padding:20px;"><div style="font-size:2rem;margin-bottom:10px;">😔</div><div>Failed to load</div><button id="rpErrBack" style="margin-top:20px;padding:10px 20px;background:rgba(192,132,252,0.3);border:1px solid rgba(192,132,252,0.6);color:#fff;border-radius:8px;cursor:pointer;">Go Home</button></div>';
        var eb = document.getElementById('rpErrBack');
        if(eb) eb.addEventListener('click', goBack);
      }
    }
  }

  var scrollTimer;
  feedEl.addEventListener('scroll', function(){
    if(scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function(){
      var idx = Math.round(feedEl.scrollTop / window.innerHeight);
      if(idx !== currentIdx && idx >= 0 && idx < videos.length){ 
        activate(idx); 
      }
    }, 120);
  }, { passive: true });

  function scrollTo(idx){
    if(idx < 0 || idx >= videos.length) return;
    feedEl.scrollTo({ top: idx * window.innerHeight, behavior: 'smooth' });
  }
  if(upBtn) upBtn.addEventListener('click', function(){ scrollTo(currentIdx - 1); });
  if(downBtn) downBtn.addEventListener('click', function(){ scrollTo(currentIdx + 1); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowDown' || e.key === 'j'){ e.preventDefault(); scrollTo(currentIdx + 1); }
    else if(e.key === 'ArrowUp' || e.key === 'k'){ e.preventDefault(); scrollTo(currentIdx - 1); }
    else if(e.key === 'Escape'){ goBack(); }
  });

  function goBack(){
    window.location.href = '/';
  }
  if(backBtn) backBtn.addEventListener('click', goBack);

  loadFeed();
})();
</script>
