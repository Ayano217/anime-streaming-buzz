---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Reels" description="Instagram-style shorts on AniTube Buzz.">

  <div class="rp-app">

    <!-- LOADER -->
    <div id="rpLoader" class="rp-loader">
      <div class="lo-orb"><div class="lo-ring"></div><div class="lo-core"></div></div>
      <p>Loading reels...</p>
    </div>

    <!-- NOT FOUND -->
    <div id="rpNotFound" class="rp-nf" style="display:none;">
      <div class="nf-ic">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </div>
      <h1>No Reels Available</h1>
      <p>No portrait shorts found for this video.</p>
      <a href="/" class="nf-bk">← Back to Homepage</a>
    </div>

    <!-- REELS CONTAINER -->
    <div id="rpMain" class="rp-main" style="display:none;">

      <!-- TOP BAR -->
      <div class="rp-top">
        <button class="rp-icon-btn" id="rpBack" aria-label="Back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <div class="rp-brand">
          <span class="rp-brand-grad">Ani</span><span class="rp-brand-w">Tube</span><span class="rp-brand-grad">Buzz</span>
        </div>
        <div class="rp-menu-wrap">
          <button class="rp-icon-btn" id="rpMenuBtn" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
          </button>
          <div class="rp-menu" id="rpMenu">
            <button class="rp-menu-item" data-action="copy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Link</span>
            </button>
            <button class="rp-menu-item" data-action="report">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              <span>Not Interested</span>
            </button>
          </div>
        </div>
      </div>

      <!-- VERTICAL SCROLLER -->
      <div id="rpScroller" class="rp-scroller"></div>

      <!-- SIDE PROGRESS -->
      <div id="rpProgress" class="rp-progress">
        <div class="rp-progress-track"><div class="rp-progress-fill" id="rpProgressFill"></div></div>
        <div class="rp-progress-count" id="rpProgressCount">1 / 1</div>
      </div>

      <!-- SCROLL HINT -->
      <div id="rpHint" class="rp-hint">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        <span>Swipe up for next</span>
      </div>

    </div>

    <!-- TOAST -->
    <div id="rpToast" class="rp-toast"></div>

  </div>

</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('rpLoader');
  var notFound = document.getElementById('rpNotFound');
  var main = document.getElementById('rpMain');
  var scroller = document.getElementById('rpScroller');
  var progress = document.getElementById('rpProgress');
  var progressFill = document.getElementById('rpProgressFill');
  var progressCount = document.getElementById('rpProgressCount');
  var hint = document.getElementById('rpHint');
  var back = document.getElementById('rpBack');
  var menuBtn = document.getElementById('rpMenuBtn');
  var menu = document.getElementById('rpMenu');
  var toast = document.getElementById('rpToast');

  var allVideos = [];
  var currentIdx = 0;
  var hintTimeout = null;
  var likedSet = new Set();

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}

  // ═══ TOAST ═══
  function showToast(msg, icon) {
    toast.innerHTML = '<span class="rp-toast-ic">' + (icon || '✓') + '</span><span>' + esc(msg) + '</span>';
    toast.classList.add('rp-toast-show');
    setTimeout(function() { toast.classList.remove('rp-toast-show'); }, 2200);
  }

  // ═══ SMART BACK ═══
  function smartGoBack() {
    var ref = document.referrer;
    var thisOrigin = window.location.origin;
    if (ref && ref.indexOf(thisOrigin) === 0 && ref !== window.location.href) {
      window.history.back();
    } else if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '/';
    }
  }
  back.addEventListener('click', smartGoBack);

  // ═══ MENU ═══
  menuBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    menu.classList.toggle('rp-menu-open');
  });
  document.addEventListener('click', function(e) {
    if (!menuBtn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.remove('rp-menu-open');
    }
  });
  menu.addEventListener('click', function(e) {
    var btn = e.target.closest('.rp-menu-item');
    if (!btn) return;
    var action = btn.dataset.action;
    if (action === 'copy') {
      try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
    } else if (action === 'report') {
      showToast('We\'ll show less of this', '🔕');
    }
    menu.classList.remove('rp-menu-open');
  });

  // ═══ KEYBOARD ═══
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      var next = scroller.querySelector('[data-idx="' + (currentIdx + 1) + '"]');
      if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      var prev = scroller.querySelector('[data-idx="' + (currentIdx - 1) + '"]');
      if (prev) prev.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (e.key === 'Escape') {
      smartGoBack();
    } else if (e.key === 'm' || e.key === 'M') {
      toggleMuteCurrent();
    }
  });

  // ═══ SAVE / LIKE ═══
  function isVideoSaved(vid) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      return saved.some(function(x) { return x.id === vid; });
    } catch(e) { return false; }
  }
  function toggleSave(video, btn) {
    try {
      var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
      var idx = saved.findIndex(function(x) { return x.id === video.id; });
      if (idx >= 0) {
        saved.splice(idx, 1);
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (btn) btn.classList.remove('rp-saved');
        showToast('Removed', '✕');
      } else {
        saved.push({
          id: video.id, title: video.title, thumbnail: video.thumbnail,
          channel: video.channel, type: video.type, savedAt: Date.now()
        });
        localStorage.setItem('savedVideos', JSON.stringify(saved));
        if (btn) btn.classList.add('rp-saved');
        showToast('Saved to library', '✓');
        notifySafiya('save', video);
      }
    } catch(e) {}
  }
  function toggleLike(video, btn) {
    if (likedSet.has(video.id)) {
      likedSet.delete(video.id);
      if (btn) btn.classList.remove('rp-liked');
    } else {
      likedSet.add(video.id);
      if (btn) btn.classList.add('rp-liked');
      showToast('Loved it 💜', '💜');
    }
  }

  // ═══ SAFIYA ═══
  function notifySafiya(type, video) {
    try {
      var deviceId = '';
      try { deviceId = localStorage.getItem('safiya_v13:device_id') || ''; } catch(e) {}
      var memoryKey = deviceId ? 'safiya_v13:memory:' + deviceId : null;
      var memRaw = null;
      if (memoryKey) memRaw = localStorage.getItem(memoryKey);
      if (!memRaw) memRaw = localStorage.getItem('safiya_memory');
      var memory = memRaw ? JSON.parse(memRaw) : {};
      if (!memory.behavior) memory.behavior = {};
      if (!memory.behavior.watchHistory) memory.behavior.watchHistory = [];
      if (!memory.behavior.savedVideos) memory.behavior.savedVideos = [];

      var record = {
        id: video.id, title: video.title, type: video.type || 'video',
        channel: video.channel || '', source: video.source || '',
        time: Date.now(), action: type
      };
      if (type === 'save') {
        memory.behavior.savedVideos.unshift(record);
        memory.behavior.savedVideos = memory.behavior.savedVideos.slice(0, 40);
      } else {
        memory.behavior.watchHistory.unshift(record);
        memory.behavior.watchHistory = memory.behavior.watchHistory.slice(0, 40);
      }
      memory.behavior.currentlyWatching = record;
      if (memoryKey) localStorage.setItem(memoryKey, JSON.stringify(memory));
      localStorage.setItem('safiya_memory', JSON.stringify(memory));

      window.dispatchEvent(new CustomEvent('safiya:video-event', {
        detail: { action: type, video: video, title: video.title, type: video.type }
      }));

      if (window.Safiya && typeof window.Safiya.say === 'function') {
        var lines = {
          save: ['saved that? nice pick', 'good taste bestie', 'adding to your library 💜'],
          watch: ['ooh nice reel', 'the vibes ✨', 'obsessed with this one', 'this one hits different']
        };
        var msgList = type === 'save' ? lines.save : lines.watch;
        setTimeout(function() {
          window.Safiya.say(msgList[Math.floor(Math.random() * msgList.length)], 3800);
        }, 500);
      }
    } catch(err) { console.warn('Safiya notify failed:', err); }
  }

  // ═══ BUILD SLOT (9:16 portrait Instagram-style) ═══
  function buildSlot(video, idx) {
    var slot = document.createElement('div');
    slot.className = 'rp-slot';
    slot.dataset.idx = idx;
    slot.dataset.vid = video.id;

    var thumb = video.thumbnail ? '<img src="' + esc(video.thumbnail) + '" alt="" class="rp-slot-bg" loading="lazy" />' : '';

    slot.innerHTML =
      thumb +
      '<div class="rp-slot-tint"></div>' +
      '<div class="rp-slot-frame">' +
        '<div class="rp-slot-video" data-loaded="0"></div>' +
        '<div class="rp-slot-loading"><div class="rp-slot-spinner"></div></div>' +
      '</div>' +
      '<div class="rp-slot-gradient"></div>' +
      '<div class="rp-slot-info">' +
        '<div class="rp-slot-user">' +
          '<div class="rp-slot-avatar"><div class="rp-slot-avatar-inner">▶</div></div>' +
          '<div class="rp-slot-user-text">' +
            '<div class="rp-slot-username">' + esc(video.channel || 'AniTube') + '</div>' +
            '<div class="rp-slot-type">' + esc((video.type || 'video').toUpperCase()) + '</div>' +
          '</div>' +
          '<button class="rp-follow">Follow</button>' +
        '</div>' +
        '<div class="rp-slot-caption">' + esc(video.title || 'Video') + '</div>' +
      '</div>' +
      // Right side action bar (Instagram style)
      '<div class="rp-actions" data-idx="' + idx + '">' +
        '<button class="rp-action" data-act="like" aria-label="Like">' +
          '<div class="rp-action-ic">' +
            '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
          '</div>' +
          '<span class="rp-action-lbl">Like</span>' +
        '</button>' +
        '<button class="rp-action rp-action-save' + (isVideoSaved(video.id) ? ' rp-saved' : '') + '" data-act="save" aria-label="Save">' +
          '<div class="rp-action-ic">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
          '</div>' +
          '<span class="rp-action-lbl">Save</span>' +
        '</button>' +
        '<button class="rp-action" data-act="share" aria-label="Share">' +
          '<div class="rp-action-ic">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>' +
          '</div>' +
          '<span class="rp-action-lbl">Share</span>' +
        '</button>' +
        '<button class="rp-action rp-action-mute" data-act="mute" aria-label="Toggle sound">' +
          '<div class="rp-action-ic">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>' +
          '</div>' +
          '<span class="rp-action-lbl">Sound</span>' +
        '</button>' +
      '</div>';

    // Bind actions
    var actions = slot.querySelectorAll('.rp-action');
    actions.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var act = btn.dataset.act;
        if (act === 'like') toggleLike(video, btn);
        else if (act === 'save') toggleSave(video, btn);
        else if (act === 'share') {
          try { navigator.clipboard.writeText(window.location.href); showToast('Link copied', '✓'); } catch(e) {}
        } else if (act === 'mute') {
          toggleMuteCurrent();
        }
      });
    });

    return slot;
  }

  // ═══ LOAD IFRAME ═══
  function loadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded === '1') return;
    videoDiv.dataset.loaded = '1';

    var video = allVideos[idx];
    if (!video || !video.embedUrl) return;

    var embedUrl = video.embedUrl;
    // Add autoplay+mute for reels feel
    if (video.source === 'youtube' || video.source === 'youtube_shorts') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&modestbranding=1&rel=0&showinfo=0&playsinline=1&loop=1&playlist=' + (video.videoId || '');
    } else if (video.source === 'dailymotion') {
      embedUrl += (embedUrl.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1&ui-logo=0';
    }

    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;fullscreen');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('playsinline', '');
    iframe.onload = function() {
      if (loading) loading.style.opacity = '0';
      setTimeout(function() { if (loading) loading.style.display = 'none'; }, 400);
    };
    videoDiv.appendChild(iframe);
  }

  function unloadVideoInSlot(idx) {
    var slot = scroller.querySelector('[data-idx="' + idx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var loading = slot.querySelector('.rp-slot-loading');
    if (!videoDiv || videoDiv.dataset.loaded !== '1') return;
    videoDiv.dataset.loaded = '0';
    videoDiv.innerHTML = '';
    if (loading) { loading.style.display = 'flex'; loading.style.opacity = '1'; }
  }

  function toggleMuteCurrent() {
    // We can't directly control YouTube/Dailymotion iframe audio without postMessage
    // But we can reload the iframe with different mute param
    var slot = scroller.querySelector('[data-idx="' + currentIdx + '"]');
    if (!slot) return;
    var videoDiv = slot.querySelector('.rp-slot-video');
    var iframe = videoDiv.querySelector('iframe');
    if (!iframe) return;
    var currentSrc = iframe.src;
    var isMuted = /[?&]mute=1/.test(currentSrc);
    var newSrc = isMuted
      ? currentSrc.replace(/([?&])mute=1/g, '$1mute=0')
      : currentSrc.replace(/([?&])mute=0/g, '$1mute=1');
    iframe.src = newSrc;
    showToast(isMuted ? '🔊 Sound on' : '🔇 Muted', isMuted ? '🔊' : '🔇');
  }

  // ═══ SET CURRENT ═══
  var currentNotifyTimeout = null;
  function setCurrentIdx(newIdx) {
    if (newIdx < 0 || newIdx >= allVideos.length || newIdx === currentIdx) return;
    currentIdx = newIdx;

    try {
      var v = allVideos[newIdx];
      if (v) {
        window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
        document.title = (v.title || 'Reel') + ' · AniTubeBuzz';
      }
    } catch(e) {}

    // Load nearby, unload far
    for (var i = 0; i < allVideos.length; i++) {
      if (Math.abs(i - newIdx) <= 1) loadVideoInSlot(i);
      else if (Math.abs(i - newIdx) > 2) unloadVideoInSlot(i);
    }

    clearTimeout(currentNotifyTimeout);
    currentNotifyTimeout = setTimeout(function() {
      if (allVideos[newIdx]) notifySafiya('watch', allVideos[newIdx]);
    }, 2000);

    updateProgress();
  }

  function updateProgress() {
    if (!progress || !allVideos.length) return;
    var pct = ((currentIdx + 1) / allVideos.length) * 100;
    if (progressFill) progressFill.style.height = pct + '%';
    if (progressCount) progressCount.textContent = (currentIdx + 1) + ' / ' + allVideos.length;
  }

  // ═══ OBSERVER ═══
  var slotObserver = null;
  function setupObserver() {
    if (slotObserver) slotObserver.disconnect();
    slotObserver = new IntersectionObserver(function(entries) {
      var mostVisible = null, maxRatio = 0;
      entries.forEach(function(entry) {
        if (entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          mostVisible = entry.target;
        }
      });
      if (mostVisible && maxRatio > 0.6) {
        var idx = parseInt(mostVisible.dataset.idx);
        if (!isNaN(idx) && idx !== currentIdx) setCurrentIdx(idx);
      }
    }, { root: scroller, threshold: [0.3, 0.6, 0.9] });

    scroller.querySelectorAll('.rp-slot').forEach(function(s) { slotObserver.observe(s); });
  }

  // ═══ HINT ═══
  function scheduleHintHide() {
    hintTimeout = setTimeout(function() {
      if (hint) hint.classList.add('rp-hint-hide');
    }, 4000);
  }
  scroller.addEventListener('scroll', function() {
    if (hint && !hint.classList.contains('rp-hint-hide')) {
      hint.classList.add('rp-hint-hide');
      clearTimeout(hintTimeout);
    }
  }, { passive: true });

  // ═══ DETECT PORTRAIT ═══
  function isPortrait(video) {
    if (!video) return false;
    if (video.aspect === 'portrait') return true;
    if (video.source === 'youtube_shorts' || video.source === 'tiktok' || video.source === 'instagram') return true;
    if (video.isShort === true) return true;
    var title = (video.title || '').toLowerCase();
    if (/#shorts?\b|\bshorts?\b|\breels?\b/i.test(title)) return true;
    if (video.duration && video.duration > 0 && video.duration < 90) return true;
    return false;
  }

  // ═══ INIT ═══
  async function init() {
    try {
      var fetched = [];
      var found = null;

      // Try to fetch with format=portrait first for better results
      try {
        var res1 = await fetch('/api/social-feed?format=portrait&page=1&limit=30');
        if (res1.ok) {
          var data1 = await res1.json();
          if (data1.success && data1.videos) {
            fetched = fetched.concat(data1.videos);
          }
        }
      } catch(e) {}

      // Also fetch general to find current video (in case it's not in portrait feed)
      for (var i = 1; i <= 2; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=25');
          if (!res.ok) continue;
          var data = await res.json();
          if (data.success && data.videos) {
            fetched = fetched.concat(data.videos);
            if (!found) found = data.videos.find(function(v) { return v.id === id; });
          }
        } catch(e) {}
      }

      // Find current video in fetched
      if (!found) found = fetched.find(function(v) { return v.id === id; });

      // Dedupe
      var seen = {};
      var uniqueAll = fetched.filter(function(v) {
        if (!v || !v.id || seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });

      // Only portrait videos (or current video if landscape — still show it)
      var portraitVideos = uniqueAll.filter(isPortrait);

      // If current isn't in portrait list, add it (edge case)
      if (found && !portraitVideos.find(function(v) { return v.id === found.id; })) {
        portraitVideos.unshift(found);
      }

      if (portraitVideos.length === 0) {
        loader.style.display = 'none';
        notFound.style.display = 'flex';
        return;
      }

      // Move current video to top
      if (found) {
        var idx = portraitVideos.findIndex(function(v) { return v.id === found.id; });
        if (idx > 0) {
          var arr = portraitVideos.splice(idx, 1);
          portraitVideos.unshift(arr[0]);
        }
      }

      allVideos = portraitVideos;

      // Build slots
      scroller.innerHTML = '';
      allVideos.forEach(function(v, i) { scroller.appendChild(buildSlot(v, i)); });

      // Hide loader, show main
      loader.style.display = 'none';
      main.style.display = 'block';
      if (hint) hint.classList.add('rp-hint-show');
      scheduleHintHide();

      // Init current
      currentIdx = -1;
      setCurrentIdx(0);
      setupObserver();

    } catch(err) {
      console.error('[Reels]', err);
      loader.style.display = 'none';
      notFound.style.display = 'flex';
    }
  }

  init();
})();
</script>

<style is:global>
  /* Full black on reels page */
  body:has(.rp-app) {
    background: #000 !important;
    overflow: hidden !important;
  }
  body:has(.rp-app) .site-header,
  body:has(.rp-app) header,
  body:has(.rp-app) footer,
  body:has(.rp-app) #btt,
  body:has(.rp-app) #back-to-top,
  body:has(.rp-app) .back-to-top {
    display: none !important;
    visibility: hidden !important;
  }
  body:has(.rp-app) main {
    padding: 0 !important;
    margin: 0 !important;
    background: #000 !important;
  }
</style>

<style>
  /* ═══════════════════════════════════════════════
     🎬 REELS APP
  ═══════════════════════════════════════════════ */
  .rp-app {
    position: fixed;
    inset: 0;
    background: #000;
    color: #fff;
    z-index: 500;
    font-family: 'Inter', 'DM Sans', -apple-system, sans-serif;
    overflow: hidden;
  }

  /* LOADER */
  .rp-loader, .rp-nf {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: #000;
    color: #fff;
    z-index: 400;
    padding: 2rem;
    text-align: center;
  }
  .lo-orb {
    position: relative;
    width: 50px; height: 50px;
  }
  .lo-core {
    position: absolute; inset: 15%; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    box-shadow: 0 0 20px rgba(192,132,252,.6);
    animation: rpLoPu 1s ease infinite;
  }
  .lo-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgba(192,132,252,.6);
    animation: rpLoEx 1.2s ease-out infinite;
  }
  @keyframes rpLoEx { 0%{transform:scale(.5);opacity:1} 100%{transform:scale(1.5);opacity:0} }
  @keyframes rpLoPu { 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
  .rp-loader p {
    color: rgba(255,255,255,.55);
    font-family: 'JetBrains Mono', monospace;
    font-size: .82rem;
    margin: 0;
  }
  .nf-ic { color: #c084fc; }
  .rp-nf h1 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.8rem; margin: 0;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .rp-nf p { color: rgba(255,255,255,.6); max-width: 400px; margin: 0; }
  .nf-bk {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 12px 24px; text-decoration: none;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    color: #fff; border-radius: 999px; font-weight: 700;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: .9rem;
    box-shadow: 0 8px 24px rgba(192,132,252,.4);
    transition: transform .2s ease;
  }
  .nf-bk:hover { transform: translateY(-2px); }

  /* MAIN */
  .rp-main { position: relative; height: 100vh; height: 100dvh; }

  /* TOP BAR */
  .rp-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,.4) 70%, transparent);
    pointer-events: none;
  }
  .rp-icon-btn {
    pointer-events: auto;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.1);
    color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all .2s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0;
    font-family: inherit;
  }
  .rp-icon-btn:hover { background: rgba(255,255,255,.18); transform: scale(1.06); }
  .rp-icon-btn:active { transform: scale(0.94); }

  .rp-brand {
    text-align: center;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem; font-weight: 800;
    letter-spacing: -.02em;
    text-shadow: 0 2px 12px rgba(0,0,0,.9);
    pointer-events: none;
    white-space: nowrap;
  }
  .rp-brand-grad {
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .rp-brand-w { color: #fff; }

  .rp-menu-wrap {
    position: relative;
    pointer-events: auto;
    justify-self: end;
  }
  .rp-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 200px;
    padding: 6px;
    background: rgba(20, 12, 32, 0.98);
    border: 1px solid rgba(192, 132, 252, 0.28);
    border-radius: 14px;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.7),
      0 0 30px rgba(192, 132, 252, 0.18);
    backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(.95);
    transform-origin: top right;
    transition: all .25s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 200;
  }
  .rp-menu-open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
  .rp-menu-item {
    display: flex; align-items: center; gap: 10px;
    width: 100%; padding: 10px 12px;
    background: transparent; border: none; color: #f5ecff;
    font-family: 'Inter', sans-serif; font-size: .87rem; font-weight: 500;
    cursor: pointer; border-radius: 8px;
    transition: all .15s ease; text-align: left;
  }
  .rp-menu-item:hover { background: rgba(192, 132, 252, 0.15); color: #e879f9; }
  .rp-menu-item svg { color: rgba(255, 255, 255, 0.7); flex-shrink: 0; }
  .rp-menu-item:hover svg { color: #e879f9; }

  /* SCROLLER */
  .rp-scroller {
    position: absolute;
    inset: 0;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-stop: always;
    contain: strict;
  }
  .rp-scroller::-webkit-scrollbar { display: none; }

  /* SLOT */
  .rp-slot {
    position: relative;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    contain: layout paint;
  }
  .rp-slot-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: blur(40px) brightness(.35) saturate(1.4);
    transform: scale(1.15);
  }
  .rp-slot-tint {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,.7) 100%);
  }
  .rp-slot-frame {
    position: relative;
    z-index: 5;
    width: min(430px, calc((100dvh - 40px) * 9 / 16));
    aspect-ratio: 9 / 16;
    max-height: calc(100dvh - 20px);
    background: #000;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 30px 80px rgba(0,0,0,.9),
      0 0 60px rgba(192,132,252,.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rp-slot-video {
    width: 100%; height: 100%;
    background: #000;
    position: relative;
  }
  .rp-slot-video iframe {
    width: 100%; height: 100%;
    border: 0; background: #000; display: block;
  }
  .rp-slot-loading {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 6;
    pointer-events: none;
    transition: opacity .4s ease;
  }
  .rp-slot-spinner {
    width: 42px; height: 42px;
    border: 3px solid rgba(255,255,255,.15);
    border-top-color: #e879f9;
    border-right-color: #c084fc;
    border-radius: 50%;
    animation: rpLoEx 0.9s linear infinite;
    animation-name: rpSpin;
  }
  @keyframes rpSpin { to { transform: rotate(360deg); } }

  .rp-slot-gradient {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 200px; z-index: 8; pointer-events: none;
    background: linear-gradient(0deg, rgba(0,0,0,.9) 20%, rgba(0,0,0,.4) 60%, transparent);
  }

  /* Bottom info */
  .rp-slot-info {
    position: absolute;
    left: 20px;
    right: 90px;
    bottom: 30px;
    z-index: 10;
    max-width: 500px;
    pointer-events: auto;
  }
  .rp-slot-user {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 12px;
  }
  .rp-slot-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    padding: 2px; flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(192,132,252,.4);
  }
  .rp-slot-avatar-inner {
    width: 100%; height: 100%; border-radius: 50%;
    background: #0a0a0a;
    display: flex; align-items: center; justify-content: center;
    color: #e879f9; font-size: .85rem; padding-left: 2px;
  }
  .rp-slot-user-text { flex: 1; min-width: 0; }
  .rp-slot-username {
    font-family: 'Inter', sans-serif;
    font-size: .92rem; font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 8px rgba(0,0,0,.9);
    line-height: 1.15;
    letter-spacing: -.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rp-slot-type {
    font-family: 'Inter', sans-serif;
    font-size: .58rem; font-weight: 700;
    color: #e879f9;
    text-shadow: 0 2px 6px rgba(0,0,0,.9);
    letter-spacing: .1em;
    margin-top: 3px;
    line-height: 1;
  }
  .rp-follow {
    padding: 6px 14px;
    background: transparent;
    border: 1.5px solid #fff;
    color: #fff;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: .72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s ease;
    flex-shrink: 0;
  }
  .rp-follow:hover {
    background: linear-gradient(135deg, #c084fc, #e879f9);
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(192,132,252,.4);
  }
  .rp-slot-caption {
    font-family: 'Inter', sans-serif;
    font-size: .88rem; font-weight: 500;
    color: #fff;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 8px rgba(0,0,0,.95);
    letter-spacing: -.005em;
  }

  /* RIGHT ACTIONS (Instagram style) */
  .rp-actions {
    position: absolute;
    right: 12px;
    bottom: 30px;
    z-index: 12;
    display: flex;
    flex-direction: column;
    gap: 16px;
    pointer-events: auto;
  }
  .rp-action {
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 4px;
    transition: transform .2s ease;
    font-family: inherit;
  }
  .rp-action:hover { transform: scale(1.1); }
  .rp-action:active { transform: scale(0.9); }
  .rp-action-ic {
    width: 46px; height: 46px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all .25s ease;
  }
  .rp-action:hover .rp-action-ic {
    background: rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .rp-action-lbl {
    font-family: 'Inter', sans-serif;
    font-size: .62rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 6px rgba(0,0,0,.95);
    letter-spacing: .02em;
  }
  .rp-action.rp-liked .rp-action-ic {
    background: rgba(239, 68, 68, 0.85);
    border-color: rgba(239, 68, 68, 0.5);
    color: #fff;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
  }
  .rp-action.rp-liked .rp-action-ic svg {
    fill: #fff;
  }
  .rp-action.rp-saved .rp-action-ic {
    background: linear-gradient(135deg, #c084fc, #e879f9);
    border-color: transparent;
    box-shadow: 0 0 20px rgba(232, 121, 249, 0.5);
  }
  .rp-action.rp-saved .rp-action-ic svg {
    fill: #fff;
  }

  /* PROGRESS */
  .rp-progress {
    position: fixed;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 50;
    pointer-events: none;
  }
  .rp-progress-track {
    width: 3px;
    height: 100px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
  }
  .rp-progress-fill {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 20%;
    background: linear-gradient(180deg, #e879f9, #c084fc, #7dd3fc);
    border-radius: 3px;
    transition: height .4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 10px rgba(232, 121, 249, 0.6);
  }
  .rp-progress-count {
    font-family: 'Inter', sans-serif;
    font-size: .58rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: .05em;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
  }

  /* HINT */
  .rp-hint {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: rgba(20, 12, 32, 0.9);
    border: 1px solid rgba(232, 121, 249, 0.3);
    border-radius: 999px;
    color: #f0e8ff;
    font-family: 'Inter', sans-serif;
    font-size: .76rem;
    font-weight: 600;
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    z-index: 60;
    transition: all .4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .rp-hint-show {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    animation: rpHintBounce 2s ease-in-out infinite;
  }
  .rp-hint-hide {
    opacity: 0 !important;
    visibility: hidden !important;
    transform: translateX(-50%) translateY(20px) !important;
    animation: none !important;
  }
  @keyframes rpHintBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-4px); }
  }
  .rp-hint svg {
    color: #e879f9;
    animation: rpHintArrow 1.4s ease-in-out infinite;
  }
  @keyframes rpHintArrow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* TOAST */
  .rp-toast {
    position: fixed;
    top: 78px;
    left: 50%;
    transform: translateX(-50%) translateY(-16px) scale(.9);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: rgba(20, 12, 32, 0.98);
    border: 1px solid rgba(232, 121, 249, 0.4);
    border-radius: 999px;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: .83rem;
    font-weight: 600;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 24px rgba(192, 132, 252, 0.25);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    z-index: 9999;
    transition: all .3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .rp-toast-show {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .rp-toast-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: #fff;
    font-size: .7rem;
    font-weight: 900;
  }

  /* RESPONSIVE */
  @media (max-width: 720px) {
    .rp-top {
      padding: 12px 14px;
      grid-template-columns: 36px 1fr 36px;
      gap: 8px;
    }
    .rp-icon-btn { width: 36px; height: 36px; }
    .rp-brand { font-size: .95rem; }

    .rp-slot-frame {
      width: 100%;
      max-height: 100vh; max-height: 100dvh;
      border-radius: 0;
      box-shadow: none;
    }
    .rp-slot-info {
      left: 14px;
      right: 76px;
      bottom: 24px;
    }
    .rp-slot-username { font-size: .88rem; }
    .rp-slot-caption { font-size: .85rem; }

    .rp-actions {
      right: 10px;
      bottom: 24px;
      gap: 14px;
    }
    .rp-action-ic { width: 42px; height: 42px; }
    .rp-action-lbl { font-size: .58rem; }

    .rp-progress { left: 8px; }
    .rp-progress-track { height: 80px; }

    .rp-hint {
      bottom: 24px;
      padding: 8px 14px;
      font-size: .7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-hint-show,
    .rp-hint svg,
    .rp-slot-spinner,
    .lo-ring,
    .lo-core {
      animation: none !important;
    }
  }
</style>
