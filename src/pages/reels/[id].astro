      color: #c084fc;
    }
    
    /* Autoplay toggle */
    .atbrp-autoplay {
      margin-bottom: 14px;
      padding: 10px 14px;
      background: linear-gradient(135deg, rgba(28, 15, 61, 0.6), rgba(20, 10, 40, 0.4));
      border: 1px solid rgba(192, 132, 252, 0.2);
      border-radius: 12px;
      backdrop-filter: blur(10px);
