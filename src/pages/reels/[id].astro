---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="Watch" description="Watch premium videos">
  <div class="tk-page" id="tkPage">
    
    <!-- Minimal Top Bar -->
    <div class="tk-topbar">
      <a href="/" class="tk-back" aria-label="Back">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div class="tk-logo">
        <span class="grad-text">Ani</span><span style="color:#fff">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <button class="tk-menu-btn" id="tkMenuBtn" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
      </button>
      
      <!-- 3-dot dropdown menu -->
      <div class="tk-menu-dropdown" id="tkMenuDropdown">
        <button class="tk-menu-item" id="tkSaveBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span>Save Video</span>
        </button>
        <button class="tk-menu-item" id="tkCopyBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Copy Link</span>
        </button>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="tk-main">
      
      <!-- Loading -->
      <div id="tkLoader" class="tk-loader">
        <div class="tk-spinner"></div>
        <p>Loading...</p>
      </div>
      
      <!-- Video Stack -->
      <div id="tkStack" class="tk-stack" style="display:none;">
        
        <!-- Current Video Slot -->
        <div class="tk-slot" id="tkSlot">
          
          <!-- Video Player -->
          <div class="tk-video" id="tkVideo">
            <div class="tk-video-loading">
              <div class="tk-spinner"></div>
            </div>
          </div>
          
          <!-- Minimal Bottom Info (auto-hide on inactivity) -->
          <div class="tk-info" id="tkInfo">
            <div class="tk-user">
              <div class="tk-avatar">
                <div class="tk-avatar-inner">▶</div>
              </div>
              <div class="tk-user-text">
                <div class="tk-channel" id="tkChannel">Loading...</div>
                <button class="tk-follow">Follow</button>
              </div>
            </div>
            <div class="tk-caption" id="tkCaption">Loading...</div>
          </div>
          
          <!-- Bottom center: Down arrow for next video -->
          <button class="tk-next-btn" id="tkNextBtn" aria-label="Next video">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
          </button>
        </div>
      </div>
      
      <!-- SAFIYA COMMENT BUBBLE (appears during video) -->
      <div class="tk-safiya" id="tkSafiya" style="display:none;">
        <div class="tk-safiya-avatar">
          <img src="/live2d/safiya/avatar.png" alt="Safiya" onerror="this.style.display='none';this.parentElement.innerHTML='💜';" />
        </div>
        <div class="tk-safiya-bubble" id="tkSafiyaBubble">
          <div class="tk-safiya-name">Safiya</div>
          <div class="tk-safiya-msg" id="tkSafiyaMsg">Watching with you 👀</div>
        </div>
      </div>
      
      <!-- RELATED VIDEOS (TikTok "For You" style) -->
      <div class="tk-related-section" id="tkRelated" style="display:none;">
        <div class="tk-related-header">
          <div class="tk-related-title">✨ For You</div>
          <div class="tk-related-hint">Scroll to explore</div>
        </div>
        <div class="tk-related-grid" id="tkRelatedGrid"></div>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ id }}>
(async function() {
  var loader = document.getElementById('tkLoader');
  var stack = document.getElementById('tkStack');
  var video = document.getElementById('tkVideo');
  var channelEl = document.getElementById('tkChannel');
  var captionEl = document.getElementById('tkCaption');
  var nextBtn = document.getElementById('tkNextBtn');
  var menuBtn = document.getElementById('tkMenuBtn');
  var menuDropdown = document.getElementById('tkMenuDropdown');
  var saveBtn = document.getElementById('tkSaveBtn');
  var copyBtn = document.getElementById('tkCopyBtn');
  var infoEl = document.getElementById('tkInfo');
  var relatedSection = document.getElementById('tkRelated');
  var relatedGrid = document.getElementById('tkRelatedGrid');
  var safiyaEl = document.getElementById('tkSafiya');
  var safiyaMsg = document.getElementById('tkSafiyaMsg');
  var safiyaBubble = document.getElementById('tkSafiyaBubble');
  
  var allVideos = [];
  var currentIdx = 0;
  var safiyaTimeout = null;
  var infoHideTimeout = null;
  
  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
  function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n).trim()+'…':s;}
  
  // ═══ SAFIYA AI — Watches videos with user ═══
  var SAFIYA_REACTIONS = {
    anime: [
      "Ooooh this is fire 🔥",
      "You have good taste btw 👀",
      "Wait this is actually so good",
      "Bestie you're going to love this ✨",
      "The animation tho 😍",
      "Not me watching this too 💜",
      "This gives me such main character energy",
      "Okay but the vibes tho",
    ],
    kdrama: [
      "K-drama time?? Say less 💖",
      "The chemistry is INSANE 🥺",
      "I'm crying and I haven't even watched it yet",
      "Second lead syndrome incoming 😭",
      "This is going to hurt so good 💔",
      "Get the tissues bestie",
    ],
    donghua: [
      "Chinese animation slaps different fr",
      "The art style is unreal 🎨",
      "Cultivation anime hits different",
      "Wait this looks EXPENSIVE",
      "Donghua tier list moment",
    ],
    movies: [
      "Movie night?? I'm in 🍿",
      "This is going to be so cinematic",
      "Bestie you have great taste in movies",
      "I'm here for the plot twist",
      "Waiting for that ONE scene 👀",
    ],
    generic: [
      "Watching with you 👀",
      "You have such good taste",
      "This is giving main character energy ✨",
      "Not me being obsessed",
      "Okay but the vibes tho 💜",
      "I'm invested now",
      "This is a cinematic experience",
      "Bestie... you're onto something",
    ],
  };
  
  function getSafiyaReaction(video) {
    var reactions = SAFIYA_REACTIONS[video.type] || SAFIYA_REACTIONS.generic;
    return reactions[Math.floor(Math.random() * reactions.length)];
  }
  
  function showSafiya(video) {
    if (safiyaTimeout) clearTimeout(safiyaTimeout);
    
    var msg = getSafiyaReaction(video);
    safiyaMsg.textContent = msg;
    safiyaEl.style.display = 'flex';
    
    // Track in Safiya's memory (integrate with main Safiya)
    try {
      var memory = JSON.parse(localStorage.getItem('safiya_memory') || '{}');
      if (!memory.watchHistory) memory.watchHistory = [];
      memory.watchHistory.unshift({
        title: video.title,
        type: video.type,
        watchedAt: Date.now(),
        source: video.source,
      });
      memory.watchHistory = memory.watchHistory.slice(0, 30);
      memory.lastVideoWatched = video.title;
      memory.lastVideoType = video.type;
      localStorage.setItem('safiya_memory', JSON.stringify(memory));
    } catch(e) {}
    
    // Auto-hide after 5s
    safiyaTimeout = setTimeout(function() {
      safiyaBubble.style.opacity = '0';
      setTimeout(function() {
        safiyaEl.style.display = 'none';
        safiyaBubble.style.opacity = '';
      }, 400);
    }, 5000);
  }
  
  // ═══ Load video ═══
  function loadVideoAt(idx) {
    if (!allVideos[idx]) return;
    currentIdx = idx;
    var v = allVideos[idx];
    
    // Update URL
    try {
      window.history.replaceState({}, '', '/reels/' + encodeURIComponent(v.id));
    } catch(e) {}
    
    document.title = (v.title || 'Reel') + ' - AniTube Buzz';
    
    // Loading state
    video.innerHTML = '<div class="tk-video-loading"><div class="tk-spinner"></div></div>';
    
    // Update info
    channelEl.textContent = v.channel || 'Channel';
    captionEl.textContent = v.title || 'Video';
    
    // Build embed URL with cleaner params
    var embedUrl = v.embedUrl;
    if (v.source === 'dailymotion') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'ui-logo=0&ui-start-screen-info=0&sharing-enable=0&autoplay=1&mute=1&queue-enable=0';
    }
    if (v.source === 'youtube') {
      embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'modestbranding=1&showinfo=0&rel=0&autoplay=1&mute=1&controls=1';
    }
    
    setTimeout(function() {
      video.innerHTML = '';
      var iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen');
      iframe.setAttribute('allowfullscreen', '');
      iframe.style.cssText = 'width:100%;height:100%;border:0;position:absolute;top:0;left:0;';
      video.appendChild(iframe);
    }, 150);
    
    // Show Safiya reaction (delayed to feel natural)
    setTimeout(function() { showSafiya(v); }, 3000);
    
    // Update related videos
    renderRelated();
    
    // Reset info visibility
    showInfoTemporarily();
  }
  
  function nextVideo() {
    if (currentIdx < allVideos.length - 1) {
      loadVideoAt(currentIdx + 1);
      // Scroll to top for fresh feel
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (allVideos.length > 0) {
      // Loop back to start
      loadVideoAt(0);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
  
  function prevVideo() {
    if (currentIdx > 0) {
      loadVideoAt(currentIdx - 1);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
  
  // Auto-hide info bar (like TikTok — clean viewing)
  function showInfoTemporarily() {
    if (!infoEl) return;
    infoEl.classList.remove('tk-info-hidden');
    if (infoHideTimeout) clearTimeout(infoHideTimeout);
    infoHideTimeout = setTimeout(function() {
      infoEl.classList.add('tk-info-hidden');
    }, 4000);
  }
  
  // Show info on hover/tap
  document.querySelector('.tk-slot').addEventListener('mousemove', showInfoTemporarily);
  document.querySelector('.tk-slot').addEventListener('touchstart', showInfoTemporarily);
  
  function renderRelated() {
    if (allVideos.length < 2) {
      relatedSection.style.display = 'none';
      return;
    }
    
    var related = allVideos.filter(function(v, i) { return i !== currentIdx; }).slice(0, 12);
    
    relatedGrid.innerHTML = related.map(function(v, i) {
      var img = v.thumbnail ? '<img src="' + esc(v.thumbnail) + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.style.background=\'linear-gradient(135deg,rgba(192,132,252,0.3),rgba(232,121,249,0.2))\';" />' : '';
      var typeLabel = { movies: '🎬 MOVIE', kdrama: '🇰🇷 K-DRAMA', donghua: '🐼 DONGHUA', anime: '🎌 ANIME' }[v.type] || '';
      
      return '<div class="tk-rel-card" data-vid="' + esc(v.id) + '">' +
        '<div class="tk-rel-thumb">' + img +
          '<div class="tk-rel-play">▶</div>' +
          (typeLabel ? '<div class="tk-rel-type">' + typeLabel + '</div>' : '') +
        '</div>' +
        '<div class="tk-rel-info">' +
          '<div class="tk-rel-title">' + esc(trunc(v.title, 45)) + '</div>' +
          '<div class="tk-rel-channel">' + esc(v.channel || 'Channel') + '</div>' +
        '</div>' +
      '</div>';
    }).join('');
    
    relatedSection.style.display = 'block';
    
    // Attach click handlers
    relatedGrid.querySelectorAll('.tk-rel-card').forEach(function(card) {
      card.addEventListener('click', function() {
        var vidId = card.dataset.vid;
        var idx = allVideos.findIndex(function(v) { return v.id === vidId; });
        if (idx >= 0) {
          loadVideoAt(idx);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  }
  
  // ═══ 3-Dot Menu ═══
  menuBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    menuDropdown.classList.toggle('open');
  });
  
  document.addEventListener('click', function(e) {
    if (!menuBtn.contains(e.target) && !menuDropdown.contains(e.target)) {
      menuDropdown.classList.remove('open');
    }
  });
  
  saveBtn.addEventListener('click', function() {
    var v = allVideos[currentIdx];
    if (!v) return;
    var saved = JSON.parse(localStorage.getItem('savedVideos') || '[]');
    var exists = saved.findIndex(function(x) { return x.id === v.id; });
    if (exists >= 0) {
      saved.splice(exists, 1);
      saveBtn.querySelector('span').textContent = 'Save Video';
    } else {
      saved.push({ id: v.id, title: v.title, thumbnail: v.thumbnail, savedAt: Date.now() });
      saveBtn.querySelector('span').textContent = '✓ Saved';
      // Safiya reaction to save
      setTimeout(function() {
        safiyaMsg.textContent = "Ooh saving this for later? Good choice 💜";
        safiyaEl.style.display = 'flex';
        if (safiyaTimeout) clearTimeout(safiyaTimeout);
        safiyaTimeout = setTimeout(function() { safiyaEl.style.display = 'none'; }, 4000);
      }, 500);
    }
    localStorage.setItem('savedVideos', JSON.stringify(saved));
    menuDropdown.classList.remove('open');
  });
  
  copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText(window.location.href).then(function() {
      copyBtn.querySelector('span').textContent = '✓ Copied!';
      setTimeout(function() { copyBtn.querySelector('span').textContent = 'Copy Link'; }, 2000);
    });
    menuDropdown.classList.remove('open');
  });
  
  // ═══ Navigation ═══
  nextBtn.addEventListener('click', nextVideo);
  
  // Keyboard
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown' || e.key === 'j') { e.preventDefault(); nextVideo(); }
    else if (e.key === 'ArrowUp' || e.key === 'k') { e.preventDefault(); prevVideo(); }
    else if (e.key === 'Escape') { window.history.back(); }
    else if (e.key === 'm') { menuBtn.click(); }
  });
  
  // Swipe on mobile
  var touchStartY = 0, touchEndY = 0;
  document.addEventListener('touchstart', function(e) {
    touchStartY = e.changedTouches[0].screenY;
  }, { passive: true });
  document.addEventListener('touchend', function(e) {
    touchEndY = e.changedTouches[0].screenY;
    var diff = touchStartY - touchEndY;
    if (Math.abs(diff) > 80) {
      if (diff > 0) nextVideo();
      else prevVideo();
    }
  }, { passive: true });
  
  // ═══ INIT ═══
  async function init() {
    try {
      // Fetch videos
      var allFetched = [];
      var found = null;
      
      for (var i = 1; i <= 3; i++) {
        try {
          var res = await fetch('/api/social-feed?type=all&page=' + i + '&limit=20');
          var data = await res.json();
          if (data.success && data.videos) {
            allFetched = allFetched.concat(data.videos);
            if (!found) {
              found = data.videos.find(function(v) { return v.id === id; });
            }
          }
        } catch(e) {}
      }
      
      if (!found && allFetched.length > 0) {
        found = allFetched[0];
      }
      
      if (!found) {
        loader.innerHTML = '<h1 style="color:#fff;margin-bottom:1rem;">Video Not Found</h1><a href="/" style="color:#c084fc;font-weight:700;">← Back to Home</a>';
        return;
      }
      
      // Dedupe
      var seen = {};
      allVideos = allFetched.filter(function(v) {
        if (seen[v.id]) return false;
        seen[v.id] = true;
        return true;
      });
      
      var foundIdx = allVideos.findIndex(function(v) { return v.id === found.id; });
      if (foundIdx < 0) {
        allVideos.unshift(found);
        foundIdx = 0;
      }
      
      loader.style.display = 'none';
      stack.style.display = 'block';
      
      loadVideoAt(foundIdx);
    } catch(e) {
      console.error(e);
      loader.innerHTML = '<h1 style="color:#fff;">Error loading video</h1>';
    }
  }
  
  init();
})();
</script>

<style>
  html, body { background: #000 !important; }
  #app { background: #000 !important; }
  main { background: #000 !important; padding: 0 !important; }
  
  .tk-page {
    min-height: 100vh;
    background: #000;
    color: #fff;
    display: flex;
    flex-direction: column;
  }
  
  /* ═══ TOP BAR ═══ */
  .tk-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  .tk-back {
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    transition: all 0.2s ease;
  }
  
  .tk-back:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  
  .tk-logo {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .tk-menu-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    position: relative;
  }
  
  .tk-menu-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  
  /* Menu Dropdown */
  .tk-menu-dropdown {
    position: absolute;
    top: 100%;
    right: 12px;
    margin-top: 8px;
    background: rgba(20, 10, 30, 0.98);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 14px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(192, 132, 252, 0.15);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.25s ease;
    z-index: 200;
  }
  
  .tk-menu-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .tk-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    background: transparent;
    border: none;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s ease;
    text-align: left;
  }
  
  .tk-menu-item:hover {
    background: rgba(192, 132, 252, 0.15);
    color: #e879f9;
  }
  
  .tk-menu-item svg {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  
  .tk-menu-item:hover svg {
    color: #e879f9;
  }
  
  /* ═══ MAIN ═══ */
  .tk-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0 40px;
  }
  
  .tk-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 6rem 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    min-height: 60vh;
  }
  
  .tk-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: tkSpin 0.8s linear infinite;
  }
  
  @keyframes tkSpin { to { transform: rotate(360deg); } }
  
  /* ═══ VIDEO STACK ═══ */
  .tk-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    padding: 0 16px;
  }
  
  /* Video slot - vertical 9:16 like TikTok */
  .tk-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 9/16;
    max-height: calc(100vh - 130px);
    background: #000;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 
      0 30px 80px rgba(0, 0, 0, 0.9),
      0 0 40px rgba(192, 132, 252, 0.15);
  }
  
  .tk-video {
    position: absolute;
    inset: 0;
    background: #000;
  }
  
  .tk-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  
  .tk-video-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }
  
  /* Minimal info bar (auto-hide) */
  .tk-info {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 60px;
    z-index: 10;
    color: #fff;
    transition: opacity 0.4s ease, transform 0.4s ease;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
  }
  
  .tk-info.tk-info-hidden {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }
  
  .tk-user {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  
  .tk-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    padding: 2px;
    flex-shrink: 0;
  }
  
  .tk-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e879f9;
    font-size: 0.9rem;
    padding-left: 2px;
  }
  
