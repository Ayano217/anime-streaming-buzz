      // MULTI-SOURCE EXTERNAL PLAYER
      // Vidsrc.to → 2embed → Vidsrc.xyz → MultiEmbed → AnimoTV
      // ═══════════════════════════════════════════════════════════
      function setupExternalPlayer() {
        var root = document.getElementById('reels-root');
        var wrap = document.getElementById('externalWrap');
        var placeholder = document.getElementById('extPlaceholder');
        var placeholderText = document.getElementById('extPlaceholderText');
        var switcher = document.getElementById('serverSwitcher');
        var serverBtns = document.getElementById('serverBtns');
        if (!root || !wrap) return;

        // Build server list
        var servers = [];

        if (tmdbId && hasMulti) {
          // Best: TMDB-based clean iframes (no crop needed)
          servers.push({
            name: 'Server 1',
            url: 'https://vidsrc.to/embed/tv/' + tmdbId + '/' + seasonNum + '/' + extCurrentEp,
            type: 'clean',
          });
          servers.push({
            name: 'Server 2',
            url: 'https://vidsrc.xyz/embed/tv?tmdb=' + tmdbId + '&season=' + seasonNum + '&episode=' + extCurrentEp,
            type: 'clean',
          });
          servers.push({
            name: 'Server 3',
            url: 'https://www.2embed.cc/embedtv/' + tmdbId + '&s=' + seasonNum + '&e=' + extCurrentEp,
            type: 'clean',
          });
          servers.push({
            name: 'Server 4',
            url: 'https://multiembed.mov/directstream.php?video_id=' + tmdbId + '&tmdb=1&s=' + seasonNum + '&e=' + extCurrentEp,
            type: 'clean',
          });
        }

        // AnimoTV as last fallback
        if (animeSlug) {
          servers.push({
            name: 'Server ' + (servers.length + 1),
            url: 'https://animotvslash.org/' + animeSlug + '-episode-' + extCurrentEp + '/',
            type: 'crop',
          });
        }

        if (servers.length === 0) {
          if (placeholderText) placeholderText.textContent = 'No servers available';
          return;
        }

        var currentIframe = null;
        var currentServerIdx = 0;
        var loadTimeout = null;
        var iframeLoaded = false;
        var safetyTimeout = null;

        // Crop config (AnimoTV only)
        var CROP = {
          viewportW: 1121,
          videoW: 950,
          videoH: 513,
          videoLeft: 86,
          videoTop: 320,
          pageHeight: 2000,
        };

        function clearIframe() {
          if (currentIframe && currentIframe.parentNode) {
            try { currentIframe.parentNode.removeChild(currentIframe); } catch(e) {}
          }
          currentIframe = null;
          iframeLoaded = false;
        }

        function applyCrop() {
          if (!currentIframe) return;
          var cw = wrap.clientWidth;
          if (cw < 10) return;
          var s = cw / CROP.videoW;
          if (s < 0.25) s = 0.25;
          if (s > 2.0) s = 2.0;
          var tx = -CROP.videoLeft * s;
          var ty = -CROP.videoTop * s;
          currentIframe.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
          var h = Math.ceil(CROP.videoH * s);
          wrap.style.aspectRatio = 'auto';
          wrap.style.height = h + 'px';
        }

        function resetToClean() {
          wrap.style.aspectRatio = '16 / 9';
          wrap.style.height = '';
        }

        function updateActiveButton(idx) {
          if (!serverBtns) return;
          var btns = serverBtns.querySelectorAll('.rp-server-btn');
          for (var i = 0; i < btns.length; i++) {
            if (parseInt(btns[i].getAttribute('data-idx')) === idx) {
              btns[i].classList.add('active');
              btns[i].classList.remove('checking');
            } else {
              btns[i].classList.remove('active');
            }
          }
        }

        function loadServer(idx) {
          if (idx >= servers.length) {
            if (placeholderText) placeholderText.textContent = 'All servers unavailable. Refresh to retry.';
            return;
          }

          currentServerIdx = idx;
          var server = servers[idx];
          clearIframe();

          if (loadTimeout) clearTimeout(loadTimeout);
          if (safetyTimeout) clearTimeout(safetyTimeout);

          if (placeholder) placeholder.classList.remove('hidden');
          if (placeholderText) placeholderText.textContent = 'Loading ' + server.name + '...';

          updateActiveButton(idx);

          var iframe = document.createElement('iframe');
          iframe.className = 'rp-ext-iframe' + (server.type === 'clean' ? ' clean' : '');
          iframe.setAttribute('src', server.url);
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('scrolling', 'no');
          iframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('referrerpolicy', 'no-referrer');

          if (server.type === 'crop') {
            iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms allow-popups');
            iframe.style.width = CROP.viewportW + 'px';
            iframe.style.height = CROP.pageHeight + 'px';
          } else {
            resetToClean();
          }

          currentIframe = iframe;

          iframe.addEventListener('load', function() {
            iframeLoaded = true;
            if (loadTimeout) clearTimeout(loadTimeout);
            setTimeout(function() {
              if (placeholder) placeholder.classList.add('hidden');
            }, 400);
            if (server.type === 'crop') {
              requestAnimationFrame(applyCrop);
            }
          });

          wrap.appendChild(iframe);

          // If iframe doesn't fire load event in 7s, try next server
          loadTimeout = setTimeout(function() {
            if (!iframeLoaded && idx < servers.length - 1) {
              var btn = serverBtns ? serverBtns.querySelector('.rp-server-btn[data-idx="' + idx + '"]') : null;
              if (btn) btn.classList.add('dead');
              loadServer(idx + 1);
            }
          }, 7000);

          // Safety: hide placeholder anyway after 10s
          safetyTimeout = setTimeout(function() {
            if (placeholder) placeholder.classList.add('hidden');
          }, 10000);
        }

        // Render server buttons
        if (servers.length > 1 && switcher && serverBtns) {
          switcher.style.display = 'flex';
          var btnsHtml = '';
          for (var i = 0; i < servers.length; i++) {
            btnsHtml += '<button class="rp-server-btn' + (i === 0 ? ' active' : '') + '" data-idx="' + i + '">' + servers[i].name + '</button>';
          }
          serverBtns.innerHTML = btnsHtml;

          var btns = serverBtns.querySelectorAll('.rp-server-btn');
          for (var j = 0; j < btns.length; j++) {
            btns[j].addEventListener('click', function() {
              var idx = parseInt(this.getAttribute('data-idx'));
              if (idx !== currentServerIdx) {
                this.classList.remove('dead');
                loadServer(idx);
              }
            });
          }
        }

        // Resize handler (only matters for crop mode)
        var resizeTimer = null;
        function onResize() {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function() {
            var server = servers[currentServerIdx];
            if (server && server.type === 'crop') applyCrop();
          }, 300);
        }
        window.addEventListener('resize', onResize, { passive: true });
        window.addEventListener('orientationchange', onResize, { passive: true });
        wrap.addEventListener('contextmenu', function(e) { e.preventDefault(); });

        // Start loading first server (small delay for smoother initial render)
        var startLoad = function() {
          setTimeout(function() { loadServer(0); }, 200);
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(startLoad, { timeout: 500 });
        } else {
          startLoad();
        }
      }

      function setupMobileAccordion() {
        var box = document.getElementById('epBoxMobile');
        var header = document.getElementById('epHeaderMobile');
        if (!box || !header) return;
        try {
          var savedState = localStorage.getItem('anitube_ep_collapsed');
          if (savedState === 'false') box.classList.remove('collapsed');
        } catch (e) {}
        header.addEventListener('click', function() {
          box.classList.toggle('collapsed');
          var isCollapsed = box.classList.contains('collapsed');
          try { localStorage.setItem('anitube_ep_collapsed', isCollapsed ? 'true' : 'false'); } catch (e) {}
          header.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
        });
      }

      function scrollActiveEpisode() {
        if (!isExternal) return;
        setTimeout(function() {
          var scrollers = document.querySelectorAll('.rp-ep-scroll');
          for (var i = 0; i < scrollers.length; i++) {
            var scroller = scrollers[i];
            var active = scroller.querySelector('.rp-ext-ep-card.active');
            if (active) {
              var activeTop = active.offsetTop;
              var scrollerHeight = scroller.clientHeight;
              var activeHeight = active.clientHeight;
              scroller.scrollTop = Math.max(0, activeTop - (scrollerHeight / 2) + (activeHeight / 2));
            }
          }
        }, 600);
      }

      function init() {
        saveToHistory();
        updateLikeBtn();
        updateSaveBtn();
        setupIframe();
        setupDoubleTap();
        setupDescToggle();
        setupCommentInput();
        setupAutoplay();
        renderComments();
        initFeeds();
        loadProducts();
        if (isExternal) {
          setupExternalPlayer();
          setupMobileAccordion();
          scrollActiveEpisode();
        }
        var likeBtn = document.getElementById('likeBtn');
        var saveBtn = document.getElementById('saveBtn');
        var sendBtn = document.getElementById('sendBtn');
        var nextBtn = document.getElementById('nextBtn');
        if (likeBtn) likeBtn.addEventListener('click', toggleLike);
        if (saveBtn) saveBtn.addEventListener('click', toggleSave);
        if (sendBtn) sendBtn.addEventListener('click', doShare);
        if (nextBtn) nextBtn.addEventListener('click', goNext);
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
