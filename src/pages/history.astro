---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Watch History | AniTubeBuzz" description="Videos you have watched">
  <Header slot="header" />
  
  <div class="lib-page">
    <div class="container">
      
      <div class="lib-hero">
        <div class="lib-hero-icon-wrap">
          <div class="lib-hero-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
        </div>
        <div class="lib-hero-content">
          <div class="lib-hero-eyebrow">MY LIBRARY</div>
          <h1 class="lib-title">Watch History</h1>
          <p class="lib-subtitle" id="libSubtitle">Loading...</p>
        </div>
        <button class="lib-clear-btn" id="libClearBtn" style="display:none">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
          </svg>
          <span>Clear All</span>
        </button>
      </div>
      
      <div id="libGrid" class="lib-grid"></div>
      
      <div id="libEmpty" class="lib-empty" style="display:none">
        <div class="lib-empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h2 class="lib-empty-title">No Watch History Yet</h2>
        <p class="lib-empty-desc">Videos you watch will appear here automatically</p>
        <a href="/" class="lib-empty-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Start Watching
        </a>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  var grid = document.getElementById('libGrid');
  var empty = document.getElementById('libEmpty');
  var subtitle = document.getElementById('libSubtitle');
  var clearBtn = document.getElementById('libClearBtn');
  
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  
  function fmtTime(ts) {
    if (!ts) return 'recently';
    var diff = Date.now() - ts;
    var mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    var days = Math.floor(hrs / 24);
    if (days < 30) return days + 'd ago';
    return Math.floor(days / 30) + 'mo ago';
  }
  
  function typeLabel(t) {
    var map = { anime: 'Anime', kdrama: 'K-Drama', donghua: 'Donghua', movies: 'Movie' };
    return map[t] || 'Anime';
  }
  
  function render() {
    var items = [];
    try { items = JSON.parse(localStorage.getItem('anitube_history') || '[]'); } catch(e) {}
    
    if (!items.length) {
      grid.style.display = 'none';
      empty.style.display = 'flex';
      subtitle.textContent = 'Nothing here yet';
      clearBtn.style.display = 'none';
      return;
    }
    
    empty.style.display = 'none';
    grid.style.display = 'grid';
    subtitle.textContent = items.length + ' ' + (items.length === 1 ? 'video' : 'videos');
    clearBtn.style.display = 'inline-flex';
    
    var html = '';
    items.forEach(function(v, i) {
      var title = esc(v.title || 'Untitled');
      var channel = esc(v.channel || 'AniTube');
      var thumb = v.thumbnail || '';
      var initial = channel.charAt(0).toUpperCase();
      var time = fmtTime(v.watchedAt);
      var type = typeLabel(v.type);
      var delay = Math.min(i * 20, 400);
      
      html += '<a href="/reels/' + encodeURIComponent(v.id) + '" class="lib-card" style="animation-delay:' + delay + 'ms">' +
        '<div class="lib-card-thumb">' +
          (thumb ? '<img src="' + esc(thumb) + '" alt="" loading="lazy"/>' : '<div class="lib-card-noimg">' + initial + '</div>') +
          '<div class="lib-card-overlay"></div>' +
          '<div class="lib-card-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>' +
          '<div class="lib-card-type">' + type + '</div>' +
          '<button class="lib-card-remove" data-id="' + esc(v.id) + '" aria-label="Remove">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>' +
          '</button>' +
        '</div>' +
        '<div class="lib-card-info">' +
          '<div class="lib-card-title">' + title + '</div>' +
          '<div class="lib-card-meta">@' + channel.replace(/\s+/g,'').toLowerCase() + ' <span class="lib-card-dot">·</span> ' + time + '</div>' +
        '</div>' +
      '</a>';
    });
    grid.innerHTML = html;
    
    grid.querySelectorAll('.lib-card-remove').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('data-id');
        var arr = [];
        try { arr = JSON.parse(localStorage.getItem('anitube_history') || '[]'); } catch(e) {}
        arr = arr.filter(function(x) { return x.id !== id; });
        localStorage.setItem('anitube_history', JSON.stringify(arr));
        render();
      });
    });
  }
  
  clearBtn.addEventListener('click', function() {
    if (confirm('Clear all watch history?')) {
      localStorage.removeItem('anitube_history');
      render();
    }
  });
  
  render();
})();
</script>

<style>
  .lib-page { min-height: calc(100vh - var(--header-h) - 100px); padding: 2rem 0 5rem; }
  
  .lib-hero {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 26px 30px;
    background: 
      linear-gradient(135deg, rgba(6, 182, 212, 0.08), rgba(125, 211, 252, 0.05)),
      linear-gradient(180deg, rgba(28, 15, 61, 0.7), rgba(20, 10, 40, 0.8));
    border: 1px solid rgba(125, 211, 252, 0.3);
    border-radius: 28px;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }
  
  .lib-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(125, 211, 252, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  
  [data-theme="light"] .lib-hero {
    background: 
      linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(125, 211, 252, 0.03)),
      linear-gradient(180deg, #ffffff, #f0f9ff);
    border-color: rgba(6, 182, 212, 0.2);
  }
  
  .lib-hero-icon-wrap { position: relative; flex-shrink: 0; }
  
  .lib-hero-icon-wrap::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: linear-gradient(135deg, #06b6d4, #7dd3fc);
    border-radius: 20px;
    opacity: 0.4;
    filter: blur(12px);
  }
  
  .lib-hero-icon {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: linear-gradient(135deg, #06b6d4, #22d3ee, #7dd3fc);
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  
  .lib-hero-content { flex: 1; min-width: 0; position: relative; z-index: 1; }
  
  .lib-hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #7dd3fc;
    letter-spacing: 0.15em;
    margin-bottom: 4px;
  }
  
  .lib-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 6px;
    background: linear-gradient(135deg, #7dd3fc, #22d3ee, #e879f9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  
  .lib-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    font-weight: 500;
  }
  
  .lib-clear-btn {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 100px;
    color: #ef4444;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  
  .lib-clear-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
  }
  
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.4rem;
  }
  
  @media (max-width: 1200px) { .lib-grid { grid-template-columns: repeat(4, 1fr); gap: 1.2rem; } }
  @media (max-width: 900px) { .lib-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }
  @media (max-width: 640px) { .lib-grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; } }
  
  .lib-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.25s ease, box-shadow 0.35s ease;
    animation: lib-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    display: block;
    position: relative;
    will-change: transform;
  }
  
  @keyframes lib-in {
    from { opacity: 0; transform: translateY(15px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .lib-card:hover {
    transform: translateY(-8px);
    border-color: rgba(125, 211, 252, 0.55);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.35), 0 0 30px rgba(125, 211, 252, 0.2);
  }
  
  .lib-card-thumb {
    position: relative;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, rgba(125, 211, 252, 0.15), rgba(6, 182, 212, 0.1));
    overflow: hidden;
  }
  
  .lib-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
  .lib-card:hover .lib-card-thumb img { transform: scale(1.1); }
  
  .lib-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lib-card:hover .lib-card-overlay { opacity: 1; }
  
  .lib-card-noimg {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 3.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #06b6d4, #22d3ee, #7dd3fc);
    color: white;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
  
  .lib-card-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    width: 56px; height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #06b6d4, #22d3ee, #7dd3fc);
    display: flex; align-items: center; justify-content: center;
    color: white;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 10px 35px rgba(6, 182, 212, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    pointer-events: none;
  }
  .lib-card-play svg { width: 24px; height: 24px; margin-left: 3px; }
  
  .lib-card:hover .lib-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  
  .lib-card-type {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border-radius: 6px;
    border: 1px solid rgba(125, 211, 252, 0.4);
    text-transform: uppercase;
  }
  
  .lib-card-remove {
    position: absolute;
    top: 10px; right: 10px;
    width: 30px; height: 30px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(239, 68, 68, 0.5);
    color: #ef4444;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: all 0.25s;
    padding: 0;
    z-index: 5;
  }
  .lib-card-remove svg { width: 13px; height: 13px; }
  .lib-card:hover .lib-card-remove { opacity: 1; }
  .lib-card-remove:hover {
    background: rgba(239, 68, 68, 0.95);
    color: white;
    transform: scale(1.12);
  }
  
  .lib-card-info { padding: 13px 15px 15px; }
  
  .lib-card-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.25s ease;
    letter-spacing: -0.005em;
  }
  
  .lib-card:hover .lib-card-title {
    background: linear-gradient(135deg, #7dd3fc, #22d3ee);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .lib-card-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .lib-card-dot { opacity: 0.4; }
  
  .lib-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    min-height: 500px;
  }
  
  .lib-empty-icon {
    width: 110px; height: 110px;
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(125, 211, 252, 0.12), rgba(6, 182, 212, 0.08));
    display: flex; align-items: center; justify-content: center;
    color: rgba(125, 211, 252, 0.55);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(125, 211, 252, 0.25);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  
  .lib-empty-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  
  .lib-empty-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 380px;
    margin: 0 0 1.8rem;
    line-height: 1.6;
  }
  
  .lib-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: linear-gradient(135deg, #06b6d4, #22d3ee, #7dd3fc);
    color: white;
    border-radius: 100px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 10px 30px rgba(6, 182, 212, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .lib-empty-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(6, 182, 212, 0.65);
  }
  
  @media (max-width: 640px) {
    .lib-hero { padding: 18px 20px; gap: 14px; border-radius: 22px; flex-wrap: wrap; }
    .lib-hero-icon { width: 48px; height: 48px; border-radius: 14px; }
    .lib-hero-icon svg { width: 24px; height: 24px; }
    .lib-clear-btn { padding: 7px 12px; font-size: 0.72rem; }
    .lib-card-info { padding: 11px 12px 13px; }
    .lib-card-title { font-size: 0.85rem; }
    .lib-card-meta { font-size: 0.62rem; }
    .lib-card-type { font-size: 0.55rem; padding: 3px 8px; }
  }
</style>
