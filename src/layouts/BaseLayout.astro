---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  showAds?: boolean; // <-- NEW: opt-in flag to load monetag
}

const {
  title = 'AniTube Buzz — Anime News, Reviews & Streaming Guide',
  description = 'Your premium source for anime news, episode recaps, manga updates and streaming guides.',
  image = '/og-default.jpg',
  type = 'website',
  showAds = false, // default false so video pages remain safe
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://anime-streaming-buzz.pages.dev');
const fullTitle = title.includes('AniTube') ? title : `${title} | AniTube Buzz`;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="AniTube Buzz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800;12..96,900&family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    <!-- Monetag: only load when page sets showAds=true -->
    {showAds && (
      <script
        src="https://quge5.com/88/tag.min.js"
        data-zone="261500"
        async
        data-cfasync="false"
      ></script>
    )}

    <script is:inline>
      (function(){
        var saved = localStorage.getItem('theme');
        if(saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          if(!saved) localStorage.setItem('theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- (The rest of your existing HTML body remains unchanged) -->
    <div id="loader">
      <div class="ld-brand">
        <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <div class="ld-bar-wrap"><div class="ld-bar"></div></div>
    </div>

    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-glow ambient-glow-1"></div>
      <div class="ambient-glow ambient-glow-2"></div>
    </div>

    <div id="app">
      <slot name="header" />
      <main><slot /></main>
      <slot name="footer" />
    </div>

    <SafiyaCore />

    <button id="btt" aria-label="Scroll to top">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <div id="resume-badge" class="resume-badge">
      <div class="resume-badge-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s-8-4.5-8-11.8A5.5 5.5 0 0 1 12 4.5a5.5 5.5 0 0 1 8 5.7c0 7.3-8 11.8-8 11.8z"/>
        </svg>
      </div>
      <div class="resume-badge-content">
        <div class="resume-badge-title">Welcome back!</div>
        <div class="resume-badge-sub">Continue watching</div>
      </div>
    </div>

    <!-- ═══ LOADER + BACK TO TOP ═══ -->
    <script is:inline>
      (function(){
        function hideLoader() {
          var l = document.getElementById('loader');
          if(l){
            l.style.opacity='0';
            setTimeout(function(){ l.style.display='none'; }, 500);
          }
        }
        window.addEventListener('load', function(){ setTimeout(hideLoader, 500); });
        setTimeout(hideLoader, 2000);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          setTimeout(hideLoader, 1500);
        } else {
          document.addEventListener('DOMContentLoaded', function(){ setTimeout(hideLoader, 1500); });
        }
        var btt = document.getElementById('btt');
        if(btt){
          var bttVisible = false;
          window.addEventListener('scroll',function(){ var show = window.scrollY > 400; if (show !== bttVisible) { bttVisible = show; btt.style.opacity = show ? '1' : '0'; btt.style.pointerEvents = show ? 'auto' : 'none'; } }, { passive: true });
          btt.addEventListener('click',function(){ window.scrollTo({top:0,behavior:'smooth'}); });
        }
      })();
    </script>

    <!-- ═══ OPTIMIZED RESUME DETECTION — Debounced MutationObserver ═══ -->
    <script is:inline>
      (function(){
        try {
          var resumeId = localStorage.getItem('anitube_resume_video');
          var resumeTime = parseInt(localStorage.getItem('anitube_resume_time') || '0', 10);
          if (!resumeId) return;
          if (isNaN(resumeTime) || (Date.now() - resumeTime) > (5 * 60 * 1000)) {
            localStorage.removeItem('anitube_resume_video');
            localStorage.removeItem('anitube_resume_time');
            return;
          }
          var path = window.location.pathname;
          if (path !== '/' && path !== '/index.html') return;
          var done = false;
          var observer = null;
          var timeoutId = null;
          var debounceTimer = null;
          function cleanup() { done = true; if (observer) { observer.disconnect(); observer = null; } if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; } if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; } localStorage.removeItem('anitube_resume_video'); localStorage.removeItem('anitube_resume_time'); }
          function highlightCard(link) { if (done) return; var card = link.closest('.card, .anime-card, [class*="card"], [class*="Card"], article, .item, [class*="tile"]') || link; cleanup(); try { card.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch(e) {} var badge = document.getElementById('resume-badge'); if (badge) { setTimeout(function(){ badge.classList.add('show'); }, 300); setTimeout(function(){ badge.classList.remove('show'); }, 4000); } setTimeout(function(){ card.classList.add('resume-highlight'); setTimeout(function(){ card.classList.add('resume-highlight-fadeout'); setTimeout(function(){ card.classList.remove('resume-highlight'); card.classList.remove('resume-highlight-fadeout'); }, 800); }, 4000); }, 700); }
          function findCard() { var anchors = document.querySelectorAll('a[href*="/reels/"]'); for (var i = 0; i < anchors.length; i++) { var href = anchors[i].getAttribute('href') || ''; if (href.indexOf(resumeId) !== -1) { return anchors[i]; } } return null; }
          function tryFind() { if (done) return true; var link = findCard(); if (link) { highlightCard(link); return true; } return false; }
          function start() {
            if (tryFind()) return;
            observer = new MutationObserver(function() { if (done) return; if (debounceTimer) clearTimeout(debounceTimer); debounceTimer = setTimeout(function() { tryFind(); }, 200); });
            observer.observe(document.body, { childList: true, subtree: true });
            timeoutId = setTimeout(function() { if (!done) cleanup(); }, 10000);
          }
          if (document.readyState === 'complete') { setTimeout(start, 300); } else { window.addEventListener('load', function(){ setTimeout(start, 300); }); }
        } catch (e) { try { localStorage.removeItem('anitube_resume_video'); localStorage.removeItem('anitube_resume_time'); } catch(err) {} }
      })();
    </script>
  </body>
</html>

<style is:global>
/* (Keep your full CSS exactly as it was — omitted here for brevity in the snippet) */
/* Paste the same CSS you already have here unchanged; nothing else needs to change. */
</style>
