---
import SafiyaCore from '../components/SafiyaCore.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'AniTube Buzz — Anime News, Reviews & Streaming Guide',
  description = 'Your premium source for anime news, episode recaps, manga updates and streaming guides.',
  image = '/og-default.jpg',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://anime-streaming-buzz.pages.dev');
const fullTitle = title.includes('AniTube') ? title : `${title} | AniTube Buzz`;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="AniTube Buzz" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800;12..96,900&family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <script is:inline>
    (function(){
      var saved = localStorage.getItem('theme');
      if(saved === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        if(!saved) localStorage.setItem('theme', 'dark');
      }
    })();
  </script>
</head>

<body>

  <div id="loader">
    <div class="ld-brand">
      <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
    </div>
    <div class="ld-bar-wrap"><div class="ld-bar"></div></div>
  </div>

  <div class="ambient-bg" aria-hidden="true">
    <div class="ambient-glow ambient-glow-1"></div>
    <div class="ambient-glow ambient-glow-2"></div>
  </div>

  <div id="app">
    <slot name="header" />
    <main><slot /></main>
    <slot name="footer" />
  </div>
  <SafiyaCore />
  <button id="btt" aria-label="Scroll to top">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <!-- 🎯 RESUME HIGHLIGHT BADGE (floating top notification) -->
  <div id="resume-badge" class="resume-badge">
    <div class="resume-badge-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s-8-4.5-8-11.8A5.5 5.5 0 0 1 12 4.5a5.5 5.5 0 0 1 8 5.7c0 7.3-8 11.8-8 11.8z"/>
      </svg>
    </div>
    <div class="resume-badge-content">
      <div class="resume-badge-title">Welcome back!</div>
      <div class="resume-badge-sub">Continuing where you left off</div>
    </div>
  </div>

  <script is:inline>
  (function(){
    window.addEventListener('load', function(){
      setTimeout(function(){
        var l = document.getElementById('loader');
        if(l){ l.style.opacity='0'; setTimeout(function(){ l.style.display='none'; },500); }
      }, 500);
    });

    var btt = document.getElementById('btt');
    if(btt){
      window.addEventListener('scroll',function(){
        var show = window.scrollY > 400;
        btt.style.opacity = show ? '1' : '0';
        btt.style.pointerEvents = show ? 'auto' : 'none';
      }, { passive: true });
      btt.addEventListener('click',function(){ window.scrollTo({top:0,behavior:'smooth'}); });
    }
  })();
  </script>

  <!-- ═══════════════════════════════════════════════════
       🎬 RESUME HIGHLIGHT — auto-detect ?resume=xxx
       Scrolls to card, glows it, shows welcome badge
       ═══════════════════════════════════════════════════ -->
  <script is:inline>
  (function(){
    var params = new URLSearchParams(window.location.search);
    var resumeId = params.get('resume');
    if (!resumeId) return;
    
    // Clean URL immediately (so refresh doesn't repeat)
    try {
      var cleanUrl = window.location.pathname + window.location.hash;
      window.history.replaceState({}, '', cleanUrl);
    } catch(e) {}
    
    // Wait for feed to render (dynamic content)
    var attempts = 0;
    var maxAttempts = 40; // 8 seconds max
    
    function findAndHighlight() {
      attempts++;
      
      // Try multiple selectors to find the card
      var selectors = [
        'a[href="/reels/' + resumeId + '"]',
        'a[href*="/reels/' + resumeId + '"]',
        '[data-video-id="' + resumeId + '"]',
        '[data-id="' + resumeId + '"]'
      ];
      
      var card = null;
      for (var i = 0; i < selectors.length; i++) {
        try {
          card = document.querySelector(selectors[i]);
          if (card) break;
        } catch(e) {}
      }
      
      if (!card && attempts < maxAttempts) {
        setTimeout(findAndHighlight, 200);
        return;
      }
      
      if (!card) return; // Give up gracefully
      
      // Get the actual card element (climb up if we got an anchor)
      var cardEl = card;
      // Try to find visual card container
      var parent = card.closest('.card, .anime-card, [class*="card"]');
      if (parent) cardEl = parent;
      
      // Show welcome badge
      var badge = document.getElementById('resume-badge');
      if (badge) {
        badge.classList.add('show');
        setTimeout(function(){
          badge.classList.remove('show');
        }, 3500);
      }
      
      // Scroll into view (centered)
      setTimeout(function(){
        try {
          cardEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch(e) {
          // Fallback for old browsers
          var rect = cardEl.getBoundingClientRect();
          window.scrollTo(0, window.pageYOffset + rect.top - window.innerHeight / 2 + rect.height / 2);
        }
        
        // Add highlight class after scroll settles
        setTimeout(function(){
          cardEl.classList.add('resume-highlight');
          
          // Remove after 4 seconds
          setTimeout(function(){
            cardEl.classList.remove('resume-highlight');
          }, 4000);
        }, 800);
      }, 400);
    }
    
    // Wait for DOM + feed
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(findAndHighlight, 800);
    } else {
      window.addEventListener('DOMContentLoaded', function(){
        setTimeout(findAndHighlight, 800);
      });
    }
  })();
  </script>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  [data-theme="dark"] {
    --bg-base:      #0a0517;
    --bg-primary:   #130827;
    --bg-secondary: #1c0f3d;
    --bg-elevated:  #241548;
    --bg-glass:     rgba(10, 5, 23, 0.85);
    --bg-card:      rgba(28, 15, 61, 0.55);
    --bg-card-hover: rgba(36, 21, 72, 0.75);

    --text-primary:   #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.75);
    --text-muted:     rgba(255, 255, 255, 0.5);
    --text-faint:     rgba(255, 255, 255, 0.25);

    --border-color:  rgba(192, 132, 252, 0.15);
    --border-hover:  rgba(192, 132, 252, 0.45);

    --body-bg: linear-gradient(180deg, #1a0b35 0%, #0a0517 100%);
    --header-bg: rgba(10, 5, 23, 0.85);
    --header-bg-scrolled: rgba(10, 5, 23, 0.95);
    --nav-link-active-color: #fff;
    --nav-link-active-bg: linear-gradient(135deg, rgba(192, 132, 252, 0.25), rgba(232, 121, 249, 0.2));
    --icon-btn-bg: rgba(192, 132, 252, 0.1);
    --icon-btn-color: rgba(255, 255, 255, 0.75);
  }

  [data-theme="light"] {
    --bg-base:      #faf5ff;
    --bg-primary:   #ffffff;
    --bg-secondary: #f3e8ff;
    --bg-elevated:  #ffffff;
    --bg-glass:     rgba(255, 255, 255, 0.9);
    --bg-card:      #ffffff;
    --bg-card-hover: #faf5ff;

    --text-primary:   #1e0f36;
    --text-secondary: rgba(30, 15, 54, 0.8);
    --text-muted:     rgba(30, 15, 54, 0.55);
    --text-faint:     rgba(30, 15, 54, 0.25);

    --border-color:  rgba(192, 132, 252, 0.25);
    --border-hover:  rgba(168, 85, 247, 0.5);

    --body-bg: linear-gradient(180deg, #f3e8ff 0%, #faf5ff 100%);
    --header-bg: rgba(255, 255, 255, 0.9);
    --header-bg-scrolled: rgba(255, 255, 255, 0.98);
    --nav-link-active-color: #ffffff;
    --nav-link-active-bg: linear-gradient(135deg, #a855f7, #e879f9);
    --icon-btn-bg: rgba(168, 85, 247, 0.1);
    --icon-btn-color: rgba(30, 15, 54, 0.8);
  }

  :root {
    --purple: #c084fc;
    --purple-deep: #a855f7;
    --pink: #f0abfc;
    --pink-hot: #e879f9;
    --cyan: #7dd3fc;
    --cyan-bright: #22d3ee;
    --flame: #fb923c;

    --grad: linear-gradient(135deg, #c084fc 0%, #e879f9 50%, #7dd3fc 100%);
    --grad-hot: linear-gradient(135deg, #a855f7, #e879f9);

    --header-h: 68px;
    --font-body:    'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-heading: 'Bricolage Grotesque', 'DM Sans', sans-serif;
    --font-mono:    'JetBrains Mono', monospace;
    --radius-sm: 10px;
    --radius-md: 14px;
    --radius-lg: 22px;
    --radius-xl: 32px;
    --max-w: 1440px;

    --transition-fast:   0.2s ease;
    --transition-normal: 0.3s ease;
  }

  body {
    font-family: var(--font-body);
    background: var(--body-bg);
    background-attachment: fixed;
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    letter-spacing: -0.025em;
  }

  p, li { color: var(--text-secondary); }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  ::selection { background: rgba(192, 132, 252, 0.4); color: #fff; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(192, 132, 252, 0.35); border-radius: 9px; }

  .ambient-bg {
    position: fixed; inset: 0;
    z-index: 0; overflow: hidden;
    pointer-events: none;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }

  .ambient-glow-1 {
    width: 500px; height: 500px;
    background: rgba(168, 85, 247, 0.22);
    top: -10%; right: -10%;
  }

  .ambient-glow-2 {
    width: 500px; height: 500px;
    background: rgba(125, 211, 252, 0.15);
    bottom: -10%; left: -10%;
  }

  [data-theme="light"] .ambient-glow-1 { background: rgba(168, 85, 247, 0.1); }
  [data-theme="light"] .ambient-glow-2 { background: rgba(125, 211, 252, 0.08); }

  .grad-text {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }

  .tube-text { color: var(--text-primary); }

  #loader {
    position: fixed; inset: 0;
    background: var(--bg-base);
    z-index: 99999;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 1.2rem;
    transition: opacity 0.4s ease;
  }

  .ld-brand {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .ld-bar-wrap {
    width: 180px; height: 2px;
    background: rgba(192, 132, 252, 0.15);
    border-radius: 9px; overflow: hidden;
  }

  .ld-bar {
    height: 100%;
    background: var(--grad);
    border-radius: 9px;
    animation: ld-fill 0.7s ease forwards;
  }

  @keyframes ld-fill { from { width: 0; } to { width: 100%; } }

  #app {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main { flex: 1; }

  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (max-width: 640px) { .container { padding: 0 1rem; } }

  #btt {
    position: fixed; bottom: 1.5rem; right: 1.5rem;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--grad);
    border: none; color: #fff;
    display: flex; align-items: center; justify-content: center;
    z-index: 1000;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s, transform 0.2s;
    cursor: pointer;
  }
  #btt:hover { transform: translateY(-3px); }
  
  /* Hide BTT on mobile — as requested */
  @media (max-width: 768px) {
    #btt { display: none !important; }
  }

  .section-block { padding: 3rem 0; }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
    letter-spacing: -0.03em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border: none;
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-grad {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 4px 20px rgba(192, 132, 252, 0.4);
  }
  .btn-grad:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(192, 132, 252, 0.55);
  }

  .btn-outline {
    background: rgba(192, 132, 252, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }
  .btn-outline:hover {
    border-color: rgba(192, 132, 252, 0.5);
    background: rgba(192, 132, 252, 0.12);
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-hover);
    transform: translateY(-6px);
  }

  /* TICKER */
  .ticker-wrap {
    background: rgba(28, 15, 61, 0.5);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
    padding: 0.6rem 0;
    position: relative;
  }

  [data-theme="light"] .ticker-wrap { background: rgba(243, 232, 255, 0.6); }

  .ticker-wrap::before, .ticker-wrap::after {
    content: ''; position: absolute; top: 0; bottom: 0;
    width: 80px; z-index: 2; pointer-events: none;
  }
  .ticker-wrap::before { left: 0; background: linear-gradient(90deg, var(--bg-base), transparent); }
  .ticker-wrap::after  { right: 0; background: linear-gradient(-90deg, var(--bg-base), transparent); }

  .ticker-label {
    position: absolute; left: 0; top: 0; bottom: 0; z-index: 3;
    background: var(--grad);
    display: flex; align-items: center;
    padding: 0 1rem;
    font-family: var(--font-heading);
    font-size: 0.68rem; font-weight: 800;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: #fff; white-space: nowrap;
  }

  .ticker-track {
    display: flex;
    animation: ticker-move 60s linear infinite;
    width: max-content;
    padding-left: 140px;
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .ticker-track:hover { animation-play-state: paused; }

  .ticker-item {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0 1.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .ticker-item:hover {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .ticker-sep {
    color: var(--purple);
    padding: 0 0.4rem;
    font-size: 0.5rem;
    opacity: 0.6;
  }

  @keyframes ticker-move {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 768px) {
    .ticker-track {
      animation-duration: 30s;
    }
  }

  .video-embed-wrapper {
    position: relative; width: 100%;
    aspect-ratio: 16/9;
    border-radius: var(--radius-lg); overflow: hidden;
    background: #000;
    border: 1px solid var(--border-color);
    margin: 1.5rem 0;
  }
  .video-embed-wrapper iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%; border: none;
  }

  .prose { color: var(--text-secondary); line-height: 1.8; font-size: 1rem; }
  .prose h2 {
    font-size: 1.5rem; color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .prose h3 { font-size: 1.15rem; color: var(--text-primary); margin: 1.5rem 0 0.5rem; }
  .prose p { margin-bottom: 1rem; color: var(--text-secondary); }
  .prose a {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    font-weight: 600;
  }
  .prose a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1rem; color: var(--text-secondary); }
  .prose li { margin-bottom: 0.3rem; }
  .prose blockquote {
    border-left: 3px solid var(--purple);
    padding: 0.75rem 1rem;
    background: rgba(192, 132, 252, 0.05);
    margin: 1rem 0;
    font-style: italic;
    border-radius: 0 12px 12px 0;
  }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
  .prose th {
    background: rgba(192, 132, 252, 0.08);
    color: var(--text-primary);
    padding: 0.7rem 0.9rem; text-align: left;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .prose td { padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border-color); color: var(--text-secondary); }
  .prose hr {
    border: none; height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    margin: 2rem 0;
  }

  .skeleton {
    background: linear-gradient(90deg,
      rgba(192, 132, 252, 0.05) 25%,
      rgba(192, 132, 252, 0.12) 50%,
      rgba(192, 132, 252, 0.05) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius-sm);
  }
  @keyframes shimmer { from { background-position: -200% 0; } to { background-position: 200% 0; } }

  mark.hl {
    background: rgba(192, 132, 252, 0.3);
    color: var(--text-primary);
    border-radius: 2px;
    padding: 0 3px;
  }

  .reveal {
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ═══════════════════════════════════════════════════
     🎯 RESUME HIGHLIGHT — Last watched video glow
     ═══════════════════════════════════════════════════ */
  
  /* Floating welcome badge */
  .resume-badge {
    position: fixed;
    top: 90px;
    left: 50%;
    transform: translateX(-50%) translateY(-100px);
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 12px;
    background: linear-gradient(135deg, rgba(28, 15, 61, 0.95), rgba(20, 10, 40, 0.98));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(192, 132, 252, 0.4);
    border-radius: 100px;
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(192, 132, 252, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    opacity: 0;
    pointer-events: none;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    font-family: var(--font-body);
  }

  .resume-badge.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .resume-badge-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(192, 132, 252, 0.5);
    animation: resume-pulse 2s ease-in-out infinite;
  }

  .resume-badge-icon svg {
    width: 20px;
    height: 20px;
  }

  @keyframes resume-pulse {
    0%, 100% { transform: scale(1); }
