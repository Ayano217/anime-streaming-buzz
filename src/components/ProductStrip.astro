---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — Product Strip Component (Self-Contained Fix)
// Path: src/components/ProductStrip.astro
// ═══════════════════════════════════════════════════════════════
// FIX: Added all pc-card styles as :global because Astro scopes
//      component styles — dynamically injected HTML via JS doesn't
//      get scoped class attributes, so styles never applied.
//      Making them global fixes this permanently.
// ═══════════════════════════════════════════════════════════════

interface Props {
  title: string;
  subtitle?: string;
  type?: 'trending' | 'featured' | 'category' | 'anime' | 'all';
  category?: string;
  anime?: string;
  limit?: number;
  size?: 'small' | 'medium' | 'large';
  showViewAll?: boolean;
  accentColor?: string;
}

const {
  title,
  subtitle = '',
  type = 'trending',
  category = '',
  anime = '',
  limit = 12,
  size = 'medium',
  showViewAll = true,
  accentColor = '',
} = Astro.props;

let apiUrl = `/api/products?limit=${limit}`;
if (type === 'trending') apiUrl += '&trending=true';
else if (type === 'featured') apiUrl += '&featured=true';
else if (type === 'category' && category) apiUrl += `&category=${encodeURIComponent(category)}`;
else if (type === 'anime' && anime) apiUrl += `&anime=${encodeURIComponent(anime)}`;

const stripId = 'ps-' + Math.random().toString(36).substring(2, 10);
---

<section class="ps-section" data-strip-id={stripId} data-api-url={apiUrl}>
  <div class="container">
    
    <div class="ps-header">
      <div class="ps-title-wrap">
        <div 
          class="ps-bar" 
          style={accentColor ? `background: ${accentColor};` : ''}
        ></div>
        <div>
          {subtitle && <div class="ps-subtitle">{subtitle}</div>}
          <h2 class="ps-title">{title}</h2>
        </div>
      </div>
      
      <div class="ps-nav">
        <button class="ps-arrow ps-arrow-left" data-dir="left" aria-label="Scroll left">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="ps-arrow ps-arrow-right" data-dir="right" aria-label="Scroll right">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="ps-scroll-wrap">
      <div class="ps-fade ps-fade-left"></div>
      <div class="ps-fade ps-fade-right"></div>
      <div class="ps-scroll" id={stripId + '-scroll'}>
        <div class="ps-skeleton"></div>
        <div class="ps-skeleton"></div>
        <div class="ps-skeleton"></div>
        <div class="ps-skeleton"></div>
        <div class="ps-skeleton"></div>
        <div class="ps-skeleton"></div>
      </div>
    </div>
    
  </div>
</section>

<script is:inline>
(function() {

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  
  function trunc(s, n) {
    s = String(s || '');
    return s.length > n ? s.slice(0, n).trim() + '…' : s;
  }
  
  function buildProductCard(product) {
    var categoryEmojis = {
      figures: '🗿', manga: '📚', posters: '🎨',
      apparel: '👕', accessories: '🔑', games: '🎮',
      bluray: '💿', cosplay: '🎭', collectibles: '⭐', snacks: '🍜'
    };
    var catIcon = categoryEmojis[product.category] || '🛍️';
    
    var fullStars = Math.floor(product.rating || 0);
    var hasHalf = (product.rating || 0) - fullStars >= 0.5;
    var starsHtml = '';
    for (var i = 0; i < 5; i++) {
      var cls = 'pc-star';
      if (i < fullStars) cls += ' full';
      else if (i === fullStars && hasHalf) cls += ' half';
      else cls += ' empty';
      starsHtml += '<span class="' + cls + '">★</span>';
    }
    
    var badgeHtml = product.badge 
      ? '<div class="pc-badge">' + esc(product.badge) + '</div>' 
      : '';
    
    var videoBadge = product.video 
      ? '<div class="pc-video-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>'
      : '';
    
    var videoWrap = product.video 
      ? '<div class="pc-video-wrap" data-video-src="' + esc(product.video) + '"></div>'
      : '';
    
    var reviewCount = (product.reviews || 0).toLocaleString();
    
    return (
      '<div class="pc-card pc-medium ps-item" data-product-id="' + esc(product.id) + '">' +
        '<div class="pc-media">' +
          '<img src="' + esc(product.image) + '" ' +
               'alt="' + esc(product.title) + '" ' +
               'loading="lazy" ' +
               'class="pc-image" ' +
               'onerror="this.style.opacity=\'0.3\'" />' +
          videoWrap +
          '<div class="pc-shine"></div>' +
          '<div class="pc-overlay"></div>' +
          badgeHtml +
          '<div class="pc-cat-icon">' + catIcon + '</div>' +
          videoBadge +
          '<div class="pc-hover-cta">' +
            '<div class="pc-hover-play">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
            '</div>' +
            '<span>View Deal</span>' +
          '</div>' +
        '</div>' +
        '<div class="pc-info">' +
          '<div class="pc-subtitle">' + esc(trunc(product.subtitle || '', 45)) + '</div>' +
          '<h3 class="pc-title">' + esc(trunc(product.title, 55)) + '</h3>' +
          '<div class="pc-rating">' +
            '<div class="pc-stars">' + starsHtml + '</div>' +
            '<span class="pc-reviews">(' + reviewCount + ')</span>' +
          '</div>' +
          '<div class="pc-footer">' +
            '<div class="pc-price">' + esc(product.price) + '</div>' +
            '<a href="' + esc(product.affiliateUrl) + '" ' +
               'target="_blank" ' +
               'rel="noopener sponsored" ' +
               'class="pc-cta" ' +
               'data-product-id="' + esc(product.id) + '">' +
              '<span>Get It</span>' +
              '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
            '</a>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }
  
  function setupVideoHover(card) {
    var videoWrap = card.querySelector('.pc-video-wrap');
    if (!videoWrap) return;
    var videoSrc = videoWrap.dataset.videoSrc;
    if (!videoSrc) return;
    
    var hoverTimeout;
    var iframeInjected = false;
    
    card.addEventListener('mouseenter', function() {
      hoverTimeout = setTimeout(function() {
        if (iframeInjected) return;
        var sep = videoSrc.includes('?') ? '&' : '?';
        var autoUrl = videoSrc + sep + 'autoplay=1&mute=1&controls=0&loop=1&modestbranding=1';
        var iframe = document.createElement('iframe');
        iframe.src = autoUrl;
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; encrypted-media');
        iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;pointer-events:none;';
        videoWrap.appendChild(iframe);
        videoWrap.classList.add('active');
        iframeInjected = true;
      }, 400);
    });
    
    card.addEventListener('mouseleave', function() {
      clearTimeout(hoverTimeout);
      if (iframeInjected) {
        videoWrap.classList.remove('active');
        setTimeout(function() {
          if (!card.matches(':hover')) {
            videoWrap.innerHTML = '';
            iframeInjected = false;
          }
        }, 300);
      }
    });
  }
  
  function setupClickTracking(cta) {
    cta.addEventListener('click', function() {
      var productId = cta.dataset.productId;
      try {
        var clicks = JSON.parse(localStorage.getItem('anitube_product_clicks') || '{}');
        clicks[productId] = (clicks[productId] || 0) + 1;
        clicks._lastClick = { id: productId, time: Date.now() };
        localStorage.setItem('anitube_product_clicks', JSON.stringify(clicks));
      } catch(e) {}
    });
  }
  
  function setupArrows(section) {
    var scrollEl = section.querySelector('.ps-scroll');
    var leftArrow = section.querySelector('.ps-arrow-left');
    var rightArrow = section.querySelector('.ps-arrow-right');
    if (!scrollEl || !leftArrow || !rightArrow) return;
    
    function updateArrows() {
      leftArrow.classList.toggle('disabled', scrollEl.scrollLeft <= 5);
      rightArrow.classList.toggle('disabled', 
        scrollEl.scrollLeft >= scrollEl.scrollWidth - scrollEl.clientWidth - 5
      );
    }
    
    leftArrow.addEventListener('click', function() {
      scrollEl.scrollBy({ left: -600, behavior: 'smooth' });
    });
    rightArrow.addEventListener('click', function() {
      scrollEl.scrollBy({ left: 600, behavior: 'smooth' });
    });
    
    scrollEl.addEventListener('scroll', updateArrows, { passive: true });
    updateArrows();
    setTimeout(updateArrows, 600);
  }
  
  async function loadStrip(section) {
    var apiUrl = section.dataset.apiUrl;
    var stripId = section.dataset.stripId;
    var scrollEl = document.getElementById(stripId + '-scroll');
    if (!apiUrl || !scrollEl) return;
    
    try {
      var res = await fetch(apiUrl);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      
      if (!data.success || !data.products || data.products.length === 0) {
        section.style.display = 'none';
        return;
      }
      
      scrollEl.innerHTML = data.products.map(buildProductCard).join('');
      
      scrollEl.querySelectorAll('.pc-card').forEach(function(card) {
        setupVideoHover(card);
        var cta = card.querySelector('.pc-cta');
        if (cta) setupClickTracking(cta);
      });
      
      setupArrows(section);
      
    } catch(e) {
      console.warn('[ProductStrip] Failed:', e.message);
      section.style.display = 'none';
    }
  }
  
  function initStrips() {
    document.querySelectorAll('.ps-section').forEach(function(section) {
      if (section.dataset.loaded === 'true') return;
      section.dataset.loaded = 'true';
      loadStrip(section);
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStrips);
  } else {
    initStrips();
  }

})();
</script>

<style is:global>
  /* ═══════════════════════════════════════════════
     PRODUCT STRIP — Strip Layout Styles
     ═══════════════════════════════════════════════ */
  
  .ps-section {
    padding: 2.5rem 0 1.5rem;
    position: relative;
  }
  
  .ps-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }
  
  .ps-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }
  
  .ps-bar {
    width: 4px;
    height: 40px;
    background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
    border-radius: 3px;
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.6);
    animation: psBarPulse 3s ease infinite;
    flex-shrink: 0;
  }
  
  @keyframes psBarPulse {
    0%, 100% { box-shadow: 0 0 15px rgba(192, 132, 252, 0.6); }
    50%       { box-shadow: 0 0 25px rgba(232, 121, 249, 0.8); }
  }
  
  .ps-subtitle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #c084fc;
    margin-bottom: 3px;
    text-transform: uppercase;
  }
  
  .ps-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: var(--text-primary, #f3e8ff);
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  
  .ps-nav {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  
  .ps-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(192, 132, 252, 0.15);
    border: 1px solid rgba(192, 132, 252, 0.3);
    color: var(--text-primary, #f3e8ff);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(10px);
  }
  
  .ps-arrow:hover:not(.disabled) {
    background: linear-gradient(135deg, #c084fc, #e879f9);
    border-color: transparent;
    color: #fff;
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(192, 132, 252, 0.4);
  }
  
  .ps-arrow.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  .ps-scroll-wrap {
    position: relative;
    margin: 0 -0.5rem;
  }
  
  .ps-fade {
    position: absolute;
    top: 0;
    bottom: 12px;
    width: 60px;
    z-index: 5;
    pointer-events: none;
  }
  .ps-fade-left {
    left: 0;
    background: linear-gradient(90deg, #0a0517, transparent);
  }
  .ps-fade-right {
    right: 0;
    background: linear-gradient(-90deg, #0a0517, transparent);
  }
  
  [data-theme="light"] .ps-fade-left {
    background: linear-gradient(90deg, #faf5ff, transparent);
  }
  [data-theme="light"] .ps-fade-right {
    background: linear-gradient(-90deg, #faf5ff, transparent);
  }
  
  .ps-scroll {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0.5rem 16px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ps-scroll::-webkit-scrollbar { display: none; }
  
  /* Each product card inside the strip */
  .ps-scroll .ps-item {
    flex: 0 0 auto;
    width: 220px;
    scroll-snap-align: start;
  }
  
  /* Skeleton loaders */
  .ps-skeleton {
    flex: 0 0 auto;
    width: 220px;
    height: 340px;
    border-radius: 16px;
    background: linear-gradient(
      90deg,
      rgba(192, 132, 252, 0.05) 25%,
      rgba(192, 132, 252, 0.12) 50%,
      rgba(192, 132, 252, 0.05) 75%
    );
    background-size: 200% 100%;
    animation: psShimmer 1.5s infinite;
    scroll-snap-align: start;
  }
  
  @keyframes psShimmer {
    from { background-position: -200% 0; }
    to   { background-position:  200% 0; }
  }

  /* ═══════════════════════════════════════════════
     PRODUCT CARD STYLES — Global (needed because
     cards are injected via JS innerHTML, not Astro)
     ═══════════════════════════════════════════════ */
  
  .pc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(28, 15, 61, 0.55);
    border: 1px solid rgba(192, 132, 252, 0.2);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    color: inherit;
    height: 100%;
    backdrop-filter: blur(10px);
    cursor: pointer;
  }
  
  [data-theme="light"] .pc-card {
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(192, 132, 252, 0.25);
  }
  
  .pc-card:hover {
    transform: translateY(-6px);
    border-color: rgba(232, 121, 249, 0.6);
    box-shadow:
      0 20px 45px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(192, 132, 252, 0.3),
      0 0 0 1px rgba(232, 121, 249, 0.35);
  }
  
  [data-theme="light"] .pc-card:hover {
    box-shadow:
      0 20px 45px rgba(192, 132, 252, 0.2),
      0 0 30px rgba(232, 121, 249, 0.15);
  }
  
  /* ─── Media (image area) ─── */
  .pc-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #0a0517;
    overflow: hidden;
    flex-shrink: 0;
  }
  
  [data-theme="light"] .pc-media {
    background: #f3e8ff;
  }
  
  .pc-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.35s ease;
    z-index: 1;
    display: block;
  }
  
  .pc-card:hover .pc-image {
    transform: scale(1.08);
    filter: brightness(0.72);
  }
  
  /* Video overlay */
  .pc-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    background: #000;
  }
  .pc-video-wrap.active { opacity: 1; }
  
  /* Shine sweep */
  .pc-shine {
    position: absolute;
    top: 0;
    left: -80%;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    z-index: 4;
    transition: left 0.8s ease;
    pointer-events: none;
  }
  .pc-card:hover .pc-shine { left: 120%; }
  
  /* Dark gradient overlay on hover */
  .pc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(10, 5, 23, 0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 3;
  }
  .pc-card:hover .pc-overlay { opacity: 1; }
  
  /* Badge (top-left) */
  .pc-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    border-radius: 6px;
    z-index: 6;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.5);
    text-transform: uppercase;
    white-space: nowrap;
    max-width: calc(100% - 50px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* Category icon (top-right) */
  .pc-cat-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    background: rgba(10, 5, 23, 0.85);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    z-index: 6;
    backdrop-filter: blur(10px);
    line-height: 1;
  }
  
  /* Video indicator dot (bottom-right) */
  .pc-video-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 6;
    box-shadow: 0 3px 10px rgba(192, 132, 252, 0.5);
    animation: pcVideoPulse 2s ease-in-out infinite;
  }
  
  @keyframes pcVideoPulse {
    0%, 100% { transform: scale(1);    box-shadow: 0 3px 10px rgba(192, 132, 252, 0.5); }
    50%       { transform: scale(1.1); box-shadow: 0 3px 15px rgba(232, 121, 249, 0.7); }
  }
  
  /* Hover CTA pill (bottom-left) */
  .pc-hover-cta {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 5px;
    background: rgba(10, 5, 23, 0.92);
    border: 1px solid rgba(192, 132, 252, 0.4);
    border-radius: 999px;
    color: #fff;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    z-index: 6;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    pointer-events: none;
  }
  .pc-card:hover .pc-hover-cta {
    opacity: 1;
    transform: translateY(0);
  }
  .pc-hover-play {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
    padding-left: 2px;
  }
  
  /* ─── Info section ─── */
  .pc-info {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  
  .pc-subtitle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    color: #c084fc;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.9;
  }
  
  .pc-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.87rem;
    font-weight: 700;
    color: var(--text-primary, #f3e8ff);
    margin: 0;
    line-height: 1.28;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.2em;
    transition: color 0.25s ease;
  }
  
  .pc-card:hover .pc-title {
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* Stars */
  .pc-rating {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  
  .pc-stars {
    display: inline-flex;
    gap: 1px;
    font-size: 0.75rem;
    line-height: 1;
  }
  
  .pc-star        { color: rgba(255, 255, 255, 0.15); }
  .pc-star.full   { color: #fbbf24; text-shadow: 0 0 6px rgba(251, 191, 36, 0.4); }
  .pc-star.half   {
    background: linear-gradient(90deg, #fbbf24 50%, rgba(255, 255, 255, 0.15) 50%);
