    color: var(--icon-btn-color);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0; position: relative;
  }
  .header-icon-btn:hover {
    background: rgba(192,132,252,0.2);
    color: var(--text-primary);
    transform: translateY(-1px);
    border-color: rgba(192,132,252,0.4);
  }
  .profile-badge {
    position: absolute; top: -2px; right: -2px;
    min-width: 8px; height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e879f9, #c084fc);
    box-shadow: 0 0 8px rgba(232,121,249,0.7);
    animation: badge-pulse 2.5s infinite;
  }
  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .theme-sun { display: none; }
  .theme-moon { display: block; }
  [data-theme="light"] .theme-sun { display: block; }
  [data-theme="light"] .theme-moon { display: none; }

  /* ═══════════════════════════════════════
     📱 MOBILE
  ═══════════════════════════════════════ */
  .mobile-only { display: none; }
  .mobile-menu {
    display: none;
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--header-bg-scrolled);
    border-bottom: 1px solid var(--border-color);
    padding: 12px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .mobile-menu.open { display: block; }

  .mobile-search-wrap {
    display: flex; align-items: center; gap: 8px;
    background: rgba(192,132,252,0.08);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 0 14px;
    margin-bottom: 10px;
    transition: border-color 0.2s;
  }
  [data-theme="light"] .mobile-search-wrap {
    background: rgba(243,232,255,0.6);
    border-color: rgba(192,132,252,0.25);
  }
  .mobile-search-wrap:focus-within {
    border-color: rgba(232,121,249,0.6);
    box-shadow: 0 0 0 2px rgba(192,132,252,0.12);
  }
  .mobile-search-input {
    flex: 1; background: none; border: none; outline: none;
    color: var(--text-primary);
    font-family: inherit; font-size: 0.85rem;
    padding: 11px 0;
  }
  .mobile-search-input::placeholder { color: var(--text-muted); opacity: 0.7; }

  .mobile-nav { display: flex; flex-direction: column; gap: 2px; }
  .mobile-nav-link {
    padding: 11px 14px; border-radius: 10px;
    color: var(--text-secondary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background: rgba(192,132,252,0.14);
    color: var(--text-primary);
  }

  /* ═══════════════════════════════════════
     🎨 SIDE MENU (unchanged, kept minimal)
  ═══════════════════════════════════════ */
  .side-menu {
    position: fixed; inset: 0;
    z-index: 9999;
    visibility: hidden; pointer-events: none;
    transition: visibility 0.4s;
  }
  .side-menu.open { visibility: visible; pointer-events: auto; }

  .side-menu-backdrop {
    position: absolute; inset: 0;
    background: rgba(10,5,23,0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  [data-theme="light"] .side-menu-backdrop { background: rgba(30,15,54,0.5); }
  .side-menu.open .side-menu-backdrop { opacity: 1; }

  .side-menu-panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 380px; max-width: 92vw;
    background: linear-gradient(180deg, #14092a 0%, #0a0517 100%) !important;
    border-left: 1px solid rgba(192,132,252,0.25);
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.34,1.4,0.64,1);
    display: flex; flex-direction: column;
    box-shadow: -20px 0 60px rgba(0,0,0,0.5);
  }
  [data-theme="light"] .side-menu-panel {
    background: linear-gradient(180deg, #ffffff 0%, #faf5ff 100%) !important;
    border-left-color: rgba(168,85,247,0.2);
    box-shadow: -20px 0 60px rgba(30,15,54,0.15);
  }
  .side-menu.open .side-menu-panel { transform: translateX(0); }

  .sm-scroll { flex: 1; overflow-y: auto; overflow-x: hidden; }
  .sm-scroll::-webkit-scrollbar { width: 4px; }
  .sm-scroll::-webkit-scrollbar-thumb { background: rgba(192,132,252,0.3); border-radius: 4px; }

  .sm-header {
    display: flex; align-items: center; gap: 14px;
    padding: 22px 20px 20px;
    border-bottom: 1px solid rgba(192,132,252,0.15);
