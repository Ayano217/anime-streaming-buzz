  .sm-user-info { flex: 1; min-width: 0; }
  .sm-username {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1rem; font-weight: 700;
    color: #ffffff !important; line-height: 1.2;
  }
  [data-theme="light"] .sm-username { color: #1e0f36 !important; }
  .sm-user-sub {
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
    color: rgba(255,255,255,0.5) !important; margin-top: 2px;
  }
  [data-theme="light"] .sm-user-sub { color: rgba(30,15,54,0.55) !important; }

  .sm-close {
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(192,132,252,0.1);
    border: 1px solid rgba(192,132,252,0.2);
    color: rgba(255,255,255,0.75); cursor: pointer;
