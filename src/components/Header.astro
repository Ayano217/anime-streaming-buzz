  }
  .sm-item:hover { background: rgba(192,132,252,0.1); transform: translateX(-2px); }
  [data-theme="light"] .sm-item:hover { background: rgba(168,85,247,0.08); }
  .sm-item-disabled { opacity: 0.5; cursor: not-allowed; }
  .sm-item-disabled:hover { background: transparent; transform: none; }

  .sm-item-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: white; flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }
  .sm-item-icon svg { width: 17px; height: 17px; }

  .sm-icon-purple { background: linear-gradient(135deg, #a855f7, #c084fc); }
  .sm-icon-pink   { background: linear-gradient(135deg, #ec4899, #e879f9); }
  .sm-icon-cyan   { background: linear-gradient(135deg, #06b6d4, #7dd3fc); }
  .sm-icon-red    { background: linear-gradient(135deg, #ef4444, #f87171); }
  .sm-icon-orange { background: linear-gradient(135deg, #f97316, #fb923c); }
  .sm-icon-grad   { background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc); }

  .sm-item-label {
    flex: 1; font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem; font-weight: 600;
    color: #ffffff !important;
  }
  [data-theme="light"] .sm-item-label { color: #1e0f36 !important; }

  .sm-item-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; font-weight: 700;
    color: #e879f9 !important;
    background: rgba(232,121,249,0.12);
