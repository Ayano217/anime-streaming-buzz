---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Browse', href: '/browse' },
  { label: 'Manga', href: '/category/manga' },
  { label: 'News', href: '/category/news' },
  { label: 'Streaming', href: '/category/streaming' },
];
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    
    <a href="/" class="header-logo">
      <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
    </a>
    
    <nav class="header-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    
    <div class="header-right">
      
      <div class="search-inline">
        <svg class="si-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input 
          type="text" 
          id="quickSearch" 
          class="si-input" 
          placeholder="Search anime..." 
          autocomplete="off"
        />
        <button id="siClear" class="si-clear" aria-label="Clear search">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        
        <div id="searchDD" class="sdd hsr-dropdown"></div>
      </div>
      
      <button id="themeToggle" class="header-icon-btn" aria-label="Toggle theme">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      
      <button id="profileBtn" class="header-icon-btn" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span id="profileBadge" class="profile-badge" style="display:none">0</span>
      </button>
      
      <button id="mobileMenuBtn" class="header-icon-btn mobile-only" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
  
  <div id="mobileMenu" class="mobile-menu">
    <nav class="mobile-nav">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- 🎨 SLIDING SIDE MENU PANEL -->
<div id="sideMenu" class="side-menu">
  <div class="side-menu-backdrop" id="sideMenuBackdrop"></div>
  <aside class="side-menu-panel">
    
    <div class="sm-header">
      <div class="sm-avatar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <div class="sm-user-info">
        <div class="sm-username">Anime Fan</div>
        <div class="sm-user-sub">@guest_user</div>
      </div>
      <button class="sm-close" id="sideMenuClose" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="sm-scroll">
      
      <div class="sm-section">
        <div class="sm-section-label">My Content</div>
        
        <a href="/saved" class="sm-item">
          <div class="sm-item-icon sm-icon-purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="sm-item-label">Saved Videos</div>
          <span class="sm-item-count" id="countSaved">0</span>
        </a>
        
        <a href="/history" class="sm-item">
          <div class="sm-item-icon sm-icon-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="sm-item-label">Watch History</div>
          <span class="sm-item-count" id="countHistory">0</span>
        </a>
        
        <a href="/liked" class="sm-item">
          <div class="sm-item-icon sm-icon-pink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <div class="sm-item-label">Liked Videos</div>
          <span class="sm-item-count" id="countLiked">0</span>
        </a>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">Community <span class="sm-coming-badge">Soon</span></div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="sm-item-label">Global Chat</div>
          <span class="sm-live-dot"></span>
        </div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="sm-item-label">Friends & Messages</div>
        </div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="4"/>
            </svg>
          </div>
          <div class="sm-item-label">Live Users</div>
        </div>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">Settings</div>
        
        <button class="sm-item sm-item-btn" id="smThemeToggle">
          <div class="sm-item-icon sm-icon-purple">
            <svg class="sm-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg class="sm-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
            </svg>
          </div>
          <div class="sm-item-label">Switch Appearance</div>
          <span class="sm-item-tag" id="smThemeTag">Dark</span>
        </button>
        
        <button class="sm-item sm-item-btn" id="smNewsletter">
          <div class="sm-item-icon sm-icon-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="sm-item-label">Newsletter</div>
        </button>
        
        <button class="sm-item sm-item-btn" id="smClearData">
          <div class="sm-item-icon sm-icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
              <path d="M10 11v6M14 11v6"/>
            </svg>
          </div>
          <div class="sm-item-label">Clear My Data</div>
        </button>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">About</div>
        
        <a href="/about" class="sm-item">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
          </div>
          <div class="sm-item-label">About AniTubeBuzz</div>
        </a>
        
        <button class="sm-item sm-item-btn" id="smReportBtn">
          <div class="sm-item-icon sm-icon-orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <div class="sm-item-label">Report a Problem</div>
        </button>
      </div>

      <!-- Bottom safe area for Safiya -->
      <div class="sm-bottom-space"></div>

    </div>

    <div class="sm-footer">
      <div class="sm-footer-brand">
        <span class="grad-text">Ani</span><span class="sm-footer-mid">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <div class="sm-footer-tagline">Made with 💜 for anime fans</div>
    </div>

  </aside>
</div>

<div id="emailModal" class="email-modal">
  <div class="email-modal-backdrop"></div>
  <div class="email-modal-content">
    <button class="email-modal-close" id="emailModalClose" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="email-modal-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </div>
    <h3 class="email-modal-title">Join the AniTube Family</h3>
    <p class="email-modal-desc">Get weekly anime updates, exclusive news & recommendations delivered straight to your inbox.</p>
    <form id="emailForm" class="email-form">
      <input type="email" id="emailInput" class="email-input" placeholder="your@email.com" required />
      <button type="submit" class="email-submit">Subscribe</button>
    </form>
    <div id="emailSuccess" class="email-success">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span>Welcome aboard, Senpai! 💜</span>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var themeBtn = document.getElementById('themeToggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateSmThemeTag();
    });
  }
  
  function updateSmThemeTag() {
    var tag = document.getElementById('smThemeTag');
    if (tag) {
      var cur = document.documentElement.getAttribute('data-theme');
      tag.textContent = cur === 'dark' ? 'Dark' : 'Light';
    }
  }
  
  var header = document.getElementById('siteHeader');
  if (header) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 20) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    }, { passive: true });
  }
  
  var mobileBtn = document.getElementById('mobileMenuBtn');
  var mobileMenu = document.getElementById('mobileMenu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', function() {
      mobileMenu.classList.toggle('open');
    });
    mobileMenu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() { mobileMenu.classList.remove('open'); });
    });
  }
  
  var profileBtn = document.getElementById('profileBtn');
  var sideMenu = document.getElementById('sideMenu');
  var sideMenuBackdrop = document.getElementById('sideMenuBackdrop');
  var sideMenuClose = document.getElementById('sideMenuClose');
  
  function openSideMenu() {
    if (sideMenu) {
      sideMenu.classList.add('open');
      document.body.style.overflow = 'hidden';
      updateMenuCounts();
      updateSmThemeTag();
    }
  }
  function closeSideMenu() {
    if (sideMenu) {
      sideMenu.classList.remove('open');
      document.body.style.overflow = '';
    }
  }
  
  if (profileBtn) profileBtn.addEventListener('click', openSideMenu);
  if (sideMenuClose) sideMenuClose.addEventListener('click', closeSideMenu);
  if (sideMenuBackdrop) sideMenuBackdrop.addEventListener('click', closeSideMenu);
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && sideMenu && sideMenu.classList.contains('open')) {
      closeSideMenu();
    }
  });
  
  function updateMenuCounts() {
    try {
      var saved = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      var history = JSON.parse(localStorage.getItem('anitube_history') || '[]');
      var liked = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      
      var cs = document.getElementById('countSaved');
      var ch = document.getElementById('countHistory');
      var cl = document.getElementById('countLiked');
      var badge = document.getElementById('profileBadge');
      
      if (cs) cs.textContent = saved.length;
      if (ch) ch.textContent = history.length;
      if (cl) cl.textContent = liked.length;
      
      var total = saved.length + history.length + liked.length;
      if (badge && total > 0) badge.style.display = 'flex';
    } catch(e) {}
  }
  
  updateMenuCounts();
  
  var smThemeToggle = document.getElementById('smThemeToggle');
  if (smThemeToggle) {
    smThemeToggle.addEventListener('click', function() {
      if (themeBtn) themeBtn.click();
    });
  }
  
  var smNewsletter = document.getElementById('smNewsletter');
  if (smNewsletter) {
    smNewsletter.addEventListener('click', function() {
      closeSideMenu();
      setTimeout(function() {
        var em = document.getElementById('emailModal');
        if (em) em.classList.add('open');
      }, 300);
    });
  }
  
  var smClearData = document.getElementById('smClearData');
  if (smClearData) {
    smClearData.addEventListener('click', function() {
      if (confirm('Clear all your Saved, History, and Liked videos?\n\nThis cannot be undone.')) {
        localStorage.removeItem('anitube_saved');
        localStorage.removeItem('anitube_history');
        localStorage.removeItem('anitube_liked');
        localStorage.removeItem('anitube_resume_video');
        localStorage.removeItem('anitube_resume_time');
        updateMenuCounts();
        alert('✅ All your data has been cleared!');
      }
    });
  }
  
  var smReportBtn = document.getElementById('smReportBtn');
  if (smReportBtn) {
    smReportBtn.addEventListener('click', function() {
      window.location.href = 'mailto:report@anitubebuzz.com?subject=Bug Report - AniTubeBuzz';
    });
  }
  
  var emailModal = document.getElementById('emailModal');
  var emailModalClose = document.getElementById('emailModalClose');
  var emailModalBackdrop = emailModal ? emailModal.querySelector('.email-modal-backdrop') : null;
  var emailForm = document.getElementById('emailForm');
  var emailSuccess = document.getElementById('emailSuccess');
  var emailInput = document.getElementById('emailInput');
  
  function closeEmailModal() {
    if (emailModal) emailModal.classList.remove('open');
  }
  
  if (emailModalClose) emailModalClose.addEventListener('click', closeEmailModal);
  if (emailModalBackdrop) emailModalBackdrop.addEventListener('click', closeEmailModal);
  
  if (emailForm) {
    emailForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = emailInput.value.trim();
      if (!email) return;
      var subs = JSON.parse(localStorage.getItem('subscribers') || '[]');
      if (subs.indexOf(email) === -1) subs.push(email);
      localStorage.setItem('subscribers', JSON.stringify(subs));
      emailForm.style.display = 'none';
      if (emailSuccess) emailSuccess.style.display = 'flex';
      setTimeout(function() {
        closeEmailModal();
        setTimeout(function() {
          emailForm.style.display = 'flex';
          if (emailSuccess) emailSuccess.style.display = 'none';
          emailInput.value = '';
        }, 400);
      }, 2000);
    });
  }
})();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--header-bg);
    border-bottom: 1px solid var(--border-color);
    transition: all 0.3s ease;
    height: var(--header-h);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  
  .site-header.scrolled {
    background: var(--header-bg-scrolled);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }
  
  [data-theme="light"] .site-header.scrolled {
    box-shadow: 0 4px 30px rgba(168, 85, 247, 0.15);
  }
  
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }
  
  .header-logo {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .header-logo:hover { transform: scale(1.02); }
  
  .header-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }
  
  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
  }
  
  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(192, 132, 252, 0.12);
  }
  
  .nav-link.active {
    color: var(--nav-link-active-color);
    background: var(--nav-link-active-bg);
    border: 1px solid rgba(192, 132, 252, 0.4);
    box-shadow: 0 4px 12px rgba(192, 132, 252, 0.25);
  }
  
  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  
  .search-inline {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(192, 132, 252, 0.08);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0 14px;
    transition: all 0.25s ease;
    backdrop-filter: blur(10px);
    width: 260px;
  }
  
  [data-theme="light"] .search-inline {
    background: rgba(243, 232, 255, 0.7);
    border-color: rgba(192, 132, 252, 0.3);
  }
  
  .search-inline:focus-within {
    border-color: rgba(232, 121, 249, 0.7);
    box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
    background: rgba(192, 132, 252, 0.12);
  }
  
  [data-theme="light"] .search-inline:focus-within {
    background: #ffffff;
  }
  
  .si-icon { color: var(--purple); flex-shrink: 0; margin-right: 8px; }
  
  .si-input {
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.82rem;
    padding: 9px 0;
    width: 100%;
    min-width: 0;
  }
  
  .si-input::placeholder { color: var(--text-muted); opacity: 0.7; }
  
  .si-clear {
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(192, 132, 252, 0.15);
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    transition: all 0.2s ease;
    flex-shrink: 0;
    margin-left: 6px;
    padding: 0;
  }
  .si-clear:hover { background: rgba(239, 68, 68, 0.3); color: #ef4444; }
  
  .sdd {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    background: var(--bg-elevated);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 14px;
    padding: 6px;
    max-height: 450px;
    overflow-y: auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3), 0 0 25px rgba(192, 132, 252, 0.15);
    backdrop-filter: blur(20px);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.25s ease;
    min-width: 320px;
  }
  
  [data-theme="dark"] .sdd { background: rgba(15, 8, 35, 0.98); }
  
  .sdd.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--icon-btn-bg);
    border: 1px solid var(--border-color);
    color: var(--icon-btn-color);
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    position: relative;
  }
  
  .header-icon-btn:hover {
    background: rgba(192, 132, 252, 0.2);
    color: var(--text-primary);
    transform: translateY(-1px);
    border-color: rgba(192, 132, 252, 0.4);
  }
  
  .profile-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e879f9, #c084fc);
    box-shadow: 0 0 8px rgba(232, 121, 249, 0.8);
    animation: badge-pulse 2s infinite;
  }
  
  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }
  
  .theme-sun { display: none; }
  .theme-moon { display: block; }
  [data-theme="light"] .theme-sun { display: block; }
  [data-theme="light"] .theme-moon { display: none; }
  
  .mobile-only { display: none; }
  
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--header-bg-scrolled);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem;
    backdrop-filter: blur(20px);
  }
  
  .mobile-menu.open { display: block; }
  
  .mobile-nav { display: flex; flex-direction: column; gap: 4px; }
  
  .mobile-nav-link {
    padding: 12px 16px;
    border-radius: 10px;
    color: var(--text-secondary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background: rgba(192, 132, 252, 0.15);
    color: var(--text-primary);
  }
  
  /* ═══════════════════════════════════════════════════
     🎨 SIDE MENU — Theme-aware
     ═══════════════════════════════════════════════════ */
  .side-menu {
    position: fixed;
    inset: 0;
    z-index: 9999;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.4s;
  }
  
  .side-menu.open {
    visibility: visible;
    pointer-events: auto;
  }
  
  .side-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 5, 23, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  
  [data-theme="light"] .side-menu-backdrop {
    background: rgba(30, 15, 54, 0.55);
  }
  
  .side-menu.open .side-menu-backdrop { opacity: 1; }
  
  /* PANEL - theme-aware background & colors */
  .side-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 380px;
    max-width: 92vw;
    background: linear-gradient(180deg, rgba(20, 10, 40, 0.98), rgba(10, 5, 23, 0.98));
    border-left: 1px solid rgba(192, 132, 252, 0.3);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.5);
  }
  
  [data-theme="light"] .side-menu-panel {
    background: linear-gradient(180deg, #ffffff, #faf5ff);
    border-left: 1px solid rgba(168, 85, 247, 0.2);
    box-shadow: -20px 0 60px rgba(30, 15, 54, 0.15);
  }
  
  .side-menu.open .side-menu-panel { transform: translateX(0); }
  
  /* Scrollable content area */
  .sm-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 0;
  }
  
  .sm-scroll::-webkit-scrollbar { width: 4px; }
  .sm-scroll::-webkit-scrollbar-track { background: transparent; }
  .sm-scroll::-webkit-scrollbar-thumb { background: rgba(192, 132, 252, 0.3); border-radius: 4px; }
  
  /* Panel Header */
  .sm-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 20px 20px;
    border-bottom: 1px solid rgba(192, 132, 252, 0.15);
    position: relative;
    flex-shrink: 0;
  }
  
  [data-theme="light"] .sm-header {
    border-bottom-color: rgba(168, 85, 247, 0.15);
  }
  
  .sm-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 16px rgba(192, 132, 252, 0.5);
    flex-shrink: 0;
  }
  
  .sm-user-info { flex: 1; min-width: 0; }
  
  .sm-username {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }
  
  .sm-user-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 2px;
  }
  
  .sm-close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.2);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  
  [data-theme="light"] .sm-close {
    background: rgba(168, 85, 247, 0.08);
  }
  
  .sm-close:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    transform: rotate(90deg);
    border-color: rgba(239, 68, 68, 0.3);
  }
  
  /* Section */
  .sm-section {
    padding: 12px 12px;
  }
  
  .sm-section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 8px 10px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .sm-coming-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    padding: 2px 6px;
    background: linear-gradient(135deg, rgba(232, 121, 249, 0.2), rgba(192, 132, 252, 0.15));
    color: #e879f9;
    border-radius: 4px;
    letter-spacing: 0.05em;
    border: 1px solid rgba(232, 121, 249, 0.3);
    text-transform: none;
  }
  
  [data-theme="light"] .sm-coming-badge {
    background: linear-gradient(135deg, rgba(232, 121, 249, 0.15), rgba(168, 85, 247, 0.1));
    color: #a855f7;
    border-color: rgba(168, 85, 247, 0.3);
  }
  
  /* Menu Items - theme-aware */
  .sm-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-primary);
    background: transparent;
    border: none;
    width: 100%;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: all 0.2s;
    margin-bottom: 2px;
    position: relative;
  }
  
  .sm-item:hover {
    background: rgba(192, 132, 252, 0.1);
    transform: translateX(-3px);
  }
  
  [data-theme="light"] .sm-item:hover {
    background: rgba(168, 85, 247, 0.08);
  }
  
  .sm-item-disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  
  .sm-item-disabled:hover {
    background: transparent;
    transform: none;
  }
  
  .sm-item-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
  }
  
  .sm-item-icon svg { width: 18px; height: 18px; }
  
  .sm-icon-purple { background: linear-gradient(135deg, #a855f7, #c084fc); }
  .sm-icon-pink { background: linear-gradient(135deg, #ec4899, #e879f9); }
  .sm-icon-cyan { background: linear-gradient(135deg, #06b6d4, #7dd3fc); }
  .sm-icon-red { background: linear-gradient(135deg, #ef4444, #f87171); }
  .sm-icon-orange { background: linear-gradient(135deg, #f97316, #fb923c); }
  .sm-icon-grad { background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc); }
  
  .sm-item-label {
    flex: 1;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  
  .sm-item-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e879f9;
    background: rgba(232, 121, 249, 0.12);
    padding: 3px 8px;
    border-radius: 8px;
    min-width: 26px;
    text-align: center;
  }
  
  [data-theme="light"] .sm-item-count {
    color: #a855f7;
    background: rgba(168, 85, 247, 0.1);
  }
  
  .sm-item-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: rgba(192, 132, 252, 0.08);
    padding: 3px 8px;
    border-radius: 8px;
    border: 1px solid rgba(192, 132, 252, 0.2);
  }
  
  [data-theme="light"] .sm-item-tag {
    background: rgba(168, 85, 247, 0.08);
    border-color: rgba(168, 85, 247, 0.2);
  }
  
  .sm-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: badge-pulse 2s infinite;
  }
  
  .sm-theme-sun { display: none; }
  .sm-theme-moon { display: block; }
  [data-theme="light"] .sm-theme-sun { display: block; }
  [data-theme="light"] .sm-theme-moon { display: none; }
  
  /* Divider */
  .sm-divider {
    height: 1px;
    margin: 4px 20px;
    background: linear-gradient(90deg, transparent, rgba(192, 132, 252, 0.2), transparent);
  }
  
  [data-theme="light"] .sm-divider {
    background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.18), transparent);
  }
  
  /* Bottom safe area for Safiya overlap */
  .sm-bottom-space {
    height: 120px; /* Safiya pill height + safe padding */
  }
  
  /* Panel Footer - FIXED at bottom, Safiya-safe */
  .sm-footer {
    padding: 16px 20px 20px;
    border-top: 1px solid rgba(192, 132, 252, 0.15);
    text-align: center;
    background: inherit;
    flex-shrink: 0;
    /* On desktop, add bottom margin so Safiya sits below */
    margin-bottom: 90px;
  }
  
  [data-theme="light"] .sm-footer {
    border-top-color: rgba(168, 85, 247, 0.15);
  }
  
  .sm-footer-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  
  .sm-footer-mid { color: var(--text-primary); }
  
  .sm-footer-tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
  
  /* EMAIL MODAL - theme aware */
  .email-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  
  .email-modal.open {
    display: flex;
    animation: fadeIn 0.3s ease;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  .email-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 5, 23, 0.85);
    backdrop-filter: blur(8px);
  }
  
  [data-theme="light"] .email-modal-backdrop {
    background: rgba(30, 15, 54, 0.6);
  }
  
  .email-modal-content {
    position: relative;
    background: linear-gradient(135deg, rgba(28, 15, 61, 0.98), rgba(36, 21, 72, 0.98));
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 24px;
    padding: 2.5rem 2rem 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 40px rgba(192, 132, 252, 0.2);
    animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  [data-theme="light"] .email-modal-content {
    background: linear-gradient(135deg, #ffffff, #faf5ff);
    border-color: rgba(168, 85, 247, 0.25);
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .email-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(192, 132, 252, 0.15);
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  
  .email-modal-close:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    transform: rotate(90deg);
  }
  
  .email-modal-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 10px 30px rgba(192, 132, 252, 0.5);
  }
  
  .email-modal-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  
  .email-modal-desc {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }
  
  .email-form { display: flex; gap: 8px; flex-direction: column; }
  
  .email-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(10, 5, 23, 0.6);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 12px;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;
    transition: all 0.2s ease;
  }
  
  [data-theme="light"] .email-input {
    background: rgba(243, 232, 255, 0.5);
    border-color: rgba(168, 85, 247, 0.3);
  }
  
  .email-input:focus {
    border-color: rgba(232, 121, 249, 0.7);
  }
  
  .email-input::placeholder { color: var(--text-muted); }
  
  .email-submit {
    width: 100%;
    padding: 12px 20px;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    border: none;
    border-radius: 12px;
    color: #fff;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 8px 25px rgba(192, 132, 252, 0.4);
  }
  
  .email-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(192, 132, 252, 0.6);
  }
  
  .email-success {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    color: #10b981;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
  }
  
  /* SEARCH RESULTS */
  .hsr-hint {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 12px 6px;
    color: #e879f9;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  
  .hsr-loading {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; padding: 2rem 1rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }
  
  .hsr-empty {
    display: flex; align-items: center; gap: 12px;
    padding: 16px;
    color: var(--text-muted);
  }
  .hsr-empty > svg { color: #c084fc; flex-shrink: 0; width: 22px; height: 22px; }
  .hsr-empty-t { font-family: 'Bricolage Grotesque', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .hsr-empty-s { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; opacity: 0.7; }
  
  .sd-i {
    display: grid !important;
    grid-template-columns: 40px 1fr auto !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 8px 10px !important;
    border-radius: 10px !important;
    text-decoration: none !important;
    color: var(--text-primary) !important;
    transition: all 0.2s ease !important;
    margin-bottom: 2px !important;
    position: relative !important;
    overflow: hidden !important;
  }
  .sd-i::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, #c084fc, #e879f9, #7dd3fc);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .sd-i:hover {
    background: rgba(192, 132, 252, 0.12) !important;
    transform: translateX(4px) !important;
  }
  .sd-i:hover::before { opacity: 1; }
  
  .sd-th {
    width: 40px !important;
    height: 52px !important;
    min-width: 40px !important;
    max-width: 40px !important;
    max-height: 52px !important;
    border-radius: 5px !important;
    overflow: hidden !important;
    background: rgba(192, 132, 252, 0.15) !important;
    display: block !important;
    position: relative !important;
    flex-shrink: 0 !important;
  }
  .sd-th img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 40px !important;
    height: 52px !important;
    max-width: 40px !important;
    max-height: 52px !important;
    object-fit: cover !important;
    display: block !important;
    aspect-ratio: auto !important;
  }
  .sd-no { width: 100%; height: 100%; background: linear-gradient(135deg, rgba(192,132,252,0.2), rgba(125,211,252,0.15)); }
  
  .sd-inf { min-width: 0; overflow: hidden; }
  .sd-t {
    font-family: 'Bricolage Grotesque', sans-serif !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin: 0 0 2px 0 !important;
    color: var(--text-primary) !important;
    line-height: 1.2 !important;
  }
  .sd-m {
    font-size: 0.65rem !important;
    color: var(--text-muted) !important;
    font-family: 'JetBrains Mono', monospace !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    line-height: 1.2 !important;
  }
  .sd-g { display: none; }
  
  .sd-badge {
    padding: 2px 6px !important;
    background: linear-gradient(135deg, #ef4444, #f97316) !important;
    color: #fff !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.5rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.03em !important;
    border-radius: 3px !important;
    box-shadow: 0 2px 4px rgba(239, 68, 68, 0.4) !important;
    align-self: center !important;
    flex-shrink: 0 !important;
  }
  
  .sd-more {
    grid-template-columns: 1fr !important;
    justify-content: center !important;
    border-top: 1px solid rgba(192, 132, 252, 0.15) !important;
    margin-top: 4px !important;
    padding: 10px 12px !important;
    color: #c084fc !important;
    font-size: 0.75rem !important;
    font-weight: 700 !important;
