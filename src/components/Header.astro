  [data-theme="light"] .sm-header { border-bottom-color: rgba(168,85,247,0.15); }

  .sm-avatar {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    display: flex; align-items: center; justify-content: center;
