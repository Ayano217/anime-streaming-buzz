---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Browse', href: '/browse' },
  { label: 'Manga', href: '/category/manga' },
  { label: 'News', href: '/category/news' },
  { label: 'Streaming', href: '/category/streaming' },
];
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    
    <a href="/" class="header-logo">
      <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
    </a>
    
    <nav class="header-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    
    <div class="header-right">
      
      <div class="search-inline" id="searchWrap">
        <svg class="si-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input 
          type="text" 
          id="quickSearch" 
          class="si-input" 
          placeholder="Search or paste link..." 
          autocomplete="off"
          spellcheck="false"
        />
        <div id="siSpinner" class="si-spinner" style="display:none">
          <div class="si-spin-ring"></div>
        </div>
        <button id="siClear" class="si-clear" aria-label="Clear search" style="display:none">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        <div id="searchDD" class="sdd"></div>
      </div>
      
      <button id="themeToggle" class="header-icon-btn" aria-label="Toggle theme">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      
      <button id="profileBtn" class="header-icon-btn" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span id="profileBadge" class="profile-badge" style="display:none">0</span>
      </button>
      
      <button id="mobileMenuBtn" class="header-icon-btn mobile-only" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
  
  <div id="mobileMenu" class="mobile-menu">
    <div class="mobile-search-wrap">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="color:rgba(192,132,252,0.7);flex-shrink:0">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="text" id="mobileSearch" class="mobile-search-input" placeholder="Search anime or paste link..." autocomplete="off" spellcheck="false" />
    </div>
    <nav class="mobile-nav">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- URL Resolve Toast -->
<div id="urlToast" class="url-toast" style="display:none">
  <div class="url-toast-inner">
    <div class="url-toast-spin"></div>
    <div class="url-toast-text">
      <span class="url-toast-title" id="urlToastTitle">Detecting anime...</span>
      <span class="url-toast-sub" id="urlToastSub">Analyzing link with AI</span>
    </div>
    <button class="url-toast-cancel" id="urlToastCancel" aria-label="Cancel">✕</button>
  </div>
</div>

<!-- 🎨 SLIDING SIDE MENU PANEL -->
<div id="sideMenu" class="side-menu">
  <div class="side-menu-backdrop" id="sideMenuBackdrop"></div>
  <aside class="side-menu-panel">
    
    <div class="sm-header">
      <div class="sm-avatar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <div class="sm-user-info">
        <div class="sm-username" id="smUsername">Anime Fan</div>
        <div class="sm-user-sub" id="smUserSub">@guest_user</div>
      </div>
      <button class="sm-close" id="sideMenuClose" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="sm-scroll">
      
      <div class="sm-section">
        <div class="sm-section-label">My Content</div>
        
        <a href="/saved" class="sm-item">
          <div class="sm-item-icon sm-icon-purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="sm-item-label">Saved Videos</div>
          <span class="sm-item-count" id="countSaved">0</span>
        </a>
        
        <a href="/history" class="sm-item">
          <div class="sm-item-icon sm-icon-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="sm-item-label">Watch History</div>
          <span class="sm-item-count" id="countHistory">0</span>
        </a>
        
        <a href="/liked" class="sm-item">
          <div class="sm-item-icon sm-icon-pink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <div class="sm-item-label">Liked Videos</div>
          <span class="sm-item-count" id="countLiked">0</span>
        </a>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">Community <span class="sm-coming-badge">Soon</span></div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="sm-item-label">Global Chat</div>
          <span class="sm-live-dot"></span>
        </div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="sm-item-label">Friends & Messages</div>
        </div>
        
        <div class="sm-item sm-item-disabled">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="4"/>
            </svg>
          </div>
          <div class="sm-item-label">Live Users</div>
        </div>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">Settings</div>
        
        <button class="sm-item sm-item-btn" id="smThemeToggle">
          <div class="sm-item-icon sm-icon-purple">
            <svg class="sm-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg class="sm-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
            </svg>
          </div>
          <div class="sm-item-label">Switch Appearance</div>
          <span class="sm-item-tag" id="smThemeTag">Dark</span>
        </button>
        
        <button class="sm-item sm-item-btn" id="smNewsletter">
          <div class="sm-item-icon sm-icon-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="sm-item-label">Newsletter</div>
        </button>
        
        <button class="sm-item sm-item-btn" id="smClearData">
          <div class="sm-item-icon sm-icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
              <path d="M10 11v6M14 11v6"/>
            </svg>
          </div>
          <div class="sm-item-label">Clear My Data</div>
        </button>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">About</div>
        
        <a href="/about" class="sm-item">
          <div class="sm-item-icon sm-icon-grad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
          </div>
          <div class="sm-item-label">About AniTubeBuzz</div>
        </a>
        
        <button class="sm-item sm-item-btn" id="smReportBtn">
          <div class="sm-item-icon sm-icon-orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <div class="sm-item-label">Report a Problem</div>
        </button>
      </div>

      <div class="sm-bottom-space"></div>

    </div>

    <div class="sm-footer">
      <div class="sm-footer-brand">
        <span class="grad-text">Ani</span><span class="sm-footer-mid">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <div class="sm-footer-tagline">Made with 💜 for anime fans</div>
    </div>

  </aside>
</div>

<div id="emailModal" class="email-modal">
  <div class="email-modal-backdrop"></div>
  <div class="email-modal-content">
    <button class="email-modal-close" id="emailModalClose" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="email-modal-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </div>
    <h3 class="email-modal-title">Join the AniTube Family</h3>
    <p class="email-modal-desc">Get weekly anime updates, exclusive news & recommendations delivered straight to your inbox.</p>
    <form id="emailForm" class="email-form">
      <input type="email" id="emailInput" class="email-input" placeholder="your@email.com" required />
      <button type="submit" class="email-submit">Subscribe</button>
    </form>
    <div id="emailSuccess" class="email-success">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span>Welcome aboard, Senpai! 💜</span>
    </div>
  </div>
</div>

<script is:inline>
(function() {

  function $(id) { return document.getElementById(id); }

  function isUrl(str) {
    var s = str.trim();
    return s.startsWith('http://') || s.startsWith('https://') ||
           s.startsWith('www.') ||
           s.indexOf('facebook.com') !== -1 ||
           s.indexOf('fb.watch') !== -1 ||
           s.indexOf('youtu.be') !== -1 ||
           s.indexOf('youtube.com') !== -1 ||
           s.indexOf('dailymotion.com') !== -1 ||
           s.indexOf('bilibili.com') !== -1;
  }

  function esc(s) {
    if (!s) return '';
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
  }

  /* THEME */
  var themeBtn = $('themeToggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateSmThemeTag();
    });
  }

  function updateSmThemeTag() {
    var tag = $('smThemeTag');
    if (tag) {
      var cur = document.documentElement.getAttribute('data-theme');
      tag.textContent = cur === 'dark' ? 'Dark' : 'Light';
    }
  }

  /* SCROLL */
  var header = $('siteHeader');
  if (header) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 20) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    }, { passive: true });
  }

  /* MOBILE MENU */
  var mobileBtn = $('mobileMenuBtn');
  var mobileMenu = $('mobileMenu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', function() {
      mobileMenu.classList.toggle('open');
    });
    mobileMenu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() { mobileMenu.classList.remove('open'); });
    });
  }

  /* SIDE MENU */
  var sideMenu = $('sideMenu');
  var sideMenuBackdrop = $('sideMenuBackdrop');
  var sideMenuClose = $('sideMenuClose');

  function openSideMenu() {
    if (!sideMenu) return;
    sideMenu.classList.add('open');
    document.body.style.overflow = 'hidden';
    updateMenuCounts();
    updateSmThemeTag();
    loadUsername();
  }
  function closeSideMenu() {
    if (!sideMenu) return;
    sideMenu.classList.remove('open');
    document.body.style.overflow = '';
  }

  var profileBtn = $('profileBtn');
  if (profileBtn) profileBtn.addEventListener('click', openSideMenu);
  if (sideMenuClose) sideMenuClose.addEventListener('click', closeSideMenu);
  if (sideMenuBackdrop) sideMenuBackdrop.addEventListener('click', closeSideMenu);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (sideMenu && sideMenu.classList.contains('open')) closeSideMenu();
      closeSearchDD();
    }
  });

  function loadUsername() {
    try {
      var un = localStorage.getItem('anitube_username');
      var uEl = $('smUsername');
      var subEl = $('smUserSub');
      if (un && uEl) {
        uEl.textContent = un;
        if (subEl) subEl.textContent = '@' + un.toLowerCase().replace(/\s+/g, '_');
      }
    } catch(e) {}
  }

  function updateMenuCounts() {
    try {
      var saved = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      var hist = JSON.parse(localStorage.getItem('anitube_history') || '[]');
      var liked = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      var cs = $('countSaved'), ch = $('countHistory'), cl = $('countLiked');
      var badge = $('profileBadge');
      if (cs) cs.textContent = saved.length;
      if (ch) ch.textContent = hist.length;
      if (cl) cl.textContent = liked.length;
      var total = saved.length + hist.length + liked.length;
      if (badge) badge.style.display = total > 0 ? 'flex' : 'none';
    } catch(e) {}
  }
  updateMenuCounts();

  var smThemeToggle = $('smThemeToggle');
  if (smThemeToggle) {
    smThemeToggle.addEventListener('click', function() {
      if (themeBtn) themeBtn.click();
    });
  }

  var smNewsletter = $('smNewsletter');
  if (smNewsletter) {
    smNewsletter.addEventListener('click', function() {
      closeSideMenu();
      setTimeout(function() {
        var em = $('emailModal');
        if (em) em.classList.add('open');
      }, 300);
    });
  }

  var smClearData = $('smClearData');
  if (smClearData) {
    smClearData.addEventListener('click', function() {
      if (confirm('Clear all your Saved, History, and Liked videos?\n\nThis cannot be undone.')) {
        localStorage.removeItem('anitube_saved');
        localStorage.removeItem('anitube_history');
        localStorage.removeItem('anitube_liked');
        localStorage.removeItem('anitube_resume_video');
        localStorage.removeItem('anitube_resume_time');
        updateMenuCounts();
        alert('All your data has been cleared!');
      }
    });
  }

  var smReportBtn = $('smReportBtn');
  if (smReportBtn) {
    smReportBtn.addEventListener('click', function() {
      window.location.href = 'mailto:report@anitubebuzz.com?subject=Bug Report - AniTubeBuzz';
    });
  }

  /* EMAIL MODAL */
  var emailModal = $('emailModal');
  var emailModalClose = $('emailModalClose');
  var emailModalBackdrop = emailModal ? emailModal.querySelector('.email-modal-backdrop') : null;
  var emailForm = $('emailForm');
  var emailSuccess = $('emailSuccess');
  var emailInput = $('emailInput');

  function closeEmailModal() { if (emailModal) emailModal.classList.remove('open'); }
  if (emailModalClose) emailModalClose.addEventListener('click', closeEmailModal);
  if (emailModalBackdrop) emailModalBackdrop.addEventListener('click', closeEmailModal);

  if (emailForm) {
    emailForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = emailInput ? emailInput.value.trim() : '';
      if (!email) return;
      try {
        var subs = JSON.parse(localStorage.getItem('subscribers') || '[]');
        if (subs.indexOf(email) === -1) subs.push(email);
        localStorage.setItem('subscribers', JSON.stringify(subs));
      } catch(ex) {}
      if (emailForm) emailForm.style.display = 'none';
      if (emailSuccess) emailSuccess.style.display = 'flex';
      setTimeout(function() {
        closeEmailModal();
        setTimeout(function() {
          if (emailForm) emailForm.style.display = 'flex';
          if (emailSuccess) emailSuccess.style.display = 'none';
          if (emailInput) emailInput.value = '';
        }, 400);
      }, 2000);
    });
  }

  /* ═══════════════════════════════════════
     🔍 SEARCH — Compact, home-page style
  ═══════════════════════════════════════ */
  var searchInput = $('quickSearch');
  var searchDD = $('searchDD');
  var siClear = $('siClear');
  var siSpinner = $('siSpinner');

  var searchCache = {};
  var searchTimer = null;
  var activeCtrl = null;

  function showSpinner() { if (siSpinner) siSpinner.style.display = 'flex'; }
  function hideSpinner() { if (siSpinner) siSpinner.style.display = 'none'; }
  function openSearchDD() { if (searchDD) searchDD.classList.add('open'); }
  function closeSearchDD() {
    if (searchDD) searchDD.classList.remove('open');
    hideSpinner();
  }
  function showClear(show) { if (siClear) siClear.style.display = show ? 'flex' : 'none'; }

  if (siClear) {
    siClear.addEventListener('click', function() {
      if (searchInput) { searchInput.value = ''; searchInput.focus(); }
      showClear(false);
      closeSearchDD();
      if (searchDD) searchDD.innerHTML = '';
    });
  }

  document.addEventListener('click', function(e) {
    var wrap = $('searchWrap');
    if (wrap && !wrap.contains(e.target)) closeSearchDD();
  });

  /* URL TOAST */
  var urlToast = $('urlToast');
  var urlToastTitle = $('urlToastTitle');
  var urlToastSub = $('urlToastSub');
  var urlToastCancel = $('urlToastCancel');
  var urlResolveCtrl = null;

  function showUrlToast(title, sub) {
    if (!urlToast) return;
    if (urlToastTitle) urlToastTitle.textContent = title || 'Detecting anime...';
    if (urlToastSub) urlToastSub.textContent = sub || 'Analyzing with AI...';
    urlToast.style.display = 'flex';
    requestAnimationFrame(function() { urlToast.classList.add('visible'); });
  }
  function hideUrlToast() {
    if (!urlToast) return;
    urlToast.classList.remove('visible');
    setTimeout(function() { urlToast.style.display = 'none'; }, 350);
  }
  if (urlToastCancel) {
    urlToastCancel.addEventListener('click', function() {
      if (urlResolveCtrl) { urlResolveCtrl.abort(); urlResolveCtrl = null; }
      hideUrlToast();
    });
  }

  function resolveUrl(url) {
    if (urlResolveCtrl) urlResolveCtrl.abort();
    urlResolveCtrl = new AbortController();
    showUrlToast('Detecting anime...', 'AI is analyzing the link');
    closeSearchDD();

    fetch('/api/link-resolver?url=' + encodeURIComponent(url), {
      signal: urlResolveCtrl.signal
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data && data.success && data.redirectUrl) {
        showUrlToast('Found: ' + (data.title || 'Anime'), 'Redirecting...');
        setTimeout(function() {
          hideUrlToast();
          window.location.href = data.redirectUrl;
        }, 700);
      } else {
        hideUrlToast();
        showUrlResolveFail(url);
      }
    })
    .catch(function(err) {
      if (err && err.name === 'AbortError') return;
      hideUrlToast();
      showUrlResolveFail(url);
    });
  }

  function showUrlResolveFail(url) {
    if (!searchDD) return;
    var platform = 'Unknown';
    if (url.indexOf('facebook') !== -1 || url.indexOf('fb.watch') !== -1) platform = 'Facebook';
    else if (url.indexOf('youtube') !== -1 || url.indexOf('youtu.be') !== -1) platform = 'YouTube';
    else if (url.indexOf('dailymotion') !== -1) platform = 'Dailymotion';

    searchDD.innerHTML =
      '<div class="hsr-empty">' +
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
      '<div><div class="hsr-empty-t">Could not detect anime</div>' +
      '<div class="hsr-empty-s">' + platform + ' — try different link</div></div>' +
      '</div>';
    openSearchDD();
  }

  /* RENDER SEARCH RESULTS */
  function renderSearchResults(results, query) {
    if (!searchDD) return;
    if (!results || results.length === 0) {
      searchDD.innerHTML =
        '<div class="hsr-empty">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' +
        '<div><div class="hsr-empty-t">No results for "' + esc(query) + '"</div>' +
        '<div class="hsr-empty-s">Try different spelling</div></div>' +
        '</div>';
      openSearchDD();
      return;
    }

    var html = '<div class="hsr-hint">' + results.length + ' results</div>';

    results.slice(0, 5).forEach(function(item) {
      var thumb = item.image || item.thumbnail || item.poster || '';
      var title = item.title || item.name || 'Unknown';
      var year = item.year || '';
      var eps = item.episodeCount ? item.episodeCount + ' EP' : '';
      var rating = item.rating || item.score || '';
      var metaParts = [];
      if (year) metaParts.push(year);
      if (eps) metaParts.push(eps);
      var meta = metaParts.join(' · ');
      var slug = item.slug || item.id || title.toLowerCase().replace(/[^a-z0-9]+/g,'-');
      var href = '/reels/anime_' + encodeURIComponent(slug) + '_ep1';
      var isNew = item.status === 'current' || item.status === 'airing';

      html += '<a href="' + href + '" class="sd-card">';
      html += '<div class="sd-thumb">';
      if (thumb) {
        html += '<img src="' + esc(thumb) + '" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display=\'none\'">';
      }
      if (isNew) html += '<span class="sd-new">NEW</span>';
      html += '</div>';
      html += '<div class="sd-body">';
      html += '<div class="sd-title">' + esc(title) + '</div>';
      html += '<div class="sd-meta">';
      if (rating) html += '<span class="sd-rating">★ ' + rating + '</span>';
      if (meta) html += '<span class="sd-dot">·</span><span>' + esc(meta) + '</span>';
      html += '</div>';
      html += '</div>';
      html += '</a>';
    });

    if (results.length > 5) {
      html += '<a href="/search?q=' + encodeURIComponent(query) + '" class="sd-viewall">View all ' + results.length + ' results →</a>';
    }

    searchDD.innerHTML = html;
    openSearchDD();
  }

  function doTextSearch(query) {
    if (searchCache[query]) {
      renderSearchResults(searchCache[query], query);
      return;
    }
    if (activeCtrl) activeCtrl.abort();
    activeCtrl = new AbortController();
    showSpinner();

    searchDD.innerHTML = '<div class="hsr-loading"><div class="hsr-spin"></div><span>Searching...</span></div>';
    openSearchDD();

    fetch('/api/anime-external?action=search&q=' + encodeURIComponent(query), {
      signal: activeCtrl.signal
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      hideSpinner();
      var results = (data && data.results) ? data.results : (Array.isArray(data) ? data : []);
      searchCache[query] = results;
      renderSearchResults(results, query);
    })
    .catch(function(err) {
      if (err && err.name === 'AbortError') return;
      hideSpinner();
      searchDD.innerHTML =
        '<div class="hsr-empty">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
        '<div><div class="hsr-empty-t">Search failed</div>' +
        '<div class="hsr-empty-s">Please try again</div></div>' +
        '</div>';
      openSearchDD();
    });
  }

  /* INPUT HANDLER */
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var val = searchInput.value.trim();
      showClear(val.length > 0);

      if (!val) {
        closeSearchDD();
        if (searchDD) searchDD.innerHTML = '';
        clearTimeout(searchTimer);
        return;
      }

      if (isUrl(val)) {
        clearTimeout(searchTimer);
        if (searchDD) {
          searchDD.innerHTML =
            '<div class="hsr-hint">🔗 Link detected</div>' +
            '<a href="#" class="sd-linkbtn" id="resolveNowBtn">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' +
            '<span>Find anime from this link</span>' +
            '</a>';
          openSearchDD();
          var resolveBtn = document.getElementById('resolveNowBtn');
          if (resolveBtn) {
            resolveBtn.addEventListener('click', function(e) {
              e.preventDefault();
              closeSearchDD();
              resolveUrl(val);
            });
          }
        }
        return;
      }

      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() {
        if (val.length >= 2) doTextSearch(val);
      }, 400);
    });

    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var val = searchInput.value.trim();
        if (!val) return;
        if (isUrl(val)) {
          closeSearchDD();
          resolveUrl(val);
        } else if (val.length >= 2) {
          window.location.href = '/search?q=' + encodeURIComponent(val);
        }
      }
      if (e.key === 'Escape') { closeSearchDD(); searchInput.blur(); }
    });

    searchInput.addEventListener('focus', function() {
      var val = searchInput.value.trim();
      if (val && searchDD && searchDD.innerHTML.trim()) openSearchDD();
    });
  }

  /* MOBILE SEARCH */
  var mobileSearchInput = $('mobileSearch');
  if (mobileSearchInput) {
    mobileSearchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var val = mobileSearchInput.value.trim();
        if (!val) return;
        if (isUrl(val)) {
          if (mobileMenu) mobileMenu.classList.remove('open');
          resolveUrl(val);
        } else if (val.length >= 2) {
          window.location.href = '/search?q=' + encodeURIComponent(val);
        }
      }
    });
  }

})();
</script>

