---
const navLinks = [
  { name: "Home",      href: "/" },
  { name: "Anime",     href: "/category/anime-recap" },
  { name: "Manhwa",    href: "/category/manhwa" },
  { name: "News",      href: "/category/news" },
  { name: "Streaming", href: "/category/streaming" },
  { name: "Gaming",    href: "/category/gaming" },
];
---

<header class="header" id="siteHeader">
  <div class="header-inner container">

    <!-- Logo -->
    <a href="/" class="logo">
      <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
    </a>

    <!-- Nav -->
    <nav class="nav">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.name}</a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="actions">
      <a href="/search" class="icon-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-3.5-3.5"/>
        </svg>
      </a>

      <button class="icon-btn" id="themeToggle" aria-label="Toggle theme" type="button">
        <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>

      <button class="mob-btn" id="mobBtn" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mob-drawer" id="mobDrawer">
    {navLinks.map(link => (
      <a href={link.href} class="mob-link">{link.name}</a>
    ))}
    <a href="/search" class="mob-link">Search</a>
  </div>
</header>

<div style="height: var(--header-h);"></div>

<style>
  .header {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: var(--header-h);
    z-index: 1000;
    background: var(--bg-glass);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid var(--border-color);
    transition: all 0.25s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 20px;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .logo:hover { transform: scale(1.03); }

  .nav {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  .nav-link {
    display: block;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
    position: relative;
  }

  .nav-link:hover {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-btn {
    width: 40px; height: 40px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    font-family: inherit;
  }

  .icon-btn:hover {
    border-color: rgba(255, 51, 102, 0.5);
    background: rgba(255, 51, 102, 0.06);
    color: transparent;
    background-image: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .icon-btn:hover svg { stroke: url(#gradStroke); }

  .ico-sun { display: none; }
  [data-theme="light"] .ico-moon { display: none; }
  [data-theme="light"] .ico-sun  { display: block; }

  /* Mobile button */
  .mob-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 40px; height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: transparent;
    cursor: pointer;
  }

  .mob-btn span {
    width: 18px; height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  .mob-btn.active span:nth-child(1) { transform: rotate(45deg) translate(4px, 5px); }
  .mob-btn.active span:nth-child(2) { opacity: 0; }
  .mob-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(4px, -5px); }

  /* Mobile drawer */
  .mob-drawer {
    display: none;
    position: fixed;
    top: var(--header-h); left: 0;
    width: 100%;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 12px;
    z-index: 999;
    flex-direction: column;
    gap: 3px;
  }

  .mob-drawer.active { display: flex; }

  .mob-link {
    padding: 13px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .mob-link:hover {
    background: rgba(255, 51, 102, 0.06);
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (max-width: 900px) {
    .nav { display: none; }
    .mob-btn { display: flex; }
  }

  @media (max-width: 480px) {
    .logo { font-size: 1.25rem; }
  }
</style>

<script is:inline>
  (function() {
    var toggle = document.getElementById('themeToggle');
    if(toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        var html = document.documentElement;
        var current = html.getAttribute('data-theme') || 'dark';
        var next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }

    var mobBtn = document.getElementById('mobBtn');
    var drawer = document.getElementById('mobDrawer');
    if(mobBtn && drawer) {
      mobBtn.addEventListener('click', function() {
        mobBtn.classList.toggle('active');
        drawer.classList.toggle('active');
      });
    }

    document.querySelectorAll('.mob-link').forEach(function(link) {
      link.addEventListener('click', function() {
        if(mobBtn) mobBtn.classList.remove('active');
        if(drawer) drawer.classList.remove('active');
      });
    });
  })();
</script>
