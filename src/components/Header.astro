    -webkit-box-orient: vertical; overflow: hidden;
  }
  [data-theme="light"] .sd-title { color: #1e0f36; }
  
  .sd-caption {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-style: italic;
  }
  [data-theme="light"] .sd-caption { color: rgba(30,15,54,0.6); }
  
  .sd-meta {
    display: flex; align-items: center; gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase; letter-spacing: 0.02em;
    flex-wrap: wrap;
  }
  [data-theme="light"] .sd-meta { color: rgba(30,15,54,0.55); }
  .sd-rating { color: #fbbf24; font-weight: 700; }
  .sd-dot { opacity: 0.4; }
  
  .sd-ep {
    padding: 2px 7px;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: #fff !important;
    font-weight: 800;
    border-radius: 4px;
    font-size: 0.6rem;
  }
  
  .sd-link-match {
    color: #10b981;
    font-weight: 700;
  }

  .sd-linkbtn {
    display: flex; align-items: center; gap: 12px;
    padding: 14px;
    border-radius: 10px;
    text-decoration: none;
    color: #ffffff;
    background: linear-gradient(135deg, rgba(232,121,249,0.15), rgba(192,132,252,0.1));
    border: 1px solid rgba(232,121,249,0.3);
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9rem; font-weight: 700;
  }
  .sd-linkbtn:hover { background: linear-gradient(135deg, rgba(232,121,249,0.25), rgba(192,132,252,0.18)); }
  .sd-linkbtn svg { color: #e879f9; flex-shrink: 0; }
  [data-theme="light"] .sd-linkbtn { color: #1e0f36; }

  /* URL TOAST */
  .url-toast {
    position: fixed;
    bottom: 90px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  .url-toast.visible {
    opacity: 1; transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .url-toast-inner {
    display: flex; align-items: center; gap: 12px;
    background: rgba(20,9,42,0.95);
    border: 1px solid rgba(192,132,252,0.4);
    border-radius: 14px;
    padding: 12px 16px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    backdrop-filter: blur(15px);
    min-width: 260px;
  }
  [data-theme="light"] .url-toast-inner {
    background: rgba(255,255,255,0.96);
    border-color: rgba(168,85,247,0.3);
  }
  .url-toast-spin {
    width: 18px; height: 18px; flex-shrink: 0;
    border: 2px solid rgba(192,132,252,0.3);
    border-top-color: #e879f9;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  .url-toast-text { flex: 1; min-width: 0; }
  .url-toast-title {
    display: block;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.85rem; font-weight: 700;
    color: #fff; line-height: 1.2;
  }
  [data-theme="light"] .url-toast-title { color: #1e0f36; }
  .url-toast-sub {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: rgba(255,255,255,0.6);
    margin-top: 2px;
  }
  [data-theme="light"] .url-toast-sub { color: rgba(30,15,54,0.6); }
  .url-toast-cancel {
    background: rgba(192,132,252,0.15);
    border: none; color: rgba(255,255,255,0.6);
    cursor: pointer;
    width: 24px; height: 24px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  [data-theme="light"] .url-toast-cancel { color: rgba(30,15,54,0.6); }

  /* ICONS */
  .header-icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--icon-btn-bg);
    border: 1px solid var(--border-color);
    color: var(--icon-btn-color);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0; position: relative;
  }
  .header-icon-btn:hover {
    background: rgba(192,132,252,0.2);
    color: var(--text-primary);
    border-color: rgba(192,132,252,0.4);
  }
  .profile-badge {
    position: absolute; top: -2px; right: -2px;
    min-width: 8px; height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e879f9, #c084fc);
    box-shadow: 0 0 6px rgba(232,121,249,0.6);
  }

  .theme-sun { display: none; }
  .theme-moon { display: block; }
  [data-theme="light"] .theme-sun { display: block; }
  [data-theme="light"] .theme-moon { display: none; }

  /* MOBILE */
  .mobile-only { display: none; }
  
  .mobile-search-bar {
    display: none;
    padding: 8px 12px 10px;
    border-top: 1px solid var(--border-color);
    background: var(--header-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  
  .msb-inner {
    position: relative;
    display: flex; align-items: center;
    background: rgba(192,132,252,0.1);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0 14px;
    transition: border-color 0.2s;
  }
  [data-theme="light"] .msb-inner {
    background: rgba(243,232,255,0.7);
    border-color: rgba(192,132,252,0.3);
  }
  .msb-inner:focus-within {
    border-color: rgba(232,121,249,0.6);
    box-shadow: 0 0 0 2px rgba(192,132,252,0.15);
  }
  
  .msb-input {
    flex: 1;
    background: none; border: none; outline: none;
    color: var(--text-primary);
    font-family: inherit; font-size: 0.9rem;
    padding: 11px 8px;
    min-width: 0;
  }
  .msb-input::placeholder { color: var(--text-muted); opacity: 0.7; }

  .mobile-menu {
    display: none;
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--header-bg-scrolled);
    border-bottom: 1px solid var(--border-color);
    padding: 12px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .mobile-menu.open { display: block; }
  .mobile-nav { display: flex; flex-direction: column; gap: 2px; }
  .mobile-nav-link {
    padding: 11px 14px; border-radius: 10px;
    color: var(--text-secondary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    text-decoration: none;
  }
  .mobile-nav-link:hover, .mobile-nav-link.active {
    background: rgba(192,132,252,0.14);
    color: var(--text-primary);
  }

  /* SIDE MENU */
  .side-menu {
    position: fixed; inset: 0;
    z-index: 9999;
    visibility: hidden; pointer-events: none;
    transition: visibility 0.4s;
  }
  .side-menu.open { visibility: visible; pointer-events: auto; }
  .side-menu-backdrop {
    position: absolute; inset: 0;
    background: rgba(10,5,23,0.7);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  [data-theme="light"] .side-menu-backdrop { background: rgba(30,15,54,0.5); }
  .side-menu.open .side-menu-backdrop { opacity: 1; }
  .side-menu-panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 340px; max-width: 92vw;
    background: linear-gradient(180deg, #14092a, #0a0517);
    border-left: 1px solid rgba(192,132,252,0.25);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex; flex-direction: column;
    box-shadow: -20px 0 60px rgba(0,0,0,0.5);
  }
  [data-theme="light"] .side-menu-panel {
    background: linear-gradient(180deg, #ffffff, #faf5ff);
    border-left-color: rgba(168,85,247,0.2);
  }
  .side-menu.open .side-menu-panel { transform: translateX(0); }
  .sm-scroll { flex: 1; overflow-y: auto; }
  .sm-header {
    display: flex; align-items: center; gap: 12px;
    padding: 20px 18px 18px;
    border-bottom: 1px solid rgba(192,132,252,0.15);
    flex-shrink: 0;
  }
  .sm-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc);
    display: flex; align-items: center; justify-content: center;
    color: white; flex-shrink: 0;
  }
  .sm-user-info { flex: 1; min-width: 0; }
  .sm-username {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.95rem; font-weight: 700;
    color: #ffffff;
  }
  [data-theme="light"] .sm-username { color: #1e0f36; }
  .sm-user-sub {
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    color: rgba(255,255,255,0.5); margin-top: 2px;
  }
  [data-theme="light"] .sm-user-sub { color: rgba(30,15,54,0.55); }
  .sm-close {
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(192,132,252,0.1);
    border: 1px solid rgba(192,132,252,0.2);
    color: rgba(255,255,255,0.7); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  [data-theme="light"] .sm-close { color: rgba(30,15,54,0.7); }
  .sm-section { padding: 8px 10px; }
  .sm-section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    padding: 6px 10px 8px;
  }
  [data-theme="light"] .sm-section-label { color: rgba(30,15,54,0.58); }
  .sm-item {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 10px; border-radius: 10px;
    text-decoration: none;
    background: transparent; border: none;
    width: 100%; cursor: pointer;
    font-family: inherit; text-align: left;
    transition: background 0.15s ease;
    margin-bottom: 2px; color: inherit;
  }
  .sm-item:hover { background: rgba(192,132,252,0.1); }
  [data-theme="light"] .sm-item:hover { background: rgba(168,85,247,0.08); }
  .sm-item-icon {
    width: 34px; height: 34px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    color: white; flex-shrink: 0;
  }
  .sm-item-icon svg { width: 16px; height: 16px; }
  .sm-icon-purple { background: linear-gradient(135deg, #a855f7, #c084fc); }
  .sm-icon-pink   { background: linear-gradient(135deg, #ec4899, #e879f9); }
  .sm-icon-cyan   { background: linear-gradient(135deg, #06b6d4, #7dd3fc); }
  .sm-icon-red    { background: linear-gradient(135deg, #ef4444, #f87171); }
  .sm-item-label {
    flex: 1; font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem; font-weight: 600;
    color: #ffffff;
  }
  [data-theme="light"] .sm-item-label { color: #1e0f36; }
  .sm-item-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 700;
    color: #e879f9;
    background: rgba(232,121,249,0.12);
    padding: 3px 8px; border-radius: 8px;
    min-width: 24px; text-align: center;
  }
  [data-theme="light"] .sm-item-count { color: #a855f7; background: rgba(168,85,247,0.1); }
  .sm-item-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700;
    color: rgba(255,255,255,0.7);
    background: rgba(192,132,252,0.08);
    padding: 3px 8px; border-radius: 8px;
    border: 1px solid rgba(192,132,252,0.2);
  }
  [data-theme="light"] .sm-item-tag { color: rgba(30,15,54,0.7); }
  .sm-theme-sun { display: none; }
  .sm-theme-moon { display: block; }
  [data-theme="light"] .sm-theme-sun { display: block; }
  [data-theme="light"] .sm-theme-moon { display: none; }
  .sm-divider {
    height: 1px; margin: 4px 18px;
    background: linear-gradient(90deg, transparent, rgba(192,132,252,0.2), transparent);
  }
  .sm-bottom-space { height: 100px; }
  .sm-footer {
    padding: 12px 18px 18px;
    border-top: 1px solid rgba(192,132,252,0.12);
    text-align: center; flex-shrink: 0;
    margin-bottom: 70px;
  }
  .sm-footer-brand {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1rem; font-weight: 800;
    margin-bottom: 4px;
  }
  .sm-footer-mid { color: #ffffff; }
  [data-theme="light"] .sm-footer-mid { color: #1e0f36; }
  .sm-footer-tagline {
    font-family: 'JetBrains Mono', monospace; font-size: 0.65rem;
    color: rgba(255,255,255,0.48);
  }
  [data-theme="light"] .sm-footer-tagline { color: rgba(30,15,54,0.52); }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .search-inline { width: 280px; }
    .sdd { width: 400px; }
    .nav-link { padding: 7px 12px; font-size: 0.85rem; }
  }
  @media (max-width: 900px) {
    .search-inline { width: 220px; }
    .sdd { width: 360px; }
  }
  /* ═══════════════════════════════════════
     🎯 SMART PICKER MODAL
  ═══════════════════════════════════════ */
  .picker-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: pickerFadeIn 0.2s ease-out;
  }
  @keyframes pickerFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .picker-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 5, 23, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .picker-panel {
    position: relative;
    background: linear-gradient(180deg, rgba(28, 15, 61, 0.98), rgba(14, 8, 26, 0.99));
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
    width: 100%;
    max-width: 520px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: pickerScaleIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pickerScaleIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  
  .picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(232, 121, 249, 0.1));
    border-bottom: 1px solid rgba(192, 132, 252, 0.2);
    flex-shrink: 0;
  }
  .picker-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .picker-emoji {
    font-size: 1.8rem;
  }
  .picker-title-main {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }
  .picker-title-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: rgba(232, 121, 249, 0.8);
    margin-top: 3px;
  }
  .picker-close {
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.25);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    transition: all 0.15s;
  }
  .picker-close:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }
  
  .picker-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .picker-body::-webkit-scrollbar { width: 5px; }
  .picker-body::-webkit-scrollbar-thumb {
    background: rgba(192, 132, 252, 0.3);
    border-radius: 3px;
  }
  
  .picker-extracted {
    background: rgba(192, 132, 252, 0.08);
    border: 1px solid rgba(192, 132, 252, 0.2);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .picker-extracted-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: rgba(232, 121, 249, 0.9);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .picker-extracted-thumb {
    width: 100%;
    max-width: 200px;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .picker-extracted-thumb img {
    width: 100%;
    height: auto;
    display: block;
  }
  .picker-extracted-caption {
    font-size: 0.85rem;
    color: rgba(245, 236, 255, 0.85);
    line-height: 1.4;
    font-style: italic;
  }
  
  .picker-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .picker-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .picker-input {
    width: 100%;
    padding: 11px 14px;
    background: rgba(10, 5, 23, 0.7);
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 10px;
    color: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s;
  }
  .picker-input:focus {
    border-color: rgba(232, 121, 249, 0.6);
    box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
  }
  .picker-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }
  
  .picker-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100px;
  }
  .picker-hint {
    text-align: center;
    padding: 30px 20px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }
  .picker-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 30px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
  }
  .picker-spin {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(192, 132, 252, 0.25);
    border-top-color: #e879f9;
    border-radius: 50%;
    animation: pickerSpin 0.7s linear infinite;
  }
  @keyframes pickerSpin { to { transform: rotate(360deg); } }
  
  .picker-empty {
    text-align: center;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }
  .picker-empty-icon { font-size: 2rem; }
  .picker-empty-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }
  .picker-empty-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: 'JetBrains Mono', monospace;
  }
  
  .picker-result-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(192, 132, 252, 0.15);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .picker-result-card:hover {
    background: rgba(192, 132, 252, 0.12);
    border-color: rgba(232, 121, 249, 0.5);
    transform: translateY(-1px);
  }
  .picker-result-thumb {
    width: 52px;
    height: 72px;
    min-width: 52px;
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.3), rgba(232, 121, 249, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .picker-result-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .picker-result-emoji {
    font-size: 1.4rem;
    opacity: 0.7;
  }
  .picker-result-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .picker-result-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .picker-result-meta {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(232, 121, 249, 0.9);
    font-weight: 600;
  }
  .picker-result-ep {
    padding: 1px 6px;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: #fff !important;
    border-radius: 4px;
    font-weight: 800;
