---
const navLinks = [
  { name: "Home",      href: "/" },
  { name: "Browse",    href: "/category/anime-recap" },
  { name: "Manga",     href: "/category/manhwa" },
  { name: "News",      href: "/category/news" },
  { name: "Streaming", href: "/category/streaming" },
];
---

<header class="hdr" id="siteHeader">
  <div class="hdr-inner container">

    <a href="/" class="logo-wrap">
      <div class="logo-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path d="M13 2L4 14H12L11 22L20 10H12L13 2Z" fill="url(#logoGrad)" />
          <defs>
            <linearGradient id="logoGrad" x1="4" y1="2" x2="20" y2="22">
              <stop stop-color="#c084fc"/>
              <stop offset="0.5" stop-color="#e879f9"/>
              <stop offset="1" stop-color="#7dd3fc"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <span class="logo-txt">
        <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
      </span>
    </a>

    <nav class="hdr-nav">
      {navLinks.map(link => (
        <a href={link.href} class="hdr-link">{link.name}</a>
      ))}
    </nav>

    <div class="hdr-actions">
      
      <div class="hdr-search" id="hdrSearch">
        <button class="hdr-search-toggle" id="hdrSearchToggle" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
        </button>
        
        <div class="hdr-search-panel" id="hdrSearchPanel">
          <div class="hdr-search-input-wrap">
            <svg class="hdr-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" id="hdrSearchInput" placeholder="Search anime..." autocomplete="off" />
            <button class="hdr-search-clear" id="hdrSearchClear" style="display:none;" aria-label="Clear">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
            <div class="hdr-search-ai-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>AI</span>
            </div>
          </div>
          <div id="hdrSearchResults" class="hdr-search-results"></div>
        </div>
      </div>

      <a href="/category/news" class="hdr-icon" aria-label="News">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
      </a>

      <button class="hdr-icon" id="themeToggle" aria-label="Toggle theme" type="button">
        <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>

      <button class="hdr-user" id="profileBtn" aria-label="Sign up">
        <div class="hdr-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
      </button>

      <button class="hdr-mob-btn" id="mobBtn" aria-label="Menu" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mob-drawer" id="mobDrawer">
    {navLinks.map(link => (
      <a href={link.href} class="mob-link">{link.name}</a>
    ))}
    <a href="/category/gaming" class="mob-link">Gaming</a>
  </div>
</header>

<div id="emailModal" class="em-modal" style="display:none;">
  <div class="em-backdrop" id="emBackdrop"></div>
  <div class="em-panel">
    <button class="em-close" id="emClose" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="em-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </div>
    <h2 class="em-title"><span class="grad-text">Join AniTube Buzz</span></h2>
    <p class="em-desc">Get notified about new anime releases, exclusive news, and special deals from our anime shop partners!</p>
    <form class="em-form" id="emForm">
      <div class="em-input-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <input type="email" id="emEmail" placeholder="your@email.com" required />
      </div>
      <button type="submit" class="em-btn">
        <span>Subscribe Free</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </form>
    <div class="em-perks">
      <div class="em-perk"><span>🎬</span><span>Weekly new anime alerts</span></div>
      <div class="em-perk"><span>💰</span><span>Exclusive merch deals</span></div>
      <div class="em-perk"><span>🎁</span><span>Free anime snacks giveaways</span></div>
    </div>
    <div class="em-privacy">We respect your privacy. Unsubscribe anytime.</div>
    <div class="em-success" id="emSuccess" style="display:none;">
      <div class="em-success-ic">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h3>Welcome to AniTube Buzz! 🎉</h3>
      <p>You'll get the freshest anime updates in your inbox!</p>
    </div>
  </div>
</div>

<div style="height: var(--header-h);"></div>

<style>
  .hdr {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: var(--header-h);
    z-index: 1000;
    background: var(--bg-glass);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid var(--border-color);
    transition: all 0.25s ease;
  }
  .hdr-inner { display: flex; align-items: center; justify-content: space-between; height: 100%; gap: 20px; }
  .logo-wrap { display: flex; align-items: center; gap: 10px; flex-shrink: 0; transition: transform 0.2s ease; }
  .logo-wrap:hover { transform: scale(1.03); }
  .logo-icon { filter: drop-shadow(0 0 8px rgba(192, 132, 252, 0.5)); }
  .logo-txt { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; letter-spacing: -0.025em; line-height: 1; }
  .hdr-nav { display: flex; align-items: center; gap: 4px; margin-left: 2rem; }
  .hdr-link { display: block; padding: 8px 16px; border-radius: 10px; font-size: 0.88rem; font-weight: 500; color: var(--text-secondary); transition: all var(--transition-fast); }
  .hdr-link:hover { color: var(--text-primary); background: rgba(192, 132, 252, 0.1); }
  .hdr-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-shrink: 0; }
  .hdr-icon { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.03); color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--transition-fast); font-family: inherit; }
  .hdr-icon:hover { background: rgba(192, 132, 252, 0.1); border-color: rgba(192, 132, 252, 0.4); color: var(--purple); }
  [data-theme="light"] .hdr-icon { background: rgba(192, 132, 252, 0.08); }
  .ico-sun { display: none; }
  [data-theme="light"] .ico-moon { display: none; }
  [data-theme="light"] .ico-sun  { display: block; }

  /* ═══ CLEAN PREMIUM SEARCH ═══ */
  .hdr-search { position: relative; }
  .hdr-search-toggle {
    width: 38px; height: 38px; border-radius: 10px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s ease;
  }
  [data-theme="light"] .hdr-search-toggle { background: rgba(192, 132, 252, 0.08); }
  .hdr-search-toggle:hover, .hdr-search.active .hdr-search-toggle {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.5);
    color: #c084fc;
  }
  
  .hdr-search-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 420px;
    max-width: calc(100vw - 20px);
    background: #0f0823;
    border: 1px solid rgba(192, 132, 252, 0.35);
    border-radius: 16px;
    padding: 10px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(192, 132, 252, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.25s ease;
    z-index: 1001;
  }
  [data-theme="light"] .hdr-search-panel {
    background: #ffffff;
    border: 1px solid rgba(168, 85, 247, 0.3);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15), 0 0 40px rgba(192, 132, 252, 0.15);
  }
  .hdr-search.active .hdr-search-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .hdr-search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(28, 15, 61, 0.6);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 10px;
    padding: 0 10px;
    transition: all 0.2s ease;
  }
  [data-theme="light"] .hdr-search-input-wrap {
    background: rgba(243, 232, 255, 0.6);
    border-color: rgba(168, 85, 247, 0.3);
  }
  .hdr-search-input-wrap:focus-within {
    border-color: rgba(232, 121, 249, 0.7);
    box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
  }
  .hdr-search-icon { color: #c084fc; flex-shrink: 0; }
  
  #hdrSearchInput {
    background: none !important;
    border: none !important;
    outline: none !important;
    color: #ffffff !important;
    font-family: inherit;
    font-size: 0.9rem;
    padding: 10px 0;
    width: 100%;
    flex: 1;
    min-width: 0;
  }
  [data-theme="light"] #hdrSearchInput {
    color: #1e0f36 !important;
  }
  #hdrSearchInput::placeholder { color: rgba(255,255,255,0.5); }
  [data-theme="light"] #hdrSearchInput::placeholder { color: rgba(30,15,54,0.5); }
  
  .hdr-search-clear {
    display: flex; align-items: center; justify-content: center;
    background: rgba(192, 132, 252, 0.15); border: none;
    color: var(--text-muted); cursor: pointer;
    width: 22px; height: 22px; border-radius: 50%;
    transition: all 0.2s ease; flex-shrink: 0;
  }
  .hdr-search-clear:hover { background: rgba(239, 68, 68, 0.3); color: #ef4444; }
  
  .hdr-search-ai-badge {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 3px 7px;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem; font-weight: 800;
    letter-spacing: 0.05em;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(192, 132, 252, 0.4);
    flex-shrink: 0;
  }
  
  .hdr-search-results {
    max-height: 480px;
    overflow-y: auto;
    margin-top: 8px;
  }
  .hdr-search-results:empty { margin-top: 0; }
  .hdr-search-results::-webkit-scrollbar { width: 6px; }
  .hdr-search-results::-webkit-scrollbar-thumb { background: rgba(192, 132, 252, 0.3); border-radius: 3px; }
  
  .hsr-hint {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 10px;
    color: #e879f9;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.05em;
  }
  
  .hsr-loading {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; padding: 1.5rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }
  
  .hsr-empty {
    display: flex; align-items: center; gap: 10px;
    padding: 16px;
    color: var(--text-muted);
  }
  .hsr-empty > svg { color: #c084fc; flex-shrink: 0; width: 22px; height: 22px; }
  .hsr-empty-t { font-family: 'Bricolage Grotesque', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .hsr-empty-s { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; opacity: 0.7; }
  
  /* ═══ COMPACT SEARCH RESULT ITEM ═══ */
  .hsr-item {
    display: flex !important;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.15s ease;
    margin-bottom: 2px;
  }
  .hsr-item:hover {
    background: rgba(192, 132, 252, 0.12);
    transform: translateX(3px);
  }
  [data-theme="light"] .hsr-item:hover {
    background: rgba(192, 132, 252, 0.1);
  }
  
  /* ═══ FIXED SMALL THUMBNAIL ═══ */
      .hsr-th {
    width: 44px !important;
    height: 58px !important;
    min-width: 44px !important;
    max-width: 44px !important;
    max-height: 58px !important;
    border-radius: 6px !important;
    overflow: hidden !important;
    background: rgba(192, 132, 252, 0.1) !important;
    flex-shrink: 0 !important;
    display: block !important;
    position: relative !important;
  }
  .hsr-th img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 44px !important;
    height: 58px !important;
    max-width: 44px !important;
    max-height: 58px !important;
    object-fit: cover !important;
    display: block !important;
    aspect-ratio: auto !important;
  }
    max-width: 44px !important;
    max-height: 58px !important;
    border-radius: 6px !important;
    overflow: hidden !important;
    background: rgba(192, 132, 252, 0.1) !important;
    flex-shrink: 0 !important;
    display: block !important;
    position: relative !important;
  }
  .hsr-th img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 44px !important;
    height: 58px !important;
    max-width: 44px !important;
    max-height: 58px !important;
    object-fit: cover !important;
    display: block !important;
    aspect-ratio: auto !important;
  }
    min-width: 44px !important;
    max-width: 44px !important;
    border-radius: 6px !important;
    overflow: hidden !important;
    background: rgba(192, 132, 252, 0.1) !important;
    flex-shrink: 0 !important;
    display: block !important;
  }
  .hsr-th img {
    width: 100% !important;
    height: 100% !important;
    max-width: 44px !important;
    max-height: 58px !important;
    object-fit: cover !important;
    display: block !important;
  }
  .hsr-th-no { width: 100%; height: 100%; }
  
  .hsr-inf {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .hsr-t {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    color: var(--text-primary);
  }
  .hsr-m {
    font-size: 0.68rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hsr-g {
    font-size: 0.6rem;
    color: #c084fc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .hsr-badge {
    padding: 2px 6px;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
    align-self: flex-start;
    flex-shrink: 0;
  }
  
  .hsr-more {
    border-top: 1px solid rgba(192, 132, 252, 0.2);
    margin-top: 6px;
    padding: 12px !important;
    color: #c084fc;
    font-size: 0.78rem;
    font-weight: 700;
    justify-content: center;
    gap: 8px;
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  .hsr-more:hover {
    color: #e879f9;
    background: rgba(232, 121, 249, 0.1);
  }
  
  /* User Avatar */
  .hdr-user { background: none; border: none; padding: 0; margin-left: 4px; cursor: pointer; }
  .hdr-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--grad); color: #fff;
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.2s;
    box-shadow: 0 4px 15px rgba(192, 132, 252, 0.35);
  }
  .hdr-avatar:hover { transform: scale(1.08); box-shadow: 0 6px 20px rgba(192, 132, 252, 0.55); }

  .hdr-mob-btn { display: none; flex-direction: column; gap: 5px; width: 38px; height: 38px; align-items: center; justify-content: center; border: 1px solid var(--border-color); border-radius: 10px; background: rgba(255, 255, 255, 0.03); cursor: pointer; }
  .hdr-mob-btn span { width: 18px; height: 2px; background: var(--text-primary); border-radius: 2px; transition: all var(--transition-fast); }
  .hdr-mob-btn.active span:nth-child(1) { transform: rotate(45deg) translate(4px, 5px); }
  .hdr-mob-btn.active span:nth-child(2) { opacity: 0; }
  .hdr-mob-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(4px, -5px); }
  .mob-drawer { display: none; position: fixed; top: var(--header-h); left: 0; width: 100%; background: var(--bg-secondary); border-bottom: 1px solid var(--border-color); padding: 12px; z-index: 999; flex-direction: column; gap: 3px; backdrop-filter: blur(20px); }
  .mob-drawer.active { display: flex; }
  .mob-link { padding: 13px 16px; border-radius: 10px; font-size: 0.95rem; font-weight: 500; color: var(--text-secondary); transition: all var(--transition-fast); }
  .mob-link:hover { background: rgba(192, 132, 252, 0.1); color: var(--text-primary); }

  /* Email Modal */
  .em-modal { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .em-backdrop { position: absolute; inset: 0; background: rgba(10, 5, 23, 0.85); backdrop-filter: blur(10px); animation: emFadeIn 0.3s ease; }
  @keyframes emFadeIn { from{opacity:0} to{opacity:1} }
  .em-panel {
    position: relative; width: 100%; max-width: 460px;
    background: linear-gradient(135deg, rgba(28,15,61,0.98), rgba(15,8,35,0.98));
    border: 1px solid rgba(192, 132, 252, 0.4);
    border-radius: 24px; padding: 2rem;
    box-shadow: 0 30px 80px rgba(0,0,0,0.7), 0 0 60px rgba(192, 132, 252, 0.3);
    backdrop-filter: blur(20px);
    animation: emSlideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-theme="light"] .em-panel { background: linear-gradient(135deg, #ffffff, #faf5ff); color: #1e0f36; }
  @keyframes emSlideUp { from{opacity:0;transform:translateY(30px) scale(0.95)} to{opacity:1;transform:translateY(0) scale(1)} }
  .em-close { position: absolute; top: 16px; right: 16px; width: 34px; height: 34px; border-radius: 50%; background: rgba(192, 132, 252, 0.1); border: 1px solid rgba(192, 132, 252, 0.3); color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; }
  .em-close:hover { background: rgba(239, 68, 68, 0.2); color: #ef4444; transform: rotate(90deg); }
  .em-icon { width: 72px; height: 72px; border-radius: 20px; background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc); display: flex; align-items: center; justify-content: center; color: #fff; margin: 0 auto 1.25rem; box-shadow: 0 15px 40px rgba(192, 132, 252, 0.5); }
  .em-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.75rem; font-weight: 800; text-align: center; margin: 0 0 0.5rem; }
  .em-desc { text-align: center; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0 0 1.5rem; }
  .em-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.25rem; }
  .em-input-wrap { display: flex; align-items: center; gap: 10px; background: rgba(10, 5, 23, 0.6); border: 1px solid rgba(192, 132, 252, 0.3); border-radius: 12px; padding: 0 14px; transition: all 0.2s ease; }
  [data-theme="light"] .em-input-wrap { background: rgba(243, 232, 255, 0.5); }
  .em-input-wrap:focus-within { border-color: rgba(232, 121, 249, 0.7); box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15); }
  .em-input-wrap svg { color: #c084fc; flex-shrink: 0; }
  #emEmail { background: none; border: none; outline: none; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; padding: 14px 0; width: 100%; }
  #emEmail::placeholder { color: var(--text-muted); opacity: 0.7; }
  .em-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 24px; background: linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc); color: #fff; border: none; border-radius: 12px; font-family: 'Bricolage Grotesque', sans-serif; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: 0 10px 30px rgba(192, 132, 252, 0.4); transition: all 0.25s ease; }
  .em-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(192, 132, 252, 0.6); }
  .em-perks { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1rem; }
  .em-perk { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: rgba(192, 132, 252, 0.06); border-radius: 8px; font-size: 0.82rem; color: var(--text-secondary); }
  .em-perk span:first-child { font-size: 1.1rem; }
  .em-privacy { text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; color: var(--text-muted); opacity: 0.7; }
  .em-success { text-align: center; padding: 1rem 0; }
  .em-success-ic { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #10b981, #059669); color: #fff; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; box-shadow: 0 12px 30px rgba(16, 185, 129, 0.4); }
  .em-success h3 { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.4rem; margin: 0 0 0.5rem; background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .em-success p { color: var(--text-secondary); font-size: 0.9rem; margin: 0; }

  @media (max-width: 900px) {
    .hdr-nav { display: none; }
    .hdr-mob-btn { display: flex; }
    .hdr-user { display: none; }
    .hdr-search-panel { right: 0; width: calc(100vw - 20px); max-width: 380px; }
  }
  @media (max-width: 480px) {
    .logo-txt { font-size: 1.15rem; }
    .hdr-inner { gap: 8px; }
    .hdr-actions { gap: 4px; }
    .hdr-icon, .hdr-search-toggle { width: 36px; height: 36px; }
    .em-panel { padding: 1.5rem; }
    .em-title { font-size: 1.4rem; }
    .hdr-search-panel { right: -80px; }
  }
</style>

<script is:inline>
  (function() {
    var toggle = document.getElementById('themeToggle');
    if(toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        var html = document.documentElement;
        var current = html.getAttribute('data-theme') || 'dark';
        var next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }

    var mobBtn = document.getElementById('mobBtn');
    var drawer = document.getElementById('mobDrawer');
    if(mobBtn && drawer) {
      mobBtn.addEventListener('click', function() {
        mobBtn.classList.toggle('active');
        drawer.classList.toggle('active');
      });
    }
    document.querySelectorAll('.mob-link').forEach(function(link) {
      link.addEventListener('click', function() {
        if(mobBtn) mobBtn.classList.remove('active');
        if(drawer) drawer.classList.remove('active');
      });
    });

    var searchWrap = document.getElementById('hdrSearch');
    var searchToggle = document.getElementById('hdrSearchToggle');
    var searchInput = document.getElementById('hdrSearchInput');
    var searchResults = document.getElementById('hdrSearchResults');
    var searchClear = document.getElementById('hdrSearchClear');
    
    function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}
    
    function levenshtein(a, b) {
      a = a.toLowerCase(); b = b.toLowerCase();
      if (a.length === 0) return b.length;
      if (b.length === 0) return a.length;
      var m = [];
      for (var i = 0; i <= b.length; i++) m[i] = [i];
      for (var j = 0; j <= a.length; j++) m[0][j] = j;
      for (var i = 1; i <= b.length; i++) {
        for (var j = 1; j <= a.length; j++) {
          if (b.charAt(i-1) === a.charAt(j-1)) m[i][j] = m[i-1][j-1];
          else m[i][j] = Math.min(m[i-1][j-1]+1, m[i][j-1]+1, m[i-1][j]+1);
        }
      }
      return m[b.length][a.length];
    }
    
    function fuzzyScore(query, title) {
      query = query.toLowerCase().trim(); title = title.toLowerCase();
      if (!query) return 0;
      if (title === query) return 1000;
      if (title.startsWith(query)) return 500;
      if (title.includes(query)) return 300;
      var words = title.split(/\s+/);
      for (var i = 0; i < words.length; i++) if (words[i].startsWith(query)) return 200;
      var dist = levenshtein(query, title.substring(0, Math.min(title.length, query.length + 3)));
      if (dist <= 2) return 100 - dist * 10;
      var matches = 0;
      for (var i = 0; i < query.length; i++) if (title.indexOf(query[i]) !== -1) matches++;
      return matches >= query.length * 0.7 ? 50 : 0;
    }
    
    if (searchToggle && searchWrap) {
      searchToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        searchWrap.classList.toggle('active');
        if (searchWrap.classList.contains('active')) {
          setTimeout(function() { searchInput.focus(); }, 100);
        }
      });
    }
    
    document.addEventListener('click', function(e) {
      if (searchWrap && !searchWrap.contains(e.target)) {
        searchWrap.classList.remove('active');
      }
    });
    
    if (searchClear) {
      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        searchClear.style.display = 'none';
        searchResults.innerHTML = '';
        searchInput.focus();
      });
    }
    
    var searchT;
    async function performSearch(q) {
      if (!q) { searchResults.innerHTML = ''; return; }
      searchResults.innerHTML = '<div class="hsr-loading"><div style="width:18px;height:18px;border:2px solid rgba(192,132,252,.2);border-top-color:#c084fc;border-radius:50%;animation:sp .8s linear infinite;"></div><span>Searching...</span></div>';
      
      try {
        var r = await fetch('/api/anime?action=search&q=' + encodeURIComponent(q));
        var j = await r.json();
        if (!j.success || !j.anime) throw new Error('fail');
        
        var scored = j.anime.map(function(a) { return { anime: a, score: fuzzyScore(q, a.title) }; })
          .filter(function(x) { return x.score > 0; })
          .sort(function(a, b) { return b.score - a.score; })
          .slice(0, 8);
        
        if (scored.length === 0) {
          searchResults.innerHTML = 
            '<div class="hsr-empty">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg>' +
              '<div><div class="hsr-empty-t">No anime found for "' + esc(q) + '"</div>' +
              '<div class="hsr-empty-s">Try a different spelling</div></div>' +
            '</div>';
          return;
        }
        
        var isTypo = scored[0].score < 200 && scored[0].score > 0;
        var html = '';
        
        if (isTypo) {
          html += '<div class="hsr-hint">💡 Did you mean...</div>';
        }
        
         html += scored.map(function(m) {
          var a = m.anime;
          var im = a.image 
            ? '<img src="' + esc(a.image) + '" alt="" loading="lazy" style="position:absolute;top:0;left:0;width:44px;height:58px;max-width:44px;max-height:58px;object-fit:cover;display:block;" />' 
            : '<div class="hsr-th-no"></div>';
          var badge = a.status === 'current' ? '<span class="hsr-badge">AIRING</span>' : '';
                    return '<a href="/anime/' + esc(a.slug) + '" class="hsr-item">' +
            '<div class="hsr-th" style="width:44px !important;height:58px !important;min-width:44px !important;max-width:44px !important;max-height:58px !important;border-radius:6px;overflow:hidden;background:rgba(192,132,252,0.1);flex-shrink:0;display:block;position:relative;">' + im + '</div>' +
            '<div class="hsr-inf">' +
              '<div class="hsr-t">' + esc(a.title) + '</div>' +
              '<div class="hsr-m">' + esc(a.year || 'Unknown') + (a.score ? ' · ⭐ ' + a.score : '') + (a.episodes ? ' · ' + a.episodes + ' EP' : '') + '</div>' +
              (a.genres && a.genres.length ? '<div class="hsr-g">' + a.genres.slice(0,2).map(esc).join(' · ') + '</div>' : '') +
            '</div>' + badge +
          '</a>';
        }).join('');
        
        html += '<a href="/search?q=' + encodeURIComponent(q) + '" class="hsr-item hsr-more">' +
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' +
          '<span>See all results for "' + esc(q) + '"</span>' +
        '</a>';
        
        searchResults.innerHTML = html;
      } catch(e) {
        searchResults.innerHTML = '<div class="hsr-empty"><div><div class="hsr-empty-t">Search error</div><div class="hsr-empty-s">Please try again</div></div></div>';
      }
    }
    
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        clearTimeout(searchT);
        var q = searchInput.value.trim();
        if (q) searchClear.style.display = 'flex'; else searchClear.style.display = 'none';
        if (!q) { searchResults.innerHTML = ''; return; }
        searchT = setTimeout(function() { performSearch(q); }, 250);
      });
      
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          var q = searchInput.value.trim();
          if (q) {
            var firstResult = searchResults.querySelector('.hsr-item:not(.hsr-more)');
            if (firstResult && firstResult.href) window.location.href = firstResult.href;
            else window.location.href = '/search?q=' + encodeURIComponent(q);
          }
        }
        if (e.key === 'Escape') { searchWrap.classList.remove('active'); searchInput.blur(); }
      });
    }
    
    var profileBtn = document.getElementById('profileBtn');
    var emailModal = document.getElementById('emailModal');
    var emBackdrop = document.getElementById('emBackdrop');
    var emClose = document.getElementById('emClose');
    var emForm = document.getElementById('emForm');
    var emEmail = document.getElementById('emEmail');
    var emSuccess = document.getElementById('emSuccess');
    
    function openModal() {
      if (emailModal) {
        emailModal.style.display = 'flex';
        if (emForm) emForm.style.display = '';
        if (emSuccess) emSuccess.style.display = 'none';
        setTimeout(function() { if (emEmail) emEmail.focus(); }, 300);
      }
    }
    function closeModal() { if (emailModal) emailModal.style.display = 'none'; }
    
    if (profileBtn) profileBtn.addEventListener('click', openModal);
    if (emClose) emClose.addEventListener('click', closeModal);
    if (emBackdrop) emBackdrop.addEventListener('click', closeModal);
    
    if (emForm) {
      emForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = emEmail.value.trim();
        if (!email) return;
        try {
          var existing = JSON.parse(localStorage.getItem('atb_emails') || '[]');
          if (existing.indexOf(email) === -1) {
            existing.push(email);
            localStorage.setItem('atb_emails', JSON.stringify(existing));
            localStorage.setItem('atb_subscribed', 'true');
          }
        } catch(e) {}
        if (emForm) emForm.style.display = 'none';
        var descEl = document.querySelector('.em-desc');
        var perksEl = document.querySelector('.em-perks');
        var privEl = document.querySelector('.em-privacy');
        var titleEl = document.querySelector('.em-title');
        var iconEl = document.querySelector('.em-icon');
        if (descEl) descEl.style.display = 'none';
        if (perksEl) perksEl.style.display = 'none';
        if (privEl) privEl.style.display = 'none';
        if (titleEl) titleEl.style.display = 'none';
        if (iconEl) iconEl.style.display = 'none';
        if (emSuccess) emSuccess.style.display = 'block';
        setTimeout(function() {
          closeModal();
          setTimeout(function() {
            if (emForm) emForm.style.display = '';
            if (descEl) descEl.style.display = '';
            if (perksEl) perksEl.style.display = '';
            if (privEl) privEl.style.display = '';
            if (titleEl) titleEl.style.display = '';
            if (iconEl) iconEl.style.display = '';
            if (emSuccess) emSuccess.style.display = 'none';
            if (emEmail) emEmail.value = '';
          }, 400);
        }, 2500);
      });
    }
  })();
</script>
