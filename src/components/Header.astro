    background: rgba(168,85,247,0.12); color: #a855f7 !important;
    border-color: rgba(168,85,247,0.3);
  }

  .sm-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 12px;
    text-decoration: none;
