---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Browse', href: '/browse' },
  { label: 'Manga', href: '/category/manga' },
  { label: 'News', href: '/category/news' },
  { label: 'Streaming', href: '/category/streaming' },
];
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    
    <a href="/" class="header-logo">
      <span class="grad-text">Ani</span><span class="tube-text">Tube</span><span class="grad-text">Buzz</span>
    </a>
    
    <nav class="header-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    
    <div class="header-right">
      
      <div class="search-inline" id="searchWrap">
        <svg class="si-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input 
          type="text" 
          id="quickSearch" 
          class="si-input" 
          placeholder="Search anime, caption, or paste link..." 
          autocomplete="off"
          spellcheck="false"
        />
        <div id="siSpinner" class="si-spinner" style="display:none">
          <div class="si-spin-ring"></div>
        </div>
        <button id="siClear" class="si-clear" aria-label="Clear search" style="display:none">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        <div id="searchDD" class="sdd"></div>
      </div>
      
      <button id="themeToggle" class="header-icon-btn" aria-label="Toggle theme">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      
      <button id="profileBtn" class="header-icon-btn" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span id="profileBadge" class="profile-badge" style="display:none">0</span>
      </button>
      
      <button id="mobileMenuBtn" class="header-icon-btn mobile-only" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- MOBILE SEARCH BAR -->
  <div class="mobile-search-bar">
    <div class="msb-inner" id="msbInner">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="color:rgba(192,132,252,0.8);flex-shrink:0">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input 
        type="text" 
        id="mobileSearch" 
        class="msb-input" 
        placeholder="Search anime, caption, or paste link..." 
        autocomplete="off" 
        spellcheck="false" 
      />
      <div id="msbSpinner" class="msb-spinner" style="display:none">
        <div class="si-spin-ring"></div>
      </div>
      <button id="msbClear" class="msb-clear" aria-label="Clear" style="display:none">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
      <div id="msbDD" class="sdd sdd-mobile"></div>
    </div>
  </div>
  
  <div id="mobileMenu" class="mobile-menu">
    <nav class="mobile-nav">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
<!-- ═══ SMART PICKER MODAL (when auto-detect fails) ═══ -->
<div id="pickerModal" class="picker-modal" style="display:none">
  <div class="picker-backdrop" id="pickerBackdrop"></div>
  <div class="picker-panel">
    <div class="picker-header">
      <div class="picker-title">
        <span class="picker-emoji">🤔</span>
        <div>
          <div class="picker-title-main">Help us find this anime</div>
          <div class="picker-title-sub">Auto-detect couldn't find it</div>
        </div>
      </div>
      <button class="picker-close" id="pickerClose" aria-label="Close">✕</button>
    </div>
    
    <div class="picker-body">
      <!-- Extracted info (if any) -->
      <div id="pickerExtracted" class="picker-extracted" style="display:none">
        <div class="picker-extracted-label">📝 We extracted this info:</div>
        <div id="pickerExtractedThumb" class="picker-extracted-thumb" style="display:none">
          <img id="pickerExtractedImg" src="" alt="" referrerpolicy="no-referrer" />
        </div>
        <div id="pickerExtractedCaption" class="picker-extracted-caption"></div>
      </div>
      
      <!-- Search input -->
      <div class="picker-field">
        <label class="picker-label">
          🔍 Search anime by name or caption
        </label>
        <input 
          type="text" 
          id="pickerSearch" 
          class="picker-input" 
          placeholder="Type anime name, caption, or keywords..."
          autocomplete="off"
        />
      </div>
      
      <!-- Search results -->
      <div id="pickerResults" class="picker-results">
        <div class="picker-hint">💡 Start typing to see matches</div>
      </div>
    </div>
    
    <div class="picker-footer">
      <button class="picker-btn-cancel" id="pickerCancel">Cancel</button>
      <a href="/admin" target="_blank" class="picker-btn-admin">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        <span>Add manually (Admin)</span>
      </a>
    </div>
  </div>
</div>
<!-- URL Resolve Toast -->
<div id="urlToast" class="url-toast" style="display:none">
  <div class="url-toast-inner">
    <div class="url-toast-spin"></div>
    <div class="url-toast-text">
      <span class="url-toast-title" id="urlToastTitle">Detecting anime...</span>
      <span class="url-toast-sub" id="urlToastSub">Searching database</span>
    </div>
    <button class="url-toast-cancel" id="urlToastCancel" aria-label="Cancel">✕</button>
  </div>
</div>

<!-- SIDE MENU -->
<div id="sideMenu" class="side-menu">
  <div class="side-menu-backdrop" id="sideMenuBackdrop"></div>
  <aside class="side-menu-panel">
    <div class="sm-header">
      <div class="sm-avatar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <div class="sm-user-info">
        <div class="sm-username" id="smUsername">Anime Fan</div>
        <div class="sm-user-sub" id="smUserSub">@guest_user</div>
      </div>
      <button class="sm-close" id="sideMenuClose" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="sm-scroll">
      <div class="sm-section">
        <div class="sm-section-label">My Content</div>
        <a href="/saved" class="sm-item">
          <div class="sm-item-icon sm-icon-purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="sm-item-label">Saved Videos</div>
          <span class="sm-item-count" id="countSaved">0</span>
        </a>
        <a href="/history" class="sm-item">
          <div class="sm-item-icon sm-icon-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="sm-item-label">Watch History</div>
          <span class="sm-item-count" id="countHistory">0</span>
        </a>
        <a href="/liked" class="sm-item">
          <div class="sm-item-icon sm-icon-pink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <div class="sm-item-label">Liked Videos</div>
          <span class="sm-item-count" id="countLiked">0</span>
        </a>
      </div>

      <div class="sm-divider"></div>

      <div class="sm-section">
        <div class="sm-section-label">Settings</div>
        <button class="sm-item sm-item-btn" id="smThemeToggle">
          <div class="sm-item-icon sm-icon-purple">
            <svg class="sm-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg class="sm-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
            </svg>
          </div>
          <div class="sm-item-label">Switch Appearance</div>
          <span class="sm-item-tag" id="smThemeTag">Dark</span>
        </button>
        <button class="sm-item sm-item-btn" id="smClearData">
          <div class="sm-item-icon sm-icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
              <path d="M10 11v6M14 11v6"/>
            </svg>
          </div>
          <div class="sm-item-label">Clear My Data</div>
        </button>
      </div>

      <div class="sm-bottom-space"></div>
    </div>

    <div class="sm-footer">
      <div class="sm-footer-brand">
        <span class="grad-text">Ani</span><span class="sm-footer-mid">Tube</span><span class="grad-text">Buzz</span>
      </div>
      <div class="sm-footer-tagline">Made with 💜 for anime fans</div>
    </div>
  </aside>
</div>

<script is:inline>
(function() {

  function $(id) { return document.getElementById(id); }

  function isUrl(str) {
    var s = str.trim();
    return s.startsWith('http://') || s.startsWith('https://') ||
           s.indexOf('facebook.com') !== -1 ||
           s.indexOf('fb.watch') !== -1 ||
           s.indexOf('youtu.be') !== -1 ||
           s.indexOf('youtube.com') !== -1 ||
           s.indexOf('dailymotion.com') !== -1 ||
           s.indexOf('bilibili.com') !== -1;
  }

  function esc(s) {
    if (!s) return '';
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
  }

  function slugify(s) {
    return String(s || '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  /* THEME */
  var themeBtn = $('themeToggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateSmThemeTag();
    });
  }
  function updateSmThemeTag() {
    var tag = $('smThemeTag');
    if (tag) tag.textContent = document.documentElement.getAttribute('data-theme') === 'dark' ? 'Dark' : 'Light';
  }

  /* SCROLL */
  var header = $('siteHeader');
  if (header) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 20) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    }, { passive: true });
  }

  /* MOBILE MENU */
  var mobileBtn = $('mobileMenuBtn');
  var mobileMenu = $('mobileMenu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', function() {
      mobileMenu.classList.toggle('open');
    });
    mobileMenu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() { mobileMenu.classList.remove('open'); });
    });
  }

  /* SIDE MENU */
  var sideMenu = $('sideMenu');
  var sideMenuBackdrop = $('sideMenuBackdrop');
  var sideMenuClose = $('sideMenuClose');

  function openSideMenu() {
    if (!sideMenu) return;
    sideMenu.classList.add('open');
    document.body.style.overflow = 'hidden';
    updateMenuCounts();
    updateSmThemeTag();
  }
  function closeSideMenu() {
    if (!sideMenu) return;
    sideMenu.classList.remove('open');
    document.body.style.overflow = '';
  }

  var profileBtn = $('profileBtn');
  if (profileBtn) profileBtn.addEventListener('click', openSideMenu);
  if (sideMenuClose) sideMenuClose.addEventListener('click', closeSideMenu);
  if (sideMenuBackdrop) sideMenuBackdrop.addEventListener('click', closeSideMenu);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (sideMenu && sideMenu.classList.contains('open')) closeSideMenu();
      closeSearchDD();
      closeMobileSearchDD();
    }
  });

  function updateMenuCounts() {
    try {
      var saved = JSON.parse(localStorage.getItem('anitube_saved') || '[]');
      var hist = JSON.parse(localStorage.getItem('anitube_history') || '[]');
      var liked = JSON.parse(localStorage.getItem('anitube_liked') || '[]');
      var cs = $('countSaved'), ch = $('countHistory'), cl = $('countLiked');
      var badge = $('profileBadge');
      if (cs) cs.textContent = saved.length;
      if (ch) ch.textContent = hist.length;
      if (cl) cl.textContent = liked.length;
      var total = saved.length + hist.length + liked.length;
      if (badge) badge.style.display = total > 0 ? 'flex' : 'none';
    } catch(e) {}
  }
  updateMenuCounts();

  var smThemeToggle = $('smThemeToggle');
  if (smThemeToggle) smThemeToggle.addEventListener('click', function() { if (themeBtn) themeBtn.click(); });

  var smClearData = $('smClearData');
  if (smClearData) {
    smClearData.addEventListener('click', function() {
      if (confirm('Clear all your Saved, History, and Liked videos?')) {
        localStorage.removeItem('anitube_saved');
        localStorage.removeItem('anitube_history');
        localStorage.removeItem('anitube_liked');
        localStorage.removeItem('anitube_resume_video');
        localStorage.removeItem('anitube_resume_time');
        updateMenuCounts();
        alert('Cleared!');
      }
    });
  }

  /* ═══════════════════════════════════════
     🔍 SEARCH LOGIC
     Priority:
     1. Check fb-anime.json (your database) 
     2. Fallback to Kitsu (general anime search)
  ═══════════════════════════════════════ */
  
  var searchCache = {};

  function searchFbDatabase(query, ctrl) {
    return fetch('/api/fb-search?q=' + encodeURIComponent(query) + '&limit=8', {
      signal: ctrl.signal
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data && data.success && data.results && data.results.length > 0) {
          return data.results.map(function(item) {
            return {
              source: 'fb',
              anime: item.anime,
              title: item.title,
              episode: item.episode,
              caption: item.caption,
              thumb: item.thumbnail || '',
              confidence: item.confidence,
              matchType: item.matchType,
              watchUrl: item.watchUrl
            };
          });
        }
        return [];
      })
      .catch(function() { return []; });
  }

  function searchKitsu(query, ctrl) {
    var url = 'https://kitsu.io/api/edge/anime?filter[text]=' + encodeURIComponent(query) + 
              '&page[limit]=8&fields[anime]=canonicalTitle,titles,posterImage,averageRating,episodeCount,startDate,subtype,slug';
    return fetch(url, { signal: ctrl.signal, headers: { 'Accept': 'application/vnd.api+json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data || !data.data) return [];
        return data.data.map(function(item) {
          var attr = item.attributes || {};
          var poster = attr.posterImage || {};
          var title = attr.canonicalTitle || 'Unknown';
          var year = attr.startDate ? String(attr.startDate).substring(0, 4) : '';
          var rating = attr.averageRating ? (parseFloat(attr.averageRating) / 10).toFixed(1) : '';
          var slug = attr.slug || slugify(title);
          return {
            source: 'kitsu',
            anime: slug,
            title: title,
            episode: 1,
            thumb: poster.small || poster.tiny || '',
            year: year,
            rating: rating,
            subtype: attr.subtype || '',
            episodes: attr.episodeCount || null,
            watchUrl: '/reels/anime_' + encodeURIComponent(slug) + '_ep1'
          };
        });
      })
      .catch(function() { return []; });
  }

  function renderResults(results, query, dropdown) {
    if (!dropdown) return;
    
    if (!results || results.length === 0) {
      dropdown.innerHTML =
        '<div class="hsr-empty">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' +
        '<div><div class="hsr-empty-t">No results for "' + esc(query) + '"</div>' +
        '<div class="hsr-empty-s">Try different keywords or paste a link</div></div></div>';
      dropdown.classList.add('open');
      return;
    }

    // Separate FB results and Kitsu results
    var fbResults = results.filter(function(r) { return r.source === 'fb'; });
    var kitsuResults = results.filter(function(r) { return r.source === 'kitsu'; });
    
    var html = '';
    
    if (fbResults.length > 0) {
      html += '<div class="hsr-hint hsr-hint-fb">🎬 From your Facebook posts</div>';
      fbResults.forEach(function(item) {
        html += buildFbCard(item);
      });
    }
    
    if (kitsuResults.length > 0) {
      html += '<div class="hsr-hint">📚 General anime database</div>';
      kitsuResults.forEach(function(item) {
        html += buildKitsuCard(item);
      });
    }

    dropdown.innerHTML = html;
    dropdown.classList.add('open');
  }
  
  function buildFbCard(item) {
    var html = '<a href="' + item.watchUrl + '" class="sd-card sd-card-fb">';
    html += '<div class="sd-thumb sd-thumb-fb">';
    if (item.thumb) {
      html += '<img src="' + esc(item.thumb) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">';
    } else {
      html += '<div class="sd-fb-icon">🎬</div>';
    }
    html += '<span class="sd-fb-badge">FB</span>';
    html += '</div>';
    html += '<div class="sd-body">';
    html += '<div class="sd-title">' + esc(item.title || item.anime) + '</div>';
    if (item.caption) {
      html += '<div class="sd-caption">' + esc(item.caption.substring(0, 80)) + (item.caption.length > 80 ? '…' : '') + '</div>';
    }
    html += '<div class="sd-meta">';
    html += '<span class="sd-ep">EP ' + item.episode + '</span>';
    if (item.matchType === 'link') {
      html += '<span class="sd-dot">·</span><span class="sd-link-match">🔗 Link match</span>';
    }
    html += '</div>';
    html += '</div></a>';
    return html;
  }
  
  function buildKitsuCard(item) {
    var html = '<a href="' + item.watchUrl + '" class="sd-card">';
    html += '<div class="sd-thumb">';
    if (item.thumb) {
      html += '<img src="' + esc(item.thumb) + '" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display=\'none\'">';
    }
    html += '</div>';
    html += '<div class="sd-body">';
    html += '<div class="sd-title">' + esc(item.title) + '</div>';
    html += '<div class="sd-meta">';
    if (item.rating) html += '<span class="sd-rating">★ ' + item.rating + '</span>';
    if (item.subtype) { if (item.rating) html += '<span class="sd-dot">·</span>'; html += '<span>' + esc(item.subtype) + '</span>'; }
    if (item.year) { html += '<span class="sd-dot">·</span><span>' + esc(item.year) + '</span>'; }
    if (item.episodes) { html += '<span class="sd-dot">·</span><span>' + item.episodes + ' EP</span>'; }
    html += '</div>';
    html += '</div></a>';
    return html;
  }

  function doSearch(rawQuery, dropdown, spinner) {
    var cacheKey = rawQuery.toLowerCase().trim();
    if (searchCache[cacheKey]) {
      renderResults(searchCache[cacheKey], rawQuery, dropdown);
      return;
    }
    
    if (spinner) spinner.style.display = 'flex';
    var ctrl = new AbortController();
    dropdown.innerHTML = '<div class="hsr-loading"><div class="hsr-spin"></div><span>Searching...</span></div>';
    dropdown.classList.add('open');

    // Search BOTH FB database AND Kitsu in parallel
    Promise.all([
      searchFbDatabase(rawQuery, ctrl),
      searchKitsu(rawQuery, ctrl)
    ]).then(function(both) {
      if (spinner) spinner.style.display = 'none';
      var fbResults = both[0] || [];
      var kitsuResults = both[1] || [];
      var combined = fbResults.concat(kitsuResults);
      searchCache[cacheKey] = combined;
      renderResults(combined, rawQuery, dropdown);
    }).catch(function() {
      if (spinner) spinner.style.display = 'none';
      dropdown.innerHTML = '<div class="hsr-empty"><div><div class="hsr-empty-t">Search failed</div><div class="hsr-empty-s">Try again</div></div></div>';
      dropdown.classList.add('open');
    });
  }

  /* URL TOAST */
  var urlToast = $('urlToast');
  var urlToastTitle = $('urlToastTitle');
  var urlToastSub = $('urlToastSub');
  var urlToastCancel = $('urlToastCancel');
  var urlResolveCtrl = null;

  function showUrlToast(title, sub) {
    if (!urlToast) return;
    if (urlToastTitle) urlToastTitle.textContent = title || 'Detecting...';
    if (urlToastSub) urlToastSub.textContent = sub || 'Searching...';
    urlToast.style.display = 'flex';
    requestAnimationFrame(function() { urlToast.classList.add('visible'); });
  }
  function hideUrlToast() {
    if (!urlToast) return;
    urlToast.classList.remove('visible');
    setTimeout(function() { urlToast.style.display = 'none'; }, 350);
  }
  if (urlToastCancel) {
    urlToastCancel.addEventListener('click', function() {
      if (urlResolveCtrl) urlResolveCtrl.abort();
      hideUrlToast();
    });
  }

  function resolveUrl(url) {
    if (urlResolveCtrl) urlResolveCtrl.abort();
    urlResolveCtrl = new AbortController();
    showUrlToast('Detecting anime...', 'Checking database');
    
    fetch('/api/link-resolver?url=' + encodeURIComponent(url), { signal: urlResolveCtrl.signal })
      .then(function(r) { 
        return r.json().then(function(data) {
          return { status: r.status, data: data };
        });
      })
      .then(function(result) {
        var data = result.data;
        
        // ═══ SUCCESS - Auto-detected ═══
        if (data && data.success && data.redirectUrl) {
          var sourceText = 'Redirecting...';
          if (data.source === 'kv-direct') sourceText = 'Found instantly!';
          else if (data.source === 'caption-match') sourceText = 'Matched by caption!';
          
          showUrlToast('Found: ' + (data.title || 'Anime'), sourceText);
          setTimeout(function() { 
            hideUrlToast(); 
            window.location.href = data.redirectUrl; 
          }, 700);
          return;
        }
        
        // ═══ NEEDS MANUAL HELP - Show picker ═══
        if (data && data.needsManualHelp) {
          hideUrlToast();
          showPickerModal({
            extracted: data.extracted || null,
            originalUrl: url
          });
          return;
        }
        
        // ═══ COMPLETE FAILURE ═══
        hideUrlToast();
        showPickerModal({
          extracted: null,
          originalUrl: url
        });
      })
      .catch(function(err) {
        if (err && err.name === 'AbortError') return;
        hideUrlToast();
        showPickerModal({
          extracted: null,
          originalUrl: url
        });
      });
  }

  /* DESKTOP SEARCH */
  var searchInput = $('quickSearch');
  var searchDD = $('searchDD');
  var siClear = $('siClear');
  var siSpinner = $('siSpinner');
  var searchTimer = null;

  function closeSearchDD() { if (searchDD) searchDD.classList.remove('open'); }

  if (siClear) {
    siClear.addEventListener('click', function() {
      searchInput.value = ''; siClear.style.display = 'none';
      closeSearchDD(); searchDD.innerHTML = ''; searchInput.focus();
    });
  }

  document.addEventListener('click', function(e) {
    var wrap = $('searchWrap');
    if (wrap && !wrap.contains(e.target)) closeSearchDD();
  });

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var val = searchInput.value.trim();
      if (siClear) siClear.style.display = val.length > 0 ? 'flex' : 'none';
      if (!val) { closeSearchDD(); searchDD.innerHTML = ''; return; }
      
      // If URL, show quick redirect option
      if (isUrl(val)) {
        clearTimeout(searchTimer);
        searchDD.innerHTML =
          '<a href="#" class="sd-linkbtn" id="resolveNowBtn">' +
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' +
          '<span>Find anime from this link</span></a>';
        searchDD.classList.add('open');
        var btn = document.getElementById('resolveNowBtn');
        if (btn) btn.addEventListener('click', function(e) { e.preventDefault(); closeSearchDD(); resolveUrl(val); });
        return;
      }
      
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() {
        if (val.length >= 2) doSearch(val, searchDD, siSpinner);
      }, 300);
    });

    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var val = searchInput.value.trim();
        if (!val) return;
        if (isUrl(val)) { closeSearchDD(); resolveUrl(val); }
        else if (val.length >= 2) doSearch(val, searchDD, siSpinner);
      }
      if (e.key === 'Escape') { closeSearchDD(); searchInput.blur(); }
    });
    searchInput.addEventListener('focus', function() {
      var val = searchInput.value.trim();
      if (val && searchDD.innerHTML.trim()) searchDD.classList.add('open');
    });
  }

  /* MOBILE SEARCH */
  var mobileSearchInput = $('mobileSearch');
  var mobileSearchDD = $('msbDD');
  var msbClear = $('msbClear');
  var msbSpinner = $('msbSpinner');
  var mobileSearchTimer = null;

  function closeMobileSearchDD() { if (mobileSearchDD) mobileSearchDD.classList.remove('open'); }

  if (msbClear) {
    msbClear.addEventListener('click', function() {
      mobileSearchInput.value = ''; msbClear.style.display = 'none';
      closeMobileSearchDD(); mobileSearchDD.innerHTML = ''; mobileSearchInput.focus();
    });
  }

  document.addEventListener('click', function(e) {
    var msb = $('msbInner');
    if (msb && !msb.contains(e.target)) closeMobileSearchDD();
  });

  if (mobileSearchInput) {
    mobileSearchInput.addEventListener('input', function() {
      var val = mobileSearchInput.value.trim();
      if (msbClear) msbClear.style.display = val.length > 0 ? 'flex' : 'none';
      if (!val) { closeMobileSearchDD(); mobileSearchDD.innerHTML = ''; return; }
      if (isUrl(val)) {
        clearTimeout(mobileSearchTimer);
        mobileSearchDD.innerHTML =
          '<a href="#" class="sd-linkbtn" id="mobResolveBtn">' +
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' +
          '<span>Find anime from this link</span></a>';
        mobileSearchDD.classList.add('open');
        var btn = document.getElementById('mobResolveBtn');
        if (btn) btn.addEventListener('click', function(e) { e.preventDefault(); closeMobileSearchDD(); resolveUrl(val); });
        return;
      }
      clearTimeout(mobileSearchTimer);
      mobileSearchTimer = setTimeout(function() {
        if (val.length >= 2) doSearch(val, mobileSearchDD, msbSpinner);
      }, 300);
    });

    mobileSearchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var val = mobileSearchInput.value.trim();
        if (!val) return;
        if (isUrl(val)) { closeMobileSearchDD(); resolveUrl(val); }
        else if (val.length >= 2) doSearch(val, mobileSearchDD, msbSpinner);
      }
    });
  }
  /* ═══════════════════════════════════════
     🎯 SMART PICKER MODAL LOGIC
  ═══════════════════════════════════════ */
  var pickerModal = $('pickerModal');
  var pickerBackdrop = $('pickerBackdrop');
  var pickerClose = $('pickerClose');
  var pickerCancel = $('pickerCancel');
  var pickerSearch = $('pickerSearch');
  var pickerResults = $('pickerResults');
  var pickerExtracted = $('pickerExtracted');
  var pickerExtractedThumb = $('pickerExtractedThumb');
  var pickerExtractedImg = $('pickerExtractedImg');
  var pickerExtractedCaption = $('pickerExtractedCaption');
  var pickerSearchTimer = null;
  var pickerContext = null;
  
  function showPickerModal(context) {
    if (!pickerModal) return;
    pickerContext = context || {};
    pickerModal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Show extracted data if any
    if (context.extracted && (context.extracted.caption || context.extracted.title || context.extracted.thumbnail)) {
      pickerExtracted.style.display = 'block';
      
      if (context.extracted.thumbnail) {
        pickerExtractedImg.src = context.extracted.thumbnail;
        pickerExtractedThumb.style.display = 'block';
      } else {
        pickerExtractedThumb.style.display = 'none';
      }
      
      var captionText = context.extracted.caption || context.extracted.title || '';
      if (captionText) {
        pickerExtractedCaption.textContent = '"' + captionText.slice(0, 200) + (captionText.length > 200 ? '...' : '') + '"';
        
        // Pre-fill search with extracted caption
        pickerSearch.value = captionText.slice(0, 60);
        setTimeout(function() { doPickerSearch(); }, 300);
      } else {
        pickerExtractedCaption.textContent = '';
      }
    } else {
      pickerExtracted.style.display = 'none';
    }
    
    // Focus search input
    setTimeout(function() { pickerSearch.focus(); }, 200);
  }
  
  function hidePickerModal() {
    if (!pickerModal) return;
    pickerModal.style.display = 'none';
    document.body.style.overflow = '';
    pickerSearch.value = '';
    pickerResults.innerHTML = '<div class="picker-hint">💡 Start typing to see matches</div>';
    pickerContext = null;
  }
  
  function doPickerSearch() {
    var q = pickerSearch.value.trim();
    if (!q || q.length < 2) {
      pickerResults.innerHTML = '<div class="picker-hint">💡 Type at least 2 characters</div>';
      return;
    }
    
    pickerResults.innerHTML = '<div class="picker-loading"><div class="picker-spin"></div><span>Searching...</span></div>';
    
    fetch('/api/fb-search?q=' + encodeURIComponent(q) + '&limit=10')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.success || !data.results || data.results.length === 0) {
          pickerResults.innerHTML = '<div class="picker-empty">' +
            '<div class="picker-empty-icon">🔍</div>' +
            '<div class="picker-empty-text">No matches found</div>' +
            '<div class="picker-empty-sub">Try different keywords or add via admin</div>' +
            '</div>';
          return;
        }
        
        var html = '';
        data.results.forEach(function(r) {
          var thumb = r.thumbnail || '';
          html += '<div class="picker-result-card" data-watch-url="' + esc(r.watchUrl) + '" data-anime-slug="' + esc(r.anime) + '">';
          html += '<div class="picker-result-thumb">';
          if (thumb) {
            html += '<img src="' + esc(thumb) + '" alt="" referrerpolicy="no-referrer" onerror="this.style.display=\'none\'" />';
          } else {
            html += '<span class="picker-result-emoji">🎬</span>';
          }
          html += '</div>';
          html += '<div class="picker-result-info">';
          html += '<div class="picker-result-title">' + esc(r.title || 'Unknown') + '</div>';
          html += '<div class="picker-result-meta">';
          html += '<span class="picker-result-ep">EP ' + r.episode + '</span>';
          if (r.season && r.season > 1) html += '<span class="picker-result-dot">·</span><span>S' + r.season + '</span>';
          html += '<span class="picker-result-dot">·</span><span>HD</span>';
          html += '</div>';
          if (r.caption) {
            html += '<div class="picker-result-caption">' + esc(r.caption.slice(0, 100)) + '</div>';
          }
          html += '</div>';
          html += '<div class="picker-result-arrow">→</div>';
          html += '</div>';
        });
        
        pickerResults.innerHTML = html;
        
        // Attach click handlers
        var cards = pickerResults.querySelectorAll('.picker-result-card');
        for (var i = 0; i < cards.length; i++) {
          cards[i].addEventListener('click', function() {
            var url = this.getAttribute('data-watch-url');
            if (url) {
              // Try to save the original FB link to this anime (auto-learn)
              if (pickerContext && pickerContext.originalUrl) {
                var animeSlug = this.getAttribute('data-anime-slug');
                autoLearnLink(pickerContext.originalUrl, animeSlug);
              }
              window.location.href = url;
            }
          });
        }
      })
      .catch(function() {
        pickerResults.innerHTML = '<div class="picker-empty">' +
          '<div class="picker-empty-icon">⚠️</div>' +
          '<div class="picker-empty-text">Search failed</div>' +
          '<div class="picker-empty-sub">Try again in a moment</div>' +
          '</div>';
      });
  }
  
  // Auto-learn: when user manually picks anime for a failed link
  function autoLearnLink(fbUrl, animeSlug) {
    try {
      // Save to localStorage for now (admin can review later)
      var learned = JSON.parse(localStorage.getItem('anitube_learned_links') || '[]');
      learned.unshift({ fbUrl: fbUrl, animeSlug: animeSlug, time: Date.now() });
      if (learned.length > 50) learned = learned.slice(0, 50);
      localStorage.setItem('anitube_learned_links', JSON.stringify(learned));
    } catch(e) {}
  }
  
  if (pickerSearch) {
    pickerSearch.addEventListener('input', function() {
      clearTimeout(pickerSearchTimer);
      pickerSearchTimer = setTimeout(doPickerSearch, 300);
    });
    
    pickerSearch.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        doPickerSearch();
      }
    });
  }
  
  if (pickerClose) pickerClose.addEventListener('click', hidePickerModal);
  if (pickerCancel) pickerCancel.addEventListener('click', hidePickerModal);
  if (pickerBackdrop) pickerBackdrop.addEventListener('click', hidePickerModal);
  
  // Escape key closes picker
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && pickerModal && pickerModal.style.display === 'flex') {
      hidePickerModal();
    }
  });
})();
</script>

