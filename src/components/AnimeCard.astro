---
interface Props {
  title: string;
  image: string;
  slug: string;
  score?: number | null;
  year?: number | string;
  episodes?: number | string;
  genre?: string;
  status?: string;
  size?: 'small' | 'medium' | 'large';
}

const {
  title,
  image,
  slug,
  score = null,
  year = '',
  episodes = '?',
  genre = '',
  status = '',
  size = 'medium',
} = Astro.props;

const isNew = status === 'Currently Airing';
---

<a href={`/anime/${slug}`} class={`anime-card anime-card-${size}`}>
  
  <div class="anime-thumb">
    
    {image ? (
      <img src={image} alt={title} loading="lazy" class="anime-img" />
    ) : (
      <div class="anime-img-fallback">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
          <path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/>
        </svg>
      </div>
    )}
    
    <!-- Overlay -->
    <div class="anime-overlay"></div>
    
    <!-- Corner accents -->
    <div class="anime-corner anime-corner-tl"></div>
    <div class="anime-corner anime-corner-tr"></div>
    <div class="anime-corner anime-corner-bl"></div>
    <div class="anime-corner anime-corner-br"></div>
    
    <!-- Play button (matches logo colors, pulsing) -->
    <div class="anime-play">
      <div class="anime-play-ring anime-play-ring-1"></div>
      <div class="anime-play-ring anime-play-ring-2"></div>
      <div class="anime-play-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
    
    <!-- Top badges -->
    <div class="anime-badges-top">
      {isNew && (
        <div class="anime-badge anime-badge-new">
          <span class="anime-new-dot"></span>
          NEW
        </div>
      )}
      {score && (
        <div class="anime-badge anime-badge-score">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {score}
        </div>
      )}
    </div>
    
    <!-- HD badge bottom right -->
    <div class="anime-hd">HD</div>
    
    <!-- Bottom info -->
    <div class="anime-info">
      <h3 class="anime-title">{title}</h3>
      <div class="anime-meta">
        {year && <span>{year}</span>}
        {episodes && <span>{episodes} EP</span>}
        {genre && <span class="anime-genre">{genre}</span>}
      </div>
    </div>
    
  </div>
  
</a>

<style>
  .anime-card {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 0.3s ease;
  }
  
  .anime-card:hover {
    transform: translateY(-6px);
  }
  
  .anime-thumb {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(28, 15, 61, 0.5);
    box-shadow: 
      0 10px 30px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(192, 132, 252, 0.15);
    transition: box-shadow 0.4s ease;
  }
  
  .anime-card:hover .anime-thumb {
    box-shadow: 
      0 20px 45px rgba(0, 0, 0, 0.5),
      0 0 0 2px rgba(192, 132, 252, 0.6),
      0 0 30px rgba(192, 132, 252, 0.25);
  }
  
  .anime-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.4s ease;
  }
  
  .anime-card:hover .anime-img {
    transform: scale(1.08);
    filter: brightness(0.75);
  }
  
  .anime-img-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(125, 211, 252, 0.1));
    color: rgba(192, 132, 252, 0.5);
  }
  
  /* Overlay gradient */
  .anime-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      transparent 40%,
      rgba(10, 5, 23, 0.5) 75%,
      rgba(10, 5, 23, 0.95) 100%
    );
    z-index: 1;
  }
  
  /* Corner accents (hover only) */
  .anime-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid #7dd3fc;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    filter: drop-shadow(0 0 4px #7dd3fc);
  }
  
  .anime-card:hover .anime-corner {
    opacity: 0.9;
  }
  
  .anime-corner-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; }
  .anime-corner-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; }
  .anime-corner-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; }
  .anime-corner-br { bottom: 10px; right: 10px; border-left: none; border-top: none; }
  
  /* PLAY BUTTON — Matches logo gradient, pulses always */
  .anime-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .anime-card:hover .anime-play {
    opacity: 1;
  }
  
  .anime-play-btn {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc 0%, #e879f9 50%, #7dd3fc 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding-left: 3px;
    box-shadow: 
      0 8px 25px rgba(192, 132, 252, 0.6),
      0 0 40px rgba(232, 121, 249, 0.3);
    z-index: 2;
  }
  
  .anime-play-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(192, 132, 252, 0.7);
    pointer-events: none;
  }
  
  .anime-play-ring-1 {
    animation: anime-play-pulse 1.8s ease-out infinite;
  }
  
  .anime-play-ring-2 {
    animation: anime-play-pulse 1.8s ease-out infinite;
    animation-delay: 0.9s;
  }
  
  @keyframes anime-play-pulse {
    0%   { transform: scale(1);   opacity: 1; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  
  /* Top badges */
  .anime-badges-top {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    justify-content: space-between;
    gap: 6px;
    z-index: 3;
  }
  
  .anime-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    backdrop-filter: blur(8px);
  }
  
  .anime-badge-new {
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    box-shadow: 0 3px 10px rgba(239, 68, 68, 0.4);
  }
  
  .anime-new-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 5px #fff;
    animation: anime-new-blink 1.2s ease infinite;
  }
  
  @keyframes anime-new-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
  
  .anime-badge-score {
    background: rgba(0, 0, 0, 0.75);
    color: #fbbf24;
    margin-left: auto;
  }
  
  /* HD badge */
  .anime-hd {
    position: absolute;
    bottom: 90px;
    right: 10px;
    background: rgba(125, 211, 252, 0.9);
    color: #0a0517;
    padding: 3px 7px;
    border-radius: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    z-index: 3;
  }
  
  /* Bottom info */
  .anime-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 14px 16px;
    z-index: 2;
  }
  
  .anime-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 5px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  
  .anime-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
    flex-wrap: wrap;
  }
  
  .anime-meta > span {
    display: inline-flex;
    align-items: center;
  }
  
  .anime-meta > span + span::before {
    content: '•';
    margin-right: 8px;
    color: rgba(255, 255, 255, 0.3);
  }
  
  .anime-genre {
    color: #c084fc !important;
    font-weight: 700;
  }
  
  .anime-meta > .anime-genre + span::before,
  .anime-meta > span + .anime-genre::before {
    color: rgba(255, 255, 255, 0.3);
  }
  
  /* Size variants */
  .anime-card-small .anime-title { font-size: 0.82rem; }
  .anime-card-small .anime-meta { font-size: 0.65rem; }
  .anime-card-small .anime-play { width: 46px; height: 46px; }
  
  .anime-card-large .anime-title { font-size: 1.1rem; }
  
  /* Responsive */
  @media (max-width: 640px) {
    .anime-title { font-size: 0.85rem; }
    .anime-meta { font-size: 0.65rem; gap: 6px; }
    .anime-play { width: 46px; height: 46px; }
    .anime-play-btn svg { width: 18px; height: 18px; }
    .anime-info { padding: 10px 10px 12px; }
    .anime-hd { bottom: 70px; }
  }
</style>
