  function fmtTime(ts) {
    var d = new Date(ts);
    var days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
    var h = d.getHours(), m = d.getMinutes();
    var ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    m = m < 10 ? '0' + m : m;
    return days[d.getDay()] + ' AT ' + h + ':' + m + ' ' + ap;
  }

  function addTimestampEl(ts) {
    var d = document.createElement('div');
