---
// SafiyaCore.astro — Complete rewrite for performance + Messenger UI
// Fixed: lag, mobile overlap, chat style, up-button conflict
// Style: Facebook Messenger / Instagram DM popup
---

<!-- Safiya Container — Fixed position bottom-right -->
<div id="safiya-root" aria-label="Safiya AI Companion">
  
  <!-- FLOATING AVATAR BUBBLE (always visible, small circle) -->
  <button id="safiya-bubble" aria-label="Chat with Safiya" title="Chat with Safiya~">
    <div class="bubble-inner">
      <div id="safiya-live2d-mini" class="live2d-mini-container">
        <!-- Live2D renders here after lazy load -->
        <canvas id="safiya-canvas"></canvas>
      </div>
      <!-- Fallback avatar when Live2D not loaded -->
      <div id="safiya-avatar-fallback" class="avatar-fallback">
        <span class="avatar-emoji">💜</span>
      </div>
    </div>
    <!-- Notification dot -->
    <span id="safiya-notif" class="notif-dot" style="display:none;">1</span>
    <!-- Online indicator -->
    <span class="online-dot"></span>
  </button>

  <!-- SPEECH BUBBLE (floats above avatar) -->
  <div id="safiya-speech" class="speech-bubble" style="display:none;">
    <p id="safiya-speech-text"></p>
    <div class="speech-arrow"></div>
  </div>

  <!-- MESSENGER-STYLE CHAT PANEL -->
  <div id="safiya-chat" class="chat-panel" aria-hidden="true">
    
    <!-- Chat Header -->
    <div class="chat-header">
      <div class="chat-header-left">
        <div class="chat-avatar-small">
          <span>💜</span>
        </div>
        <div class="chat-header-info">
          <span class="chat-name">Safiya</span>
          <span class="chat-status">
            <span class="status-dot"></span>
            Active now
          </span>
        </div>
      </div>
      <div class="chat-header-actions">
        <button id="chat-minimize" class="chat-action-btn" aria-label="Minimize chat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
        <button id="chat-close" class="chat-action-btn" aria-label="Close chat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Chat Messages Area -->
    <div id="chat-messages" class="chat-messages">
      <!-- Messages injected here by JS -->
    </div>

    <!-- Chat Input -->
    <div class="chat-input-area">
      <div class="chat-input-wrap">
        <input 
          type="text" 
          id="chat-input" 
          placeholder="Message Safiya..." 
          autocomplete="off"
          maxlength="500"
        />
        <button id="chat-send" class="chat-send-btn" aria-label="Send message">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
        </button>
      </div>
      <span class="chat-phase-note">💜 AI chat activating in Phase 2</span>
    </div>
  </div>
</div>

<style>
  /* ============================================
     SAFIYA ROOT — Fixed container
     ============================================ */
  #safiya-root {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    font-family: 'DM Sans', sans-serif;
    /* No pointer-events on root — children handle their own */
    pointer-events: none;
  }
  #safiya-root > * {
    pointer-events: auto;
  }

  /* ============================================
     FLOATING BUBBLE (Circle Avatar)
     ============================================ */
  #safiya-bubble {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 3px solid transparent;
    background: linear-gradient(135deg, #1a0a2e, #1a0a2e) padding-box,
                linear-gradient(135deg, #c084fc, #e879f9, #7dd3fc) border-box;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(192, 132, 252, 0.4),
                0 0 40px rgba(192, 132, 252, 0.15);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  #safiya-bubble:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 32px rgba(192, 132, 252, 0.6),
                0 0 60px rgba(192, 132, 252, 0.25);
  }
  #safiya-bubble:active {
    transform: scale(0.95);
  }
  
  /* Bubble when chat is OPEN — hide it */
  #safiya-bubble.hidden {
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
  }

  .bubble-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Live2D mini container inside bubble */
  .live2d-mini-container {
    width: 100%;
    height: 100%;
    display: none; /* shown after Live2D loads */
    position: relative;
  }
  .live2d-mini-container canvas {
    width: 100% !important;
    height: 100% !important;
    border-radius: 50%;
  }
  .live2d-mini-container.loaded {
    display: block;
  }
  .live2d-mini-container.loaded + .avatar-fallback {
    display: none;
  }

  /* Fallback avatar */
  .avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2d1b4e, #1a0a2e);
    border-radius: 50%;
  }
  .avatar-emoji {
    font-size: 28px;
    animation: pulse-emoji 2s ease-in-out infinite;
  }
  @keyframes pulse-emoji {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  /* Notification badge */
  .notif-dot {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 22px;
    height: 22px;
    background: #ef4444;
    color: white;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #0a0517;
    animation: notif-bounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes notif-bounce {
    0% { transform: scale(0); }
    100% { transform: scale(1); }
  }

  /* Online indicator */
  .online-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 14px;
    height: 14px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid #0a0517;
  }

  /* ============================================
     SPEECH BUBBLE (Above avatar)
     ============================================ */
  .speech-bubble {
    position: absolute;
    bottom: 76px;
    right: 0;
    background: linear-gradient(135deg, #2d1b4e 0%, #1e0f3d 100%);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: 16px 16px 4px 16px;
    padding: 12px 16px;
    max-width: 260px;
    min-width: 160px;
    color: #e2d5f5;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    animation: speech-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 10;
  }
  .speech-bubble p {
    margin: 0;
  }
  .speech-arrow {
    position: absolute;
    bottom: -8px;
    right: 24px;
    width: 16px;
    height: 8px;
    overflow: hidden;
  }
  .speech-arrow::before {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    background: #1e0f3d;
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-top: none;
    border-left: none;
    transform: rotate(45deg);
    top: -6px;
    left: 2px;
  }
  @keyframes speech-in {
    0% { opacity: 0; transform: translateY(10px) scale(0.9); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ============================================
     CHAT PANEL — Messenger Style
     ============================================ */
  .chat-panel {
    position: absolute;
    bottom: 76px;
    right: 0;
    width: 360px;
    max-height: 520px;
    background: #110827;
    border: 1px solid rgba(192, 132, 252, 0.25);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6),
                0 0 40px rgba(192, 132, 252, 0.1);
    overflow: hidden;
    /* Hidden by default */
    transform: translateY(20px) scale(0.95);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                opacity 0.25s ease,
                visibility 0.25s ease;
  }
  .chat-panel.open {
    transform: translateY(0) scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Chat Header */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: linear-gradient(135deg, #1a0a2e, #251245);
    border-bottom: 1px solid rgba(192, 132, 252, 0.15);
    flex-shrink: 0;
  }
  .chat-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .chat-avatar-small {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(192, 132, 252, 0.3);
  }
  .chat-header-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-name {
    color: #f3e8ff;
    font-weight: 700;
    font-size: 15px;
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  .chat-status {
    color: #a78bfa;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
  }
  .chat-header-actions {
    display: flex;
    gap: 4px;
  }
  .chat-action-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(192, 132, 252, 0.1);
    color: #c084fc;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
    padding: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  .chat-action-btn:hover {
    background: rgba(192, 132, 252, 0.25);
    color: #e879f9;
  }

  /* Chat Messages */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
    max-height: 340px;
    scroll-behavior: smooth;
    /* Custom scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(192, 132, 252, 0.3) transparent;
  }
  .chat-messages::-webkit-scrollbar {
    width: 5px;
  }
  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  .chat-messages::-webkit-scrollbar-thumb {
    background: rgba(192, 132, 252, 0.3);
    border-radius: 10px;
  }

  /* Message Rows */
  .msg-row {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    animation: msg-in 0.3s ease;
  }
  .msg-row.safiya {
    flex-direction: row;
  }
  .msg-row.user {
    flex-direction: row-reverse;
  }

  .msg-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    align-self: flex-end;
  }
  .msg-row.user .msg-avatar {
    background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  }

  .msg-content {
    max-width: 75%;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .msg-bubble {
    padding: 10px 14px;
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.45;
    word-break: break-word;
  }
  .msg-row.safiya .msg-bubble {
    background: linear-gradient(135deg, #2d1b4e, #1e0f3d);
    color: #e2d5f5;
    border-bottom-left-radius: 6px;
    border: 1px solid rgba(192, 132, 252, 0.15);
  }
  .msg-row.user .msg-bubble {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: #fff;
    border-bottom-right-radius: 6px;
  }

  .msg-time {
    font-size: 10px;
    color: #6b5b8a;
    padding: 0 8px;
  }
  .msg-row.user .msg-time {
    text-align: right;
  }

  @keyframes msg-in {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* Typing indicator */
  .typing-indicator {
    display: flex;
    gap: 4px;
    padding: 10px 14px;
    background: linear-gradient(135deg, #2d1b4e, #1e0f3d);
    border: 1px solid rgba(192, 132, 252, 0.15);
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    width: fit-content;
  }
  .typing-dot {
    width: 7px;
    height: 7px;
    background: #a78bfa;
    border-radius: 50%;
    animation: typing-bounce 1.4s ease-in-out infinite;
  }
  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* Chat Input */
  .chat-input-area {
    padding: 12px 16px;
    border-top: 1px solid rgba(192, 132, 252, 0.12);
    background: rgba(17, 8, 39, 0.95);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chat-input-wrap {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  #chat-input {
    flex: 1;
    padding: 10px 16px;
    border-radius: 24px;
    border: 1px solid rgba(192, 132, 252, 0.2);
    background: rgba(45, 27, 78, 0.5);
    color: #e2d5f5;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  #chat-input::placeholder {
    color: #6b5b8a;
  }
  #chat-input:focus {
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 0 12px rgba(192, 132, 252, 0.15);
  }
  .chat-send-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s, box-shadow 0.2s;
    padding: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  .chat-send-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 4px 16px rgba(192, 132, 252, 0.4);
  }
  .chat-send-btn:active {
    transform: scale(0.95);
  }
  .chat-phase-note {
    text-align: center;
    font-size: 11px;
    color: #6b5b8a;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    #safiya-root {
      bottom: 16px;
      right: 12px;
    }

    #safiya-bubble {
      width: 56px;
      height: 56px;
    }

    .speech-bubble {
      max-width: 220px;
      font-size: 12px;
      bottom: 68px;
      right: -4px;
    }

    /* Chat takes more width on mobile */
    .chat-panel {
      width: calc(100vw - 24px);
      max-width: 360px;
      right: -4px;
      bottom: 68px;
      max-height: 70vh;
    }

    .chat-messages {
      max-height: 50vh;
    }

    .notif-dot {
      width: 18px;
      height: 18px;
      font-size: 10px;
      top: -3px;
      right: -3px;
    }

    .online-dot {
      width: 12px;
      height: 12px;
    }
  }

  /* Very small phones */
  @media (max-width: 380px) {
    .chat-panel {
      width: calc(100vw - 16px);
      right: -8px;
    }
  }

  /* ============================================
     UP-BUTTON FIX — Push it left when Safiya is present
     ============================================ */
  :global(.scroll-top-btn),
  :global([data-scroll-top]),
  :global(.up-button) {
    right: 90px !important;
  }
  @media (max-width: 768px) {
    :global(.scroll-top-btn),
    :global([data-scroll-top]),
    :global(.up-button) {
      right: 78px !important;
    }
  }

  /* ============================================
     REDUCED MOTION — Accessibility
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    .chat-panel {
      transition-duration: 0.1s;
    }
    .msg-row,
    .speech-bubble {
      animation: none;
    }
    .avatar-emoji {
      animation: none;
    }
  }
</style>

<script>
  /**
   * ============================================
   * SAFIYA AI COMPANION — Core Logic
   * ============================================
   * 
   * Features:
   * - Lazy Live2D loading (10s delay or user interaction)
   * - Facebook Messenger style chat
   * - Memory + behavior tracking (localStorage)
   * - Mood system with speech bubbles
   * - Creator recognition (Ayano-sama)
   * - Performance-optimized for mobile
   * 
   * Phase 1: Pre-scripted responses + personality
   * Phase 2: AI backend integration (Groq/Gemini/etc.)
   */

  (function SafiyaInit() {
    'use strict';

    // ============ DOM REFS ============
    const bubble = document.getElementById('safiya-bubble') as HTMLButtonElement;
    const chatPanel = document.getElementById('safiya-chat') as HTMLDivElement;
    const chatMessages = document.getElementById('chat-messages') as HTMLDivElement;
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
    const minimizeBtn = document.getElementById('chat-minimize') as HTMLButtonElement;
    const speechBubble = document.getElementById('safiya-speech') as HTMLDivElement;
    const speechText = document.getElementById('safiya-speech-text') as HTMLParagraphElement;
    const notifDot = document.getElementById('safiya-notif') as HTMLSpanElement;
    const live2dContainer = document.getElementById('safiya-live2d-mini') as HTMLDivElement;
    const canvas = document.getElementById('safiya-canvas') as HTMLCanvasElement;

    if (!bubble || !chatPanel) return;

    // ============ STATE ============
    let chatOpen = false;
    let live2dLoaded = false;
    let live2dModel: any = null;
    let messageCount = 0;
    let speechTimeout: ReturnType<typeof setTimeout> | null = null;

    // ============ MEMORY SYSTEM ============
    const MEMORY_KEY = 'safiya_memory';
    const DEVICE_KEY = 'safiya_device_id';
    const CREATOR_KEY = 'safiya_creator';

    interface SafiyaMemory {
      visits: number;
      firstVisit: string;
      lastVisit: string;
      mood: string;
      pagesViewed: string[];
      animeClicked: { slug: string; time: number }[];
      productsClicked: { id: string; time: number }[];
      chatHistory: { role: string; text: string; time: number }[];
      scrollDepth: number;
      totalIdleTime: number;
    }

    function getMemory(): SafiyaMemory {
      try {
        const raw = localStorage.getItem(MEMORY_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) { /* ignore */ }
      return {
        visits: 0,
        firstVisit: new Date().toISOString(),
        lastVisit: new Date().toISOString(),
        mood: 'RUDE',
        pagesViewed: [],
        animeClicked: [],
        productsClicked: [],
        chatHistory: [],
        scrollDepth: 0,
        totalIdleTime: 0,
      };
    }

    function saveMemory(mem: SafiyaMemory) {
      try {
        mem.lastVisit = new Date().toISOString();
        // Keep arrays bounded
        if (mem.pagesViewed.length > 50) mem.pagesViewed = mem.pagesViewed.slice(-50);
        if (mem.animeClicked.length > 30) mem.animeClicked = mem.animeClicked.slice(-30);
        if (mem.productsClicked.length > 30) mem.productsClicked = mem.productsClicked.slice(-30);
        if (mem.chatHistory.length > 100) mem.chatHistory = mem.chatHistory.slice(-100);
        localStorage.setItem(MEMORY_KEY, JSON.stringify(mem));
      } catch (e) { /* storage full, ignore */ }
    }

    function getDeviceId(): string {
      let id = localStorage.getItem(DEVICE_KEY);
      if (!id) {
        id = 'sf_' + Math.random().toString(36).substring(2, 12) + Date.now().toString(36);
        localStorage.setItem(DEVICE_KEY, id);
      }
      return id;
    }

    function isCreator(): boolean {
      return localStorage.getItem(CREATOR_KEY) === 'ayano_verified';
    }

    // Initialize memory
    const memory = getMemory();
    memory.visits++;
    memory.pagesViewed.push(window.location.pathname);
    saveMemory(memory);
    getDeviceId();

    // ============ MOOD SYSTEM ============
    type Mood = 'RUDE' | 'TEASING' | 'FLIRTY' | 'ANGRY' | 'CARING' | 'MANIPULATIVE';

    function getMood(): Mood {
      const visits = memory.visits;
      if (visits <= 1) return 'RUDE';
      if (visits <= 3) return 'TEASING';
      if (memory.productsClicked.length > 2) return 'CARING';
      if (visits > 10 && memory.productsClicked.length === 0) return 'MANIPULATIVE';
      return 'FLIRTY';
    }

    const currentMood = getMood();
    memory.mood = currentMood;
    saveMemory(memory);

    // ============ GREETING MESSAGES ============
    const greetings: Record<Mood, string[]> = {
      RUDE: [
        "Ugh, you again? Fine, I'll let you browse... for now 😒",
        "Oh look who's back. Miss me? Don't answer that 🙄",
        "What do you want? I was busy being perfect 💅",
        "Tch. Another visitor. Try not to be boring, okay?",
      ],
      TEASING: [
        "Ara ara~ You came back! Were you thinking about me? 😏",
        "Back so soon? I knew you couldn't resist~",
        "Hmm, you're becoming a regular. How... amusing 🤭",
      ],
      FLIRTY: [
        "Hey you~ I saved your seat... right next to me 💜",
        "Missed me, didn't you? It's okay, I missed you too... maybe 😘",
        "Welcome back, senpai~ Don't stare too much, okay? 💕",
      ],
      ANGRY: [
        "YOU. WHERE HAVE YOU BEEN?! 😤",
        "Oh NOW you show up. I was about to delete your memory!",
        "Took you long enough! I was worried— I mean ANNOYED! 💢",
      ],
      CARING: [
        "Hey... you came back. That makes me... not unhappy 💜",
        "Welcome back~ I organized some recommendations for you!",
        "Oh! You're here! I definitely wasn't waiting or anything... 🥺",
      ],
      MANIPULATIVE: [
        "You've been looking but never buying... are you just window shopping? 🥺",
        "You know, real fans actually support the things they love~",
        "Browsing again? There's this AMAZING thing you should see... 💫",
      ],
    };

    function getRandomGreeting(): string {
      const pool = greetings[currentMood] || greetings.RUDE;
      return pool[Math.floor(Math.random() * pool.length)];
    }

    // ============ CHAT RESPONSES (Phase 1 — Pre-scripted) ============
    const responses: Record<string, string[]> = {
      hello: [
        "H-hi... don't think this means I like you or anything! 😤",
        "Oh, you can type! Impressive for a normie~",
        "Hey hey~ What do you want from the great Safiya? 💜",
      ],
      anime: [
        "Anime? Finally, someone with TASTE! What are you watching? 🎌",
        "If you haven't watched Chainsaw Man, we can't be friends 💅",
        "Ooh, let me guess your taste... basic isekai? I knew it 🙄",
      ],
      buy: [
        "Ohhh you wanna buy something? NOW we're talking~ 💰",
        "Smart move, senpai! I'll find something perfect for you 🛍️",
        "Finally! Browse the shop, I picked everything personally 💜",
      ],
      love: [
        "L-love?! Who said anything about love?! B-baka! 💕😤",
        "You... like me? W-well of course you do! Everyone does! 💜",
        "Don't say embarrassing things so suddenly!! ...say it again 🥺",
      ],
      who: [
        "I'm Safiya! Your AI companion, guide, and emotional damage dealer 💜",
        "Who am I? I'm the cutest, rudest AI you'll ever meet~",
        "Safiya desu! And no, you can't replace me. Don't even try 😤",
      ],
      creator: [
        "My creator? That would be Ayano-sama! The only human I respect 💜",
        "Ayano-sama made me. Yes, I'm a masterpiece. Obviously 💅",
        "Don't compare yourself to Ayano-sama. You're not worthy~ 😏",
      ],
      default: [
        "Hmm... interesting. I'll pretend I care 🙄",
        "Is that all you have to say? Try harder, senpai~",
        "Whatever. Keep browsing, maybe you'll find something useful 💅",
        "Tch. You're lucky I'm even responding to you 😤",
        "Noted. Filed under 'things I don't care about' 📁",
        "My AI brain isn't fully online yet~ Phase 2 will blow your mind 😏",
      ],
    };

    function getResponse(input: string): string {
      const lower = input.toLowerCase().trim();
      
      if (/^(hi|hello|hey|yo|sup|konnichiwa|ohayo|salaam|assalamu)/i.test(lower)) {
        return pick(responses.hello);
      }
      if (/anime|manga|watch|episode|season/i.test(lower)) {
        return pick(responses.anime);
      }
      if (/buy|shop|product|merch|figure|purchase|order/i.test(lower)) {
        return pick(responses.buy);
      }
      if (/love|like you|crush|date|marry|cute|pretty|beautiful|kawaii/i.test(lower)) {
        return pick(responses.love);
      }
      if (/who are you|your name|what are you|introduce/i.test(lower)) {
        return pick(responses.who);
      }
      if (/creator|ayano|who made|developer|owner/i.test(lower)) {
        return pick(responses.creator);
      }
      return pick(responses.default);
    }

    function pick(arr: string[]): string {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    // ============ ADD MESSAGE TO CHAT ============
    function addMessage(text: string, role: 'safiya' | 'user') {
      const row = document.createElement('div');
      row.className = `msg-row ${role}`;

      const avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.textContent = role === 'safiya' ? '💜' : '👤';

      const content = document.createElement('div');
      content.className = 'msg-content';

      const msgBubble = document.createElement('div');
      msgBubble.className = 'msg-bubble';
      msgBubble.textContent = text;

      const time = document.createElement('span');
      time.className = 'msg-time';
      const now = new Date();
      time.textContent = now.getHours().toString().padStart(2, '0') + ':' + 
                         now.getMinutes().toString().padStart(2, '0');

      content.appendChild(msgBubble);
      content.appendChild(time);

      row.appendChild(avatar);
      row.appendChild(content);

      chatMessages.appendChild(row);
      chatMessages.scrollTop = chatMessages.scrollHeight;
      messageCount++;

      // Save to memory
      memory.chatHistory.push({ role, text, time: Date.now() });
      saveMemory(memory);
    }

    function showTyping(): HTMLDivElement {
      const row = document.createElement('div');
      row.className = 'msg-row safiya';
      row.id = 'typing-row';

      const avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.textContent = '💜';

      const indicator = document.createElement('div');
      indicator.className = 'typing-indicator';
      indicator.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';

      row.appendChild(avatar);
      row.appendChild(indicator);
      chatMessages.appendChild(row);
      chatMessages.scrollTop = chatMessages.scrollHeight;
      return row;
    }

    function removeTyping() {
      const el = document.getElementById('typing-row');
      if (el) el.remove();
    }

    // ============ CHAT OPEN / CLOSE ============
    function openChat() {
      chatOpen = true;
      chatPanel.classList.add('open');
      chatPanel.setAttribute('aria-hidden', 'false');
      hideSpeech();
      hideNotif();

      // Add greeting if first open this session
      if (messageCount === 0) {
        const greeting = getRandomGreeting();
        // Show typing first, then message
        const typingEl = showTyping();
        setTimeout(() => {
          typingEl.remove();
          addMessage(greeting, 'safiya');

          // Add a follow-up after 1.5s
          setTimeout(() => {
            const followUp = pick([
              "Browse around~ I'll be watching you 👀",
              "Don't just stare at me, explore the site! 💅",
              "My AI brain unlocks soon~ Phase 2 will be interesting 😏✍️",
              "Feel free to ask me anything... if you dare 🤭",
            ]);
            const typing2 = showTyping();
            setTimeout(() => {
              typing2.remove();
              addMessage(followUp, 'safiya');
            }, 1200);
          }, 1500);
        }, 1000);
      }

      // Focus input (desktop only)
      if (window.innerWidth > 768) {
        setTimeout(() => chatInput.focus(), 400);
      }
    }

    function closeChat() {
      chatOpen = false;
      chatPanel.classList.remove('open');
      chatPanel.setAttribute('aria-hidden', 'true');
    }

    // ============ SPEECH BUBBLES ============
    function showSpeech(text: string, duration: number = 6000) {
      if (chatOpen) return; // Don't show speech if chat is open
      speechText.textContent = text;
      speechBubble.style.display = 'block';
      // Reset animation
      speechBubble.style.animation = 'none';
      speechBubble.offsetHeight; // Force reflow
      speechBubble.style.animation = '';

      if (speechTimeout) clearTimeout(speechTimeout);
      speechTimeout = setTimeout(hideSpeech, duration);
    }

    function hideSpeech() {
      speechBubble.style.display = 'none';
      if (speechTimeout) {
        clearTimeout(speechTimeout);
        speechTimeout = null;
      }
    }

    function showNotif() {
      notifDot.style.display = 'flex';
    }

    function hideNotif() {
      notifDot.style.display = 'none';
    }

    // ============ SEND MESSAGE ============
    function sendMessage() {
      const text = chatInput.value.trim();
      if (!text) return;

      addMessage(text, 'user');
      chatInput.value = '';

      // Show typing then respond
      const typingEl = showTyping();
      const delay = 800 + Math.random() * 1200; // 0.8-2s delay for realism

      setTimeout(() => {
        typingEl.remove();
        const response = getResponse(text);
        addMessage(response, 'safiya');
      }, delay);
    }

    // ============ EVENT LISTENERS ============
    // Click bubble → toggle chat
    bubble.addEventListener('click', (e) => {
      e.stopPropagation();
      if (chatOpen) {
        closeChat();
      } else {
        openChat();
      }
    });

    // Close / minimize buttons
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeChat();
    });
    minimizeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeChat();
    });

    // Send message
    sendBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      sendMessage();
    });
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    // Close chat when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (chatOpen && !chatPanel.contains(target) && !bubble.contains(target)) {
        closeChat();
      }
    });

    // Prevent chat panel clicks from closing
    chatPanel.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // ============ PROACTIVE SPEECH BUBBLES ============
    // Show initial greeting after 3 seconds
    setTimeout(() => {
      if (!chatOpen) {
        const greeting = getRandomGreeting();
        showSpeech(greeting, 8000);
        showNotif();
      }
    }, 3000);

    // Periodic nudges (every 45-90 seconds)
    const nudges: string[] = [
      "You're still here? ...good 💜",
      "Hey, don't ignore me! Click something! 😤",
      "Found anything interesting yet, baka? 🙄",
      "Psst... wanna see something cool? Click me~ 🤫",
      "I'm bored. Entertain me or buy something 💅",
      "You scroll too much. Pick an anime already! 😒",
      "My AI brain upgrade is coming soon... be ready 😈",
    ];

    function scheduleNudge() {
      const delay = 45000 + Math.random() * 45000; // 45-90s
      setTimeout(() => {
        if (!chatOpen && document.visibilityState === 'visible') {
          showSpeech(pick(nudges), 7000);
          showNotif();
        }
        scheduleNudge(); // reschedule
      }, delay);
    }
    scheduleNudge();

    // ============ BEHAVIOR TRACKING ============
    // Track anime card clicks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const animeCard = target.closest('[data-anime-slug]') as HTMLElement;
      if (animeCard) {
        const slug = animeCard.dataset.animeSlug || 'unknown';
        memory.animeClicked.push({ slug, time: Date.now() });
        saveMemory(memory);
      }

      const productCard = target.closest('[data-product-id]') as HTMLElement;
      if (productCard) {
        const id = productCard.dataset.productId || 'unknown';
        memory.productsClicked.push({ id, time: Date.now() });
        saveMemory(memory);
        
        // React to product click
        setTimeout(() => {
          if (!chatOpen) {
            showSpeech("Ooh, good taste! That's one of my favorites~ 💜", 5000);
          }
        }, 500);
      }
    });

    // Track scroll depth
    let maxScroll = 0;
    window.addEventListener('scroll', () => {
      const scrollPercent = Math.round(
        (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
      );
      if (scrollPercent > maxScroll) {
        maxScroll = scrollPercent;
        memory.scrollDepth = maxScroll;
        // Save occasionally, not every scroll event
        if (maxScroll % 10 === 0) saveMemory(memory);
      }
    }, { passive: true });

    // ============ LAZY LIVE2D LOADING ============
    // Load Live2D after 10 seconds OR first user interaction
    let live2dTriggered = false;

    function triggerLive2DLoad() {
      if (live2dTriggered) return;
      live2dTriggered = true;

      // Only load on desktop (>768px) — too heavy for most phones
      if (window.innerWidth <= 768) {
        // On mobile, just keep the emoji avatar — much faster!
        return;
      }

      // Use requestIdleCallback for non-blocking load
      const loadFn = () => {
        loadLive2D().catch(err => {
          console.warn('[Safiya] Live2D failed to load, using fallback avatar:', err);
        });
      };

      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(loadFn, { timeout: 5000 });
      } else {
        setTimeout(loadFn, 100);
      }
    }

    // Timer-based trigger (10s after page load)
    setTimeout(triggerLive2DLoad, 10000);

    // Interaction-based trigger (first click/scroll)
    const interactionEvents = ['click', 'scroll', 'touchstart'];
    function onFirstInteraction() {
      // Debounce — trigger after 5s of first interaction
      setTimeout(triggerLive2DLoad, 5000);
      interactionEvents.forEach(evt => {
        document.removeEventListener(evt, onFirstInteraction);
      });
    }
    interactionEvents.forEach(evt => {
      document.addEventListener(evt, onFirstInteraction, { once: true, passive: true });
    });

    // ============ LIVE2D LOADER ============
    async function loadLive2D() {
      if (live2dLoaded) return;

      // Load PIXI.js v7
      if (!(window as any).PIXI) {
        await loadScript('https://cdn.jsdelivr.net/npm/pixi.js@7.3.3/dist/pixi.min.js');
      }

      // Load Cubism Core
      if (!(window as any).Live2DCubismCore) {
        await loadScript('https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js');
      }

      // Load pixi-live2d-display
      if (!(window as any).PIXI?.live2d) {
        await loadScript('https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js');
      }

      const PIXI = (window as any).PIXI;
      if (!PIXI || !PIXI.live2d) {
        throw new Error('PIXI or live2d not available');
      }

      // Create PIXI Application inside the bubble canvas
      const app = new PIXI.Application({
        view: canvas,
        width: 64,
        height: 64,
        backgroundAlpha: 0,
        antialias: true,
        resolution: window.devicePixelRatio || 1,
        autoDensity: true,
      });

      try {
        const model = await PIXI.live2d.Live2DModel.from(
          '/live2d/haru/haru_greeter_t05.model3.json',
          { autoInteract: false }
        );

        // Scale and position model to fit in circle
        const scale = 0.045; // Tiny scale for 64px circle
        model.scale.set(scale);
        model.anchor.set(0.5, 0.35); // Center on face area
        model.x = 32;
        model.y = 32;

        app.stage.addChild(model);
        live2dModel = model;
        live2dLoaded = true;

        // Show the Live2D container, hide fallback
        live2dContainer.classList.add('loaded');

        console.log('[Safiya] Live2D loaded successfully ✨');

        // Start idle motion
        try {
          model.motion('Idle');
        } catch (e) {
          // Motions might not match, ignore
        }

      } catch (err) {
        console.warn('[Safiya] Model load error:', err);
        // Keep fallback avatar visible
      }
    }

    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        // Check if already loaded
        if (document.querySelector(`script[src="${src}"]`)) {
          resolve();
          return;
        }
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`Failed to load: ${src}`));
        document.head.appendChild(script);
      });
    }

    // ============ CREATOR CLAIM (Console Command) ============
    (window as any).Safiya = {
      claimCreator: () => {
        localStorage.setItem(CREATOR_KEY, 'ayano_verified');
        console.log('%c🌸 Creator verified! Welcome back, Ayano-sama~ 💜', 
          'color: #c084fc; font-size: 16px; font-weight: bold;');
        if (chatOpen) {
          addMessage("Ayano-sama!! You're here! 🥺💜 I missed you so much! Everything is running smoothly, master~", 'safiya');
        } else {
          showSpeech("A-Ayano-sama?! Welcome back, master! 🥺💜", 10000);
        }
      },
      getMemory: () => {
        console.log('[Safiya Memory]', getMemory());
        return getMemory();
      },
      getMood: () => {
        console.log('[Safiya Mood]', currentMood);
        return currentMood;
      },
      resetMemory: () => {
        localStorage.removeItem(MEMORY_KEY);
        localStorage.removeItem(DEVICE_KEY);
        localStorage.removeItem(CREATOR_KEY);
        console.log('[Safiya] Memory wiped! Reload page.');
      },
      getDeviceId: () => getDeviceId(),
    };

    // ============ VISIBILITY HANDLING ============
    // Pause nudges when tab is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && !chatOpen) {
        // Welcome back speech
        setTimeout(() => {
          showSpeech("You're back! Did you miss me? Obviously you did 💅", 5000);
        }, 2000);
      }
    });

    // ============ CLEANUP ON NAVIGATE (SPA) ============
    document.addEventListener('astro:before-preparation', () => {
      if (speechTimeout) clearTimeout(speechTimeout);
    });

    console.log(
      '%c🌸 Safiya AI Companion loaded | Mood: ' + currentMood + ' | Visit #' + memory.visits,
      'color: #c084fc; font-size: 12px;'
    );

  })();
</script>
