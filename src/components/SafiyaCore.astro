    border: 2px solid #0a0517;
    animation: notifyBounce 1.5s ease-in-out infinite;
  }
  @keyframes notifyBounce {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.15); }
  }

  /* ═══════════════════════════════════════════════
     SPEECH BUBBLE (small notification style)
     ═══════════════════════════════════════════════ */
  .safiya-bubble {
    position: absolute;
    bottom: 76px;
    right: 0;
    width: 280px;
    padding: 12px 36px 12px 14px;
