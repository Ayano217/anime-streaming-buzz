      greet:   ['greet', 'hello', 'hi', 'wave', 'tap_body'],
      happy:   ['happy', 'smile', 'joy', 'laugh'],
      sad:     ['sad', 'cry', 'down'],
      angry:   ['angry', 'mad', 'flick'],
      shy:     ['shy', 'blush', 'flick_head', 'head'],
      surprise:['surprise', 'shock', 'gasp'],
      listen:  ['idle', 'listen', 'wait'],
      love:    ['love', 'heart', 'flirt'],
      dance:   ['dance', 'body'],
    };
    var keywords = groupMap[context] || [context];
    var group = findMotionGroup(keywords);
    if (group) {
      playMotion(group, undefined, 2);
      return true;
    }
    // Fallback: random motion
    playRandomMotion();
    return false;
  }

  // Trigger motion based on Safiya's REPLY TEXT
  function triggerMotionFromText(text) {
    if (!live2dModel || !text) return;
    var t = text.toLowerCase();
    // Analyze sentiment/keywords
    if (/💜|💕|love|cute|shy|blush|w-what|shut up/.test(t))    triggerMotionByKeyword('shy');
    else if (/😤|angry|mad|hmph|ugh|stop|baka/.test(t))       triggerMotionByKeyword('angry');
    else if (/hi|hey|hello|welcome|back/.test(t))              triggerMotionByKeyword('greet');
    else if (/😏|✨|😊|nice|good|great|yay/.test(t))           triggerMotionByKeyword('happy');
    else if (/😳|surprise|really|omg|wow/.test(t))             triggerMotionByKeyword('surprise');
    else if (/dance|move|body/.test(t))                        triggerMotionByKeyword('dance');
    else if (Math.random() < 0.5) playRandomMotion();  // 50% chance random motion for other messages
  }

  // Trigger motion based on mood change
  function triggerMoodMotion(newMood) {
    if (!live2dModel) return;
    if (newMood === 'flirty')      triggerMotionByKeyword('shy');
    else if (newMood === 'angry')  triggerMotionByKeyword('angry');
    else if (newMood === 'caring') triggerMotionByKeyword('happy');
    else if (newMood === 'rude')   triggerMotionByKeyword('angry');
  }

  // ═══ IDLE MOTIONS ═══
  function startIdleMotions() {
    if (idleMotionInterval) clearInterval(idleMotionInterval);
    idleMotionInterval = setInterval(function() {
      if (!live2dModel || !chatOpen) return;
      if (Date.now() - lastMotionTime < 12000) return;
      if (Math.random() < 0.35) playRandomMotion();
    }, 8000);
  }

  // ═══ AVATAR TAP ═══
  var lastTouchTime = 0;
  avatar.addEventListener('click', function() {
    var now = Date.now();
    if (now - lastTouchTime < 400) return;
    lastTouchTime = now;
    playRandomMotion();
    if (Math.random() < 0.4 && availableExpressions.length) playRandomExpression();
    avatar.classList.remove('s-avatar-tap'); void avatar.offsetWidth; avatar.classList.add('s-avatar-tap');
    var allTouchLines = [].concat(lines.touchFace, lines.touchBody, lines.touchHead);
    reactToTouch(pick(allTouchLines));
    if (navigator.vibrate) navigator.vibrate(20);
  });
  function reactToTouch(line) {
    if (!chatOpen) return;
    setTimeout(function() {
      addTyping();
      setTimeout(function() { removeTyping(); addMessage(line, 'her'); }, 500);
    }, 150);
  }

  // ═══ IDLE NUDGES ═══
  var lastAct = Date.now(), nudges = 0;
  function resetIdle() { lastAct = Date.now(); }
  function tickIdle() {
    if (document.hidden || chatOpen || isMinimized) return;
    if (Date.now() - lastAct > 40000 && nudges < 5) {
      showBubble(pickLine(), 6000); lastAct = Date.now(); nudges++;
    }
  }
  ['mousemove','scroll','touchstart','click'].forEach(function(e) {
    window.addEventListener(e, resetIdle, { passive: true });
  });
  setInterval(tickIdle, 8000);

  var cp = window.location.pathname;
  if (b.lastPage !== cp) {
    b.pagesViewed.push({ path: cp, time: Date.now() });
    if (b.pagesViewed.length > 50) b.pagesViewed = b.pagesViewed.slice(-50);
    b.lastPage = cp; safeSet('safiya_memory', memory);
  }
  document.addEventListener('click', function(e) {
    var a = e.target.closest && e.target.closest('a');
    if (!a) return;
    var h = a.getAttribute('href') || '';
    if (h.indexOf('/anime/') === 0) {
      b.animeClicked.push({ slug: h.replace('/anime/',''), time: Date.now() });
      if (b.animeClicked.length > 30) b.animeClicked = b.animeClicked.slice(-30);
    } else if (h.indexOf('/product/') === 0 || a.dataset.productId) {
      var id = a.dataset.productId || h.replace('/product/','');
      b.productsClicked.push({ id: id, time: Date.now() });
      if (b.productsClicked.length > 30) b.productsClicked = b.productsClicked.slice(-30);
      setMood('flirty');
      setTimeout(function() { showBubble("oh~ good taste 💜", 5000); }, 500);
    }
  }, { passive: true });

  var btt = $('btt');
  if (btt) {
    btt.style.right = '90px';
    var updateBtt = function() {
      btt.style.display = (window.innerWidth <= 720) ? 'none' : '';
    };
    updateBtt();
    window.addEventListener('resize', updateBtt);
  }

  // Auto-restore chat
  if (memory.chatOpen) {
    setTimeout(function() { openChat(); }, 300);
  } else if (memory.chatMinimized) {
    setTimeout(function() {
      isMinimized = true;
      mini.classList.add('s-mini-show');
      head.classList.add('s-head-hide');
    }, 300);
  } else {
    setTimeout(function() {
      if (!chatOpen && !isMinimized) {
        var g = isCreator ? "Ayano-sama... back? 💜" :
                memory.userName ? "hey " + memory.userName + " ✨" :
                memory.visits === 1 ? "a newbie? 🙄" : pickLine();
        showBubble(g, 7000);
      }
    }, 3500);
  }

  // ═══ SECRET SHORTCUT: Ctrl+Shift+A → Creator mode ═══
  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
      e.preventDefault();
      try { localStorage.setItem('safiya_creator', 'ayano-217'); } catch(err) {}
      isCreator = true;
      memory.userName = 'Ayano';
      safeSet('safiya_memory', memory);
      showBubble("Ayano-sama! 💜 Welcome back~", 7000);
      setTimeout(function() { location.reload(); }, 2000);
    }
  });

  // ═══ GLOBAL API ═══
  window.Safiya = {
    open: openChat, close: closeChat, minimize: minimizeChat, say: showBubble,
    memory: function() { return safeGet('safiya_memory', {}); },
    name: function() { return memory.userName; },
    setName: function(n) { memory.userName = n; safeSet('safiya_memory', memory); },
    history: function() { return memory.chatHistory; },
    clearHistory: function() {
      memory.chatHistory = []; safeSet('safiya_memory', memory);
      chatBody.innerHTML = ''; chatInited = false;
    },
    reset: function() {
      try {
        localStorage.removeItem('safiya_memory');
        localStorage.removeItem('safiya_device_id');
        localStorage.removeItem('safiya_creator');
      } catch(e) {}
      location.reload();
    },
    claimCreator: function() {
      try { localStorage.setItem('safiya_creator', 'ayano-217'); } catch(e) {}
      isCreator = true;
      memory.userName = 'Ayano';
      safeSet('safiya_memory', memory);
      showBubble("Ayano-sama! 💜 Recognized~", 7000);
    },
    // ═══ Motion controls ═══
    motion: function(nameOrIndex) {
      if (typeof nameOrIndex === 'number') {
        var m = availableMotions[nameOrIndex];
        if (m) return playMotion(m.groupName);
      } else if (typeof nameOrIndex === 'string') {
        return playMotion(nameOrIndex);
      }
      return playRandomMotion();
    },
    randomMotion: playRandomMotion,
    trigger: triggerMotionByKeyword,  // Safiya.trigger('happy') etc.
    listMotions: function() {
      console.log('%c🎭 Motions:', 'color:#e879f9;font-weight:bold');
      availableMotions.forEach(function(m, i) {
        console.log('%c  [' + i + '] ' + m.groupName + ' (' + m.count + ')', 'color:#c084fc');
      });
      return availableMotions;
    },
    expression: function(name) {
      if (!name) return playRandomExpression();
      return playExpression(name);
    },
    listExpressions: function() {
      console.log('%c😊 Expressions:', 'color:#e879f9;font-weight:bold', availableExpressions);
      return availableExpressions;
    },
    testAllMotions: function() {
      var i = 0;
      var iv = setInterval(function() {
        if (i >= availableMotions.length) {
          clearInterval(iv);
          console.log('%c✅ Done!', 'color:#22c55e;font-weight:bold');
          return;
        }
        console.log('%c▶ ' + availableMotions[i].groupName, 'color:#e879f9');
        playMotion(availableMotions[i].groupName);
        i++;
      }, 3000);
    },
    reloadDP: tryLoadDP,
    dpUrl: function() { return DP_URL; }
  };
  console.log('%c💜 Safiya v10.0 | Name: ' + (memory.userName || 'unknown') + ' | Msgs: ' + memory.chatHistory.length, 'color:#e879f9;font-weight:bold');
  console.log('%c🔧 Model path: ' + MODEL_PATH, 'color:#a78bfa');
  console.log('%c💡 Commands: Safiya.listMotions() | Safiya.motion(0) | Safiya.trigger("happy")', 'color:#a78bfa');
})();
</script>

