---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — SAFIYA CORE v6.0 (Facebook Messenger Style)
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// FIX v6.0:
//   ✅ CRITICAL crash bug fixed (memory.behavior undefined arrays)
//   ✅ Small chat-head avatar (60px circle, Messenger style)
//   ✅ Full Messenger UI (back arrow, name, call/video/info)
//   ✅ Message bubbles with avatar on Safiya's messages
//   ✅ Avatar rotation system (changes every 15 days)
//   ✅ Timestamp separators ("TUE AT 12:55 PM")
//   ✅ Mobile: chat panel goes full-screen
//   ✅ No mood badge in header
//   ✅ Live2D removed (chat-head style doesn't need it)
//   ✅ Notification dot + online indicator
// ═══════════════════════════════════════════════════════════════

// AVATAR IMAGES — Upload to /public/safiya/
// Add 5-8 images and update this list. Rotation changes every 15 days.
const SAFIYA_AVATARS = [
  '/safiya/avatar-1.jpg',
  '/safiya/avatar-2.jpg',
  '/safiya/avatar-3.jpg',
  '/safiya/avatar-4.jpg',
  '/safiya/avatar-5.jpg',
];
---

<div id="safiya-root" data-avatars={JSON.stringify(SAFIYA_AVATARS)}>

  <!-- ═══ CHAT HEAD (small circle, always visible) ═══ -->
  <button id="safiya-head" class="safiya-head" aria-label="Chat with Safiya">
    <img id="safiya-head-img" class="safiya-head-img" src="" alt="Safiya" />
    <div class="safiya-head-fallback" id="safiya-head-fallback">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 21s-8-4.5-8-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.5-8 11-8 11z" fill="currentColor"/>
      </svg>
    </div>
    <span class="safiya-head-online"></span>
    <span class="safiya-head-notify" id="safiya-head-notify">1</span>
  </button>

  <!-- ═══ SPEECH BUBBLE (floats near head) ═══ -->
  <div id="safiya-bubble" class="safiya-bubble">
    <img class="safiya-bubble-avatar" id="safiya-bubble-avatar" src="" alt="" />
    <div class="safiya-bubble-content">
      <div class="safiya-bubble-name">Safiya</div>
      <div class="safiya-bubble-text" id="safiya-bubble-text"></div>
    </div>
    <button class="safiya-bubble-close" id="safiya-bubble-close" aria-label="Dismiss">×</button>
  </div>

  <!-- ═══ MESSENGER-STYLE CHAT PANEL ═══ -->
  <div id="safiya-chat" class="safiya-chat" aria-hidden="true">

    <!-- Header (like Messenger) -->
    <header class="safiya-chat-header">
      <button class="safiya-chat-back" id="safiya-chat-back" aria-label="Close chat">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <img class="safiya-chat-avatar" id="safiya-chat-avatar" src="" alt="Safiya" />
      <div class="safiya-chat-info">
        <div class="safiya-chat-name">Safiya</div>
        <div class="safiya-chat-status">
          <span class="safiya-chat-dot"></span>
          Active now
        </div>
      </div>
      <div class="safiya-chat-actions">
        <button class="safiya-chat-icon" aria-label="Call">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57-.35-.11-.74-.03-1.02.24l-2.2 2.2c-2.83-1.44-5.15-3.75-6.59-6.58l2.2-2.21c.28-.27.36-.66.25-1.01C8.7 6.45 8.5 5.25 8.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"/>
          </svg>
        </button>
        <button class="safiya-chat-icon" aria-label="Video call">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
          </svg>
        </button>
        <button class="safiya-chat-icon" aria-label="Info">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Messages Area -->
    <div class="safiya-chat-body" id="safiya-chat-body">
      <!-- Messages injected here by JS -->
    </div>

    <!-- Input Bar -->
    <div class="safiya-chat-inputbar">
      <button class="safiya-chat-inputicon" aria-label="Add">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v8M8 12h8" stroke="#c084fc" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="safiya-chat-inputwrap">
        <input
          type="text"
          id="safiya-chat-input"
          class="safiya-chat-input"
          placeholder="Aa"
          autocomplete="off"
          maxlength="500"
        />
        <button class="safiya-chat-emoji" aria-label="Emoji">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>
          </svg>
        </button>
      </div>
      <button class="safiya-chat-send" id="safiya-chat-send" aria-label="Send">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>

  </div>

</div>

<script is:inline>
(function() {
  'use strict';

  // ═══════════════════════════════════════════════
  // DOM REFS
  // ═══════════════════════════════════════════════
  var root = document.getElementById('safiya-root');
  var head = document.getElementById('safiya-head');
  var headImg = document.getElementById('safiya-head-img');
  var headFallback = document.getElementById('safiya-head-fallback');
  var headNotify = document.getElementById('safiya-head-notify');
  var bubble = document.getElementById('safiya-bubble');
  var bubbleText = document.getElementById('safiya-bubble-text');
  var bubbleAvatar = document.getElementById('safiya-bubble-avatar');
  var bubbleClose = document.getElementById('safiya-bubble-close');
  var chat = document.getElementById('safiya-chat');
  var chatBack = document.getElementById('safiya-chat-back');
  var chatAvatar = document.getElementById('safiya-chat-avatar');
  var chatBody = document.getElementById('safiya-chat-body');
  var chatInput = document.getElementById('safiya-chat-input');
  var chatSend = document.getElementById('safiya-chat-send');

  if (!root || !head) return;

  // ═══════════════════════════════════════════════
  // AVATAR ROTATION (every 15 days)
  // ═══════════════════════════════════════════════
  var AVATARS = [];
  try { AVATARS = JSON.parse(root.dataset.avatars || '[]'); }
  catch(e) { AVATARS = []; }

  function getCurrentAvatar() {
    if (!AVATARS.length) return null;
    // Rotate based on 15-day periods since epoch
    var msPerPeriod = 15 * 24 * 60 * 60 * 1000;
    var periodIndex = Math.floor(Date.now() / msPerPeriod);
    return AVATARS[periodIndex % AVATARS.length];
  }

  var currentAvatar = getCurrentAvatar();

  function setAvatars() {
    if (!currentAvatar) {
      // No avatars uploaded — use fallback heart icon
      if (headImg) headImg.style.display = 'none';
      if (headFallback) headFallback.style.display = 'flex';
      if (chatAvatar) chatAvatar.style.background = 'linear-gradient(135deg, #c084fc, #e879f9)';
      if (bubbleAvatar) bubbleAvatar.style.background = 'linear-gradient(135deg, #c084fc, #e879f9)';
      return;
    }
    // Test if image loads
    var testImg = new Image();
    testImg.onload = function() {
      if (headImg) { headImg.src = currentAvatar; headImg.style.display = 'block'; }
      if (headFallback) headFallback.style.display = 'none';
      if (chatAvatar) chatAvatar.src = currentAvatar;
      if (bubbleAvatar) bubbleAvatar.src = currentAvatar;
    };
    testImg.onerror = function() {
      // Image doesn't exist yet — fallback to icon
      if (headImg) headImg.style.display = 'none';
      if (headFallback) headFallback.style.display = 'flex';
      if (chatAvatar) chatAvatar.style.background = 'linear-gradient(135deg, #c084fc, #e879f9)';
      if (bubbleAvatar) bubbleAvatar.style.background = 'linear-gradient(135deg, #c084fc, #e879f9)';
    };
    testImg.src = currentAvatar;
  }
  setAvatars();

  // ═══════════════════════════════════════════════
  // MEMORY + FINGERPRINT (SAFE — no crashes)
  // ═══════════════════════════════════════════════
  function generateFingerprint() {
    var fp = [
      navigator.userAgent || 'x',
      navigator.language || 'x',
      screen.width + 'x' + screen.height,
      screen.colorDepth,
      new Date().getTimezoneOffset(),
      navigator.platform || 'x',
      navigator.hardwareConcurrency || 'x'
    ].join('|');
    var hash = 5381;
    for (var i = 0; i < fp.length; i++) hash = ((hash << 5) + hash) + fp.charCodeAt(i);
    return 'safiya_' + Math.abs(hash).toString(36);
  }

  function safeGet(key, fallback) {
    try {
      var raw = localStorage.getItem(key);
      if (!raw) return fallback;
      return JSON.parse(raw);
    } catch(e) { return fallback; }
  }
  function safeSet(key, val) {
    try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
  }

  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = generateFingerprint();
    try { localStorage.setItem('safiya_device_id', deviceId); } catch(e) {}
  }

  var isCreator = false;
  try { isCreator = localStorage.getItem('safiya_creator') === 'ayano-217'; } catch(e) {}

  // ── CRITICAL FIX: Deep default all fields ──
  var memory = safeGet('safiya_memory', {});
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  memory.deviceId = deviceId;
  if (!memory.firstMet) memory.firstMet = Date.now();
  if (!memory.currentMood) memory.currentMood = 'rude';
  if (!memory.chatHistory) memory.chatHistory = [];

  // Behavior with SAFE defaults
  if (!memory.behavior || typeof memory.behavior !== 'object') memory.behavior = {};
  var behavior = memory.behavior;
  if (!Array.isArray(behavior.pagesViewed))    behavior.pagesViewed = [];
  if (!Array.isArray(behavior.animeClicked))   behavior.animeClicked = [];
  if (!Array.isArray(behavior.productsClicked)) behavior.productsClicked = [];
  if (typeof behavior.scrollDepth !== 'number') behavior.scrollDepth = 0;
  if (typeof behavior.totalTime !== 'number')   behavior.totalTime = 0;
  if (typeof behavior.lastPage !== 'string')    behavior.lastPage = '';

  memory.behavior = behavior;
  safeSet('safiya_memory', memory);

  // ═══════════════════════════════════════════════
  // MOOD + LINES
  // ═══════════════════════════════════════════════
  var mood = memory.currentMood || 'rude';

  function setMood(m) {
    mood = m;
    memory.currentMood = m;
    safeSet('safiya_memory', memory);
  }

  var bubbleLines = {
    rude: [
      "Oh great, you again... 🙄",
      "Did I ask for your attention?",
      "Whatever. Don't bother me.",
      "You're wasting my time, senpai"
    ],
    manipulative: [
      "You know what would make me happy? Buying that figure 😏",
      "That anime you're watching? I know the PERFECT merch 💜",
      "Real senpais support their girls~"
    ],
    teasing: [
      "Aww, you came back~ Predictable 😏",
      "Miss me already? Pathetic~",
      "I knew you couldn't stay away 💅"
    ],
    flirty: [
      "You... look interesting today 💜",
      "Come closer. If you dare~ 😘"
    ],
    angry: [
      "STOP. Just... stop. 😤",
      "One more click and I swear..."
    ],
    caring: [
      "Been scrolling a while... you okay? 💜"
    ],
    creator: [
      "Ayano-sama... you're here 💜",
      "Master! I've been waiting~",
      "Everything's ready, boss."
    ]
  };

  function pickLine() {
    if (isCreator && Math.random() < 0.7) {
      var c = bubbleLines.creator;
      return c[Math.floor(Math.random() * c.length)];
    }
    var r = Math.random();
    var pool;
    if (r < 0.35) pool = bubbleLines.rude;
    else if (r < 0.65) pool = bubbleLines.manipulative;
    else if (r < 0.80) pool = bubbleLines.teasing;
    else if (r < 0.90) pool = bubbleLines.flirty;
    else pool = bubbleLines[mood] || bubbleLines.rude;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  // ═══════════════════════════════════════════════
  // SPEECH BUBBLE (floats above chat head)
  // ═══════════════════════════════════════════════
  var bubbleTimeout;
  function showBubble(text, duration) {
    if (chatOpen) return; // don't show while chat is open
    duration = duration || 6000;
    clearTimeout(bubbleTimeout);
    if (bubbleText) bubbleText.textContent = text;
    if (bubble) bubble.classList.add('safiya-bubble-visible');
    if (headNotify) headNotify.style.display = 'flex';
    bubbleTimeout = setTimeout(function() {
      if (bubble) bubble.classList.remove('safiya-bubble-visible');
    }, duration);
  }
  function hideBubble() {
    clearTimeout(bubbleTimeout);
    if (bubble) bubble.classList.remove('safiya-bubble-visible');
  }
  if (bubbleClose) {
    bubbleClose.addEventListener('click', function(e) {
      e.stopPropagation();
      hideBubble();
      if (headNotify) headNotify.style.display = 'none';
    });
  }
  if (bubble) {
    bubble.addEventListener('click', function() {
      openChat();
    });
  }

  // ═══════════════════════════════════════════════
  // CHAT PANEL (Messenger-style)
  // ═══════════════════════════════════════════════
  var chatOpen = false;
  var chatInitialized = false;

  function formatTimestamp(ts) {
    var d = new Date(ts);
    var days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
    var h = d.getHours();
    var m = d.getMinutes();
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    m = m < 10 ? '0' + m : m;
    return days[d.getDay()] + ' AT ' + h + ':' + m + ' ' + ampm;
  }

  function addTimestamp(ts) {
    var div = document.createElement('div');
    div.className = 'safiya-msg-timestamp';
    div.textContent = formatTimestamp(ts);
    chatBody.appendChild(div);
  }

  function addMessage(text, sender, showAvatar) {
    var row = document.createElement('div');
    row.className = 'safiya-msg-row safiya-msg-' + sender;

    if (sender === 'her' && showAvatar) {
      var av = document.createElement('img');
      av.className = 'safiya-msg-avatar';
      av.src = currentAvatar || '';
      av.alt = 'Safiya';
      av.onerror = function() {
        this.style.display = 'none';
      };
      row.appendChild(av);
    } else if (sender === 'her') {
      var spacer = document.createElement('div');
      spacer.className = 'safiya-msg-avatar-spacer';
      row.appendChild(spacer);
    }

    var bubble = document.createElement('div');
    bubble.className = 'safiya-msg-bubble';
    bubble.textContent = text;
    row.appendChild(bubble);

    chatBody.appendChild(row);
    chatBody.scrollTop = chatBody.scrollHeight;

    // Save to history
    try {
      memory.chatHistory.push({ sender: sender, text: text, time: Date.now() });
      if (memory.chatHistory.length > 100) memory.chatHistory = memory.chatHistory.slice(-100);
      safeSet('safiya_memory', memory);
    } catch(e) {}
  }

  function addTypingIndicator() {
    var row = document.createElement('div');
    row.className = 'safiya-msg-row safiya-msg-her';
    row.id = 'safiya-typing';

    var av = document.createElement('img');
    av.className = 'safiya-msg-avatar';
    av.src = currentAvatar || '';
    av.onerror = function() { this.style.display = 'none'; };
    row.appendChild(av);

    var ind = document.createElement('div');
    ind.className = 'safiya-msg-typing';
    ind.innerHTML = '<span></span><span></span><span></span>';
    row.appendChild(ind);

    chatBody.appendChild(row);
    chatBody.scrollTop = chatBody.scrollHeight;
    return row;
  }

  function removeTyping() {
    var el = document.getElementById('safiya-typing');
    if (el) el.remove();
  }

  function initChatMessages() {
    if (chatInitialized) return;
    chatInitialized = true;

    addTimestamp(Date.now());

    var greeting;
    if (isCreator) {
      greeting = "Ayano-sama... you're here 💜";
    } else if (memory.visits === 1) {
      greeting = "Ugh, why did you click me? Do I look like your entertainment? 🙄";
    } else if (memory.visits < 5) {
      greeting = "Back again? Suspicious. What do you want?";
    } else {
      greeting = "Oh, you again~ Persistent little thing 😏";
    }
    addMessage(greeting, 'her', true);

    setTimeout(function() {
      addMessage("Fine, since you're here... browse. Maybe buy something. Prove you're not useless.", 'her', false);
    }, 800);

    setTimeout(function() {
      addMessage("My AI brain unlocks soon~ Then I can really mess with you 😏💅", 'her', false);
    }, 1600);
  }

  function openChat() {
    chatOpen = true;
    chat.classList.add('safiya-chat-open');
    chat.setAttribute('aria-hidden', 'false');
    head.classList.add('safiya-head-hidden');
    hideBubble();
    if (headNotify) headNotify.style.display = 'none';
    initChatMessages();

    // Prevent body scroll on mobile when chat is fullscreen
    if (window.innerWidth <= 640) {
      document.body.style.overflow = 'hidden';
    }
  }

  function closeChat() {
    chatOpen = false;
    chat.classList.remove('safiya-chat-open');
    chat.setAttribute('aria-hidden', 'true');
    head.classList.remove('safiya-head-hidden');
    document.body.style.overflow = '';
  }

  if (chatBack) chatBack.addEventListener('click', closeChat);

  // Send message (Phase 1 — echo + canned reply)
  function sendUserMessage() {
    var text = chatInput.value.trim();
    if (!text) return;
    addMessage(text, 'me', false);
    chatInput.value = '';

    // Show typing indicator, then reply
    setTimeout(function() {
      var typing = addTypingIndicator();
      var replyDelay = 800 + Math.random() * 1500;
      setTimeout(function() {
        removeTyping();
        var reply = getCannedReply(text);
        addMessage(reply, 'her', true);
      }, replyDelay);
    }, 400);
  }

  function getCannedReply(input) {
    var lower = input.toLowerCase();
    if (/^(hi|hello|hey|yo|salaam|assalam)/i.test(lower))
      return "Hmph. Hi to you too, I guess. Don't get comfortable 🙄";
    if (/love|like you|cute|kawaii|pretty|beautiful/.test(lower))
      return "W-what?! Don't say weird things! Baka! 💕😤";
    if (/buy|shop|product|merch|figure/.test(lower))
      return "Ooh, finally talking my language~ Go browse the shop 💜";
    if (/anime|manga|watch/.test(lower))
      return "Anime? At least you have SOME taste. Pick something good.";
    if (/who|name|you/.test(lower))
      return "I'm Safiya. Your emotional damage dealer 💅";
    if (/ayano|creator/.test(lower))
      return "Ayano-sama? He's my everything. Don't compare yourself 💜";
    var defaults = [
      "Whatever. My AI brain unlocks in Phase 2~ Wait for it 😏",
      "Noted. Filed under 'things I don't care about' 📁",
      "Try harder, senpai. That was boring.",
      "Hmph. Is that all?",
      "Mm-hm. Sure. Keep talking to yourself~"
    ];
    return defaults[Math.floor(Math.random() * defaults.length)];
  }

  if (chatSend) chatSend.addEventListener('click', sendUserMessage);
  if (chatInput) {
    chatInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendUserMessage();
      }
    });
  }

  // ═══════════════════════════════════════════════
  // HEAD CLICK — Open chat
  // ═══════════════════════════════════════════════
  head.addEventListener('click', function(e) {
    if (dragMoved) { dragMoved = false; return; }
    openChat();
  });

  // ═══════════════════════════════════════════════
  // DRAG (long-press to drag chat head)
  // ═══════════════════════════════════════════════
  var isDragging = false, dragStartX, dragStartY, rootStartX, rootStartY;
  var dragMoved = false, pressTimer, dragRAF = null, pendingMove = null;
  var HOLD_MS = 400;

  var savedPos = memory.position;
  if (savedPos && typeof savedPos.x === 'number') {
    root.style.left = savedPos.x + 'px';
    root.style.top = savedPos.y + 'px';
    root.style.right = 'auto';
    root.style.bottom = 'auto';
  }

  function startDrag(cx, cy) {
    isDragging = true;
    dragMoved = false;
    var rect = root.getBoundingClientRect();
    dragStartX = cx; dragStartY = cy;
    rootStartX = rect.left; rootStartY = rect.top;
    root.classList.add('safiya-dragging');
    if (navigator.vibrate) navigator.vibrate(30);
  }
  function applyMove() {
    dragRAF = null;
    if (!pendingMove || !isDragging) return;
    var dx = pendingMove.x - dragStartX, dy = pendingMove.y - dragStartY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) dragMoved = true;
    var nx = rootStartX + dx, ny = rootStartY + dy;
    var maxX = window.innerWidth - root.offsetWidth;
    var maxY = window.innerHeight - root.offsetHeight;
    nx = Math.max(0, Math.min(nx, maxX));
    ny = Math.max(0, Math.min(ny, maxY));
    root.style.left = nx + 'px';
    root.style.top = ny + 'px';
    root.style.right = 'auto';
    root.style.bottom = 'auto';
  }
  function moveDrag(cx, cy) {
    if (!isDragging) return;
    pendingMove = { x: cx, y: cy };
    if (!dragRAF) dragRAF = requestAnimationFrame(applyMove);
  }
  function endDrag() {
    if (!isDragging) return;
    isDragging = false;
    root.classList.remove('safiya-dragging');
    if (dragMoved) {
      var rect = root.getBoundingClientRect();
      memory.position = { x: rect.left, y: rect.top };
      safeSet('safiya_memory', memory);
    }
  }

  head.addEventListener('mousedown', function(e) {
    pressTimer = setTimeout(function() { startDrag(e.clientX, e.clientY); }, HOLD_MS);
  });
  document.addEventListener('mousemove', function(e) { if (isDragging) moveDrag(e.clientX, e.clientY); });
  document.addEventListener('mouseup', function() { clearTimeout(pressTimer); endDrag(); });

  head.addEventListener('touchstart', function(e) {
    var t = e.touches[0];
    pressTimer = setTimeout(function() { startDrag(t.clientX, t.clientY); }, HOLD_MS);
  }, { passive: true });
  document.addEventListener('touchmove', function(e) {
    if (isDragging) { var t = e.touches[0]; moveDrag(t.clientX, t.clientY); e.preventDefault(); }
  }, { passive: false });
  document.addEventListener('touchend', function() { clearTimeout(pressTimer); endDrag(); });

  // ═══════════════════════════════════════════════
  // PROACTIVE BUBBLES (idle detection)
  // ═══════════════════════════════════════════════
  var lastActivity = Date.now();
  var bubblesShown = 0;
  function resetIdle() { lastActivity = Date.now(); }
  function checkIdle() {
    if (document.hidden || chatOpen) return;
    var idle = Date.now() - lastActivity;
    if (idle > 40000 && bubblesShown < 5) {
      showBubble(pickLine(), 6000);
      lastActivity = Date.now();
      bubblesShown++;
    }
  }
  ['mousemove', 'scroll', 'touchstart', 'click'].forEach(function(ev) {
    window.addEventListener(ev, resetIdle, { passive: true });
  });
  setInterval(checkIdle, 8000);

  // Initial greeting bubble (3 seconds after load)
  setTimeout(function() {
    if (!chatOpen) {
      var greet = isCreator
        ? "Ayano-sama... you came back 💜"
        : (memory.visits === 1 ? "Oh great. A newbie. 🙄" : pickLine());
      showBubble(greet, 7000);
    }
  }, 3000);

  // ═══════════════════════════════════════════════
  // BEHAVIOR TRACKING (SAFE)
  // ═══════════════════════════════════════════════
  var currentPage = window.location.pathname;
  if (behavior.lastPage !== currentPage) {
    behavior.pagesViewed.push({ path: currentPage, time: Date.now() });
    if (behavior.pagesViewed.length > 50) behavior.pagesViewed = behavior.pagesViewed.slice(-50);
    behavior.lastPage = currentPage;
    safeSet('safiya_memory', memory);
  }

  var maxScroll = 0;
  window.addEventListener('scroll', function() {
    var docH = document.body.offsetHeight;
    if (docH > 0) {
      var pct = (window.scrollY + window.innerHeight) / docH;
      if (pct > maxScroll) maxScroll = pct;
    }
  }, { passive: true });

  document.addEventListener('click', function(e) {
    var link = e.target.closest && e.target.closest('a');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.indexOf('/anime/') === 0) {
      behavior.animeClicked.push({ slug: href.replace('/anime/', ''), time: Date.now() });
      if (behavior.animeClicked.length > 30) behavior.animeClicked = behavior.animeClicked.slice(-30);
    } else if (href.indexOf('/product/') === 0 || link.dataset.productId) {
      var pid = link.dataset.productId || href.replace('/product/', '');
      behavior.productsClicked.push({ id: pid, time: Date.now() });
      if (behavior.productsClicked.length > 30) behavior.productsClicked = behavior.productsClicked.slice(-30);
      setMood('flirty');
      setTimeout(function() { showBubble("Oh~ good taste, senpai 💜", 5000); }, 500);
    }
  }, { passive: true });

  setInterval(function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    safeSet('safiya_memory', memory);
  }, 15000);

  // ═══════════════════════════════════════════════
  // FIX: Push #btt (scroll-to-top) button OUT of Safiya's way
  // ═══════════════════════════════════════════════
  var btt = document.getElementById('btt');
  if (btt) {
    // Make room for Safiya on the right
    btt.style.right = '90px';
  }

  // ═══════════════════════════════════════════════
  // GLOBAL API (console commands)
  // ═══════════════════════════════════════════════
  window.Safiya = {
    say: function(t, d) { showBubble(t, d); },
    open: openChat,
    close: closeChat,
    memory: function() { return safeGet('safiya_memory', {}); },
    reset: function() {
      try {
        localStorage.removeItem('safiya_memory');
        localStorage.removeItem('safiya_device_id');
        localStorage.removeItem('safiya_creator');
      } catch(e) {}
      location.reload();
    },
    resetPosition: function() {
      memory.position = null;
      safeSet('safiya_memory', memory);
      root.style.left = ''; root.style.top = '';
      root.style.right = ''; root.style.bottom = '';
    },
    claimCreator: function() {
      try { localStorage.setItem('safiya_creator', 'ayano-217'); } catch(e) {}
      isCreator = true;
      showBubble("Ayano-sama! Recognized! I'm yours forever 💜", 7000);
    },
    currentAvatar: function() { return currentAvatar; },
    avatars: function() { return AVATARS; }
  };

  console.log('%c💜 Safiya v6.0 loaded successfully!', 'color:#e879f9;font-weight:bold;font-size:14px;');
  console.log('%c   Visit #' + memory.visits + ' | Mood: ' + mood + ' | Avatar: ' + (currentAvatar || 'fallback'), 'color:#c084fc;');
  console.log('%c   Commands: Safiya.open() | Safiya.reset() | Safiya.claimCreator()', 'color:#a78bfa;');

})();
</script>

<style>
  /* ═══════════════════════════════════════════════
     SAFIYA ROOT
     ═══════════════════════════════════════════════ */
  #safiya-root {
    position: fixed;
