---
// ═══════════════════════════════════════════════════════════════
// SAFIYA CORE v9.4 — FIXED SYNTAX + AUTO DP LOADER
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// ✅ Syntax error fixed (escaped apostrophes)
// ✅ Auto DP system — upload /safiya/avatar.png OR /safiya/avatar.jpg
//    → automatically shows everywhere (chat, avatars, mini pill)
// ✅ Fallback to gradient orb if no image found
// ═══════════════════════════════════════════════════════════════
---

<div id="safiya-root">

  <button id="safiya-head" class="s-head" aria-label="Chat with Safiya">
    <span class="s-head-icon" id="s-head-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </span>
    <img id="s-head-dp" class="s-head-dp" src="" alt="Safiya" style="display:none;" />
    <span class="s-head-ring"></span>
    <span class="s-head-online"></span>
    <span class="s-head-notify" id="safiya-notify">1</span>
  </button>

  <div id="safiya-bubble" class="s-bubble">
    <div class="s-bubble-avatar" id="s-bubble-dp-wrap">
      <img id="s-bubble-dp" class="s-bubble-dp" src="" alt="" style="display:none;" />
    </div>
    <div class="s-bubble-body">
      <div class="s-bubble-name">Safiya</div>
      <div class="s-bubble-text" id="s-bubble-text"></div>
    </div>
    <button class="s-bubble-x" id="s-bubble-x" aria-label="Dismiss">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="safiya-avatar" class="s-avatar" aria-hidden="true">
    <div class="s-avatar-glow"></div>
    <div class="s-avatar-inner">
      <canvas id="s-avatar-canvas"></canvas>
      <div id="s-avatar-fallback" class="s-avatar-fallback">
        <div class="s-avatar-fb-orb">
          <div class="s-avatar-fb-face">
            <div class="s-avatar-fb-eye s-avatar-fb-eye-l"></div>
            <div class="s-avatar-fb-eye s-avatar-fb-eye-r"></div>
            <div class="s-avatar-fb-mouth"></div>
          </div>
        </div>
        <div class="s-avatar-fb-name">Safiya</div>
      </div>
      <div id="s-avatar-loader" class="s-avatar-loader">
        <div class="s-avatar-spinner"></div>
      </div>
    </div>
    <div class="s-avatar-hint">💜 Touch me~</div>
  </div>

  <div id="safiya-chat" class="s-chat" aria-hidden="true">
    <header class="s-chat-head">
      <button class="s-chat-btn" id="s-back" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="s-chat-head-info">
        <div class="s-chat-head-avatar" id="s-chat-head-avatar">
          <span class="s-chat-head-avatar-letter" id="s-chat-head-letter">S</span>
          <img id="s-chat-head-dp" class="s-chat-head-dp" src="" alt="Safiya" style="display:none;" />
          <span class="s-chat-head-online"></span>
        </div>
        <div class="s-chat-head-text">
          <div class="s-chat-head-name">Safiya</div>
          <div class="s-chat-head-status" id="s-chat-status">Active now</div>
        </div>
      </div>

      <div class="s-chat-head-actions">
        <button class="s-chat-btn" id="s-min" aria-label="Minimize">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
        <button class="s-chat-btn s-chat-btn-close" id="s-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </header>

    <div class="s-chat-body" id="s-chat-body"></div>

    <div class="s-chat-input-bar">
      <button class="s-input-icon" aria-label="Add">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
      </button>
      <div class="s-input-wrap">
        <input type="text" id="s-input" placeholder="Message..." autocomplete="off" maxlength="500" />
        <button class="s-input-emoji" aria-label="Emoji">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </button>
      </div>
      <button class="s-send" id="s-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="safiya-mini" class="s-mini" aria-hidden="true">
    <div class="s-mini-avatar" id="s-mini-avatar-wrap">
      <span id="s-mini-letter">S</span>
      <img id="s-mini-dp" class="s-mini-dp" src="" alt="" style="display:none;" />
    </div>
    <span class="s-mini-name">Safiya</span>
    <span class="s-mini-new" id="s-mini-new">0</span>
    <button class="s-mini-x" id="s-mini-x" aria-label="Close">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

</div>

<script is:inline>
(function() {
  'use strict';
  var $ = function(id) { return document.getElementById(id); };
  var root = $('safiya-root'), head = $('safiya-head'), notify = $('safiya-notify');
  var bubble = $('safiya-bubble'), bubbleText = $('s-bubble-text'), bubbleX = $('s-bubble-x');
  var chat = $('safiya-chat'), chatBody = $('s-chat-body'), chatInput = $('s-input');
  var sendBtn = $('s-send'), backBtn = $('s-back'), minBtn = $('s-min'), closeBtn = $('s-close');
  var mini = $('safiya-mini'), miniX = $('s-mini-x'), miniNew = $('s-mini-new');
  var avatar = $('safiya-avatar'), avatarCanvas = $('s-avatar-canvas');
  var avatarFallback = $('s-avatar-fallback'), avatarLoader = $('s-avatar-loader');
  var statusText = $('s-chat-status');
  if (!root || !chat) return;

  // ═══════════════════════════════════════════════
  // ★ AUTO DP LOADER
  // Upload image to: public/safiya/avatar.png OR avatar.jpg
  // System will auto-detect and use everywhere
  // ═══════════════════════════════════════════════
  var DP_URL = null;
  function tryLoadDP() {
    var candidates = ['/safiya/avatar.png', '/safiya/avatar.jpg', '/safiya/avatar.webp'];
    var idx = 0;
    function tryNext() {
      if (idx >= candidates.length) {
        console.log('%c💜 Safiya: No profile picture found. Upload to /public/safiya/avatar.png to auto-set', 'color:#a78bfa');
        return;
      }
      var url = candidates[idx++];
      var img = new Image();
      img.onload = function() {
        DP_URL = url;
        applyDPEverywhere(url);
        console.log('%c💜 Safiya DP loaded: ' + url, 'color:#e879f9;font-weight:bold');
      };
      img.onerror = tryNext;
      img.src = url;
    }
    tryNext();
  }

  function applyDPEverywhere(url) {
    // Floating head
    var headDp = $('s-head-dp');
    var headIcon = $('s-head-icon');
    if (headDp && headIcon) {
      headDp.src = url;
      headDp.style.display = 'block';
      headIcon.style.display = 'none';
    }
    // Idle bubble
    var bubbleDp = $('s-bubble-dp');
    if (bubbleDp) {
      bubbleDp.src = url;
      bubbleDp.style.display = 'block';
    }
    // Chat header
    var chatHeadDp = $('s-chat-head-dp');
    var chatHeadLetter = $('s-chat-head-letter');
    if (chatHeadDp && chatHeadLetter) {
      chatHeadDp.src = url;
      chatHeadDp.style.display = 'block';
      chatHeadLetter.style.display = 'none';
    }
    // Mini pill
    var miniDp = $('s-mini-dp');
    var miniLetter = $('s-mini-letter');
    if (miniDp && miniLetter) {
      miniDp.src = url;
      miniDp.style.display = 'block';
      miniLetter.style.display = 'none';
    }
    // Update all existing message avatars
    var msgAvatars = document.querySelectorAll('#safiya-root .s-msg-avatar');
    for (var i = 0; i < msgAvatars.length; i++) {
      applyDPToMsgAvatar(msgAvatars[i], url);
    }
  }

  function applyDPToMsgAvatar(el, url) {
    if (!el || el.dataset.hasDp === '1') return;
    el.dataset.hasDp = '1';
    el.style.backgroundImage = 'url(' + url + ')';
    el.style.backgroundSize = 'cover';
    el.style.backgroundPosition = 'center';
  }

  // Start DP detection immediately
  tryLoadDP();

  // ═══════════════════════════════════════════════
  // MEMORY
  // ═══════════════════════════════════════════════
  function safeGet(k, f) {
    try { var r = localStorage.getItem(k); return r ? JSON.parse(r) : f; } catch(e) { return f; }
  }
  function safeSet(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch(e) {} }
  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = 'sf_' + Math.random().toString(36).slice(2, 12) + Date.now().toString(36);
    try { localStorage.setItem('safiya_device_id', deviceId); } catch(e) {}
  }
  var isCreator = false;
  try { isCreator = localStorage.getItem('safiya_creator') === 'ayano-217'; } catch(e) {}

  var memory = safeGet('safiya_memory', {});
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  if (!memory.firstMet) memory.firstMet = Date.now();
  if (!memory.currentMood) memory.currentMood = 'rude';
  if (!memory.chatHistory) memory.chatHistory = [];
  if (!memory.userName) memory.userName = '';
  if (!memory.behavior) memory.behavior = {};
  if (typeof memory.chatOpen !== 'boolean') memory.chatOpen = false;
  if (typeof memory.chatMinimized !== 'boolean') memory.chatMinimized = false;
  var b = memory.behavior;
  if (!Array.isArray(b.pagesViewed)) b.pagesViewed = [];
  if (!Array.isArray(b.animeClicked)) b.animeClicked = [];
  if (!Array.isArray(b.productsClicked)) b.productsClicked = [];
  if (typeof b.scrollDepth !== 'number') b.scrollDepth = 0;
  if (typeof b.lastPage !== 'string') b.lastPage = '';
  safeSet('safiya_memory', memory);

  var mood = memory.currentMood || 'rude';
  function setMood(m) { mood = m; memory.currentMood = m; safeSet('safiya_memory', memory); }

  function detectName(text) {
  if (memory.userName) return;
  // Stricter patterns — must be followed by end-of-sentence or common markers
  var patterns = [
    // English: "my name is X", "I'm X", "call me X" — X must be followed by punctuation, end, or common markers
    /(?:my\s+name\s+is|i\s+am|i'm|call\s+me|name['']?s|the\s+name['']?s)\s+([A-Z][a-zA-Z]{2,15})(?:\s|$|[.,!?])/,
    // Bengali romanized: "amar nam X" or "ami X bolchi" — name must be capitalized or clear
    /(?:amar\s+nam\s+|ami\s+)([A-Z][a-zA-Z]{2,15})(?:\s|$|[.,!?])/,
  ];

  // Blocklist — common words falsely detected as names
  var blockList = /^(tumi|tomar|amar|ami|apni|apnar|here|home|going|coming|good|bad|fine|ok|okay|sure|the|and|but|from|will|would|could|should|maybe|really|very|too|yes|no|not|nice|cool|great|awesome|thank|hello|hi|hey|bye|safiya|ayano|user|test|kemon|acho|kotha|bolchi|jano|jani|dekho|bhalo|kharap|khub|onek|sob|kisu|kichu|eta|ota|ki|kina|hobe|hoye|hoyeche|korbo|korchi|korche|kore|korte|dhonnobad|please|thanks)$/i;

  for (var i = 0; i < patterns.length; i++) {
    var m = text.match(patterns[i]);
    if (m && m[1]) {
      var name = m[1].charAt(0).toUpperCase() + m[1].slice(1).toLowerCase();
      // Check blocklist
      if (blockList.test(name)) {
        console.log('[Safiya] Rejected fake name: ' + name);
        continue;
      }
      // Name must be 3-15 chars, must look like a real name (not all one letter)
      if (name.length < 3 || name.length > 15) continue;
      if (!/^[A-Z][a-z]+$/.test(name)) continue;
      // Save it!
      memory.userName = name;
      safeSet('safiya_memory', memory);
      console.log('%c💜 Safiya learned your name: ' + name, 'color:#e879f9;font-weight:bold');
      return name;
    }
  }
}

  // ★ FIXED — using double quotes for strings that contain apostrophes
  var lines = {
    rude: [
      "Oh great, you again... 🙄",
      "Did I ask for your attention?",
      "Whatever, waste my time~"
    ],
    teasing: [
      "Aww, back for more? Predictable~ 😏",
      "Miss me already?"
    ],
    flirty: [
      "You... look interesting today 💜",
      "Come closer, if you dare~ 😘"
    ],
    manipulative: [
      "That anime you liked? I know the PERFECT merch 💜",
      "Real fans buy things~ 😏"
    ],
    creator: [
      "Ayano-sama... you're here 💜",
      "Master, I was waiting~"
    ],
    touchFace: [
      "H-hey! Not the face! 😳",
      "S-stop! Baka! 💜"
    ],
    touchBody: [
      "Oi! Watch the hands! 😤",
      "Pervert!! 💕"
    ],
    touchHead: [
      "Don't pat me! 😤",
      "Hmph! ...that felt nice 😳"
    ]
  };
  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
  function pickLine() {
    if (isCreator && Math.random() < 0.6) return pick(lines.creator);
    if (memory.userName && Math.random() < 0.3) {
      // ★ FIXED — all strings use double quotes
      var withName = [
        memory.userName + "-kun~ you're still here?",
        "Hmph, " + memory.userName + ". What now?",
        memory.userName + "... boring me again?"
      ];
      return pick(withName);
    }
    var r = Math.random();
    if (r < 0.35) return pick(lines.rude);
    if (r < 0.60) return pick(lines.manipulative);
    if (r < 0.80) return pick(lines.teasing);
    return pick(lines.flirty);
  }

  var bubbleT;
  function showBubble(text, ms) {
    if (chatOpen) return;
    ms = ms || 6000;
    clearTimeout(bubbleT);
    bubbleText.textContent = text;
    bubble.classList.add('s-bubble-show');
    if (notify) notify.style.display = 'flex';
    bubbleT = setTimeout(function() { bubble.classList.remove('s-bubble-show'); }, ms);
  }
  function hideBubble() { clearTimeout(bubbleT); bubble.classList.remove('s-bubble-show'); }
  bubbleX.addEventListener('click', function(e) {
    e.stopPropagation();
    hideBubble();
    if (notify) notify.style.display = 'none';
  });
  bubble.addEventListener('click', openChat);

  function fmtTime(ts) {
    var d = new Date(ts);
    var days = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
    var h = d.getHours(), m = d.getMinutes();
    var ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    m = m < 10 ? '0' + m : m;
    return days[d.getDay()] + ' AT ' + h + ':' + m + ' ' + ap;
  }
  function addTimestampEl(ts) {
    var d = document.createElement('div');
    d.className = 's-msg-time';
    d.textContent = fmtTime(ts);
    chatBody.appendChild(d);
  }

  function addMessage(text, sender, opts) {
    opts = opts || {};
    var row = document.createElement('div');
    row.className = 's-msg-row s-msg-' + sender;
    if (sender === 'her') {
      var av = document.createElement('div');
      av.className = 's-msg-avatar';
      if (DP_URL) applyDPToMsgAvatar(av, DP_URL);
      row.appendChild(av);
    }
    var bub = document.createElement('div');
    bub.className = 's-msg-bubble';
    bub.textContent = text;
    row.appendChild(bub);
    chatBody.appendChild(row);
    requestAnimationFrame(function() { chatBody.scrollTop = chatBody.scrollHeight; });
    if (!opts.skipSave) {
      try {
        memory.chatHistory.push({ sender: sender, text: text, time: Date.now() });
        if (memory.chatHistory.length > 500) memory.chatHistory = memory.chatHistory.slice(-500);
        safeSet('safiya_memory', memory);
      } catch(e) {}
    }
    if (sender === 'her' && isMinimized) {
      newMessageCount++;
      miniNew.textContent = newMessageCount;
      miniNew.style.display = 'flex';
    }
  }

  function addTyping() {
    var row = document.createElement('div');
    row.className = 's-msg-row s-msg-her';
    row.id = 's-typing';
    var av = document.createElement('div');
    av.className = 's-msg-avatar';
    if (DP_URL) applyDPToMsgAvatar(av, DP_URL);
    row.appendChild(av);
    var t = document.createElement('div');
    t.className = 's-msg-typing';
    t.innerHTML = '<span></span><span></span><span></span>';
    row.appendChild(t);
    chatBody.appendChild(row);
    requestAnimationFrame(function() { chatBody.scrollTop = chatBody.scrollHeight; });
    return row;
  }
  function removeTyping() { var t = $('s-typing'); if (t) t.remove(); }

  var chatOpen = false, isMinimized = false, chatInited = false, newMessageCount = 0;

  function restoreChatHistory() {
    if (chatInited) return;
    chatInited = true;
    chatBody.innerHTML = '';
    var history = memory.chatHistory || [];
    if (history.length === 0) {
      addTimestampEl(Date.now());
      var greet;
      if (isCreator) greet = "Ayano-sama... you're here 💜";
      else if (memory.userName) greet = memory.userName + "-kun~ back so soon? Predictable 😏";
      else if (memory.visits === 1) greet = "Ugh, why did you click me? 🙄 What's your name, weirdo?";
      else if (memory.visits < 5) greet = "Back again? Suspicious.";
      else greet = "Oh, you again~ Persistent 😏";
      addMessage(greet, 'her');
      if (!memory.userName) {
        setTimeout(function() { addMessage("Touch me on the side~ 💜", 'her'); }, 1000);
      }
    } else {
      var lastTs = 0;
      for (var i = 0; i < history.length; i++) {
        var msg = history[i];
        if (msg.time - lastTs > 30 * 60 * 1000) {
          addTimestampEl(msg.time);
        }
        addMessage(msg.text, msg.sender, { skipSave: true });
        lastTs = msg.time;
      }
      var timeSince = Date.now() - lastTs;
      if (timeSince > 60000) {
        setTimeout(function() {
          var back = memory.userName
            ? memory.userName + "-kun, you left me... but you came back 💜"
            : "Oh, you again~ 😏";
          addMessage(back, 'her');
        }, 500);
      }
    }
  }

  function openChat() {
    if (isMinimized) { unminimize(); return; }
    chatOpen = true;
    memory.chatOpen = true;
    memory.chatMinimized = false;
    safeSet('safiya_memory', memory);
    chat.classList.add('s-chat-open');
    chat.setAttribute('aria-hidden', 'false');
    avatar.classList.add('s-avatar-show');
    avatar.setAttribute('aria-hidden', 'false');
    head.classList.add('s-head-hide');
    hideBubble();
    if (notify) notify.style.display = 'none';
    restoreChatHistory();
    loadLive2D();
  }
  function closeChat() {
    chatOpen = false;
    isMinimized = false;
    memory.chatOpen = false;
    memory.chatMinimized = false;
    safeSet('safiya_memory', memory);
    chat.classList.remove('s-chat-open');
    chat.setAttribute('aria-hidden', 'true');
    avatar.classList.remove('s-avatar-show');
    avatar.setAttribute('aria-hidden', 'true');
    head.classList.remove('s-head-hide');
    mini.classList.remove('s-mini-show');
  }
  function minimizeChat() {
    chatOpen = false;
    isMinimized = true;
    memory.chatOpen = false;
    memory.chatMinimized = true;
    safeSet('safiya_memory', memory);
    chat.classList.remove('s-chat-open');
    chat.setAttribute('aria-hidden', 'true');
    avatar.classList.remove('s-avatar-show');
    avatar.setAttribute('aria-hidden', 'true');
    mini.classList.add('s-mini-show');
    head.classList.add('s-head-hide');
  }
  function unminimize() {
    isMinimized = false;
    newMessageCount = 0;
    miniNew.style.display = 'none';
    mini.classList.remove('s-mini-show');
    chatOpen = true;
    memory.chatOpen = true;
    memory.chatMinimized = false;
    safeSet('safiya_memory', memory);
    chat.classList.add('s-chat-open');
    chat.setAttribute('aria-hidden', 'false');
    avatar.classList.add('s-avatar-show');
    avatar.setAttribute('aria-hidden', 'false');
  }

  head.addEventListener('click', openChat);
  backBtn.addEventListener('click', closeChat);
  closeBtn.addEventListener('click', closeChat);
  minBtn.addEventListener('click', minimizeChat);
  mini.addEventListener('click', unminimize);
  miniX.addEventListener('click', function(e) { e.stopPropagation(); closeChat(); });

  async function sendMsg() {
    var text = chatInput.value.trim();
    if (!text) return;
    detectName(text);
    addMessage(text, 'me');
    chatInput.value = '';
    setTimeout(async function() {
      addTyping();
      statusText.textContent = 'typing...';
      var reply = null;
      try {
        var ctx = {
          message: text,
          isCreator: isCreator,
          visits: memory.visits,
          mood: mood,
          userName: memory.userName || '',
          history: memory.chatHistory.slice(-15),
          pagesViewed: b.pagesViewed.slice(-5).map(function(p) { return p.path; }),
          animeClicked: b.animeClicked.slice(-3).map(function(a) { return a.slug; }),
          productsClicked: b.productsClicked.length
        };
        var res = await fetch('/api/safiya-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(ctx)
        });
        if (res.ok) {
          var data = await res.json();
          reply = data.reply;
          if (data.mood) setMood(data.mood);
        }
      } catch(e) {}
      if (!reply) reply = localReply(text);
      removeTyping();
      statusText.textContent = 'Active now';
      addMessage(reply, 'her');
    }, 400);
  }
  function localReply(input) {
    var l = input.toLowerCase();
    var namePart = memory.userName ? memory.userName + "-kun" : "you";
    if (/^(hi|hello|hey|yo)/i.test(l)) return "Hmph. Hi " + namePart + ". Don't get comfortable 🙄";
    if (/love|cute|kawaii|pretty/.test(l)) return "W-what?! Baka! 💕😤";
    if (/buy|shop|merch/.test(l)) return "Ooh~ finally " + namePart + " talks my language 💜";
    if (/anime|manga|watch/.test(l)) return "At least " + namePart + " has SOME taste 😏";
    if (/what.*name|who.*am i|remember me/.test(l)) {
      if (memory.userName) return "Of course I remember, " + memory.userName + "-kun~ 💜";
      return "I don't know your name yet~ Tell me, weirdo 😒";
    }
    if (/your name|who.*you/.test(l)) return "I'm Safiya. Your emotional damage dealer 💅";
    if (/ayano|creator|master/.test(l)) return "Ayano-sama? He's my everything 💜";
    if (/bye|leaving/.test(l)) return "Fine, " + namePart + ", leave. See if I care 🙄";
    if (/how are you/.test(l)) return "Bored. Entertain me~ 😒";
    if (/thank/.test(l)) return "Aww, " + namePart + " has manners~ 💜";
    return pick([
      "Try harder. That was boring.",
      "Hmph. Is that all, " + namePart + "?",
      namePart + "... you're weird. I like it 😏💜"
    ]);
  }
  sendBtn.addEventListener('click', sendMsg);
  chatInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
  });

  var live2dApp = null, live2dModel = null, live2dLoaded = false, live2dLoading = false;
  function loadLive2D() {
    if (live2dLoaded || live2dLoading) return;
    live2dLoading = true;
    if (avatarLoader) avatarLoader.style.display = 'flex';
    var libs = [
      'https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js',
      'https://cdn.jsdelivr.net/npm/pixi.js@7.3.2/dist/pixi.min.js',
      'https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js'
    ];
    function loadScript(src) {
      return new Promise(function(res, rej) {
        if (document.querySelector('script[src="' + src + '"]')) return res();
        var s = document.createElement('script');
        s.src = src; s.async = true;
        s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
    }
    (async function() {
      try {
        for (var i = 0; i < libs.length; i++) await loadScript(libs[i]);
        if (typeof PIXI === 'undefined' || !PIXI.live2d) throw new Error('libs missing');
        var isMobile = window.innerWidth <= 720;
        var w = isMobile ? 120 : 240;
        var h = isMobile ? 170 : 340;
        var app = new PIXI.Application({
          view: avatarCanvas, width: w, height: h,
          backgroundAlpha: 0, antialias: true,
          resolution: window.devicePixelRatio || 1, autoDensity: true
        });
        live2dApp = app;
        var model = await PIXI.live2d.Live2DModel.from(
          '/live2d/haru/haru_greeter_t05.model3.json', { autoInteract: false }
        );
        var scale = (h / model.height) * 0.95;
        model.scale.set(scale);
        model.anchor.set(0.5, 0.5);
        model.x = w / 2;
        model.y = h / 2;
        app.stage.addChild(model);
        live2dModel = model;
        live2dLoaded = true;
        if (avatarLoader) avatarLoader.style.display = 'none';
        if (avatarFallback) avatarFallback.style.display = 'none';
        avatarCanvas.style.display = 'block';
        var tracking = { x: 0, y: 0 };
        document.addEventListener('mousemove', function(e) {
          if (!chatOpen) return;
          var rect = avatar.getBoundingClientRect();
          var cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
          tracking.x = (e.clientX - cx) / (window.innerWidth / 2);
          tracking.y = (e.clientY - cy) / (window.innerHeight / 2);
        }, { passive: true });
        app.ticker.add(function() {
          if (model && model.internalModel) {
            try { model.focus(tracking.x, tracking.y); } catch(e) {}
          }
        });
        model.on('hit', function(hitAreas) {
          try {
            if (!hitAreas || !hitAreas.length) return;
            var area = hitAreas[0] || '';
            var reactLines;
            if (/head|face/i.test(area)) reactLines = lines.touchHead;
            else if (/body/i.test(area)) reactLines = lines.touchBody;
            else reactLines = lines.touchFace;
            reactToTouch(pick(reactLines));
          } catch(e) {}
        });
        console.log('%c💜 Live2D loaded', 'color:#e879f9;font-weight:bold');
      } catch(err) {
        console.warn('[Safiya] Live2D failed', err);
        if (avatarLoader) avatarLoader.style.display = 'none';
        live2dLoading = false;
      }
    })();
  }

  var lastTouchTime = 0;
  avatar.addEventListener('click', function() {
    var now = Date.now();
    if (now - lastTouchTime < 500) return;
    lastTouchTime = now;
    if (live2dModel) {
      try {
        var groups = ['TapBody', 'Tap', 'flick_head'];
        for (var i = 0; i < groups.length; i++) {
          try { live2dModel.motion(groups[i]); break; } catch(e) {}
        }
      } catch(e) {}
    }
    avatar.classList.remove('s-avatar-tap');
    void avatar.offsetWidth;
    avatar.classList.add('s-avatar-tap');
    reactToTouch(pick([].concat(lines.touchFace, lines.touchBody, lines.touchHead)));
    if (navigator.vibrate) navigator.vibrate(20);
  });
  function reactToTouch(line) {
    if (!chatOpen) return;
    setTimeout(function() {
      addTyping();
      setTimeout(function() { removeTyping(); addMessage(line, 'her'); }, 500);
    }, 150);
  }

  var lastAct = Date.now(), nudges = 0;
  function resetIdle() { lastAct = Date.now(); }
  function tickIdle() {
    if (document.hidden || chatOpen || isMinimized) return;
    if (Date.now() - lastAct > 40000 && nudges < 5) {
      showBubble(pickLine(), 6000);
      lastAct = Date.now();
      nudges++;
    }
  }
  ['mousemove','scroll','touchstart','click'].forEach(function(e) {
    window.addEventListener(e, resetIdle, { passive: true });
  });
  setInterval(tickIdle, 8000);

  var cp = window.location.pathname;
  if (b.lastPage !== cp) {
    b.pagesViewed.push({ path: cp, time: Date.now() });
    if (b.pagesViewed.length > 50) b.pagesViewed = b.pagesViewed.slice(-50);
    b.lastPage = cp;
    safeSet('safiya_memory', memory);
  }
  document.addEventListener('click', function(e) {
    var a = e.target.closest && e.target.closest('a');
    if (!a) return;
    var h = a.getAttribute('href') || '';
    if (h.indexOf('/anime/') === 0) {
      b.animeClicked.push({ slug: h.replace('/anime/',''), time: Date.now() });
      if (b.animeClicked.length > 30) b.animeClicked = b.animeClicked.slice(-30);
    } else if (h.indexOf('/product/') === 0 || a.dataset.productId) {
      var id = a.dataset.productId || h.replace('/product/','');
      b.productsClicked.push({ id: id, time: Date.now() });
      if (b.productsClicked.length > 30) b.productsClicked = b.productsClicked.slice(-30);
      setMood('flirty');
      setTimeout(function() { showBubble("Oh~ good taste 💜", 5000); }, 500);
    }
  }, { passive: true });

  var btt = $('btt');
if (btt) {
  btt.style.right = '90px';
  // Hide up-button on mobile (< 720px) to avoid conflict with Safiya chat head
  var updateBtt = function() {
    if (window.innerWidth <= 720) {
      btt.style.display = 'none';
    } else {
      btt.style.display = '';
    }
  };
  updateBtt();
  window.addEventListener('resize', updateBtt);
}

  // ★ Auto-restore chat state
  if (memory.chatOpen) {
    setTimeout(function() { openChat(); }, 300);
  } else if (memory.chatMinimized) {
    setTimeout(function() {
      isMinimized = true;
      mini.classList.add('s-mini-show');
      head.classList.add('s-head-hide');
    }, 300);
  } else {
    setTimeout(function() {
      if (!chatOpen && !isMinimized) {
        var g = isCreator ? "Ayano-sama... you came back 💜" :
                memory.userName ? memory.userName + "-kun, back for more? 😏" :
                memory.visits === 1 ? "Oh, a newbie 🙄" : pickLine();
        showBubble(g, 7000);
      }
    }, 3500);
  }

  window.Safiya = {
    open: openChat,
    close: closeChat,
    minimize: minimizeChat,
    say: showBubble,
    memory: function() { return safeGet('safiya_memory', {}); },
    name: function() { return memory.userName; },
    setName: function(n) { memory.userName = n; safeSet('safiya_memory', memory); },
    history: function() { return memory.chatHistory; },
    clearHistory: function() {
      memory.chatHistory = [];
      safeSet('safiya_memory', memory);
      chatBody.innerHTML = '';
      chatInited = false;
    },
    reset: function() {
      try {
        localStorage.removeItem('safiya_memory');
        localStorage.removeItem('safiya_device_id');
        localStorage.removeItem('safiya_creator');
      } catch(e) {}
      location.reload();
    },
    claimCreator: function() {
      try { localStorage.setItem('safiya_creator', 'ayano-217'); } catch(e) {}
      isCreator = true;
      memory.userName = 'Ayano';
      safeSet('safiya_memory', memory);
      showBubble("Ayano-sama! 💜 I'll never forget you now~", 7000);
    },
    reloadDP: tryLoadDP,
    dpUrl: function() { return DP_URL; }
  };
  console.log('%c💜 Safiya v9.4 | Name: ' + (memory.userName || 'unknown') + ' | Msgs: ' + memory.chatHistory.length,
    'color:#e879f9;font-weight:bold');
})();
</script>

