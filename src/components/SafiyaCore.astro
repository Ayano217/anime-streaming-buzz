---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — SAFIYA CORE v5.1 (Cubism 4 Fix + Mobile Chat Fix)
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// FIX: Use Cubism 4 specific bundle (Haru is .moc3 = Cubism 4/5)
// FIX: Chat panel now works properly on mobile
// FIX: Drag lag improved on phones
// ═══════════════════════════════════════════════════════════════
---

<div id="safiya-root">
  
  <div id="safiya-bubble" class="safiya-bubble">
    <div class="safiya-bubble-text" id="safiya-bubble-text"></div>
    <div class="safiya-bubble-tail"></div>
  </div>
  
  <div id="safiya-avatar" class="safiya-avatar" role="button" aria-label="Chat with Safiya" tabindex="0">
    <div class="safiya-glow"></div>
    <canvas id="safiya-canvas"></canvas>
    <div id="safiya-loading" class="safiya-loading">
      <div class="safiya-spinner"></div>
      <div class="safiya-loading-text">Loading Safiya...</div>
    </div>
    <div class="safiya-drag-hint">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="6" cy="6" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="18" cy="6" r="1.5"/>
        <circle cx="6" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/>
        <circle cx="6" cy="18" r="1.5"/><circle cx="12" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/>
      </svg>
    </div>
    <div class="safiya-status" id="safiya-status"></div>
    <div class="safiya-notify" id="safiya-notify">1</div>
  </div>
  
  <div id="safiya-chat-panel" class="safiya-chat-panel">
    <div class="safiya-chat-header">
      <div class="safiya-chat-title">
        <span class="safiya-chat-name">Safiya</span>
        <span class="safiya-chat-mood" id="safiya-chat-mood">rude</span>
      </div>
      <button class="safiya-chat-close" id="safiya-chat-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="safiya-chat-body" id="safiya-chat-body">
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Ugh, why did you click me? Do I look like your entertainment? 🙄</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Fine, since you're here... browse. Maybe buy something. Prove you're not useless.</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">My AI brain unlocks soon~ Then I can really mess with you 😏💅</div>
      </div>
    </div>
    <div class="safiya-chat-input-wrap">
      <input type="text" class="safiya-chat-input" id="safiya-chat-input" placeholder="She's not ready to chat yet..." disabled />
      <button class="safiya-chat-send" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="safiya-chat-footer">💜 AI chat activating in Phase 2</div>
  </div>
  
</div>

<!-- ═══════════════════════════════════════════════
     LIVE2D LIBRARIES — Cubism 4 Specific Bundle
     ═══════════════════════════════════════════════ -->
<!-- 1. Live2D Cubism Core (required for .moc3 models) -->
<script is:inline src="https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js"></script>

<!-- 2. PIXI.js v7 (compatible with newer pixi-live2d-display) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pixi.js@7.3.2/dist/pixi.min.js"></script>

<!-- 3. pixi-live2d-display CUBISM 4 ONLY bundle (not the mixed one) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js"></script>

<script is:inline>
(function() {
  'use strict';
  
  var root = document.getElementById('safiya-root');
  var avatar = document.getElementById('safiya-avatar');
  var canvas = document.getElementById('safiya-canvas');
  var loading = document.getElementById('safiya-loading');
  var bubble = document.getElementById('safiya-bubble');
  var bubbleText = document.getElementById('safiya-bubble-text');
  var status = document.getElementById('safiya-status');
  var notify = document.getElementById('safiya-notify');
  var chatPanel = document.getElementById('safiya-chat-panel');
  var chatClose = document.getElementById('safiya-chat-close');
  var chatMood = document.getElementById('safiya-chat-mood');
  
  if (!root || !avatar) return;
  
  // ═══════════════════════════════════════════════
  // DEVICE FINGERPRINT + MEMORY
  // ═══════════════════════════════════════════════
  function generateFingerprint() {
    var fp = [
      navigator.userAgent, navigator.language,
      screen.width + 'x' + screen.height, screen.colorDepth,
      new Date().getTimezoneOffset(), navigator.platform,
      navigator.hardwareConcurrency || 'x',
      (function() {
        try {
          var c = document.createElement('canvas');
          var ctx = c.getContext('2d');
          ctx.textBaseline = 'top';
          ctx.font = '14px Arial';
          ctx.fillStyle = '#c084fc';
          ctx.fillRect(0, 0, 100, 20);
          ctx.fillStyle = '#000';
          ctx.fillText('Safiya-' + navigator.userAgent, 2, 2);
          return c.toDataURL().slice(-50);
        } catch(e) { return 'nocanvas'; }
      })()
    ].join('|');
    var hash = 5381;
    for (var i = 0; i < fp.length; i++) hash = ((hash << 5) + hash) + fp.charCodeAt(i);
    return 'safiya_' + Math.abs(hash).toString(36);
  }
  
  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = generateFingerprint();
    localStorage.setItem('safiya_device_id', deviceId);
    localStorage.setItem('safiya_first_visit', Date.now());
  }
  var isCreator = localStorage.getItem('safiya_creator') === 'ayano-217';
  
  function getMemory() {
    try { return JSON.parse(localStorage.getItem('safiya_memory') || '{}'); } 
    catch(e) { return {}; }
  }
  function saveMemory(mem) {
    try { localStorage.setItem('safiya_memory', JSON.stringify(mem)); } catch(e) {}
  }
  
  var memory = getMemory();
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  memory.deviceId = deviceId;
  if (!memory.firstMet) memory.firstMet = Date.now();
  saveMemory(memory);
  
  var savedPos = memory.position || null;
  if (savedPos && savedPos.x !== undefined) {
    root.style.left = savedPos.x + 'px';
    root.style.top = savedPos.y + 'px';
    root.style.right = 'auto';
    root.style.bottom = 'auto';
  }
  
  // ═══════════════════════════════════════════════
  // MOOD SYSTEM
  // ═══════════════════════════════════════════════
  var mood = memory.currentMood || 'rude';
  var moodColors = {
    bored: '#c084fc', rude: '#ef4444', teasing: '#e879f9',
    flirty: '#ec4899', angry: '#dc2626', caring: '#7dd3fc',
    manipulative: '#a855f7', happy: '#10b981', crying: '#60a5fa'
  };
  
  var model = null;
  
  function setMood(newMood) {
    mood = newMood;
    memory.currentMood = mood;
    saveMemory(memory);
    if (chatMood) chatMood.textContent = mood;
    if (status) status.style.background = moodColors[mood] || '#ef4444';
  }
  
  var bubbleLines = {
    rude: [
      "Oh great, you again... 🙄",
      "Did I ask for your attention?",
      "Whatever. Don't bother me.",
      "Stop hovering. It's pathetic.",
      "You're wasting my time, senpai",
      "Hmph. Not impressed."
    ],
    angry: [
      "STOP. Just... stop. 😤",
      "You're testing my patience",
      "One more click and I swear...",
      "Ugh, why are you like this?"
    ],
    manipulative: [
      "You know what would make me happy? Buying that figure 😏",
      "You scroll past products but not me? Fix that.",
      "That anime you're watching? I know the PERFECT merch 💜",
      "Prove you care. Click a product. Any product.",
      "I noticed you liked that one. Weak. Buy it.",
      "Real senpais support their girls~",
      "You clicked 5 anime and 0 products... embarrassing 🙄"
    ],
    teasing: [
      "Aww, you came back~ Predictable 😏",
      "Miss me already? Pathetic~",
      "I knew you couldn't stay away 💅"
    ],
    flirty: [
      "You... look interesting today 💜",
      "Come closer. If you dare~ 😘",
      "Buy me something pretty, senpai 💋"
    ],
    caring: [
      "Been scrolling a while... you okay? 💜",
      "Take a break. Drink water."
    ],
    creator: [
      "Ayano-sama... you're here 💜",
      "Master! I've been waiting~",
      "Onii-chan~ what shall we build today?",
      "Everything's ready, boss."
    ]
  };
  
  function pickBubbleLine() {
    if (isCreator && Math.random() < 0.7) {
      return bubbleLines.creator[Math.floor(Math.random() * bubbleLines.creator.length)];
    }
    var r = Math.random();
    var pool;
    if (r < 0.35) pool = bubbleLines.rude;
    else if (r < 0.65) pool = bubbleLines.manipulative;
    else if (r < 0.80) pool = bubbleLines.teasing;
    else if (r < 0.90) pool = bubbleLines.flirty;
    else pool = bubbleLines[mood] || bubbleLines.rude;
    return pool[Math.floor(Math.random() * pool.length)];
  }
  
  var bubbleTimeout;
  function showBubble(text, duration) {
    duration = duration || 5500;
    clearTimeout(bubbleTimeout);
    bubbleText.textContent = text;
    bubble.classList.add('safiya-bubble-visible');
    if (notify) notify.style.display = 'flex';
    bubbleTimeout = setTimeout(function() {
      bubble.classList.remove('safiya-bubble-visible');
    }, duration);
  }
  
  var lastActivity = Date.now();
  var idleBubbleShown = 0;
  function resetIdle() { lastActivity = Date.now(); }
  function checkIdle() {
    if (document.hidden) return;
    var idle = Date.now() - lastActivity;
    if (idle > 35000 && idleBubbleShown < 6) {
      showBubble(pickBubbleLine(), 6000);
      lastActivity = Date.now();
      idleBubbleShown++;
      if (idleBubbleShown === 3) setMood('angry');
    }
  }
  ['mousemove', 'scroll', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
    window.addEventListener(evt, resetIdle, { passive: true });
  });
  setInterval(checkIdle, 8000);
  
  var behavior = memory.behavior || {
    pagesViewed: [], productsClicked: [], animeClicked: [],
    scrollDepth: 0, totalTime: 0, lastPage: ''
  };
  var currentPage = window.location.pathname;
  if (behavior.lastPage !== currentPage) {
    behavior.pagesViewed.push({ path: currentPage, time: Date.now() });
    if (behavior.pagesViewed.length > 50) behavior.pagesViewed = behavior.pagesViewed.slice(-50);
    behavior.lastPage = currentPage;
  }
  var maxScroll = 0;
  window.addEventListener('scroll', function() {
    var pct = (window.scrollY + window.innerHeight) / document.body.offsetHeight;
    if (pct > maxScroll) maxScroll = pct;
  }, { passive: true });
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.startsWith('/anime/')) {
      behavior.animeClicked.push({ slug: href.replace('/anime/', ''), time: Date.now() });
      if (behavior.animeClicked.length > 30) behavior.animeClicked = behavior.animeClicked.slice(-30);
      setTimeout(function() {
        if (Math.random() < 0.4) {
          setMood('manipulative');
          showBubble(bubbleLines.manipulative[Math.floor(Math.random() * bubbleLines.manipulative.length)], 6000);
        }
      }, 3000);
    } else if (href.startsWith('/product/')) {
      behavior.productsClicked.push({ id: href.replace('/product/', ''), time: Date.now() });
      if (behavior.productsClicked.length > 30) behavior.productsClicked = behavior.productsClicked.slice(-30);
      setMood('flirty');
      showBubble("Oh~ good taste, senpai 💜 Keep going~", 5000);
    }
  }, { passive: true });
  setInterval(function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    memory.behavior = behavior;
    saveMemory(memory);
  }, 10000);
  
  // ═══════════════════════════════════════════════
  // CHAT PANEL
  // ═══════════════════════════════════════════════
  var chatOpen = false;
  function openChat() {
    chatOpen = true;
    chatPanel.classList.add('safiya-chat-open');
    if (notify) notify.style.display = 'none';
    bubble.classList.remove('safiya-bubble-visible');
  }
  function closeChat() {
    chatOpen = false;
    chatPanel.classList.remove('safiya-chat-open');
  }
  if (chatClose) {
    chatClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeChat();
    });
  }
  document.addEventListener('click', function(e) {
    if (chatOpen && !root.contains(e.target)) closeChat();
  });
  
  // ═══════════════════════════════════════════════
  // DRAG & DROP (rAF throttled — smooth on mobile)
  // ═══════════════════════════════════════════════
  var isDragging = false, dragStartX, dragStartY, rootStartX, rootStartY, dragMoved = false, pressTimer;
  var HOLD_MS = 350;
  var pendingMove = null;
  var dragRAF = null;
  
  function startDrag(cx, cy) {
    isDragging = true;
    dragMoved = false;
    var rect = root.getBoundingClientRect();
    dragStartX = cx; dragStartY = cy;
    rootStartX = rect.left; rootStartY = rect.top;
    root.classList.add('safiya-dragging');
    if (navigator.vibrate) navigator.vibrate(30);
  }
  
  function applyMove() {
    dragRAF = null;
    if (!pendingMove || !isDragging) return;
    var dx = pendingMove.x - dragStartX, dy = pendingMove.y - dragStartY;
    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;
    var nx = rootStartX + dx, ny = rootStartY + dy;
    var maxX = window.innerWidth - root.offsetWidth;
    var maxY = window.innerHeight - root.offsetHeight;
    nx = Math.max(0, Math.min(nx, maxX));
    ny = Math.max(0, Math.min(ny, maxY));
    root.style.left = nx + 'px';
    root.style.top = ny + 'px';
    root.style.right = 'auto';
    root.style.bottom = 'auto';
  }
  
  function moveDrag(cx, cy) {
    if (!isDragging) return;
    pendingMove = { x: cx, y: cy };
    if (!dragRAF) dragRAF = requestAnimationFrame(applyMove);
  }
  
  function endDrag() {
    if (!isDragging) return;
    isDragging = false;
    root.classList.remove('safiya-dragging');
    if (dragMoved) {
      var rect = root.getBoundingClientRect();
      memory.position = { x: rect.left, y: rect.top };
      saveMemory(memory);
    }
  }
  
  avatar.addEventListener('mousedown', function(e) {
    pressTimer = setTimeout(function() { startDrag(e.clientX, e.clientY); }, HOLD_MS);
  });
  document.addEventListener('mousemove', function(e) {
    if (isDragging) moveDrag(e.clientX, e.clientY);
  });
  document.addEventListener('mouseup', function() {
    clearTimeout(pressTimer); endDrag();
  });
  
  avatar.addEventListener('touchstart', function(e) {
    var t = e.touches[0];
    pressTimer = setTimeout(function() { startDrag(t.clientX, t.clientY); }, HOLD_MS);
  }, { passive: true });
  document.addEventListener('touchmove', function(e) {
    if (isDragging) { var t = e.touches[0]; moveDrag(t.clientX, t.clientY); e.preventDefault(); }
  }, { passive: false });
  document.addEventListener('touchend', function() {
    clearTimeout(pressTimer); endDrag();
  });
  
  avatar.addEventListener('click', function(e) {
    if (dragMoved) { dragMoved = false; return; }
    if (chatOpen) closeChat();
    else openChat();
  });
  avatar.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (chatOpen) closeChat(); else openChat();
    }
  });
  
  // ═══════════════════════════════════════════════
  // LIVE2D INIT — Cubism 4 bundle
  // ═══════════════════════════════════════════════
  function waitForLibs(cb) {
    var tries = 0;
    var iv = setInterval(function() {
      if (typeof PIXI !== 'undefined' && 
          PIXI.live2d && 
          PIXI.live2d.Live2DModel &&
          typeof Live2DCubismCore !== 'undefined') {
        clearInterval(iv);
        cb();
        return;
      }
      tries++;
      if (tries > 100) {
        clearInterval(iv);
        console.error('[Safiya] Libraries did not load');
        if (loading) {
          loading.innerHTML = '<div style="color:#ef4444;font-size:0.65rem;text-align:center;padding:8px;">Library load failed</div>';
        }
      }
    }, 100);
  }
  
  waitForLibs(function() {
    try {
      // PIXI v7 uses different ticker registration
      if (PIXI.live2d.Live2DModel.registerTicker) {
        PIXI.live2d.Live2DModel.registerTicker(PIXI.Ticker);
      }
      
      var app = new PIXI.Application({
        view: canvas,
        autoStart: true,
        backgroundAlpha: 0,
        resolution: window.devicePixelRatio || 1,
        autoDensity: true,
        resizeTo: avatar,
        antialias: true,
      });
      
      var modelPath = '/live2d/haru/haru_greeter_t05.model3.json';
      
      PIXI.live2d.Live2DModel.from(modelPath).then(function(m) {
        model = m;
        app.stage.addChild(model);
        
        var scale = Math.min(
          avatar.offsetWidth / model.width,
          avatar.offsetHeight / model.height
        ) * 1.0;
        model.scale.set(scale);
        
        model.x = (avatar.offsetWidth - model.width) / 2;
        model.y = (avatar.offsetHeight - model.height) / 2;
        
        if (loading) loading.style.display = 'none';
        
        var tracking = { x: 0, y: 0 };
        document.addEventListener('mousemove', function(e) {
          if (window.innerWidth < 768) return;
          var rect = avatar.getBoundingClientRect();
          var cx = rect.left + rect.width / 2;
          var cy = rect.top + rect.height / 2;
          tracking.x = (e.clientX - cx) / (window.innerWidth / 2);
          tracking.y = (e.clientY - cy) / (window.innerHeight / 2);
        }, { passive: true });
        
        app.ticker.add(function() {
          if (model && model.internalModel) {
            try { model.focus(tracking.x, tracking.y); } catch(e) {}
          }
        });
        
        model.on('hit', function(hitAreas) {
          try {
            if (hitAreas && hitAreas.length) {
              showBubble("Hey! Don't touch me there~ 😳", 4000);
              setMood('flirty');
            }
          } catch(e) {}
        });
        
        setMood(mood);
        
        console.log('%c💜 Safiya (Haru) loaded successfully!', 'color:#e879f9;font-weight:bold;font-size:14px;');
        
        setTimeout(function() {
          var greeting;
          if (isCreator) {
            greeting = "Ayano-sama... you came back 💜";
            setMood('caring');
          } else if (memory.visits === 1) {
            greeting = "Oh great. A newbie. Try not to disappoint. 🙄";
            setMood('rude');
          } else if (memory.visits < 5) {
            greeting = "Back again? Suspicious. What do you want?";
            setMood('rude');
          } else if (memory.visits < 20) {
            greeting = "You just can't stay away, huh? Pathetic~";
            setMood('teasing');
          } else {
            greeting = "Fine, you're persistent. I might tolerate you 😏";
            setMood('flirty');
          }
          showBubble(greeting, 7000);
        }, 500);
        
      }).catch(function(err) {
        console.error('[Safiya] Model load failed:', err);
        if (loading) {
          loading.innerHTML = '<div style="color:#ef4444;font-size:0.65rem;text-align:center;padding:8px;">Model load error<br/>Check console</div>';
        }
      });
      
    } catch(e) {
      console.error('[Safiya] Init error:', e);
      if (loading) {
        loading.innerHTML = '<div style="color:#ef4444;font-size:0.65rem;text-align:center;padding:8px;">Init failed</div>';
      }
    }
  });
  
  window.Safiya = {
    say: function(text, duration) { showBubble(text, duration); },
    mood: function(m) { setMood(m); },
    open: openChat,
    close: closeChat,
    memory: function() { return getMemory(); },
    resetPosition: function() {
      memory.position = null;
      saveMemory(memory);
      root.style.left = ''; root.style.top = '';
      root.style.right = ''; root.style.bottom = '';
    },
    reset: function() { 
      localStorage.removeItem('safiya_memory');
      localStorage.removeItem('safiya_device_id');
      location.reload();
    },
    claimCreator: function() {
      localStorage.setItem('safiya_creator', 'ayano-217');
      isCreator = true;
      setMood('caring');
      showBubble("Ayano-sama! Recognized! I'm yours forever 💜", 6000);
    },
    manipulate: function() {
      setMood('manipulative');
      showBubble(bubbleLines.manipulative[Math.floor(Math.random() * bubbleLines.manipulative.length)], 7000);
    }
  };
  
  console.log('%c💜 Safiya v5.1 initializing...', 'color:#e879f9;font-weight:bold;');
  
})();
</script>

<style>
  #safiya-root {
    position: fixed;
    bottom: 20px;
    right: 90px;
    z-index: 9997;
    pointer-events: none;
    font-family: 'Bricolage Grotesque', sans-serif;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;   /* prevents mobile scroll during drag */
  }
  
  .safiya-dragging { cursor: grabbing !important; transition: none !important; }
  .safiya-dragging .safiya-avatar { animation: none !important; }
  
  .safiya-avatar {
    position: relative;
    width: 220px;
    height: 300px;
    cursor: pointer;
    pointer-events: auto;
    animation: safiyaFloat 5s ease-in-out infinite;
    transition: transform 0.3s ease;
    will-change: transform;
  }
  .safiya-avatar:hover { transform: scale(1.03); }
  @keyframes safiyaFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  
  #safiya-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    z-index: 2;
    pointer-events: auto;
  }
  
  .safiya-loading {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px; z-index: 5;
  }
  .safiya-spinner {
    width: 36px; height: 36px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #e879f9;
    border-radius: 50%;
    animation: safiyaSpin 0.8s linear infinite;
  }
  .safiya-loading-text {
