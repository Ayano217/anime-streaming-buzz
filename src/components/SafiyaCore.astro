  // ═══════════════════════════════════════════════
  // ⏰ IDLE MOTIONS (silent, no repeat messages)
  // ═══════════════════════════════════════════════
  function startIdleMotions() {
    if (idleMotionInterval) clearInterval(idleMotionInterval);
    idleMotionInterval = setInterval(function() {
      if (!live2dModel || !chatOpen) return;
      if (Date.now() - lastMotionTime < 12000) return;
      // ONLY play motion (no chat message spam!)
      if (Math.random() < 0.35) playRandomMotion();
    }, 8000);
  }

  // ═══════════════════════════════════════════════
  // 👆 CENTRAL TOUCH HANDLER
  // Called from both avatar click AND model hit
  // Prevents duplicate messages
  // ═══════════════════════════════════════════════
  var lastTouchLine = '';
  var lastTouchAt = 0;

  function handleTouch(area) {
    // Debounce touches (min 800ms between)
    var now = Date.now();
    if (now - lastTouchAt < 800) return;
    lastTouchAt = now;

    // Play motion
    playRandomMotion();

    // Random expression sometimes
    if (Math.random() < 0.5 && availableExpressions.length) {
      playRandomExpression();
    }

    // ★ Play voice ONLY if user configured VOICE_LINES.touch
    playCustomVoice('touch');

    // Pick reaction line based on area
    var reactLines;
    if (/head|face/i.test(area || '')) reactLines = lines.touchHead;
    else if (/body/i.test(area || '')) reactLines = lines.touchBody;
    else reactLines = [].concat(lines.touchFace, lines.touchBody, lines.touchHead);

    // Prevent same line twice in a row
    var line;
    var tries = 0;
    do {
      line = pick(reactLines);
      tries++;
    } while (line === lastTouchLine && tries < 5);
    lastTouchLine = line;

    // Send to chat (only ONE message)
    reactToTouch(line);

    // Vibrate on mobile
    if (navigator.vibrate) navigator.vibrate(20);

    // Visual pulse
    avatar.classList.remove('s-avatar-tap');
    void avatar.offsetWidth;
    avatar.classList.add('s-avatar-tap');
  }

  // Avatar click uses same handler
  avatar.addEventListener('click', function() {
    handleTouch('body'); // Default to body if no specific hit
  });

