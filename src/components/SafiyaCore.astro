    /* Chat: FULL SCREEN on mobile (like real Messenger) */
    .safiya-chat {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      border: none;
      transform-origin: center;
    }

    .safiya-chat-open {
      transform: translateY(0) scale(1);
    }

    /* Larger input on mobile for easier tapping */
    .safiya-chat-input { padding: 12px 0; font-size: 1rem; }
    .safiya-chat-send { width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .safiya-head, .safiya-head-notify {
      animation: none !important;
    }
  }
</style>
