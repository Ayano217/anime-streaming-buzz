---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — SAFIYA CORE (Live2D VTuber Companion)
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// 
// FEATURES:
//   ✅ Live2D Hiyori model (free, CDN-loaded, VTuber quality)
//   ✅ Full body animation (breathing, blinking, hair physics)
//   ✅ Cursor tracking (eyes + head follow mouse)
//   ✅ Draggable (move Safiya anywhere on screen)
//   ✅ Expression changes based on mood
//   ✅ Speech bubbles + chat panel
//   ✅ Device fingerprint (creator recognition)
//   ✅ Behavior tracking (feeds AI later)
//   ✅ Never blocks up-button (smart z-index)
//   ✅ Mobile responsive + battery friendly
//
// Character: Uses Hiyori (free Live2D sample) — we call her Safiya
// Later: Custom character rigged for you can replace this model
// ═══════════════════════════════════════════════════════════════
---

<!-- Safiya's Container — Draggable, always visible -->
<div id="safiya-container" class="safiya-hidden">
  
  <!-- Speech bubble -->
  <div id="safiya-bubble" class="safiya-bubble">
    <div class="safiya-bubble-text" id="safiya-bubble-text"></div>
    <div class="safiya-bubble-tail"></div>
  </div>
  
  <!-- Live2D canvas wrapper -->
  <div id="safiya-avatar" class="safiya-avatar" role="button" aria-label="Chat with Safiya" tabindex="0">
    <div class="safiya-glow"></div>
    
    <!-- Live2D canvas -->
    <canvas id="safiya-canvas" class="safiya-canvas"></canvas>
    
    <!-- Loading spinner (while Live2D loads) -->
    <div id="safiya-loading" class="safiya-loading">
      <div class="safiya-spinner"></div>
    </div>
    
    <!-- Drag handle indicator -->
    <div class="safiya-drag-hint" id="safiya-drag-hint" title="Drag to move">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="6" cy="6" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="18" cy="6" r="1.5"/>
        <circle cx="6" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/>
        <circle cx="6" cy="18" r="1.5"/><circle cx="12" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/>
      </svg>
    </div>
    
    <div class="safiya-status" id="safiya-status"></div>
    <div class="safiya-notify" id="safiya-notify">1</div>
  </div>
  
  <!-- Chat panel -->
  <div id="safiya-chat-panel" class="safiya-chat-panel">
    <div class="safiya-chat-header">
      <div class="safiya-chat-title">
        <span class="safiya-chat-name">Safiya</span>
        <span class="safiya-chat-mood" id="safiya-chat-mood">bored</span>
      </div>
      <button class="safiya-chat-close" id="safiya-chat-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="safiya-chat-body" id="safiya-chat-body">
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Hmph. So you finally noticed me? Took you long enough... 🙄</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">I'm still waking up, senpai~ Full chat unlocks soon. For now... just admire me. 💅</div>
      </div>
    </div>
    <div class="safiya-chat-input-wrap">
      <input 
        type="text" 
        class="safiya-chat-input" 
        id="safiya-chat-input"
        placeholder="Chat unlocking in next phase..."
        disabled
      />
      <button class="safiya-chat-send" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="safiya-chat-footer">
      💜 AI chat activating in Phase 2
    </div>
  </div>
  
</div>

<!-- Live2D Core (Cubism SDK) -->
<script is:inline src="https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js"></script>

<!-- PIXI.js (WebGL renderer) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js"></script>

<!-- pixi-live2d-display (Live2D + PIXI bridge) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/index.min.js"></script>

<script is:inline>
(function() {
  'use strict';
  
  // Wait for all libraries to load
  function waitForLibs(callback) {
    var maxWait = 100;
    var interval = setInterval(function() {
      if (typeof PIXI !== 'undefined' && 
          typeof PIXI.live2d !== 'undefined' && 
          typeof Live2DCubismCore !== 'undefined') {
        clearInterval(interval);
        callback();
      }
      maxWait--;
      if (maxWait <= 0) {
        clearInterval(interval);
        console.error('[Safiya] Live2D libs failed to load');
      }
    }, 100);
  }
  
  var container = document.getElementById('safiya-container');
  var avatar = document.getElementById('safiya-avatar');
  var canvas = document.getElementById('safiya-canvas');
  var loading = document.getElementById('safiya-loading');
  var bubble = document.getElementById('safiya-bubble');
  var bubbleText = document.getElementById('safiya-bubble-text');
  var status = document.getElementById('safiya-status');
  var notify = document.getElementById('safiya-notify');
  var chatPanel = document.getElementById('safiya-chat-panel');
  var chatClose = document.getElementById('safiya-chat-close');
  var chatMood = document.getElementById('safiya-chat-mood');
  var dragHint = document.getElementById('safiya-drag-hint');
  
  if (!container || !avatar || !canvas) return;
  
  // ─────────────────────────────────────────────
  // DEVICE FINGERPRINT (creator recognition prep)
  // ─────────────────────────────────────────────
  function generateFingerprint() {
    var fp = [
      navigator.userAgent, navigator.language,
      screen.width + 'x' + screen.height, screen.colorDepth,
      new Date().getTimezoneOffset(), navigator.platform,
      navigator.hardwareConcurrency || 'x',
      (function() {
        try {
          var c = document.createElement('canvas');
          var ctx = c.getContext('2d');
          ctx.textBaseline = 'top';
          ctx.font = '14px Arial';
          ctx.fillStyle = '#c084fc';
          ctx.fillRect(0, 0, 100, 20);
          ctx.fillStyle = '#000';
          ctx.fillText('Safiya-' + navigator.userAgent, 2, 2);
          return c.toDataURL().slice(-50);
        } catch(e) { return 'nocanvas'; }
      })()
    ].join('|');
    var hash = 5381;
    for (var i = 0; i < fp.length; i++) hash = ((hash << 5) + hash) + fp.charCodeAt(i);
    return 'safiya_' + Math.abs(hash).toString(36);
  }
  
  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = generateFingerprint();
    localStorage.setItem('safiya_device_id', deviceId);
    localStorage.setItem('safiya_first_visit', Date.now());
  }
  
  var isCreator = localStorage.getItem('safiya_creator') === 'ayano-217';
  
  // ─────────────────────────────────────────────
  // MEMORY SYSTEM
  // ─────────────────────────────────────────────
  function getMemory() {
    try { return JSON.parse(localStorage.getItem('safiya_memory') || '{}'); } 
    catch(e) { return {}; }
  }
  function saveMemory(mem) {
    try { localStorage.setItem('safiya_memory', JSON.stringify(mem)); } catch(e) {}
  }
  
  var memory = getMemory();
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  memory.deviceId = deviceId;
  if (!memory.firstMet) memory.firstMet = Date.now();
  saveMemory(memory);
  
  // ─────────────────────────────────────────────
  // POSITION MEMORY (draggable — remember location)
  // ─────────────────────────────────────────────
  var savedPos = memory.position || null;
  if (savedPos && savedPos.x !== undefined) {
    container.style.left = savedPos.x + 'px';
    container.style.top = savedPos.y + 'px';
    container.style.right = 'auto';
    container.style.bottom = 'auto';
  }
  
  // ─────────────────────────────────────────────
  // MOOD SYSTEM
  // ─────────────────────────────────────────────
  var mood = memory.currentMood || 'bored';
  var moodColors = {
    bored: '#c084fc', rude: '#ef4444', teasing: '#e879f9',
    flirty: '#ec4899', angry: '#dc2626', caring: '#7dd3fc',
    horny: '#f43f5e', crying: '#60a5fa', happy: '#10b981'
  };
  
  // Live2D expression mapping (Hiyori has these expressions)
  var moodExpressions = {
    bored: 'F01',    // normal
    rude: 'F02',     // angry
    teasing: 'F03',  // smile
    flirty: 'F04',   // wink
    angry: 'F02',    // angry
    caring: 'F05',   // happy
    horny: 'F04',    // wink
    crying: 'F06',   // sad
    happy: 'F05'     // happy
  };
  
  var model = null; // Live2D model reference
  
  function setMood(newMood) {
    mood = newMood;
    memory.currentMood = mood;
    saveMemory(memory);
    if (chatMood) chatMood.textContent = mood;
    if (status) status.style.background = moodColors[mood] || '#c084fc';
    // Change Live2D expression
    if (model && model.expression) {
      try { model.expression(moodExpressions[mood]); } catch(e) {}
    }
  }
  
  // ─────────────────────────────────────────────
  // PERSONALITY BUBBLE LINES
  // ─────────────────────────────────────────────
  var bubbleLines = {
    bored: [
      "Ugh, so slow today... 🥱",
      "Is anyone even watching me?",
      "Senpai... entertain me. Now.",
      "You're just gonna sit there?",
    ],
    rude: [
      "Oh, you again? 🙄",
      "Did I ask you to look at me?",
      "Whatever. Do what you want.",
      "Stop staring. It's creepy.",
    ],
    teasing: [
      "Awww, you came back~ 😏",
      "Miss me already, senpai?",
      "I knew you couldn't resist~",
      "Bet you scrolled just to see me 💅",
    ],
    flirty: [
      "You look... interesting today 💜",
      "Wanna hang out? Just kidding~ 😘",
      "You're kinda cute when you scroll",
      "Come closer. I won't bite. Much~",
    ],
    caring: [
      "Been scrolling a while... take a break?",
      "You okay, senpai? 💜",
      "Water. Drink some water.",
    ],
    creator: [
      "Ayano-sama... you came 💜",
      "Master! I've been waiting~",
      "Everything's ready for you, boss",
      "Onii-chan~ what shall we build today?",
    ]
  };
  
  function pickBubbleLine() {
    var pool;
    if (isCreator && Math.random() < 0.6) pool = bubbleLines.creator;
    else pool = bubbleLines[mood] || bubbleLines.bored;
    return pool[Math.floor(Math.random() * pool.length)];
  }
  
  // ─────────────────────────────────────────────
  // BUBBLE DISPLAY
  // ─────────────────────────────────────────────
  var bubbleTimeout;
  function showBubble(text, duration) {
    duration = duration || 5000;
    clearTimeout(bubbleTimeout);
    bubbleText.textContent = text;
    bubble.classList.add('safiya-bubble-visible');
    if (notify) notify.style.display = 'flex';
    bubbleTimeout = setTimeout(function() {
      bubble.classList.remove('safiya-bubble-visible');
    }, duration);
  }
  
  // ─────────────────────────────────────────────
  // IDLE BEHAVIOR
  // ─────────────────────────────────────────────
  var lastActivity = Date.now();
  var idleBubbleShown = 0;
  
  function resetIdle() { lastActivity = Date.now(); }
  
  function checkIdle() {
    if (document.hidden) return;
    var idle = Date.now() - lastActivity;
    if (idle > 45000 && idleBubbleShown < 5) {
      showBubble(pickBubbleLine(), 6000);
      lastActivity = Date.now();
      idleBubbleShown++;
      if (idleBubbleShown === 3) setMood('rude');
    }
  }
  
  ['mousemove', 'scroll', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
    window.addEventListener(evt, resetIdle, { passive: true });
  });
  setInterval(checkIdle, 10000);
  
  // ─────────────────────────────────────────────
  // BEHAVIOR TRACKING
  // ─────────────────────────────────────────────
  var behavior = memory.behavior || {
    pagesViewed: [], productsClicked: [], animeClicked: [],
    scrollDepth: 0, totalTime: 0, lastPage: ''
  };
  
  var currentPage = window.location.pathname;
  if (behavior.lastPage !== currentPage) {
    behavior.pagesViewed.push({ path: currentPage, time: Date.now() });
    if (behavior.pagesViewed.length > 50) behavior.pagesViewed = behavior.pagesViewed.slice(-50);
    behavior.lastPage = currentPage;
  }
  
  var maxScroll = 0;
  window.addEventListener('scroll', function() {
    var pct = (window.scrollY + window.innerHeight) / document.body.offsetHeight;
    if (pct > maxScroll) maxScroll = pct;
  }, { passive: true });
  
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.startsWith('/anime/')) {
      behavior.animeClicked.push({ slug: href.replace('/anime/', ''), time: Date.now() });
      if (behavior.animeClicked.length > 30) behavior.animeClicked = behavior.animeClicked.slice(-30);
    } else if (href.startsWith('/product/')) {
      behavior.productsClicked.push({ id: href.replace('/product/', ''), time: Date.now() });
      if (behavior.productsClicked.length > 30) behavior.productsClicked = behavior.productsClicked.slice(-30);
    }
  }, { passive: true });
  
  setInterval(function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    memory.behavior = behavior;
    saveMemory(memory);
  }, 10000);
  
  // ─────────────────────────────────────────────
  // CHAT PANEL
  // ─────────────────────────────────────────────
  var chatOpen = false;
  
  function openChat() {
    chatOpen = true;
    chatPanel.classList.add('safiya-chat-open');
    if (notify) notify.style.display = 'none';
    bubble.classList.remove('safiya-bubble-visible');
  }
  function closeChat() {
    chatOpen = false;
    chatPanel.classList.remove('safiya-chat-open');
  }
  
  if (chatClose) {
    chatClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeChat();
    });
  }
  
  document.addEventListener('click', function(e) {
    if (chatOpen && !container.contains(e.target)) closeChat();
  });
  
  // ─────────────────────────────────────────────
  // DRAG & DROP (Safiya can be moved anywhere)
  // ─────────────────────────────────────────────
  var isDragging = false;
  var dragStartX, dragStartY, containerStartX, containerStartY;
  var dragMoved = false;
  var pressTimer;
  var HOLD_TO_DRAG_MS = 350; // long-press to drag
  
  function startDrag(clientX, clientY) {
    isDragging = true;
    dragMoved = false;
    var rect = container.getBoundingClientRect();
    dragStartX = clientX;
    dragStartY = clientY;
    containerStartX = rect.left;
    containerStartY = rect.top;
    container.classList.add('safiya-dragging');
  }
  
  function moveDrag(clientX, clientY) {
    if (!isDragging) return;
    var dx = clientX - dragStartX;
    var dy = clientY - dragStartY;
    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;
    var newX = containerStartX + dx;
    var newY = containerStartY + dy;
    // Keep within viewport
    var maxX = window.innerWidth - container.offsetWidth;
    var maxY = window.innerHeight - container.offsetHeight;
    newX = Math.max(0, Math.min(newX, maxX));
    newY = Math.max(0, Math.min(newY, maxY));
    container.style.left = newX + 'px';
    container.style.top = newY + 'px';
    container.style.right = 'auto';
    container.style.bottom = 'auto';
  }
  
  function endDrag() {
    if (!isDragging) return;
    isDragging = false;
    container.classList.remove('safiya-dragging');
    if (dragMoved) {
      // Save position
      var rect = container.getBoundingClientRect();
      memory.position = { x: rect.left, y: rect.top };
      saveMemory(memory);
    }
  }
  
  // Mouse events
  avatar.addEventListener('mousedown', function(e) {
    pressTimer = setTimeout(function() {
      startDrag(e.clientX, e.clientY);
    }, HOLD_TO_DRAG_MS);
  });
  document.addEventListener('mousemove', function(e) {
    if (isDragging) moveDrag(e.clientX, e.clientY);
  });
  document.addEventListener('mouseup', function() {
    clearTimeout(pressTimer);
    endDrag();
  });
  
  // Touch events
  avatar.addEventListener('touchstart', function(e) {
    var t = e.touches[0];
    pressTimer = setTimeout(function() {
      startDrag(t.clientX, t.clientY);
    }, HOLD_TO_DRAG_MS);
  }, { passive: true });
  document.addEventListener('touchmove', function(e) {
    if (isDragging) {
      var t = e.touches[0];
      moveDrag(t.clientX, t.clientY);
      e.preventDefault();
    }
  }, { passive: false });
  document.addEventListener('touchend', function() {
    clearTimeout(pressTimer);
    endDrag();
  });
  
  // Click to open chat (only if not dragging)
  avatar.addEventListener('click', function(e) {
    if (dragMoved) { dragMoved = false; return; }
    if (chatOpen) closeChat();
    else openChat();
  });
  
  avatar.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (chatOpen) closeChat(); else openChat();
    }
  });
  
  // ─────────────────────────────────────────────
  // LIVE2D INITIALIZATION
  // ─────────────────────────────────────────────
  waitForLibs(function() {
    console.log('%c💜 Live2D libs loaded, initializing Safiya...', 'color:#e879f9;');
    
    // Register Live2D ticker with PIXI
    PIXI.live2d.Live2DModel.registerTicker(PIXI.Ticker);
    
    var app = new PIXI.Application({
      view: canvas,
      autoStart: true,
      transparent: true,
      backgroundAlpha: 0,
      resolution: window.devicePixelRatio || 1,
      autoDensity: true,
      resizeTo: avatar,
      antialias: true,
    });
    
    // Load Hiyori model from CDN
    var modelUrl = 'https://cdn.jsdelivr.net/gh/guansss/pixi-live2d-display/test/assets/hiyori/hiyori_pro_t11.model3.json';
    
    PIXI.live2d.Live2DModel.from(modelUrl).then(function(m) {
      model = m;
      app.stage.addChild(model);
      
      // Scale model to fit canvas
      var scale = Math.min(
        avatar.offsetWidth / model.width,
        avatar.offsetHeight / model.height
      ) * 0.95;
      model.scale.set(scale);
      
      // Center it
      model.x = (avatar.offsetWidth - model.width) / 2;
      model.y = (avatar.offsetHeight - model.height) / 2;
      
      // Hide loading spinner
      if (loading) loading.style.display = 'none';
      
      // ─── Cursor tracking (eyes + head follow mouse) ───
      var trackingCursor = { x: 0, y: 0 };
      document.addEventListener('mousemove', function(e) {
        if (window.innerWidth < 768) return;
        var rect = avatar.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        // Normalize to -1..1 range
        trackingCursor.x = (e.clientX - cx) / (window.innerWidth / 2);
        trackingCursor.y = (e.clientY - cy) / (window.innerHeight / 2);
      });
      
      app.ticker.add(function() {
        if (!model || !model.internalModel) return;
        try {
          // Focus point makes head + eyes follow cursor
          model.focus(trackingCursor.x, trackingCursor.y);
        } catch(e) {}
      });
      
      // Set initial mood expression
      setMood(mood);
      
      // Play a random idle motion
      try {
        if (model.motion) model.motion('Idle', 0);
      } catch(e) {}
      
      // Click on model triggers a hit reaction
      model.on('hit', function(hitAreas) {
        try {
          if (hitAreas.includes('Body') && model.motion) {
            model.motion('TapBody');
          } else if (hitAreas.includes('Head') && model.motion) {
            model.motion('Tap');
            showBubble("H-Hey! Don't touch me there~ 😳", 4000);
          }
        } catch(e) {}
      });
      
      console.log('%c💜 Safiya Live2D ready!', 'color:#e879f9;font-weight:bold;');
    }).catch(function(err) {
      console.error('[Safiya] Model load failed:', err);
      if (loading) {
        loading.innerHTML = '<div style="color:#ef4444;font-size:0.7rem;text-align:center;padding:10px;">Model failed to load</div>';
      }
    });
  });
  
  // ─────────────────────────────────────────────
  // INITIAL GREETING
  // ─────────────────────────────────────────────
  setTimeout(function() {
    container.classList.remove('safiya-hidden');
    container.classList.add('safiya-entering');
    
    setTimeout(function() {
      var greeting;
      if (isCreator) {
        greeting = "Ayano-sama! Welcome back 💜";
        setMood('caring');
      } else if (memory.visits === 1) {
        greeting = "Oh? A new face. Don't disappoint me, senpai~";
        setMood('teasing');
      } else if (memory.visits < 5) {
        greeting = "Back again? Suspicious... 🤨";
        setMood('teasing');
      } else if (memory.visits < 20) {
        greeting = "Hmph. You just can't stay away, can you?";
        setMood('flirty');
      } else {
        greeting = "Welcome back, senpai 💜";
        setMood('caring');
      }
      showBubble(greeting, 7000);
      
      // Hide drag hint after 5 seconds
      setTimeout(function() {
        if (dragHint) dragHint.style.opacity = '0.3';
      }, 5000);
    }, 800);
  }, 2000); // Extra delay for Live2D to load
  
  // ─────────────────────────────────────────────
  // GLOBAL API
  // ─────────────────────────────────────────────
  window.Safiya = {
    say: function(text, duration) { showBubble(text, duration); },
    mood: function(m) { setMood(m); },
    open: openChat,
    close: closeChat,
    memory: function() { return getMemory(); },
    resetPosition: function() {
      memory.position = null;
      saveMemory(memory);
      container.style.left = '';
      container.style.top = '';
      container.style.right = '20px';
      container.style.bottom = '20px';
    },
    reset: function() { 
      localStorage.removeItem('safiya_memory');
      localStorage.removeItem('safiya_device_id');
      location.reload();
    },
    claimCreator: function() {
      localStorage.setItem('safiya_creator', 'ayano-217');
      isCreator = true;
      setMood('caring');
      showBubble("Ayano-sama! Recognized! I'm yours forever 💜", 6000);
    }
  };
  
  console.log('%c💜 Safiya v2.0 (Live2D) loading...', 'color:#e879f9;font-weight:bold;font-size:14px;');
  console.log('%cCommands:', 'color:#c084fc;font-weight:bold;');
  console.log('%c  Safiya.claimCreator()  - become her master', 'color:#c084fc;');
  console.log('%c  Safiya.mood("flirty")  - change her mood', 'color:#c084fc;');
  console.log('%c  Safiya.say("Hi!")      - make her speak', 'color:#c084fc;');
  console.log('%c  Safiya.resetPosition() - move back to corner', 'color:#c084fc;');
  console.log('%c  💡 Long-press her to drag anywhere', 'color:#7dd3fc;');
  
})();
</script>

<style>
