  function sendMsg() {
    var text = chatInput.value.trim();
    if (!text) return;

    session.lastActiveAt = Date.now();

    var parsedLinks = analyzeUserText(text);
    addMessage(text, 'me');
    chatInput.value = '';

    triggerMotionByKeyword('listen');

    setTimeout(function() {
      addTyping();
      statusText.textContent = 'typing...';

      var stage = getRelationshipStage();
      var ctx = {
        message: text,
        isCreator: isCreator,
        visits: memory.visits,
        mood: mood,
        userName: memory.userName || '',
        history: memory.chatHistory.slice(-18),
        pagesViewed: memory.behavior.pagesViewed.slice(-8).map(function(p) { return p.path; }),
        animeClicked: memory.behavior.animeClicked.slice(-5).map(function(a) { return a.slug; }),
        productsClicked: memory.behavior.productsClicked.length,

        relationshipStage: memory.relationship.stageKey,
        relationshipLabel: memory.relationship.stageLabel,
        relationshipScore: memory.relationship.score,
        userType: memory.profile.userType,
        favoriteAnime: memory.profile.favoriteAnime || '',
        preferredLanguage: memory.profile.prefLanguage || 'en',
        pageViews: memory.pageViews,

        currentlyWatching: memory.behavior.currentlyWatching || null,
        watchHistory: memory.behavior.watchHistory.slice(-5),
        savedVideos: memory.behavior.savedVideos.slice(-5),
        currentProduct: memory.behavior.currentProduct || null,
        currentAnime: memory.behavior.currentAnime || null,
        sharedLinks: memory.behavior.sharedLinks.slice(-3),
        recentParsedLinks: parsedLinks || [],

        stageHint: stage.key,
        deviceId: deviceId
      };

      fetch('/api/safiya-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(ctx)
      }).then(function(res) {
        if (res.ok) return res.json();
        throw new Error('AI failed');
      }).then(function(data) {
        var reply = data && data.reply ? data.reply : '';
        if (data && data.mood) {
          mood = data.mood;
          setMood(data.mood);
        }
        finishReply(reply, parsedLinks);
      }).catch(function() {
        finishReply(localReply(text, parsedLinks), parsedLinks);
      });
    }, 350);
  }

