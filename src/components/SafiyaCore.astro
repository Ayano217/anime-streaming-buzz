    var lastTs = 0;
    for (var i = 0; i < history.length; i++) {
      var msg = history[i];
      if (msg.time - lastTs > 30 * 60 * 1000) addTimestampEl(msg.time);
      addMessage(msg.text, msg.sender, { skipSave: true });
      lastTs = msg.time;
