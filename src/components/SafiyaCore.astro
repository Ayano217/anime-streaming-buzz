  var live2dLoaded = false, live2dLoading = false;
  var availableMotions = [];
  var availableExpressions = [];
  var lastMotionTime = 0;
  var idleMotionInterval = null;
  var currentAudio = null;

  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }

  function playCustomVoice(category) {
    if (!VOICE_LINES[category] || VOICE_LINES[category].length === 0) return;
    if (currentAudio) {
      try { currentAudio.pause(); currentAudio.currentTime = 0; } catch(e) {}
    }
    var line = pick(VOICE_LINES[category]);
    try {
      currentAudio = new Audio(line);
      currentAudio.volume = 0.7;
      currentAudio.play().catch(function() {});
    } catch(e) {}
  }

  function stopAllAudio() {
    if (currentAudio) {
      try { currentAudio.pause(); currentAudio.currentTime = 0; } catch(e) {}
      currentAudio = null;
    }
    if (live2dModel && live2dModel.internalModel) {
      try {
        var mm = live2dModel.internalModel.motionManager;
        if (mm && mm.currentAudio) {
          try { mm.currentAudio.pause(); mm.currentAudio = null; } catch(e) {}
        }
      } catch(e) {}
    }
  }

  function loadLive2D() {
    if (live2dLoaded || live2dLoading) return;
    live2dLoading = true;
    if (avatarLoader) avatarLoader.style.display = 'flex';

    var libs = [
      'https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js',
      'https://cdn.jsdelivr.net/npm/pixi.js@7.3.2/dist/pixi.min.js',
      'https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js'
    ];

    function loadScript(src) {
      return new Promise(function(res, rej) {
        if (document.querySelector('script[src="' + src + '"]')) return res();
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = res;
        s.onerror = rej;
        document.head.appendChild(s);
      });
    }

    function tryLoadModel(path) {
      return fetch(path, { method: 'HEAD' }).then(function(res) {
        if (!res.ok) return null;
        return PIXI.live2d.Live2DModel.from(path, {
          autoInteract: false,
          autoUpdate: true,
          motionPreload: 'NONE'
        });
      }).catch(function() {
        return null;
      });
    }

    (function() {
      var loadChain = Promise.resolve();
      libs.forEach(function(src) {
        loadChain = loadChain.then(function() { return loadScript(src); });
      });

      loadChain.then(function() {
        if (typeof PIXI === 'undefined' || !PIXI.live2d) throw new Error('libs missing');

        if (PIXI.live2d.SoundManager) PIXI.live2d.SoundManager.volume = 0;
        if (PIXI.live2d.config) PIXI.live2d.config.sound = false;

        var isMobile = window.innerWidth <= 720;
        var w = isMobile ? 120 : 240;
        var h = isMobile ? 170 : 340;

        var app = new PIXI.Application({
          view: avatarCanvas,
          width: w,
          height: h,
          backgroundAlpha: 0,
          antialias: true,
          resolution: window.devicePixelRatio || 1,
          autoDensity: true
        });
        live2dApp = app;

        var pathsToTry = [MODEL_PATH].concat(MODEL_FALLBACKS.filter(function(p) { return p !== MODEL_PATH; }));
        var modelChain = Promise.resolve(null);

        pathsToTry.forEach(function(p) {
          modelChain = modelChain.then(function(m) {
            if (m) return m;
            return tryLoadModel(p);
          });
        });

        return modelChain.then(function(model) {
          if (!model) throw new Error('No model loaded');

          var scale = (h / model.height) * 0.95;
          model.scale.set(scale);
          model.anchor.set(0.5, 0.5);
          model.x = w / 2;
          model.y = h / 2;

          app.stage.addChild(model);
          live2dModel = model;
          live2dLoaded = true;

          if (avatarLoader) avatarLoader.style.display = 'none';
          if (avatarFallback) avatarFallback.style.display = 'none';
          avatarCanvas.style.display = 'block';

          try {
            var mm = model.internalModel && model.internalModel.motionManager;
            if (mm) {
              if (mm.playSound) mm.playSound = function() { return; };
              if (mm._playSound) mm._playSound = function() { return; };
              if (mm.on) mm.on('motionStart', function() { stopAllAudio(); });
            }
            if (model.volume !== undefined) model.volume = 0;
          } catch(e) {}

          try {
            var settings = model.internalModel && model.internalModel.settings;
            if (settings && settings.motions) {
              availableMotions = [];
              Object.keys(settings.motions).forEach(function(group) {
                var count = (settings.motions[group] || []).length;
                availableMotions.push({ groupName: group, count: count });
              });
            }
            if (settings && settings.expressions) {
              availableExpressions = settings.expressions.map(function(e) {
                return e.Name || e.name;
              }).filter(Boolean);
            }
          } catch(e) {}

          var tracking = { x: 0, y: 0 };
          document.addEventListener('mousemove', function(e) {
            if (!chatOpen) return;
            var rect = avatar.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;
            tracking.x = (e.clientX - cx) / (window.innerWidth / 2);
            tracking.y = (e.clientY - cy) / (window.innerHeight / 2);
          }, { passive: true });

          app.ticker.add(function() {
            if (model && model.internalModel) {
              try { model.focus(tracking.x, tracking.y); } catch(e) {}
            }
          });

          model.on('hit', function(hitAreas) {
            try {
              if (!hitAreas || !hitAreas.length) return;
              handleTouch(hitAreas[0] || '');
            } catch(e) {}
          });

          startIdleMotions();
          setTimeout(function() { playRandomMotion(); }, 800);
        });
      }).catch(function() {
        if (avatarLoader) avatarLoader.style.display = 'none';
        live2dLoading = false;
      });
    })();
  }

  function playMotion(groupName, index, priority) {
    if (!live2dModel) return false;
    priority = priority || 2;
    try {
      stopAllAudio();
      if (typeof index === 'number') {
        live2dModel.motion(groupName, index, priority);
      } else {
        live2dModel.motion(groupName, undefined, priority);
      }
      lastMotionTime = Date.now();
      setTimeout(stopAllAudio, 60);
      setTimeout(stopAllAudio, 200);
      return true;
    } catch(e) {
      return false;
    }
  }

  function playRandomMotion() {
    if (!live2dModel || !availableMotions.length) return;
    var nonIdle = availableMotions.filter(function(m) { return !/idle/i.test(m.groupName); });
    var pool = nonIdle.length ? nonIdle : availableMotions;
    var chosen = pick(pool);
    playMotion(chosen.groupName, undefined, 2);
  }

  function playExpression(name) {
    if (!live2dModel) return false;
    try {
      live2dModel.expression(name);
      return true;
    } catch(e) {
      return false;
    }
  }

  function playRandomExpression() {
    if (!availableExpressions.length) return;
    playExpression(pick(availableExpressions));
  }

  function findMotionGroup(keywords) {
    if (!availableMotions.length) return null;
    for (var i = 0; i < keywords.length; i++) {
      var kw = keywords[i].toLowerCase();
      var found = availableMotions.find(function(m) {
        return m.groupName.toLowerCase().indexOf(kw) !== -1;
      });
      if (found) return found.groupName;
    }
    return null;
  }

  function triggerMotionByKeyword(context) {
    if (!live2dModel) return;
    var groupMap = {
      greet: ['greet', 'hello', 'hi', 'wave', 'tap_body'],
      happy: ['happy', 'smile', 'joy', 'laugh'],
      sad: ['sad', 'cry', 'down'],
      angry: ['angry', 'mad', 'flick'],
      shy: ['shy', 'blush', 'flick_head', 'head'],
      surprise: ['surprise', 'shock', 'gasp'],
      listen: ['idle', 'listen', 'wait'],
      love: ['love', 'heart', 'flirt'],
      dance: ['dance', 'body']
    };
    var keywords = groupMap[context] || [context];
    var group = findMotionGroup(keywords);
    if (group) {
      playMotion(group, undefined, 2);
      return true;
    }
    playRandomMotion();
    return false;
  }

  function tryExpression(keywords) {
    if (!availableExpressions.length) return false;
    for (var i = 0; i < keywords.length; i++) {
      var found = availableExpressions.find(function(e) {
        return e.toLowerCase().indexOf(keywords[i].toLowerCase()) !== -1;
      });
      if (found) {
        playExpression(found);
        return true;
      }
    }
    return false;
  }

  function triggerMotionFromText(text) {
    if (!live2dModel || !text) return;
    var t = text.toLowerCase();

    if (/💜|💕|cute|sweet|blush|shy|missed|stop being nice/.test(t)) {
      triggerMotionByKeyword('shy');
      tryExpression(['shy', 'blush', 'happy']);
    } else if (/😤|angry|mad|hmph|ugh|stop|baka|boundaries/.test(t)) {
      triggerMotionByKeyword('angry');
      tryExpression(['angry', 'mad']);
    } else if (/hi|hey|hello|welcome|back/.test(t)) {
      triggerMotionByKeyword('greet');
      tryExpression(['happy', 'smile']);
    } else if (/✨|😊|nice|good|great|yay|lol|bestie/.test(t)) {
      triggerMotionByKeyword('happy');
      tryExpression(['happy', 'smile']);
    } else if (/😳|really|omg|wow/.test(t)) {
      triggerMotionByKeyword('surprise');
      tryExpression(['surprise', 'shock']);
    } else if (Math.random() < 0.35) {
      playRandomMotion();
    }
  }

  function triggerMoodMotion(newMood) {
    if (!live2dModel) return;
    if (newMood === 'flirty') {
      triggerMotionByKeyword('shy');
      tryExpression(['shy', 'blush']);
    } else if (newMood === 'angry') {
      triggerMotionByKeyword('angry');
      tryExpression(['angry']);
    } else if (newMood === 'caring') {
      triggerMotionByKeyword('happy');
      tryExpression(['happy']);
    } else if (newMood === 'rude') {
      triggerMotionByKeyword('angry');
      tryExpression(['angry']);
    }
  }

  function startIdleMotions() {
    if (idleMotionInterval) clearInterval(idleMotionInterval);
    idleMotionInterval = setInterval(function() {
      if (!live2dModel || !chatOpen) return;
      if (Date.now() - lastMotionTime < 12000) return;
      if (Math.random() < 0.32) playRandomMotion();
    }, 8000);
  }

  // ═══ TOUCH HANDLER ═══
  var lastTouchLine = '';
  var lastTouchAt = 0;

  function reactToTouch(line) {
    if (!chatOpen) return;
    setTimeout(function() {
      addTyping();
      setTimeout(function() {
        removeTyping();
        addMessage(line, 'her');
      }, 420);
    }, 140);
  }

  function handleTouch(area) {
    var now = Date.now();
    if (now - lastTouchAt < 800) return;
    lastTouchAt = now;

    playRandomMotion();
    if (Math.random() < 0.5 && availableExpressions.length) playRandomExpression();
    playCustomVoice('touch');

    var reactLines = getTouchLines(area || '');
    var line = '';
    var tries = 0;
    do {
      line = pick(reactLines);
      tries++;
    } while (line === lastTouchLine && tries < 5);

    lastTouchLine = line;
    reactToTouch(line);

    if (navigator.vibrate) navigator.vibrate(20);
    avatar.classList.remove('s-avatar-tap');
    void avatar.offsetWidth;
    avatar.classList.add('s-avatar-tap');
  }

  avatar.addEventListener('click', function() {
    handleTouch('body');
  });

  // ═══════════════════════════════════════════════
  // 📡 WATCH / PRODUCT / PAGE CONTEXT MEMORY
  // ═══════════════════════════════════════════════
  function setCurrentPageContext() {
    var path = window.location.pathname || '/';

    if (path.indexOf('/product/') === 0) {
      memory.behavior.currentProduct = {
        id: path.replace('/product/', '').replace(/\/+$/, ''),
        path: path,
        time: Date.now()
      };
    } else if (path.indexOf('/anime/') === 0) {
      memory.behavior.currentAnime = {
        slug: path.replace('/anime/', '').replace(/\/+$/, ''),
        path: path,
        time: Date.now()
      };
    } else if (path.indexOf('/reels/') === 0) {
      memory.behavior.currentlyWatching = memory.behavior.currentlyWatching || {
        id: path.replace('/reels/', '').replace(/\/+$/, ''),
        path: path,
        time: Date.now()
      };
    }

    persistMemory();
  }

  function pushWatchHistory(item) {
    if (!item) return;

    var clean = {
      id: item.id || item.videoId || item.slug || '',
      title: item.title || item.caption || item.name || '',
      type: item.type || 'video',
      path: item.path || location.pathname,
      time: Date.now()
    };

    memory.behavior.currentlyWatching = clean;

    var list = memory.behavior.watchHistory || [];
    var duplicate = false;
    for (var i = list.length - 1; i >= 0; i--) {
      if (list[i] && list[i].id && clean.id && list[i].id === clean.id) {
        duplicate = true;
        break;
      }
    }
    if (!duplicate) {
      list.push(clean);
      memory.behavior.watchHistory = trimArray(list, 40);
    }

    persistMemory();
  }

  function pushSavedVideo(item) {
    if (!item) return;

    var clean = {
      id: item.id || item.videoId || '',
      title: item.title || item.caption || item.name || '',
      path: item.path || location.pathname,
      time: Date.now()
    };

    memory.behavior.savedVideos.push(clean);
    memory.behavior.savedVideos = trimArray(memory.behavior.savedVideos, 40);
    persistMemory();

    if (!chatOpen && !session.saveBubbleShown) {
      session.saveBubbleShown = true;
      showBubble('saved that one for later? smart 💜', 4200);
    }
  }

  window.addEventListener('safiya:watching', function(ev) {
    var detail = ev && ev.detail ? ev.detail : {};
    pushWatchHistory(detail);

    if (!chatOpen && Math.random() < 0.35) {
      var title = detail.title || detail.caption || '';
      showBubble(title ? ('ooh "' + title.slice(0, 38) + '"? nice taste') : 'ooh, nice taste ✨', 4300);
    }
  });

  window.addEventListener('reels:watch', function(ev) {
    var detail = ev && ev.detail ? ev.detail : {};
    pushWatchHistory(detail);
  });

  window.addEventListener('video:watch', function(ev) {
    var detail = ev && ev.detail ? ev.detail : {};
    pushWatchHistory(detail);
  });

  window.addEventListener('safiya:videoSaved', function(ev) {
    var detail = ev && ev.detail ? ev.detail : {};
    pushSavedVideo(detail);
  });

  window.addEventListener('reels:saved', function(ev) {
    var detail = ev && ev.detail ? ev.detail : {};
    pushSavedVideo(detail);
  });

  var cp = window.location.pathname || '/';
  if (memory.behavior.lastPage !== cp) {
    memory.behavior.pagesViewed.push({ path: cp, time: Date.now() });
    memory.behavior.pagesViewed = trimArray(memory.behavior.pagesViewed, 80);
    memory.behavior.lastPage = cp;
    persistMemory();
  }

  setCurrentPageContext();

  document.addEventListener('click', function(e) {
    var a = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!a) return;

    var h = a.getAttribute('href') || '';
    if (h.indexOf('/anime/') === 0) {
      memory.behavior.animeClicked.push({
        slug: h.replace('/anime/', '').replace(/\/+$/, ''),
        time: Date.now()
      });
      memory.behavior.animeClicked = trimArray(memory.behavior.animeClicked, 50);
      persistMemory();
    } else if (h.indexOf('/product/') === 0 || a.dataset.productId) {
      var id = a.dataset.productId || h.replace('/product/', '').replace(/\/+$/, '');
      memory.behavior.productsClicked.push({ id: id, time: Date.now() });
      memory.behavior.productsClicked = trimArray(memory.behavior.productsClicked, 50);
      memory.behavior.currentProduct = { id: id, path: h, time: Date.now() };
      persistMemory();
      setMood('flirty');

      if (!chatOpen && !session.productBubbleShown) {
        session.productBubbleShown = true;
        showBubble('oh~ good taste', 3800);
      }
    }
  }, { passive: true });

  // ═══════════════════════════════════════════════
  // 💤 LOW-SPAM AUTOMATION
  // ═══════════════════════════════════════════════
  function resetIdle() {
    session.lastActiveAt = Date.now();
  }

  window.addEventListener('mousemove', resetIdle, { passive: true });
  window.addEventListener('click', resetIdle, { passive: true });
  window.addEventListener('touchstart', resetIdle, { passive: true });

  window.addEventListener('scroll', function() {
    session.lastActiveAt = Date.now();
    session.lastScrollAt = Date.now();
    var doc = document.documentElement;
    var body = document.body;
    var scrollTop = window.scrollY || doc.scrollTop || body.scrollTop || 0;
    var height = Math.max(body.scrollHeight, doc.scrollHeight) - window.innerHeight;
    var depth = height > 0 ? Math.round((scrollTop / height) * 100) : 0;
    if (depth > memory.behavior.scrollDepth) {
      memory.behavior.scrollDepth = depth;
      persistMemory();
    }
  }, { passive: true });

  function tickIdle() {
    if (document.hidden || chatOpen || isMinimized) return;
    if (session.nudgesSent >= 2) return;
    if (Date.now() - session.lastActiveAt < 60000) return;
    if (Date.now() - session.lastScrollAt < 15000) return;
    if (Date.now() - session.lastAutoAt < 60000) return;

    session.nudgesSent += 1;
    session.lastAutoAt = Date.now();
    memory.automation.nudgesSentLifetime += 1;
    memory.automation.lastNudgeAt = Date.now();
    persistMemory();

    showBubble(getSubtleNudge(), 5200);
  }

  setInterval(tickIdle, 10000);

  // ═══════════════════════════════════════════════
  // 🔁 AUTO RESTORE
  // ═══════════════════════════════════════════════
  if (memory.automation.chatOpen) {
    setTimeout(function() { openChat(); }, 300);
  } else if (memory.automation.chatMinimized) {
    setTimeout(function() {
      isMinimized = true;
      mini.classList.add('s-mini-show');
      head.classList.add('s-head-hide');
    }, 300);
  } else {
    setTimeout(function() {
      if (!chatOpen && !isMinimized && !session.didWelcome) {
        session.didWelcome = true;
        showBubble(getStageBasedGreeting(), 6500);
      }
    }, 3200);
  }

  // ═══════════════════════════════════════════════
  // ⌨️ SECRET SHORTCUT
  // ═══════════════════════════════════════════════
  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
      e.preventDefault();
      try { localStorage.setItem(CREATOR_KEY, 'ayano-217'); } catch(err) {}
      isCreator = true;
      memory.userName = 'Ayano';
      memory.profile.nameUpdatedAt = Date.now();
      persistMemory();
      showBubble('Ayano-sama! 💜 Welcome back~', 7000);
      setTimeout(function() { location.reload(); }, 1800);
    }
  });

  // ═══════════════════════════════════════════════
  // ↕️ BACK-TO-TOP SAFETY OFFSET
  // ═══════════════════════════════════════════════
  var btt = $('btt');
  if (btt) {
    function updateBtt() {
      if (window.innerWidth <= 720) {
        btt.style.display = 'none';
        return;
      }
      btt.style.display = '';
      var w = head ? head.offsetWidth : 160;
      btt.style.right = Math.max(96, w + 34) + 'px';
    }
    updateBtt();
    window.addEventListener('resize', updateBtt);
    setTimeout(updateBtt, 600);
  }

  // ═══════════════════════════════════════════════
  // 🌐 GLOBAL API
  // ═══════════════════════════════════════════════
  window.Safiya = {
    open: openChat,
    close: closeChat,
    minimize: minimizeChat,
    say: showBubble,
    memory: function() {
      return safeGet(memoryKey, safeGet(LEGACY_MEMORY_KEY, {}));
    },
    name: function() {
      return memory.userName;
    },
    setName: function(n) {
      memory.userName = String(n || '').trim().slice(0, 24);
      memory.profile.nameUpdatedAt = Date.now();
      persistMemory();
    },
    history: function() {
      return memory.chatHistory;
    },
    stage: function() {
      return getRelationshipStage();
    },
    clearHistory: function() {
      memory.chatHistory = [];
      persistMemory();
      chatBody.innerHTML = '';
      chatInited = false;
    },
    reset: function() {
      try {
        safeRemove(memoryKey);
        safeRemove(LEGACY_MEMORY_KEY);
        safeRemove(DEVICE_KEY);
        safeRemove(CREATOR_KEY);
      } catch(e) {}
      setCookie(DEVICE_KEY, '', -1);
      location.reload();
    },
    claimCreator: function() {
      try { localStorage.setItem(CREATOR_KEY, 'ayano-217'); } catch(e) {}
      isCreator = true;
      memory.userName = 'Ayano';
      memory.profile.nameUpdatedAt = Date.now();
      persistMemory();
      showBubble('Ayano-sama! 💜', 7000);
    },
    motion: function(nameOrIndex) {
      if (typeof nameOrIndex === 'number') {
        var m = availableMotions[nameOrIndex];
        if (m) return playMotion(m.groupName);
      } else if (typeof nameOrIndex === 'string') {
        return playMotion(nameOrIndex);
      }
      return playRandomMotion();
    },
    randomMotion: playRandomMotion,
    trigger: triggerMotionByKeyword,
    listMotions: function() {
      return availableMotions;
    },
    expression: function(name) {
      if (!name) return playRandomExpression();
      return playExpression(name);
    },
    listExpressions: function() {
      return availableExpressions;
    },
    stopAudio: stopAllAudio,
    reloadDP: tryLoadDP,
    dpUrl: function() {
      return DP_URL;
    }
  };

  getRelationshipStage();
})();
</script>

<style is:global>
  #safiya-root {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    user-select: none;
    -webkit-user-select: none;
  }

  #safiya-root svg {
    display: block;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════
     LAUNCHER PILL
  ═══════════════════════════════════════════════ */
