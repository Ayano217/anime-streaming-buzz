---
// ═══════════════════════════════════════════════════════════════
// COMMIT: feat: upgrade Safiya launcher pill, persistent memory,
// softer progression, and low-spam automation
// PATH: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// ✅ Premium rectangular floating pill launcher
// ✅ Stronger persistent memory with legacy migration
// ✅ Shy -> warm -> close progression tracking
// ✅ Girl-user bestie mode tracking
// ✅ Reduced automation / idle spam
// ✅ Link parsing + watch/product context memory
// ✅ Kept existing Live2D/chat features intact
// ═══════════════════════════════════════════════════════════════
---

<div id="safiya-root">

  <button id="safiya-head" class="s-head" aria-label="Chat with Safiya">
    <span class="s-head-ring"></span>

    <span class="s-head-inner">
      <span class="s-head-avatarbox">
        <span class="s-head-icon" id="s-head-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </span>
        <img id="s-head-dp" class="s-head-dp" src="" alt="Safiya" style="display:none;" />
        <span class="s-head-online"></span>
      </span>

      <span class="s-head-copy">
        <span class="s-head-title">💜 Safiya</span>
        <span class="s-head-sub">online</span>
      </span>
    </span>

    <span class="s-head-notify" id="safiya-notify">1</span>
  </button>

  <div id="safiya-bubble" class="s-bubble">
    <div class="s-bubble-avatar" id="s-bubble-dp-wrap">
      <img id="s-bubble-dp" class="s-bubble-dp" src="" alt="" style="display:none;" />
    </div>
    <div class="s-bubble-body">
      <div class="s-bubble-name">Safiya</div>
      <div class="s-bubble-text" id="s-bubble-text"></div>
    </div>
    <button class="s-bubble-x" id="s-bubble-x" aria-label="Dismiss">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="safiya-avatar" class="s-avatar" aria-hidden="true">
    <div class="s-avatar-glow"></div>
    <div class="s-avatar-inner">
      <canvas id="s-avatar-canvas"></canvas>
      <div id="s-avatar-fallback" class="s-avatar-fallback">
        <div class="s-avatar-fb-orb">
          <div class="s-avatar-fb-face">
            <div class="s-avatar-fb-eye s-avatar-fb-eye-l"></div>
            <div class="s-avatar-fb-eye s-avatar-fb-eye-r"></div>
            <div class="s-avatar-fb-mouth"></div>
          </div>
        </div>
        <div class="s-avatar-fb-name">Safiya</div>
      </div>
      <div id="s-avatar-loader" class="s-avatar-loader">
        <div class="s-avatar-spinner"></div>
      </div>
    </div>
    <div class="s-avatar-hint">💜 Touch me~</div>
  </div>

  <div id="safiya-chat" class="s-chat" aria-hidden="true">
    <header class="s-chat-head">
      <button class="s-chat-btn" id="s-back" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="s-chat-head-info">
        <div class="s-chat-head-avatar" id="s-chat-head-avatar">
          <span class="s-chat-head-avatar-letter" id="s-chat-head-letter">S</span>
          <img id="s-chat-head-dp" class="s-chat-head-dp" src="" alt="Safiya" style="display:none;" />
          <span class="s-chat-head-online"></span>
        </div>
        <div class="s-chat-head-text">
          <div class="s-chat-head-name">Safiya</div>
          <div class="s-chat-head-status" id="s-chat-status">Active now</div>
        </div>
      </div>

      <div class="s-chat-head-actions">
        <button class="s-chat-btn" id="s-min" aria-label="Minimize">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
        <button class="s-chat-btn s-chat-btn-close" id="s-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </header>

    <div class="s-chat-body" id="s-chat-body"></div>

    <div class="s-chat-input-bar">
      <button class="s-input-icon" aria-label="Add">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
      </button>
      <div class="s-input-wrap">
        <input type="text" id="s-input" placeholder="Message..." autocomplete="off" maxlength="500" />
        <button class="s-input-emoji" aria-label="Emoji">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </button>
      </div>
      <button class="s-send" id="s-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="safiya-mini" class="s-mini" aria-hidden="true">
    <div class="s-mini-avatar" id="s-mini-avatar-wrap">
      <span id="s-mini-letter">S</span>
      <img id="s-mini-dp" class="s-mini-dp" src="" alt="" style="display:none;" />
    </div>
    <span class="s-mini-name">Safiya</span>
    <span class="s-mini-new" id="s-mini-new">0</span>
    <button class="s-mini-x" id="s-mini-x" aria-label="Close">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

</div>

<script is:inline>
(function() {
  'use strict';

  // ═══════════════════════════════════════════════
  // ⚙️ MODEL CONFIG
  // ═══════════════════════════════════════════════
  var MODEL_PATH = '/live2d/safiya/izumi_illust.model3.json';
  var MODEL_FALLBACKS = [
    '/live2d/safiya/izumi_illust.model3.json',
    '/live2d/haru/haru_greeter_t05.model3.json',
  ];

  // ═══════════════════════════════════════════════
  // 🎤 VOICE LINES (optional)
  // ═══════════════════════════════════════════════
  var VOICE_LINES = {
    touch: [],
    greet: [],
    happy: [],
    shy: [],
    angry: [],
  };

  // ═══════════════════════════════════════════════
  // 🧠 STORAGE / MEMORY
  // ═══════════════════════════════════════════════
  var STORAGE_NS = 'safiya_v11';
  var LEGACY_MEMORY_KEY = 'safiya_memory';
  var DEVICE_KEY = STORAGE_NS + ':device_id';
  var MEMORY_PREFIX = STORAGE_NS + ':memory:';
  var INDEX_KEY = STORAGE_NS + ':index';
  var CREATOR_KEY = 'safiya_creator';

  var $ = function(id) { return document.getElementById(id); };
  var root = $('safiya-root'), head = $('safiya-head'), notify = $('safiya-notify');
  var bubble = $('safiya-bubble'), bubbleText = $('s-bubble-text'), bubbleX = $('s-bubble-x');
  var chat = $('safiya-chat'), chatBody = $('s-chat-body'), chatInput = $('s-input');
  var sendBtn = $('s-send'), backBtn = $('s-back'), minBtn = $('s-min'), closeBtn = $('s-close');
  var mini = $('safiya-mini'), miniX = $('s-mini-x'), miniNew = $('s-mini-new');
  var avatar = $('safiya-avatar'), avatarCanvas = $('s-avatar-canvas');
  var avatarFallback = $('s-avatar-fallback'), avatarLoader = $('s-avatar-loader');
  var statusText = $('s-chat-status');
  if (!root || !chat || !head || !bubble || !chatBody || !chatInput) return;

  function safeGet(key, fallback) {
    try {
      var raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch(e) {
      return fallback;
    }
  }

  function safeSet(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch(e) {}
  }

  function safeRemove(key) {
    try { localStorage.removeItem(key); } catch(e) {}
  }

  function getCookie(name) {
    try {
      var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()[\]\\/+^]/g, '\\$&') + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    } catch(e) {
      return '';
    }
  }

  function setCookie(name, value, days) {
    try {
      var maxAge = (days || 3650) * 24 * 60 * 60;
      document.cookie = name + '=' + encodeURIComponent(value) + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
    } catch(e) {}
  }

  function ensureArray(value) {
    return Array.isArray(value) ? value : [];
  }

  function trimArray(value, max) {
    var arr = ensureArray(value);
    if (arr.length <= max) return arr;
    return arr.slice(arr.length - max);
  }

  function createDeviceId() {
    return 'sf_' + Math.random().toString(36).slice(2, 12) + '_' + Date.now().toString(36);
  }

  function getDeviceId() {
    var fromStorage = '';
    var fromCookie = '';
    try { fromStorage = localStorage.getItem(DEVICE_KEY) || ''; } catch(e) {}
    fromCookie = getCookie(DEVICE_KEY);

    var id = fromStorage || fromCookie || '';
    if (!id) {
      id = createDeviceId();
    }

    try { localStorage.setItem(DEVICE_KEY, id); } catch(e) {}
    setCookie(DEVICE_KEY, id, 3650);

    return id;
  }

  var deviceId = getDeviceId();
  var memoryKey = MEMORY_PREFIX + deviceId;

  function normalizeMemory(raw) {
    var now = Date.now();
    var m = raw && typeof raw === 'object' ? raw : {};

    m.schemaVersion = 11;
    m.deviceId = deviceId;
    m.firstMet = m.firstMet || now;
    m.lastVisit = typeof m.lastVisit === 'number' ? m.lastVisit : 0;
    m.pageViews = typeof m.pageViews === 'number' ? m.pageViews : 0;
    m.visits = typeof m.visits === 'number' ? m.visits : 0;
    m.currentMood = typeof m.currentMood === 'string' ? m.currentMood : 'rude';
    m.chatHistory = trimArray(m.chatHistory, 700);
    m.userName = typeof m.userName === 'string' ? m.userName : '';
    m.updatedAt = now;

    if (!m.profile || typeof m.profile !== 'object') m.profile = {};
    if (!m.relationship || typeof m.relationship !== 'object') m.relationship = {};
    if (!m.behavior || typeof m.behavior !== 'object') m.behavior = {};
    if (!m.automation || typeof m.automation !== 'object') m.automation = {};

    var p = m.profile;
    p.userType = typeof p.userType === 'string' ? p.userType : 'unknown';
    p.prefLanguage = typeof p.prefLanguage === 'string' ? p.prefLanguage : 'en';
    p.favoriteAnime = typeof p.favoriteAnime === 'string' ? p.favoriteAnime : '';
    p.favoriteTags = trimArray(p.favoriteTags, 20);
    p.femaleSignals = typeof p.femaleSignals === 'number' ? p.femaleSignals : 0;
    p.maleSignals = typeof p.maleSignals === 'number' ? p.maleSignals : 0;
    p.nameUpdatedAt = typeof p.nameUpdatedAt === 'number' ? p.nameUpdatedAt : 0;
    p.lastSharedType = typeof p.lastSharedType === 'string' ? p.lastSharedType : '';
    p.firstSeenPath = typeof p.firstSeenPath === 'string' ? p.firstSeenPath : (location.pathname || '/');

    var r = m.relationship;
    r.userMessages = typeof r.userMessages === 'number' ? r.userMessages : 0;
    r.stageKey = typeof r.stageKey === 'string' ? r.stageKey : 'shy';
    r.stageLabel = typeof r.stageLabel === 'string' ? r.stageLabel : 'New';
    r.score = typeof r.score === 'number' ? r.score : 1;
    r.lastInteractionAt = typeof r.lastInteractionAt === 'number' ? r.lastInteractionAt : now;

    var b = m.behavior;
    b.pagesViewed = trimArray(b.pagesViewed, 80);
    b.animeClicked = trimArray(b.animeClicked, 50);
    b.productsClicked = trimArray(b.productsClicked, 50);
    b.watchHistory = trimArray(b.watchHistory, 40);
    b.savedVideos = trimArray(b.savedVideos, 40);
    b.sharedLinks = trimArray(b.sharedLinks, 40);
    b.scrollDepth = typeof b.scrollDepth === 'number' ? b.scrollDepth : 0;
    b.lastPage = typeof b.lastPage === 'string' ? b.lastPage : '';
    b.currentProduct = b.currentProduct && typeof b.currentProduct === 'object' ? b.currentProduct : null;
    b.currentAnime = b.currentAnime && typeof b.currentAnime === 'object' ? b.currentAnime : null;
    b.currentlyWatching = b.currentlyWatching && typeof b.currentlyWatching === 'object' ? b.currentlyWatching : null;

    var a = m.automation;
    a.chatOpen = typeof a.chatOpen === 'boolean' ? a.chatOpen : false;
    a.chatMinimized = typeof a.chatMinimized === 'boolean' ? a.chatMinimized : false;
    a.nudgesSentLifetime = typeof a.nudgesSentLifetime === 'number' ? a.nudgesSentLifetime : 0;
    a.lastNudgeAt = typeof a.lastNudgeAt === 'number' ? a.lastNudgeAt : 0;

    m.pageViews += 1;
    if (!m.lastVisit || now - m.lastVisit > 20 * 60 * 1000) {
      m.visits += 1;
    }
    m.lastVisit = now;

    return m;
  }

  function loadMemory() {
    var current = safeGet(memoryKey, null);
    var legacy = safeGet(LEGACY_MEMORY_KEY, null);
    var base = current || legacy || {};
    return normalizeMemory(base);
  }

  var memory = loadMemory();

  function persistMemory() {
    memory.updatedAt = Date.now();
    safeSet(memoryKey, memory);
    safeSet(LEGACY_MEMORY_KEY, memory);

    var index = safeGet(INDEX_KEY, []);
    if (!Array.isArray(index)) index = [];
    var exists = false;
    for (var i = 0; i < index.length; i++) {
      if (index[i] && index[i].deviceId === deviceId) {
        index[i].updatedAt = memory.updatedAt;
        exists = true;
        break;
      }
    }
    if (!exists) {
      index.push({ deviceId: deviceId, updatedAt: memory.updatedAt });
    }
    safeSet(INDEX_KEY, trimArray(index, 30));

    try { localStorage.setItem(DEVICE_KEY, deviceId); } catch(e) {}
    setCookie(DEVICE_KEY, deviceId, 3650);
  }

  var isCreator = false;
  try { isCreator = localStorage.getItem(CREATOR_KEY) === 'ayano-217'; } catch(e) {}

  var session = {
    startedAt: Date.now(),
    nudgesSent: 0,
    lastActiveAt: Date.now(),
    lastScrollAt: Date.now(),
    lastAutoAt: 0,
    didWelcome: false,
    productBubbleShown: false,
    saveBubbleShown: false
  };

  function countUserMessages() {
    var count = 0;
    for (var i = 0; i < memory.chatHistory.length; i++) {
      if (memory.chatHistory[i] && memory.chatHistory[i].sender === 'me') count++;
    }
    return count;
  }

  function getRelationshipStage() {
    var msgCount = countUserMessages();
    memory.relationship.userMessages = msgCount;

    var score = memory.visits + Math.floor(msgCount / 4) + Math.floor(memory.pageViews / 8);
    if (memory.behavior.productsClicked.length > 0) score += 1;
    if (memory.behavior.watchHistory.length > 2) score += 1;
    if (score < 1) score = 1;

    var isGirlUser = memory.profile.userType === 'girl';
    var key = 'shy';
    var label = 'New';

    if (isGirlUser) {
      if (score <= 3) { key = 'shy'; label = 'Getting comfy'; }
      else if (score <= 10) { key = 'warm'; label = 'Warm'; }
      else if (score <= 20) { key = 'friend'; label = 'Bestie mode'; }
      else if (score <= 50) { key = 'bestie'; label = 'Close bestie'; }
      else { key = 'ride'; label = 'Ride or die'; }
    } else {
      if (score <= 3) { key = 'shy'; label = 'New'; }
      else if (score <= 10) { key = 'warm'; label = 'Comfortable'; }
      else if (score <= 20) { key = 'friend'; label = 'Friendly'; }
      else if (score <= 50) { key = 'close'; label = 'Close'; }
      else { key = 'attached'; label = 'Very close'; }
    }

    memory.relationship.score = score;
    memory.relationship.stageKey = key;
    memory.relationship.stageLabel = label;
    memory.relationship.lastInteractionAt = Date.now();
    persistMemory();

    return {
      key: key,
      label: label,
      score: score,
      isGirlUser: isGirlUser,
      userMessages: msgCount
    };
  }

  function setMood(m) {
    memory.currentMood = m || 'rude';
    persistMemory();
    triggerMoodMotion(memory.currentMood);
  }

  function rememberLanguageFromText(text) {
    if (!text) return;
    var hasBanglaUnicode = /[\u0980-\u09FF]/.test(text);
    var romanBangla = /\b(ami|amar|tumi|tomar|kemon|acho|bhalo|na|ki|keno|hobe|lagche|valo|dekho|achi|bolo)\b/i.test(text);
    if (hasBanglaUnicode || romanBangla) memory.profile.prefLanguage = 'bn';
    else memory.profile.prefLanguage = 'en';
  }

  function detectUserType(text) {
    if (!text) return;
    var low = text.toLowerCase();

    if (/\b(i am a girl|i'm a girl|i am girl|i'm girl|i am female|i'm female|as a girl|ami meye|ami girl)\b/i.test(low)) {
      memory.profile.userType = 'girl';
      memory.profile.femaleSignals += 1;
    } else if (/\b(i am a boy|i'm a boy|i am male|i'm male|ami chele|ami boy)\b/i.test(low)) {
      if (memory.profile.userType !== 'girl') memory.profile.userType = 'boy';
      memory.profile.maleSignals += 1;
    }
  }

  function detectName(text) {
    if (!text) return '';

    var patterns = [
      /(?:my\s+name\s+is|i\s+am|i'm|call\s+me|name'?s|the\s+name'?s)\s+([a-z][a-zA-Z0-9_-]{1,19})/i,
      /(?:amar\s+nam\s+|ami\s+)([a-z][a-zA-Z0-9_-]{1,19})/i
    ];

    var blockList = /^(tumi|tomar|amar|ami|apni|apnar|here|home|going|coming|good|bad|fine|ok|okay|sure|the|and|but|from|will|would|could|should|maybe|really|very|too|yes|no|not|nice|cool|great|awesome|thank|hello|hi|hey|bye|safiya|ayano|user|test|kemon|acho|kotha|bolchi|jano|jani|dekho|bhalo|kharap|khub|onek|sob|kisu|kichu|eta|ota|ki|kina|hobe|hoye|hoyeche|korbo|korchi|korche|kore|korte|dhonnobad|please|thanks)$/i;

    for (var i = 0; i < patterns.length; i++) {
      var match = text.match(patterns[i]);
      if (match && match[1]) {
        var rawName = match[1].replace(/[_-]+/g, ' ').trim();
        if (!rawName || rawName.length < 2 || rawName.length > 20) continue;
        if (blockList.test(rawName)) continue;

        var parts = rawName.split(/\s+/);
        var normalized = [];
        for (var p = 0; p < parts.length; p++) {
          var part = parts[p];
          if (!part) continue;
          normalized.push(part.charAt(0).toUpperCase() + part.slice(1).toLowerCase());
        }
        var finalName = normalized.join(' ').slice(0, 24);
        if (!finalName) continue;

        memory.userName = finalName;
        memory.profile.nameUpdatedAt = Date.now();
        persistMemory();
        return finalName;
      }
    }

    return '';
  }

  function detectFavoriteAnime(text) {
    if (!text) return;
    var match = text.match(/(?:my\s+favou?rite\s+anime\s+is|favorite\s+anime\s+is|favourite\s+anime\s+is|amar\s+favorite\s+anime\s+)([a-zA-Z0-9 .:'!?\-]{2,60})/i);
    if (match && match[1]) {
      var fav = match[1].replace(/[.,!?]+$/, '').trim();
      if (fav.length >= 2 && fav.length <= 60) {
        memory.profile.favoriteAnime = fav;
      }
    }
  }

  function extractUrls(text) {
    if (!text) return [];
    var matches = text.match(/https?:\/\/[^\s<>"']+/gi) || [];
    return matches.slice(0, 5);
  }

  function extractRelativeSiteLinks(text) {
    if (!text) return [];
    var matches = text.match(/\/(?:anime|product|reels)\/[a-zA-Z0-9._~:/?#[\]@!$&'()*+,;=%-]+/g) || [];
    return matches.slice(0, 5);
  }

  function parseSharedLink(url) {
    try {
      var full = url;
      if (url.indexOf('/') === 0) full = location.origin + url;
      var u = new URL(full);
      var host = (u.hostname || '').replace(/^www\./, '').toLowerCase();
      var path = u.pathname || '/';
      var info = {
        url: url,
        host: host,
        path: path,
        type: 'link',
        internalType: '',
        label: 'shared link',
        id: '',
        slug: ''
      };

      var thisHost = (location.hostname || '').replace(/^www\./, '').toLowerCase();
      if (!host || host === thisHost) {
        if (path.indexOf('/product/') === 0) {
          info.type = 'product';
          info.internalType = 'product';
          info.label = 'shared product';
          info.id = path.replace('/product/', '').replace(/\/+$/, '');
        } else if (path.indexOf('/anime/') === 0) {
          info.type = 'anime';
          info.internalType = 'anime';
          info.label = 'shared anime';
          info.slug = path.replace('/anime/', '').replace(/\/+$/, '');
        } else if (path.indexOf('/reels/') === 0) {
          info.type = 'video';
          info.internalType = 'reels';
          info.label = 'shared reel';
          info.id = path.replace('/reels/', '').replace(/\/+$/, '');
        }
        return info;
      }

      if (/youtube\.com|youtu\.be/.test(host)) {
        info.type = 'video';
        info.label = 'shared video';
        info.id = u.searchParams.get('v') || (host.indexOf('youtu.be') !== -1 ? path.replace(/\//g, '') : '');
      } else if (/facebook\.com|fb\.watch/.test(host)) {
        info.type = 'social';
        info.label = 'shared social video';
      } else if (/amazon\./.test(host)) {
        info.type = 'product';
        info.label = 'shared product';
      } else if (/instagram\.com|tiktok\.com|x\.com|twitter\.com/.test(host)) {
        info.type = 'social';
        info.label = 'shared social link';
      }

      return info;
    } catch(e) {
      return {
        url: url,
        host: '',
        path: '',
        type: 'link',
        internalType: '',
        label: 'shared link',
        id: '',
        slug: ''
      };
    }
  }

  function rememberSharedLinks(text) {
    var urls = extractUrls(text);
    var rel = extractRelativeSiteLinks(text);
    var combined = urls.concat(rel);
    if (!combined.length) return [];

    var parsed = [];
    for (var i = 0; i < combined.length; i++) {
      var info = parseSharedLink(combined[i]);
      parsed.push(info);
      memory.behavior.sharedLinks.push({
        url: info.url,
        type: info.type,
        internalType: info.internalType,
        id: info.id,
        slug: info.slug,
        time: Date.now()
      });
      memory.profile.lastSharedType = info.type;
    }

    memory.behavior.sharedLinks = trimArray(memory.behavior.sharedLinks, 40);
    persistMemory();
    return parsed;
  }

  function analyzeUserText(text) {
    rememberLanguageFromText(text);
    detectUserType(text);
    detectName(text);
    detectFavoriteAnime(text);
