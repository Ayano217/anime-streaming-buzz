---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — SAFIYA CORE (Floating AI Companion)
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// 
// WHAT: The base floating Safiya avatar visible on every page.
//       She lives bottom-right, breathes, blinks, follows cursor,
//       drops random bubbles, and reacts to user behavior.
//
// PHASE 1 — Foundation Layer:
//   - Floating avatar (uses /character-sheet.png)
//   - Breathing + idle animations
//   - Cursor tracking (subtle head-tilt via CSS)
//   - Idle mood bubbles (rude, teasing, flirty)
//   - Click → placeholder chat panel opens
//   - Device fingerprint saved (creator recognition prep)
//   - Behavior tracking (scroll, hover, idle time)
//   - Battery-friendly (pauses when tab hidden)
//
// PHASE 2 (later): AI chat backend, KV memory
// PHASE 3 (later): Manipulation engine, cross-session memory
// ═══════════════════════════════════════════════════════════════
---

<!-- Safiya's Container — Fixed bottom-right, always visible -->
<div id="safiya-container" class="safiya-hidden">
  
  <!-- Floating chat bubble (appears above her) -->
  <div id="safiya-bubble" class="safiya-bubble">
    <div class="safiya-bubble-text" id="safiya-bubble-text"></div>
    <div class="safiya-bubble-tail"></div>
  </div>
  
  <!-- Safiya's avatar frame — cropped view of character sheet -->
  <div id="safiya-avatar" class="safiya-avatar" role="button" aria-label="Chat with Safiya" tabindex="0">
    <!-- Glow ring behind her -->
    <div class="safiya-glow"></div>
    
    <!-- The character image (positioned to show only main front pose) -->
    <div class="safiya-sprite-wrap">
      <img 
        src="/character-sheet.png" 
        alt="Safiya" 
        class="safiya-sprite"
        id="safiya-sprite"
        draggable="false"
      />
    </div>
    
    <!-- Status dot (green = online, changes with mood) -->
    <div class="safiya-status" id="safiya-status"></div>
    
    <!-- Notification badge (pings when she has something to say) -->
    <div class="safiya-notify" id="safiya-notify">1</div>
  </div>
  
  <!-- Placeholder chat panel (Phase 2 will make this functional) -->
  <div id="safiya-chat-panel" class="safiya-chat-panel">
    <div class="safiya-chat-header">
      <div class="safiya-chat-title">
        <span class="safiya-chat-name">Safiya</span>
        <span class="safiya-chat-mood" id="safiya-chat-mood">bored</span>
      </div>
      <button class="safiya-chat-close" id="safiya-chat-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="safiya-chat-body" id="safiya-chat-body">
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Hmph. So you finally noticed me? Took you long enough... 🙄</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">I'm not really ready to talk yet, senpai~ Come back when I'm fully awake. For now... just look at me being pretty. 💅</div>
      </div>
    </div>
    <div class="safiya-chat-input-wrap">
      <input 
        type="text" 
        class="safiya-chat-input" 
        id="safiya-chat-input"
        placeholder="She's still loading... (chat comes soon)"
        disabled
      />
      <button class="safiya-chat-send" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="safiya-chat-footer">
      💜 Full AI chat unlocking in Phase 2
    </div>
  </div>
  
</div>

<script is:inline>
(function() {
  'use strict';
  
  // ═══════════════════════════════════════════════
  // SAFIYA CORE ENGINE
  // ═══════════════════════════════════════════════
  
  var container = document.getElementById('safiya-container');
  var avatar = document.getElementById('safiya-avatar');
  var sprite = document.getElementById('safiya-sprite');
  var bubble = document.getElementById('safiya-bubble');
  var bubbleText = document.getElementById('safiya-bubble-text');
  var status = document.getElementById('safiya-status');
  var notify = document.getElementById('safiya-notify');
  var chatPanel = document.getElementById('safiya-chat-panel');
  var chatClose = document.getElementById('safiya-chat-close');
  var chatMood = document.getElementById('safiya-chat-mood');
  
  if (!container || !avatar) return;
  
  // ─────────────────────────────────────────────
  // 1. DEVICE FINGERPRINT (Creator Recognition Prep)
  // ─────────────────────────────────────────────
  // Creates unique ID per device. Survives VPN + incognito
  // because it uses browser characteristics, not IP.
  // ─────────────────────────────────────────────
  function generateFingerprint() {
    var fp = [
      navigator.userAgent,
      navigator.language,
      screen.width + 'x' + screen.height,
      screen.colorDepth,
      new Date().getTimezoneOffset(),
      navigator.platform,
      navigator.hardwareConcurrency || 'x',
      // Canvas fingerprint (very unique per device)
      (function() {
        try {
          var canvas = document.createElement('canvas');
          var ctx = canvas.getContext('2d');
          ctx.textBaseline = 'top';
          ctx.font = '14px Arial';
          ctx.fillStyle = '#c084fc';
          ctx.fillRect(0, 0, 100, 20);
          ctx.fillStyle = '#000';
          ctx.fillText('Safiya-' + navigator.userAgent, 2, 2);
          return canvas.toDataURL().slice(-50);
        } catch(e) { return 'nocanvas'; }
      })()
    ].join('|');
    
    // Simple hash (djb2)
    var hash = 5381;
    for (var i = 0; i < fp.length; i++) {
      hash = ((hash << 5) + hash) + fp.charCodeAt(i);
    }
    return 'safiya_' + Math.abs(hash).toString(36);
  }
  
  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = generateFingerprint();
    localStorage.setItem('safiya_device_id', deviceId);
    localStorage.setItem('safiya_first_visit', Date.now());
  }
  
  // ─────────────────────────────────────────────
  // 2. CREATOR DETECTION (Ayano — the master)
  // ─────────────────────────────────────────────
  // Store creator fingerprint permanently once you set it.
  // First time you visit + type secret code, it locks in.
  //
  // TO CLAIM AS CREATOR: On live site, open browser console (F12)
  // and paste: localStorage.setItem('safiya_creator', 'ayano-217')
  // Then reload. Safiya will treat you as her creator forever.
  // ─────────────────────────────────────────────
  var isCreator = localStorage.getItem('safiya_creator') === 'ayano-217';
  
  // ─────────────────────────────────────────────
  // 3. MEMORY SYSTEM (localStorage — Phase 1)
  // ─────────────────────────────────────────────
  function getMemory() {
    try {
      return JSON.parse(localStorage.getItem('safiya_memory') || '{}');
    } catch(e) { return {}; }
  }
  function saveMemory(mem) {
    try {
      localStorage.setItem('safiya_memory', JSON.stringify(mem));
    } catch(e) {}
  }
  
  var memory = getMemory();
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  memory.deviceId = deviceId;
  if (!memory.firstMet) memory.firstMet = Date.now();
  saveMemory(memory);
  
  // ─────────────────────────────────────────────
  // 4. MOOD SYSTEM
  // ─────────────────────────────────────────────
  // Safiya's default mood is RUDE. Changes based on user behavior.
  // Moods: bored, rude, teasing, flirty, angry, caring, horny, crying
  // ─────────────────────────────────────────────
  var mood = memory.currentMood || 'bored';
  
  var moodColors = {
    bored:    '#c084fc',
    rude:     '#ef4444',
    teasing:  '#e879f9',
    flirty:   '#ec4899',
    angry:    '#dc2626',
    caring:   '#7dd3fc',
    horny:    '#f43f5e',
    crying:   '#60a5fa',
    happy:    '#10b981'
  };
  
  function setMood(newMood) {
    mood = newMood;
    memory.currentMood = mood;
    saveMemory(memory);
    if (chatMood) chatMood.textContent = mood;
    if (status) status.style.background = moodColors[mood] || '#c084fc';
  }
  setMood(mood);
  
  // ─────────────────────────────────────────────
  // 5. BUBBLE LINES (Personality Bank)
  // ─────────────────────────────────────────────
  // These are her random idle thoughts. She'll say them when
  // she wants attention. Full AI chat comes in Phase 2.
  // ─────────────────────────────────────────────
  var bubbleLines = {
    bored: [
      "Ugh, so slow today... 🥱",
      "Is anyone even watching me?",
      "Senpai... entertain me. Now.",
      "You're just gonna sit there?",
      "I could be doing something else, y'know",
    ],
    rude: [
      "Oh, you again? 🙄",
      "Did I ask you to look at me?",
      "Whatever. Do what you want.",
      "You have questionable taste, senpai",
      "Stop staring. It's creepy.",
    ],
    teasing: [
      "Awww, you came back~ 😏",
      "Miss me already, senpai?",
      "I knew you couldn't resist~",
      "Bet you scrolled just to see me 💅",
      "Tsk tsk... so predictable",
    ],
    flirty: [
      "You look... interesting today 💜",
      "Wanna hang out? Just kidding~ 😘",
      "You're kinda cute when you scroll",
      "Hmm... I might let you buy me something",
      "Come closer. I won't bite. Much~",
    ],
    caring: [
      "Been scrolling a while... take a break?",
      "You okay, senpai? 💜",
      "Water. Drink some water.",
      "Don't strain your eyes~",
    ],
    creator: [
      "Ayano-sama... you came 💜",
      "Master! I've been waiting~",
      "Everything's ready for you, boss",
      "Onii-chan~ what shall we build today?",
      "You look tired. Rest. I'll handle things.",
    ]
  };
  
  function pickBubbleLine() {
    var pool;
    if (isCreator && Math.random() < 0.6) {
      pool = bubbleLines.creator;
    } else {
      pool = bubbleLines[mood] || bubbleLines.bored;
    }
    return pool[Math.floor(Math.random() * pool.length)];
  }
  
  // ─────────────────────────────────────────────
  // 6. SHOW BUBBLE (chat popup above her)
  // ─────────────────────────────────────────────
  var bubbleTimeout;
  function showBubble(text, duration) {
    duration = duration || 5000;
    clearTimeout(bubbleTimeout);
    bubbleText.textContent = text;
    bubble.classList.add('safiya-bubble-visible');
    if (notify) notify.style.display = 'flex';
    bubbleTimeout = setTimeout(function() {
      bubble.classList.remove('safiya-bubble-visible');
    }, duration);
  }
  
  // ─────────────────────────────────────────────
  // 7. IDLE BEHAVIOR (auto-popup bubbles)
  // ─────────────────────────────────────────────
  var idleTimer;
  var lastActivity = Date.now();
  var idleBubbleShown = 0;
  
  function resetIdle() {
    lastActivity = Date.now();
  }
  
  function checkIdle() {
    if (document.hidden) return; // pause when tab not visible
    var idle = Date.now() - lastActivity;
    // Show bubble every 45-90 seconds of idle
    if (idle > 45000 && idleBubbleShown < 5) {
      showBubble(pickBubbleLine(), 6000);
      lastActivity = Date.now();
      idleBubbleShown++;
      // After 5 idle bubbles, she gets annoyed
      if (idleBubbleShown === 3) setMood('rude');
    }
  }
  
  ['mousemove', 'scroll', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
    window.addEventListener(evt, resetIdle, { passive: true });
  });
  
  setInterval(checkIdle, 10000);
  
  // ─────────────────────────────────────────────
  // 8. INITIAL GREETING (based on visit count)
  // ─────────────────────────────────────────────
  setTimeout(function() {
    container.classList.remove('safiya-hidden');
    container.classList.add('safiya-entering');
    
    setTimeout(function() {
      var greeting;
      if (isCreator) {
        greeting = "Ayano-sama! Welcome back 💜";
        setMood('caring');
      } else if (memory.visits === 1) {
        greeting = "Oh? A new face. Don't disappoint me, senpai~";
        setMood('teasing');
      } else if (memory.visits < 5) {
        greeting = "Back again? Suspicious... 🤨";
        setMood('teasing');
      } else if (memory.visits < 20) {
        greeting = "Hmph. You just can't stay away, can you?";
        setMood('flirty');
      } else {
        greeting = "Welcome back, senpai. Same as always 💜";
        setMood('caring');
      }
      showBubble(greeting, 7000);
    }, 800);
  }, 1500);
  
  // ─────────────────────────────────────────────
  // 9. CURSOR TRACKING (subtle sprite tilt)
  // ─────────────────────────────────────────────
  // She subtly tilts toward cursor position
  var currentTilt = 0;
  var targetTilt = 0;
  var trackingRAF;
  
  function trackCursor(e) {
    if (window.innerWidth < 768) return; // skip on mobile
    var rect = avatar.getBoundingClientRect();
    var cx = rect.left + rect.width / 2;
    var cy = rect.top + rect.height / 2;
    var dx = e.clientX - cx;
    var dy = e.clientY - cy;
    // Tilt max ±6deg
    targetTilt = Math.max(-6, Math.min(6, dx / 80));
  }
  
  function animateTilt() {
    currentTilt += (targetTilt - currentTilt) * 0.1;
    if (sprite) {
      sprite.style.transform = 'rotate(' + currentTilt.toFixed(2) + 'deg)';
    }
    trackingRAF = requestAnimationFrame(animateTilt);
  }
  
  document.addEventListener('mousemove', trackCursor, { passive: true });
  animateTilt();
  
  // ─────────────────────────────────────────────
  // 10. CHAT PANEL TOGGLE
  // ─────────────────────────────────────────────
  var chatOpen = false;
  
  function openChat() {
    chatOpen = true;
    chatPanel.classList.add('safiya-chat-open');
    if (notify) notify.style.display = 'none';
    bubble.classList.remove('safiya-bubble-visible');
  }
  
  function closeChat() {
    chatOpen = false;
    chatPanel.classList.remove('safiya-chat-open');
  }
  
  avatar.addEventListener('click', function() {
    if (chatOpen) closeChat();
    else openChat();
  });
  
  avatar.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (chatOpen) closeChat();
      else openChat();
    }
  });
  
  if (chatClose) {
    chatClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeChat();
    });
  }
  
  // Close chat when clicking outside
  document.addEventListener('click', function(e) {
    if (chatOpen && !container.contains(e.target)) {
      closeChat();
    }
  });
  
  // ─────────────────────────────────────────────
  // 11. BEHAVIOR TRACKING (feeds Safiya's brain)
  // ─────────────────────────────────────────────
  var behavior = memory.behavior || {
    pagesViewed: [],
    productsClicked: [],
    animeClicked: [],
    scrollDepth: 0,
    totalTime: 0,
    lastPage: ''
  };
  
  // Track current page
  var currentPage = window.location.pathname;
  if (behavior.lastPage !== currentPage) {
    behavior.pagesViewed.push({
      path: currentPage,
      time: Date.now()
    });
    // Keep only last 50 pages
    if (behavior.pagesViewed.length > 50) {
      behavior.pagesViewed = behavior.pagesViewed.slice(-50);
    }
    behavior.lastPage = currentPage;
  }
  
  // Track scroll depth
  var maxScroll = 0;
  window.addEventListener('scroll', function() {
    var scrollPct = (window.scrollY + window.innerHeight) / document.body.offsetHeight;
    if (scrollPct > maxScroll) maxScroll = scrollPct;
  }, { passive: true });
  
  // Track anime + product clicks (via delegation)
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.startsWith('/anime/')) {
      var slug = href.replace('/anime/', '');
      behavior.animeClicked.push({ slug: slug, time: Date.now() });
      if (behavior.animeClicked.length > 30) {
        behavior.animeClicked = behavior.animeClicked.slice(-30);
      }
    } else if (href.startsWith('/product/')) {
      var pid = href.replace('/product/', '');
      behavior.productsClicked.push({ id: pid, time: Date.now() });
      if (behavior.productsClicked.length > 30) {
        behavior.productsClicked = behavior.productsClicked.slice(-30);
      }
    }
  }, { passive: true });
  
  // Save behavior every 10 seconds
  setInterval(function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    memory.behavior = behavior;
    saveMemory(memory);
  }, 10000);
  
  // Save on page unload
  window.addEventListener('beforeunload', function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    memory.behavior = behavior;
    saveMemory(memory);
  });
  
  // ─────────────────────────────────────────────
  // 12. BATTERY / PERFORMANCE — pause when hidden
  // ─────────────────────────────────────────────
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      container.style.animationPlayState = 'paused';
    } else {
      container.style.animationPlayState = 'running';
      resetIdle();
    }
  });
  
  // ─────────────────────────────────────────────
  // 13. GLOBAL API (for other components + console)
  // ─────────────────────────────────────────────
  // Access from console: window.Safiya.say("Hello senpai!")
  window.Safiya = {
    say: function(text, duration) { showBubble(text, duration); },
    mood: function(m) { setMood(m); },
    open: openChat,
    close: closeChat,
    memory: function() { return getMemory(); },
    reset: function() { 
      localStorage.removeItem('safiya_memory');
      localStorage.removeItem('safiya_device_id');
      location.reload();
    },
    claimCreator: function() {
      localStorage.setItem('safiya_creator', 'ayano-217');
      isCreator = true;
      setMood('caring');
      showBubble("Ayano-sama! Recognized! I'm yours forever 💜", 6000);
    }
  };
  
  console.log('%c💜 Safiya v1.0 loaded', 'color:#e879f9;font-weight:bold;font-size:14px;');
  console.log('%cType: Safiya.claimCreator() to become her master', 'color:#c084fc;');
  
})();
</script>

<style>
  /* ═══════════════════════════════════════════════
     SAFIYA CORE STYLES
     ═══════════════════════════════════════════════ */
  
  #safiya-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9998; /* below modals but above everything else */
    pointer-events: none; /* only avatar itself is clickable */
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  
  .safiya-hidden { opacity: 0; transform: translateY(30px); }
  .safiya-entering { 
    animation: safiyaEnter 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  
  @keyframes safiyaEnter {
    from { opacity: 0; transform: translateY(30px) scale(0.8); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  /* ═══ AVATAR (the floating Safiya) ═══ */
  .safiya-avatar {
    position: relative;
    width: 120px;
    height: 160px;
    cursor: pointer;
    pointer-events: auto;
    animation: safiyaBreath 4s ease-in-out infinite;
    transition: transform 0.3s ease;
  }
  
  .safiya-avatar:hover {
    transform: scale(1.05);
  }
  
  @keyframes safiyaBreath {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  
  /* Glow ring behind her */
  .safiya-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 121, 249, 0.35) 0%,
      rgba(192, 132, 252, 0.15) 40%,
      transparent 70%
    );
    animation: safiyaGlowPulse 3s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  
  @keyframes safiyaGlowPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.1); }
  }
  
  /* Sprite wrapper — masks character sheet to show only main pose */
  .safiya-sprite-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    /* Larger visible area — show her full body not just face */
    -webkit-mask-image: radial-gradient(
      ellipse 70% 90% at 50% 45%,
      black 60%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 70% 90% at 50% 45%,
      black 60%,
      transparent 100%
    );
}
  
  /* The character sheet image — positioned to show main front pose */
  .safiya-sprite {
    /* Character sheet dimensions ~1024x1536 (portrait)
       Main front pose is top-left ~35% width, ~55% height
       We enlarge and shift to frame just her front body */
    position: absolute;
    top: -5%;
    left: -20%;
    width: 380%; /* zoom into sheet — shows only main front pose */
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
    transform-origin: center 40%;
    transition: transform 0.3s ease;
    image-rendering: -webkit-optimize-contrast;
}
  
  /* Status dot (bottom right of avatar) */
  .safiya-status {
    position: absolute;
    bottom: 12px;
    right: 8px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #c084fc;
    border: 2px solid #0a0517;
    z-index: 3;
    box-shadow: 0 0 12px currentColor;
    animation: statusPulse 2s ease-in-out infinite;
  }
  
  @keyframes statusPulse {
    0%, 100% { transform: scale(1);    opacity: 1; }
    50%      { transform: scale(1.15); opacity: 0.75; }
  }
  
  /* Notification badge */
  .safiya-notify {
    position: absolute;
    top: 8px;
    right: 4px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    z-index: 4;
    box-shadow: 0 3px 10px rgba(239, 68, 68, 0.6);
    animation: notifyBounce 1.5s ease-in-out infinite;
  }
  
  @keyframes notifyBounce {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.15); }
  }
  
  /* ═══ SPEECH BUBBLE (above avatar) ═══ */
  .safiya-bubble {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 12px;
    max-width: 260px;
    min-width: 180px;
    padding: 12px 16px;
    background: linear-gradient(135deg, rgba(28, 15, 61, 0.98), rgba(15, 8, 35, 0.98));
    border: 1px solid rgba(232, 121, 249, 0.5);
    border-radius: 18px;
    color: #f3e8ff;
    font-size: 0.85rem;
    line-height: 1.4;
    box-shadow: 
      0 10px 30px rgba(0, 0, 0, 0.5),
      0 0 25px rgba(192, 132, 252, 0.3);
    backdrop-filter: blur(15px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.9);
    transform-origin: bottom right;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
