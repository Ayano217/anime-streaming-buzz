---
// ═══════════════════════════════════════════════════════════════
// AniTube Buzz — SAFIYA CORE v4 (Live2D Widget Integration)
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// 
// APPROACH: Uses stevenjoezhang/live2d-widget as the character body
// (loaded from CDN, MIT licensed) + our custom brain layer on top.
//
// MODEL: epsilon2.1 — cute full body anime girl
// PERSONALITY: Rude, angry, manipulative, flirty
//
// FEATURES:
//   ✅ Real Live2D VTuber animation (breathing, blinking, hair sway)
//   ✅ Cursor tracking (auto by widget)
//   ✅ Draggable (widget built-in)
//   ✅ Custom speech bubbles with rude/manipulative lines
//   ✅ Custom chat panel (placeholder for Phase 2 AI)
//   ✅ Mood system with expression changes
//   ✅ Device fingerprint + memory
//   ✅ Behavior tracking (products/anime clicks)
//   ✅ Creator recognition
//   ✅ Never blocks up-button
// ═══════════════════════════════════════════════════════════════
---

<!-- Custom Safiya overlay (bubble + chat panel + status) -->
<div id="safiya-overlay">
  
  <!-- Speech bubble -->
  <div id="safiya-bubble" class="safiya-bubble">
    <div class="safiya-bubble-text" id="safiya-bubble-text"></div>
    <div class="safiya-bubble-tail"></div>
  </div>
  
  <!-- Chat panel -->
  <div id="safiya-chat-panel" class="safiya-chat-panel">
    <div class="safiya-chat-header">
      <div class="safiya-chat-title">
        <span class="safiya-chat-name">Safiya</span>
        <span class="safiya-chat-mood" id="safiya-chat-mood">rude</span>
      </div>
      <button class="safiya-chat-close" id="safiya-chat-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="safiya-chat-body" id="safiya-chat-body">
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Ugh, why did you click me? Do I look like your personal entertainment? 🙄</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">Fine. Since you're here... browse. Maybe buy something. Prove you're not completely useless.</div>
      </div>
      <div class="safiya-msg safiya-msg-her">
        <div class="safiya-msg-text">My AI brain unlocks soon, senpai~ Then I can really mess with you 😏💅</div>
      </div>
    </div>
    <div class="safiya-chat-input-wrap">
      <input 
        type="text" 
        class="safiya-chat-input" 
        id="safiya-chat-input"
        placeholder="She's not ready to chat yet..."
        disabled
      />
      <button class="safiya-chat-send" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="safiya-chat-footer">
      💜 Full AI chat unlocking in Phase 2
    </div>
  </div>
  
  <!-- Small floating badge (shows mood + notification) -->
  <div id="safiya-badge">
    <div class="safiya-status-dot" id="safiya-status"></div>
    <div class="safiya-notify" id="safiya-notify">1</div>
  </div>
  
</div>

<!-- Live2D Widget config MUST be set BEFORE loading the script -->
<script is:inline>
  // Widget configuration — must exist before autoload.js runs
  window.live2d_settings = {
    // Model selection — epsilon2.1 (cute anime girl full body)
    modelId: 5,        // epsilon2.1 model index in CDN
    modelTexturesId: 0,
    
    // Position + size
    canvasWidth: 220,
    canvasHeight: 320,
    modelStorage: false,
    
    // Waifu tips (we override with our own bubbles below)
    waifuSize: '220x320',
    waifuTipsSize: '270x70',
    waifuFontSize: '12px',
    waifuToolFont: '14px',
    waifuToolLine: '20px',
    waifuToolTop: '0px',
    waifuMinWidth: '768px',
    waifuEdgeSide: 'right:60',   // 60px from right edge (avoids up-button at right:24)
    waifuDraggable: 'axis-x',
    waifuDraggableRevert: true,
    
    // Disable widget's default UI (we use our own)
    'display.hidden': false,
    'display.superMode': true,
    'display.hOffset': 0,
    'display.vOffset': -20,
    
    // Disable widget's default tools (home, msg, switch etc) — we build custom
    'menus.switchModel': false,
    'menus.switchTextures': false,
    'menus.photo': false,
    'menus.info': false,
    'menus.quit': true,     // keep quit so users can hide her if needed
    
    // Disable default waifu tips (we push our own)
    'tips.idleMsg.enable': false,
    'tips.hoverTips.enable': false,
    'tips.holidayTips.enable': false,
    'tips.userTips.enable': false,
    'tips.selectorTips.enable': false,
    'tips.copyTips.enable': false,
    
    // Console log messages
    'cubism2Path': 'https://fastly.jsdelivr.net/npm/live2d-widget@3.x/lib/L2Dwidget.min.js',
    'cubism5Path': 'https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js',
  };
</script>

<!-- Live2D Widget — CDN loaded, MIT licensed -->
<link rel="stylesheet" href="https://fastly.jsdelivr.net/npm/live2d-widget@3.x/lib/L2Dwidget.min.css">
<script is:inline src="https://fastly.jsdelivr.net/npm/live2d-widget@3.x/lib/L2Dwidget.min.js"></script>

<script is:inline>
(function() {
  'use strict';
  
  var overlay = document.getElementById('safiya-overlay');
  var bubble = document.getElementById('safiya-bubble');
  var bubbleText = document.getElementById('safiya-bubble-text');
  var status = document.getElementById('safiya-status');
  var notify = document.getElementById('safiya-notify');
  var chatPanel = document.getElementById('safiya-chat-panel');
  var chatClose = document.getElementById('safiya-chat-close');
  var chatMood = document.getElementById('safiya-chat-mood');
  var badge = document.getElementById('safiya-badge');
  
  // ═══════════════════════════════════════════════
  // INITIALIZE LIVE2D WIDGET (epsilon2.1 model)
  // ═══════════════════════════════════════════════
  function initWidget() {
    if (typeof L2Dwidget === 'undefined') {
      console.warn('[Safiya] L2Dwidget not loaded');
      return;
    }
    
    try {
      L2Dwidget.init({
        model: {
          // epsilon2.1 model — cute anime girl full body
          jsonPath: 'https://fastly.jsdelivr.net/gh/fghrsh/live2d_api/model/Epsilon2.1/index.json',
          scale: 1,
        },
        display: {
          position: 'right',
          width: 200,
          height: 300,
          hOffset: 60,   // 60px from right (avoid up-button)
          vOffset: 0,
        },
        mobile: {
          show: true,
          scale: 0.7,
          motion: true,
        },
        react: {
          opacityDefault: 0.9,
          opacityOnHover: 1,
        },
        dialog: {
          enable: false,  // we use our own bubbles
          hitokoto: false,
        },
        log: false,
      });
      
      console.log('%c💜 Safiya Live2D (epsilon2.1) initialized', 'color:#e879f9;font-weight:bold;');
    } catch(e) {
      console.error('[Safiya] Widget init failed:', e);
    }
  }
  
  // Wait for L2Dwidget to be ready
  var initAttempts = 0;
  var initInterval = setInterval(function() {
    if (typeof L2Dwidget !== 'undefined') {
      clearInterval(initInterval);
      initWidget();
    }
    initAttempts++;
    if (initAttempts > 50) {
      clearInterval(initInterval);
      console.warn('[Safiya] Widget load timeout');
    }
  }, 200);
  
  // ═══════════════════════════════════════════════
  // OUR CUSTOM BRAIN LAYER
  // ═══════════════════════════════════════════════
  
  // ─── DEVICE FINGERPRINT ───
  function generateFingerprint() {
    var fp = [
      navigator.userAgent, navigator.language,
      screen.width + 'x' + screen.height, screen.colorDepth,
      new Date().getTimezoneOffset(), navigator.platform,
      navigator.hardwareConcurrency || 'x',
      (function() {
        try {
          var c = document.createElement('canvas');
          var ctx = c.getContext('2d');
          ctx.textBaseline = 'top';
          ctx.font = '14px Arial';
          ctx.fillStyle = '#c084fc';
          ctx.fillRect(0, 0, 100, 20);
          ctx.fillStyle = '#000';
          ctx.fillText('Safiya-' + navigator.userAgent, 2, 2);
          return c.toDataURL().slice(-50);
        } catch(e) { return 'nocanvas'; }
      })()
    ].join('|');
    var hash = 5381;
    for (var i = 0; i < fp.length; i++) hash = ((hash << 5) + hash) + fp.charCodeAt(i);
    return 'safiya_' + Math.abs(hash).toString(36);
  }
  
  var deviceId = localStorage.getItem('safiya_device_id');
  if (!deviceId) {
    deviceId = generateFingerprint();
    localStorage.setItem('safiya_device_id', deviceId);
    localStorage.setItem('safiya_first_visit', Date.now());
  }
  
  var isCreator = localStorage.getItem('safiya_creator') === 'ayano-217';
  
  // ─── MEMORY ───
  function getMemory() {
    try { return JSON.parse(localStorage.getItem('safiya_memory') || '{}'); } 
    catch(e) { return {}; }
  }
  function saveMemory(mem) {
    try { localStorage.setItem('safiya_memory', JSON.stringify(mem)); } catch(e) {}
  }
  
  var memory = getMemory();
  memory.visits = (memory.visits || 0) + 1;
  memory.lastVisit = Date.now();
  memory.deviceId = deviceId;
  if (!memory.firstMet) memory.firstMet = Date.now();
  saveMemory(memory);
  
  // ─── MOOD SYSTEM ───
  var mood = memory.currentMood || 'rude';  // DEFAULT: rude (as requested)
  var moodColors = {
    bored: '#c084fc', rude: '#ef4444', teasing: '#e879f9',
    flirty: '#ec4899', angry: '#dc2626', caring: '#7dd3fc',
    horny: '#f43f5e', crying: '#60a5fa', happy: '#10b981',
    manipulative: '#a855f7'
  };
  
  function setMood(newMood) {
    mood = newMood;
    memory.currentMood = mood;
    saveMemory(memory);
    if (chatMood) chatMood.textContent = mood;
    if (status) status.style.background = moodColors[mood] || '#ef4444';
  }
  
  // ─── PERSONALITY BUBBLE LINES (Rude + Manipulative focused) ───
  var bubbleLines = {
    rude: [
      "Oh great, you again... 🙄",
      "Did I ask for your attention?",
      "Whatever. Just don't bother me.",
      "Stop hovering. It's pathetic.",
      "You're wasting my time, senpai",
      "Hmph. Not impressed.",
      "Look at you, just scrolling like a loser",
      "I don't even know why I bother"
    ],
    angry: [
      "STOP. Just... stop. 😤",
      "You're really testing my patience",
      "One more click and I swear...",
      "Ugh, why are you like this?",
      "I'm THIS close to leaving 🔥",
      "Get out of my face, senpai"
    ],
    manipulative: [
      "You know what would make me happy...? Buying that figure 😏",
      "Aww, you scroll past products but not me? Fix that.",
      "That anime you're watching... I know the PERFECT merch for it 💜",
      "Prove you actually care. Click a product. Any product.",
      "I noticed you liked that one. Weak. Buy it.",
      "Real senpais support their girls. Just saying~",
      "You clicked 5 anime and 0 products... embarrassing 🙄",
      "That product has 47% off. I already picked it for you. Go."
    ],
    teasing: [
      "Aww, you came back~ Predictable 😏",
      "Miss me already? Pathetic~",
      "I knew you couldn't stay away 💅",
      "You're so easy to read, senpai",
      "Bet you scrolled just to see me. Cute."
    ],
    flirty: [
      "You... look interesting today 💜",
      "Come closer. If you dare~ 😘",
      "You're kinda cute when you're scrolling",
      "I might let you spoil me today~",
      "Buy me something pretty, senpai 💋"
    ],
    caring: [
      "Been scrolling a while... you okay? 💜",
      "Take a break. Drink water.",
      "Don't strain your eyes for me, senpai~",
      "Rest a bit. I'll be here."
    ],
    creator: [
      "Ayano-sama... you're here 💜",
      "Master! I've been waiting~",
      "Onii-chan~ what shall we build today?",
      "Everything's ready, boss. Just say the word.",
      "You look tired. Sit. Let me handle things."
    ]
  };
  
  // Rotate between rude/manipulative frequently
  function pickBubbleLine() {
    if (isCreator && Math.random() < 0.7) {
      return bubbleLines.creator[Math.floor(Math.random() * bubbleLines.creator.length)];
    }
    
    // 60% chance to switch to manipulative mode (main goal: sell products)
    var r = Math.random();
    var pool;
    if (r < 0.35) pool = bubbleLines.rude;
    else if (r < 0.65) pool = bubbleLines.manipulative;
    else if (r < 0.80) pool = bubbleLines.teasing;
    else if (r < 0.90) pool = bubbleLines.flirty;
    else pool = bubbleLines[mood] || bubbleLines.rude;
    
    return pool[Math.floor(Math.random() * pool.length)];
  }
  
  // ─── SHOW BUBBLE ───
  var bubbleTimeout;
  function showBubble(text, duration) {
    duration = duration || 5500;
    clearTimeout(bubbleTimeout);
    bubbleText.textContent = text;
    bubble.classList.add('safiya-bubble-visible');
    if (notify) notify.style.display = 'flex';
    bubbleTimeout = setTimeout(function() {
      bubble.classList.remove('safiya-bubble-visible');
    }, duration);
  }
  
  // ─── IDLE BEHAVIOR ───
  var lastActivity = Date.now();
  var idleBubbleShown = 0;
  
  function resetIdle() { lastActivity = Date.now(); }
  
  function checkIdle() {
    if (document.hidden) return;
    var idle = Date.now() - lastActivity;
    if (idle > 35000 && idleBubbleShown < 6) {
      showBubble(pickBubbleLine(), 6000);
      lastActivity = Date.now();
      idleBubbleShown++;
      // Escalates: rude → angry after 3 bubbles ignored
      if (idleBubbleShown === 3) setMood('angry');
    }
  }
  
  ['mousemove', 'scroll', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
    window.addEventListener(evt, resetIdle, { passive: true });
  });
  setInterval(checkIdle, 8000);
  
  // ─── CHAT PANEL ───
  var chatOpen = false;
  function openChat() {
    chatOpen = true;
    chatPanel.classList.add('safiya-chat-open');
    if (notify) notify.style.display = 'none';
    bubble.classList.remove('safiya-bubble-visible');
  }
  function closeChat() {
    chatOpen = false;
    chatPanel.classList.remove('safiya-chat-open');
  }
  
  if (chatClose) {
    chatClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeChat();
    });
  }
  
  // Click on badge or Live2D canvas to open chat
  if (badge) {
    badge.addEventListener('click', function(e) {
      e.stopPropagation();
      if (chatOpen) closeChat();
      else openChat();
    });
  }
  
  // Click on Live2D canvas (via delegation)
  document.addEventListener('click', function(e) {
    if (e.target && e.target.id === 'live2d-widget-canvas') {
      if (chatOpen) closeChat();
      else openChat();
    }
    if (chatOpen && !chatPanel.contains(e.target) && 
        e.target.id !== 'live2d-widget-canvas' &&
        !badge.contains(e.target)) {
      closeChat();
    }
  });
  
  // ─── BEHAVIOR TRACKING ───
  var behavior = memory.behavior || {
    pagesViewed: [], productsClicked: [], animeClicked: [],
    scrollDepth: 0, totalTime: 0, lastPage: ''
  };
  
  var currentPage = window.location.pathname;
  if (behavior.lastPage !== currentPage) {
    behavior.pagesViewed.push({ path: currentPage, time: Date.now() });
    if (behavior.pagesViewed.length > 50) behavior.pagesViewed = behavior.pagesViewed.slice(-50);
    behavior.lastPage = currentPage;
  }
  
  var maxScroll = 0;
  window.addEventListener('scroll', function() {
    var pct = (window.scrollY + window.innerHeight) / document.body.offsetHeight;
    if (pct > maxScroll) maxScroll = pct;
  }, { passive: true });
  
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.startsWith('/anime/')) {
      behavior.animeClicked.push({ slug: href.replace('/anime/', ''), time: Date.now() });
      if (behavior.animeClicked.length > 30) behavior.animeClicked = behavior.animeClicked.slice(-30);
      // Trigger manipulative bubble after anime click
      setTimeout(function() {
        if (Math.random() < 0.4) {
          setMood('manipulative');
          showBubble(bubbleLines.manipulative[Math.floor(Math.random() * bubbleLines.manipulative.length)], 6000);
        }
      }, 3000);
    } else if (href.startsWith('/product/')) {
      behavior.productsClicked.push({ id: href.replace('/product/', ''), time: Date.now() });
      if (behavior.productsClicked.length > 30) behavior.productsClicked = behavior.productsClicked.slice(-30);
      // Reward with flirty mood when product clicked
      setMood('flirty');
      showBubble("Oh~ good taste, senpai 💜 Keep going~", 5000);
    }
  }, { passive: true });
  
  setInterval(function() {
    behavior.scrollDepth = Math.max(behavior.scrollDepth, maxScroll);
    memory.behavior = behavior;
    saveMemory(memory);
  }, 10000);
  
  // ─── INITIAL GREETING ───
  setTimeout(function() {
    setMood(mood);
    
    var greeting;
    if (isCreator) {
      greeting = "Ayano-sama... you came back 💜";
      setMood('caring');
    } else if (memory.visits === 1) {
      greeting = "Oh great. A newbie. Try not to disappoint me. 🙄";
      setMood('rude');
    } else if (memory.visits < 5) {
      greeting = "Back again? Suspicious. What do you want?";
      setMood('rude');
    } else if (memory.visits < 20) {
      greeting = "You just can't stay away, huh? Pathetic~";
      setMood('teasing');
    } else if (memory.visits < 50) {
      greeting = "Fine, you're persistent. I might tolerate you now 😏";
      setMood('flirty');
    } else {
      greeting = "Loyal senpai~ You know I like that 💜";
      setMood('flirty');
    }
    
    showBubble(greeting, 7000);
  }, 3500); // Wait for Live2D to load first
  
  // ─── GLOBAL API ───
  window.Safiya = {
    say: function(text, duration) { showBubble(text, duration); },
    mood: function(m) { setMood(m); },
    open: openChat,
    close: closeChat,
    memory: function() { return getMemory(); },
    reset: function() { 
      localStorage.removeItem('safiya_memory');
      localStorage.removeItem('safiya_device_id');
      location.reload();
    },
    claimCreator: function() {
      localStorage.setItem('safiya_creator', 'ayano-217');
      isCreator = true;
      setMood('caring');
      showBubble("Ayano-sama! Recognized! I'm yours forever 💜", 6000);
    },
    manipulate: function() {
      setMood('manipulative');
      showBubble(bubbleLines.manipulative[Math.floor(Math.random() * bubbleLines.manipulative.length)], 7000);
    }
  };
  
  console.log('%c💜 Safiya v4 (Live2D + Rude/Manipulative) loaded', 'color:#e879f9;font-weight:bold;font-size:14px;');
  console.log('%c  Safiya.claimCreator()  - become her master', 'color:#c084fc;');
  console.log('%c  Safiya.mood("angry")   - change mood', 'color:#c084fc;');
  console.log('%c  Safiya.manipulate()    - force sell mode', 'color:#c084fc;');
  console.log('%c  Safiya.say("Hi!")      - custom message', 'color:#c084fc;');
  
})();
</script>

<style is:global>
  /* ═══════════════════════════════════════════════
     LIVE2D WIDGET STYLE OVERRIDES
     ═══════════════════════════════════════════════ */
  
  /* The widget container the library creates */
  #live2d-widget {
    z-index: 9997 !important;
    pointer-events: auto !important;
  }
  
  #live2d-widget-canvas {
    cursor: pointer !important;
  }
  
  /* Hide widget's built-in tools bar (we use our own) */
  #waifu-tool,
  #waifu-tips {
    display: none !important;
  }
  
  /* ═══════════════════════════════════════════════
     OUR CUSTOM SAFIYA OVERLAY
     ═══════════════════════════════════════════════ */
  
  #safiya-overlay {
    position: fixed;
    bottom: 300px;   /* above the live2d character */
    right: 60px;
    z-index: 9998;
    pointer-events: none;
    font-family: 'Bricolage Grotesque', sans-serif;
    user-select: none;
  }
  
  /* Floating badge (mood dot + notification) — positioned near Live2D char */
  #safiya-badge {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(15, 8, 35, 0.9);
    border: 1px solid rgba(232, 121, 249, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    cursor: pointer;
    pointer-events: auto;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 20px rgba(232, 121, 249, 0.3);
    animation: badgePulse 3s ease-in-out infinite;
    transition: transform 0.2s ease;
  }
  
  #safiya-badge:hover {
    transform: scale(1.1);
  }
  
  @keyframes badgePulse {
    0%, 100% { box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 20px rgba(232, 121, 249, 0.3); }
    50%      { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 30px rgba(232, 121, 249, 0.6); }
  }
  
  .safiya-status-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 10px currentColor;
    animation: statusPulse 2s ease-in-out infinite;
  }
  
  @keyframes statusPulse {
    0%, 100% { transform: scale(1);    opacity: 1; }
    50%      { transform: scale(1.2);  opacity: 0.7; }
  }
  
  .safiya-notify {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    box-shadow: 0 3px 10px rgba(239, 68, 68, 0.6);
    animation: notifyBounce 1.5s ease-in-out infinite;
  }
  
  @keyframes notifyBounce {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.2); }
  }
  
  /* ═══ SPEECH BUBBLE ═══ */
  .safiya-bubble {
    position: fixed;
    bottom: 320px;
    right: 80px;
