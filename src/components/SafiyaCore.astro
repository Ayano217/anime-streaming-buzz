  #safiya-root .s-head:hover {
    transform: translateY(-2px) scale(1.015);
  }

  #safiya-root .s-head-hide {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.92);
  }

  #safiya-root .s-head-ring {
    position: absolute;
    inset: -45%;
    background:
      conic-gradient(
        from 0deg,
        #c084fc 0deg,
        #e879f9 120deg,
        #7dd3fc 240deg,
        #c084fc 360deg
      );
    animation: sRingSpin 9s linear infinite;
    filter: blur(14px) saturate(1.15);
    opacity: 0.95;
  }

  #safiya-root .s-head-inner {
    position: relative;
    z-index: 2;
    height: 56px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px 0 8px;
