---
// ═══════════════════════════════════════════════════════════════
// SAFIYA v14 — INSTAGRAM DM STYLE, NO AVATAR, SMART LINK DETECTION
// Path: src/components/SafiyaCore.astro
// ═══════════════════════════════════════════════════════════════
// ✅ Live2D REMOVED (screen free, no lag)
// ✅ Instagram DM style bubbles with gradients
// ✅ Sweet caring girl personality
// ✅ FB link auto-detect → Watch Now button
// ✅ KV integration for anime lookup
// ✅ Long-press message → Copy/Reply/Delete
// ✅ Reply preview like WhatsApp
// ✅ Long text scrolls perfectly
// ✅ Owner recognition (Ayano)
// ═══════════════════════════════════════════════════════════════
---

<div id="safiya-root">

  <!-- ═══════════════ LAUNCHER PILL ═══════════════ -->
  <button id="safiya-head" class="sf-launcher" aria-label="Chat with Safiya">
    <span class="sf-launcher-neon"></span>
    <span class="sf-launcher-inner">
      <span class="sf-launcher-avatar">
        <span class="sf-launcher-icon" id="s-head-icon">S</span>
        <span class="sf-launcher-dot"></span>
      </span>
      <span class="sf-launcher-text">
        <span class="sf-launcher-name">Safiya</span>
        <span class="sf-launcher-status">online</span>
      </span>
    </span>
    <span class="sf-launcher-notify" id="safiya-notify">1</span>
  </button>

  <!-- ═══════════════ TEASER BUBBLE ═══════════════ -->
  <div id="safiya-bubble" class="sf-teaser">
    <div class="sf-teaser-avatar">S</div>
    <div class="sf-teaser-body">
      <div class="sf-teaser-name">Safiya</div>
      <div class="sf-teaser-text" id="s-bubble-text"></div>
    </div>
    <button class="sf-teaser-close" id="s-bubble-x" aria-label="Dismiss">✕</button>
  </div>

  <!-- ═══════════════ CHAT WINDOW ═══════════════ -->
  <div id="safiya-chat" class="sf-chat" aria-hidden="true">
    
    <!-- HEADER -->
    <header class="sf-chat-header">
      <button class="sf-icon-btn" id="s-back" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="sf-chat-user">
        <div class="sf-chat-user-avatar">
          <span class="sf-chat-avatar-letter">S</span>
          <span class="sf-chat-user-dot"></span>
        </div>
        <div class="sf-chat-user-info">
          <div class="sf-chat-user-name">Safiya</div>
          <div class="sf-chat-user-status" id="s-chat-status">Active now</div>
        </div>
      </div>

      <div class="sf-chat-actions">
        <button class="sf-icon-btn" id="s-clear" aria-label="Clear chat" title="Clear conversation">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
          </svg>
        </button>
        <button class="sf-icon-btn" id="s-min" aria-label="Minimize">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
        <button class="sf-icon-btn sf-icon-btn-danger" id="s-close" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- BODY -->
    <div class="sf-chat-body" id="s-chat-body"></div>

    <!-- MESSAGE ACTION MENU (long-press popup) -->
    <div class="sf-msg-menu" id="s-msg-menu" style="display:none">
      <button class="sf-msg-menu-btn" data-action="reply">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 17 4 12 9 7"/>
          <path d="M20 18v-2a4 4 0 0 0-4-4H4"/>
        </svg>
        <span>Reply</span>
      </button>
      <button class="sf-msg-menu-btn" data-action="copy">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span>Copy</span>
      </button>
      <button class="sf-msg-menu-btn sf-msg-menu-danger" data-action="delete">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
        </svg>
        <span>Delete</span>
      </button>
    </div>

    <!-- REPLY PREVIEW (above composer when replying) -->
    <div class="sf-reply-preview" id="s-reply-preview" style="display:none">
      <div class="sf-reply-bar"></div>
      <div class="sf-reply-content">
        <div class="sf-reply-label" id="s-reply-label">Replying to Safiya</div>
        <div class="sf-reply-text" id="s-reply-text"></div>
      </div>
      <button class="sf-reply-close" id="s-reply-close" aria-label="Cancel reply">✕</button>
    </div>

    <!-- COMPOSER -->
    <div class="sf-chat-composer">
      <div class="sf-composer-input">
        <textarea 
          id="s-input" 
          placeholder="Message..." 
          autocomplete="off" 
          maxlength="1000" 
          rows="1"
        ></textarea>
      </div>
      <button class="sf-composer-send" id="s-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- ═══════════════ MINIMIZED PILL ═══════════════ -->
  <div id="safiya-mini" class="sf-mini" aria-hidden="true">
    <div class="sf-mini-avatar">S</div>
    <span class="sf-mini-name">Safiya</span>
    <span class="sf-mini-badge" id="s-mini-new">0</span>
    <button class="sf-mini-close" id="s-mini-x" aria-label="Close">✕</button>
  </div>

</div>

<style is:global>
  /* ═══════════════════════════════════════════════
     🎨 ROOT STYLES
  ═══════════════════════════════════════════════ */
  #safiya-root {
    font-family: 'Inter', 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    user-select: none;
    -webkit-user-select: none;
  }
  #safiya-root *, #safiya-root *::before, #safiya-root *::after {
    box-sizing: border-box;
  }
  #safiya-root svg { display: block; flex-shrink: 0; }
  #safiya-root button { font-family: inherit; cursor: pointer; }

  /* ═══════════════════════════════════════════════
     🎯 LAUNCHER PILL — Instagram gradient neon
  ═══════════════════════════════════════════════ */
  #safiya-root .sf-launcher {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9997;
    border: none;
    padding: 0;
    height: 48px;
    min-width: 140px;
    border-radius: 24px;
    background: transparent;
    overflow: visible;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    isolation: isolate;
  }
  #safiya-root .sf-launcher:hover { transform: translateY(-1px) scale(1.02); }
  #safiya-root .sf-launcher:active { transform: scale(0.97); }
  #safiya-root .sf-launcher-hide {
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px) scale(0.9);
  }

  #safiya-root .sf-launcher-neon {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 1.5px;
    background: conic-gradient(
      from var(--sf-angle, 0deg),
      #f09433 0%,
      #e6683c 15%,
      #dc2743 30%,
      #cc2366 50%,
      #bc1888 70%,
      #833ab4 85%,
      #f09433 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: sfNeonRotate 4s linear infinite;
    pointer-events: none;
    z-index: 1;
  }

  @property --sf-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes sfNeonRotate {
    to { --sf-angle: 360deg; }
  }

  #safiya-root .sf-launcher::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 26px;
    background: conic-gradient(
      from var(--sf-angle, 0deg),
      transparent 0%,
      rgba(220, 39, 67, 0.35) 15%,
      transparent 30%,
      rgba(188, 24, 136, 0.3) 50%,
      transparent 65%,
      rgba(131, 58, 180, 0.35) 85%,
      transparent 100%
    );
    filter: blur(6px);
    opacity: 0.7;
    z-index: -1;
    animation: sfNeonRotate 4s linear infinite;
    pointer-events: none;
  }

  #safiya-root .sf-launcher-hot::before {
    opacity: 1;
    filter: blur(10px);
  }

  #safiya-root .sf-launcher-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 16px 4px 4px;
    border-radius: 24px;
    background:
      linear-gradient(180deg,
        rgba(38, 22, 66, 0.98) 0%,
        rgba(22, 12, 38, 0.98) 45%,
        rgba(12, 6, 22, 0.99) 100%
      );
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5),
      0 8px 20px rgba(0, 0, 0, 0.55),
      0 2px 6px rgba(0, 0, 0, 0.4);
  }

  #safiya-root .sf-launcher-avatar {
    position: relative;
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2),
      0 2px 8px rgba(220, 39, 67, 0.4);
    flex-shrink: 0;
  }

  #safiya-root .sf-launcher-icon {
    color: #fff;
    font-weight: 800;
    font-size: 1.15rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: -0.02em;
  }

  #safiya-root .sf-launcher-dot {
    position: absolute;
    right: 0px;
    bottom: 0px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid rgba(12, 6, 22, 1);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.9);
    z-index: 3;
  }

  #safiya-root .sf-launcher-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    line-height: 1;
    min-width: 0;
    gap: 3px;
  }

  #safiya-root .sf-launcher-name {
    color: #f7edff !important;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  #safiya-root .sf-launcher-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(232, 121, 249, 0.9) !important;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }
  #safiya-root .sf-launcher-status::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.9);
    flex-shrink: 0;
  }

  #safiya-root .sf-launcher-notify {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 10px;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff !important;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 800;
    z-index: 5;
    border: 2px solid rgba(12, 6, 22, 1);
    box-shadow: 0 3px 10px rgba(239, 68, 68, 0.5);
  }

  /* ═══════════════════════════════════════════════
     💭 TEASER BUBBLE
  ═══════════════════════════════════════════════ */
  #safiya-root .sf-teaser {
    position: fixed;
    right: 20px;
    bottom: 80px;
    z-index: 9997;
    width: 280px;
    padding: 12px 36px 12px 12px;
    background: rgba(18, 10, 32, 0.96) !important;
    border: 1px solid rgba(232, 121, 249, 0.3);
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    gap: 10px;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.96);
    transform-origin: bottom right;
    transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  #safiya-root .sf-teaser-show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  #safiya-root .sf-teaser-avatar {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff !important;
    font-weight: 800;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
  }
  #safiya-root .sf-teaser-body { flex: 1; min-width: 0; }
  #safiya-root .sf-teaser-name {
    font-weight: 700;
    font-size: 0.72rem;
    color: #e879f9 !important;
    margin-bottom: 3px;
    letter-spacing: -0.005em;
  }
  #safiya-root .sf-teaser-text {
    font-size: 0.87rem;
    line-height: 1.4;
    color: #f0e8ff !important;
    font-weight: 450;
    letter-spacing: -0.005em;
    word-wrap: break-word;
  }
  #safiya-root .sf-teaser-close {
    position: absolute;
    top: 6px;
    right: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: rgba(240, 232, 255, 0.5);
    cursor: pointer;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    padding: 0;
    font-size: 0.7rem;
    font-weight: 700;
    transition: all 0.15s;
  }
  #safiya-root .sf-teaser-close:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.15);
  }
</style>
