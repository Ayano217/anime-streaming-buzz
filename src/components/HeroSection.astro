    border: none;
  }

  .btn-watch:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(192, 132, 252, 0.55);
  }

  .btn-watch-icon {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    animation: pulse-ring-slow 4s ease-out infinite;
  }

  @keyframes pulse-ring-slow {
    0%   { transform: scale(1);   opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .btn-info {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    color: #fff !important;
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.25s ease;
    text-decoration: none;
    backdrop-filter: blur(10px);
  }

  .btn-info:hover {
    background: rgba(125, 211, 252, 0.15);
    border-color: rgba(125, 211, 252, 0.5);
    color: var(--cyan) !important;
    transform: translateY(-2px);
  }

  /* RIGHT COVER */
  .slide-right {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    animation: slideInRight 0.7s ease;
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .cover-frame {
    padding: 20px;
    max-width: 100%;
  }

  .cover-container {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 3/4;
  }

  .cover-border-glow {
    position: absolute;
    inset: -2px;
    border-radius: 22px;
    background: conic-gradient(
      from 0deg,
      #c084fc,
      #e879f9,
      #7dd3fc,
      #a855f7,
      #c084fc
    );
    animation: border-spin 60s linear infinite;
    z-index: 0;
    opacity: 0.5;
    filter: blur(1px);
  }

  @keyframes border-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .cover-glow {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(192, 132, 252, 0.45) 0%,
      rgba(232, 121, 249, 0.25) 30%,
      rgba(125, 211, 252, 0.15) 60%,
      transparent 75%
    );
    filter: blur(50px);
    z-index: 0;
    animation: glow-breathe 8s ease-in-out infinite;
  }

  @keyframes glow-breathe {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.03); }
  }

  .cover-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s ease;
