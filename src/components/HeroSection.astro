---
// ═══ USING ANILIST API (better data, HD banners, no lag) ═══

async function fetchAniListTrending() {
  const query = `
    query {
      Page(page: 1, perPage: 5) {
        media(sort: TRENDING_DESC, type: ANIME, status: RELEASING) {
          id
          title { english romaji native }
          description(asHtml: false)
          bannerImage
          coverImage { extraLarge large color }
          averageScore
          meanScore
          popularity
          trending
          favourites
          episodes
          duration
          season
          seasonYear
          format
          genres
          studios(isMain: true) { nodes { name } }
          nextAiringEpisode { episode timeUntilAiring }
          trailer { id site }
          siteUrl
          tags(sort: RANK) { name rank category isMediaSpoiler }
        }
      }
    }
  `;

  try {
    const res = await fetch('https://graphql.anilist.co', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify({ query }),
    });
    if (!res.ok) throw new Error('AniList API failed');
    const data = await res.json();
    return data?.data?.Page?.media || [];
  } catch (e) {
    console.warn('[HeroSection] AniList failed:', e);
    return [];
  }
}

let heroAnime = [];
const anilistData = await fetchAniListTrending();

if (anilistData.length > 0) {
  heroAnime = anilistData.map(a => {
    // Get mood tags (non-spoiler)
    const moodTags = (a.tags || [])
      .filter(t => !t.isMediaSpoiler && t.rank > 60)
      .slice(0, 3)
      .map(t => t.name);

    // Calculate hype score (0-100)
    const scoreNorm  = (a.averageScore || 0);
    const popNorm    = Math.min(100, Math.log10((a.popularity || 1) + 1) * 20);
    const trendNorm  = Math.min(100, Math.log10((a.trending || 1) + 1) * 25);
    const hype       = Math.round((scoreNorm * 0.5) + (popNorm * 0.25) + (trendNorm * 0.25));

    // Fake but engaging "watching now" number
    const watching = Math.floor((a.popularity || 1000) * 0.008 + Math.random() * 500);

    // Time until next episode
    let nextEp = '';
    if (a.nextAiringEpisode?.timeUntilAiring) {
      const days = Math.floor(a.nextAiringEpisode.timeUntilAiring / 86400);
      const hours = Math.floor((a.nextAiringEpisode.timeUntilAiring % 86400) / 3600);
      if (days > 0) nextEp = `EP ${a.nextAiringEpisode.episode} in ${days}d ${hours}h`;
      else nextEp = `EP ${a.nextAiringEpisode.episode} in ${hours}h`;
    }

    // Strip HTML from description
    const cleanDesc = (a.description || '')
      .replace(/<br\s*\/?>/gi, ' ')
      .replace(/<[^>]*>/g, '')
      .replace(/&#\d+;/g, '')
      .substring(0, 220);

    return {
      title:    a.title?.english || a.title?.romaji || 'Unknown',
      titleJp:  a.title?.native || '',
      description: cleanDesc + '...',
      coverImage: a.coverImage?.extraLarge || a.coverImage?.large || '',
      bannerImage: a.bannerImage || a.coverImage?.extraLarge || '',
      coverColor: a.coverImage?.color || '#c084fc',
      score:    a.averageScore || 0,
      popularity: a.popularity || 0,
      trending: a.trending || 0,
      episodes: a.episodes || '?',
      duration: a.duration || 24,
      season:   a.season ? `${a.season} ${a.seasonYear}`.toLowerCase() : '',
      format:   a.format || 'TV',
      genres:   (a.genres || []).slice(0, 3),
      studios:  (a.studios?.nodes || []).slice(0, 1).map(s => s.name),
      nextEp,
      hype,
      watching,
      trailerId: a.trailer?.id || '',
      trailerSite: a.trailer?.site || '',
      moodTags,
      siteUrl:  a.siteUrl,
    };
  });
}

// Fallback
if (heroAnime.length === 0) {
  heroAnime = [{
    title: 'Discover Anime',
    titleJp: '',
    description: 'Explore the latest anime series.',
    coverImage: '', bannerImage: '', coverColor: '#c084fc',
    score: 0, popularity: 0, trending: 0,
    episodes: '?', duration: 24, season: '', format: 'TV',
    genres: [], studios: [], nextEp: '', hype: 0, watching: 0,
    trailerId: '', trailerSite: '', moodTags: [], siteUrl: '#',
  }];
}

// Fetch latest posts
import { getCollection } from 'astro:content';
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestNews = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter(post => {
    const img = post.data.image || '';
    return img && !img.includes('picsum.photos');
  })
  .slice(0, 4);

const displayEpisodes = latestNews.length >= 4 ? latestNews :
  allPosts.sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 4);
---

<section class="cine-hero" id="cineHero">

  <!-- Slides -->
  <div class="cine-slides" id="cineSlides">
    {heroAnime.map((anime, idx) => (
      <div class={`cine-slide ${idx === 0 ? 'active' : ''}`} data-index={idx} data-color={anime.coverColor}>

        <!-- HUGE Banner Background -->
        <div class="cine-banner" style={anime.bannerImage ? `background-image: url(${anime.bannerImage})` : `background: linear-gradient(135deg, ${anime.coverColor}88, #1c0f3d)`}></div>

        <!-- Dark gradient overlay -->
        <div class="cine-overlay"></div>

        <!-- Color tint (matches cover) -->
        <div class="cine-color-tint" style={`background: linear-gradient(90deg, ${anime.coverColor}55 0%, transparent 60%)`}></div>

        <!-- Content -->
        <div class="cine-content container">
          <div class="cine-content-inner">

            <!-- Left: Info -->
            <div class="cine-left">

              <!-- Trending Rank Badge -->
              {idx === 0 && (
                <div class="rank-badge">
                  <div class="flame-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="url(#flameGrad)">
                      <defs>
                        <linearGradient id="flameGrad">
                          <stop offset="0" stop-color="#fb923c"/>
                          <stop offset="1" stop-color="#e879f9"/>
                        </linearGradient>
                      </defs>
                      <path d="M12 23a9 9 0 0 1-9-9c0-3.9 3.75-8.85 6-9 0 3 1.5 5 3 6.5 1.5 1.5 3 3.5 3 5.5A5.5 5.5 0 0 1 12 23z M12 3s3 4.5 3 8"/>
                    </svg>
                  </div>
                  <span>#1 Trending This Week</span>
                </div>
              )}

              <!-- Badges Row -->
              <div class="cine-badges">
                {anime.studios[0] && (
                  <div class="cine-badge badge-studio">
                    <div class="studio-icon-mini">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/></svg>
                    </div>
                    {anime.studios[0]}
                  </div>
                )}
                <div class="cine-badge badge-quality">HD 4K</div>
                {anime.nextEp && (
                  <div class="cine-badge badge-airing">
                    <span class="live-pulse"></span>
                    AIRING · {anime.nextEp}
                  </div>
                )}
              </div>

              <!-- Title -->
              <h1 class="cine-title">{anime.title}</h1>
              {anime.titleJp && <p class="cine-title-jp">{anime.titleJp}</p>}

              <!-- Meta -->
              <div class="cine-meta">
                <span class="meta-item"><strong>{anime.format}</strong></span>
                {anime.season && <span class="meta-item">{anime.season}</span>}
                <span class="meta-item">{anime.episodes} EP</span>
                <span class="meta-item">{anime.duration}min</span>
                {anime.genres.length > 0 && (
                  <span class="meta-item meta-genres">
                    {anime.genres.slice(0, 2).join(' · ')}
                  </span>
                )}
              </div>

              <!-- Description -->
              <p class="cine-desc">{anime.description}</p>

              <!-- UNIQUE: Hype Meter -->
              <div class="hype-section">
                <div class="hype-header">
                  <div class="hype-label">
                    <span class="hype-icon">◆</span>
                    <span>HYPE METER</span>
                  </div>
                  <div class="hype-score">
                    <span class="hype-num">{anime.hype}</span><span class="hype-max">/100</span>
                  </div>
                </div>
                <div class="hype-bar">
                  <div class="hype-fill" style={`width: ${anime.hype}%`}></div>
                </div>
              </div>

              <!-- UNIQUE: Live Stats -->
              <div class="live-stats">
                <div class="stat-item">
                  <span class="stat-live-dot"></span>
                  <div>
                    <div class="stat-num" data-count={anime.watching}>{anime.watching.toLocaleString()}</div>
                    <div class="stat-lbl">watching now</div>
                  </div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                  <div class="stat-star">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="stat-num">{(anime.score / 10).toFixed(1)}</div>
                    <div class="stat-lbl">rating</div>
                  </div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                  <div class="stat-star">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </div>
                  <div>
                    <div class="stat-num">{(anime.popularity / 1000).toFixed(0)}K</div>
                    <div class="stat-lbl">members</div>
                  </div>
                </div>
              </div>

              <!-- UNIQUE: Mood Tags -->
              {anime.moodTags.length > 0 && (
                <div class="mood-tags">
                  <span class="mood-label">MOOD:</span>
                  {anime.moodTags.map(tag => (
                    <span class="mood-tag">{tag}</span>
                  ))}
                </div>
              )}

              <!-- CTAs -->
              <div class="cine-actions">
                {anime.trailerId && anime.trailerSite === 'youtube' && (
                  <a
                    href={`https://www.youtube.com/watch?v=${anime.trailerId}`}
                    target="_blank" rel="noopener"
                    class="cta-primary"
                  >
                    <div class="cta-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                    <span>Watch Trailer</span>
                  </a>
                )}
                {!anime.trailerId && (
                  <a href={anime.siteUrl} target="_blank" rel="noopener" class="cta-primary">
                    <div class="cta-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                    <span>Watch Now</span>
                  </a>
                )}

                <a href={anime.siteUrl} target="_blank" rel="noopener" class="cta-secondary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4M12 8h.01"/>
                  </svg>
                  <span>More Info</span>
                </a>

                <button class="cta-icon-btn" aria-label="Add to list">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14"/>
                  </svg>
                </button>
              </div>

            </div>

            <!-- Right: BIG Cover with effects -->
            <div class="cine-right">
              <div class="cover-frame">
                <!-- Reflection/glow behind -->
                <div class="cover-shadow" style={`background: ${anime.coverColor}55`}></div>

                <!-- Cover image (BIG!) -->
                {anime.coverImage && (
                  <div class="cover-image-wrap">
                    <img
                      src={anime.coverImage}
                      alt={anime.title}
                      class="cover-image"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                    />

                    <!-- Manga panel cut lines -->
                    <div class="cover-cuts">
                      <div class="cut cut-1"></div>
                      <div class="cut cut-2"></div>
                    </div>

                    <!-- Corner brackets -->
                    <div class="bracket bracket-tl"></div>
                    <div class="bracket bracket-tr"></div>
                    <div class="bracket bracket-bl"></div>
                    <div class="bracket bracket-br"></div>

                    <!-- Score floating -->
                    <div class="cover-score-float">
                      <div class="score-circle">
                        <span class="score-val">{(anime.score / 10).toFixed(1)}</span>
                      </div>
                      <div class="score-label">RATING</div>
                    </div>

                  </div>
                )}
              </div>
            </div>

          </div>
        </div>

      </div>
    ))}
  </div>

  <!-- Bottom bar: dots + progress + controls -->
  <div class="cine-bottom container">

    <div class="cine-dots">
      {heroAnime.map((_, idx) => (
        <button class={`cine-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}>
          <span class="dot-num">{String(idx + 1).padStart(2, '0')}</span>
          <span class="dot-bar"></span>
        </button>
      ))}
    </div>

    <div class="cine-controls">
      <button class="ctrl-btn" id="prevSlide" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="ctrl-btn" id="nextSlide" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

  </div>

  <!-- Latest episodes -->
  {displayEpisodes.length > 0 && (
    <div class="ep-section container">
      <div class="ep-section-header">
        <h2 class="ep-section-title">
          <span class="grad-text">Latest</span> Updates
        </h2>
        <a href="/category/news" class="ep-view-all">
          View All →
        </a>
      </div>

      <div class="ep-grid">
        {displayEpisodes.map((post, idx) => {
          const dateStr = new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          const cat = post.data.category || 'News';
          return (
            <a href={`/posts/${post.slug}`} class="ep-card-mini">
              <div class="ep-mini-thumb">
                {post.data.image && !post.data.image.includes('picsum') ? (
                  <img src={post.data.image} alt={post.data.title} loading="lazy" />
                ) : (
                  <div class="ep-mini-fallback">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg>
                  </div>
                )}
                <div class="ep-mini-overlay">
                  <div class="ep-mini-play">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
                <div class="ep-mini-badge">{dateStr}</div>
              </div>
              <div class="ep-mini-info">
                <div class="ep-mini-cat">{cat}</div>
                <div class="ep-mini-title">{post.data.title}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}

</section>

<script is:inline>
(function() {
  var slides = document.querySelectorAll('.cine-slide');
  var dots   = document.querySelectorAll('.cine-dot');
  var current = 0;
  var interval;
  var duration = 8000;

  if(slides.length === 0) return;

  function goto(idx){
    slides[current].classList.remove('active');
    dots[current] && dots[current].classList.remove('active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current] && dots[current].classList.add('active');
  }

  function next(){ goto(current + 1); }
  function prev(){ goto(current - 1); }

  function startAuto(){
    clearInterval(interval);
    interval = setInterval(next, duration);
  }

  dots.forEach(function(dot){
    dot.addEventListener('click', function(){
      goto(parseInt(dot.dataset.index));
      startAuto();
    });
  });

  var prevBtn = document.getElementById('prevSlide');
  var nextBtn = document.getElementById('nextSlide');
  if(prevBtn) prevBtn.addEventListener('click', function(){ prev(); startAuto(); });
  if(nextBtn) nextBtn.addEventListener('click', function(){ next(); startAuto(); });

  // Pause on hover
  var hero = document.getElementById('cineHero');
  if(hero) {
    hero.addEventListener('mouseenter', function(){ clearInterval(interval); });
    hero.addEventListener('mouseleave', startAuto);
  }

  if(slides.length > 1) startAuto();

  // Animated counter for "watching now"
  var counters = document.querySelectorAll('[data-count]');
  counters.forEach(function(el){
    var target = parseInt(el.dataset.count);
    if(isNaN(target)) return;
    var duration = 1500;
    var start = 0;
    var startTime = null;
    function animate(t){
      if(!startTime) startTime = t;
      var progress = Math.min((t - startTime) / duration, 1);
      var val = Math.floor(progress * target);
      el.textContent = val.toLocaleString();
      if(progress < 1) requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
  });

  // Simulate live counter increases
  setInterval(function(){
    counters.forEach(function(el){
      var current = parseInt(el.textContent.replace(/,/g,'')) || 0;
      var change = Math.floor(Math.random() * 5) - 2;
      var next = Math.max(0, current + change);
      el.textContent = next.toLocaleString();
    });
  }, 3000);

})();
</script>

<style>
  /* ═══ HERO WRAPPER ═══ */
  .cine-hero {
    position: relative;
    margin-bottom: 3rem;
  }

  /* ═══ SLIDES ═══ */
  .cine-slides {
    position: relative;
    min-height: 640px;
    overflow: hidden;
  }

  .cine-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease;
  }

  .cine-slide.active {
    opacity: 1;
    visibility: visible;
  }

  /* ═══ HUGE BANNER BG ═══ */
  .cine-banner {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
    animation: banner-zoom 20s ease infinite alternate;
  }

  @keyframes banner-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }

  .cine-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(10, 5, 23, 0.95) 0%,
      rgba(10, 5, 23, 0.75) 40%,
      rgba(10, 5, 23, 0.5) 65%,
      rgba(10, 5, 23, 0.75) 100%
    ),
    linear-gradient(
      180deg,
      rgba(10, 5, 23, 0.3) 0%,
      rgba(10, 5, 23, 0.5) 60%,
      rgba(10, 5, 23, 0.95) 100%
    );
    z-index: 1;
  }

  .cine-color-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: overlay;
    opacity: 0.6;
  }

  /* ═══ CONTENT ═══ */
  .cine-content {
    position: relative;
    z-index: 2;
    padding: 4rem 1.5rem 3rem;
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  .cine-content-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  /* ═══ LEFT SIDE ═══ */
  .cine-left {
    position: relative;
    animation: slide-in-left 0.9s ease forwards;
  }

  @keyframes slide-in-left {
    from { opacity: 0; transform: translateX(-30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── Rank Badge ── */
  .rank-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.2), rgba(232, 121, 249, 0.15));
    border: 1px solid rgba(251, 146, 60, 0.4);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--flame);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .flame-icon {
    animation: flame-flicker 1.5s ease infinite;
    display: flex;
  }

  @keyframes flame-flicker {
    0%, 100% { transform: scale(1) rotate(0); }
    50%       { transform: scale(1.15) rotate(-3deg); }
  }

  /* ── Badges ── */
  .cine-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .cine-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    backdrop-filter: blur(10px);
  }

  .badge-studio {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-transform: none;
    font-family: var(--font-body);
    font-size: 0.72rem;
    padding-left: 0.3rem;
  }

  .studio-icon-mini {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .badge-quality {
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan);
  }

  .badge-airing {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .live-pulse {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: live-pulse 1.5s ease infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(1.3); }
  }

  /* ── Title ── */
