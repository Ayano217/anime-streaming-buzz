---
import { getCollection } from 'astro:content';
---

<section class="hero-sec" id="heroSec">
  <div class="hero-bg-force"></div>

  <div class="hero-inner container">
    <div class="hero-slides" id="heroSlides">
      <!-- Skeleton slide for initial paint -->
      <div class="hero-slide active" data-index="0">
        <div class="slide-content">
          <div class="slide-left">
            <div class="badges">
              <div class="badge badge-hd">HD</div>
            </div>
            <h1 class="slide-title" style="opacity:0.5;">Loading Trending Anime...</h1>
            <p class="slide-desc" style="opacity:0.5;">Fetching the hottest anime right now from our servers.</p>
            <div class="slide-actions">
              <span class="btn-watch" style="opacity:0.5;">
                <div class="btn-watch-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <span>Loading...</span>
              </span>
            </div>
          </div>
          <div class="slide-right">
            <div class="cover-frame">
              <div class="cover-container">
                <div class="cover-border-glow"></div>
                <div class="cover-glow"></div>
                <div class="cover-inner">
                  <div class="cover-skeleton"></div>
                  <div class="corner-acc corner-tl"></div>
                  <div class="corner-acc corner-tr"></div>
                  <div class="corner-acc corner-bl"></div>
                  <div class="corner-acc corner-br"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-controls">
      <div class="slide-dots" id="slideDots"></div>
      <div class="slide-nav">
        <button class="nav-btn" id="prevBtn" aria-label="Previous">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="nav-btn" id="nextBtn" aria-label="Next">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(async function(){
  var slidesEl = document.getElementById('heroSlides');
  var dotsEl = document.getElementById('slideDots');
  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  var hero = document.getElementById('heroSec');
  var current = 0, interval, slides = [], dots = [];

  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];})}

  function truncate(str,n){str=String(str||'');return str.length>n?str.slice(0,n).trim()+'...':str;}

  function buildSlide(anime, idx) {
    var isFirst = idx === 0;
    var title = anime.title || 'Unknown';
    var syno = truncate(anime.synopsis || 'No synopsis available.', 200);
    var img = anime.image || '';
    var slug = anime.slug || ('anime-' + anime.id);
    var score = anime.score ? Number(anime.score).toFixed(1) : null;
    var year = anime.year || '';
    var eps = anime.episodes && anime.episodes > 0 ? anime.episodes : '?';
    var type = anime.subtype || 'TV';
    var isAiring = anime.status === 'current';
    var genre = (anime.genres && anime.genres.length) ? anime.genres[0] : '';

    var trendingHtml = isFirst 
      ? '<div class="trending-pill"><span class="flame">🔥</span><span>#1 Trending Now</span></div>' 
      : '';

    var badges = '<div class="badges">' +
      '<div class="badge badge-hd">HD</div>' +
      (isAiring ? '<div class="badge badge-live"><span class="live-dot-mini"></span>AIRING</div>' : '') +
      (type ? '<div class="badge badge-studio">' + esc(type) + '</div>' : '') +
    '</div>';

    var meta = '<div class="slide-meta">' +
      (year ? '<span>' + esc(year) + '</span>' : '') +
      '<span>' + esc(type) + '</span>' +
      '<span>' + esc(eps) + ' EP</span>' +
      (genre ? '<span class="genre-tag">' + esc(genre) + '</span>' : '') +
      (score ? '<span class="rating"><svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' + score + '</span>' : '') +
    '</div>';

    var coverHtml = img ? (
      '<div class="cover-frame">' +
        '<div class="cover-container">' +
          '<div class="cover-border-glow"></div>' +
          '<div class="cover-glow"></div>' +
          '<div class="cover-inner">' +
            '<img src="' + esc(img) + '" alt="' + esc(title) + '" class="cover-img" loading="' + (isFirst ? 'eager' : 'lazy') + '" />' +
            '<div class="sparkle sparkle-1"></div>' +
            '<div class="sparkle sparkle-2"></div>' +
            '<div class="corner-acc corner-tl"></div>' +
            '<div class="corner-acc corner-tr"></div>' +
            '<div class="corner-acc corner-bl"></div>' +
            '<div class="corner-acc corner-br"></div>' +
            (score ? '<div class="score-badge"><div class="score-inner"><div class="score-value">' + score + '</div></div></div>' : '') +
          '</div>' +
        '</div>' +
      '</div>'
    ) : '';

    return '<div class="hero-slide' + (isFirst ? ' active' : '') + '" data-index="' + idx + '">' +
      '<div class="slide-content">' +
        '<div class="slide-left">' +
          trendingHtml +
          badges +
          '<h1 class="slide-title">' + esc(title) + '</h1>' +
          meta +
          '<p class="slide-desc">' + esc(syno) + '</p>' +
          '<div class="slide-actions">' +
            '<a href="/anime/' + esc(slug) + '" class="btn-watch">' +
              '<div class="btn-watch-icon">' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' +
                '<div class="pulse-ring"></div>' +
              '</div>' +
              '<span>Watch Now</span>' +
            '</a>' +
            '<a href="/anime/' + esc(slug) + '" class="btn-info">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>' +
              'More Info' +
            '</a>' +
          '</div>' +
        '</div>' +
        '<div class="slide-right">' + coverHtml + '</div>' +
      '</div>' +
    '</div>';
  }

  function goto(idx) {
    if (slides.length === 0) return;
    slides[current].classList.remove('active');
    if (dots[current]) dots[current].classList.remove('active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
    if (dots[current]) dots[current].classList.add('active');
  }

  function startAuto() {
    clearInterval(interval);
    if (slides.length > 1) interval = setInterval(function(){goto(current+1);}, 8000);
  }

  try {
    var res = await fetch('/api/anime?action=list&category=popular&page=1');
    var json = await res.json();
    if (!json.success || !json.anime || json.anime.length === 0) throw new Error('no data');

    var picks = json.anime.slice(0, 5);
    
    // Build all slides
    slidesEl.innerHTML = picks.map(buildSlide).join('');
    
    // Build dots
    dotsEl.innerHTML = picks.map(function(_, i){
      return '<button class="slide-dot' + (i===0?' active':'') + '" data-index="' + i + '" aria-label="Slide ' + (i+1) + '"></button>';
    }).join('');

    slides = document.querySelectorAll('.hero-slide');
    dots = document.querySelectorAll('.slide-dot');

    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        goto(parseInt(dot.dataset.index));
        startAuto();
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', function(){goto(current-1);startAuto();});
    if (nextBtn) nextBtn.addEventListener('click', function(){goto(current+1);startAuto();});
    
    if (hero) {
      hero.addEventListener('mouseenter', function(){clearInterval(interval);});
      hero.addEventListener('mouseleave', startAuto);
    }

    startAuto();
  } catch (e) {
    console.warn('Hero load failed:', e);
  }
})();
</script>

<style>
  .hero-sec {
    padding: 2rem 0 3rem;
    position: relative;
  }

  .hero-bg-force {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100% - 2rem), 1420px);
    height: calc(100% - 4rem);
    background: linear-gradient(180deg,
      rgba(20, 8, 45, 0.85) 0%,
      rgba(15, 6, 35, 0.9) 100%
    );
    border-radius: 24px;
    z-index: 0;
    pointer-events: none;
    border: 1px solid rgba(192, 132, 252, 0.12);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  [data-theme="light"] .hero-bg-force {
    background: linear-gradient(180deg,
      rgba(20, 8, 45, 0.92) 0%,
      rgba(15, 6, 35, 0.95) 100%
    );
    border-color: rgba(192, 132, 252, 0.2);
    box-shadow: 0 20px 50px rgba(168, 85, 247, 0.15);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding: 2rem 1.5rem;
  }

  .hero-slides {
    position: relative;
    min-height: 560px;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
  }

  .hero-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .slide-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 560px;
  }

  .slide-left {
    animation: slideInLeft 0.7s ease;
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .trending-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.18), rgba(232, 121, 249, 0.18));
    border: 1px solid rgba(251, 146, 60, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--flame);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    backdrop-filter: blur(10px);
  }

  .flame { display: inline-block; font-size: 0.85rem; }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff !important;
    backdrop-filter: blur(10px);
  }

  .badge-studio {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-transform: none;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge-hd {
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan) !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .badge-live {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171 !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .live-dot-mini {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-live 2s ease infinite;
  }

  @keyframes pulse-live {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }

  .slide-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    color: #ffffff !important;
    line-height: 1.02;
    margin-bottom: 0.4rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .slide-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .slide-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .genre-tag {
    background: rgba(192, 132, 252, 0.18);
    color: var(--purple) !important;
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rating {
    background: rgba(251, 191, 36, 0.12);
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #fbbf24 !important;
  }

  .slide-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82) !important;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 520px;
  }

  .slide-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-watch {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1.6rem 0.4rem 0.4rem;
    background: var(--grad);
    border-radius: 999px;
    color: #fff !important;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 8px 25px rgba(192, 132, 252, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .btn-watch:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(192, 132, 252, 0.55);
  }

  .btn-watch-icon {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    animation: pulse-ring-slow 4s ease-out infinite;
  }

  @keyframes pulse-ring-slow {
    0%   { transform: scale(1);   opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .btn-info {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    color: #fff !important;
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.25s ease;
    text-decoration: none;
    backdrop-filter: blur(10px);
  }

  .btn-info:hover {
    background: rgba(125, 211, 252, 0.15);
    border-color: rgba(125, 211, 252, 0.5);
    color: var(--cyan) !important;
    transform: translateY(-2px);
  }

  .slide-right {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    animation: slideInRight 0.7s ease;
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .cover-frame { padding: 20px; max-width: 100%; }

  .cover-container {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 3/4;
  }

  .cover-border-glow {
    position: absolute;
    inset: -2px;
    border-radius: 22px;
    background: conic-gradient(from 0deg, #c084fc, #e879f9, #7dd3fc, #a855f7, #c084fc);
    animation: border-spin 60s linear infinite;
    z-index: 0;
    opacity: 0.5;
    filter: blur(1px);
  }

  @keyframes border-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .cover-glow {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(192, 132, 252, 0.45) 0%,
      rgba(232, 121, 249, 0.25) 30%,
      rgba(125, 211, 252, 0.15) 60%,
      transparent 75%
    );
    filter: blur(50px);
    z-index: 0;
    animation: glow-breathe 8s ease-in-out infinite;
  }

  @keyframes glow-breathe {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.03); }
  }

  .cover-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s ease;
  }

  .cover-inner:hover { transform: scale(1.02); }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-skeleton {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
      rgba(192, 132, 252, 0.08) 25%,
      rgba(192, 132, 252, 0.18) 50%,
      rgba(192, 132, 252, 0.08) 75%
    );
    background-size: 200% 100%;
    animation: sk-shine 1.5s infinite;
  }

  @keyframes sk-shine {
    from { background-position: -200% 0; }
    to   { background-position: 200% 0; }
  }

  .sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px #fff, 0 0 12px var(--cyan);
    animation: sparkle-twinkle 5s ease infinite;
    pointer-events: none;
    z-index: 2;
  }

  .sparkle-1 { top: 20%; left: 15%; animation-delay: 0s; }
  .sparkle-2 { bottom: 25%; right: 20%; animation-delay: 2.5s; }

  @keyframes sparkle-twinkle {
    0%, 100% { opacity: 0; transform: scale(0); }
    50%       { opacity: 1; transform: scale(1.5); }
  }

  .corner-acc {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--cyan);
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 0 4px var(--cyan));
  }

  .corner-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; }
  .corner-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; }
  .corner-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; }
  .corner-br { bottom: 10px; right: 10px; border-left: none; border-top: none; }

  .score-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    animation: float-gentle 5s ease infinite;
  }

  @keyframes float-gentle {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-4px); }
  }

  .score-inner {
    background: var(--grad);
    border-radius: 50%;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff !important;
    box-shadow: 0 6px 20px rgba(192, 132, 252, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.15);
  }

  .score-value {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1;
    color: #fff !important;
  }

  .hero-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding: 0 0.5rem;
  }

  .slide-dots { display: flex; gap: 0.5rem; }

  .slide-dot {
    width: 28px;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .slide-dot:hover { background: rgba(255, 255, 255, 0.4); }

  .slide-dot.active {
    background: var(--grad);
    width: 42px;
    box-shadow: 0 0 10px rgba(192, 132, 252, 0.5);
  }

  .slide-nav { display: flex; gap: 0.4rem; }

  .nav-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    backdrop-filter: blur(10px);
  }

  .nav-btn:hover {
    background: rgba(192, 132, 252, 0.2);
    border-color: rgba(192, 132, 252, 0.5);
    transform: scale(1.1);
  }

  @media (max-width: 1024px) { .cover-container { max-width: 320px; } }

  @media (max-width: 900px) {
    .hero-sec { padding: 1.5rem 0 2.5rem; }
    .hero-bg-force { top: 1.5rem; height: calc(100% - 4rem); }
    .hero-inner { padding: 1.5rem 1rem; }
    .hero-slides { position: relative; min-height: auto; }
    .hero-slide {
      position: relative !important;
      inset: auto !important;
      display: none !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    .hero-slide.active { display: block !important; }
    .slide-content {
      grid-template-columns: 1fr !important;
      gap: 2rem;
      min-height: auto;
      text-align: center;
    }
    .slide-right { order: -1; padding: 0; }
    .cover-frame { padding: 15px; width: 100%; display: flex; justify-content: center; }
    .cover-container { max-width: 240px; }
    .slide-left { padding: 0 0.5rem; }
    .slide-meta { justify-content: center; }
    .slide-desc { margin: 0 auto 1.5rem; }
    .slide-actions { justify-content: center; }
    .trending-pill, .badges { justify-content: center; }
