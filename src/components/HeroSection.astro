  }

  .live-dot-mini {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-live 2s ease infinite;
  }

  @keyframes pulse-live {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }

  .slide-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    color: #ffffff !important;
    line-height: 1.02;
    margin-bottom: 0.4rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .slide-title-jp {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(125, 211, 252, 0.9) !important;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .slide-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .slide-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .genre-tag {
    background: rgba(192, 132, 252, 0.18);
    color: var(--purple) !important;
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rating {
    background: rgba(251, 191, 36, 0.12);
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #fbbf24 !important;
  }

  .slide-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82) !important;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 520px;
  }

  .slide-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-watch {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1.6rem 0.4rem 0.4rem;
    background: var(--grad);
