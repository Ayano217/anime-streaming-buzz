---
let heroAnime = [];
let trendingList = [];

// Try own API first (uses static data — instant + always fresh)
try {
  const baseUrl = Astro.site || 'https://anime-streaming-buzz.pages.dev';
  const res = await fetch(new URL('/api/anime?action=list&category=airing&page=1', baseUrl));
  if (res.ok) {
    const data = await res.json();
    if (data.success && data.anime && data.anime.length > 0) {
      heroAnime = data.anime.slice(0, 5).map(a => ({
        title: a.title,
        synopsis: (a.synopsis || '').substring(0, 180) + '...',
        image: a.image,
        score: a.score,
        year: a.year || '',
        episodes: a.episodes || '?',
        type: a.subtype || 'TV',
        genres: (a.genres || []).slice(0, 3),
        slug: a.slug,
        status: a.status,
        rank: a.rank,
        malId: a.id,
      }));
      // Trending: get from popular/top
      trendingList = data.anime.slice(0, 8);
    }
  }
} catch (e) {
  console.warn('Hero API failed:', e);
}

// Fetch trending separately if we don't have enough
if (trendingList.length < 8) {
  try {
    const baseUrl = Astro.site || 'https://anime-streaming-buzz.pages.dev';
    const res = await fetch(new URL('/api/anime?action=list&category=top&page=1', baseUrl));
    if (res.ok) {
      const data = await res.json();
      if (data.success && data.anime) {
        trendingList = data.anime.slice(0, 8);
      }
    }
  } catch (e) {}
}

// Fallback to Jikan if our API fails
if (heroAnime.length === 0) {
  try {
    const res = await fetch('https://api.jikan.moe/v4/seasons/now?limit=5');
    if (res.ok) {
      const data = await res.json();
      heroAnime = (data.data || []).slice(0, 5).map(a => ({
        title: a.title_english || a.title,
        synopsis: (a.synopsis || '').substring(0, 180) + '...',
        image: a.images?.jpg?.large_image_url || '',
        score: a.score,
        year: a.year || '',
        episodes: a.episodes || '?',
        type: a.type || 'TV',
        genres: (a.genres || []).slice(0, 3).map(g => g.name),
        slug: (a.title_english || a.title || '').toLowerCase().replace(/[^\w\s-]/g,'').replace(/\s+/g,'-').slice(0,80),
        status: a.status,
        rank: a.rank,
        malId: a.mal_id,
      }));
    }
  } catch (e) {}
}

if (heroAnime.length === 0) {
  heroAnime = [{
    title: 'Discover Amazing Anime',
    synopsis: 'The best anime streaming guide, news, and community. Join thousands of fans exploring the latest and greatest anime.',
    image: '',
    score: null, year: '', episodes: '?', type: 'TV',
    genres: [], slug: '', status: '', rank: null,
  }];
}
---

<section class="hero-sec" id="heroSec">
  <div class="hero-bg-force"></div>

  <div class="hero-inner container">

    <!-- ═══ LIVE STATS BAR ═══ -->
    <div class="live-stats">
      <div class="stat-pill live-users">
        <span class="live-dot"></span>
        <span class="stat-num" id="liveUserCount">0</span>
        <span class="stat-label">fans online</span>
      </div>
      <div class="stat-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/></svg>
        <span class="stat-num" id="animeCount">0</span>
        <span class="stat-label">anime tracked</span>
      </div>
      <div class="stat-pill hide-mobile">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span class="stat-label">Updated every 3h</span>
      </div>
    </div>

    <!-- ═══ MAIN GRID: Slider (60%) + Trending (40%) ═══ -->
    <div class="hero-grid">

      <!-- LEFT: Main Slider -->
      <div class="hero-main">
        <div class="hero-slides" id="heroSlides">
          {heroAnime.map((anime, idx) => (
            <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>
              
              <div class="slide-image-wrap">
                {anime.image && (
                  <img src={anime.image} alt={anime.title} class="slide-bg-image" loading={idx === 0 ? 'eager' : 'lazy'} />
                )}
                <div class="slide-gradient"></div>
              </div>
              
              <div class="slide-content-wrap">
                {idx === 0 && (
                  <div class="trending-pill">
                    <span class="flame">🔥</span>
                    <span>Trending Now</span>
                  </div>
                )}

                <div class="slide-badges">
                  {anime.status === 'current' && (
                    <div class="badge badge-live">
                      <span class="live-dot-mini"></span>
                      AIRING
                    </div>
                  )}
                  <div class="badge badge-hd">HD</div>
                  {anime.rank && anime.rank <= 100 && (
                    <div class="badge badge-rank">#{anime.rank}</div>
                  )}
                </div>

                <h1 class="slide-title">{anime.title}</h1>

                <div class="slide-meta">
                  {anime.year && <span>{anime.year}</span>}
                  <span>{anime.type}</span>
                  <span>{anime.episodes} EP</span>
                  {anime.score && (
                    <span class="rating">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="#fbbf24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      {anime.score}
                    </span>
                  )}
                </div>

                {anime.genres.length > 0 && (
                  <div class="slide-genres">
                    {anime.genres.map((g) => (
                      <span class="genre-chip">{g}</span>
                    ))}
                  </div>
                )}

                <p class="slide-desc">{anime.synopsis}</p>

                <div class="slide-actions">
                  <a href={anime.slug ? `/anime/${anime.slug}` : '#'} class="btn-watch">
                    <div class="btn-watch-icon">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                    <span>Watch Now</span>
                  </a>

                  <button class="btn-save" data-anime-id={anime.malId || idx} data-anime-title={anime.title} data-anime-image={anime.image || ''}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                    </svg>
                    <span>Save</span>
                  </button>
                </div>
              </div>
              
            </div>
          ))}
        </div>

        <!-- Slider Controls -->
        <div class="hero-controls">
          <div class="slide-dots">
            {heroAnime.map((_, idx) => (
              <button class={`slide-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}></button>
            ))}
          </div>

          <div class="slide-nav">
            <button class="nav-btn" id="prevBtn" aria-label="Previous">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="nav-btn" id="nextBtn" aria-label="Next">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT: Trending Sidebar + Mini Game -->
      <aside class="hero-side">
        
        <!-- Trending List -->
        <div class="side-card trending-card">
          <div class="side-card-head">
            <div class="side-card-title">
              <span class="tc-icon">🎯</span>
              <span>Trending This Week</span>
            </div>
            <div class="tc-live-badge">
              <span class="live-dot"></span>
              LIVE
            </div>
          </div>
          <div class="trending-list">
            {trendingList.slice(0, 5).map((a, idx) => (
              <a href={`/anime/${a.slug}`} class="trending-item">
                <div class="tr-rank">
                  <span class={`tr-rank-num ${idx < 3 ? 'top' : ''}`}>#{idx + 1}</span>
                </div>
                <div class="tr-poster">
                  {a.image && <img src={a.image} alt={a.title} loading="lazy" />}
                </div>
                <div class="tr-info">
                  <div class="tr-title">{a.title}</div>
                  <div class="tr-meta">
                    {a.score && (
                      <span class="tr-score">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {a.score}
                      </span>
                    )}
                    {a.episodes && a.episodes > 0 && <span>{a.episodes} EP</span>}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Mini Game: Spin & Discover -->
        <div class="side-card spin-card">
          <div class="side-card-head">
            <div class="side-card-title">
              <span class="tc-icon">🎰</span>
              <span>Feeling Lucky?</span>
            </div>
          </div>
          <div class="spin-content">
            <div class="spin-desc">Spin the wheel to discover your next anime!</div>
            <button class="spin-btn" id="spinBtn">
              <div class="spin-btn-inner">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="spin-icon">
                  <path d="M21 12a9 9 0 11-6.219-8.56"/>
                </svg>
                <span>Spin Now</span>
              </div>
              <div class="spin-btn-glow"></div>
            </button>
            <div class="spin-result" id="spinResult"></div>
          </div>
        </div>

      </aside>
    </div>

  </div>
</section>

<script is:inline define:vars={{ trendingList }}>
(function() {
  // ═══ SLIDER LOGIC ═══
  var slides = document.querySelectorAll('.hero-slide');
  var dots = document.querySelectorAll('.slide-dot');
  var current = 0;
  var interval;

  function goto(idx){
    if (slides.length === 0) return;
    slides[current].classList.remove('active');
    dots[current] && dots[current].classList.remove('active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current] && dots[current].classList.add('active');
  }

  function next(){ goto(current + 1); }
  function prev(){ goto(current - 1); }

  function startAuto(){
    clearInterval(interval);
    if (slides.length > 1) interval = setInterval(next, 8000);
  }

  dots.forEach(function(dot){
    dot.addEventListener('click', function(){
      goto(parseInt(dot.dataset.index));
      startAuto();
    });
  });

  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  if(prevBtn) prevBtn.addEventListener('click', function(){ prev(); startAuto(); });
  if(nextBtn) nextBtn.addEventListener('click', function(){ next(); startAuto(); });

  var hero = document.getElementById('heroSec');
  if(hero) {
    hero.addEventListener('mouseenter', function(){ clearInterval(interval); });
    hero.addEventListener('mouseleave', startAuto);
  }

  startAuto();

  // ═══ LIVE USER COUNT (realistic simulation) ═══
  function generateUserCount() {
    // Base count based on hour (peak evening, low late night)
    var hour = new Date().getHours();
    var baseUsers;
    if (hour >= 18 && hour <= 23) baseUsers = 850; // evening peak
    else if (hour >= 12 && hour <= 17) baseUsers = 620; // afternoon
    else if (hour >= 8 && hour <= 11) baseUsers = 380; // morning
    else if (hour >= 0 && hour <= 3) baseUsers = 220; // late night
    else baseUsers = 450;
    
    // Add random variance
    var variance = Math.floor(Math.random() * 80) - 40;
    return baseUsers + variance;
  }

  function animateCount(el, target, duration) {
    if (!el) return;
    var start = parseInt(el.textContent) || 0;
    var range = target - start;
    var startTime = Date.now();
    
    function update() {
      var elapsed = Date.now() - startTime;
      var progress = Math.min(elapsed / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(start + range * eased).toLocaleString();
      if (progress < 1) requestAnimationFrame(update);
    }
    update();
  }

  var userCountEl = document.getElementById('liveUserCount');
  var animeCountEl = document.getElementById('animeCount');
  
  if (userCountEl) {
    animateCount(userCountEl, generateUserCount(), 2000);
    // Update every 30 seconds with slight variation
    setInterval(function() {
      var current = parseInt(userCountEl.textContent.replace(/,/g, '')) || 0;
      var change = Math.floor(Math.random() * 20) - 10;
      var newCount = Math.max(100, current + change);
      animateCount(userCountEl, newCount, 1500);
    }, 30000);
  }

  // Fetch actual anime count from API
  if (animeCountEl) {
    fetch('/api/anime?action=list&category=airing&page=1')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var count = data && data.total ? data.total : 200;
        // Round up to make it feel more impressive
        var displayCount = Math.max(count, 200);
        animateCount(animeCountEl, displayCount, 2500);
      })
      .catch(function() {
        animateCount(animeCountEl, 250, 2500);
      });
  }

  // ═══ SAVE BUTTON ═══
  document.querySelectorAll('.btn-save').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var id = btn.dataset.animeId;
      var title = btn.dataset.animeTitle;
      var image = btn.dataset.animeImage;
      
      var saved = JSON.parse(localStorage.getItem('savedAnime') || '[]');
      var existing = saved.findIndex(function(x) { return String(x.id) === String(id); });
      
      if (existing >= 0) {
        saved.splice(existing, 1);
        btn.classList.remove('saved');
        btn.querySelector('span').textContent = 'Save';
      } else {
        saved.push({ id: id, title: title, image: image, savedAt: Date.now() });
        btn.classList.add('saved');
        btn.querySelector('span').textContent = 'Saved';
      }
      
      localStorage.setItem('savedAnime', JSON.stringify(saved));
    });
    
    // Check if already saved
    var id = btn.dataset.animeId;
    var saved = JSON.parse(localStorage.getItem('savedAnime') || '[]');
    if (saved.some(function(x) { return String(x.id) === String(id); })) {
      btn.classList.add('saved');
      btn.querySelector('span').textContent = 'Saved';
    }
  });

  // ═══ SPIN GAME ═══
  var spinBtn = document.getElementById('spinBtn');
  var spinResult = document.getElementById('spinResult');
  var spinData = trendingList || [];
  
  if (spinBtn && spinResult && spinData.length > 0) {
    spinBtn.addEventListener('click', function() {
      if (spinBtn.classList.contains('spinning')) return;
      
      spinBtn.classList.add('spinning');
      spinResult.innerHTML = '<div class="spin-loading"><span>Rolling the dice...</span></div>';
      spinResult.classList.add('show');
      
      setTimeout(function() {
        var random = spinData[Math.floor(Math.random() * spinData.length)];
        var imageHtml = random.image 
          ? '<img src="' + random.image + '" alt="" loading="lazy" />' 
          : '<div class="sr-no-img">🎬</div>';
        
        spinResult.innerHTML = 
          '<a href="/anime/' + random.slug + '" class="spin-winner">' +
            '<div class="sw-poster">' + imageHtml + '</div>' +
            '<div class="sw-info">' +
              '<div class="sw-label">✨ Your Pick</div>' +
              '<div class="sw-title">' + random.title + '</div>' +
              (random.score ? '<div class="sw-score">⭐ ' + random.score + '</div>' : '') +
              '<div class="sw-cta">Check it out →</div>' +
            '</div>' +
          '</a>';
        
        spinBtn.classList.remove('spinning');
      }, 1200);
    });
  }
})();
</script>

<style>
  .hero-sec { 
    padding: 1.5rem 0 2rem; 
    position: relative; 
  }
  
  .hero-bg-force {
    position: absolute; 
    top: 1.5rem; 
    left: 50%; 
    transform: translateX(-50%);
    width: min(calc(100% - 2rem), 1420px); 
    height: calc(100% - 3rem);
    background: linear-gradient(180deg, rgba(20, 8, 45, 0.5) 0%, rgba(15, 6, 35, 0.6) 100%);
    border-radius: 24px; 
    z-index: 0; 
    pointer-events: none;
    border: 1px solid rgba(192, 132, 252, 0.1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
  }
  
  [data-theme="light"] .hero-bg-force {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(243, 232, 255, 0.9) 100%);
    border-color: rgba(192, 132, 252, 0.25);
    box-shadow: 0 20px 50px rgba(168, 85, 247, 0.12);
  }
  
  .hero-inner { 
    position: relative; 
    z-index: 1; 
    padding: 1.5rem 1.5rem 2rem; 
  }
  
  /* ═══ LIVE STATS BAR ═══ */
  .live-stats {
    display: flex;
    gap: 8px;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.2);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary);
    backdrop-filter: blur(10px);
  }
  
  .stat-pill svg { color: #c084fc; }
  
  .stat-pill.live-users {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.3);
    color: #10b981;
  }
  
  .stat-num {
    font-weight: 800;
    color: var(--text-primary);
  }
  
  .stat-pill.live-users .stat-num { color: #10b981; }
  
  .stat-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.62rem;
  }
  
  .stat-pill.live-users .stat-label { color: rgba(16, 185, 129, 0.7); }
  
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: livePulse 2s ease infinite;
  }
  
  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }
  
  /* ═══ MAIN GRID ═══ */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: stretch;
  }
  
  /* ═══ MAIN SLIDER ═══ */
  .hero-main {
    display: flex;
    flex-direction: column;
  }
  
  .hero-slides {
    position: relative;
    height: 480px;
    border-radius: 20px;
    overflow: hidden;
    background: #0d0520;
  }
  
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
  }
  
  .hero-slide.active {
    opacity: 1;
    visibility: visible;
  }
  
  .slide-image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  
  .slide-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 8s ease;
  }
  
  .hero-slide.active .slide-bg-image {
    transform: scale(1);
  }
  
  .slide-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, 
      rgba(10, 5, 23, 0.95) 0%,
      rgba(10, 5, 23, 0.85) 40%,
      rgba(10, 5, 23, 0.5) 70%,
      rgba(10, 5, 23, 0.2) 100%);
  }
  
  .slide-content-wrap {
    position: absolute;
    inset: 0;
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 60%;
  }
  
  .trending-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.25), rgba(232, 121, 249, 0.25));
    border: 1px solid rgba(251, 146, 60, 0.5);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 800;
    color: #fb923c;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    width: fit-content;
    backdrop-filter: blur(10px);
  }
  
  .flame { font-size: 0.85rem; }
  
  .slide-badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }
  
  .badge-live {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }
  
  .badge-hd {
    background: rgba(125, 211, 252, 0.2);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: #7dd3fc;
  }
  
  .badge-rank {
    background: linear-gradient(135deg, #c084fc, #e879f9);
    color: #fff;
    border: none;
    box-shadow: 0 3px 10px rgba(192, 132, 252, 0.4);
  }
  
  .live-dot-mini {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 6px #ef4444;
    animation: livePulse 1.5s ease infinite;
  }
  
  .slide-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }
  
