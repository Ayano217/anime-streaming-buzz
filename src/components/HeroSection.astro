---
let heroAnime = [];

try {
  const res = await fetch('https://api.jikan.moe/v4/top/anime?filter=airing&limit=5');
  if (res.ok) {
    const data = await res.json();
    heroAnime = (data.data || []).slice(0, 5).map(a => ({
      title:    a.title_english || a.title,
      titleJp:  a.title_japanese || '',
      synopsis: (a.synopsis || '').substring(0, 200) + '...',
      image:    a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '',
      score:    a.score,
      year:     a.year || '',
      episodes: a.episodes || '?',
      type:     a.type || 'TV',
      studio:   a.studios?.[0]?.name || 'Studio',
      genres:   (a.genres || []).slice(0, 3).map(g => g.name),
      malUrl:   a.url,
      malId:    a.mal_id,
      status:   a.status || '',
      members:  a.members || 0,
      rank:     a.rank || null,
    }));
  }
} catch (e) {
  console.warn('Jikan hero failed:', e);
}

if (heroAnime.length === 0) {
  heroAnime = [{
    title: 'Loading Trending Anime',
    titleJp: '',
    synopsis: 'Fetching the hottest anime right now.',
    image: '',
    score: null, year: '', episodes: '?', type: 'TV',
    studio: 'AniTube', genres: [], malUrl: '#', members: 0,
  }];
}

// Latest news
import { getCollection } from 'astro:content';
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const displayEpisodes = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter(post => {
    const img = post.data.image || '';
    return img && !img.includes('picsum.photos');
  })
  .slice(0, 4);
---

<section class="hero-sec" id="heroSec">
  <!-- Force dark background for hero always (readable in both themes) -->
  <div class="hero-bg-force"></div>

  <div class="hero-inner container">

    <div class="hero-slides" id="heroSlides">
      {heroAnime.map((anime, idx) => (
        <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>

          <div class="slide-content">

            <!-- LEFT INFO -->
            <div class="slide-left">

              {idx === 0 && (
                <div class="trending-pill">
                  <span class="flame">🔥</span>
                  <span>#1 Trending Now</span>
                </div>
              )}

              <div class="badges">
                {anime.studio && (
                  <div class="badge badge-studio">
                    <div class="badge-icon">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/></svg>
                    </div>
                    {anime.studio}
                  </div>
                )}
                <div class="badge badge-hd">HD</div>
                {anime.status === 'Currently Airing' && (
                  <div class="badge badge-live">
                    <span class="live-dot-mini"></span>
                    AIRING
                  </div>
                )}
              </div>

              <h1 class="slide-title">{anime.title}</h1>
              {anime.titleJp && <p class="slide-title-jp">{anime.titleJp}</p>}

              <div class="slide-meta">
                {anime.year && <span>{anime.year}</span>}
                <span>{anime.type}</span>
                <span>{anime.episodes} EP</span>
                {anime.genres.length > 0 && (
                  <span class="genre-tag">{anime.genres[0]}</span>
                )}
                {anime.score && (
                  <span class="rating">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    {anime.score}
                  </span>
                )}
              </div>

              <p class="slide-desc">{anime.synopsis}</p>

              <div class="slide-actions">
                <a href={anime.malUrl} target="_blank" rel="noopener" class="btn-watch">
                  <div class="btn-watch-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    <div class="pulse-ring"></div>
                  </div>
                  <span>Watch Now</span>
                </a>

                <a href={anime.malUrl} target="_blank" rel="noopener" class="btn-info">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4M12 8h.01"/>
                  </svg>
                  More Info
                </a>
              </div>

            </div>

            <!-- RIGHT COVER -->
            <div class="slide-right">
              {anime.image && (
                <div class="cover-container" data-tilt>
                  <div class="cover-border"></div>
                  <div class="cover-backdrop"></div>

                  <div class="cover-inner">
                    <img
                      src={anime.image}
                      alt={anime.title}
                      class="cover-img"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                    />

                    <div class="cover-sparkles">
                      <div class="sparkle sparkle-1"></div>
                      <div class="sparkle sparkle-2"></div>
                      <div class="sparkle sparkle-3"></div>
                    </div>

                    <div class="corner-acc corner-tl"></div>
                    <div class="corner-acc corner-tr"></div>
                    <div class="corner-acc corner-bl"></div>
                    <div class="corner-acc corner-br"></div>
                  </div>

                  {anime.score && (
                    <div class="score-float">
                      <div class="score-inner">
                        <div class="score-value">{anime.score}</div>
                        <div class="score-label">
                          {[1,2,3,4,5].map(s => (
                            <svg width="6" height="6" viewBox="0 0 24 24" fill={s <= Math.round(anime.score/2) ? '#fbbf24' : 'rgba(255,255,255,0.2)'}>
                              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}

                  {anime.rank && anime.rank <= 100 && (
                    <div class="rank-float">
                      <div class="rank-hash">#</div>
                      <div class="rank-num">{anime.rank}</div>
                    </div>
                  )}

                </div>
              )}
            </div>

          </div>

        </div>
      ))}
    </div>

    <div class="hero-controls">
      <div class="slide-dots">
        {heroAnime.map((_, idx) => (
          <button class={`slide-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}></button>
        ))}
      </div>

      <div class="slide-nav">
        <button class="nav-btn" id="prevBtn" aria-label="Previous">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="nav-btn" id="nextBtn" aria-label="Next">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    {displayEpisodes.length > 0 && (
      <div class="latest-updates">
        <div class="latest-header">
          <h2 class="latest-title">
            <span class="latest-bar"></span>
            <span class="grad-text">Latest</span> <span class="tube-txt-adaptive">Updates</span>
          </h2>
          <a href="/category/news" class="latest-more">View All →</a>
        </div>

        <div class="updates-grid">
          {displayEpisodes.map((post) => {
            const dateStr = new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            const cat = post.data.category || 'News';
            return (
              <a href={`/posts/${post.slug}`} class="update-card">
                <div class="update-thumb">
                  {post.data.image && !post.data.image.includes('picsum') ? (
                    <img src={post.data.image} alt={post.data.title} loading="lazy" />
                  ) : (
                    <div class="update-fallback">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
                        <path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/>
                      </svg>
                    </div>
                  )}
                  <div class="update-play-overlay">
                    <div class="update-play-btn">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                  <div class="update-date">{dateStr}</div>
                </div>
                <div class="update-info">
                  <div class="update-cat">{cat}</div>
                  <div class="update-title">{post.data.title}</div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

  </div>
</section>

<script is:inline>
(function() {
  var slides = document.querySelectorAll('.hero-slide');
  var dots   = document.querySelectorAll('.slide-dot');
  var current = 0;
  var interval;

  if(slides.length === 0) return;

  function goto(idx){
    slides[current].classList.remove('active');
    dots[current] && dots[current].classList.remove('active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current] && dots[current].classList.add('active');
  }

  function next(){ goto(current + 1); }
  function prev(){ goto(current - 1); }

  function startAuto(){
    clearInterval(interval);
    interval = setInterval(next, 10000);
  }

  dots.forEach(function(dot){
    dot.addEventListener('click', function(){
      goto(parseInt(dot.dataset.index));
      startAuto();
    });
  });

  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  if(prevBtn) prevBtn.addEventListener('click', function(){ prev(); startAuto(); });
  if(nextBtn) nextBtn.addEventListener('click', function(){ next(); startAuto(); });

  var hero = document.getElementById('heroSec');
  if(hero) {
    hero.addEventListener('mouseenter', function(){ clearInterval(interval); });
    hero.addEventListener('mouseleave', startAuto);
  }

  if(slides.length > 1) startAuto();

  // ═══ 3D TILT — only on desktop ═══
  if(window.innerWidth > 900) {
    var tiltEls = document.querySelectorAll('[data-tilt]');
    tiltEls.forEach(function(el){
      var rect;

      el.addEventListener('mouseenter', function(){
        rect = el.getBoundingClientRect();
      });

      el.addEventListener('mousemove', function(e){
        if(!rect) rect = el.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var cx = rect.width / 2;
        var cy = rect.height / 2;
        var rx = ((y - cy) / cy) * -6;
        var ry = ((x - cx) / cx) * 6;
        el.style.transform = 'perspective(1200px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) scale(1.02)';
      });

      el.addEventListener('mouseleave', function(){
        el.style.transform = 'perspective(1200px) rotateX(0) rotateY(0) scale(1)';
      });
    });
  }

})();
</script>

<style>
  /* ═══ HERO WRAPPER ═══ */
  .hero-sec {
    padding: 2.5rem 0 3rem;
    position: relative;
  }

  /* ═══ FORCE DARK BG FOR HERO (readable in both themes) ═══ */
  .hero-bg-force {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100% - 2rem), 1420px);
    height: 720px;
    background: linear-gradient(180deg,
      rgba(20, 8, 45, 0.85) 0%,
      rgba(15, 6, 35, 0.9) 100%
    );
    border-radius: var(--radius-xl);
    z-index: 0;
    pointer-events: none;
    border: 1px solid rgba(192, 132, 252, 0.12);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  [data-theme="light"] .hero-bg-force {
    background: linear-gradient(180deg,
      rgba(20, 8, 45, 0.92) 0%,
      rgba(15, 6, 35, 0.95) 100%
    );
    border-color: rgba(192, 132, 252, 0.2);
    box-shadow: 0 20px 50px rgba(168, 85, 247, 0.15);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  /* ═══ SLIDES ═══ */
  .hero-slides {
    position: relative;
    min-height: 580px;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease;
  }

  .hero-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .slide-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 580px;
  }

  /* ═══ LEFT INFO ═══ */
  .slide-left {
    animation: slideInLeft 0.9s ease;
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .trending-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.18), rgba(232, 121, 249, 0.18));
    border: 1px solid rgba(251, 146, 60, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--flame);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    backdrop-filter: blur(10px);
  }

  .flame {
    display: inline-block;
    animation: flame-shake 2.5s ease infinite;
    font-size: 0.85rem;
  }

  @keyframes flame-shake {
    0%, 100% { transform: rotate(0) scale(1); }
    25%       { transform: rotate(-6deg) scale(1.08); }
    75%       { transform: rotate(6deg)  scale(1.08); }
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff !important;
    backdrop-filter: blur(10px);
  }

  .badge-studio {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding-left: 0.35rem;
    text-transform: none;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge-icon {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .badge-hd {
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan) !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .badge-live {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171 !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .live-dot-mini {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-live 2s ease infinite;
  }

  @keyframes pulse-live {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(1.2); }
  }

  /* Title — ALWAYS WHITE regardless of theme */
  .slide-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    color: #ffffff !important;
    line-height: 1.02;
    margin-bottom: 0.4rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .slide-title-jp {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(125, 211, 252, 0.9) !important;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  /* Meta — ALWAYS WHITE */
  .slide-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .slide-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .genre-tag {
    background: rgba(192, 132, 252, 0.18);
    color: var(--purple) !important;
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .rating {
    background: rgba(251, 191, 36, 0.12);
    padding: 0.2rem 0.6rem !important;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #fbbf24 !important;
  }

  /* Description — ALWAYS WHITE */
  .slide-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82) !important;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 520px;
  }

  /* Actions */
  .slide-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-watch {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1.6rem 0.4rem 0.4rem;
    background: var(--grad);
    border-radius: 999px;
    color: #fff !important;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 8px 25px rgba(192, 132, 252, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    border: none;
  }

  .btn-watch:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(192, 132, 252, 0.55);
  }

  .btn-watch-icon {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
  }

  /* ═══ SLOW pulse ring ═══ */
  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    animation: pulse-ring-slow 3s ease-out infinite;
    will-change: transform, opacity;
  }

  @keyframes pulse-ring-slow {
    0%   { transform: scale(1);   opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .btn-info {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    color: #fff !important;
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.25s ease;
    text-decoration: none;
    backdrop-filter: blur(10px);
  }

  .btn-info:hover {
    background: rgba(125, 211, 252, 0.15);
    border-color: rgba(125, 211, 252, 0.5);
    color: var(--cyan) !important;
    transform: translateY(-2px);
  }

  /* ═══ RIGHT COVER ═══ */
  .slide-right {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    animation: slideInRight 0.9s ease;
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .cover-container {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 3/4;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    cursor: pointer;
    will-change: transform;
  }

  /* ═══ SLOW ROTATING BORDER (20 seconds) ═══ */
  .cover-border {
    position: absolute;
    inset: -3px;
    border-radius: calc(var(--radius-lg) + 3px);
    background: conic-gradient(
      from 0deg,
      #c084fc 0deg,
      #e879f9 90deg,
      #7dd3fc 180deg,
      #a855f7 270deg,
      #c084fc 360deg
    );
    animation: border-rotate 20s linear infinite;
    opacity: 0.6;
    z-index: 0;
    filter: blur(1px);
    will-change: transform;
  }

  @keyframes border-rotate {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ═══ SLOW backdrop pulse ═══ */
  .cover-backdrop {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(192, 132, 252, 0.55) 0%,
      rgba(232, 121, 249, 0.3) 30%,
      rgba(125, 211, 252, 0.2) 60%,
      transparent 75%
    );
    filter: blur(60px);
    animation: backdrop-pulse 8s ease infinite;
    z-index: 0;
    will-change: opacity, transform;
  }

  @keyframes backdrop-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%       { opacity: 0.85; transform: scale(1.05); }
  }

  .cover-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px #fff, 0 0 12px var(--cyan);
    animation: sparkle-twinkle 4s ease infinite;
    will-change: opacity, transform;
  }

  .sparkle-1 { top: 15%; left: 20%; animation-delay: 0s; }
  .sparkle-2 { top: 65%; right: 15%; animation-delay: 1.5s; }
