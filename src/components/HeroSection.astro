---
let heroAnime = [];

try {
  const res = await fetch('https://api.jikan.moe/v4/top/anime?filter=airing&limit=5');
  if (res.ok) {
    const data = await res.json();
    heroAnime = (data.data || []).slice(0, 5).map(a => ({
      title:    a.title_english || a.title,
      titleJp:  a.title_japanese || '',
      synopsis: (a.synopsis || '').substring(0, 200) + '...',
      image:    a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '',
      score:    a.score,
      year:     a.year || '',
      episodes: a.episodes || '?',
      type:     a.type || 'TV',
      studio:   a.studios?.[0]?.name || 'Studio',
      genres:   (a.genres || []).slice(0, 2).map(g => g.name),
      malUrl:   a.url,
      status:   a.status || '',
      malId:    a.mal_id,
    }));
  }
} catch (e) {
  console.warn('Jikan hero failed:', e);
}

if (heroAnime.length === 0) {
  heroAnime = [{
    title: 'Discover Anime',
    synopsis: 'Explore the latest anime series and streaming guides.',
    image: '', score: null, year: 2025, episodes: '?', type: 'TV',
    studio: 'AniTube', genres: ['Anime'], malUrl: '#', status: 'Featured',
  }];
}

// Fetch latest news posts, filter out ones with picsum placeholder
import { getCollection } from 'astro:content';
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestNews = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter(post => {
    const img = post.data.image || '';
    // Skip picsum placeholders — only real anime images
    return img && !img.includes('picsum.photos') && !img.includes('placeholder');
  })
  .slice(0, 4);

// If not enough good posts, get whatever we have
const displayEpisodes = latestNews.length >= 4
  ? latestNews
  : allPosts
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
      .slice(0, 4);
---

<section class="hero-strm" id="heroStrm">
  <div class="hero-strm-cnt container">

    <div class="hero-strm-slides" id="heroSlides">
      {heroAnime.map((anime, idx) => (
        <div class={`hero-strm-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>

          <div class="hero-strm-inner">

            <!-- Backdrop tint image behind everything -->
            {anime.image && (
              <div class="hero-backdrop" style={`background-image: url(${anime.image})`}></div>
            )}
            <div class="hero-backdrop-tint"></div>

            <!-- Left Info -->
            <div class="hero-info">

              <div class="hero-badges-top">
                <div class="hero-studio-badge">
                  <div class="studio-icon">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/>
                    </svg>
                  </div>
                  <span>{anime.studio}</span>
                  <span class="studio-orig">Original</span>
                </div>

                <div class="hero-quality-badge">
                  <span class="quality-dot"></span>
                  <span>HD</span>
                </div>

                <div class="hero-new-badge">
                  <span class="new-pulse"></span>
                  <span>NEW</span>
                </div>
              </div>

              <h1 class="hero-strm-title">{anime.title}</h1>

              {anime.titleJp && (
                <p class="hero-title-jp">{anime.titleJp}</p>
              )}

              <div class="hero-strm-meta">
                {anime.year && <span class="meta-pill meta-year">{anime.year}</span>}
                <span class="meta-pill meta-eps">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" style="opacity:0.7">
                    <path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                  </svg>
                  {anime.episodes} EP
                </span>
                {anime.genres.length > 0 && (
                  <span class="meta-pill meta-genre">{anime.genres[0]}</span>
                )}
                {anime.score && (
                  <span class="meta-pill meta-rating">
                    {[1,2,3,4,5].map(s => (
                      <svg width="11" height="11" viewBox="0 0 24 24" fill={s <= Math.round(anime.score/2) ? '#fbbf24' : 'rgba(255,255,255,0.25)'}>
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                    <span class="rating-num">{anime.score}</span>
                  </span>
                )}
              </div>

              <p class="hero-strm-desc">{anime.synopsis}</p>

              <div class="hero-strm-actions">
                <a href={anime.malUrl} target="_blank" rel="noopener" class="hero-play-cta">
                  <div class="play-btn-circle">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <span class="play-cta-txt">Watch Now</span>
                </a>

                <a href={anime.malUrl} target="_blank" rel="noopener" class="hero-info-cta">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4M12 8h.01"/>
                  </svg>
                  <span>More Info</span>
                </a>
              </div>

            </div>

            <!-- Right Poster -->
            <div class="hero-visual">
              {anime.image && (
                <div class="hero-poster-frame">
                  <div class="hero-poster-glow"></div>
                  <div class="hero-poster-wrap">
                    <img
                      src={anime.image}
                      alt={anime.title}
                      class="hero-poster-img"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                  <!-- Corner accents (gaming style) -->
                  <div class="corner corner-tl"></div>
                  <div class="corner corner-tr"></div>
                  <div class="corner corner-bl"></div>
                  <div class="corner corner-br"></div>
                </div>
              )}
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Season tabs -->
    <div class="season-tabs-row">
      <div class="season-tabs">
        <button class="season-tab active">Season 1</button>
        <button class="season-tab">Season 2</button>
        <button class="season-tab">Season 3</button>
        <button class="season-tab">Season 4</button>
        <button class="season-tab">Season 5</button>
      </div>
      <div class="season-count">
        <span class="grad-text">Live</span>
        <span class="live-dot"></span>
      </div>
    </div>

    <!-- Latest news / episodes -->
    {displayEpisodes.length > 0 && (
      <div class="episodes-row">
        {displayEpisodes.map((post, idx) => {
          const dateStr = new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          const cat = (post.data.category || 'News');
          const catSlug = cat.toLowerCase().replace(/\s+/g, '-');
          return (
            <a href={`/posts/${post.slug}`} class="episode-card">
              <div class="ep-thumb">
                {post.data.image && !post.data.image.includes('picsum') ? (
                  <img src={post.data.image} alt={post.data.title} loading="lazy" />
                ) : (
                  <div class="ep-thumb-fallback">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
                      <path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z"/>
                    </svg>
                  </div>
                )}
                <div class="ep-play-overlay">
                  <div class="ep-play-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
                <div class="ep-date-badge">{dateStr}</div>
                <div class="ep-hd-badge">HD</div>
              </div>
              <div class="ep-info">
                <div class="ep-cat">{cat}</div>
                <div class="ep-title">{post.data.title}</div>
              </div>
            </a>
          );
        })}
      </div>
    )}

    <!-- Slide dots -->
    <div class="hero-strm-dots">
      {heroAnime.map((_, idx) => (
        <button class={`strm-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}></button>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    var slides = document.querySelectorAll('.hero-strm-slide');
    var dots   = document.querySelectorAll('.strm-dot');
    var current = 0;
    var interval;

    if(slides.length === 0) return;

    function goto(idx){
      slides[current].classList.remove('active');
      dots[current] && dots[current].classList.remove('active');
      current = (idx + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current] && dots[current].classList.add('active');
    }

    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        clearInterval(interval);
        goto(parseInt(dot.dataset.index));
        interval = setInterval(function(){ goto(current + 1); }, 7000);
      });
    });

    // Season tabs
    var tabs = document.querySelectorAll('.season-tab');
    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        tabs.forEach(function(t){ t.classList.remove('active'); });
        tab.classList.add('active');
      });
    });

    if(slides.length > 1) {
      interval = setInterval(function(){ goto(current + 1); }, 7000);
    }
  })();
</script>

<style>
  .hero-strm {
    padding: 2rem 0 3rem;
    position: relative;
  }

  /* ═══ SLIDES ═══ */
  .hero-strm-slides {
    position: relative;
    min-height: 520px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    isolation: isolate;
  }

  .hero-strm-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
  }

  .hero-strm-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .hero-strm-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 520px;
    position: relative;
    z-index: 1;
  }

  /* Backdrop blurred image (gives cinematic feel) */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
    filter: blur(30px) brightness(0.35) saturate(1.3);
    transform: scale(1.1);
  }

  .hero-backdrop-tint {
    position: absolute;
    inset: 0;
    background: var(--hero-bg-inner);
    z-index: 0;
    backdrop-filter: brightness(0.7);
  }

  /* ═══ LEFT INFO ═══ */
  .hero-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 2.5rem;
    z-index: 2;
    position: relative;
  }

  .hero-badges-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-studio-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    backdrop-filter: blur(10px);
  }

  .studio-icon {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .studio-orig {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
    font-weight: 500;
    margin-left: 0.2rem;
  }

  .hero-quality-badge, .hero-new-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
  }

  .hero-quality-badge {
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: var(--cyan);
    box-shadow: 0 0 15px rgba(125, 211, 252, 0.2);
  }

  .quality-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .hero-new-badge {
    background: rgba(240, 171, 252, 0.15);
    border: 1px solid rgba(240, 171, 252, 0.4);
    color: var(--pink);
    box-shadow: 0 0 15px rgba(240, 171, 252, 0.2);
  }

  .new-pulse {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 8px var(--pink);
    animation: pulse-new 1.5s ease infinite;
  }

  @keyframes pulse-new {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(1.2); }
  }

  .hero-strm-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    color: #ffffff !important;
    line-height: 1.05;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .hero-title-jp {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(125, 211, 252, 0.85);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-strm-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }

  .meta-year {
    font-family: var(--font-mono);
    background: rgba(125, 211, 252, 0.12);
    color: var(--cyan);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .meta-genre {
    background: rgba(192, 132, 252, 0.15);
    color: var(--purple);
    border-color: rgba(192, 132, 252, 0.3);
  }

  .meta-rating {
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.3);
  }

  .rating-num {
    color: #fbbf24;
    font-weight: 700;
    margin-left: 3px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .hero-strm-desc {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85) !important;
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 500px;
  }

  /* ═══ CTA BUTTONS ═══ */
  .hero-strm-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-play-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    padding: 0.35rem 1.3rem 0.35rem 0.35rem;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    text-decoration: none;
    color: #fff;
  }

  .hero-play-cta:hover {
    background: rgba(192, 132, 252, 0.2);
    border-color: rgba(192, 132, 252, 0.5);
    transform: translateY(-2px);
    box-shadow: var(--neon-purple);
  }

  .play-btn-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--grad);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding-left: 3px;
    box-shadow: 0 4px 15px rgba(192, 132, 252, 0.4);
  }

  .play-cta-txt {
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
  }

  .hero-info-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
    text-decoration: none;
    backdrop-filter: blur(10px);
  }

  .hero-info-cta:hover {
    background: rgba(125, 211, 252, 0.1);
    border-color: rgba(125, 211, 252, 0.5);
    color: var(--cyan);
    box-shadow: var(--neon-cyan);
  }

  /* ═══ RIGHT POSTER ═══ */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .hero-poster-frame {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 3/4;
  }

  .hero-poster-glow {
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(192, 132, 252, 0.5) 0%,
      rgba(240, 171, 252, 0.3) 30%,
      rgba(125, 211, 252, 0.2) 60%,
      transparent 75%
    );
    filter: blur(50px);
    animation: poster-glow 4s ease infinite;
    z-index: 0;
  }

  @keyframes poster-glow {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.05); }
  }

  .hero-poster-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    z-index: 1;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .hero-poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: img-in 1s ease forwards;
  }

  @keyframes img-in {
    from { transform: scale(1.05); opacity: 0.5; }
    to   { transform: scale(1);    opacity: 1; }
  }

  /* Corner accents (gaming HUD style) */
  .corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 2px solid var(--purple);
    z-index: 2;
    opacity: 0.7;
  }

  .corner-tl { top: -6px; left: -6px; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
  .corner-tr { top: -6px; right: -6px; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
  .corner-bl { bottom: -6px; left: -6px; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
  .corner-br { bottom: -6px; right: -6px; border-left: none; border-top: none; border-radius: 0 0 6px 0; }

  /* ═══ SEASON TABS ═══ */
  .season-tabs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .season-tabs {
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 0;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
  }
  .season-tabs::-webkit-scrollbar { display: none; }

  .season-tab {
    padding: 0.55rem 1.3rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    backdrop-filter: blur(10px);
  }

  .season-tab:hover {
    background: rgba(192, 132, 252, 0.1);
    color: var(--text-primary);
    border-color: rgba(192, 132, 252, 0.3);
  }

  .season-tab.active {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 4px 15px rgba(192, 132, 252, 0.35);
  }

  .season-count {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-new 1.5s ease infinite;
  }

  /* ═══ EPISODES ROW ═══ */
  .episodes-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .episode-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
    backdrop-filter: blur(10px);
    position: relative;
  }

  .episode-card:hover {
    transform: translateY(-5px);
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 12px 30px rgba(192, 132, 252, 0.2);
  }

  .ep-thumb {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .ep-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .episode-card:hover .ep-thumb img { transform: scale(1.1); }

  .ep-thumb-fallback {
