---
let heroAnime = [];

try {
  const res = await fetch('https://api.jikan.moe/v4/top/anime?filter=airing&limit=5');
  if (res.ok) {
    const data = await res.json();
    heroAnime = (data.data || []).slice(0, 5).map(a => ({
      title:    a.title_english || a.title,
      titleJp:  a.title_japanese || '',
      synopsis: (a.synopsis || '').substring(0, 180) + '...',
      image:    a.images?.jpg?.large_image_url || a.images?.jpg?.image_url || '',
      score:    a.score,
      year:     a.year || '',
      genre:    (a.genres?.[0]?.name) || 'Anime',
      malUrl:   a.url,
      season:   a.status === 'Currently Airing' ? 'Now Airing' : (a.status || 'New Season'),
    }));
  }
} catch (e) {
  console.warn('Jikan fetch failed:', e);
}

if (heroAnime.length === 0) {
  heroAnime = [{
    title: 'Discover Anime',
    titleJp: '',
    synopsis: 'Explore latest anime series, official trailers, and streaming guides.',
    image: '',
    score: null, year: '', genre: 'Anime', malUrl: '#',
    season: 'Coming Soon',
  }];
}

const firstDate = new Date().toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<section class="hero" id="heroSec">
  <div class="hero-cnt container">

    <div class="hero-slides" id="heroSlides">
      {heroAnime.map((anime, idx) => (
        <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>

          <!-- Left content -->
          <div class="hero-left">
            <h1 class="hero-welcome">
              <span class="grad-text">Welcome</span> <span class="tube-text">to</span><br/>
              <span class="tube-text">AniTube Buzz</span>
            </h1>

            <p class="hero-desc">{anime.synopsis}</p>

            <div class="hero-play-row">
              <a href={anime.malUrl} target="_blank" rel="noopener" class="hero-play-btn" aria-label="Watch">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </a>
              <div class="hero-play-info">
                <div class="hero-date">{firstDate}</div>
                <div class="hero-season">
                  <span class="grad-text">{anime.season}</span>
                </div>
                <div class="hero-anime-name">{anime.title}</div>
              </div>
            </div>
          </div>

          <!-- Right image (BIG, HD, NO BLUR) -->
          <div class="hero-right">
            <div class="hero-image-glow"></div>
            {anime.image && (
              <div class="hero-image-wrap">
                <img
                  src={anime.image}
                  alt={anime.title}
                  class="hero-image"
                  loading={idx === 0 ? 'eager' : 'lazy'}
                />
              </div>
            )}
            {anime.score && (
              <div class="hero-score-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                {anime.score}
              </div>
            )}
          </div>

        </div>
      ))}
    </div>

    <!-- Dots -->
    <div class="hero-dots">
      {heroAnime.map((_, idx) => (
        <button class={`hero-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}></button>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    var slides = document.querySelectorAll('.hero-slide');
    var dots   = document.querySelectorAll('.hero-dot');
    var current = 0;
    var interval;

    if(slides.length === 0) return;

    function goto(idx){
      slides[current].classList.remove('active');
      dots[current] && dots[current].classList.remove('active');
      current = (idx + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current] && dots[current].classList.add('active');
    }

    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        clearInterval(interval);
        goto(parseInt(dot.dataset.index));
        interval = setInterval(function(){ goto(current + 1); }, 6000);
      });
    });

    if(slides.length > 1) {
      interval = setInterval(function(){ goto(current + 1); }, 6000);
    }
  })();
</script>

<style>
  .hero {
    padding: 3rem 0 4rem;
    position: relative;
  }

  .hero-cnt {
    position: relative;
  }

  .hero-slides {
    position: relative;
    min-height: 560px;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 4rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
    padding: 1rem 0;
  }

  .hero-slide.active {
    opacity: 1;
    visibility: visible;
  }

  /* Left content */
  .hero-left {
    position: relative;
    z-index: 2;
    animation-delay: 0.2s;
  }

  .hero-welcome {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 420px;
    margin-bottom: 2.5rem;
  }

  .hero-play-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .hero-play-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--grad);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
    transition: transform 0.2s ease;
    box-shadow: 0 8px 25px rgba(255, 51, 153, 0.4);
    position: relative;
    text-decoration: none;
  }

  .hero-play-btn::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 51, 153, 0.3);
    animation: play-ring 2s ease infinite;
  }

  @keyframes play-ring {
    0%   { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .hero-play-btn:hover { transform: scale(1.1); }

  .hero-play-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-season {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
  }

  .hero-anime-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  /* Right image — BIG, HD */
  .hero-right {
    position: relative;
    height: 100%;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 110%;
    height: 110%;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(255, 51, 153, 0.5) 0%,
      rgba(204, 51, 204, 0.3) 30%,
      rgba(0, 212, 255, 0.25) 60%,
      transparent 75%
    );
    filter: blur(80px);
    animation: glow-pulse 4s ease infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
    50%       { opacity: 1;   transform: translate(-50%, -50%) scale(1.05); }
  }

  .hero-image-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 3/4;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-img-in 1s ease forwards;
  }

  @keyframes hero-img-in {
    from { transform: scale(1.05); opacity: 0.5; }
    to   { transform: scale(1);    opacity: 1; }
  }

  .hero-score-badge {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    color: #ffd700;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    border: 1px solid rgba(255, 215, 0, 0.3);
  }

  /* Dots */
  .hero-dots {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    gap: 8px;
  }

  .hero-dot {
    width: 32px;
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-dot:hover { background: rgba(255, 255, 255, 0.35); }

  .hero-dot.active {
    background: var(--grad);
    width: 48px;
    box-shadow: 0 0 10px rgba(255, 51, 153, 0.5);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero { padding: 2rem 0 3rem; }
    .hero-slides { min-height: auto; }
    .hero-slide {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
      position: relative;
    }
    .hero-slide:not(.active) { display: none; }
    .hero-left { order: 2; }
    .hero-right {
      order: 1;
      min-height: 400px;
    }
    .hero-image-wrap { max-width: 320px; }
    .hero-desc { margin: 0 auto 2rem; }
    .hero-play-row { justify-content: center; }
    .hero-dots {
      position: relative;
      bottom: auto;
      left: auto;
      justify-content: center;
      margin-top: 2rem;
    }
  }

  @media (max-width: 480px) {
    .hero-welcome { font-size: 1.9rem; }
    .hero-image-wrap { max-width: 260px; }
    .hero-right { min-height: 340px; }
  }
</style>
