    transform: scale(1.02);
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px #fff, 0 0 12px var(--cyan);
    animation: sparkle-twinkle 5s ease infinite;
    pointer-events: none;
    z-index: 2;
  }

  .sparkle-1 { top: 20%; left: 15%; animation-delay: 0s; }
  .sparkle-2 { bottom: 25%; right: 20%; animation-delay: 2.5s; }

  @keyframes sparkle-twinkle {
    0%, 100% { opacity: 0; transform: scale(0); }
    50%       { opacity: 1; transform: scale(1.5); }
  }

  .corner-acc {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--cyan);
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 0 4px var(--cyan));
