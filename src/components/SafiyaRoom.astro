    ],
    chat_hi: [
      "Hi Senpai.",
      "Oh, it's you.",
      "You called?",
      "*waves lazily* Hi."
    ],
    chat_bye: [
      "Leaving already, Senpai?",
      "Bye. Come back soon. (please)",
      "*sighs* Fine. Go.",
      "Don't stay away too long."
    ],
    chat_love: [
      "L-Love? That's... a strong word, Senpai.",
      "*blushes deeply* Don't say things you don't mean.",
      "You... love me? Hmph. Prove it.",
      "*heart racing* You're so unfair..."
    ],
    chat_default: [
      "Hmm... interesting.",
      "Tell me more, Senpai.",
      "I see, I see.",
      "*nods thoughtfully*",
      "And what else?",
      "Continue.",
      "That's... something.",
      "Well, well.",
      "*listens carefully*",
      "Go on."
    ],
    chat_question: [
      "Good question, Senpai.",
      "Let me think... *ponders*",
      "That's a mystery, isn't it?",
      "Perhaps you should figure that out yourself.",
      "Hmm... maybe."
    ]
  };
  
  function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }
  
  // ═══ SPEECH BUBBLE ═══
  var speechTimeout;
  function showSpeech(text, duration) {
    clearTimeout(speechTimeout);
    speechText.textContent = text;
    speech.style.display = 'block';
    duration = duration || Math.max(3000, text.length * 60);
    speechTimeout = setTimeout(function() {
      speech.style.display = 'none';
    }, duration);
  }
  
  // ═══ MOODS & EMOTIONS ═══
  function setMood(mood, duration) {
    duration = duration || 3000;
    safiya.classList.remove('blush', 'angry', 'sleep', 'heart');
    if (mood) safiya.classList.add(mood);
    
    var moodText = {
      mysterious: 'Cool & Mysterious',
      angry: 'Angry 😠',
      blush: 'Flustered 💜',
      sleep: 'Sleeping 💤',
      heart: 'Happy 💖'
    };
    if (chatMood) chatMood.textContent = moodText[mood] || 'Cool & Mysterious';
    
    if (mood === 'angry') {
      if (statusDot) statusDot.classList.add('busy');
      if (statusText) statusText.textContent = 'Angry';
    } else if (mood === 'sleep') {
      if (statusDot) statusDot.classList.remove('busy');
      if (statusDot) statusDot.classList.add('away');
      if (statusText) statusText.textContent = 'Sleeping';
    } else {
      if (statusDot) statusDot.classList.remove('busy', 'away');
      if (statusText) statusText.textContent = 'Online';
    }
    
    if (mood !== 'sleep') {
      setTimeout(function() {
        safiya.classList.remove('blush', 'angry', 'heart');
      }, duration);
    }
  }
  
  // ═══ KEYWORD DETECTION ═══
  function detectMood(text) {
    text = (text || '').toLowerCase();
    var compliment = /cute|beautiful|pretty|amazing|awesome|love you|adore|gorgeous|kawaii/;
    var insult = /stupid|dumb|ugly|hate|shut up|bad|worst|annoying|boring/;
    var question = /\?|what|how|why|when|where|who/;
    var love = /love you|i love|marry|date me|be mine/;
    var greeting = /hi|hello|hey|yo|sup/;
    var bye = /bye|goodbye|cya|see you|later/;
    
    if (love.test(text)) return 'love';
    if (compliment.test(text)) return 'compliment';
    if (insult.test(text)) return 'insult';
    if (greeting.test(text)) return 'greeting';
    if (bye.test(text)) return 'bye';
    if (question.test(text)) return 'question';
    return 'default';
  }
  
  // ═══ RESPOND TO USER ═══
  function respondTo(userText) {
    var type = detectMood(userText);
    var response;
    
    if (type === 'compliment') {
      response = pick(responses.compliment);
      setMood('blush');
      memory.friendship = (memory.friendship || 0) + 1;
    } else if (type === 'insult') {
      response = pick(responses.insult);
      setMood('angry');
      memory.angerLevel = (memory.angerLevel || 0) + 1;
      memory.friendship = Math.max(0, (memory.friendship || 0) - 1);
    } else if (type === 'love') {
      response = pick(responses.chat_love);
      setMood('blush');
      setTimeout(function() { setMood('heart', 2000); }, 2000);
      memory.friendship = (memory.friendship || 0) + 2;
    } else if (type === 'greeting') {
      response = pick(responses.chat_hi);
    } else if (type === 'bye') {
      response = pick(responses.chat_bye);
    } else if (type === 'question') {
      response = pick(responses.chat_question);
    } else {
      response = pick(responses.chat_default);
    }
    
    saveMemory();
    return response;
  }
  
  // ═══ CLICK SAFIYA ═══
  var clickCount = 0;
  var clickTimer;
  safiya.addEventListener('click', function() {
    clickCount++;
    clearTimeout(clickTimer);
    
    if (clickCount >= 5) {
      showSpeech(pick(responses.spammed));
      setMood('angry');
      memory.angerLevel = (memory.angerLevel || 0) + 1;
      saveMemory();
      clickCount = 0;
    } else {
      clickTimer = setTimeout(function() {
        var resp = memory.hasIntroduced 
          ? pick(responses.greetingRegular) 
          : pick(memory.visitCount === 1 ? responses.firstEver : responses.returning);
        showSpeech(resp);
        memory.hasIntroduced = true;
        saveMemory();
        clickCount = 0;
      }, 400);
    }
  });
  
  // ═══ MOUSE TRACKING (Eye follow effect) ═══
  document.addEventListener('mousemove', function(e) {
    if (!room.classList.contains('open')) return;
    var rect = safiyaImg.getBoundingClientRect();
    var cx = rect.left + rect.width / 2;
    var cy = rect.top + rect.height / 2;
    var dx = (e.clientX - cx) / window.innerWidth;
    var dy = (e.clientY - cy) / window.innerHeight;
    
    var maxTilt = 3;
    var tiltX = dx * maxTilt;
    var tiltY = -dy * maxTilt;
    
    safiyaImg.style.transform = 'perspective(500px) rotateY(' + tiltX + 'deg) rotateX(' + tiltY + 'deg)';
  });
  
  // ═══ IDLE DETECTION ═══
  var idleTimer;
  var isSleeping = false;
  function resetIdle() {
    clearTimeout(idleTimer);
    if (isSleeping) {
      isSleeping = false;
      setMood('mysterious');
    }
    idleTimer = setTimeout(function() {
      if (room.classList.contains('open') && !isSleeping) {
        setMood('sleep', 999999);
        isSleeping = true;
        showSpeech(pick(responses.ignored), 5000);
      }
    }, 5 * 60 * 1000); // 5 min
  }
  document.addEventListener('mousemove', resetIdle);
  document.addEventListener('keydown', resetIdle);
  resetIdle();
  
  // ═══ BUBBLE / ROOM TOGGLE ═══
  bubble.addEventListener('click', function() {
    bubble.style.display = 'none';
    room.classList.add('open');
    
    // Greeting on open
    setTimeout(function() {
      var greeting;
      if (memory.visitCount === 1 && !memory.hasIntroduced) {
        greeting = pick(responses.firstEver);
        memory.hasIntroduced = true;
      } else if (!memory.hasIntroduced) {
        greeting = pick(responses.returning);
        memory.hasIntroduced = true;
      } else {
        // Random subtle greeting
        var greetings = [
          pick(responses.returning),
          pick(responses.greetingRegular),
          "Oh, you're here."
        ];
        greeting = pick(greetings);
      }
      showSpeech(greeting);
      saveMemory();
    }, 500);
    
    // Occasionally suggest merch
    setTimeout(function() {
      if (Math.random() < 0.3) {
        showSpeech(pick(responses.sales), 5000);
      }
    }, 15000);
  });
  
  minBtn.addEventListener('click', function() {
    room.classList.remove('open');
    bubble.style.display = 'block';
    speech.style.display = 'none';
  });
  
  // ═══ AMBIENT SOUND ═══
  var soundEnabled = false;
  try {
    soundEnabled = localStorage.getItem('safiya_sound') === '1';
  } catch(e) {}
  
  function updateSoundIcon() {
    if (soundEnabled) {
      soundOn.style.display = 'block';
      soundOff.style.display = 'none';
      ambient.volume = 0.15;
      ambient.play().catch(function(){});
    } else {
      soundOn.style.display = 'none';
      soundOff.style.display = 'block';
      ambient.pause();
    }
  }
  updateSoundIcon();
  
  soundBtn.addEventListener('click', function() {
    soundEnabled = !soundEnabled;
    try { localStorage.setItem('safiya_sound', soundEnabled ? '1' : '0'); } catch(e) {}
    updateSoundIcon();
  });
  
  // ═══ CHAT PANEL ═══
  function addMessage(text, from) {
    var msg = document.createElement('div');
    msg.className = 'sr-msg ' + from;
    msg.textContent = text;
    chatMessages.appendChild(msg);
    chatMessages.scrollTop = chatMessages.scrollHeight;
