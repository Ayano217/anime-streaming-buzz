  function addTyping() {
    var t = document.createElement('div');
    t.className = 'sr-typing';
    t.id = 'srTypingIndicator';
    t.innerHTML = '<span></span><span></span><span></span>';
    chatMessages.appendChild(t);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
  function removeTyping() {
    var t = document.getElementById('srTypingIndicator');
    if (t) t.remove();
  }
  
  function loadChatHistory() {
    try {
      var history = JSON.parse(localStorage.getItem('safiya_chat') || '[]');
      history.slice(-20).forEach(function(m) {
        addMessage(m.text, m.from);
      });
    } catch(e) {}
  }
  
  function saveChatMessage(text, from) {
    try {
      var history = JSON.parse(localStorage.getItem('safiya_chat') || '[]');
      history.push({ text: text, from: from, time: Date.now() });
      if (history.length > 50) history = history.slice(-50);
      localStorage.setItem('safiya_chat', JSON.stringify(history));
    } catch(e) {}
  }
  
  chatBtn.addEventListener('click', function() {
    room.classList.remove('open');
    chatPanel.style.display = 'flex';
    if (chatMessages.children.length === 0) {
      loadChatHistory();
      if (chatMessages.children.length === 0) {
        setTimeout(function() {
          addMessage(pick(responses.chat_hi), 'safiya');
        }, 400);
      }
    }
    setTimeout(function() { chatInput.focus(); }, 300);
  });
  
  chatClose.addEventListener('click', function() {
    chatPanel.style.display = 'none';
    bubble.style.display = 'block';
  });
  
  function sendMessage() {
    var text = chatInput.value.trim();
    if (!text) return;
    addMessage(text, 'user');
    saveChatMessage(text, 'user');
    chatInput.value = '';
    memory.conversationCount = (memory.conversationCount || 0) + 1;
    saveMemory();
    
    addTyping();
    setTimeout(function() {
      removeTyping();
      // 🔮 FUTURE AI INTEGRATION POINT
      // Later replace this with: fetch('/api/safiya', { body: JSON.stringify({message: text, memory}) })
      var response = respondTo(text);
      addMessage(response, 'safiya');
      saveChatMessage(response, 'safiya');
    }, 800 + Math.random() * 700);
  }
  
  chatSend.addEventListener('click', sendMessage);
  chatInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') sendMessage();
  });
  
  // ═══ HIDE HINT AFTER 5 SECONDS ═══
  setTimeout(function() {
    if (bubbleHint) bubbleHint.style.display = 'none';
  }, 5000);
  
})();
</script>
